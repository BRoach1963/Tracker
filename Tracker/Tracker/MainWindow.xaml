<controls:BaseWindow x:Class="Tracker.MainWindow"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:local="clr-namespace:Tracker"
                     xmlns:controls="clr-namespace:Tracker.Controls"
                     xmlns:languages="clr-namespace:Tracker.Resources.Languages"
                     xmlns:commands="clr-namespace:Tracker.Command"
                     xmlns:enums="clr-namespace:Tracker.Common.Enums"
                     xmlns:dialogViewModels="clr-namespace:Tracker.ViewModels.DialogViewModels"
                     xmlns:viewModels="clr-namespace:Tracker.ViewModels"
                     xmlns:attachedProperties="clr-namespace:Tracker.AttachedProperties"
                     xmlns:converters="clr-namespace:Tracker.Common.Converters"
                     xmlns:theming="clr-namespace:DeepEndControls.Theming;assembly=DeepEndControls"
                     mc:Ignorable="d"
                     MouseDown="OnDragHandleMouseDown"
                     WindowStyle="None"
                     WindowStartupLocation="CenterScreen"
                     ResizeMode="CanResize"
                     AllowsTransparency="True"
                     Closed="Window_Closed"
                     Background="Transparent"
                     Title="Tracker"
                     Height="800"
                     Width="1200"
                     MinHeight="600"
                     MinWidth="900"
                     d:DataContext="{d:DesignInstance Type=viewModels:TrackerMainViewModel}">
    
    <controls:BaseWindow.InputBindings>
        <!-- Search and Help -->
        <KeyBinding Key="K" Modifiers="Ctrl" Command="{Binding OpenSearchCommand}"/>
        <KeyBinding Key="F" Modifiers="Ctrl" Command="{Binding OpenSearchCommand}"/>
        <KeyBinding Key="F1" Command="{Binding OpenHelpBotCommand}"/>
        <KeyBinding Key="H" Modifiers="Ctrl+Shift" Command="{Binding OpenHelpBotCommand}"/>
        <!-- Navigation shortcuts - Ctrl+1-5 -->
        <KeyBinding Key="D1" Modifiers="Ctrl" Command="{x:Static local:MainWindow.NavigateToTabCommand}" CommandParameter="0"/>
        <KeyBinding Key="D2" Modifiers="Ctrl" Command="{x:Static local:MainWindow.NavigateToTabCommand}" CommandParameter="1"/>
        <KeyBinding Key="D3" Modifiers="Ctrl" Command="{x:Static local:MainWindow.NavigateToTabCommand}" CommandParameter="2"/>
        <KeyBinding Key="D4" Modifiers="Ctrl" Command="{x:Static local:MainWindow.NavigateToTabCommand}" CommandParameter="3"/>
        <KeyBinding Key="D5" Modifiers="Ctrl" Command="{x:Static local:MainWindow.NavigateToTabCommand}" CommandParameter="4"/>
        <!-- NumPad navigation -->
        <KeyBinding Key="NumPad1" Modifiers="Ctrl" Command="{x:Static local:MainWindow.NavigateToTabCommand}" CommandParameter="0"/>
        <KeyBinding Key="NumPad2" Modifiers="Ctrl" Command="{x:Static local:MainWindow.NavigateToTabCommand}" CommandParameter="1"/>
        <KeyBinding Key="NumPad3" Modifiers="Ctrl" Command="{x:Static local:MainWindow.NavigateToTabCommand}" CommandParameter="2"/>
        <KeyBinding Key="NumPad4" Modifiers="Ctrl" Command="{x:Static local:MainWindow.NavigateToTabCommand}" CommandParameter="3"/>
        <KeyBinding Key="NumPad5" Modifiers="Ctrl" Command="{x:Static local:MainWindow.NavigateToTabCommand}" CommandParameter="4"/>
        <!-- New item shortcut -->
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewItemCommand}"/>
    </controls:BaseWindow.InputBindings>
    
    <Grid>
        <Border Background="{DynamicResource BackgroundBrush}"
                BorderThickness="1"
                BorderBrush="{DynamicResource ForegroundBrush}"
                CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="5" />
                </Grid.RowDefinitions>
                
                <!-- Title Bar -->
                <Border Grid.Row="0"
                        Height="Auto"
                        Background="{DynamicResource BackgroundBrush}"
                        CornerRadius="12,12,0,0"
                        AutomationProperties.Name="Application Title Bar">
                    <controls:DialogTitleBar x:Name="TitleBar"
                                             ShowThemeSelector="False"
                                             ShowProfileButton="True"
                                             UserInitials="{Binding UserInitials}"
                                             HasUserAvatar="{Binding HasUserAvatar}"
                                             UserAvatarSource="{Binding UserAvatarSource}"
                                             CloseClicked="Close_Click"
                                             MinimizeClicked="Minimize_Click"
                                             MaximizeClicked="Maximize_Click"
                                             RestoreClicked="Restore_Click"
                                             ProfileClicked="Profile_Click"
                                             AutomationProperties.Name="Window Controls" />
                </Border>
                
                <!-- Main Content -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" MaxWidth="200" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                    </Grid.ColumnDefinitions>
                    
                    <!-- Sidebar Background -->
                    <Border Grid.Column="0" Grid.ColumnSpan="2"
                            CornerRadius="0,0,0,12"
                            Background="{DynamicResource BackgroundBrush}" />
                    
                    <!-- Main Navigation (5 Pillars) -->
                    <TabControl x:Name="TabControl"
                                SelectionChanged="TabChangedEventHandler"
                                Grid.Column="1"
                                Margin="0,0,5,0"
                                AutomationProperties.Name="Main Navigation"
                                AutomationProperties.HelpText="Use Ctrl+1 through Ctrl+5 to navigate between sections">
                        
                        <!-- HOME (Dashboard) -->
                        <TabItem x:Name="Home"
                                 Header="Home"
                                 attachedProperties:TabItemExtensions.IconData="M10,20V14H14V20H19V12H22L12,3L2,12H5V20H10Z"
                                 attachedProperties:TooltipProperties.Text="Dashboard - Overview and statistics (Ctrl+1)"
                                 AutomationProperties.Name="Home - Dashboard"
                                 AutomationProperties.HelpText="View team health dashboard and statistics. Keyboard shortcut: Ctrl+1"
                                 AutomationProperties.AcceleratorKey="Ctrl+1"/>
                        
                        <!-- CIRCLE (Team, 1:1s, Feedback, Goals) -->
                        <TabItem x:Name="Circle"
                                 Header="Circle"
                                 attachedProperties:TabItemExtensions.IconData="M12,5.5A3.5,3.5 0 0,1 15.5,9A3.5,3.5 0 0,1 12,12.5A3.5,3.5 0 0,1 8.5,9A3.5,3.5 0 0,1 12,5.5M5,8C5.56,8 6.08,8.15 6.53,8.42C6.38,9.85 6.8,11.27 7.66,12.38C7.16,13.34 6.16,14 5,14A3,3 0 0,1 2,11A3,3 0 0,1 5,8M19,8A3,3 0 0,1 22,11A3,3 0 0,1 19,14C17.84,14 16.84,13.34 16.34,12.38C17.2,11.27 17.62,9.85 17.47,8.42C17.92,8.15 18.44,8 19,8M5.5,18.25C5.5,16.18 8.41,14.5 12,14.5C15.59,14.5 18.5,16.18 18.5,18.25V20H5.5V18.25M0,20V18.5C0,17.11 1.89,15.94 4.45,15.6C3.86,16.28 3.5,17.22 3.5,18.25V20H0M24,20H20.5V18.25C20.5,17.22 20.14,16.28 19.55,15.6C22.11,15.94 24,17.11 24,18.5V20Z"
                                 attachedProperties:TooltipProperties.Text="Circle - Your team, meetings, feedback &amp; goals (Ctrl+2)"
                                 AutomationProperties.Name="Circle - Team Management"
                                 AutomationProperties.HelpText="Manage team members, 1:1 meetings, feedback and goals. Keyboard shortcut: Ctrl+2"
                                 AutomationProperties.AcceleratorKey="Ctrl+2"/>
                        
                        <!-- PULSE (Projects, Tasks, OKRs, KPIs) -->
                        <TabItem x:Name="Pulse"
                                 Header="Pulse"
                                 attachedProperties:TabItemExtensions.IconData="M3,13H5V11H3V13M3,17H5V15H3V17M3,9H5V7H3V9M7,13H21V11H7V13M7,17H21V15H7V17M7,7V9H21V7H7Z"
                                 attachedProperties:TooltipProperties.Text="Pulse - Projects, tasks, OKRs &amp; KPIs (Ctrl+3)"
                                 AutomationProperties.Name="Pulse - Work Tracking"
                                 AutomationProperties.HelpText="Track OKRs, KPIs, projects and tasks. Keyboard shortcut: Ctrl+3"
                                 AutomationProperties.AcceleratorKey="Ctrl+3"/>
                        
                        <!-- CHRONICLE (Notes, Reports) -->
                        <TabItem x:Name="Chronicle"
                                 Header="Chronicle"
                                 attachedProperties:TabItemExtensions.IconData="M19,1L14,6V17L19,12.5V1M21,5V18.5C19.9,18.15 18.7,18 17.5,18C15.8,18 13.35,18.65 12,19.5V6C10.55,4.9 8.45,4.5 6.5,4.5C4.55,4.5 2.45,4.9 1,6V20.65C1,20.9 1.25,21.15 1.5,21.15C1.6,21.15 1.65,21.1 1.75,21.1C3.1,20.45 5.05,20 6.5,20C8.45,20 10.55,20.4 12,21.5C13.35,20.65 15.8,20 17.5,20C19.15,20 20.85,20.3 22.25,21.05C22.35,21.1 22.4,21.1 22.5,21.1C22.75,21.1 23,20.85 23,20.6V6C22.4,5.55 21.75,5.25 21,5M10,18.41C8.75,18.09 7.5,18 6.5,18C5.44,18 4.18,18.19 3,18.5V7.13C3.91,6.73 5.14,6.5 6.5,6.5C7.86,6.5 9.09,6.73 10,7.13V18.41Z"
                                 attachedProperties:TooltipProperties.Text="Chronicle - Notes, journal &amp; reports (Ctrl+4)"
                                 AutomationProperties.Name="Chronicle - Notes and Reports"
                                 AutomationProperties.HelpText="Access quick notes and performance reports. Keyboard shortcut: Ctrl+4"
                                 AutomationProperties.AcceleratorKey="Ctrl+4"/>
                        
                        <!-- SETTINGS -->
                        <TabItem x:Name="Settings"
                                 Header="{x:Static languages:Resources.Settings_Title}"
                                 attachedProperties:TabItemExtensions.IconData="M12,8A4,4 0 0,1 16,12A4,4 0 0,1 12,16A4,4 0 0,1 8,12A4,4 0 0,1 12,8M12,10A2,2 0 0,0 10,12A2,2 0 0,0 12,14A2,2 0 0,0 14,12A2,2 0 0,0 12,10M10,22C9.75,22 9.54,21.82 9.5,21.58L9.13,18.93C8.5,18.68 7.96,18.34 7.44,17.94L4.95,18.95C4.73,19.03 4.46,18.95 4.34,18.73L2.34,15.27C2.21,15.05 2.27,14.78 2.46,14.63L4.57,12.97L4.5,12L4.57,11L2.46,9.37C2.27,9.22 2.21,8.95 2.34,8.73L4.34,5.27C4.46,5.05 4.73,4.96 4.95,5.05L7.44,6.05C7.96,5.66 8.5,5.32 9.13,5.07L9.5,2.42C9.54,2.18 9.75,2 10,2H14C14.25,2 14.46,2.18 14.5,2.42L14.87,5.07C15.5,5.32 16.04,5.66 16.56,6.05L19.05,5.05C19.27,4.96 19.54,5.05 19.66,5.27L21.66,8.73C21.79,8.95 21.73,9.22 21.54,9.37L19.43,11L19.5,12L19.43,13L21.54,14.63C21.73,14.78 21.79,15.05 21.66,15.27L19.66,18.73C19.54,18.95 19.27,19.04 19.05,18.95L16.56,17.95C16.04,18.34 15.5,18.68 14.87,18.93L14.5,21.58C14.46,21.82 14.25,22 14,22H10M11.25,4L10.88,6.61C9.68,6.86 8.62,7.5 7.85,8.39L5.44,7.35L4.69,8.65L6.8,10.2C6.4,11.37 6.4,12.64 6.8,13.8L4.68,15.36L5.43,16.66L7.86,15.62C8.63,16.5 9.68,17.14 10.87,17.38L11.24,20H12.76L13.13,17.39C14.32,17.14 15.37,16.5 16.14,15.62L18.57,16.66L19.32,15.36L17.2,13.81C17.6,12.64 17.6,11.37 17.2,10.2L19.31,8.65L18.56,7.35L16.15,8.39C15.38,7.5 14.32,6.86 13.12,6.62L12.75,4H11.25Z"
                                 AutomationProperties.Name="Settings"
                                 AutomationProperties.HelpText="Configure application settings, themes, and integrations. Keyboard shortcut: Ctrl+5"
                                 AutomationProperties.AcceleratorKey="Ctrl+5">
                            <TabItem.ToolTip>
                                <ToolTip Style="{StaticResource CustomInformationToolTip}">
                                    <controls:TrackerToolTip ToolTipText="{x:Static languages:Resources.ToolTip_Settings}" />
                                </ToolTip>
                            </TabItem.ToolTip>
                        </TabItem>
                    </TabControl>
                    
                    <!-- Sidebar Divider -->
                    <Border Grid.Column="1"
                            Margin="0,1,2,1"
                            Background="{DynamicResource ForegroundBrush}"
                            Width="1"
                            HorizontalAlignment="Right"/>
                    
                    <!-- Collapse Button -->
                    <Button Style="{StaticResource ExpansionButtonStyle}"
                            VerticalAlignment="Bottom"
                            Panel.ZIndex="99"
                            Grid.Column="1"
                            Width="20"
                            Height="20"
                            Margin="0,0,-7.5,10"
                            HorizontalAlignment="Right"
                            Command="{x:Static attachedProperties:TabControlExtensions.ToggleCollapseCommand}"
                            CommandParameter="{Binding ElementName=TabControl}" />
                    
                    <!-- ============================================ -->
                    <!-- CONTENT AREA -->
                    <!-- ============================================ -->
                    
                    <!-- HOME Content (Dashboard) -->
                    <controls:DashboardControl x:Name="DashboardControl"
                                               Grid.Column="3"
                                               Visibility="{Binding ElementName=Home, Path=IsSelected, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}"/>
                    
                    <!-- CIRCLE Content -->
                    <Grid Grid.Column="3"
                          Visibility="{Binding ElementName=Circle, Path=IsSelected, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Circle Header + Sub-Navigation -->
                        <StackPanel Grid.Row="0" Margin="0,8,0,0">
                            <Border Style="{StaticResource SegmentedControlContainer}"
                                    AutomationProperties.Name="Circle Navigation">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="CircleMembers" 
                                                 Content="Members" 
                                                 Style="{StaticResource SegmentedButtonStyle}"
                                                 IsChecked="True"
                                                 GroupName="CircleNav"
                                                 AutomationProperties.Name="Team Members"
                                                 AutomationProperties.HelpText="View and manage team members"
                                                 TabIndex="10"/>
                                    <RadioButton x:Name="CircleOneOnOnes" 
                                                 Content="1:1s" 
                                                 Style="{StaticResource SegmentedButtonStyle}"
                                                 GroupName="CircleNav"
                                                 AutomationProperties.Name="One on One Meetings"
                                                 AutomationProperties.HelpText="Schedule and manage 1:1 meetings"
                                                 TabIndex="11"/>
                                    <RadioButton x:Name="CircleFeedback" 
                                                 Content="Feedback" 
                                                 Style="{StaticResource SegmentedButtonStyle}"
                                                 GroupName="CircleNav"
                                                 AutomationProperties.Name="Feedback"
                                                 AutomationProperties.HelpText="Track feedback given to team members"
                                                 TabIndex="12"/>
                                    <RadioButton x:Name="CircleGoals" 
                                                 Content="Goals" 
                                                 Style="{StaticResource SegmentedButtonStyle}"
                                                 GroupName="CircleNav"
                                                 AutomationProperties.Name="Individual Goals"
                                                 AutomationProperties.HelpText="Track individual development goals"
                                                 TabIndex="13"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        
                        <!-- Circle Sub-Content -->
                        <Grid Grid.Row="1">
                            <controls:TeamMembersControl 
                                Visibility="{Binding ElementName=CircleMembers, Path=IsChecked, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}"/>
                            <controls:OneOnOnesControl 
                                Visibility="{Binding ElementName=CircleOneOnOnes, Path=IsChecked, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}"/>
                            <controls:FeedbackHistoryControl 
                                Visibility="{Binding ElementName=CircleFeedback, Path=IsChecked, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}"/>
                            <controls:GoalsControl 
                                Visibility="{Binding ElementName=CircleGoals, Path=IsChecked, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}"/>
                        </Grid>
                    </Grid>
                    
                    <!-- PULSE Content -->
                    <Grid Grid.Column="3"
                          Visibility="{Binding ElementName=Pulse, Path=IsSelected, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Pulse Header + Sub-Navigation (hierarchical: strategic → tactical) -->
                        <StackPanel Grid.Row="0" Margin="0,8,0,0">
                            <Border Style="{StaticResource SegmentedControlContainer}"
                                    AutomationProperties.Name="Pulse Navigation">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="PulseOkrs" 
                                                 Content="OKRs" 
                                                 Style="{StaticResource SegmentedButtonStyle}"
                                                 IsChecked="True"
                                                 GroupName="PulseNav"
                                                 AutomationProperties.Name="OKRs - Objectives and Key Results"
                                                 AutomationProperties.HelpText="Track objectives and key results"
                                                 TabIndex="20"/>
                                    <RadioButton x:Name="PulseKpis" 
                                                 Content="KPIs" 
                                                 Style="{StaticResource SegmentedButtonStyle}"
                                                 GroupName="PulseNav"
                                                 AutomationProperties.Name="KPIs - Key Performance Indicators"
                                                 AutomationProperties.HelpText="Monitor key performance indicators"
                                                 TabIndex="21"/>
                                    <RadioButton x:Name="PulseProjects" 
                                                 Content="Projects" 
                                                 Style="{StaticResource SegmentedButtonStyle}"
                                                 GroupName="PulseNav"
                                                 AutomationProperties.Name="Projects"
                                                 AutomationProperties.HelpText="Manage projects and track progress"
                                                 TabIndex="22"/>
                                    <RadioButton x:Name="PulseTasks" 
                                                 Content="Tasks" 
                                                 Style="{StaticResource SegmentedButtonStyle}"
                                                 GroupName="PulseNav"
                                                 AutomationProperties.Name="Tasks"
                                                 AutomationProperties.HelpText="View and manage individual tasks"
                                                 TabIndex="23"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        
                        <!-- Pulse Sub-Content -->
                        <Grid Grid.Row="1">
                            <controls:OkrsControl 
                                Visibility="{Binding ElementName=PulseOkrs, Path=IsChecked, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}"/>
                            <controls:KpisControl 
                                Visibility="{Binding ElementName=PulseKpis, Path=IsChecked, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}"/>
                            <controls:ProjectsControl 
                                Visibility="{Binding ElementName=PulseProjects, Path=IsChecked, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}"/>
                            <controls:TasksControl 
                                Visibility="{Binding ElementName=PulseTasks, Path=IsChecked, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}"/>
                        </Grid>
                    </Grid>
                    
                    <!-- CHRONICLE Content -->
                    <Grid Grid.Column="3"
                          Visibility="{Binding ElementName=Chronicle, Path=IsSelected, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Chronicle Header + Sub-Navigation -->
                        <StackPanel Grid.Row="0" Margin="0,8,0,0">
                            <Border Style="{StaticResource SegmentedControlContainer}"
                                    AutomationProperties.Name="Chronicle Navigation">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="ChronicleNotes" 
                                                 Content="Notes" 
                                                 Style="{StaticResource SegmentedButtonStyle}"
                                                 IsChecked="True"
                                                 GroupName="ChronicleNav"
                                                 AutomationProperties.Name="Quick Notes"
                                                 AutomationProperties.HelpText="Create and manage quick notes"
                                                 TabIndex="30"/>
                                    <RadioButton x:Name="ChronicleReports" 
                                                 Content="Reports" 
                                                 Style="{StaticResource SegmentedButtonStyle}"
                                                 GroupName="ChronicleNav"
                                                 AutomationProperties.Name="Reports"
                                                 AutomationProperties.HelpText="View performance reports and analytics"
                                                 TabIndex="31"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        
                        <!-- Chronicle Sub-Content -->
                        <Grid Grid.Row="1">
                            <controls:QuickNotesControl 
                                Visibility="{Binding ElementName=ChronicleNotes, Path=IsChecked, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}"/>
                            <controls:ReportsControl 
                                Visibility="{Binding ElementName=ChronicleReports, Path=IsChecked, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}"/>
                        </Grid>
                    </Grid>
                    
                    <!-- SETTINGS Content -->
                    <controls:SettingsControl x:Name="SettingsControl"
                                              Grid.Column="3"
                                              Visibility="{Binding ElementName=Settings, Path=IsSelected, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}"/>
                    
                </Grid>
                
                <!-- Floating Help Bot Button (FAB) - positioned in content area -->
                <Button x:Name="HelpBotFab"
                        Grid.Row="1"
                        Command="{Binding OpenHelpBotCommand}"
                        Width="48" Height="48"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,20,16"
                        Cursor="Hand"
                        ToolTip="AI Help Assistant (F1)"
                        Panel.ZIndex="100"
                        AutomationProperties.Name="AI Help Assistant"
                        AutomationProperties.HelpText="Open the AI-powered help assistant. Keyboard shortcut: F1"
                        AutomationProperties.AcceleratorKey="F1"
                        TabIndex="100">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <!-- Shadow layer -->
                                <Ellipse Fill="#40000000"
                                         Width="48" Height="48"
                                         Margin="2,2,0,0"/>
                                
                                <!-- Main button - dark background -->
                                <Ellipse x:Name="FabBackground"
                                         Fill="#1A1A2E"
                                         Width="48" Height="48"/>
                                
                                <!-- Sparkle icon with gradient (like the image) -->
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- Main large sparkle -->
                                    <Path Data="M12,1L9,9L1,12L9,15L12,23L15,15L23,12L15,9L12,1Z"
                                          Width="26" Height="26"
                                          Stretch="Uniform">
                                        <Path.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#FFF8E1" Offset="0"/>
                                                <GradientStop Color="#4FC3F7" Offset="0.4"/>
                                                <GradientStop Color="#0288D1" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Path.Fill>
                                    </Path>
                                    <!-- Small accent sparkle -->
                                    <Path Data="M12,1L9,9L1,12L9,15L12,23L15,15L23,12L15,9L12,1Z"
                                          Width="10" Height="10"
                                          Stretch="Uniform"
                                          Margin="18,-14,0,0">
                                        <Path.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#FFF8E1" Offset="0"/>
                                                <GradientStop Color="#29B6F6" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Path.Fill>
                                    </Path>
                                </Grid>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="FabBackground" Property="Fill" Value="#2A2A4E"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="FabBackground" Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="0.95" ScaleY="0.95" CenterX="24" CenterY="24"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
    </Grid>
</controls:BaseWindow>
