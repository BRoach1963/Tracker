<UserControl x:Class="Tracker.Controls.TasksControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Tracker.Controls"
             xmlns:commands="clr-namespace:Tracker.Command"
             xmlns:enums="clr-namespace:Tracker.Common.Enums"
             xmlns:converters="clr-namespace:Tracker.Common.Converters"
             xmlns:viewModels="clr-namespace:Tracker.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1200"
             d:DataContext="{d:DesignInstance Type=viewModels:TrackerMainViewModel}"
             AutomationProperties.Name="Tasks"
             AutomationProperties.HelpText="Track team assignments and deliverables">
    
    <UserControl.Resources>
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource HintTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
        </Style>
        
        <Style x:Key="TaskCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <converters:TaskStatusToColorConverter x:Key="TaskStatusToColorConverter"/>
    </UserControl.Resources>
    
    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- ROW 0: HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel>
                <TextBlock Text="Tasks" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}"/>
                <TextBlock Text="Track team assignments and deliverables" FontSize="14" Foreground="{DynamicResource HintTextBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            
            <Button Grid.Column="1" 
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{x:Static commands:DialogCommands.LaunchDialogCommand}"
                    CommandParameter="{x:Static enums:DialogType.AddTask}"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Add New Task"
                    AutomationProperties.HelpText="Open dialog to create a new task"
                    ToolTip="Create a new task"
                    TabIndex="100">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"
                          Fill="{DynamicResource BackgroundBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"/>
                    <TextBlock Text="New Task"/>
                </StackPanel>
            </Button>
        </Grid>
        
        <!-- ROW 1: STATS BAR (Clickable Filters) -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Border Grid.Column="0" Margin="0,0,6,0"
                    MouseLeftButtonUp="StatCard_Open_Click"
                    ToolTip="Click to filter by Open tasks">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource StatCardStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=ShowOpenTasks, Path=IsChecked}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="OPEN" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Text="{Binding OpenTaskCount, FallbackValue='0'}" Style="{StaticResource StatValue}" Foreground="{DynamicResource AccentBrush}"/>
                </StackPanel>
            </Border>
            
            <Border Grid.Column="1" Margin="3,0"
                    MouseLeftButtonUp="StatCard_Overdue_Click"
                    ToolTip="Click to filter by Overdue tasks">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource StatCardStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=ShowOverdueTasks, Path=IsChecked}" Value="True">
                                <Setter Property="BorderBrush" Value="#EF4444"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="OVERDUE" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Text="{Binding OverdueTaskCount, FallbackValue='0'}" Style="{StaticResource StatValue}" Foreground="#EF4444"/>
                </StackPanel>
            </Border>
            
            <Border Grid.Column="2" Margin="3,0"
                    MouseLeftButtonUp="StatCard_Completed_Click"
                    ToolTip="Click to filter by Completed tasks">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource StatCardStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=ShowCompletedTasks, Path=IsChecked}" Value="True">
                                <Setter Property="BorderBrush" Value="#10B981"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="COMPLETED" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Text="{Binding CompletedTaskCount, FallbackValue='0'}" Style="{StaticResource StatValue}" Foreground="#10B981"/>
                </StackPanel>
            </Border>
            
            <Border Grid.Column="3" Margin="6,0,0,0"
                    MouseLeftButtonUp="StatCard_All_Click"
                    ToolTip="Click to show all tasks">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource StatCardStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=ShowAllTasks, Path=IsChecked}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource ForegroundBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="TOTAL" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Text="{Binding Tasks.Count, FallbackValue='0'}" Style="{StaticResource StatValue}"/>
                </StackPanel>
            </Border>
        </Grid>
        
        <!-- ROW 2: FILTER BAR -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Search Box -->
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                          Fill="{DynamicResource HintTextBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" 
                             Text="{Binding TaskSearchText, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource ForegroundBrush}"
                             VerticalAlignment="Center" Margin="10,0,0,0" FontSize="13">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="Search tasks..." Foreground="{DynamicResource HintTextBrush}" FontSize="13"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>
            </Border>
            
            <!-- Filter Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                <RadioButton x:Name="ShowAllTasks" Content="All" GroupName="TaskFilter" 
                             Style="{StaticResource SegmentedButtonStyle}"
                             IsChecked="{Binding TaskStatusFilter, Converter={x:Static converters:NullToBoolConverter.Instance}, ConverterParameter=True}"
                             Click="FilterAll_Click"/>
                <RadioButton x:Name="ShowOpenTasks" Content="Open" GroupName="TaskFilter" 
                             Style="{StaticResource SegmentedButtonStyle}"
                             Click="FilterOpen_Click"/>
                <RadioButton x:Name="ShowOverdueTasks" Content="Overdue" GroupName="TaskFilter" 
                             Style="{StaticResource SegmentedButtonStyle}"
                             Click="FilterOverdue_Click"/>
                <RadioButton x:Name="ShowCompletedTasks" Content="Completed" GroupName="TaskFilter" 
                             Style="{StaticResource SegmentedButtonStyle}"
                             Click="FilterCompleted_Click"/>
            </StackPanel>
            
            <!-- Clear Filter Button -->
            <Button Grid.Column="2" 
                    Content="Clear Filter" 
                    Style="{StaticResource SecondaryButtonStyle}"
                    Visibility="{Binding TaskStatusFilter, Converter={x:Static converters:NullToVisibilityConverter.Instance}}"
                    Click="FilterAll_Click"
                    HorizontalAlignment="Right"
                    Margin="8,0,0,0"/>
        </Grid>
        
        <!-- ROW 3: MAIN CONTENT -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>
            
            <!-- Task List -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
                <ItemsControl ItemsSource="{Binding FilteredTasks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource TaskCardStyle}"
                                    MouseLeftButtonDown="Task_MouseDown"
                                    Tag="{Binding}"
                                    ToolTip="Click to select, double-click to edit">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Checkbox -->
                                    <CheckBox IsChecked="{Binding IsCompleted}" VerticalAlignment="Top" Margin="0,2,10,0"/>
                                    
                                    <!-- Content -->
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Description}" 
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="42">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                            <Setter Property="Opacity" Value="0.5"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        
                                        <!-- Meta Row -->
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <!-- Owner -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0"
                                                        Visibility="{Binding Owner, Converter={x:Static converters:NullToVisibilityConverter.Instance}}">
                                                <Grid Width="18" Height="18">
                                                    <!-- Background for initials fallback -->
                                                    <Ellipse Fill="{DynamicResource AccentBrush}"
                                                             Visibility="{Binding Owner.ProfileImage, Converter={x:Static converters:ByteArrayToVisibilityConverter.InverseInstance}}"/>
                                                    <TextBlock Text="{Binding Owner.Initials}" FontSize="8" FontWeight="Bold"
                                                               Foreground="{DynamicResource BackgroundBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="{Binding Owner.ProfileImage, Converter={x:Static converters:ByteArrayToVisibilityConverter.InverseInstance}}"/>
                                                    <!-- Profile Image -->
                                                    <Ellipse Visibility="{Binding Owner.ProfileImage, Converter={x:Static converters:ByteArrayToVisibilityConverter.Instance}}">
                                                        <Ellipse.Fill>
                                                            <ImageBrush ImageSource="{Binding Owner.ProfileImage, Converter={x:Static converters:ByteArrayToImageSourceConverter.Instance}}"
                                                                        RenderOptions.BitmapScalingMode="HighQuality"
                                                                        Stretch="UniformToFill"/>
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                </Grid>
                                                <TextBlock Text="{Binding Owner.FullName}" FontSize="11"
                                                           Foreground="{DynamicResource HintTextBrush}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            
                                            <!-- Due Date -->
                                            <StackPanel Orientation="Horizontal"
                                                        Visibility="{Binding DueDate, Converter={x:Static converters:NullToVisibilityConverter.Instance}}">
                                                <Path Data="M19,19H5V8H19M16,1V3H8V1H6V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3H18V1"
                                                      Fill="{DynamicResource HintTextBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding DueDate, StringFormat='{}{0:MMM dd}'}" FontSize="11"
                                                           Foreground="{DynamicResource HintTextBrush}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                    
                                    <!-- Status Badge -->
                                    <Border Grid.Column="2" CornerRadius="6" Padding="8,4" VerticalAlignment="Top"
                                            Background="{Binding Status, Converter={StaticResource TaskStatusToColorConverter}}">
                                        <TextBlock Text="{Binding Status}" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            
            <!-- Detail Panel -->
            <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="12"
                    Visibility="{Binding SelectedTask, Converter={x:Static converters:NullToVisibilityConverter.Instance}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <!-- Task Description -->
                        <TextBlock Text="{Binding SelectedTask.Description}" 
                                   FontSize="16" FontWeight="Bold" 
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,12"/>
                        
                        <!-- Status -->
                        <Border CornerRadius="8" Padding="10,5" HorizontalAlignment="Left" Margin="0,0,0,16"
                                Background="{Binding SelectedTask.Status, Converter={StaticResource TaskStatusToColorConverter}}">
                            <TextBlock Text="{Binding SelectedTask.Status}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        
                        <!-- Owner -->
                        <TextBlock Text="ASSIGNED TO" Style="{StaticResource SectionHeader}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Grid Width="28" Height="28" Visibility="{Binding SelectedTask.Owner, Converter={x:Static converters:NullToVisibilityConverter.Instance}}">
                                <!-- Background for initials fallback -->
                                <Ellipse Fill="{DynamicResource AccentBrush}"
                                         Visibility="{Binding SelectedTask.Owner.ProfileImage, Converter={x:Static converters:ByteArrayToVisibilityConverter.InverseInstance}}"/>
                                <TextBlock Text="{Binding SelectedTask.Owner.Initials}" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource BackgroundBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding SelectedTask.Owner.ProfileImage, Converter={x:Static converters:ByteArrayToVisibilityConverter.InverseInstance}}"/>
                                <!-- Profile Image -->
                                <Ellipse Visibility="{Binding SelectedTask.Owner.ProfileImage, Converter={x:Static converters:ByteArrayToVisibilityConverter.Instance}}">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{Binding SelectedTask.Owner.ProfileImage, Converter={x:Static converters:ByteArrayToImageSourceConverter.Instance}}"
                                                    RenderOptions.BitmapScalingMode="HighQuality"
                                                    Stretch="UniformToFill"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Grid>
                            <TextBlock Text="{Binding SelectedTask.Owner.FullName, FallbackValue='Unassigned'}" 
                                       FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                        
                        <!-- Due Date -->
                        <TextBlock Text="DUE DATE" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="{Binding SelectedTask.DueDate, StringFormat='{}{0:dddd, MMMM d, yyyy}', TargetNullValue='No due date'}"
                                   FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,16"/>
                        
                        <!-- Notes -->
                        <TextBlock Text="NOTES" Style="{StaticResource SectionHeader}"/>
                        <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                            <TextBlock Text="{Binding SelectedTask.Notes, TargetNullValue='No notes'}"
                                       FontSize="12" Foreground="{DynamicResource ForegroundBrush}" TextWrapping="Wrap" LineHeight="18"/>
                        </Border>
                        
                        <!-- Actions -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <Button Content="Edit" Command="{Binding EditTaskCommand}" 
                                    CommandParameter="{Binding SelectedTask}"
                                    Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
                            <Button Content="Delete" Command="{Binding DeleteTaskCommand}" 
                                    CommandParameter="{Binding SelectedTask}"
                                    Style="{StaticResource SecondaryButtonStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            
            <!-- Empty State -->
            <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="12"
                    Visibility="{Binding SelectedTask, Converter={x:Static converters:NullToVisibilityConverter.InverseInstance}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Path Data="M20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4C12.76,4 13.5,4.11 14.2,4.31L15.77,2.74C14.61,2.26 13.34,2 12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12M7.91,10.08L6.5,11.5L11,16L21,6L19.59,4.58L11,13.17L7.91,10.08Z"
                          Fill="{DynamicResource HintTextBrush}" Width="48" Height="48" Stretch="Uniform" Opacity="0.4"/>
                    <TextBlock Text="Select a task" FontSize="14" Foreground="{DynamicResource HintTextBrush}" 
                               HorizontalAlignment="Center" Margin="0,16,0,4"/>
                    <TextBlock Text="to view details" FontSize="12" Foreground="{DynamicResource HintTextBrush}" 
                               HorizontalAlignment="Center" Opacity="0.7"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
