<UserControl x:Class="Tracker.Controls.QuickNotesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:Tracker.Common.Converters"
             xmlns:enums="clr-namespace:Tracker.Common.Enums"
             xmlns:viewModels="clr-namespace:Tracker.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1200"
             d:DataContext="{d:DesignInstance Type=viewModels:QuickNotesViewModel}"
             AutomationProperties.Name="Quick Notes"
             AutomationProperties.HelpText="Capture thoughts, observations, and reminders">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles/DialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Note Category Colors -->
            <SolidColorBrush x:Key="GeneralBrush" Color="#607D8B"/>
            <SolidColorBrush x:Key="MeetingBrush" Color="#2196F3"/>
            <SolidColorBrush x:Key="IdeaBrush" Color="#FFC107"/>
            <SolidColorBrush x:Key="TodoBrush" Color="#4CAF50"/>
            <SolidColorBrush x:Key="DecisionBrush" Color="#9C27B0"/>
            <SolidColorBrush x:Key="ObservationBrush" Color="#00BCD4"/>
            <SolidColorBrush x:Key="ReflectionBrush" Color="#E91E63"/>
            <SolidColorBrush x:Key="ReminderBrush" Color="#FF5722"/>
            
            <Style x:Key="NoteCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="12"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            
            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource HintTextBrush}"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- ROW 0: HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel>
                <TextBlock Text="Quick Notes" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}"/>
                <TextBlock Text="Capture thoughts, observations, and reminders" FontSize="14" Foreground="{DynamicResource HintTextBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            
            <Button Grid.Column="1" 
                    Command="{Binding NewNoteCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Create New Note"
                    AutomationProperties.HelpText="Create a new quick note"
                    ToolTip="Create a new note"
                    TabIndex="100">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"
                          Fill="{DynamicResource BackgroundBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"/>
                    <TextBlock Text="New Note"/>
                </StackPanel>
            </Button>
        </Grid>
        
        <!-- ROW 1: STATS BAR -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Border Grid.Column="0" Margin="0,0,6,0" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="TOTAL" Style="{StaticResource SectionHeaderStyle}"/>
                    <TextBlock Text="{Binding TotalNotes, FallbackValue='0'}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}"/>
                </StackPanel>
            </Border>
            
            <Border Grid.Column="1" Margin="3,0" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="PINNED" Style="{StaticResource SectionHeaderStyle}"/>
                    <TextBlock Text="{Binding PinnedCount, FallbackValue='0'}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                </StackPanel>
            </Border>
            
            <Border Grid.Column="2" Margin="3,0" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="FILTERED" Style="{StaticResource SectionHeaderStyle}"/>
                    <TextBlock Text="{Binding FilteredCount, FallbackValue='0'}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}"/>
                </StackPanel>
            </Border>
            
            <Border Grid.Column="3" Margin="6,0,0,0" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="16,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="Archived" IsChecked="{Binding ShowArchived}" Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <CheckBox Content="Pinned Only" IsChecked="{Binding ShowPinnedOnly}" Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
        
        <!-- ROW 2: MAIN CONTENT - Master/Detail -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="350"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>
            
            <!-- LEFT: Notes List (Master) -->
            <Grid Grid.Column="0" Margin="0,0,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Search -->
                <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                              Fill="{DynamicResource HintTextBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" 
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource ForegroundBrush}"
                                 VerticalAlignment="Center" Margin="10,0,0,0" FontSize="13">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <VisualBrush AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                        <VisualBrush.Visual>
                                                            <TextBlock Text="Search notes..." Foreground="{DynamicResource HintTextBrush}" FontSize="13"/>
                                                        </VisualBrush.Visual>
                                                    </VisualBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>
                </Border>
                
                <!-- Filter Bar -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <ComboBox Grid.Column="0" 
                              ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedCategoryFilter}"
                              Margin="0,0,5,0">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                <Setter Property="Tag" Value="Category"/>
                            </Style>
                        </ComboBox.Style>
                    </ComboBox>
                    
                    <ComboBox Grid.Column="1" 
                              ItemsSource="{Binding LinkedEntityTypes}"
                              SelectedItem="{Binding SelectedEntityTypeFilter}"
                              Margin="5,0,5,0">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                <Setter Property="Tag" Value="Linked To"/>
                            </Style>
                        </ComboBox.Style>
                    </ComboBox>
                    
                    <Button Grid.Column="2" 
                            Content="Clear" 
                            Command="{Binding ClearFiltersCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="10,5"/>
                </Grid>
                
                <!-- Notes List -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding FilteredNotes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border MouseLeftButtonUp="Note_Click"
                                        Tag="{Binding}">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource NoteCardStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Value="True">
                                                    <DataTrigger.Binding>
                                                        <MultiBinding Converter="{x:Static converters:ObjectEqualityConverter.Instance}">
                                                            <Binding/>
                                                            <Binding Path="DataContext.SelectedNote" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                        </MultiBinding>
                                                    </DataTrigger.Binding>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        
                                        <!-- Header -->
                                        <Grid Grid.Row="0" Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Pin -->
                                            <TextBlock Grid.Column="0" Text="📌" FontSize="12"
                                                       Visibility="{Binding IsPinned, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}"
                                                       Margin="0,0,6,0"/>
                                            
                                            <!-- Category Badge -->
                                            <Border Grid.Column="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource GeneralBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Category}" Value="Meeting">
                                                                <Setter Property="Background" Value="{StaticResource MeetingBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Category}" Value="Idea">
                                                                <Setter Property="Background" Value="{StaticResource IdeaBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Category}" Value="Todo">
                                                                <Setter Property="Background" Value="{StaticResource TodoBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Category}" Value="Decision">
                                                                <Setter Property="Background" Value="{StaticResource DecisionBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Category}" Value="Observation">
                                                                <Setter Property="Background" Value="{StaticResource ObservationBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Category}" Value="Reflection">
                                                                <Setter Property="Background" Value="{StaticResource ReflectionBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Category}" Value="Reminder">
                                                                <Setter Property="Background" Value="{StaticResource ReminderBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding CategoryDisplay}" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                            </Border>
                                            
                                            <!-- Linked Entity -->
                                            <TextBlock Grid.Column="2" Text="{Binding LinkedToDisplay}" FontSize="11" 
                                                       FontStyle="Italic" Foreground="{DynamicResource HintTextBrush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            
                                            <!-- Date -->
                                            <TextBlock Grid.Column="3" Text="{Binding CreatedDisplay}" FontSize="11"
                                                       Foreground="{DynamicResource HintTextBrush}" VerticalAlignment="Center"/>
                                        </Grid>
                                        
                                        <!-- Title/Preview -->
                                        <TextBlock Grid.Row="1" Text="{Binding DisplayTitle}" 
                                                   FontWeight="SemiBold" FontSize="14"
                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        
                                        <!-- Tags -->
                                        <TextBlock Grid.Row="2" Text="{Binding Tags}" FontSize="11" Margin="0,4,0,0"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding Tags, Converter={x:Static converters:EmptyStringToVisibilityConverter.Instance}}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
            
            <!-- RIGHT: Note Detail (Detail) -->
            <Border Grid.Column="1" 
                    Background="{DynamicResource SurfaceBrush}" 
                    CornerRadius="12" 
                    Padding="20">
                <Grid>
                    <!-- No Note Selected -->
                    <Grid Visibility="{Binding HasSelectedNote, Converter={x:Static converters:ReverseBoolToVisConverter.Instance}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Path Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20M13,13V18H10V13H7L12,8L17,13H13Z"
                              Fill="{DynamicResource HintTextBrush}" Width="48" Height="48" Stretch="Uniform"
                              HorizontalAlignment="Center" Margin="0,0,0,16"/>
                        <TextBlock Text="Select a note to view details" FontSize="14" 
                                   Foreground="{DynamicResource HintTextBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="or click 'New Note' to create one" FontSize="12" 
                                   Foreground="{DynamicResource HintTextBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
                
                <!-- Note Detail View -->
                <Grid Visibility="{Binding HasSelectedNote, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Title -->
                    <TextBox Grid.Row="0" 
                             Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="{Binding IsReadOnly}"
                             FontSize="18" FontWeight="Bold"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource ForegroundBrush}"
                             Margin="0,0,0,8">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="Note title (optional)..." Foreground="{DynamicResource HintTextBrush}" FontSize="18" FontWeight="Bold"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    
                    <!-- Meta Row -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <ComboBox Grid.Column="0" 
                                  ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding EditCategory}"
                                  IsEnabled="{Binding IsEditing}"
                                  Width="110" Margin="0,0,10,0"/>
                        
                        <ComboBox Grid.Column="1" 
                                  ItemsSource="{Binding LinkedEntityTypes}"
                                  SelectedItem="{Binding EditLinkedEntityType}"
                                  IsEnabled="{Binding IsEditing}"
                                  Width="120" Margin="0,0,10,0"/>
                        
                        <!-- Dynamic linked entity picker -->
                        <ComboBox Grid.Column="2" 
                                  ItemsSource="{Binding TeamMembers}"
                                  SelectedItem="{Binding EditLinkedEntity}"
                                  DisplayMemberPath="FullName"
                                  IsEnabled="{Binding IsEditing}"
                                  Visibility="{Binding ShowTeamMemberPicker, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}"/>
                        <ComboBox Grid.Column="2" 
                                  ItemsSource="{Binding Projects}"
                                  SelectedItem="{Binding EditLinkedEntity}"
                                  DisplayMemberPath="Name"
                                  IsEnabled="{Binding IsEditing}"
                                  Visibility="{Binding ShowProjectPicker, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}"/>
                        <ComboBox Grid.Column="2" 
                                  ItemsSource="{Binding Kpis}"
                                  SelectedItem="{Binding EditLinkedEntity}"
                                  DisplayMemberPath="Name"
                                  IsEnabled="{Binding IsEditing}"
                                  Visibility="{Binding ShowKpiPicker, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}"/>
                        <ComboBox Grid.Column="2" 
                                  ItemsSource="{Binding Okrs}"
                                  SelectedItem="{Binding EditLinkedEntity}"
                                  DisplayMemberPath="Title"
                                  IsEnabled="{Binding IsEditing}"
                                  Visibility="{Binding ShowOkrPicker, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}"/>
                    </Grid>
                    
                    <!-- Content -->
                    <TextBox Grid.Row="2" 
                             Text="{Binding EditContent, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="{Binding IsReadOnly}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Background="{DynamicResource BackgroundBrush}"
                             Foreground="{DynamicResource ForegroundBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             Padding="10" FontSize="14"/>
                    
                    <!-- Tags -->
                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Text="Tags:" FontSize="12" Foreground="{DynamicResource HintTextBrush}" 
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding EditTags, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{Binding IsReadOnly}"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource AccentBrush}"
                                 FontSize="12" VerticalAlignment="Center">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <VisualBrush AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                        <VisualBrush.Visual>
                                                            <TextBlock Text="comma, separated, tags..." Foreground="{DynamicResource HintTextBrush}" FontSize="12"/>
                                                        </VisualBrush.Visual>
                                                    </VisualBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>
                    
                    <!-- Action Buttons -->
                    <Grid Grid.Row="4" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Left actions -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Content="📌" Command="{Binding TogglePinCommand}" 
                                    ToolTip="Toggle Pin" Style="{StaticResource SecondaryButtonStyle}" 
                                    Width="36" Height="36" Margin="0,0,8,0"/>
                            <Button Content="📁" Command="{Binding ArchiveNoteCommand}" 
                                    ToolTip="Archive" Style="{StaticResource SecondaryButtonStyle}" 
                                    Width="36" Height="36" Margin="0,0,8,0"/>
                            <Button Content="🗑" Command="{Binding DeleteNoteCommand}" 
                                    ToolTip="Delete" Style="{StaticResource SecondaryButtonStyle}" 
                                    Width="36" Height="36"/>
                        </StackPanel>
                        
                        <!-- Right actions -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <!-- View mode buttons -->
                            <Button Content="Edit" Command="{Binding EditNoteCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" Padding="20,8"
                                    Visibility="{Binding IsReadOnly, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}"/>
                            
                            <!-- Edit mode buttons -->
                            <Button Content="Cancel" Command="{Binding CancelEditCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" Padding="15,8" Margin="0,0,8,0"
                                    Visibility="{Binding IsEditing, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}"/>
                            <Button Content="Save" Command="{Binding SaveNoteCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" Padding="20,8"
                                    Visibility="{Binding IsEditing, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
