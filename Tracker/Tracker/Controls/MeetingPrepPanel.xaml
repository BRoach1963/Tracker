<UserControl x:Class="Tracker.Controls.MeetingPrepPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:Tracker.Common.Converters"
             xmlns:datamodels="clr-namespace:Tracker.DataModels"
             xmlns:enums="clr-namespace:Tracker.Common.Enums"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="400"
             AutomationProperties.Name="Meeting Prep Panel"
             AutomationProperties.HelpText="Auto-generated preparation for 1:1 meetings">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles/DialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Priority Colors -->
            <SolidColorBrush x:Key="CriticalPriorityBrush" Color="#F44336"/>
            <SolidColorBrush x:Key="HighPriorityBrush" Color="#FF9800"/>
            <SolidColorBrush x:Key="NormalPriorityBrush" Color="#2196F3"/>
            <SolidColorBrush x:Key="LowPriorityBrush" Color="#9E9E9E"/>
            
            <!-- Priority to Brush Converter -->
            <converters:PrepItemPriorityToBrushConverter x:Key="PriorityToBrushConverter"/>
            
            <!-- Stat Card Style -->
            <Style x:Key="StatCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="16,12"/>
                <Setter Property="Margin" Value="4"/>
            </Style>
            
            <!-- Section Header Style -->
            <Style x:Key="SectionHeaderStyle" TargetType="Expander">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Margin" Value="0,8,0,0"/>
                <Setter Property="Padding" Value="0"/>
            </Style>
            
            <!-- Prep Item Card Style -->
            <Style x:Key="PrepItemCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="3,0,0,0"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Padding" Value="12,10"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            
            <!-- Add to Agenda Button Style -->
            <Style x:Key="AddToAgendaButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="6,3"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource PrimaryDarkBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            
            <!-- Prep Item DataTemplate -->
            <DataTemplate x:Key="PrepItemTemplate" DataType="{x:Type datamodels:PrepItem}">
                <Border Style="{StaticResource PrepItemCardStyle}"
                        BorderBrush="{Binding Priority, Converter={StaticResource PriorityToBrushConverter}}"
                        Opacity="{Binding IsAddedToAgenda, Converter={x:Static converters:BoolToOpacityConverter.Instance}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap"
                                       FontWeight="Medium" FontSize="13"
                                       Foreground="{DynamicResource ForegroundBrush}"/>
                            <TextBlock Text="{Binding Subtext}" TextWrapping="Wrap"
                                       FontSize="12" Margin="0,2,0,0"
                                       Foreground="{DynamicResource HintTextBrush}"
                                       Visibility="{Binding Subtext, Converter={x:Static converters:StringToVisibilityConverter.Instance}}"/>
                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                       FontSize="11" Margin="0,4,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       MaxHeight="40" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding Description, Converter={x:Static converters:StringToVisibilityConverter.Instance}}"/>
                        </StackPanel>
                        
                        <Button Grid.Column="1" Content="+ Agenda"
                                Style="{StaticResource AddToAgendaButtonStyle}"
                                Command="{Binding DataContext.AddToAgendaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                ToolTip="Add this item to meeting agenda"
                                Visibility="{Binding IsAddedToAgenda, Converter={x:Static converters:InverseBoolToVisibilityConverter.Instance}}"
                                VerticalAlignment="Top"/>
                        
                        <TextBlock Grid.Column="1" Text="✓ Added"
                                   FontSize="11" VerticalAlignment="Top"
                                   Foreground="{DynamicResource SuccessBrush}"
                                   Visibility="{Binding IsAddedToAgenda, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}"/>
                    </Grid>
                </Border>
            </DataTemplate>
            
            <!-- Section DataTemplate -->
            <DataTemplate x:Key="PrepSectionTemplate" DataType="{x:Type datamodels:PrepSection}">
                <Expander IsExpanded="{Binding IsExpanded}" Style="{StaticResource SectionHeaderStyle}">
                    <Expander.Header>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                                           Foreground="{DynamicResource ForegroundBrush}"/>
                            </StackPanel>
                            
                            <Border Grid.Column="1" Background="{DynamicResource SurfaceAltBrush}"
                                    CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ItemCount}" FontSize="12"
                                           Foreground="{DynamicResource HintTextBrush}"/>
                            </Border>
                        </Grid>
                    </Expander.Header>
                    
                    <StackPanel Margin="0,4,0,8">
                        <TextBlock Text="{Binding Description}" FontSize="12" Margin="0,0,0,8"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Visibility="{Binding Description, Converter={x:Static converters:StringToVisibilityConverter.Instance}}"/>
                        <ItemsControl ItemsSource="{Binding ItemsByPriority}"
                                      ItemTemplate="{StaticResource PrepItemTemplate}"/>
                    </StackPanel>
                </Expander>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource PrimaryBrush}" CornerRadius="8,8,0,0" Padding="16">
            <StackPanel>
                <TextBlock Text="📋 Meeting Prep" FontSize="14" FontWeight="Medium"
                           Foreground="White" Opacity="0.9"/>
                <TextBlock Text="{Binding MeetingPrep.MeetingTitle}" FontSize="20" FontWeight="Bold"
                           Foreground="White" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding MeetingPrep.ScheduledDateDisplay}" FontSize="13"
                           Foreground="White" Opacity="0.85" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>
        
        <!-- Stats Bar -->
        <Border Grid.Row="1" Background="{DynamicResource BackgroundBrush}" Padding="8,12">
            <UniformGrid Columns="3">
                <Border Style="{StaticResource StatCardStyle}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding MeetingPrep.OverdueTaskCount}" FontSize="24" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource CriticalPriorityBrush}"/>
                        <TextBlock Text="Overdue" FontSize="11" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource HintTextBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCardStyle}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding MeetingPrep.OpenActionItemCount}" FontSize="24" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource HighPriorityBrush}"/>
                        <TextBlock Text="Action Items" FontSize="11" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource HintTextBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCardStyle}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding MeetingPrep.OkrsAtRiskCount}" FontSize="24" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource WarningBrush}"/>
                        <TextBlock Text="OKRs at Risk" FontSize="11" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource HintTextBrush}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </Border>
        
        <!-- Sections List -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="16,0">
            <StackPanel>
                <!-- Loading Indicator -->
                <StackPanel Visibility="{Binding IsLoading, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40">
                    <TextBlock Text="Generating prep..." FontSize="14"
                               Foreground="{DynamicResource HintTextBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
                
                <!-- Empty State -->
                <StackPanel Visibility="{Binding IsEmpty, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}"
                            HorizontalAlignment="Center" Margin="0,40">
                    <TextBlock Text="✨" FontSize="40" HorizontalAlignment="Center"/>
                    <TextBlock Text="Looking good!" FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,8,0,0"
                               Foreground="{DynamicResource ForegroundBrush}"/>
                    <TextBlock Text="No notable items to discuss" FontSize="13"
                               HorizontalAlignment="Center" Margin="0,4,0,0"
                               Foreground="{DynamicResource HintTextBrush}"/>
                </StackPanel>
                
                <!-- Prep Sections -->
                <ItemsControl ItemsSource="{Binding MeetingPrep.NonEmptySections}"
                              ItemTemplate="{StaticResource PrepSectionTemplate}"
                              Visibility="{Binding HasContent, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}"/>
                
                <!-- AI Suggestions -->
                <Expander Header="💡 AI Suggested Topics" IsExpanded="False"
                          Visibility="{Binding MeetingPrep.HasAiSuggestions, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}"
                          Style="{StaticResource SectionHeaderStyle}" Margin="0,12,0,8">
                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="4" Padding="12" Margin="0,8,0,0">
                        <TextBlock Text="{Binding MeetingPrep.AiSuggestedAgenda}" TextWrapping="Wrap"
                                   FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </Border>
                </Expander>
            </StackPanel>
        </ScrollViewer>
        
        <!-- Footer -->
        <Border Grid.Row="3" Background="{DynamicResource BackgroundBrush}" Padding="16,12"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                           FontSize="11" Foreground="{DynamicResource HintTextBrush}">
                    <Run Text="Generated"/>
                    <Run Text="{Binding MeetingPrep.GeneratedAt, StringFormat={}{0:h:mm tt}}"/>
                </TextBlock>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Refresh" Command="{Binding RefreshCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            FontSize="12" Padding="12,6" Margin="0,0,8,0"/>
                    <Button Content="Close" Command="{Binding CloseCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            FontSize="12" Padding="12,6"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
