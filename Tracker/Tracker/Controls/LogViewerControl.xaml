<UserControl x:Class="Tracker.Controls.LogViewerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:Tracker.Common.Converters"
             xmlns:customControls="clr-namespace:Tracker.Controls.CustomControls"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles/DialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Log level colors -->
            <SolidColorBrush x:Key="DebugBrush" Color="#6B7280"/>
            <SolidColorBrush x:Key="InfoBrush" Color="#3B82F6"/>
            <SolidColorBrush x:Key="WarnBrush" Color="#F59E0B"/>
            <SolidColorBrush x:Key="ErrorBrush" Color="#EF4444"/>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" 
                Background="#1E293B" 
                Padding="15,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20M13,17V19H11V17H13M13,11V15H11V11H13Z"
                          Fill="White" Width="20" Height="20" Stretch="Uniform" Margin="0,0,10,0"/>
                    <TextBlock Text="Log Viewer" FontWeight="SemiBold" FontSize="16" Foreground="White"/>
                </StackPanel>
                <TextBlock Grid.Column="1" 
                           Text="{Binding TotalEntries, StringFormat='{}{0} entries'}"
                           Foreground="White" Opacity="0.7" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        
        <!-- Filters -->
        <Border Grid.Row="1" Background="{DynamicResource BackgroundBrush}" Padding="15,10" BorderBrush="#334155" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Date Range -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,15,0">
                    <TextBlock Text="From:" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="{DynamicResource ForegroundBrush}"/>
                    <customControls:CalendarButton SelectedDate="{Binding StartDate, Mode=TwoWay}" Width="120"/>
                    <TextBlock Text="To:" VerticalAlignment="Center" Margin="15,0,5,0" Foreground="{DynamicResource ForegroundBrush}"/>
                    <customControls:CalendarButton SelectedDate="{Binding EndDate, Mode=TwoWay}" Width="120"/>
                </StackPanel>
                
                <!-- Level Filter -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,15,0">
                    <TextBlock Text="Level:" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="{DynamicResource ForegroundBrush}"/>
                    <ComboBox SelectedItem="{Binding SelectedLevel}" ItemsSource="{Binding LogLevels}" Width="100"/>
                </StackPanel>
                
                <!-- Search -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,15,0">
                    <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="{DynamicResource ForegroundBrush}"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="200" 
                             VerticalContentAlignment="Center" Padding="5,3"/>
                </StackPanel>
                
                <!-- Search Button -->
                <Button Grid.Column="3" Content="Search" Command="{Binding SearchCommand}" 
                        Style="{StaticResource DialogButtonStyle}" Padding="15,5"/>
                
                <!-- Actions -->
                <StackPanel Grid.Column="5" Orientation="Horizontal">
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" 
                            Style="{StaticResource DialogButtonStyle}" Padding="10,5" Margin="0,0,5,0"/>
                    <Button Content="Clear Old Logs" Command="{Binding ClearOldLogsCommand}" 
                            Style="{StaticResource DialogButtonStyle}" Padding="10,5" Margin="0,0,5,0"/>
                    <Button Content="Open Folder" Command="{Binding OpenFolderCommand}" 
                            Style="{StaticResource DialogButtonStyle}" Padding="10,5"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Log Files List / Log Content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Log Files List -->
            <Border Grid.Column="0" Background="#0F172A" BorderBrush="#334155" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="Log Files" FontWeight="SemiBold" Padding="10,8" 
                               Foreground="White" Background="#1E293B"/>
                    
                    <ListBox Grid.Row="1" ItemsSource="{Binding LogFiles}" 
                             SelectedItem="{Binding SelectedLogFile}"
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,6" BorderBrush="#334155" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="{Binding Date, StringFormat='{}{0:MMM dd, yyyy}'}" 
                                                   FontWeight="SemiBold" Foreground="White"/>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal">
                                            <TextBlock Text="{Binding SizeFormatted}" FontSize="11" Foreground="#94A3B8"/>
                                            <TextBlock Text=" • Today" FontSize="11" Foreground="#22C55E" 
                                                       Visibility="{Binding IsCurrentLog, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            
            <!-- Log Content -->
            <DataGrid Grid.Column="1" ItemsSource="{Binding LogEntries}" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True"
                      Background="{DynamicResource BackgroundBrush}"
                      RowBackground="Transparent"
                      AlternatingRowBackground="#0F172A"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#334155"
                      BorderThickness="0"
                      HeadersVisibility="Column"
                      CanUserReorderColumns="False"
                      SelectionMode="Single"
                      RowHeight="24"
                      ColumnHeaderHeight="28"
                      FontSize="11"
                      FontFamily="Consolas"
                      RowStyle="{StaticResource CompactDataGridRowStyle}"
                      CellStyle="{StaticResource CompactDataGridCellStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time" Binding="{Binding TimeDisplay}" Width="85">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Level" Binding="{Binding LevelDisplay}" Width="55">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LevelDisplay}" Value="DEBUG">
                                        <Setter Property="Foreground" Value="#6B7280"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding LevelDisplay}" Value="INFO">
                                        <Setter Property="Foreground" Value="#3B82F6"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding LevelDisplay}" Value="WARN">
                                        <Setter Property="Foreground" Value="#F59E0B"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding LevelDisplay}" Value="ERROR">
                                        <Setter Property="Foreground" Value="#EF4444"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Source" Binding="{Binding Component}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#A78BFA"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="ToolTip" Value="{Binding Message}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        
        <!-- Status Bar -->
        <Border Grid.Row="3" Background="#1E293B" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#94A3B8" FontSize="11"/>
                <TextBlock Grid.Column="1" Text="{Binding LogDirectory}" Foreground="#64748B" FontSize="11"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>

