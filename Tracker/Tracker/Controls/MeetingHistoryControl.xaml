<UserControl x:Class="Tracker.Controls.MeetingHistoryControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Tracker.Controls"
             xmlns:converters="clr-namespace:Tracker.Common.Converters"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="400">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles/DialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" 
                Background="{DynamicResource AccentBrush}" 
                CornerRadius="6,6,0,0"
                Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Meeting History" 
                           FontWeight="SemiBold" 
                           FontSize="14"
                           Foreground="{DynamicResource BackgroundBrush}"/>
                <TextBlock Grid.Column="1" 
                           Text="{Binding MeetingCount, StringFormat='{}{0} meetings'}"
                           FontSize="12"
                           Foreground="{DynamicResource BackgroundBrush}"
                           Opacity="0.8"/>
            </Grid>
        </Border>
        
        <!-- Meeting List -->
        <Border Grid.Row="1" 
                BorderBrush="{DynamicResource ForegroundBrush}" 
                BorderThickness="1,0,1,1"
                CornerRadius="0,0,6,6"
                Background="{DynamicResource BackgroundBrush}">
            <Grid>
                <!-- Empty State -->
                <TextBlock Text="No meetings yet" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource ForegroundBrush}"
                           Opacity="0.5"
                           Visibility="{Binding HasNoMeetings, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}"/>
                
                <!-- Meeting List -->
                <ListView ItemsSource="{Binding Meetings}"
                          SelectedItem="{Binding SelectedMeeting}"
                          BorderThickness="0"
                          Background="Transparent"
                          Visibility="{Binding HasMeetings, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,8" 
                                    BorderBrush="{DynamicResource ForegroundBrush}" 
                                    BorderThickness="0,0,0,1"
                                    Background="Transparent">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <!-- Date -->
                                    <TextBlock Grid.Column="0" Grid.Row="0"
                                               Text="{Binding Date, StringFormat='{}{0:MMM dd, yyyy}'}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                    
                                    <!-- Status Badge -->
                                    <Border Grid.Column="2" Grid.Row="0"
                                            Background="{Binding Status, Converter={x:Static converters:MeetingStatusToColorConverter.Instance}}"
                                            CornerRadius="4"
                                            Padding="6,2">
                                        <TextBlock Text="{Binding Status}"
                                                   FontSize="10"
                                                   Foreground="White"/>
                                    </Border>
                                    
                                    <!-- Description -->
                                    <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1"
                                               Text="{Binding Description}"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               Opacity="0.7"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,4,0,0"/>
                                    
                                    <!-- Task Count -->
                                    <TextBlock Grid.Column="2" Grid.Row="1"
                                               Text="{Binding Tasks.Count, StringFormat='{}{0} tasks'}"
                                               FontSize="11"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               Opacity="0.5"
                                               Margin="0,4,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</UserControl>

