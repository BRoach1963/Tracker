<UserControl x:Class="Tracker.Controls.SchedulingAssistantControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Tracker.Controls"
             xmlns:converters="clr-namespace:Tracker.Common.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="400">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" 
                   Text="Scheduling Assistant"
                   FontWeight="SemiBold"
                   FontSize="14"
                   Foreground="{DynamicResource ForegroundBrush}"
                   Margin="0,0,0,8"/>

        <!-- Date Navigation -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="◀" 
                    Command="{Binding PreviousDayCommand}"
                    Width="28" Height="28"
                    Padding="0"/>
            <TextBlock Text="{Binding SelectedDate, StringFormat='{}{0:dddd, MMMM d}'}"
                       FontWeight="Medium"
                       VerticalAlignment="Center"
                       Margin="10,0"
                       Foreground="{DynamicResource ForegroundBrush}"/>
            <Button Content="▶" 
                    Command="{Binding NextDayCommand}"
                    Width="28" Height="28"
                    Padding="0"/>
            <Button Content="Today" 
                    Command="{Binding TodayCommand}"
                    Margin="10,0,0,0"
                    Padding="8,4"/>
        </StackPanel>

        <!-- Timeline View -->
        <Border Grid.Row="2" 
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Legend -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8">
                    <Rectangle Width="12" Height="12" Fill="{DynamicResource AccentBrush}" RadiusX="2" RadiusY="2"/>
                    <TextBlock Text="Your Calendar" Margin="4,0,16,0" FontSize="11" Foreground="{DynamicResource HintTextBrush}"/>
                    <Rectangle Width="12" Height="12" Fill="#E57373" RadiusX="2" RadiusY="2"/>
                    <TextBlock Text="{Binding TeamMemberName}" Margin="4,0,0,0" FontSize="11" Foreground="{DynamicResource HintTextBrush}"/>
                </StackPanel>

                <!-- Loading Indicator -->
                <Grid Grid.Row="1" Visibility="{Binding IsLoading, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}">
                    <TextBlock Text="Loading calendars..."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontStyle="Italic"
                               Foreground="{DynamicResource HintTextBrush}"/>
                </Grid>

                <!-- Calendar Grid -->
                <ScrollViewer Grid.Row="1" 
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding IsLoading, Converter={x:Static converters:ReverseBoolToVisibilityConverter.Instance}}">
                    <Grid x:Name="TimelineGrid" Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Time Labels (populated in code-behind) -->
                        <ItemsControl Grid.Column="0" ItemsSource="{Binding TimeLabels}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" 
                                               Height="30" 
                                               FontSize="10"
                                               Foreground="{DynamicResource HintTextBrush}"
                                               VerticalAlignment="Top"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Manager Timeline -->
                        <Grid Grid.Column="1" Background="{DynamicResource SurfaceVariantBrush}" Margin="2">
                            <ItemsControl ItemsSource="{Binding ManagerBusyBlocks}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource AccentBrush}"
                                                Opacity="0.7"
                                                CornerRadius="2"
                                                Height="{Binding Height}"
                                                ToolTip="{Binding Tooltip}">
                                            <Border.RenderTransform>
                                                <TranslateTransform Y="{Binding Top}"/>
                                            </Border.RenderTransform>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                        <!-- Team Member Timeline -->
                        <Grid Grid.Column="2" Background="{DynamicResource SurfaceVariantBrush}" Margin="2">
                            <!-- Error message if calendar unavailable -->
                            <TextBlock Text="{Binding CalendarError}"
                                       TextWrapping="Wrap"
                                       FontSize="10"
                                       Foreground="{DynamicResource WarningBrush}"
                                       Margin="4"
                                       Visibility="{Binding HasCalendarError, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}"/>
                            
                            <ItemsControl ItemsSource="{Binding TeamMemberBusyBlocks}"
                                          Visibility="{Binding HasCalendarError, Converter={x:Static converters:ReverseBoolToVisibilityConverter.Instance}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#E57373"
                                                Opacity="0.7"
                                                CornerRadius="2"
                                                Height="{Binding Height}"
                                                ToolTip="{Binding Tooltip}">
                                            <Border.RenderTransform>
                                                <TranslateTransform Y="{Binding Top}"/>
                                            </Border.RenderTransform>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Suggested Times -->
        <StackPanel Grid.Row="3" Margin="0,8,0,0">
            <TextBlock Text="Suggested Times" 
                       FontWeight="Medium"
                       FontSize="12"
                       Foreground="{DynamicResource ForegroundBrush}"
                       Margin="0,0,0,4"/>
            <ItemsControl ItemsSource="{Binding SuggestedSlots}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.SelectSlotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                HorizontalAlignment="Left"
                                Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Start, StringFormat='{}{0:h:mm tt}'}" Margin="0,0,4,0"/>
                                <TextBlock Text="-" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding End, StringFormat='{}{0:h:mm tt}'}"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="No available times found for this day"
                       FontStyle="Italic"
                       FontSize="11"
                       Foreground="{DynamicResource HintTextBrush}"
                       Visibility="{Binding HasNoSuggestedSlots, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}"/>
        </StackPanel>
    </Grid>
</UserControl>
