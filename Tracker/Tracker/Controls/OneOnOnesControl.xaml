<UserControl x:Class="Tracker.Controls.OneOnOnesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Tracker.Controls"
             xmlns:commands="clr-namespace:Tracker.Command"
             xmlns:enums="clr-namespace:Tracker.Common.Enums"
             xmlns:converters="clr-namespace:Tracker.Common.Converters"
             xmlns:viewModels="clr-namespace:Tracker.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1200"
             d:DataContext="{d:DesignInstance Type=viewModels:TrackerMainViewModel}"
             AutomationProperties.Name="One on One Meetings"
             AutomationProperties.HelpText="Schedule and manage 1:1 meetings with team members">
    
    <UserControl.Resources>
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource HintTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
        </Style>
        
        <!-- Team Member Card Style -->
        <Style x:Key="TeamMemberCardStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        
        <!-- Meeting Row Style -->
        <Style x:Key="MeetingRowStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Panel Header Style -->
        <Style x:Key="PanelHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource HintTextBrush}"/>
            <Setter Property="Margin" Value="12,12,12,8"/>
        </Style>

        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>
    
    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- ROW 0: HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel>
                <TextBlock Text="1:1 Meetings" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}"/>
                <TextBlock Text="Track and manage your team check-ins" FontSize="14" Foreground="{DynamicResource HintTextBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            
            <Button Grid.Column="1" 
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{x:Static commands:DialogCommands.LaunchDialogCommand}"
                    CommandParameter="{x:Static enums:DialogType.AddOneOnOne}"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Schedule 1:1 Meeting"
                    AutomationProperties.HelpText="Open dialog to schedule a new one-on-one meeting"
                    ToolTip="Schedule a new 1:1 meeting"
                    TabIndex="100">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"
                          Fill="{DynamicResource BackgroundBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"/>
                    <TextBlock Text="Schedule 1:1"/>
                </StackPanel>
            </Button>
        </Grid>
        
        <!-- ROW 1: STATS BAR - This Month Stats -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Border Grid.Column="0" Style="{StaticResource StatCardStyle}" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}">
                        <Run Text="COMPLETED"/>
                        <Run Text=" this month" Foreground="{DynamicResource HintTextBrush}" FontWeight="Normal" FontSize="8"/>
                    </TextBlock>
                    <TextBlock Text="{Binding CompletedMeetingsThisMonth, FallbackValue='0'}" Style="{StaticResource StatValue}" Foreground="#10B981"/>
                </StackPanel>
            </Border>
            
            <Border Grid.Column="1" Style="{StaticResource StatCardStyle}" Margin="3,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}">
                        <Run Text="SCHEDULED"/>
                        <Run Text=" this month" Foreground="{DynamicResource HintTextBrush}" FontWeight="Normal" FontSize="8"/>
                    </TextBlock>
                    <TextBlock Text="{Binding ScheduledMeetingsThisMonth, FallbackValue='0'}" Style="{StaticResource StatValue}" Foreground="{DynamicResource AccentBrush}"/>
                </StackPanel>
            </Border>
            
            <Border Grid.Column="2" Style="{StaticResource StatCardStyle}" Margin="3,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}">
                        <Run Text="CANCELLED"/>
                        <Run Text=" this month" Foreground="{DynamicResource HintTextBrush}" FontWeight="Normal" FontSize="8"/>
                    </TextBlock>
                    <TextBlock Text="{Binding CancelledMeetingsThisMonth, FallbackValue='0'}" Style="{StaticResource StatValue}" Foreground="#EF4444"/>
                </StackPanel>
            </Border>
            
            <Border Grid.Column="3" Style="{StaticResource StatCardStyle}" Margin="6,0,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}">
                        <Run Text="OPEN TASKS"/>
                        <Run Text=" from meetings" Foreground="{DynamicResource HintTextBrush}" FontWeight="Normal" FontSize="8"/>
                    </TextBlock>
                    <TextBlock Text="{Binding OpenMeetingTasksCount, FallbackValue='0'}" Style="{StaticResource StatValue}" Foreground="#F59E0B"/>
                </StackPanel>
            </Border>
        </Grid>
        
        <!-- ROW 2: 3-PANEL LAYOUT -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="180"/>
                <ColumnDefinition Width="*" MinWidth="280"/>
                <ColumnDefinition Width="350" MinWidth="300"/>
            </Grid.ColumnDefinitions>
            
            <!-- ========== LEFT PANEL: Team Members ========== -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="TEAM MEMBERS" Style="{StaticResource PanelHeaderStyle}"/>
                    
                    <!-- Quick Search -->
                    <Border Grid.Row="1" Background="{DynamicResource BackgroundBrush}" CornerRadius="6" Margin="10,0,10,8" Padding="8,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                                  Fill="{DynamicResource HintTextBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding MemberSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0" FontSize="12"
                                     Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </Grid>
                    </Border>
                    
                    <!-- Team Member List -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="6,0">
                        <ItemsControl ItemsSource="{Binding TeamMembers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TeamMemberCardStyle}"
                                            MouseLeftButtonUp="TeamMember_Click"
                                            Tag="{Binding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Avatar -->
                                            <Grid Width="32" Height="32">
                                                <!-- Background for initials fallback -->
                                                <Ellipse Fill="{DynamicResource AccentBrush}"
                                                         Visibility="{Binding ProfileImage, Converter={x:Static converters:ByteArrayToVisibilityConverter.InverseInstance}}"/>
                                                <TextBlock Text="{Binding Initials}" FontSize="11" FontWeight="Bold"
                                                           Foreground="{DynamicResource BackgroundBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding ProfileImage, Converter={x:Static converters:ByteArrayToVisibilityConverter.InverseInstance}}"/>
                                                <!-- Profile Image -->
                                                <Ellipse Visibility="{Binding ProfileImage, Converter={x:Static converters:ByteArrayToVisibilityConverter.Instance}}">
                                                    <Ellipse.Fill>
                                                        <ImageBrush ImageSource="{Binding ProfileImage, Converter={x:Static converters:ByteArrayToImageSourceConverter.Instance}}"
                                                                    RenderOptions.BitmapScalingMode="HighQuality"
                                                                    Stretch="UniformToFill"/>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                            </Grid>
                                            
                                            <!-- Name -->
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FullName}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource ForegroundBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock FontSize="10" Foreground="{DynamicResource HintTextBrush}">
                                                    <Run Text="Last: "/>
                                                    <Run Text="{Binding LastOneOnOneDisplay, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            
                                            <!-- Meeting Count Badge -->
                                            <Border Grid.Column="2" Background="{DynamicResource BackgroundBrush}" 
                                                    CornerRadius="10" Padding="6,2" VerticalAlignment="Center"
                                                    Visibility="{Binding UpcomingMeetingCount, Converter={x:Static converters:IntToVisibilityConverter.Instance}}">
                                                <TextBlock Text="{Binding UpcomingMeetingCount}" FontSize="10" FontWeight="Bold"
                                                           Foreground="{DynamicResource AccentBrush}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
            
            <!-- ========== MIDDLE PANEL: Meetings List ========== -->
            <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Margin="4,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Header with member name -->
                    <Grid Grid.Row="0" Margin="12,12,12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedMemberForMeetings.FullName, FallbackValue='Select a team member'}"
                                       FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}"/>
                            <TextBlock Text="1:1 MEETINGS" Style="{StaticResource SectionHeader}" Margin="0,2,0,0"/>
                        </StackPanel>
                        
                        <!-- Add meeting for this member -->
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4"
                                Command="{Binding AddTeamMemberOneOnOneCommand}"
                                Visibility="{Binding SelectedMemberForMeetings, Converter={x:Static converters:NullToVisibilityConverter.Instance}}"
                                ToolTip="Schedule 1:1 with this member">
                            <Path Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"
                                  Fill="{DynamicResource ForegroundBrush}" Width="12" Height="12" Stretch="Uniform"/>
                        </Button>
                    </Grid>
                    
                    <!-- Filter: Upcoming / Past -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,0,10,8">
                        <RadioButton x:Name="ShowUpcoming" Content="Upcoming" IsChecked="True" GroupName="TimeFilter" 
                                     Style="{StaticResource SegmentedButtonStyle}" Checked="MeetingFilter_Changed"/>
                        <RadioButton x:Name="ShowPast" Content="Past" GroupName="TimeFilter" 
                                     Style="{StaticResource SegmentedButtonStyle}" Checked="MeetingFilter_Changed"/>
                        <RadioButton x:Name="ShowAllTime" Content="All" GroupName="TimeFilter" 
                                     Style="{StaticResource SegmentedButtonStyle}" Checked="MeetingFilter_Changed"/>
                    </StackPanel>
                    
                    <!-- Meetings List -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="6,0,6,6">
                        <ItemsControl x:Name="MeetingsListControl" ItemsSource="{Binding SelectedMemberMeetings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource MeetingRowStyle}"
                                            MouseLeftButtonUp="Meeting_Click"
                                            Tag="{Binding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Date -->
                                            <StackPanel>
                                                <TextBlock Text="{Binding Date, StringFormat='{}{0:MMM dd}'}" 
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource ForegroundBrush}"/>
                                                <TextBlock Text="{Binding StartTime, StringFormat='{}{0:h\\:mm tt}'}" 
                                                           FontSize="10" Foreground="{DynamicResource HintTextBrush}"/>
                                            </StackPanel>
                                            
                                            <!-- Description & Task indicator -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                                                <TextBlock Text="{Binding DescriptionPreview}" FontSize="11"
                                                           Foreground="{DynamicResource HintTextBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                                            Visibility="{Binding IncompleteTaskCount, Converter={x:Static converters:IntToVisibilityConverter.Instance}}">
                                                    <Path Data="M9,5V9H21V5M9,19H21V15H9M9,14H21V10H9M4,9H8V5H4M4,19H8V15H4M4,14H8V10H4V14Z"
                                                          Fill="{DynamicResource AccentBrush}" Width="10" Height="10" Stretch="Uniform"/>
                                                    <TextBlock FontSize="10" Foreground="{DynamicResource AccentBrush}" Margin="4,0,0,0">
                                                        <Run Text="{Binding IncompleteTaskCount, Mode=OneWay}"/>
                                                        <Run Text=" open tasks"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                            
                                            <!-- Status Badge -->
                                            <Border Grid.Column="2" CornerRadius="6" Padding="8,4" VerticalAlignment="Center"
                                                    Background="{Binding Status, Converter={x:Static converters:MeetingStatusToColorConverter.Instance}}">
                                                <TextBlock Text="{Binding Status}" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        
                        <!-- Empty State -->
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedMemberForMeetings}" Value="{x:Null}">
                                        <Setter Property="Content">
                                            <Setter.Value>
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,60,0,0">
                                                    <Path Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z"
                                                          Fill="{DynamicResource HintTextBrush}" Width="40" Height="40" Stretch="Uniform" Opacity="0.4"/>
                                                    <TextBlock Text="Select a team member" FontSize="13" 
                                                               Foreground="{DynamicResource HintTextBrush}" Margin="0,12,0,0"/>
                                                </StackPanel>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                    </ScrollViewer>
                </Grid>
            </Border>
            
            <!-- ========== RIGHT PANEL: Meeting Details ========== -->
            <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Margin="8,0,0,0">
                <!-- Has Selection -->
                <Grid Visibility="{Binding SelectedOneOnOne, Converter={x:Static converters:NullToVisibilityConverter.Instance}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                        <StackPanel>
                            <!-- Meeting Header -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <Grid Width="50" Height="50">
                                    <!-- Background for initials fallback -->
                                    <Ellipse Fill="{DynamicResource AccentBrush}"
                                             Visibility="{Binding SelectedOneOnOne.TeamMember.ProfileImage, Converter={x:Static converters:ByteArrayToVisibilityConverter.InverseInstance}}"/>
                                    <TextBlock Text="{Binding SelectedOneOnOne.TeamMember.Initials, Mode=OneWay}" 
                                               FontSize="18" FontWeight="Bold"
                                               Foreground="{DynamicResource BackgroundBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding SelectedOneOnOne.TeamMember.ProfileImage, Converter={x:Static converters:ByteArrayToVisibilityConverter.InverseInstance}}"/>
                                    <!-- Profile Image -->
                                    <Ellipse Visibility="{Binding SelectedOneOnOne.TeamMember.ProfileImage, Converter={x:Static converters:ByteArrayToVisibilityConverter.Instance}}">
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="{Binding SelectedOneOnOne.TeamMember.ProfileImage, Converter={x:Static converters:ByteArrayToImageSourceConverter.Instance}}"
                                                        RenderOptions.BitmapScalingMode="HighQuality"
                                                        Stretch="UniformToFill"/>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                </Grid>
                                
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedOneOnOne.TeamMemberName, Mode=OneWay}"
                                               FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource HintTextBrush}">
                                        <Run Text="{Binding SelectedOneOnOne.Date, StringFormat='{}{0:dddd, MMMM d}', Mode=OneWay}"/>
                                        <Run Text=" at "/>
                                        <Run Text="{Binding SelectedOneOnOne.StartTime, StringFormat='{}{0:h\\:mm tt}', Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                            
                            <!-- Status & Duration Row -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <Border CornerRadius="8" Padding="10,5"
                                        Background="{Binding SelectedOneOnOne.Status, Converter={x:Static converters:MeetingStatusToColorConverter.Instance}}">
                                    <TextBlock Text="{Binding SelectedOneOnOne.Status, Mode=OneWay}" 
                                               FontSize="11" FontWeight="Bold" Foreground="White"/>
                                </Border>
                                
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Path Data="M12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22C6.47,22 2,17.5 2,12A10,10 0 0,1 12,2M12.5,7V12.25L17,14.92L16.25,16.15L11,13V7H12.5Z"
                                          Fill="{DynamicResource HintTextBrush}" Width="14" Height="14" Stretch="Uniform"/>
                                    <TextBlock Text="{Binding SelectedOneOnOne.Duration, StringFormat='{}{0:h\\:mm}', Mode=OneWay}"
                                               FontSize="12" Foreground="{DynamicResource HintTextBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            
                            <!-- Notes Section -->
                            <TextBlock Text="NOTES" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                            <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                                <TextBlock Text="{Binding SelectedOneOnOne.Description, Mode=OneWay, TargetNullValue='No notes recorded'}"
                                           Foreground="{DynamicResource ForegroundBrush}" TextWrapping="Wrap" FontSize="12" LineHeight="18"/>
                            </Border>
                            
                            <!-- Agenda Section -->
                            <TextBlock Text="AGENDA ITEMS" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                            <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                                <ItemsControl ItemsSource="{Binding SelectedOneOnOne.AgendaItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="5" Height="5" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,5,0,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Description}" FontSize="12"
                                                           Foreground="{DynamicResource ForegroundBrush}" TextWrapping="Wrap" Margin="8,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            
                            <!-- Action Items Section -->
                            <TextBlock Text="ACTION ITEMS" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                            <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                                <ItemsControl ItemsSource="{Binding SelectedOneOnOne.Tasks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <CheckBox IsChecked="{Binding IsCompleted}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                                
                                                <TextBlock Grid.Column="1" Text="{Binding Description}" FontSize="12"
                                                           Foreground="{DynamicResource ForegroundBrush}" TextWrapping="Wrap" Margin="8,0,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                    <Setter Property="Opacity" Value="0.5"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                
                                                <TextBlock Grid.Column="2" Text="{Binding DueDate, StringFormat='{}{0:M/d}'}" FontSize="10"
                                                           Foreground="{DynamicResource HintTextBrush}" VerticalAlignment="Top" Margin="8,2,0,0"
                                                           Visibility="{Binding DueDate, Converter={x:Static converters:NullToVisibilityConverter.Instance}}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            
                            <!-- Actions -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                <Button Content="Edit Meeting" Command="{Binding EditOneOnOneCommand}" 
                                        CommandParameter="{Binding SelectedOneOnOne}"
                                        Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
                                <Button Content="Delete" Command="{Binding DeleteOneOnOneCommand}" 
                                        CommandParameter="{Binding SelectedOneOnOne}"
                                        Style="{StaticResource SecondaryButtonStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
            
            <!-- Empty Details State (overlays right panel when no selection) -->
            <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Margin="8,0,0,0"
                    Visibility="{Binding SelectedOneOnOne, Converter={x:Static converters:NullToVisibilityConverter.InverseInstance}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
