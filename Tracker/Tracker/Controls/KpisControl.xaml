<UserControl x:Class="Tracker.Controls.KpisControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Tracker.Controls"
             xmlns:commands="clr-namespace:Tracker.Command"
             xmlns:enums="clr-namespace:Tracker.Common.Enums"
             xmlns:converters="clr-namespace:Tracker.Common.Converters"
             xmlns:viewModels="clr-namespace:Tracker.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1200"
             d:DataContext="{d:DesignInstance Type=viewModels:TrackerMainViewModel}"
             AutomationProperties.Name="KPIs - Key Performance Indicators"
             AutomationProperties.HelpText="Track and monitor key performance metrics">
    
    <UserControl.Resources>
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource HintTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
        </Style>
        
        <Style x:Key="KpiCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <converters:KpiStatusToColorConverter x:Key="KpiStatusToColorConverter"/>
        <converters:KpiSourceTypeToColorConverter x:Key="KpiSourceTypeToColorConverter"/>
        <converters:KpiSourceTypeToIconConverter x:Key="KpiSourceTypeToIconConverter"/>
    </UserControl.Resources>
    
    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- ROW 0: HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel>
                <TextBlock Text="KPIs" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}"/>
                <TextBlock Text="Key Performance Indicators" FontSize="14" Foreground="{DynamicResource HintTextBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            
            <Button Grid.Column="1" 
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{x:Static commands:DialogCommands.LaunchDialogCommand}"
                    CommandParameter="{x:Static enums:DialogType.AddKPI}"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Add New KPI"
                    AutomationProperties.HelpText="Open dialog to create a new Key Performance Indicator"
                    ToolTip="Create a new KPI"
                    TabIndex="100">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"
                          Fill="{DynamicResource BackgroundBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"/>
                    <TextBlock Text="New KPI"/>
                </StackPanel>
            </Button>
        </Grid>
        
        <!-- ROW 1: STATS BAR (Clickable Filters) -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Border Grid.Column="0" Margin="0,0,6,0"
                    MouseLeftButtonUp="StatCard_OnTarget_Click"
                    ToolTip="Click to filter by On Target">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource StatCardStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=ShowOnTarget, Path=IsChecked}" Value="True">
                                <Setter Property="BorderBrush" Value="#10B981"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="ON TARGET" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Text="{Binding OnTargetKpiCount, FallbackValue='0'}" Style="{StaticResource StatValue}" Foreground="#10B981"/>
                </StackPanel>
            </Border>
            
            <Border Grid.Column="1" Margin="3,0"
                    MouseLeftButtonUp="StatCard_BelowTarget_Click"
                    ToolTip="Click to filter by Below Target">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource StatCardStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=ShowBelowTarget, Path=IsChecked}" Value="True">
                                <Setter Property="BorderBrush" Value="#EF4444"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="BELOW TARGET" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Text="{Binding BelowTargetKpiCount, FallbackValue='0'}" Style="{StaticResource StatValue}" Foreground="#EF4444"/>
                </StackPanel>
            </Border>
            
            <Border Grid.Column="2" Margin="6,0,0,0"
                    MouseLeftButtonUp="StatCard_All_Click"
                    ToolTip="Click to show all KPIs">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource StatCardStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=ShowAllKpis, Path=IsChecked}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="TOTAL" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Text="{Binding KeyPerformanceIndicators.Count, FallbackValue='0'}" Style="{StaticResource StatValue}"/>
                </StackPanel>
            </Border>
        </Grid>
        
        <!-- ROW 2: FILTER BAR -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Search Box -->
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                          Fill="{DynamicResource HintTextBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" 
                             Text="{Binding KpiSearchText, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource ForegroundBrush}"
                             VerticalAlignment="Center" Margin="10,0,0,0" FontSize="13">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="Search KPIs..." Foreground="{DynamicResource HintTextBrush}" FontSize="13"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>
            </Border>
            
            <!-- Filter Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                <RadioButton x:Name="ShowAllKpis" Content="All" GroupName="KpiFilter" 
                             Style="{StaticResource SegmentedButtonStyle}"
                             IsChecked="{Binding KpiStatusFilter, Converter={x:Static converters:NullToBoolConverter.Instance}, ConverterParameter=True}"
                             Click="FilterAll_Click"/>
                <RadioButton x:Name="ShowOnTarget" Content="On Target" GroupName="KpiFilter" 
                             Style="{StaticResource SegmentedButtonStyle}"
                             IsChecked="{Binding KpiStatusFilter, Converter={x:Static converters:EnumToBoolConverter.Instance}, ConverterParameter={x:Static enums:KpiStatusEnum.OnTarget}}"
                             Click="FilterOnTarget_Click"/>
                <RadioButton x:Name="ShowBelowTarget" Content="Below Target" GroupName="KpiFilter" 
                             Style="{StaticResource SegmentedButtonStyle}"
                             Click="FilterBelowTarget_Click"/>
            </StackPanel>
            
            <!-- Clear Filter Button -->
            <Button Grid.Column="2" 
                    Content="Clear Filter" 
                    Style="{StaticResource SecondaryButtonStyle}"
                    Visibility="{Binding KpiStatusFilter, Converter={x:Static converters:NullToVisibilityConverter.Instance}}"
                    Click="FilterAll_Click"
                    HorizontalAlignment="Right"
                    Margin="8,0,0,0"/>
        </Grid>
        
        <!-- ROW 3: MAIN CONTENT -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>
            
            <!-- KPI Cards -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
                <ItemsControl ItemsSource="{Binding FilteredKpis}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource KpiCardStyle}"
                                    MouseLeftButtonUp="Kpi_Click"
                                    Tag="{Binding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <!-- Name -->
                                    <TextBlock Text="{Binding Name}" 
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               VerticalAlignment="Center"/>
                                    
                                    <!-- Value Display -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="20" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}">
                                            <Run Text="{Binding Value, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="12" Foreground="{DynamicResource HintTextBrush}" VerticalAlignment="Bottom" Margin="4,0,0,3">
                                            <Run Text="/ "/><Run Text="{Binding TargetValue, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    
                                    <!-- Progress Bar -->
                                    <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0" x:Name="ProgressContainer">
                                        <Border CornerRadius="4" Height="8" Background="{DynamicResource BackgroundBrush}">
                                            <Border CornerRadius="4" HorizontalAlignment="Left"
                                                    Background="{Binding Status, Converter={StaticResource KpiStatusToColorConverter}}">
                                                <Border.Width>
                                                    <MultiBinding Converter="{x:Static converters:KpiProgressConverter.Instance}">
                                                        <Binding Path="Value"/>
                                                        <Binding Path="TargetValue"/>
                                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}"/>
                                                    </MultiBinding>
                                                </Border.Width>
                                            </Border>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            
            <!-- Detail Panel -->
            <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="12"
                    Visibility="{Binding SelectedKpi, Converter={x:Static converters:NullToVisibilityConverter.Instance}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <!-- KPI Name -->
                        <TextBlock Text="{Binding SelectedKpi.Name}" 
                                   FontSize="18" FontWeight="Bold" 
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,12"/>
                        
                        <!-- Status Badge -->
                        <Border CornerRadius="8" Padding="10,5" HorizontalAlignment="Left" Margin="0,0,0,16"
                                Background="{Binding SelectedKpi.Status, Converter={StaticResource KpiStatusToColorConverter}}">
                            <TextBlock Text="{Binding SelectedKpi.Status}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        
                        <!-- Value -->
                        <TextBlock Text="CURRENT VALUE" Style="{StaticResource SectionHeader}"/>
                        <TextBlock FontSize="32" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,16">
                            <Run Text="{Binding SelectedKpi.Value, Mode=OneWay}"/>
                        </TextBlock>
                        
                        <!-- Target -->
                        <TextBlock Text="TARGET VALUE" Style="{StaticResource SectionHeader}"/>
                        <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,16">
                            <Run Text="{Binding SelectedKpi.TargetValue, Mode=OneWay}"/>
                        </TextBlock>
                        
                        <!-- Progress -->
                        <TextBlock Text="PROGRESS" Style="{StaticResource SectionHeader}"/>
                        <Grid Margin="0,0,0,16" x:Name="DetailProgressContainer">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border CornerRadius="6" Height="12" Background="{DynamicResource BackgroundBrush}">
                                <Border CornerRadius="6" HorizontalAlignment="Left"
                                        Background="{Binding SelectedKpi.Status, Converter={StaticResource KpiStatusToColorConverter}}">
                                    <Border.Width>
                                        <MultiBinding Converter="{x:Static converters:KpiProgressConverter.Instance}">
                                            <Binding Path="SelectedKpi.Value"/>
                                            <Binding Path="SelectedKpi.TargetValue"/>
                                            <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}"/>
                                        </MultiBinding>
                                    </Border.Width>
                                </Border>
                            </Border>
                            <TextBlock Grid.Column="1" 
                                       Text="{Binding SelectedKpi.PercentComplete, StringFormat='{}{0:F0}%', Mode=OneWay}"
                                       FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        
                        <!-- Description -->
                        <TextBlock Text="DESCRIPTION" Style="{StaticResource SectionHeader}"/>
                        <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                            <TextBlock Text="{Binding SelectedKpi.Description, TargetNullValue='No description'}"
                                       FontSize="12" Foreground="{DynamicResource ForegroundBrush}" TextWrapping="Wrap" LineHeight="18"/>
                        </Border>
                        
                        <!-- Data Sources (if any) -->
                        <StackPanel Visibility="{Binding SelectedKpi.HasDataSources, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}">
                            <TextBlock Text="DATA SOURCES" Style="{StaticResource SectionHeader}"/>
                            <ItemsControl ItemsSource="{Binding SelectedKpi.DataSources}" Margin="0,0,0,16">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <!-- Source Type Icon -->
                                                <Border Width="26" Height="26" CornerRadius="6" Margin="0,0,10,0"
                                                        Background="{Binding SourceType, Converter={StaticResource KpiSourceTypeToColorConverter}}">
                                                    <Path Data="{Binding SourceType, Converter={StaticResource KpiSourceTypeToIconConverter}}"
                                                          Fill="White" Width="12" Height="12" Stretch="Uniform"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                
                                                <!-- Source Info -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName, TargetNullValue='Manual Entry'}"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource ForegroundBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding SourceType}" FontSize="10"
                                                               Foreground="{DynamicResource HintTextBrush}"/>
                                                </StackPanel>
                                                
                                                <!-- Current Value -->
                                                <TextBlock Grid.Column="2" 
                                                           Text="{Binding CurrentValue, StringFormat='{}{0:N1}', TargetNullValue='-'}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="8,0,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        
                        <!-- Child KPIs (if composite) -->
                        <StackPanel Visibility="{Binding SelectedKpi.HasChildKpis, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}">
                            <TextBlock Text="CHILD KPIS" Style="{StaticResource SectionHeader}"/>
                            <ItemsControl ItemsSource="{Binding SelectedKpi.ChildKpis}" Margin="0,0,0,16">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource ForegroundBrush}"
                                                           VerticalAlignment="Center"/>
                                                
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Value, StringFormat='{}{0:N1}'}"
                                                               FontSize="12" FontWeight="Bold"
                                                               Foreground="{DynamicResource AccentBrush}"/>
                                                    <TextBlock Text="{Binding TargetValue, StringFormat=' / {0:N1}'}"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource HintTextBrush}"
                                                               VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        
                        <!-- Actions -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <Button Content="Edit" Command="{Binding EditKpiCommand}" 
                                    CommandParameter="{Binding SelectedKpi}"
                                    Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
                            <Button Content="Delete" Command="{Binding DeleteKpiCommand}" 
                                    CommandParameter="{Binding SelectedKpi}"
                                    Style="{StaticResource SecondaryButtonStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            
            <!-- Empty State -->
            <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="12"
                    Visibility="{Binding SelectedKpi, Converter={x:Static converters:NullToVisibilityConverter.InverseInstance}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Path Data="M22,21H2V3H4V19H6V10H10V19H12V6H16V19H18V14H22V21Z"
                          Fill="{DynamicResource HintTextBrush}" Width="48" Height="48" Stretch="Uniform" Opacity="0.4"/>
                    <TextBlock Text="Select a KPI" FontSize="14" Foreground="{DynamicResource HintTextBrush}" 
                               HorizontalAlignment="Center" Margin="0,16,0,4"/>
                    <TextBlock Text="to view details" FontSize="12" Foreground="{DynamicResource HintTextBrush}" 
                               HorizontalAlignment="Center" Opacity="0.7"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
