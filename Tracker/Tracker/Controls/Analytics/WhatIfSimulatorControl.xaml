<UserControl x:Class="Tracker.Controls.Analytics.WhatIfSimulatorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="450"
             x:Name="WhatIfControl">

    <UserControl.Resources>
        <!-- Scenario Card Style -->
        <Style x:Key="ScenarioCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                    <Setter Property="Background" Value="{DynamicResource CardBackgroundHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Impact Badge Style -->
        <Style x:Key="ImpactBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>

        <!-- Section Header Style -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="What-If Scenarios" 
                       FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryText}"/>
            <TextBlock Text="Explore how changes could affect your outcome"
                       FontSize="12" 
                       Foreground="{DynamicResource SecondaryText}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Current Baseline -->
        <Border Grid.Row="1" 
                Background="{DynamicResource InfoBackground}"
                CornerRadius="6" Padding="12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Current Progress" FontSize="11" 
                               Foreground="{DynamicResource SecondaryText}"/>
                    <TextBlock x:Name="CurrentProgressText" Text="--%" 
                               FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryText}"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Projected Final" FontSize="11"
                               Foreground="{DynamicResource SecondaryText}"/>
                    <TextBlock x:Name="ProjectedFinalText" Text="--%" 
                               FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryText}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Days Remaining" FontSize="11"
                               Foreground="{DynamicResource SecondaryText}"/>
                    <TextBlock x:Name="DaysRemainingText" Text="--" 
                               FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryText}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Scenarios List -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ScenariosPanel">
                <!-- Scenarios will be added programmatically -->
            </StackPanel>
        </ScrollViewer>

        <!-- Custom Scenario Slider -->
        <Border Grid.Row="3" Background="{DynamicResource CardBackground}"
                CornerRadius="6" Padding="12" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="Custom Velocity Adjustment" Style="{StaticResource SectionHeaderStyle}"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>

                    <Slider x:Name="VelocitySlider" 
                            Minimum="0.5" Maximum="2.0" Value="1.0"
                            TickFrequency="0.1" IsSnapToTickEnabled="True"
                            VerticalAlignment="Center"
                            ValueChanged="VelocitySlider_ValueChanged"/>
                    
                    <TextBlock Grid.Column="1" x:Name="SliderValueText"
                               Text="100%" FontWeight="SemiBold"
                               VerticalAlignment="Center" HorizontalAlignment="Right"
                               Foreground="{DynamicResource PrimaryText}"/>
                </Grid>

                <TextBlock x:Name="CustomScenarioResult" 
                           Text=""
                           FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryText}"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
