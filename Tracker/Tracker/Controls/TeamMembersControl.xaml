<UserControl x:Class="Tracker.Controls.TeamMembersControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Tracker.Controls"
             xmlns:commands="clr-namespace:Tracker.Command"
             xmlns:enums="clr-namespace:Tracker.Common.Enums"
             xmlns:languages="clr-namespace:Tracker.Resources.Languages"
             xmlns:converters="clr-namespace:Tracker.Common.Converters"
             xmlns:viewModels="clr-namespace:Tracker.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1200"
             d:DataContext="{d:DesignInstance Type=viewModels:TrackerMainViewModel}"
             AutomationProperties.Name="Team Members"
             AutomationProperties.HelpText="Manage your team members, view their details, and schedule 1:1 meetings">
    
    <UserControl.Resources>
        <!-- Card Style -->
        <Style x:Key="MemberCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.15" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Stat Card Style - Clickable -->
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.12" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Active Stat Card Style - Shows selection state -->
        <Style x:Key="ClickableStatCardStyle" TargetType="Border" BasedOn="{StaticResource StatCardStyle}">
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Section Header Style -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource HintTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        
        <!-- Stat Value Style -->
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
        </Style>
        
        <!-- Stat Label Style -->
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource HintTextBrush}"/>
        </Style>
        
        <!-- Quick Action Button Style -->
        <Style x:Key="QuickActionButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" 
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>
    
    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- ============================================== -->
        <!-- ROW 0: HEADER - Title + Actions -->
        <!-- ============================================== -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel>
                <TextBlock Text="Your Team" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource ForegroundBrush}"/>
                <TextBlock FontSize="14" 
                           Foreground="{DynamicResource HintTextBrush}"
                           Margin="0,4,0,0">
                    <Run Text="{Binding TeamMembers.Count, Mode=OneWay, FallbackValue='0'}"/>
                    <Run Text=" team members"/>
                </TextBlock>
            </StackPanel>
            
            <!-- Quick Action Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Command="{x:Static commands:DialogCommands.LaunchDialogCommand}"
                        CommandParameter="{x:Static enums:DialogType.AddTeamMember}"
                        AutomationProperties.Name="Add Team Member"
                        AutomationProperties.HelpText="Open dialog to add a new team member"
                        ToolTip="Add a new team member"
                        TabIndex="100">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M15,14C12.33,14 7,15.33 7,18V20H23V18C23,15.33 17.67,14 15,14M15,12A4,4 0 0,0 19,8A4,4 0 0,0 15,4A4,4 0 0,0 11,8A4,4 0 0,0 15,12M5,9.59L7.12,7.46L8.54,8.88L6.41,11L8.54,13.12L7.12,14.54L5,12.41L2.88,14.54L1.46,13.12L3.59,11L1.46,8.88L2.88,7.46L5,9.59M1,20H5V18C5,16.76 5.47,15.59 6.22,14.63C3.93,15.17 1,16.54 1,18V20Z"
                              Fill="{DynamicResource BackgroundBrush}"
                              Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                        <TextBlock Text="Add Member"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        
        <!-- ============================================== -->
        <!-- ROW 1: STATS BAR (Horizontal) - Clickable Filters -->
        <!-- ============================================== -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Active -->
            <Border Grid.Column="0" Margin="0,0,8,0"
                    MouseLeftButtonUp="StatCard_Active_Click"
                    ToolTip="Click to show only active members"
                    AutomationProperties.Name="Active Members Filter"
                    AutomationProperties.HelpText="Filter to show only active team members">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource ClickableStatCardStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MemberFilter}" Value="{x:Static enums:TeamMemberFilterEnum.Active}">
                                <Setter Property="BorderBrush" Value="#10B981"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="ACTIVE" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Text="{Binding ActiveMemberCount, FallbackValue='0'}" 
                               Style="{StaticResource StatValue}"
                               Foreground="#10B981"/>
                </StackPanel>
            </Border>
            
            <!-- Inactive -->
            <Border Grid.Column="1" Margin="4,0"
                    MouseLeftButtonUp="StatCard_Inactive_Click"
                    ToolTip="Click to show only inactive members"
                    AutomationProperties.Name="Inactive Members Filter"
                    AutomationProperties.HelpText="Filter to show only inactive team members">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource ClickableStatCardStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MemberFilter}" Value="{x:Static enums:TeamMemberFilterEnum.Inactive}">
                                <Setter Property="BorderBrush" Value="{DynamicResource HintTextBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="INACTIVE" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Text="{Binding InactiveMemberCount, FallbackValue='0'}" 
                               Style="{StaticResource StatValue}"
                               Foreground="{DynamicResource HintTextBrush}"/>
                </StackPanel>
            </Border>
            
            <!-- Avg Tenure (not clickable - just informational) -->
            <Border Grid.Column="2" Style="{StaticResource StatCardStyle}" Margin="4,0"
                    Cursor="Arrow"
                    ToolTip="Average tenure of active team members">
                <StackPanel>
                    <TextBlock Text="AVG TENURE" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Text="{Binding AverageTenure, FallbackValue='—'}" 
                               Style="{StaticResource StatValue}"/>
                </StackPanel>
            </Border>
            
            <!-- 1:1 On Track -->
            <Border Grid.Column="3" Margin="4,0"
                    MouseLeftButtonUp="StatCard_OnTrack_Click"
                    ToolTip="Click to show members with on-track 1:1s (within 14 days)"
                    AutomationProperties.Name="1:1 On Track Filter"
                    AutomationProperties.HelpText="Filter to show members who have had a 1:1 within 14 days">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource ClickableStatCardStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MemberFilter}" Value="{x:Static enums:TeamMemberFilterEnum.OneOnOneOnTrack}">
                                <Setter Property="BorderBrush" Value="#10B981"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="1:1 ON TRACK" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Text="{Binding OnTrack1on1Count, FallbackValue='0'}" 
                               Style="{StaticResource StatValue}"
                               Foreground="#10B981"/>
                </StackPanel>
            </Border>
            
            <!-- 1:1 Overdue -->
            <Border Grid.Column="4" Margin="4,0"
                    MouseLeftButtonUp="StatCard_Overdue_Click"
                    ToolTip="Click to show members overdue for 1:1 (21+ days)"
                    AutomationProperties.Name="1:1 Overdue Filter"
                    AutomationProperties.HelpText="Filter to show members who haven't had a 1:1 in 21 or more days">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource ClickableStatCardStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MemberFilter}" Value="{x:Static enums:TeamMemberFilterEnum.OneOnOneOverdue}">
                                <Setter Property="BorderBrush" Value="#EF4444"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="1:1 OVERDUE" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Text="{Binding Overdue1on1Count, FallbackValue='0'}" 
                               Style="{StaticResource StatValue}"
                               Foreground="#EF4444"/>
                </StackPanel>
            </Border>
            
            <!-- Open Tasks -->
            <Border Grid.Column="5" Margin="8,0,0,0"
                    MouseLeftButtonUp="StatCard_OpenTasks_Click"
                    ToolTip="Click to show members with open tasks"
                    AutomationProperties.Name="Open Tasks Filter"
                    AutomationProperties.HelpText="Filter to show members who have open tasks assigned">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource ClickableStatCardStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MemberFilter}" Value="{x:Static enums:TeamMemberFilterEnum.HasOpenTasks}">
                                <Setter Property="BorderBrush" Value="#F59E0B"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="OPEN TASKS" Style="{StaticResource SectionHeader}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding MembersWithOpenTasksCount, FallbackValue='0'}" 
                                   Style="{StaticResource StatValue}"
                                   Foreground="#F59E0B"/>
                        <TextBlock Text="{Binding TotalOpenTasks, Mode=OneWay, StringFormat=' ({0})'}"
                                   FontSize="12" 
                                   Foreground="{DynamicResource HintTextBrush}"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,2"
                                   ToolTip="Total tasks"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
        
        <!-- ============================================== -->
        <!-- ROW 2: SEARCH & FILTER BAR -->
        <!-- ============================================== -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- Search Box -->
            <Border Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="8"
                    Padding="12,8"
                    AutomationProperties.Name="Search Team Members">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                          Fill="{DynamicResource HintTextBrush}"
                          Width="16" Height="16" Stretch="Uniform"
                          VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" 
                             Text="{Binding MemberSearchText, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{DynamicResource ForegroundBrush}"
                             VerticalAlignment="Center"
                             Margin="10,0,0,0"
                             FontSize="13"
                             AutomationProperties.Name="Search"
                             AutomationProperties.HelpText="Type to filter team members by name"
                             TabIndex="101">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="Search team members..." 
                                                                   Foreground="{DynamicResource HintTextBrush}"
                                                                   FontSize="13"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>
            </Border>
            
            <!-- Filter Buttons - synced with stat cards -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0"
                        AutomationProperties.Name="Filter Options">
                <RadioButton x:Name="ShowAll" 
                             Content="All" 
                             IsChecked="{Binding MemberFilter, Converter={x:Static converters:EnumToBoolConverter.Instance}, ConverterParameter={x:Static enums:TeamMemberFilterEnum.All}}"
                             GroupName="MemberFilter"
                             Style="{StaticResource SegmentedButtonStyle}"
                             Click="FilterButton_All_Click"
                             AutomationProperties.Name="Show All Members"
                             TabIndex="102"/>
                <RadioButton x:Name="ShowActive" 
                             Content="Active" 
                             IsChecked="{Binding MemberFilter, Converter={x:Static converters:EnumToBoolConverter.Instance}, ConverterParameter={x:Static enums:TeamMemberFilterEnum.Active}}"
                             GroupName="MemberFilter"
                             Style="{StaticResource SegmentedButtonStyle}"
                             Click="FilterButton_Active_Click"
                             AutomationProperties.Name="Show Active Members Only"
                             TabIndex="103"/>
                <RadioButton x:Name="ShowNeedsAttention" 
                             Content="Needs Attention" 
                             IsChecked="{Binding MemberFilter, Converter={x:Static converters:EnumToBoolConverter.Instance}, ConverterParameter={x:Static enums:TeamMemberFilterEnum.NeedsAttention}}"
                             GroupName="MemberFilter"
                             Style="{StaticResource SegmentedButtonStyle}"
                             Click="FilterButton_NeedsAttention_Click"
                             AutomationProperties.Name="Show Members Needing Attention"
                             TabIndex="104"/>
            </StackPanel>
            
            <!-- Clear Filter Button (appears when a stat card filter is active) -->
            <Button Grid.Column="2" 
                    Content="✕ Clear Filter" 
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="ClearFilter_Click"
                    Margin="16,0,0,0"
                    Padding="12,6"
                    FontSize="11"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Clear Filter"
                    AutomationProperties.HelpText="Remove the current filter and show all team members"
                    TabIndex="105">
                <Button.Visibility>
                    <Binding Path="MemberFilter" Converter="{x:Static converters:EnumToVisibilityConverter.Instance}">
                        <Binding.ConverterParameter>
                            <x:Static Member="enums:TeamMemberFilterEnum.All"/>
                        </Binding.ConverterParameter>
                    </Binding>
                </Button.Visibility>
            </Button>
            
            <!-- View Toggle (future: grid vs list) -->
            <TextBlock Grid.Column="3" 
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource HintTextBrush}"
                       FontSize="12">
                <Run Text="Showing"/>
                <Run Text="{Binding FilteredMemberCount, FallbackValue='0', Mode=OneWay}" FontWeight="SemiBold"/>
                <Run Text="of"/>
                <Run Text="{Binding TeamMembers.Count, FallbackValue='0', Mode=OneWay}" FontWeight="SemiBold"/>
            </TextBlock>
        </Grid>
        
        <!-- ============================================== -->
        <!-- ROW 3: MAIN CONTENT - Cards + Detail Panel -->
        <!-- ============================================== -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            
            <!-- Team Member Cards Grid (Multi-column) -->
            <ScrollViewer Grid.Column="0" 
                          VerticalScrollBarVisibility="Auto" 
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="0,0,16,0">
                <ItemsControl ItemsSource="{Binding FilteredTeamMembers}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="260" 
                                    Style="{StaticResource MemberCardStyle}"
                                    Margin="0,0,12,12"
                                    MouseLeftButtonDown="MemberCard_Click"
                                    Tag="{Binding}"
                                    Cursor="Hand"
                                    ToolTip="Click to select, double-click to edit">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftDoubleClick" 
                                                  Command="{Binding DataContext.TeamMemberEditCommand, RelativeSource={RelativeSource AncestorType={x:Type local:TeamMembersControl}}}"
                                                  CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <!-- Header: Avatar + Name + Status -->
                                    <Grid Grid.Row="0" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Avatar with Presence Indicator -->
                                        <Grid Width="44" Height="44">
                                            <!-- Background for initials fallback -->
                                            <Ellipse Fill="{DynamicResource AccentBrush}"
                                                     Visibility="{Binding ProfileImage, Converter={x:Static converters:ByteArrayToVisibilityConverter.InverseInstance}}"/>
                                            <TextBlock Text="{Binding Initials, Mode=OneWay}" 
                                                       FontSize="15" 
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource BackgroundBrush}"
                                                       HorizontalAlignment="Center" 
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding ProfileImage, Converter={x:Static converters:ByteArrayToVisibilityConverter.InverseInstance}}"/>
                                            <!-- Profile Image -->
                                            <Ellipse Visibility="{Binding ProfileImage, Converter={x:Static converters:ByteArrayToVisibilityConverter.Instance}}">
                                                <Ellipse.Fill>
                                                    <ImageBrush ImageSource="{Binding ProfileImage, Converter={x:Static converters:ByteArrayToImageSourceConverter.Instance}}"
                                                                RenderOptions.BitmapScalingMode="HighQuality"
                                                                Stretch="UniformToFill"/>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <!-- Presence Indicator (bottom-right corner) -->
                                            <Border Width="14" Height="14" 
                                                    CornerRadius="7"
                                                    BorderBrush="{DynamicResource SurfaceBrush}"
                                                    BorderThickness="2"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Bottom"
                                                    Margin="0,0,-2,-2"
                                                    ToolTip="{Binding PresenceDisplay}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#ADB5BD"/>
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <!-- Show only when presence is known -->
                                                            <DataTrigger Binding="{Binding Presence}" Value="Available">
                                                                <Setter Property="Background" Value="#28A745"/>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Presence}" Value="Busy">
                                                                <Setter Property="Background" Value="#DC3545"/>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Presence}" Value="InACall">
                                                                <Setter Property="Background" Value="#DC3545"/>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Presence}" Value="InAMeeting">
                                                                <Setter Property="Background" Value="#DC3545"/>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Presence}" Value="DoNotDisturb">
                                                                <Setter Property="Background" Value="#DC3545"/>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Presence}" Value="Away">
                                                                <Setter Property="Background" Value="#FFC107"/>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Presence}" Value="BeRightBack">
                                                                <Setter Property="Background" Value="#FFC107"/>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Presence}" Value="Offline">
                                                                <Setter Property="Background" Value="#6C757D"/>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Presence}" Value="OutOfOffice">
                                                                <Setter Property="Background" Value="#6C757D"/>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </Grid>
                                        
                                        <!-- Name + Title -->
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FullName, Mode=OneWay}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource ForegroundBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding JobTitle, Mode=OneWay}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource HintTextBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        
                                        <!-- Status Badge -->
                                        <Border Grid.Column="2" CornerRadius="10" Padding="8,3" VerticalAlignment="Top">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#10B981"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Background" Value="#6B7280"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusDisplay, Mode=OneWay}" 
                                                       FontSize="9"
                                                       FontWeight="SemiBold"
                                                       Foreground="White"/>
                                        </Border>
                                    </Grid>
                                    
                                    <!-- Quick Stats Row -->
                                    <Border Grid.Row="1" 
                                            Background="{DynamicResource BackgroundBrush}"
                                            CornerRadius="8"
                                            Padding="10,8"
                                            Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Tenure -->
                                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding Tenure, Mode=OneWay}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource ForegroundBrush}"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="Tenure"
                                                           FontSize="9"
                                                           Foreground="{DynamicResource HintTextBrush}"
                                                           HorizontalAlignment="Center"/>
                                            </StackPanel>
                                            
                                            <Border Grid.Column="1" Width="1" Background="{DynamicResource BorderBrush}" Margin="6,2"/>
                                            
                                            <!-- Tasks -->
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding OpenTaskCount, Mode=OneWay}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding OpenTaskCount}" Value="0">
                                                                    <Setter Property="Foreground" Value="{DynamicResource HintTextBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="Tasks"
                                                           FontSize="9"
                                                           Foreground="{DynamicResource HintTextBrush}"
                                                           HorizontalAlignment="Center"/>
                                            </StackPanel>
                                            
                                            <Border Grid.Column="3" Width="1" Background="{DynamicResource BorderBrush}" Margin="6,2"/>
                                            
                                            <!-- Goals -->
                                            <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding ActiveGoalCount, Mode=OneWay}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ActiveGoalCount}" Value="0">
                                                                    <Setter Property="Foreground" Value="{DynamicResource HintTextBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="Goals"
                                                           FontSize="9"
                                                           Foreground="{DynamicResource HintTextBrush}"
                                                           HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    
                                    <!-- 1:1 Status -->
                                    <Grid Grid.Row="2" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Last 1:1"
                                                       FontSize="9"
                                                       Foreground="{DynamicResource HintTextBrush}"/>
                                            <TextBlock Text="{Binding LastOneOnOneDisplay, Mode=OneWay}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource ForegroundBrush}"/>
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock Text="Next 1:1"
                                                       FontSize="9"
                                                       Foreground="{DynamicResource HintTextBrush}"
                                                       HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding NextOneOnOneDisplay, Mode=OneWay}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Right">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding NextOneOnOneDisplay}" Value="Overdue">
                                                                <Setter Property="Foreground" Value="#EF4444"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NextOneOnOneDisplay}" Value="Today">
                                                                <Setter Property="Foreground" Value="#10B981"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NextOneOnOneDisplay}" Value="Tomorrow">
                                                                <Setter Property="Foreground" Value="#F59E0B"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                    
                                    <!-- Quick Actions -->
                                    <Border Grid.Row="3" 
                                            BorderThickness="0,1,0,0"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            Padding="0,10,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Schedule 1:1 -->
                                            <Button Grid.Column="0" 
                                                    Style="{StaticResource QuickActionButton}"
                                                    Command="{Binding DataContext.AddTeamMemberOneOnOneCommand, RelativeSource={RelativeSource AncestorType={x:Type local:TeamMembersControl}}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Schedule 1:1">
                                                <Path Data="M19,19H5V8H19M16,1V3H8V1H6V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3H18V1M17,12H12V17H17V12Z"
                                                      Fill="{DynamicResource AccentBrush}"
                                                      Width="16" Height="16" Stretch="Uniform"/>
                                            </Button>
                                            
                                            <!-- Email -->
                                            <Button Grid.Column="1" 
                                                    Style="{StaticResource QuickActionButton}"
                                                    Click="EmailMember_Click"
                                                    Tag="{Binding}"
                                                    ToolTip="Send Email">
                                                <Path Data="M20,8L12,13L4,8V6L12,11L20,6M20,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V6C22,4.89 21.1,4 20,4Z"
                                                      Fill="{DynamicResource HintTextBrush}"
                                                      Width="16" Height="16" Stretch="Uniform"/>
                                            </Button>
                                            
                                            <!-- Edit -->
                                            <Button Grid.Column="2" 
                                                    Style="{StaticResource QuickActionButton}"
                                                    Command="{Binding DataContext.TeamMemberEditCommand, RelativeSource={RelativeSource AncestorType={x:Type local:TeamMembersControl}}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Edit Details">
                                                <Path Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"
                                                      Fill="{DynamicResource HintTextBrush}"
                                                      Width="16" Height="16" Stretch="Uniform"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            
            <!-- ============================================== -->
            <!-- RIGHT SIDEBAR: Selected Member Details -->
            <!-- ============================================== -->
            <Border Grid.Column="1" 
                    Style="{StaticResource MemberCardStyle}"
                    Visibility="{Binding SelectedTeamMemberWrapper, Converter={x:Static converters:NullToVisibilityConverter.Instance}}"
                    Margin="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding SelectedTeamMemberWrapper}">
                        
                        <!-- Profile Header -->
                        <StackPanel HorizontalAlignment="Center" Margin="0,0,0,20">
                            <Grid Width="72" Height="72" HorizontalAlignment="Center">
                                <!-- Background for initials fallback -->
                                <Ellipse Fill="{DynamicResource AccentBrush}"
                                         Visibility="{Binding ProfileImage, Converter={x:Static converters:NullToVisibilityConverter.InverseInstance}}"/>
                                <TextBlock Text="{Binding Data.Initials, Mode=OneWay}" 
                                           FontSize="26" 
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource BackgroundBrush}"
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"
                                           Visibility="{Binding ProfileImage, Converter={x:Static converters:NullToVisibilityConverter.InverseInstance}}"/>
                                <!-- Profile Image -->
                                <Ellipse Visibility="{Binding ProfileImage, Converter={x:Static converters:NullToVisibilityConverter.Instance}}">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{Binding ProfileImage}"
                                                    RenderOptions.BitmapScalingMode="HighQuality"
                                                    Stretch="UniformToFill"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Grid>
                            <TextBlock Text="{Binding Data.FullName, Mode=OneWay}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,12,0,4"/>
                            <TextBlock Text="{Binding JobTitle, Mode=OneWay}"
                                       FontSize="13"
                                       Foreground="{DynamicResource HintTextBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                        
                        <!-- Contact Info -->
                        <TextBlock Text="CONTACT" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                        
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Data="M20,8L12,13L4,8V6L12,11L20,6M20,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V6C22,4.89 21.1,4 20,4Z"
                                  Fill="{DynamicResource HintTextBrush}"
                                  Width="14" Height="14" Stretch="Uniform"
                                  VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" 
                                       Text="{Binding Email, Mode=OneWay}"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       FontSize="12"
                                       Margin="10,0,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Data="M6.62,10.79C8.06,13.62 10.38,15.94 13.21,17.38L15.41,15.18C15.69,14.9 16.08,14.82 16.43,14.93C17.55,15.3 18.75,15.5 20,15.5A1,1 0 0,1 21,16.5V20A1,1 0 0,1 20,21A17,17 0 0,1 3,4A1,1 0 0,1 4,3H7.5A1,1 0 0,1 8.5,4C8.5,5.25 8.7,6.45 9.07,7.57C9.18,7.92 9.1,8.31 8.82,8.59L6.62,10.79Z"
                                  Fill="{DynamicResource HintTextBrush}"
                                  Width="14" Height="14" Stretch="Uniform"
                                  VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" 
                                       Text="{Binding CellPhone, Mode=OneWay}"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       FontSize="12"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        
                        <!-- Details -->
                        <TextBlock Text="DETAILS" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                        
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Role" 
                                       Foreground="{DynamicResource HintTextBrush}"
                                       FontSize="12"/>
                            <TextBlock Grid.Column="1" 
                                       Text="{Binding Role.DisplayValue, Mode=OneWay}"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       FontSize="12"/>
                        </Grid>
                        
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Level" 
                                       Foreground="{DynamicResource HintTextBrush}"
                                       FontSize="12"/>
                            <TextBlock Grid.Column="1" 
                                       Text="{Binding Level.DisplayValue, Mode=OneWay}"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       FontSize="12"/>
                        </Grid>
                        
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Hire Date" 
                                       Foreground="{DynamicResource HintTextBrush}"
                                       FontSize="12"/>
                            <TextBlock Grid.Column="1" 
                                       Text="{Binding HireDateDisplay, Mode=OneWay}"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       FontSize="12"/>
                        </Grid>
                        
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Birthday" 
                                       Foreground="{DynamicResource HintTextBrush}"
                                       FontSize="12"/>
                            <TextBlock Grid.Column="1" 
                                       Text="{Binding BirthDayDisplay, Mode=OneWay}"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       FontSize="12"/>
                        </Grid>
                        
                        <!-- Social Links -->
                        <TextBlock Text="SOCIAL" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Style="{StaticResource QuickActionButton}"
                                    Click="OpenSocialLink_Click"
                                    Tag="{Binding LinkedInProfile}"
                                    Visibility="{Binding LinkedInProfile, Converter={x:Static converters:NullToVisibilityConverter.Instance}}"
                                    ToolTip="LinkedIn">
                                <Path Data="M19 3A2 2 0 0 1 21 5V19A2 2 0 0 1 19 21H5A2 2 0 0 1 3 19V5A2 2 0 0 1 5 3H19M18.5 18.5V13.2A3.26 3.26 0 0 0 15.24 9.94C14.39 9.94 13.4 10.46 12.92 11.24V10.13H10.13V18.5H12.92V13.57C12.92 12.8 13.54 12.17 14.31 12.17A1.4 1.4 0 0 1 15.71 13.57V18.5H18.5M6.88 8.56A1.68 1.68 0 0 0 8.56 6.88C8.56 5.95 7.81 5.19 6.88 5.19A1.69 1.69 0 0 0 5.19 6.88C5.19 7.81 5.95 8.56 6.88 8.56M8.27 18.5V10.13H5.5V18.5H8.27Z"
                                      Fill="#0A66C2"
                                      Width="18" Height="18" Stretch="Uniform"/>
                            </Button>
                            
                            <Button Style="{StaticResource QuickActionButton}"
                                    Click="OpenSocialLink_Click"
                                    Tag="{Binding XProfile}"
                                    Visibility="{Binding XProfile, Converter={x:Static converters:NullToVisibilityConverter.Instance}}"
                                    ToolTip="X (Twitter)">
                                <Path Data="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
                                      Fill="{DynamicResource ForegroundBrush}"
                                      Width="18" Height="18" Stretch="Uniform"/>
                            </Button>
                        </StackPanel>
                        
                    </StackPanel>
                </ScrollViewer>
            </Border>
            
            <!-- Placeholder when no member selected -->
            <Border Grid.Column="1" 
                    Style="{StaticResource MemberCardStyle}"
                    Visibility="{Binding SelectedTeamMemberWrapper, Converter={x:Static converters:NullToVisibilityConverter.InverseInstance}}"
                    Margin="0">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Path Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z"
                          Fill="{DynamicResource HintTextBrush}"
                          Width="48" Height="48" Stretch="Uniform"
                          HorizontalAlignment="Center"
                          Opacity="0.5"/>
                    <TextBlock Text="Select a team member"
                               FontSize="14"
                               Foreground="{DynamicResource HintTextBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,16,0,4"/>
                    <TextBlock Text="to view details"
                               FontSize="12"
                               Foreground="{DynamicResource HintTextBrush}"
                               HorizontalAlignment="Center"
                               Opacity="0.7"/>
                </StackPanel>
            </Border>
            
        </Grid>
    </Grid>
</UserControl>
