<UserControl x:Class="Tracker.Controls.ProjectsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Tracker.Controls"
             xmlns:commands="clr-namespace:Tracker.Command"
             xmlns:enums="clr-namespace:Tracker.Common.Enums"
             xmlns:converters="clr-namespace:Tracker.Common.Converters"
             xmlns:viewModels="clr-namespace:Tracker.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1200"
             d:DataContext="{d:DesignInstance Type=viewModels:TrackerMainViewModel}"
             AutomationProperties.Name="Projects"
             AutomationProperties.HelpText="Track team projects and deliverables">
    
    <UserControl.Resources>
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource HintTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
        </Style>
        
        <Style x:Key="ProjectCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <converters:ProjectStatusToColorConverter x:Key="ProjectStatusToColorConverter"/>
    </UserControl.Resources>
    
    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- ROW 0: HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel>
                <TextBlock Text="Projects" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}"/>
                <TextBlock Text="Track team projects and deliverables" FontSize="14" Foreground="{DynamicResource HintTextBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            
            <Button Grid.Column="1" 
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{x:Static commands:DialogCommands.LaunchDialogCommand}"
                    CommandParameter="{x:Static enums:DialogType.AddProject}"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Add New Project"
                    AutomationProperties.HelpText="Open dialog to create a new project"
                    ToolTip="Create a new project"
                    TabIndex="100">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"
                          Fill="{DynamicResource BackgroundBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"/>
                    <TextBlock Text="New Project"/>
                </StackPanel>
            </Button>
        </Grid>
        
        <!-- ROW 1: STATS BAR (Clickable Filters) -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Border Grid.Column="0" Margin="0,0,6,0"
                    MouseLeftButtonUp="StatCard_Active_Click"
                    ToolTip="Click to filter by Active projects">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource StatCardStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=ShowActiveProjects, Path=IsChecked}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="ACTIVE" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Text="{Binding ActiveProjectCount, FallbackValue='0'}" Style="{StaticResource StatValue}" Foreground="{DynamicResource AccentBrush}"/>
                </StackPanel>
            </Border>
            
            <Border Grid.Column="1" Margin="3,0"
                    MouseLeftButtonUp="StatCard_Completed_Click"
                    ToolTip="Click to filter by Completed projects">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource StatCardStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=ShowCompletedProjects, Path=IsChecked}" Value="True">
                                <Setter Property="BorderBrush" Value="#10B981"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="COMPLETED" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Text="{Binding CompletedProjectCount, FallbackValue='0'}" Style="{StaticResource StatValue}" Foreground="#10B981"/>
                </StackPanel>
            </Border>
            
            <Border Grid.Column="2" Style="{StaticResource StatCardStyle}" Margin="3,0">
                <StackPanel>
                    <TextBlock Text="AT RISK" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Text="{Binding AtRiskProjectCount, FallbackValue='0'}" Style="{StaticResource StatValue}" Foreground="#EF4444"/>
                </StackPanel>
            </Border>
            
            <Border Grid.Column="3" Margin="6,0,0,0"
                    MouseLeftButtonUp="StatCard_All_Click"
                    ToolTip="Click to show all projects">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource StatCardStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=ShowAllProjects, Path=IsChecked}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource ForegroundBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="TOTAL" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Text="{Binding Projects.Count, FallbackValue='0'}" Style="{StaticResource StatValue}"/>
                </StackPanel>
            </Border>
        </Grid>
        
        <!-- ROW 2: FILTER BAR -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Search Box -->
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                          Fill="{DynamicResource HintTextBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" 
                             Text="{Binding ProjectSearchText, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource ForegroundBrush}"
                             VerticalAlignment="Center" Margin="10,0,0,0" FontSize="13">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="Search projects..." Foreground="{DynamicResource HintTextBrush}" FontSize="13"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>
            </Border>
            
            <!-- Filter Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                <RadioButton x:Name="ShowAllProjects" Content="All" GroupName="ProjectFilter" 
                             Style="{StaticResource SegmentedButtonStyle}"
                             IsChecked="{Binding ProjectStatusFilter, Converter={x:Static converters:NullToBoolConverter.Instance}, ConverterParameter=True}"
                             Click="FilterAll_Click"/>
                <RadioButton x:Name="ShowActiveProjects" Content="Active" GroupName="ProjectFilter" 
                             Style="{StaticResource SegmentedButtonStyle}"
                             Click="FilterActive_Click"/>
                <RadioButton x:Name="ShowCompletedProjects" Content="Completed" GroupName="ProjectFilter" 
                             Style="{StaticResource SegmentedButtonStyle}"
                             Click="FilterCompleted_Click"/>
            </StackPanel>
            
            <!-- Clear Filter Button -->
            <Button Grid.Column="2" 
                    Content="Clear Filter" 
                    Style="{StaticResource SecondaryButtonStyle}"
                    Visibility="{Binding ProjectStatusFilter, Converter={x:Static converters:NullToVisibilityConverter.Instance}}"
                    Click="FilterAll_Click"
                    HorizontalAlignment="Right"
                    Margin="8,0,0,0"/>
        </Grid>
        
        <!-- ROW 3: MAIN CONTENT -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>
            
            <!-- Project List -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
                <ItemsControl ItemsSource="{Binding FilteredProjects}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ProjectCardStyle}"
                                    MouseLeftButtonUp="Project_Click"
                                    Tag="{Binding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <!-- Name & Status -->
                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Text="{Binding Name}" 
                                               FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    
                                    <Border Grid.Row="0" Grid.Column="1" 
                                            CornerRadius="6" Padding="8,4" VerticalAlignment="Center"
                                            Background="{Binding Status, Converter={StaticResource ProjectStatusToColorConverter}}">
                                        <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                    
                                    <!-- Description -->
                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                                               Text="{Binding Description}" 
                                               FontSize="12" Foreground="{DynamicResource HintTextBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxHeight="36" TextWrapping="Wrap"
                                               Margin="0,6,0,0"/>
                                    
                                    <!-- Meta: Dates & Progress -->
                                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
                                        <!-- Start Date -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                            <Path Data="M19,19H5V8H19M16,1V3H8V1H6V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3H18V1"
                                                  Fill="{DynamicResource HintTextBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding StartDate, StringFormat='{}{0:MMM dd}'}" FontSize="11" 
                                                       Foreground="{DynamicResource HintTextBrush}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        
                                        <!-- End Date -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                            <Path Data="M12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22C6.47,22 2,17.5 2,12A10,10 0 0,1 12,2M12.5,7V12.25L17,14.92L16.25,16.15L11,13V7H12.5Z"
                                                  Fill="{DynamicResource HintTextBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding EndDate, StringFormat='{}{0:MMM dd}'}" FontSize="11"
                                                       Foreground="{DynamicResource HintTextBrush}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        
                                        <!-- Owner -->
                                        <StackPanel Orientation="Horizontal"
                                                    Visibility="{Binding Owner, Converter={x:Static converters:NullToVisibilityConverter.Instance}}">
                                            <Grid Width="18" Height="18">
                                                <Ellipse Fill="{DynamicResource AccentBrush}"/>
                                                <TextBlock Text="{Binding Owner.Initials}" FontSize="8" FontWeight="Bold"
                                                           Foreground="{DynamicResource BackgroundBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Owner.FullName}" FontSize="11"
                                                       Foreground="{DynamicResource HintTextBrush}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            
            <!-- Detail Panel -->
            <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="12"
                    Visibility="{Binding SelectedProject, Converter={x:Static converters:NullToVisibilityConverter.Instance}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <!-- Project Name -->
                        <TextBlock Text="{Binding SelectedProject.Name}" 
                                   FontSize="18" FontWeight="Bold" 
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,8"/>
                        
                        <!-- Status Badge -->
                        <Border CornerRadius="8" Padding="10,5" HorizontalAlignment="Left" Margin="0,0,0,16"
                                Background="{Binding SelectedProject.Status, Converter={StaticResource ProjectStatusToColorConverter}}">
                            <TextBlock Text="{Binding SelectedProject.Status}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        
                        <!-- Dates -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="START DATE" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Text="{Binding SelectedProject.StartDate, StringFormat='{}{0:MMM dd, yyyy}'}"
                                           FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="END DATE" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Text="{Binding SelectedProject.EndDate, StringFormat='{}{0:MMM dd, yyyy}'}"
                                           FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}"/>
                            </StackPanel>
                        </Grid>
                        
                        <!-- Owner -->
                        <TextBlock Text="OWNER" Style="{StaticResource SectionHeader}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Grid Width="28" Height="28" Visibility="{Binding SelectedProject.Owner, Converter={x:Static converters:NullToVisibilityConverter.Instance}}">
                                <Ellipse Fill="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="{Binding SelectedProject.Owner.Initials}" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource BackgroundBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="{Binding SelectedProject.Owner.FullName, FallbackValue='Unassigned'}" 
                                       FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                        
                        <!-- Description -->
                        <TextBlock Text="DESCRIPTION" Style="{StaticResource SectionHeader}"/>
                        <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                            <TextBlock Text="{Binding SelectedProject.Description, TargetNullValue='No description'}"
                                       FontSize="12" Foreground="{DynamicResource ForegroundBrush}" TextWrapping="Wrap" LineHeight="18"/>
                        </Border>
                        
                        <!-- Actions -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <Button Content="Edit" Command="{Binding EditProjectCommand}" 
                                    CommandParameter="{Binding SelectedProject}"
                                    Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
                            <Button Content="Delete" Command="{Binding DeleteProjectCommand}" 
                                    CommandParameter="{Binding SelectedProject}"
                                    Style="{StaticResource SecondaryButtonStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            
            <!-- Empty State -->
            <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="12"
                    Visibility="{Binding SelectedProject, Converter={x:Static converters:NullToVisibilityConverter.InverseInstance}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Path Data="M12.6,2.86C15.27,4.1 18,5.39 20.66,6.63C20.81,6.7 21,6.75 21,6.95C21,7.15 20.81,7.19 20.66,7.26C18,8.5 15.3,9.77 12.62,11C12.21,11.21 11.79,11.21 11.38,11C8.69,9.76 6,8.5 3.32,7.25C3.18,7.19 3,7.14 3,6.94C3,6.76 3.18,6.71 3.31,6.65C6,5.39 8.74,4.1 11.44,2.85C11.73,2.72 12.3,2.73 12.6,2.86M12,21.15C11.8,21.15 11.66,21.07 11.38,20.97C8.69,19.73 6,18.47 3.33,17.22C3.19,17.15 3,17.11 3,16.9C3,16.7 3.19,16.66 3.34,16.59C3.78,16.38 4.23,16.17 4.67,15.96C5.12,15.76 5.56,15.76 6,15.97C7.79,16.8 9.57,17.63 11.35,18.46C11.79,18.67 12.23,18.66 12.67,18.46C14.45,17.62 16.23,16.79 18,15.96C18.44,15.76 18.87,15.75 19.29,15.95C19.77,16.16 20.24,16.39 20.71,16.61C20.78,16.64 20.85,16.68 20.91,16.73C21.04,16.83 21.04,17 20.91,17.08C20.83,17.14 20.74,17.19 20.65,17.23C18,18.5 15.33,19.72 12.66,20.95C12.46,21.05 12.19,21.15 12,21.15M12,16.17C11.9,16.17 11.55,16.07 11.36,16C8.68,14.74 6,13.5 3.34,12.24C3.2,12.18 3,12.13 3,11.93C3,11.72 3.2,11.68 3.35,11.61C3.8,11.39 4.25,11.18 4.7,10.97C5.13,10.78 5.56,10.78 6,11C7.78,11.82 9.58,12.66 11.38,13.5C11.79,13.69 12.21,13.69 12.63,13.5C14.43,12.65 16.23,11.81 18.04,10.97C18.45,10.78 18.87,10.78 19.29,10.97C19.76,11.19 20.24,11.41 20.71,11.63C20.77,11.66 20.84,11.69 20.9,11.74C21.04,11.85 21.04,12 20.89,12.12C20.84,12.16 20.77,12.19 20.71,12.22C18,13.5 15.31,14.75 12.61,16C12.42,16.09 12.08,16.17 12,16.17Z"
                          Fill="{DynamicResource HintTextBrush}" Width="48" Height="48" Stretch="Uniform" Opacity="0.4"/>
                    <TextBlock Text="Select a project" FontSize="14" Foreground="{DynamicResource HintTextBrush}" 
                               HorizontalAlignment="Center" Margin="0,16,0,4"/>
                    <TextBlock Text="to view details" FontSize="12" Foreground="{DynamicResource HintTextBrush}" 
                               HorizontalAlignment="Center" Opacity="0.7"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
