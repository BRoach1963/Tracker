<UserControl x:Class="Tracker.Controls.GoalsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Tracker.Controls"
             xmlns:converters="clr-namespace:Tracker.Common.Converters"
             xmlns:viewModels="clr-namespace:Tracker.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200"
             d:DataContext="{d:DesignInstance Type=viewModels:TrackerMainViewModel}"
             AutomationProperties.Name="Goals"
             AutomationProperties.HelpText="Track individual development goals for team members">
    
    <UserControl.Resources>
        <!-- Card Style -->
        <Style x:Key="GoalCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.15" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Stat Card Style (Clickable) -->
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.12" Color="Black"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Section Header Style -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource HintTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        
        <!-- Stat Value Style -->
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
        </Style>
        
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>
    
    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- ============================================== -->
        <!-- ROW 0: HEADER - Title + Actions -->
        <!-- ============================================== -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel>
                <TextBlock Text="Goals" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource ForegroundBrush}"/>
                <TextBlock FontSize="14" 
                           Foreground="{DynamicResource HintTextBrush}"
                           Margin="0,4,0,0">
                    <Run Text="Track individual development goals for your team"/>
                </TextBlock>
            </StackPanel>
            
            <!-- Quick Action Buttons -->
            <Button Grid.Column="1" 
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding AddGoalCommand}"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Add New Goal"
                    AutomationProperties.HelpText="Open dialog to create a new development goal"
                    ToolTip="Create a new goal"
                    TabIndex="100">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"
                          Fill="{DynamicResource BackgroundBrush}"
                          Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                    <TextBlock Text="Add Goal"/>
                </StackPanel>
            </Button>
        </Grid>
        
        <!-- ============================================== -->
        <!-- ROW 1: STATS BAR (Horizontal) -->
        <!-- ============================================== -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Active -->
            <Border Grid.Column="0" Style="{StaticResource StatCardStyle}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="ACTIVE" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Text="{Binding ActiveGoalCount, FallbackValue='0'}" 
                               Style="{StaticResource StatValue}"
                               Foreground="{DynamicResource AccentBrush}"/>
                </StackPanel>
            </Border>
            
            <!-- On Track -->
            <Border Grid.Column="1" Style="{StaticResource StatCardStyle}" Margin="4,0">
                <StackPanel>
                    <TextBlock Text="ON TRACK" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Text="{Binding OnTrackGoalCount, FallbackValue='0'}" 
                               Style="{StaticResource StatValue}"
                               Foreground="#10B981"/>
                </StackPanel>
            </Border>
            
            <!-- At Risk -->
            <Border Grid.Column="2" Style="{StaticResource StatCardStyle}" Margin="4,0">
                <StackPanel>
                    <TextBlock Text="AT RISK" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Text="{Binding AtRiskGoalCount, FallbackValue='0'}" 
                               Style="{StaticResource StatValue}"
                               Foreground="#EF4444"/>
                </StackPanel>
            </Border>
            
            <!-- Completed -->
            <Border Grid.Column="3" Style="{StaticResource StatCardStyle}" Margin="4,0">
                <StackPanel>
                    <TextBlock Text="COMPLETED" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Text="{Binding CompletedGoalCount, FallbackValue='0'}" 
                               Style="{StaticResource StatValue}"
                               Foreground="#6B7280"/>
                </StackPanel>
            </Border>
            
            <!-- Avg Progress -->
            <Border Grid.Column="4" Style="{StaticResource StatCardStyle}" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="AVG PROGRESS" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Text="{Binding AverageGoalProgress, StringFormat='{}{0}%', FallbackValue='0%'}" 
                               Style="{StaticResource StatValue}"
                               Foreground="#F59E0B"/>
                </StackPanel>
            </Border>
        </Grid>
        
        <!-- ============================================== -->
        <!-- ROW 2: SEARCH & FILTER BAR -->
        <!-- ============================================== -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- Search Box -->
            <Border Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="8"
                    Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                          Fill="{DynamicResource HintTextBrush}"
                          Width="16" Height="16" Stretch="Uniform"
                          VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" 
                             Text="{Binding GoalSearchText, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{DynamicResource ForegroundBrush}"
                             VerticalAlignment="Center"
                             Margin="10,0,0,0"
                             FontSize="13">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="Search goals..." 
                                                                   Foreground="{DynamicResource HintTextBrush}"
                                                                   FontSize="13"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>
            </Border>
            
            <!-- Filter Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                <RadioButton x:Name="ShowAllGoals" 
                             Content="All" 
                             IsChecked="True"
                             GroupName="GoalFilter"
                             Style="{StaticResource SegmentedButtonStyle}"/>
                <RadioButton x:Name="ShowInProgress" 
                             Content="In Progress" 
                             GroupName="GoalFilter"
                             Style="{StaticResource SegmentedButtonStyle}"/>
                <RadioButton x:Name="ShowAtRisk" 
                             Content="At Risk" 
                             GroupName="GoalFilter"
                             Style="{StaticResource SegmentedButtonStyle}"/>
                <RadioButton x:Name="ShowCompletedGoals" 
                             Content="Completed" 
                             GroupName="GoalFilter"
                             Style="{StaticResource SegmentedButtonStyle}"/>
            </StackPanel>
            
            <!-- Team Member Filter -->
            <StackPanel Grid.Column="3" Orientation="Horizontal">
                <TextBlock Text="Member:" 
                           Foreground="{DynamicResource HintTextBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{Binding TeamMembers}"
                          SelectedItem="{Binding SelectedGoalFilterMember}"
                          DisplayMemberPath="FullName"
                          Width="150"
                          Style="{StaticResource {x:Type ComboBox}}"/>
            </StackPanel>
        </Grid>
        
        <!-- ============================================== -->
        <!-- ROW 3: MAIN CONTENT - Cards + Detail Panel -->
        <!-- ============================================== -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>
            
            <!-- Goals Cards Grid (Multi-column) -->
            <ScrollViewer Grid.Column="0" 
                          VerticalScrollBarVisibility="Auto" 
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="0,0,16,0">
                <Grid>
                    <!-- Empty State -->
                    <StackPanel VerticalAlignment="Center" 
                                HorizontalAlignment="Center" 
                                Margin="0,100,0,0"
                                Visibility="{Binding HasNoGoals, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                        <Path Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"
                              Fill="{DynamicResource HintTextBrush}"
                              Width="64" Height="64" Stretch="Uniform"
                              HorizontalAlignment="Center"
                              Opacity="0.4"/>
                        <TextBlock Text="No goals set yet"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource HintTextBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,20,0,8"/>
                        <TextBlock Text="Add your first goal to start tracking"
                                   FontSize="14"
                                   Foreground="{DynamicResource HintTextBrush}"
                                   HorizontalAlignment="Center"
                                   Opacity="0.7"/>
                    </StackPanel>
                    
                    <!-- Cards -->
                    <ItemsControl ItemsSource="{Binding Goals}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="300" 
                                    Style="{StaticResource GoalCardStyle}"
                                    Margin="0,0,12,12"
                                    MouseLeftButtonUp="GoalItem_Click"
                                    Tag="{Binding}"
                                    Cursor="Hand">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <!-- Header: Avatar + Name + Status -->
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Avatar -->
                                        <Grid Width="40" Height="40">
                                            <Ellipse Fill="{DynamicResource AccentBrush}"/>
                                            <TextBlock Text="{Binding TeamMember.Initials, Mode=OneWay}" 
                                                       FontSize="14" 
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource BackgroundBrush}"
                                                       HorizontalAlignment="Center" 
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                        
                                        <!-- Name -->
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TeamMember.FullName, Mode=OneWay}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource HintTextBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Border Background="{DynamicResource BackgroundBrush}"
                                                    CornerRadius="4"
                                                    Padding="6,2"
                                                    HorizontalAlignment="Left"
                                                    Margin="0,4,0,0">
                                                <TextBlock Text="{Binding Category, Mode=OneWay}"
                                                           FontSize="9"
                                                           Foreground="{DynamicResource ForegroundBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        
                                        <!-- Status Badge -->
                                        <Border Grid.Column="2" 
                                                CornerRadius="10" 
                                                Padding="8,3" 
                                                VerticalAlignment="Top"
                                                Background="{Binding Status, Converter={x:Static converters:GoalStatusToColorConverter.Instance}}">
                                            <TextBlock Text="{Binding Status, Mode=OneWay}" 
                                                       FontSize="9"
                                                       FontWeight="SemiBold"
                                                       Foreground="White"/>
                                        </Border>
                                    </Grid>
                                    
                                    <!-- Title -->
                                    <TextBlock Grid.Row="1" 
                                               Text="{Binding Title, Mode=OneWay}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="Wrap"
                                               MaxHeight="40"
                                               Margin="0,0,0,10"/>
                                    
                                    <!-- Progress Bar -->
                                    <Grid Grid.Row="2" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}"
                                                     Maximum="100"
                                                     Height="8"
                                                     Background="{DynamicResource BackgroundBrush}"
                                                     Foreground="{DynamicResource AccentBrush}"/>
                                        
                                        <TextBlock Grid.Column="1" 
                                                   Text="{Binding ProgressPercent, StringFormat='{}{0}%', Mode=OneWay}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    
                                    <!-- Target Date & Days Remaining -->
                                    <Grid Grid.Row="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M19,19H5V8H19M16,1V3H8V1H6V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3H18V1"
                                                  Fill="{DynamicResource HintTextBrush}"
                                                  Width="12" Height="12" Stretch="Uniform"
                                                  VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding TargetDate, StringFormat='{}{0:MMM dd}', Mode=OneWay}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource HintTextBrush}"
                                                       Margin="6,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        
                                        <!-- Days Remaining -->
                                        <TextBlock Grid.Column="1"
                                                   FontSize="11"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource HintTextBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                            <Setter Property="Foreground" Value="#EF4444"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <Run Text="{Binding DaysRemaining, Mode=OneWay}"/>
                                            <Run Text="d left"/>
                                        </TextBlock>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </Grid>
            </ScrollViewer>
            
            <!-- ============================================== -->
            <!-- RIGHT SIDEBAR: Selected Goal Details -->
            <!-- ============================================== -->
            <Border Grid.Column="1" 
                    Style="{StaticResource GoalCardStyle}"
                    Visibility="{Binding SelectedGoal, Converter={x:Static converters:NullToVisibilityConverter.Instance}}"
                    Margin="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        
                        <!-- Goal Header -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Grid Width="56" Height="56">
                                <Ellipse Fill="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="{Binding SelectedGoal.TeamMember.Initials, Mode=OneWay}" 
                                           FontSize="20" 
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource BackgroundBrush}"
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                            </Grid>
                            
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedGoal.TeamMember.FullName, Mode=OneWay}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource ForegroundBrush}"/>
                                <Border Background="{DynamicResource BackgroundBrush}"
                                        CornerRadius="4"
                                        Padding="6,2"
                                        HorizontalAlignment="Left"
                                        Margin="0,4,0,0">
                                    <TextBlock Text="{Binding SelectedGoal.Category, Mode=OneWay}"
                                               FontSize="10"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                        
                        <!-- Status & Progress -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel>
                                <TextBlock Text="Status" 
                                           FontSize="10"
                                           Foreground="{DynamicResource HintTextBrush}"/>
                                <Border CornerRadius="6" 
                                        Padding="8,4"
                                        HorizontalAlignment="Left"
                                        Margin="0,4,0,0"
                                        Background="{Binding SelectedGoal.Status, Converter={x:Static converters:GoalStatusToColorConverter.Instance}}">
                                    <TextBlock Text="{Binding SelectedGoal.Status, Mode=OneWay}" 
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="White"/>
                                </Border>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Progress" 
                                           FontSize="10"
                                           Foreground="{DynamicResource HintTextBrush}"/>
                                <TextBlock Text="{Binding SelectedGoal.ProgressPercent, StringFormat='{}{0}%', Mode=OneWay}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                        
                        <!-- Progress Bar -->
                        <ProgressBar Value="{Binding SelectedGoal.ProgressPercent, Mode=OneWay}"
                                     Maximum="100"
                                     Height="8"
                                     Background="{DynamicResource BackgroundBrush}"
                                     Foreground="{DynamicResource AccentBrush}"
                                     Margin="0,0,0,16"/>
                        
                        <!-- Title -->
                        <TextBlock Text="GOAL" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding SelectedGoal.Title, Mode=OneWay}"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,16"/>
                        
                        <!-- Description -->
                        <TextBlock Text="DESCRIPTION" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                        <Border Background="{DynamicResource BackgroundBrush}"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,0,0,16">
                            <TextBlock Text="{Binding SelectedGoal.Description, Mode=OneWay}"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap"
                                       FontSize="13"
                                       LineHeight="20"/>
                        </Border>
                        
                        <!-- Target Date -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel>
                                <TextBlock Text="Target" FontSize="10" Foreground="{DynamicResource HintTextBrush}"/>
                                <TextBlock Text="{Binding SelectedGoal.TargetDate, StringFormat='{}{0:MMM dd}', Mode=OneWay}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Days Left" FontSize="10" Foreground="{DynamicResource HintTextBrush}"/>
                                <TextBlock FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedGoal.IsOverdue}" Value="True">
                                                    <Setter Property="Foreground" Value="#EF4444"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <Run Text="{Binding SelectedGoal.DaysRemaining, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                        
                        <!-- Milestones -->
                        <TextBlock Text="MILESTONES" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding SelectedGoal.Milestones}" Margin="0,0,0,16">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <Path Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"
                                              Width="14" Height="14" Stretch="Uniform"
                                              VerticalAlignment="Top" Margin="0,2,0,0">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Fill" Value="{DynamicResource HintTextBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                            <Setter Property="Fill" Value="#10B981"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                        
                                        <TextBlock Grid.Column="1" 
                                                   Text="{Binding Description, Mode=OneWay}"
                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Margin="8,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                            <Setter Property="Opacity" Value="0.6"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        
                        <!-- Actions -->
                        <Border BorderThickness="0,1,0,0"
                                BorderBrush="{DynamicResource BorderBrush}"
                                Padding="0,16,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="Edit"
                                        Command="{Binding EditGoalCommand}"
                                        CommandParameter="{Binding SelectedGoal}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Margin="0,0,8,0"/>
                                <Button Content="Delete"
                                        Command="{Binding DeleteGoalCommand}"
                                        CommandParameter="{Binding SelectedGoal}"
                                        Style="{StaticResource SecondaryButtonStyle}"/>
                            </StackPanel>
                        </Border>
                        
                    </StackPanel>
                </ScrollViewer>
            </Border>
            
