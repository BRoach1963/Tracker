<UserControl x:Class="Tracker.Controls.Settings.OracleSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:Tracker.Common.Converters"
             xmlns:viewModels="clr-namespace:Tracker.ViewModels.DialogViewModels"
             xmlns:custom="clr-namespace:Tracker.Controls.CustomControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="450"
             d:DataContext="{d:DesignInstance Type=viewModels:SettingsViewModel}">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="BoolToVisibilityInverseConverter"/>
    </UserControl.Resources>
    
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="20,0,0,0">
        <StackPanel MaxWidth="450" HorizontalAlignment="Left">
            
            <!-- AI Provider Selection -->
            <Label Style="{StaticResource LabelStyle}" Content="AI Provider" Margin="0,8,0,0"/>
            <Border Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="6"
                    Padding="12"
                    Margin="0,5,0,10">
                <StackPanel>
                    <TextBlock Text="Select which AI service powers your Oracle assistant" 
                               TextWrapping="Wrap" Margin="0,0,0,12"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    
                    <ComboBox x:Name="ProviderComboBox"
                              SelectedItem="{Binding SelectedAIProvider, Mode=TwoWay}"
                              ItemsSource="{Binding AvailableAIProviders}"
                              Margin="0,0,0,8"/>
                    
                    <TextBlock x:Name="ProviderDescriptionText"
                               Text="{Binding AIProviderDescription}"
                               FontSize="11"
                               Foreground="{DynamicResource HintTextBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            
            <!-- Usage & Budget -->
            <Label Style="{StaticResource LabelStyle}" Content="AI Credit Usage" Margin="0,8,0,0"/>
            <Border Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="6"
                    Padding="12"
                    Margin="0,5,0,10">
                <StackPanel>
                    <!-- Credit Summary -->
                    <TextBlock Text="{Binding CreditUsageSummary}" 
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Margin="0,0,0,12"/>
                    
                    <!-- Progress Bar (hidden for unlimited) -->
                    <custom:TrackerProgressBar Value="{Binding CreditsUsedPercent}"
                                               Maximum="100"
                                               Height="8"
                                               Margin="0,0,0,12"
                                               TrackBrush="{DynamicResource SurfaceVariantBrush}"
                                               FillBrush="{DynamicResource PrimaryBrush}"
                                               ShowPercentage="False"
                                               Visibility="{Binding HasUnlimitedCredits, Converter={StaticResource BoolToVisibilityInverseConverter}}"/>
                    
                    <!-- Credit Details -->
                    <Grid Margin="0,0,0,8"
                          Visibility="{Binding HasUnlimitedCredits, Converter={StaticResource BoolToVisibilityInverseConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Monthly Allowance" FontSize="11" Foreground="{DynamicResource HintTextBrush}"/>
                            <TextBlock Text="{Binding MonthlyCredits, StringFormat={}{0:N0} credits}" 
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Purchased Credits" FontSize="11" Foreground="{DynamicResource HintTextBrush}"/>
                            <TextBlock Text="{Binding AdditionalCredits, StringFormat={}{0:N0} credits}" 
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </StackPanel>
                    </Grid>
                    
                    <!-- Warning when exhausted -->
                    <Border Background="{DynamicResource WarningBackgroundBrush}" 
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,0,0,12"
                            Visibility="{Binding IsCreditsExhausted, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M13,14H11V10H13M13,18H11V16H13M1,21H23L12,2L1,21Z"
                                  Width="16" Height="16"
                                  Stretch="Uniform"
                                  Fill="{DynamicResource WarningBrush}"
                                  Margin="0,0,10,0"
                                  VerticalAlignment="Top"/>
                            <TextBlock Text="Your AI credits are exhausted. Purchase more to continue using Oracle." 
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource WarningBrush}"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Purchase Button -->
                    <Button Content="Purchase More Credits"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding PurchaseCreditsCommand}"
                            HorizontalAlignment="Left"
                            Visibility="{Binding HasUnlimitedCredits, Converter={StaticResource BoolToVisibilityInverseConverter}}"/>
                    
                    <TextBlock Text="Credits reset on the 1st of each month. Purchased credits never expire."
                               FontSize="11" Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource HintTextBrush}"
                               Visibility="{Binding HasUnlimitedCredits, Converter={StaticResource BoolToVisibilityInverseConverter}}"/>
                </StackPanel>
            </Border>
            
            <!-- AI Settings -->
            <Label Style="{StaticResource LabelStyle}" Content="Settings" Margin="0,8,0,0"/>
            <Border Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="6"
                    Padding="12"
                    Margin="0,5,0,10">
                <StackPanel>
                    <CheckBox Content="Enable AI features" 
                              IsChecked="{Binding IsAIEnabled, Mode=TwoWay}"
                              Margin="0,0,0,8"/>
                    
                    <TextBlock Text="When disabled, Oracle and AI-powered insights will not be available."
                               FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource HintTextBrush}"/>
                </StackPanel>
            </Border>
            
            <!-- Vector Storage -->
            <Label Style="{StaticResource LabelStyle}" Content="Vector Storage" Margin="0,8,0,0"/>
            <Border Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="6"
                    Padding="12"
                    Margin="0,5,0,10">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Current Provider" FontSize="11" Foreground="{DynamicResource HintTextBrush}"/>
                            <TextBlock Text="{Binding VectorStorageProviderName}" 
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </StackPanel>
                        <Path Grid.Column="1" 
                              Data="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M11,16.5L18,9.5L16.59,8.09L11,13.67L7.41,10.09L6,11.5L11,16.5Z"
                              Width="24" Height="24"
                              Stretch="Uniform"
                              Fill="{DynamicResource SuccessBrush}"
                              VerticalAlignment="Center"
                              Visibility="{Binding HasNativeVectorSupport, Converter={StaticResource BoolToVisibilityConverter}}"
                              ToolTip="Native vector support with pgvector"/>
                    </Grid>
                    
                    <TextBlock Text="Vector embeddings are stored in your main database for semantic search and AI features."
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Foreground="{DynamicResource HintTextBrush}"/>
                    
                    <!-- Legacy migration notice -->
                    <Border Background="{DynamicResource InfoBackgroundBrush}" 
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,12,0,0"
                            Visibility="{Binding HasLegacyVectorStore, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Path Data="M13,9H11V7H13M13,17H11V11H13M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z"
                                      Width="16" Height="16"
                                      Stretch="Uniform"
                                      Fill="{DynamicResource InfoBrush}"
                                      Margin="0,0,8,0"
                                      VerticalAlignment="Center"/>
                                <TextBlock Text="Legacy Data Found" 
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource InfoBrush}"/>
                            </StackPanel>
                            <TextBlock TextWrapping="Wrap"
                                       Foreground="{DynamicResource SecondaryTextBrush}">
                                <Run Text="Your previous vector embeddings ("/>
                                <Run Text="{Binding LegacyVectorStoreSize, Mode=OneWay}"/>
                                <Run Text=") can be migrated to your current database. Use 'Refresh AI Knowledge' to reindex your data."/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
            
        </StackPanel>
    </ScrollViewer>
</UserControl>
