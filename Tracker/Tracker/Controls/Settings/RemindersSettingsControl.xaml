<UserControl x:Class="Tracker.Controls.Settings.RemindersSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,0,0,0">
            
            <!-- Notification Preferences -->
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="12" Margin="0,0,20,16">
                <StackPanel>
                    <Label Content="Notification Preferences" Style="{StaticResource LabelStyle}"/>
                    <CheckBox Content="Enable desktop notifications" IsChecked="{Binding DesktopNotificationsEnabled}" Margin="0,8,0,4"/>
                    <CheckBox Content="Play notification sounds" IsChecked="{Binding NotificationSoundsEnabled}" Margin="0,4"/>
                    <CheckBox Content="Show email notifications" IsChecked="{Binding EmailNotificationsEnabled}" Margin="0,4"/>
                </StackPanel>
            </Border>
            
            <!-- Follow-up Reminders -->
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="12" Margin="0,0,20,16">
                <StackPanel>
                    <Label Content="Follow-up Reminders" Style="{StaticResource LabelStyle}"/>
                    <CheckBox Content="Automatically create follow-up reminders" IsChecked="{Binding AutoFollowUpEnabled}" Margin="0,8,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <Label Content="Default follow-up interval:" Foreground="{DynamicResource HintTextBrush}"/>
                        <ComboBox x:Name="FollowUpIntervalComboBox" Width="120" Margin="8,0,0,0" SelectedValue="{Binding DefaultFollowUpDays}">
                            <ComboBoxItem Content="1 day" Tag="1"/>
                            <ComboBoxItem Content="3 days" Tag="3"/>
                            <ComboBoxItem Content="1 week" Tag="7"/>
                            <ComboBoxItem Content="2 weeks" Tag="14"/>
                            <ComboBoxItem Content="1 month" Tag="30"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Border>
            
            <!-- Reminder Types -->
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="12" Margin="0,0,20,16">
                <StackPanel>
                    <Label Content="Reminder Types" Style="{StaticResource LabelStyle}"/>
                    <CheckBox Content="Show birthday reminders" IsChecked="{Binding BirthdayRemindersEnabled}" Margin="0,8,0,4"/>
                    <CheckBox Content="Show meeting reminders" IsChecked="{Binding MeetingRemindersEnabled}" Margin="0,4"/>
                    <CheckBox Content="Show task reminders" IsChecked="{Binding TaskRemindersEnabled}" Margin="0,4"/>
                    <CheckBox Content="Show anniversary reminders" IsChecked="{Binding AnniversaryRemindersEnabled}" Margin="0,4"/>
                </StackPanel>
            </Border>
            
            <!-- Quiet Hours -->
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="12" Margin="0,0,20,16">
                <StackPanel>
                    <Label Content="Quiet Hours" Style="{StaticResource LabelStyle}"/>
                    <CheckBox x:Name="QuietHoursCheckBox" Content="Enable quiet hours" IsChecked="{Binding QuietHoursEnabled}" Margin="0,8,0,8"/>
                    <Grid IsEnabled="{Binding IsChecked, ElementName=QuietHoursCheckBox}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        
                        <Label Grid.Row="0" Grid.Column="0" Content="From:" Foreground="{DynamicResource HintTextBrush}"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding QuietHoursStartTime}" Margin="4,0"/>
                        
                        <Label Grid.Row="0" Grid.Column="3" Content="To:" Foreground="{DynamicResource HintTextBrush}"/>
                        <TextBox Grid.Row="0" Grid.Column="4" Text="{Binding QuietHoursEndTime}" Margin="4,0"/>
                        
                        <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" 
                                  Content="Apply quiet hours on weekends" 
                                  IsChecked="{Binding QuietHoursOnWeekends}" 
                                  Margin="0,8,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>
            
            <!-- Reminder Actions -->
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="12" Margin="0,0,20,16">
                <StackPanel>
                    <Label Content="Reminder Management" Style="{StaticResource LabelStyle}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                        <Button x:Name="ViewActiveRemindersButton" 
                                Content="View Active Reminders" 
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,0,10,0"/>
                        <Button x:Name="ClearCompletedButton" 
                                Content="Clear Completed" 
                                Style="{StaticResource DangerButtonStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            
        </StackPanel>
    </ScrollViewer>
</UserControl>
