<UserControl x:Class="Tracker.Controls.TeamMemberGoalsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:Tracker.Common.Converters"
             mc:Ignorable="d"
             d:DesignHeight="200" d:DesignWidth="400">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles/DialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Icon resources -->
            <PathGeometry x:Key="EditIcon" Figures="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"/>
            <PathGeometry x:Key="DeleteIcon" Figures="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"/>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" 
                Background="{DynamicResource AccentBrush}" 
                CornerRadius="6,6,0,0"
                Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Goals" 
                           FontWeight="SemiBold" 
                           FontSize="14"
                           Foreground="{DynamicResource BackgroundBrush}"/>
                <TextBlock Grid.Column="1" 
                           Text="{Binding GoalCount, StringFormat='{}{0} goals'}"
                           FontSize="12"
                           Foreground="{DynamicResource BackgroundBrush}"
                           Opacity="0.8"
                           Margin="0,0,12,0"/>
                <Button Grid.Column="2"
                        Content="+ Add"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        Command="{Binding AddGoalCommand}"
                        Padding="8,4"
                        FontSize="11"
                        MinWidth="50"/>
            </Grid>
        </Border>
        
        <!-- Goal List -->
        <Border Grid.Row="1" 
                BorderBrush="{DynamicResource ForegroundBrush}" 
                BorderThickness="1,0,1,1"
                CornerRadius="0,0,6,6"
                Background="{DynamicResource BackgroundBrush}">
            <Grid>
                <!-- Empty State -->
                <StackPanel HorizontalAlignment="Center" 
                            VerticalAlignment="Center"
                            Visibility="{Binding HasNoGoals, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}">
                    <TextBlock Text="No goals yet" 
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource HintTextBrush}"
                               Opacity="0.6"
                               FontSize="13"/>
                    <TextBlock Text="Click '+ Add' to create a goal" 
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource HintTextBrush}"
                               Opacity="0.4"
                               FontSize="11"
                               Margin="0,4,0,0"/>
                </StackPanel>
                
                <!-- Goal List -->
                <ListView ItemsSource="{Binding Goals}"
                          SelectedItem="{Binding SelectedGoal}"
                          BorderThickness="0"
                          Background="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          HorizontalContentAlignment="Stretch"
                          Visibility="{Binding HasGoals, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}"
                          MouseDoubleClick="ListView_MouseDoubleClick">
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Edit Goal" 
                                      Command="{Binding EditGoalCommand}"
                                      Icon="{StaticResource EditIcon}"/>
                            <MenuItem Header="Delete Goal" 
                                      Command="{Binding DeleteGoalCommand}"
                                      Icon="{StaticResource DeleteIcon}"/>
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,8" 
                                    BorderBrush="{DynamicResource BorderBrush}" 
                                    BorderThickness="0,0,0,1"
                                    Background="Transparent"
                                    Cursor="Hand">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <!-- Title -->
                                    <TextBlock Grid.Column="0" Grid.Row="0"
                                               Text="{Binding Title}"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               TextWrapping="Wrap"
                                               ToolTip="{Binding Title}"/>
                                    
                                    <!-- Status Badge -->
                                    <Border Grid.Column="1" Grid.Row="0"
                                            Background="{Binding Status, Converter={x:Static converters:GoalStatusToColorConverter.Instance}}"
                                            CornerRadius="4"
                                            Padding="6,2"
                                            Margin="8,0,0,0">
                                        <TextBlock Text="{Binding Status}"
                                                   FontSize="10"
                                                   Foreground="White"/>
                                    </Border>
                                    
                                    <!-- Description Preview -->
                                    <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1"
                                               Text="{Binding Description}"
                                               Foreground="{DynamicResource HintTextBrush}"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               MaxHeight="32"
                                               TextWrapping="Wrap"
                                               ToolTip="{Binding Description}"
                                               Margin="0,3,0,0"/>
                                    
                                    <!-- Target Date -->
                                    <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2"
                                               Text="{Binding TargetDate, StringFormat='Target: {0:MMM dd, yyyy}'}"
                                               FontSize="10"
                                               Foreground="{DynamicResource HintTextBrush}"
                                               Opacity="0.7"
                                               Margin="0,3,0,0"/>
                                    
                                    <!-- Progress Bar -->
                                    <Grid Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="3" Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Height="4" 
                                                CornerRadius="2" 
                                                Background="{DynamicResource SurfaceBrush}">
                                            <Border HorizontalAlignment="Left"
                                                    CornerRadius="2"
                                                    Background="{DynamicResource AccentBrush}">
                                                <Border.Width>
                                                    <MultiBinding Converter="{x:Static converters:ProgressWidthConverter.Instance}">
                                                        <Binding Path="Progress"/>
                                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}"/>
                                                    </MultiBinding>
                                                </Border.Width>
                                            </Border>
                                        </Border>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Progress, StringFormat='{}{0:F0}%'}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource HintTextBrush}"
                                                   Margin="8,0,0,0"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</UserControl>

