<UserControl x:Class="Tracker.Controls.HelpBotControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:Tracker.ViewModels"
             xmlns:converters="clr-namespace:Tracker.Common.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="400"
             d:DataContext="{d:DesignInstance Type=viewModels:HelpBotViewModel}">
    
    <UserControl.Resources>
        <!-- User Message Style (right-aligned, accent color) -->
        <DataTemplate x:Key="UserMessageTemplate">
            <Grid Margin="40,4,8,4" HorizontalAlignment="Right">
                <Border Background="{DynamicResource AccentBrush}"
                        CornerRadius="12,12,4,12"
                        Padding="12,8"
                        MaxWidth="300">
                    <StackPanel>
                        <TextBlock Text="{Binding Content}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource BackgroundBrush}"
                                   FontSize="13"/>
                        <TextBlock Text="{Binding TimeDisplay}"
                                   FontSize="10"
                                   Foreground="{DynamicResource BackgroundBrush}"
                                   Opacity="0.7"
                                   HorizontalAlignment="Right"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>
        
        <!-- Assistant Message Style (left-aligned, surface color) -->
        <DataTemplate x:Key="AssistantMessageTemplate">
            <Grid Margin="8,4,40,4" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Sparkle Avatar -->
                <Border Grid.Column="0" 
                        Width="32" Height="32"
                        Background="#1A1A2E"
                        CornerRadius="16"
                        VerticalAlignment="Top"
                        Margin="0,0,8,0">
                    <Path Data="M12,1L9,9L1,12L9,15L12,23L15,15L23,12L15,9L12,1Z"
                          Width="18" Height="18"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                        <Path.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FFF8E1" Offset="0"/>
                                <GradientStop Color="#4FC3F7" Offset="0.5"/>
                                <GradientStop Color="#0288D1" Offset="1"/>
                            </LinearGradientBrush>
                        </Path.Fill>
                    </Path>
                </Border>
                
                <Border Grid.Column="1"
                        Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="12,12,12,4"
                        Padding="12,8"
                        MaxWidth="280">
                    <StackPanel>
                        <TextBlock Text="{Binding Content}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   FontSize="13"/>
                        <TextBlock Text="{Binding TimeDisplay}"
                                   FontSize="10"
                                   Foreground="{DynamicResource HintTextBrush}"
                                   HorizontalAlignment="Right"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>
        
        <!-- Message Template Selector -->
        <local:ChatMessageTemplateSelector x:Key="MessageTemplateSelector"
                                           xmlns:local="clr-namespace:Tracker.Controls"
                                           UserTemplate="{StaticResource UserMessageTemplate}"
                                           AssistantTemplate="{StaticResource AssistantMessageTemplate}"/>
    </UserControl.Resources>
    
    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" 
                Background="{DynamicResource SurfaceBrush}"
                Padding="16,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                    <!-- Sparkle Icon -->
                    <Grid Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Path Data="M12,1L9,9L1,12L9,15L12,23L15,15L23,12L15,9L12,1Z"
                              Stretch="Uniform" Width="20" Height="20"
                              HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FFFAF0" Offset="0"/>
                                    <GradientStop Color="#4FC3F7" Offset="0.5"/>
                                    <GradientStop Color="#0288D1" Offset="1"/>
                                </LinearGradientBrush>
                            </Path.Fill>
                        </Path>
                    </Grid>
                    <TextBlock Text="Help Assistant"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Foreground="{DynamicResource ForegroundBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                
                <!-- Clear Button -->
                <Button Grid.Row="0" Grid.Column="2"
                        Command="{Binding ClearCommand}"
                        ToolTip="Clear conversation"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="8"
                        Cursor="Hand">
                    <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                          Width="14" Height="14"
                          Stretch="Uniform"
                          Fill="{DynamicResource HintTextBrush}"/>
                </Button>
                
                <!-- Usage Info - Hidden for SaaS (costs covered by subscription) -->
                <!-- Keeping code for internal monitoring, not user-facing -->
                <TextBlock Grid.Row="1" Grid.ColumnSpan="3"
                           Text="{Binding UsageSummary}"
                           FontSize="10"
                           Foreground="{DynamicResource HintTextBrush}"
                           Margin="0,4,0,0"
                           ToolTip="AI usage this month"
                           Visibility="Collapsed"/>
            </Grid>
        </Border>
        
        <!-- Messages Area -->
        <ScrollViewer Grid.Row="1" 
                      x:Name="MessagesScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,8">
            <ItemsControl ItemsSource="{Binding Messages}"
                          ItemTemplateSelector="{StaticResource MessageTemplateSelector}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>
        
        <!-- Status Bar -->
        <Border Grid.Row="2" 
                Padding="12,6"
                Visibility="{Binding StatusMessage, Converter={x:Static converters:StringToVisibilityConverter.Instance}}">
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="11"
                       Foreground="{DynamicResource HintTextBrush}"
                       TextWrapping="Wrap"/>
        </Border>
        
        <!-- Input Area -->
        <Border Grid.Row="3" 
                Background="{DynamicResource SurfaceBrush}"
                Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Input TextBox -->
                <Border Grid.Column="0"
                        Background="{DynamicResource BackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="4,0">
                    <TextBox x:Name="InputTextBox"
                             Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{DynamicResource ForegroundBrush}"
                             CaretBrush="{DynamicResource ForegroundBrush}"
                             VerticalContentAlignment="Center"
                             Padding="12,8"
                             FontSize="13"
                             MaxHeight="100"
                             TextWrapping="Wrap"
                             AcceptsReturn="False"
                             KeyDown="InputTextBox_KeyDown"
                             IsEnabled="{Binding IsAvailable}">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Border>
                
                <!-- Send Button -->
                <Button Grid.Column="1"
                        Command="{Binding SendCommand}"
                        Width="40" Height="40"
                        Margin="8,0,0,0"
                        Background="{DynamicResource AccentBrush}"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="Send message (Enter)">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="20">
                                <Grid>
                                    <!-- Send Icon (when not loading) -->
                                    <Path x:Name="SendIcon"
                                          Data="M2,21L23,12L2,3V10L17,12L2,14V21Z"
                                          Width="18" Height="18"
                                          Stretch="Uniform"
                                          Fill="{DynamicResource BackgroundBrush}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                    
                                    <!-- Loading indicator -->
                                    <Grid x:Name="LoadingIndicator" Visibility="Collapsed">
                                        <Ellipse Width="20" Height="20"
                                                 Stroke="{DynamicResource BackgroundBrush}"
                                                 StrokeThickness="2"
                                                 StrokeDashArray="3,2"
                                                 RenderTransformOrigin="0.5,0.5">
                                            <Ellipse.RenderTransform>
                                                <RotateTransform x:Name="LoadingRotation"/>
                                            </Ellipse.RenderTransform>
                                            <Ellipse.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation 
                                                                Storyboard.TargetName="LoadingRotation"
                                                                Storyboard.TargetProperty="Angle"
                                                                From="0" To="360" Duration="0:0:1"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Ellipse.Triggers>
                                        </Ellipse>
                                    </Grid>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.9"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter TargetName="SendIcon" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="LoadingIndicator" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>

