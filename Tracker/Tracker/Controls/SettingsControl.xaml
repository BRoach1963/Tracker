<UserControl x:Class="Tracker.Controls.SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:Tracker.Controls"
             xmlns:languages="clr-namespace:Tracker.Resources.Languages"
             xmlns:attachedProperties="clr-namespace:Tracker.AttachedProperties"
             xmlns:converters="clr-namespace:Tracker.Common.Converters"
             xmlns:viewModels="clr-namespace:Tracker.ViewModels.DialogViewModels"
             xmlns:help="clr-namespace:Tracker.Help.Attributes"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=viewModels:SettingsViewModel}"
             AutomationProperties.Name="Settings"
             AutomationProperties.HelpText="Configure application settings, themes, database, and integrations">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles.xaml"/>
                <ResourceDictionary Source="/Resources/Styles/DialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <TextBlock Text="{x:Static languages:Resources.Settings_Title}"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource ForegroundBrush}"
                   Margin="0,0,0,20"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TabControl Grid.Column="0"
                       Margin="0,0,5,0">
                <TabItem x:Name="General"
                         Header="{x:Static languages:Resources.TabHeader_GeneralSettings}"
                         help:HelpProperties.TopicId="dialogs/settings"
                         help:HelpProperties.Section="general-settings"
                         attachedProperties:TabItemExtensions.IconData="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"
                         attachedProperties:TooltipProperties.Text="General application settings and theme"/>
                <TabItem x:Name="Account"
                         Header="Account"
                         help:HelpProperties.TopicId="dialogs/settings"
                         help:HelpProperties.Section="account-settings"
                         attachedProperties:TabItemExtensions.IconData="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z"
                         attachedProperties:TooltipProperties.Text="Account and authentication settings"/>
                <TabItem x:Name="Database"
                         Header="{x:Static languages:Resources.TabHeader_DatabaseSettings}"
                         help:HelpProperties.TopicId="dialogs/settings"
                         help:HelpProperties.Section="database-settings"
                         attachedProperties:TabItemExtensions.IconData="M7,22H9V24H7V22M11,22H13V24H11V22M15,22H17V24H15V22M12,3C16.42,3 20,4.79 20,7C20,9.21 16.42,11 12,11C7.58,11 4,9.21 4,7C4,4.79 7.58,3 12,3M4,9C4,11.21 7.58,13 12,13C16.42,13 20,11.21 20,9V12C20,14.21 16.42,16 12,16C7.58,16 4,14.21 4,12V9M4,14C4,16.21 7.58,18 12,18C16.42,18 20,16.21 20,14V17C20,18.19 18.95,19.27 17.29,20H6.71C5.05,19.27 4,18.19 4,17V14Z"
                         attachedProperties:TooltipProperties.Text="Database connection and seed settings"/>
                <TabItem x:Name="Calendar"
                         Header="Calendar"
                         help:HelpProperties.TopicId="dialogs/settings"
                         help:HelpProperties.Section="calendar-settings"
                         attachedProperties:TabItemExtensions.IconData="M19,19H5V8H19M16,1V3H8V1H6V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3H18V1M17,12H12V17H17V12Z"
                         attachedProperties:TooltipProperties.Text="Calendar and email integration settings"/>
                <TabItem x:Name="Reminders"
                         Header="Reminders"
                         help:HelpProperties.TopicId="dialogs/settings"
                         help:HelpProperties.Section="reminders-settings"
                         attachedProperties:TabItemExtensions.IconData="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M16.2,16.2L11,13V7H12.5V12.2L17,15.1L16.2,16.2Z"
                         attachedProperties:TooltipProperties.Text="Configure reminders and notifications"/>
                <TabItem x:Name="Logs"
                         Header="Logs"
                         help:HelpProperties.TopicId="dialogs/settings"
                         help:HelpProperties.Section="logs-viewer"
                         attachedProperties:TabItemExtensions.IconData="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20M13,17V19H11V17H13M13,11V15H11V11H13Z"
                         attachedProperties:TooltipProperties.Text="View application logs"/>
            </TabControl>
            <StackPanel Orientation="Vertical"
                       Grid.Column="1"
                       Visibility="{Binding ElementName=General, Path=IsSelected, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}"
                       Margin="20,0,0,0">
                <Label Style="{StaticResource LabelStyle}"
                       Content="Theme" />
                <ComboBox ItemsSource="{Binding AvailableThemes}"
                          SelectedItem="{Binding SelectedTheme}"
                          Width="200"
                          HorizontalAlignment="Left"
                          Margin="0,5,0,0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="14" Height="14" 
                                         Fill="{Binding PreviewColor}" 
                                         Margin="0,0,10,0"
                                         VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding DisplayName}" 
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                
                <TextBlock Text="Theme changes are applied immediately and saved automatically."
                           Foreground="{DynamicResource HintTextBrush}"
                           FontSize="11"
                           Margin="0,8,0,0"
                           FontStyle="Italic"/>
                
                <!-- Setup & Reset Section -->
                <Label Style="{StaticResource LabelStyle}" Content="Setup &amp; Reset" Margin="0,25,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Re-run Setup Wizard"
                            Command="{Binding ResetSetupCommand}"
                            Padding="16,8"
                            Margin="0,0,10,0"/>
                    <Button Content="Reset All Settings"
                            Command="{Binding ResetSettingsCommand}"
                            Padding="16,8"
                            Background="#8B0000"
                            Foreground="White"/>
                </StackPanel>
                <TextBlock Text="'Re-run Setup Wizard' shows the initial configuration wizard. 'Reset All Settings' clears all preferences but keeps your data."
                           Foreground="{DynamicResource HintTextBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           MaxWidth="350"
                           HorizontalAlignment="Left"
                           Margin="0,8,0,0"/>
                
                <!-- AI Help Bot Section -->
                <Label Style="{StaticResource LabelStyle}" Content="AI Help Bot" Margin="0,25,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="🔄 Refresh AI Knowledge Base"
                            Command="{Binding RefreshAiKnowledgeCommand}"
                            Padding="16,8"
                            IsEnabled="{Binding IsNotRefreshingAi}"/>
                </StackPanel>
                <TextBlock Text="{Binding AiRefreshStatus}"
                           Foreground="{DynamicResource AccentBrush}"
                           FontSize="12"
                           FontWeight="Medium"
                           TextWrapping="Wrap"
                           MaxWidth="350"
                           HorizontalAlignment="Left"
                           Margin="0,8,0,0"
                           Visibility="{Binding HasAiRefreshStatus, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}"/>
                <TextBlock Text="Re-indexes all documentation files for the AI Help Bot. Use this after updating help files or integrations."
                           Foreground="{DynamicResource HintTextBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           MaxWidth="350"
                           HorizontalAlignment="Left"
                           Margin="0,8,0,0"/>
            </StackPanel>
            
            <!-- Account Settings Panel -->
            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding ElementName=Account, Path=IsSelected, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}"
                          Margin="20,0,0,0">
                <StackPanel MaxWidth="450" HorizontalAlignment="Left">
                    
                    <!-- Account Info Control (shared with dialog) -->
                    <controls:AccountInfoControl/>
                    
                    <!-- Windows Authentication Section -->
                    <Label Style="{StaticResource LabelStyle}" Content="Windows Authentication" Margin="0,8,0,0"/>
                    <Border Background="{DynamicResource SurfaceBrush}"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,5,0,10">
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource ForegroundBrush}">
                                <Run Text="Status: " FontWeight="SemiBold"/>
                                <Run Text="{Binding WindowsAuthStatusText, Mode=OneWay, TargetNullValue='Not configured', FallbackValue='Not configured'}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Enable Windows Authentication"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding EnableWindowsAuthCommand}"
                                Margin="0,0,10,0"
                                Visibility="{Binding UseWindowsAuthentication, Converter={x:Static converters:ReverseBoolToVisibilityConverter.Instance}}"/>
                        <Button Content="Disable Windows Authentication"
                                Style="{StaticResource DestructiveButtonStyle}"
                                Command="{Binding DisableWindowsAuthCommand}"
                                Visibility="{Binding UseWindowsAuthentication, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}"/>
                    </StackPanel>
                    
                    <TextBlock TextWrapping="Wrap"
                               HorizontalAlignment="Left"
                               Foreground="{DynamicResource HintTextBrush}"
                               FontSize="11"
                               Margin="0,0,0,20">
                        <Run FontWeight="SemiBold">Windows Authentication</Run>
                        <Run>allows you to skip the login screen on startup. Your Windows account will be used to automatically identify you. All your data will be associated with this Windows account.</Run>
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>
            
            <StackPanel Orientation="Vertical"
                       Grid.Column="1"
                       Visibility="{Binding ElementName=Database, Path=IsSelected, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}"                                
                       Margin="20,0,0,0">
                
                <!-- Current Connection Info -->
                <Label Style="{StaticResource LabelStyle}" Content="Current Connection" />
                <Border Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="6"
                        Padding="12"
                        Margin="0,5,0,15">
                    <StackPanel>
                        <TextBlock Foreground="{DynamicResource ForegroundBrush}">
                            <Run Text="Type: " FontWeight="SemiBold"/>
                            <Run Text="{Binding CurrentDatabaseType, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Foreground="{DynamicResource ForegroundBrush}" Margin="0,4,0,0">
                            <Run Text="Location: " FontWeight="SemiBold"/>
                            <Run Text="{Binding CurrentDatabaseLocation, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
                
                <!-- Change Connection Button -->
                <Button Content="Change Database Connection..."
                        Command="{Binding ChangeDatabaseCommand}"
                        HorizontalAlignment="Left"
                        Padding="16,8"
                        Margin="0,0,0,15"/>
                
                <TextBlock Text="⚠ Changing database connections may result in different data being displayed. Your data in the current database will not be migrated."
                           Foreground="{DynamicResource HintTextBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           MaxWidth="350"
                           HorizontalAlignment="Left"/>
                
                <!-- Data Management Section -->
                <Label Style="{StaticResource LabelStyle}" Content="Data Management" Margin="0,20,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Add Sample Data"
                            Command="{Binding SeedSampleDataCommand}"
                            Padding="16,8"
                            Margin="0,0,10,0"/>
                    <Button Content="Clear All Data"
                            Command="{Binding ClearDataCommand}"
                            Padding="16,8"
                            Background="#8B0000"
                            Foreground="White"/>
                </StackPanel>
                
                <TextBlock Text="'Add Sample Data' populates empty databases with demo content. 'Clear All Data' permanently removes all records."
                           Foreground="{DynamicResource HintTextBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           MaxWidth="350"
                           HorizontalAlignment="Left"
                           Margin="0,8,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Vertical"
                       Grid.Column="1"
                       Visibility="{Binding ElementName=Calendar, Path=IsSelected, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}"                                
                       Margin="20,0,0,0">
                
                <!-- Google Calendar Section -->
                <Label Style="{StaticResource LabelStyle}" Content="Google Calendar" />
                <Border Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="6"
                        Padding="12"
                        Margin="0,5,0,10">
                    <StackPanel>
                        <TextBlock Foreground="{DynamicResource ForegroundBrush}">
                            <Run Text="Status: " FontWeight="SemiBold"/>
                            <Run Text="{Binding CalendarSettings.GoogleStatus, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Foreground="{DynamicResource ForegroundBrush}" Margin="0,4,0,0">
                            <Run Text="Account: " FontWeight="SemiBold"/>
                            <Run Text="{Binding CalendarSettings.GoogleUserEmail, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <Button Content="Connect Google Calendar"
                            Command="{Binding CalendarSettings.ConnectGoogleCommand}"
                            Padding="16,8"
                            Margin="0,0,10,0"
                            IsEnabled="{Binding CalendarSettings.IsConnectingGoogle, Converter={x:Static converters:ReverseBooleanConverter.Instance}}"/>
                    <Button Content="Disconnect"
                            Command="{Binding CalendarSettings.DisconnectGoogleCommand}"
                            Padding="16,8"
                            Background="#8B0000"
                            Foreground="White"/>
                </StackPanel>
                
                <!-- Outlook Calendar Section -->
                <Label Style="{StaticResource LabelStyle}" Content="Outlook Calendar" Margin="0,10,0,0"/>
                <Border Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="6"
                        Padding="12"
                        Margin="0,5,0,10">
                    <StackPanel>
                        <TextBlock Foreground="{DynamicResource ForegroundBrush}">
                            <Run Text="Status: " FontWeight="SemiBold"/>
                            <Run Text="{Binding CalendarSettings.OutlookStatus, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Foreground="{DynamicResource ForegroundBrush}" Margin="0,4,0,0">
                            <Run Text="Account: " FontWeight="SemiBold"/>
                            <Run Text="{Binding CalendarSettings.OutlookUserEmail, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <Button Content="Connect Outlook Calendar"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding CalendarSettings.ConnectOutlookCommand}"
                            Margin="0,0,10,0"
                            IsEnabled="{Binding CalendarSettings.IsConnectingOutlook, Converter={x:Static converters:ReverseBooleanConverter.Instance}}"/>
                    <Button Content="Disconnect"
                            Style="{StaticResource DestructiveButtonStyle}"
                            Command="{Binding CalendarSettings.DisconnectOutlookCommand}"/>
                </StackPanel>
                
                <!-- Sync Options -->
                <Label Style="{StaticResource LabelStyle}" Content="Sync Options" Margin="0,10,0,0"/>
                <CheckBox Content="Automatically sync meetings when created or updated"
                          IsChecked="{Binding CalendarSettings.AutoSyncOnSave}"
                          Margin="0,10,0,5"
                          Foreground="{DynamicResource ForegroundBrush}"/>
                <CheckBox Content="Send meeting invitations via email"
                          IsChecked="{Binding CalendarSettings.SyncMeetingInvitations}"
                          Margin="0,5,0,5"
                          Foreground="{DynamicResource ForegroundBrush}"/>
                <CheckBox Content="Send meeting summaries via email after meetings"
                          IsChecked="{Binding CalendarSettings.SyncMeetingSummaries}"
                          Margin="0,5,0,0"
                          Foreground="{DynamicResource ForegroundBrush}"/>
                
                <TextBlock Text="Calendar sync settings are saved automatically. Meetings will be synced to your connected calendars when created or updated."
                           Foreground="{DynamicResource HintTextBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           MaxWidth="350"
                           HorizontalAlignment="Left"
                           Margin="0,15,0,0"/>
            </StackPanel>
            
            <!-- Reminders Panel -->
            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding ElementName=Reminders, Path=IsSelected, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}"
                          Margin="20,0,0,0">
                <StackPanel Orientation="Vertical" MaxWidth="450">
                    
                    <!-- General -->
                    <Label Style="{StaticResource LabelStyle}" Content="General" />
                    <CheckBox Content="Enable reminders and notifications"
                              IsChecked="{Binding ReminderSettings.EnableReminders}"
                              Margin="0,10,0,5"
                              Foreground="{DynamicResource ForegroundBrush}"/>
                    
                    <!-- System Tray -->
                    <Label Style="{StaticResource LabelStyle}" Content="System Tray" Margin="0,15,0,0"/>
                    <CheckBox Content="Minimize to system tray instead of closing"
                              IsChecked="{Binding ReminderSettings.MinimizeToTray}"
                              Margin="0,10,0,5"
                              Foreground="{DynamicResource ForegroundBrush}"/>
                    <CheckBox Content="Start Tracker minimized on Windows login"
                              IsChecked="{Binding ReminderSettings.StartWithWindows}"
                              Margin="0,5,0,5"
                              Foreground="{DynamicResource ForegroundBrush}"/>
                    
                    <!-- Meeting Reminders -->
                    <Label Style="{StaticResource LabelStyle}" Content="Meeting Reminders" Margin="0,15,0,0"/>
                    <CheckBox Content="Show meeting reminders"
                              IsChecked="{Binding ReminderSettings.ShowMeetingReminders}"
                              Margin="0,10,0,5"
                              Foreground="{DynamicResource ForegroundBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="20,0,0,5">
                        <TextBlock Text="Remind me" VerticalAlignment="Center" Foreground="{DynamicResource ForegroundBrush}"/>
                        <ComboBox SelectedValue="{Binding ReminderSettings.MeetingReminderMinutes}" 
                                  SelectedValuePath="Tag"
                                  Width="80" Margin="10,0">
                            <ComboBoxItem Content="5 min" Tag="5"/>
                            <ComboBoxItem Content="10 min" Tag="10"/>
                            <ComboBoxItem Content="15 min" Tag="15"/>
                            <ComboBoxItem Content="30 min" Tag="30"/>
                            <ComboBoxItem Content="1 hour" Tag="60"/>
                        </ComboBox>
                        <TextBlock Text="before" VerticalAlignment="Center" Foreground="{DynamicResource ForegroundBrush}"/>
                    </StackPanel>
                    <CheckBox Content="Also remind me one day before meetings"
                              IsChecked="{Binding ReminderSettings.ShowMeetingReminderDayBefore}"
                              Margin="20,0,0,5"
                              Foreground="{DynamicResource ForegroundBrush}"/>
                    
                    <!-- Engagement Alerts -->
                    <Label Style="{StaticResource LabelStyle}" Content="Engagement Alerts" Margin="0,15,0,0"/>
                    <CheckBox Content="Alert when team members haven't had a 1:1"
                              IsChecked="{Binding ReminderSettings.ShowEngagementAlerts}"
                              Margin="0,10,0,5"
                              Foreground="{DynamicResource ForegroundBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="20,0,0,5">
                        <TextBlock Text="Alert after" VerticalAlignment="Center" Foreground="{DynamicResource ForegroundBrush}"/>
                        <ComboBox SelectedValue="{Binding ReminderSettings.EngagementAlertWeeks}" 
                                  SelectedValuePath="Tag"
                                  Width="80" Margin="10,0">
                            <ComboBoxItem Content="1 week" Tag="1"/>
                            <ComboBoxItem Content="2 weeks" Tag="2"/>
                            <ComboBoxItem Content="3 weeks" Tag="3"/>
                            <ComboBoxItem Content="4 weeks" Tag="4"/>
                        </ComboBox>
                        <TextBlock Text="without a 1:1" VerticalAlignment="Center" Foreground="{DynamicResource ForegroundBrush}"/>
                    </StackPanel>
                    
                    <!-- Task Reminders -->
                    <Label Style="{StaticResource LabelStyle}" Content="Task Reminders" Margin="0,15,0,0"/>
                    <CheckBox Content="Show task deadline reminders"
                              IsChecked="{Binding ReminderSettings.ShowTaskReminders}"
                              Margin="0,10,0,5"
                              Foreground="{DynamicResource ForegroundBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="20,0,0,5">
                        <TextBlock Text="Remind me" VerticalAlignment="Center" Foreground="{DynamicResource ForegroundBrush}"/>
                        <ComboBox SelectedValue="{Binding ReminderSettings.TaskReminderDays}" 
                                  SelectedValuePath="Tag"
                                  Width="80" Margin="10,0">
                            <ComboBoxItem Content="Same day" Tag="0"/>
                            <ComboBoxItem Content="1 day" Tag="1"/>
                            <ComboBoxItem Content="2 days" Tag="2"/>
                            <ComboBoxItem Content="3 days" Tag="3"/>
                        </ComboBox>
                        <TextBlock Text="before due date" VerticalAlignment="Center" Foreground="{DynamicResource ForegroundBrush}"/>
                    </StackPanel>
                    
                    <!-- Goal Reminders -->
                    <Label Style="{StaticResource LabelStyle}" Content="Goal Reminders" Margin="0,15,0,0"/>
                    <CheckBox Content="Show goal deadline reminders"
                              IsChecked="{Binding ReminderSettings.ShowGoalReminders}"
                              Margin="0,10,0,5"
                              Foreground="{DynamicResource ForegroundBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="20,0,0,5">
                        <TextBlock Text="Remind me" VerticalAlignment="Center" Foreground="{DynamicResource ForegroundBrush}"/>
                        <ComboBox SelectedValue="{Binding ReminderSettings.GoalReminderDays}" 
                                  SelectedValuePath="Tag"
                                  Width="100" Margin="10,0">
                            <ComboBoxItem Content="1 day" Tag="1"/>
                            <ComboBoxItem Content="3 days" Tag="3"/>
                            <ComboBoxItem Content="1 week" Tag="7"/>
                            <ComboBoxItem Content="2 weeks" Tag="14"/>
                        </ComboBox>
                        <TextBlock Text="before target date" VerticalAlignment="Center" Foreground="{DynamicResource ForegroundBrush}"/>
                    </StackPanel>
                    
                    <!-- Snooze -->
                    <Label Style="{StaticResource LabelStyle}" Content="Other Settings" Margin="0,15,0,0"/>
                    <CheckBox Content="Play sound with notifications"
                              IsChecked="{Binding ReminderSettings.PlaySound}"
                              Margin="0,10,0,5"
                              Foreground="{DynamicResource ForegroundBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                        <TextBlock Text="Default snooze:" VerticalAlignment="Center" Foreground="{DynamicResource ForegroundBrush}"/>
                        <ComboBox SelectedValue="{Binding ReminderSettings.DefaultSnoozeMins}" 
                                  SelectedValuePath="Tag"
                                  Width="80" Margin="10,0">
                            <ComboBoxItem Content="5 min" Tag="5"/>
                            <ComboBoxItem Content="10 min" Tag="10"/>
                            <ComboBoxItem Content="15 min" Tag="15"/>
                            <ComboBoxItem Content="30 min" Tag="30"/>
                            <ComboBoxItem Content="1 hour" Tag="60"/>
                        </ComboBox>
                    </StackPanel>
                    
                    <TextBlock Text="Reminder settings are saved automatically. The app will check for due reminders every minute while running."
                               Foreground="{DynamicResource HintTextBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Left"
                               Margin="0,15,0,20"/>
                </StackPanel>
            </ScrollViewer>
            
            <!-- Logs Panel -->
            <controls:LogViewerControl Grid.Column="1"
                                       Visibility="{Binding ElementName=Logs, Path=IsSelected, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}"
                                       Margin="10,0,0,0"/>
        </Grid>
    </Grid>
</UserControl>

