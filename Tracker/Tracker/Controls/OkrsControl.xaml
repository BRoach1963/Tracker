<UserControl x:Class="Tracker.Controls.OkrsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Tracker.Controls"
             xmlns:customControls="clr-namespace:Tracker.Controls.CustomControls"
             xmlns:analytics="clr-namespace:Tracker.Controls.Analytics"
             xmlns:converters="clr-namespace:Tracker.Common.Converters"
             xmlns:viewModels="clr-namespace:Tracker.ViewModels"
             xmlns:enums="clr-namespace:Tracker.Common.Enums"
             mc:Ignorable="d"
             d:DesignHeight="800"
             d:DesignWidth="1400"
             d:DataContext="{d:DesignInstance Type=viewModels:GoalsViewModel}"
             AutomationProperties.Name="OKRs - Objectives and Key Results"
             AutomationProperties.HelpText="Create and track team objectives with measurable key results">
    
    <UserControl.Resources>
        <!-- Stats card style (Clickable) -->
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource HintTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
        </Style>
        
        <Style x:Key="PanelHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        
        <Style x:Key="FilterButton" TargetType="RadioButton" BasedOn="{StaticResource SegmentedButtonStyle}"/>
        
        <converters:GoalStatusToColorConverter x:Key="StatusToColorConverter"/>
    </UserControl.Resources>
    
    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- ================================================== -->
        <!-- ROW 0: HEADER -->
        <!-- ================================================== -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel>
                <TextBlock Text="OKRs" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}"/>
                <TextBlock Text="Objectives and Key Results" FontSize="14" Foreground="{DynamicResource HintTextBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            
            <Button Grid.Column="1" 
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding AddOkrCommand}"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Add New OKR"
                    AutomationProperties.HelpText="Open dialog to create a new Objective and Key Results"
                    ToolTip="Create a new OKR"
                    TabIndex="100">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"
                          Fill="{DynamicResource BackgroundBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"/>
                    <TextBlock Text="New OKR"/>
                </StackPanel>
            </Button>
        </Grid>
        
        <!-- ================================================== -->
        <!-- ROW 1: STATS BAR (Clickable Filters) -->
        <!-- ================================================== -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Border Grid.Column="0" Margin="0,0,6,0"
                    MouseLeftButtonUp="StatCard_OnTrack_Click"
                    ToolTip="Click to filter by On Track">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource StatCardStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusFilter}" Value="OnTrack">
                                <Setter Property="BorderBrush" Value="#10B981"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="ON TRACK" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Text="{Binding OnTrackCount, FallbackValue='0'}" Style="{StaticResource StatValue}" Foreground="#10B981"/>
                </StackPanel>
            </Border>
            
            <Border Grid.Column="1" Margin="3,0"
                    MouseLeftButtonUp="StatCard_AtRisk_Click"
                    ToolTip="Click to filter by At Risk">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource StatCardStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusFilter}" Value="AtRisk">
                                <Setter Property="BorderBrush" Value="#F59E0B"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="AT RISK" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Text="{Binding AtRiskCount, FallbackValue='0'}" Style="{StaticResource StatValue}" Foreground="#F59E0B"/>
                </StackPanel>
            </Border>
            
            <Border Grid.Column="2" Margin="3,0"
                    MouseLeftButtonUp="StatCard_OffTrack_Click"
                    ToolTip="Click to filter by Off Track">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource StatCardStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusFilter}" Value="OffTrack">
                                <Setter Property="BorderBrush" Value="#EF4444"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="OFF TRACK" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Text="{Binding OffTrackCount, FallbackValue='0'}" Style="{StaticResource StatValue}" Foreground="#EF4444"/>
                </StackPanel>
            </Border>
            
            <Border Grid.Column="3" Margin="6,0,0,0"
                    MouseLeftButtonUp="StatCard_All_Click"
                    ToolTip="Click to show all OKRs">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource StatCardStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusFilter}" Value="{x:Null}">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="TOTAL" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Text="{Binding TotalCount, FallbackValue='0'}" Style="{StaticResource StatValue}"/>
                </StackPanel>
            </Border>
        </Grid>
        
        <!-- ================================================== -->
        <!-- ROW 2: FILTER BAR -->
        <!-- ================================================== -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Search Box -->
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                          Fill="{DynamicResource HintTextBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" 
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource ForegroundBrush}"
                             VerticalAlignment="Center" Margin="10,0,0,0" FontSize="13">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="Search OKRs..." Foreground="{DynamicResource HintTextBrush}" FontSize="13"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>
            </Border>
            
            <!-- Filter Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                <RadioButton Content="All" GroupName="OkrFilter" 
                             Style="{StaticResource SegmentedButtonStyle}"
                             IsChecked="{Binding StatusFilter, Converter={x:Static converters:NullToBoolConverter.Instance}, ConverterParameter=True}"
                             Click="FilterAll_Click"/>
                <RadioButton Content="On Track" GroupName="OkrFilter" 
                             Style="{StaticResource SegmentedButtonStyle}"
                             IsChecked="{Binding StatusFilter, Converter={x:Static converters:EnumToBoolConverter.Instance}, ConverterParameter={x:Static enums:GoalStatus.OnTrack}}"
                             Click="FilterOnTrack_Click"/>
                <RadioButton Content="At Risk" GroupName="OkrFilter" 
                             Style="{StaticResource SegmentedButtonStyle}"
                             IsChecked="{Binding StatusFilter, Converter={x:Static converters:EnumToBoolConverter.Instance}, ConverterParameter={x:Static enums:GoalStatus.AtRisk}}"
                             Click="FilterAtRisk_Click"/>
                <RadioButton Content="Off Track" GroupName="OkrFilter" 
                             Style="{StaticResource SegmentedButtonStyle}"
                             IsChecked="{Binding StatusFilter, Converter={x:Static converters:EnumToBoolConverter.Instance}, ConverterParameter={x:Static enums:GoalStatus.OffTrack}}"
                             Click="FilterOffTrack_Click"/>
            </StackPanel>
            
            <!-- Clear Filter (when filter is active) -->
            <Button Grid.Column="2" 
                    Content="Clear Filter" 
                    Style="{StaticResource SecondaryButtonStyle}"
                    Visibility="{Binding StatusFilter, Converter={x:Static converters:NullToVisibilityConverter.Instance}}"
                    Click="FilterAll_Click"
                    HorizontalAlignment="Right"
                    Margin="8,0,0,0"/>
        </Grid>
        
        <!-- ================================================== -->
        <!-- ROW 3: MAIN 3-PANEL LAYOUT -->
        <!-- ================================================== -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <!-- Left Panel: OKR Cards (larger) -->
                <ColumnDefinition Width="*" MinWidth="350"/>
                <!-- Right Panel: KR Details -->
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>
            
            <!-- ================================== -->
            <!-- LEFT PANEL: OKR CARDS -->
            <!-- ================================== -->
            <ScrollViewer Grid.Column="0" 
                          VerticalScrollBarVisibility="Auto" 
                          Margin="0,0,16,0"
                          Padding="0,0,4,0">
                <ItemsControl ItemsSource="{Binding FilteredOkrs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <customControls:OkrCard Okr="{Binding}"
                                                    Margin="0,0,0,12"
                                                    CardClicked="OkrCard_CardClicked"
                                                    EditRequested="OkrCard_EditRequested"
                                                    DuplicateRequested="OkrCard_DuplicateRequested"
                                                    DeleteRequested="OkrCard_DeleteRequested">
                                <customControls:OkrCard.IsSelected>
                                    <MultiBinding Converter="{x:Static converters:ObjectEqualityConverter.Instance}">
                                        <Binding Path="DataContext.SelectedOkr" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                        <Binding/>
                                    </MultiBinding>
                                </customControls:OkrCard.IsSelected>
                            </customControls:OkrCard>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            
            <!-- ================================== -->
            <!-- RIGHT PANEL: KEY RESULTS + DETAILS -->
            <!-- ================================== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <!-- Top: Key Results List -->
                    <RowDefinition Height="*" MinHeight="200"/>
                    <!-- Middle: KR Details -->
                    <RowDefinition Height="Auto"/>
                    <!-- Bottom: Advanced Analytics (What-If + Recommendations) -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- ============ TOP: KEY RESULTS LIST ============ -->
                <Border Grid.Row="0" 
                        Background="{DynamicResource SurfaceBrush}" 
                        CornerRadius="12"
                        Padding="16"
                        Margin="0,0,0,12"
                        Visibility="{Binding HasSelectedOkr, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="KEY RESULTS" Style="{StaticResource PanelHeader}" Margin="0"/>
                            <TextBlock Grid.Column="1" FontSize="12" Foreground="{DynamicResource HintTextBrush}" VerticalAlignment="Center"
                                       Text="{Binding SelectedOkr.KeyResultCount, Mode=OneWay, StringFormat='{}{0} items', FallbackValue='0 items'}"/>
                        </Grid>
                        
                        <!-- Key Results List -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SelectedOkrKeyResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <customControls:KeyResultItem KeyResult="{Binding}"
                                                                      ShowActions="True"
                                                                      Margin="0,0,0,8"
                                                                      ItemClicked="KeyResultItem_ItemClicked"
                                                                      EditRequested="KeyResultItem_EditRequested"
                                                                      DuplicateRequested="KeyResultItem_DuplicateRequested"
                                                                      DeleteRequested="KeyResultItem_DeleteRequested">
                                            <customControls:KeyResultItem.IsSelected>
                                                <MultiBinding Converter="{x:Static converters:ObjectEqualityConverter.Instance}">
                                                    <Binding Path="DataContext.SelectedKeyResult" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                    <Binding/>
                                                </MultiBinding>
                                            </customControls:KeyResultItem.IsSelected>
                                        </customControls:KeyResultItem>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        
                        <!-- Add Key Result Button -->
                        <Button Grid.Row="2" 
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding AddKeyResultCommand}"
                                HorizontalAlignment="Stretch"
                                Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"
                                      Fill="{DynamicResource ForegroundBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="Add Key Result"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
                
                <!-- ============ BOTTOM: KR DETAILS ============ -->
                <Border Grid.Row="1" 
                        Background="{DynamicResource SurfaceBrush}" 
                        CornerRadius="12"
                        Padding="16"
                        MinHeight="200"
                        Visibility="{Binding HasSelectedKeyResult, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- KR Title with Trend Indicator -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding SelectedKeyResult.Title}"
                                       FontSize="14" 
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap"/>
                            <!-- Trend Indicator -->
                            <customControls:TrendIndicator Grid.Column="1"
                                                           Direction="{Binding SelectedKrAnalytics.TrendDirection}"
                                                           Visibility="{Binding SelectedKrAnalytics.HasSufficientData, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}"
                                                           ToolTip="{Binding SelectedKrAnalytics.TrendDisplayText}"
                                                           Margin="8,0,0,0"/>
                        </Grid>
                        
                        <!-- Values Display with Prediction -->
                        <Grid Grid.Row="1" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel>
                                <TextBlock Text="CURRENT" FontSize="9" Foreground="{DynamicResource HintTextBrush}" FontWeight="SemiBold"/>
                                <TextBlock FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                                           Text="{Binding SelectedKeyResult.CurrentValue, Mode=OneWay, StringFormat='{}{0:F1}'}"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="TARGET" FontSize="9" Foreground="{DynamicResource HintTextBrush}" FontWeight="SemiBold"/>
                                <TextBlock FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}"
                                           Text="{Binding SelectedKeyResult.TargetValue, Mode=OneWay, StringFormat='{}{0:F1}'}"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="PROGRESS" FontSize="9" Foreground="{DynamicResource HintTextBrush}" FontWeight="SemiBold"/>
                                <TextBlock FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}"
                                           Text="{Binding SelectedKeyResult.Progress, Mode=OneWay, StringFormat='{}{0:F0}%'}"/>
                            </StackPanel>
                            
                            <!-- Confidence Display -->
                            <customControls:ConfidenceDisplay Grid.Column="3"
                                                              Level="{Binding SelectedKrAnalytics.ConfidenceLevel}"
                                                              Score="{Binding SelectedKrAnalytics.ConfidenceScore}"
                                                              Visibility="{Binding SelectedKrAnalytics.HasSufficientData, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}"
                                                              VerticalAlignment="Center"
                                                              Margin="12,0,0,0"/>
                        </Grid>
                        
                        <!-- Prediction Row (when available) -->
                        <Border Grid.Row="2" 
                                Background="{DynamicResource BackgroundBrush}" 
                                CornerRadius="6" 
                                Padding="10,8"
                                Margin="0,0,0,12"
                                Visibility="{Binding SelectedKrAnalytics.HasPredictedDate, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Sparkline -->
                                <customControls:SparklineControl 
                                    DataPoints="{Binding SelectedKrAnalytics.SparklineData}"
                                    TrendDirection="{Binding SelectedKrAnalytics.TrendDirection}"
                                    ChartWidth="60"
                                    ChartHeight="24"
                                    ShowEndPoint="True"
                                    Margin="0,0,12,0"/>
                                
                                <!-- Risk Badge -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedKrAnalytics.RiskDisplayText}"
                                               FontSize="11" 
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBlock Text="trajectory projection"
                                               FontSize="9"
                                               Foreground="{DynamicResource HintTextBrush}"/>
                                </StackPanel>
                                
                                <!-- Predicted Date Badge -->
                                <customControls:PredictedDateBadge Grid.Column="2"
                                    PredictedDate="{Binding SelectedKrAnalytics.PredictedCompletionDate}"
                                    TargetDate="{Binding SelectedOkr.EndDate}"/>
                            </Grid>
                        </Border>
                        
                        <!-- Linked Measurables Section -->
                        <StackPanel Grid.Row="3">
                            <TextBlock Text="LINKED MEASURABLES" 
                                       FontSize="10" 
                                       FontWeight="SemiBold" 
                                       Foreground="{DynamicResource HintTextBrush}" 
                                       Margin="0,0,0,8"/>
                            
                            <ItemsControl ItemsSource="{Binding SelectedKeyResult.Measurables}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <customControls:MeasurableItem MeasurableType="{Binding MeasurableType}"
                                                                       DisplayName="{Binding DisplayName}"
                                                                       DisplayValue="{Binding CurrentDisplayValue}"
                                                                       CanRemove="True"
                                                                       RemoveClicked="MeasurableItem_RemoveClicked"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            
                            <!-- Empty state for measurables -->
                            <TextBlock Text="No linked measurables"
                                       FontSize="11"
                                       Foreground="{DynamicResource HintTextBrush}"
                                       FontStyle="Italic"
                                       Visibility="{Binding SelectedKeyResult.HasMeasurables, Converter={StaticResource ReverseBoolToVisConverter}}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        
                        <!-- Add Measurable Button -->
                        <Button Grid.Row="4" 
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding AddMeasurableCommand}"
                                HorizontalAlignment="Stretch"
                                Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"
                                      Fill="{DynamicResource ForegroundBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="Link Measurable"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
                
                <!-- ============ BOTTOM: ADVANCED ANALYTICS ============ -->
                <Border Grid.Row="2" 
                        Background="{DynamicResource SurfaceBrush}" 
                        CornerRadius="12"
                        Padding="16"
                        Margin="0,12,0,0"
                        Visibility="{Binding HasSelectedOkr, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Header -->
                        <TextBlock Grid.Row="0" 
                                   Text="PREDICTIVE INSIGHTS" 
                                   FontSize="10" 
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource HintTextBrush}" 
                                   Margin="0,0,0,12"/>
                        
                        <!-- What-If Simulator (Expander) -->
                        <Expander Grid.Row="1" 
                                  Header="What-If Scenarios" 
                                  IsExpanded="False"
                                  Margin="0,0,0,8">
                            <analytics:WhatIfSimulatorControl 
                                Prediction="{Binding SelectedKrAnalytics.Prediction}"
                                Margin="0,8,0,0"/>
                        </Expander>
                        
                        <!-- Recommendations Panel (Expander) -->
                        <Expander Grid.Row="2" 
                                  Header="Recommendations" 
                                  IsExpanded="True">
                            <analytics:RecommendationsPanel 
                                Prediction="{Binding SelectedKrAnalytics.Prediction}"
                                MaxRecommendations="3"
                                ShowActionSteps="True"
                                Margin="0,8,0,0"/>
                        </Expander>
                    </Grid>
                </Border>
                
                <!-- ============ EMPTY STATE (No OKR Selected) ============ -->
                <Border Grid.Row="0" Grid.RowSpan="3"
                        Background="{DynamicResource SurfaceBrush}" 
                        CornerRadius="12"
                        Visibility="{Binding HasSelectedOkr, Converter={StaticResource ReverseBoolToVisConverter}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12,6A6,6 0 0,0 6,12A6,6 0 0,0 12,18A6,6 0 0,0 18,12A6,6 0 0,0 12,6M12,8A4,4 0 0,1 16,12A4,4 0 0,1 12,16A4,4 0 0,1 8,12A4,4 0 0,1 12,8M12,10A2,2 0 0,0 10,12A2,2 0 0,0 12,14A2,2 0 0,0 14,12A2,2 0 0,0 12,10Z"
                              Fill="{DynamicResource HintTextBrush}" Width="56" Height="56" Stretch="Uniform" Opacity="0.3"/>
                        <TextBlock Text="Select an OKR" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource HintTextBrush}" 
                                   HorizontalAlignment="Center" Margin="0,20,0,4"/>
                        <TextBlock Text="to view Key Results and details" FontSize="12" 
                                   Foreground="{DynamicResource HintTextBrush}" 
                                   HorizontalAlignment="Center" Opacity="0.7"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
        
        <!-- Loading Overlay -->
        <Border Grid.Row="0" Grid.RowSpan="4"
                Background="#80000000"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Loading..." FontSize="16" Foreground="White"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
