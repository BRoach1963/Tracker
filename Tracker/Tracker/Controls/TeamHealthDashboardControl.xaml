<UserControl x:Class="Tracker.Controls.TeamHealthDashboardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:Tracker.ViewModels"
             xmlns:converters="clr-namespace:Tracker.Common.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1200"
             d:DataContext="{d:DesignInstance Type=viewModels:TeamHealthDashboardViewModel}"
             AutomationProperties.Name="Team Health Dashboard"
             AutomationProperties.HelpText="Overview of team health metrics and engagement">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles/DialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Metric Card Style -->
            <Style x:Key="MetricCard" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="16"/>
                <Setter Property="Margin" Value="0,0,8,8"/>
            </Style>
            
            <!-- Large Metric Value -->
            <Style x:Key="MetricValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="32"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            </Style>
            
            <!-- Metric Label -->
            <Style x:Key="MetricLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{DynamicResource HintTextBrush}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            
            <!-- Section Header -->
            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                <Setter Property="Margin" Value="0,16,0,12"/>
            </Style>
            
            <!-- Attention Level Colors -->
            <SolidColorBrush x:Key="NormalBrush" Color="#4CAF50"/>
            <SolidColorBrush x:Key="NeedsReviewBrush" Color="#FF9800"/>
            <SolidColorBrush x:Key="UrgentBrush" Color="#F44336"/>
            
            <!-- Attention Level Converter -->
            <Style x:Key="AttentionBadge" TargetType="Border">
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
            </Style>
            
            <!-- Member Card Style -->
            <Style x:Key="MemberCard" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="12"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid>
        <!-- Loading Overlay -->
        <Border Background="{DynamicResource BackgroundBrush}" 
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                Panel.ZIndex="100">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4"/>
                <TextBlock Text="Loading team health data..." 
                           Margin="0,16,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource HintTextBrush}"/>
            </StackPanel>
        </Border>
        
        <!-- Error Message -->
        <Border Background="{DynamicResource BackgroundBrush}"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"
                Panel.ZIndex="99">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Path Data="M12,2C17.53,2 22,6.47 22,12C22,17.53 17.53,22 12,22C6.47,22 2,17.53 2,12C2,6.47 6.47,2 12,2M15.59,7L12,10.59L8.41,7L7,8.41L10.59,12L7,15.59L8.41,17L12,13.41L15.59,17L17,15.59L13.41,12L17,8.41L15.59,7Z"
                      Fill="{StaticResource UrgentBrush}"
                      Width="48" Height="48" Stretch="Uniform"
                      HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding ErrorMessage}" 
                           Margin="0,16,0,0"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource ForegroundBrush}"/>
                <Button Content="Retry" 
                        Command="{Binding RefreshCommand}"
                        Margin="0,16,0,0"
                        Padding="24,8"
                        Style="{DynamicResource PrimaryButtonStyle}"/>
            </StackPanel>
        </Border>
        
        <!-- Empty State -->
        <Border Background="{DynamicResource BackgroundBrush}"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}"
                Panel.ZIndex="98">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Path Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z"
                      Fill="{DynamicResource HintTextBrush}"
                      Width="64" Height="64" Stretch="Uniform"
                      HorizontalAlignment="Center"/>
                <TextBlock Text="No Team Members" 
                           Margin="0,16,0,4"
                           FontSize="18"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource ForegroundBrush}"/>
                <TextBlock Text="Add team members to see health metrics" 
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource HintTextBrush}"/>
            </StackPanel>
        </Border>
        
        <!-- Main Content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Padding="24"
                      Visibility="{Binding HasData, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <!-- Header -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Team Health Dashboard" 
                                   FontSize="24" 
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                        <TextBlock Text="Monitor your team's engagement and performance at a glance"
                                   FontSize="14"
                                   Foreground="{DynamicResource HintTextBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Command="{Binding RefreshCommand}"
                            ToolTip="Refresh dashboard"
                            Style="{DynamicResource IconButtonStyle}"
                            Padding="8">
                        <Path Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"
                              Fill="{DynamicResource ForegroundBrush}"
                              Width="20" Height="20" Stretch="Uniform"/>
                    </Button>
                </Grid>
                
                <!-- Summary Metrics Row -->
                <TextBlock Text="OVERVIEW" Style="{StaticResource SectionHeader}"/>
                <UniformGrid Rows="1" Columns="4" Margin="0,0,0,8">
                    <!-- Total Members -->
                    <Border Style="{StaticResource MetricCard}">
                        <StackPanel>
                            <TextBlock Text="{Binding Summary.TotalMembers}" Style="{StaticResource MetricValue}"/>
                            <TextBlock Text="Team Members" Style="{StaticResource MetricLabel}"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Task Completion Rate -->
                    <Border Style="{StaticResource MetricCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource MetricValue}">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0:F0}%">
                                        <Binding Path="Summary.TaskCompletionRate"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <TextBlock Text="Task Completion" Style="{StaticResource MetricLabel}"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- OKR On-Track -->
                    <Border Style="{StaticResource MetricCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource MetricValue}">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0:F0}%">
                                        <Binding Path="Summary.OkrOnTrackPercentage"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <TextBlock Text="OKRs On Track" Style="{StaticResource MetricLabel}"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Avg Days Since Meeting -->
                    <Border Style="{StaticResource MetricCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource MetricValue}">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0:F0}">
                                        <Binding Path="Summary.AverageDaysSinceLastMeeting"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <TextBlock Text="Avg Days Since Meeting" Style="{StaticResource MetricLabel}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
                
                <!-- Alert Cards Row -->
                <UniformGrid Rows="1" Columns="3" Margin="0,0,0,16">
                    <!-- Overdue Tasks Alert -->
                    <Border Style="{StaticResource MetricCard}" 
                            BorderBrush="{StaticResource UrgentBrush}"
                            BorderThickness="0,0,0,3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="40" Height="40" Fill="{StaticResource UrgentBrush}" Opacity="0.1"/>
                            <Path Data="M12,2C17.53,2 22,6.47 22,12C22,17.53 17.53,22 12,22C6.47,22 2,17.53 2,12C2,6.47 6.47,2 12,2M11,15H13V17H11V15M11,7H13V13H11V7Z"
                                  Fill="{StaticResource UrgentBrush}"
                                  Width="24" Height="24" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Summary.MembersWithOverdueTasks}" 
                                           FontSize="24" FontWeight="Bold"
                                           Foreground="{StaticResource UrgentBrush}"/>
                                <TextBlock Text="Members with overdue tasks" 
                                           Style="{StaticResource MetricLabel}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                    <!-- At-Risk OKRs Alert -->
                    <Border Style="{StaticResource MetricCard}"
                            BorderBrush="{StaticResource NeedsReviewBrush}"
                            BorderThickness="0,0,0,3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="40" Height="40" Fill="{StaticResource NeedsReviewBrush}" Opacity="0.1"/>
                            <Path Data="M13,13H11V7H13M13,17H11V15H13M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z"
                                  Fill="{StaticResource NeedsReviewBrush}"
                                  Width="24" Height="24" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Summary.MembersWithAtRiskOkrs}" 
                                           FontSize="24" FontWeight="Bold"
                                           Foreground="{StaticResource NeedsReviewBrush}"/>
                                <TextBlock Text="Members with at-risk OKRs" 
                                           Style="{StaticResource MetricLabel}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                    <!-- Meeting Overdue Alert -->
                    <Border Style="{StaticResource MetricCard}"
                            BorderBrush="{StaticResource NeedsReviewBrush}"
                            BorderThickness="0,0,0,3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="40" Height="40" Fill="{StaticResource NeedsReviewBrush}" Opacity="0.1"/>
                            <Path Data="M12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22C6.47,22 2,17.5 2,12A10,10 0 0,1 12,2M12.5,7V12.25L17,14.92L16.25,16.15L11,13V7H12.5Z"
                                  Fill="{StaticResource NeedsReviewBrush}"
                                  Width="24" Height="24" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Summary.MembersWithNoRecentMeetings}" 
                                           FontSize="24" FontWeight="Bold"
                                           Foreground="{StaticResource NeedsReviewBrush}"/>
                                <TextBlock Text="Members without recent meetings" 
                                           Style="{StaticResource MetricLabel}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </UniformGrid>
                
                <!-- Meeting Cadence Section -->
                <TextBlock Text="MEETING CADENCE" Style="{StaticResource SectionHeader}"/>
                <Border Style="{StaticResource MetricCard}" Padding="20" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Last 7 Days -->
                        <StackPanel HorizontalAlignment="Center">
                            <Border Background="{StaticResource NormalBrush}" 
                                    CornerRadius="50" Width="60" Height="60">
                                <TextBlock Text="{Binding MeetingCadence.MeetingsLast7Days}"
                                           FontSize="24" FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Last 7 days" 
                                       Style="{StaticResource MetricLabel}"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                        
                        <!-- Last 14 Days -->
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <Border Background="{DynamicResource AccentBrush}" 
                                    CornerRadius="50" Width="60" Height="60">
                                <TextBlock Text="{Binding MeetingCadence.MeetingsLast14Days}"
                                           FontSize="24" FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="8-14 days ago" 
                                       Style="{StaticResource MetricLabel}"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                        
                        <!-- Last 30 Days -->
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <Border Background="{StaticResource NeedsReviewBrush}" 
                                    CornerRadius="50" Width="60" Height="60">
                                <TextBlock Text="{Binding MeetingCadence.MeetingsLast30Days}"
                                           FontSize="24" FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="15-30 days ago" 
                                       Style="{StaticResource MetricLabel}"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                        
                        <!-- Overdue -->
                        <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                            <Border Background="{StaticResource UrgentBrush}" 
                                    CornerRadius="50" Width="60" Height="60">
                                <TextBlock Text="{Binding MeetingCadence.MeetingsOverdue}"
                                           FontSize="24" FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="30+ days ago" 
                                       Style="{StaticResource MetricLabel}"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
                
                <!-- Members Needing Attention -->
                <TextBlock Text="MEMBERS NEEDING ATTENTION" Style="{StaticResource SectionHeader}"
                           Visibility="{Binding MembersNeedingAttention.Count, Converter={x:Static converters:IntToVisibilityConverter.Instance}}"/>
                <ItemsControl ItemsSource="{Binding MembersNeedingAttention}"
                              Visibility="{Binding MembersNeedingAttention.Count, Converter={x:Static converters:IntToVisibilityConverter.Instance}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource MemberCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Avatar -->
                                    <Border Width="40" Height="40" CornerRadius="20"
                                            Background="{DynamicResource AccentBrush}">
                                        <TextBlock Text="{Binding Initials}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    
                                    <!-- Name and Status -->
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding MemberName}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ForegroundBrush}"/>
                                        <TextBlock Foreground="{DynamicResource HintTextBrush}" FontSize="12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding LastMeetingDate}" Value="{x:Null}">
                                                            <Setter Property="Text" Value="No meetings recorded"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                    <Setter Property="Text">
                                                        <Setter.Value>
                                                            <MultiBinding StringFormat="Last meeting: {0:d} ({1} days ago)">
                                                                <Binding Path="LastMeetingDate"/>
                                                                <Binding Path="DaysSinceLastMeeting"/>
                                                            </MultiBinding>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    
                                    <!-- Overdue Tasks -->
                                    <StackPanel Grid.Column="2" Margin="16,0" VerticalAlignment="Center"
                                                Visibility="{Binding OverdueTaskCount, Converter={x:Static converters:IntToVisibilityConverter.Instance}}">
                                        <TextBlock Text="{Binding OverdueTaskCount, StringFormat='{}{0} overdue'}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource UrgentBrush}"/>
                                        <TextBlock Text="tasks" FontSize="11"
                                                   Foreground="{DynamicResource HintTextBrush}"/>
                                    </StackPanel>
                                    
                                    <!-- At Risk OKRs -->
                                    <StackPanel Grid.Column="3" Margin="16,0" VerticalAlignment="Center"
                                                Visibility="{Binding AtRiskOkrCount, Converter={x:Static converters:IntToVisibilityConverter.Instance}}">
                                        <TextBlock Text="{Binding AtRiskOkrCount, StringFormat='{}{0} at risk'}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource NeedsReviewBrush}"/>
                                        <TextBlock Text="OKRs" FontSize="11"
                                                   Foreground="{DynamicResource HintTextBrush}"/>
                                    </StackPanel>
                                    
                                    <!-- Attention Badge -->
                                    <Border Grid.Column="4" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource AttentionBadge}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AttentionLevel}" Value="Urgent">
                                                        <Setter Property="Background" Value="{StaticResource UrgentBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding AttentionLevel}" Value="NeedsReview">
                                                        <Setter Property="Background" Value="{StaticResource NeedsReviewBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding AttentionLevel}" Value="Normal">
                                                        <Setter Property="Background" Value="{StaticResource NormalBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="White">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AttentionLevel}" Value="Urgent">
                                                            <Setter Property="Text" Value="URGENT"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding AttentionLevel}" Value="NeedsReview">
                                                            <Setter Property="Text" Value="NEEDS REVIEW"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                
                <!-- All Team Members Section -->
                <TextBlock Text="ALL TEAM MEMBERS" Style="{StaticResource SectionHeader}" Margin="0,24,0,12"/>
                <ItemsControl ItemsSource="{Binding MemberReports}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource MemberCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Avatar -->
                                    <Border Width="36" Height="36" CornerRadius="18"
                                            Background="{DynamicResource AccentBrush}">
                                        <TextBlock Text="{Binding Initials}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    
                                    <!-- Name -->
                                    <TextBlock Grid.Column="1" 
                                               Text="{Binding MemberName}"
                                               FontSize="13"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0"/>
                                    
                                    <!-- Task Completion -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TaskCompletionPercentage, StringFormat='{}{0:F0}%'}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="Tasks Done" FontSize="10"
                                                   Foreground="{DynamicResource HintTextBrush}"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    
                                    <!-- Overdue Count -->
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding OverdueTaskCount}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding OverdueTaskCount}" Value="0">
                                                            <Setter Property="Foreground" Value="{DynamicResource HintTextBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="Overdue" FontSize="10"
                                                   Foreground="{DynamicResource HintTextBrush}"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    
                                    <!-- Days Since Meeting -->
                                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                        <TextBlock FontSize="13" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                                                    <Setter Property="Text" Value="{Binding DaysSinceLastMeeting}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DaysSinceLastMeeting}" Value="2147483647">
                                                            <Setter Property="Text" Value="-"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource HintTextBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="Days Ago" FontSize="10"
                                                   Foreground="{DynamicResource HintTextBrush}"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
