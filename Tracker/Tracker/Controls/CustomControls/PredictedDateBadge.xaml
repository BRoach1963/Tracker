<UserControl x:Class="Tracker.Controls.CustomControls.PredictedDateBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="28" d:DesignWidth="180"
             x:Name="Root"
             ToolTip="{Binding TooltipText, ElementName=Root}">
    
    <Border Background="{Binding BadgeBrush, ElementName=Root}"
            CornerRadius="4"
            Padding="8,4"
            HorizontalAlignment="Left"
            VerticalAlignment="Center">
        
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- Calendar Icon -->
            <Path Data="M6 2V4M14 2V4M3 8H17M5 4H15C16.1046 4 17 4.89543 17 6V16C17 17.1046 16.1046 18 15 18H5C3.89543 18 3 17.1046 3 16V6C3 4.89543 3.89543 4 5 4Z"
                  Stroke="White"
                  StrokeThickness="1.5"
                  Stretch="Uniform"
                  Width="14" Height="14"
                  Margin="0,0,6,0"
                  VerticalAlignment="Center"/>
            
            <!-- Prediction Text -->
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding PredictionLabel, ElementName=Root}"
                           FontSize="9"
                           Foreground="White"
                           Opacity="0.8"/>
                <TextBlock Text="{Binding DateText, ElementName=Root}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="White"/>
            </StackPanel>
            
            <!-- Delta Badge -->
            <Border Background="White"
                    Opacity="0.9"
                    CornerRadius="3"
                    Padding="4,1"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Visibility="{Binding ShowDelta, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{Binding DeltaText, ElementName=Root}"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="{Binding BadgeBrush, ElementName=Root}"/>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
