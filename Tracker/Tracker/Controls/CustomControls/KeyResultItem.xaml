<UserControl x:Class="Tracker.Controls.CustomControls.KeyResultItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Tracker.Controls.CustomControls"
             xmlns:converters="clr-namespace:Tracker.Common.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="80" d:DesignWidth="350"
             x:Name="Root">
    
    <Border x:Name="ItemBorder"
            Background="{DynamicResource SurfaceBrush}"
            CornerRadius="8"
            Padding="12"
            Cursor="Hand"
            MouseLeftButtonDown="Item_MouseLeftButtonDown">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                    </Trigger>
                    <DataTrigger Binding="{Binding IsSelected, ElementName=Root}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- ROW 0: Title + Actions -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Title -->
                <TextBlock Text="{Binding KeyResult.Title, ElementName=Root}" 
                           FontSize="13" 
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ForegroundBrush}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
                
                <!-- Status Badge (optional - for compact mode) -->
                <local:StatusBadge Grid.Column="1" 
                                   Status="{Binding KeyResult.Status, ElementName=Root}"
                                   BadgeFontSize="9"
                                   BadgePadding="6,2,6,2"
                                   CornerRadius="4"
                                   Margin="8,0,0,0"
                                   Visibility="{Binding ShowStatus, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}"/>
                
                <!-- Actions Menu -->
                <Button Grid.Column="2" 
                        x:Name="ActionsButton"
                        Style="{StaticResource GridActionButtonStyle}"
                        Click="ActionsButton_Click"
                        Margin="4,0,0,0"
                        Visibility="{Binding ShowActions, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}"
                        ToolTip="Actions">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="ActionsMenu">
                            <MenuItem Header="Edit" Click="Edit_Click">
                                <MenuItem.Icon>
                                    <Path Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"
                                          Fill="{DynamicResource ForegroundBrush}"
                                          Width="14" Height="14" Stretch="Uniform"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Duplicate" Click="Duplicate_Click">
                                <MenuItem.Icon>
                                    <Path Data="M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z"
                                          Fill="{DynamicResource ForegroundBrush}"
                                          Width="14" Height="14" Stretch="Uniform"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Delete" Click="Delete_Click" Foreground="#EF4444">
                                <MenuItem.Icon>
                                    <Path Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"
                                          Fill="#EF4444"
                                          Width="14" Height="14" Stretch="Uniform"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                    <Path Data="M12,16A2,2 0 0,1 14,18A2,2 0 0,1 12,20A2,2 0 0,1 10,18A2,2 0 0,1 12,16M12,10A2,2 0 0,1 14,12A2,2 0 0,1 12,14A2,2 0 0,1 10,12A2,2 0 0,1 12,10M12,4A2,2 0 0,1 14,6A2,2 0 0,1 12,8A2,2 0 0,1 10,6A2,2 0 0,1 12,4Z"
                          Fill="{DynamicResource HintTextBrush}"
                          Width="12" Height="12" Stretch="Uniform"/>
                </Button>
            </Grid>
            
            <!-- ROW 1: Progress Bar with Values -->
            <Grid Grid.Row="1" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <Border CornerRadius="3" Height="6" Background="{DynamicResource BackgroundBrush}">
                    <Border CornerRadius="3" 
                            HorizontalAlignment="Left"
                            Background="{DynamicResource AccentBrush}">
                        <Border.Width>
                            <MultiBinding Converter="{StaticResource ProgressWidthConverter}">
                                <Binding Path="KeyResult.Progress" ElementName="Root" Mode="OneWay"/>
                                <Binding Source="100"/>
                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}" Mode="OneWay"/>
                            </MultiBinding>
                        </Border.Width>
                    </Border>
                </Border>
                
                <TextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold" Margin="10,0,0,0"
                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                           Text="{Binding KeyResult.Progress, ElementName=Root, Mode=OneWay, StringFormat='{}{0:F0}%', FallbackValue='0%'}"/>
            </Grid>
            
            <!-- ROW 2: Values Display -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Current Value -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Current: " FontSize="11" Foreground="{DynamicResource HintTextBrush}"/>
                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0:F1} {1}">
                                <Binding Path="KeyResult.CurrentValue" ElementName="Root" Mode="OneWay" FallbackValue="0"/>
                                <Binding Path="KeyResult.Unit" ElementName="Root" Mode="OneWay" FallbackValue=""/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
                
                <!-- Target Value -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="Target: " FontSize="11" Foreground="{DynamicResource HintTextBrush}"/>
                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0:F1} {1}">
                                <Binding Path="KeyResult.TargetValue" ElementName="Root" Mode="OneWay" FallbackValue="100"/>
                                <Binding Path="KeyResult.Unit" ElementName="Root" Mode="OneWay" FallbackValue=""/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>

