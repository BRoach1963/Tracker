<UserControl x:Class="Tracker.Controls.CustomControls.TrackerProgressBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="24" d:DesignWidth="200"
             x:Name="Root">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        
        <!-- Progress Track -->
        <Border x:Name="Track" 
                Height="{Binding Height, ElementName=Root, FallbackValue=8}"
                CornerRadius="{Binding CornerRadius, ElementName=Root}"
                Background="{Binding TrackBrush, ElementName=Root}">
            
            <!-- Progress Fill -->
            <Border x:Name="Fill"
                    CornerRadius="{Binding CornerRadius, ElementName=Root}"
                    HorizontalAlignment="Left"
                    Background="{Binding FillBrush, ElementName=Root}">
                <Border.Width>
                    <MultiBinding Converter="{StaticResource ProgressWidthConverter}">
                        <Binding Path="Value" ElementName="Root"/>
                        <Binding Path="Maximum" ElementName="Root"/>
                        <Binding Path="ActualWidth" ElementName="Track"/>
                    </MultiBinding>
                </Border.Width>
            </Border>
        </Border>
        
        <!-- Percentage Label (optional) -->
        <TextBlock Grid.Column="1" 
                   Visibility="{Binding ShowPercentage, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}"
                   VerticalAlignment="Center"
                   Margin="10,0,0,0"
                   FontSize="{Binding FontSize, ElementName=Root}"
                   FontWeight="{Binding FontWeight, ElementName=Root}"
                   Foreground="{Binding LabelBrush, ElementName=Root}"
                   Text="{Binding DisplayPercentage, ElementName=Root, Mode=OneWay, StringFormat='{}{0}%'}"/>
    </Grid>
</UserControl>

