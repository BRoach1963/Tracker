<UserControl x:Class="Tracker.Controls.CustomControls.AgendaItemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    
    <Border Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12,10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Checkbox for completion -->
            <CheckBox Grid.Column="0" Grid.Row="0"
                      x:Name="CompletedCheckBox"
                      IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                      VerticalAlignment="Top"
                      Margin="0,4,10,0"
                      ToolTip="Mark as completed"/>
            
            <!-- Editable Description -->
            <TextBox Grid.Column="1" Grid.Row="0"
                     x:Name="DescriptionTextBox"
                     Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="13"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="{DynamicResource ForegroundBrush}"
                     CaretBrush="{DynamicResource ForegroundBrush}"
                     TextWrapping="Wrap"
                     AcceptsReturn="False"
                     VerticalAlignment="Center"
                     Padding="0,2"/>
            
            <!-- Delete button -->
            <Button Grid.Column="2" Grid.Row="0"
                    x:Name="DeleteButton"
                    Width="24" Height="24"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="DeleteButton_Click"
                    ToolTip="Remove agenda item">
                <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                      Width="12" Height="12"
                      Stretch="Uniform"
                      Fill="{DynamicResource HintTextBrush}"/>
            </Button>
            
            <!-- Category & Priority Tags (display-only for now, can be expanded later) -->
            <StackPanel Grid.Column="1" Grid.Row="1" 
                        Orientation="Horizontal"
                        Margin="0,6,0,0">
                <Border Background="{DynamicResource AccentBrush}"
                        CornerRadius="4"
                        Padding="6,2"
                        Margin="0,0,6,0">
                    <TextBlock Text="{Binding Category}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BackgroundBrush}"/>
                </Border>
                <Border Background="{DynamicResource BorderBrush}"
                        CornerRadius="4"
                        Padding="6,2">
                    <TextBlock Text="{Binding Priority}"
                               FontSize="10"
                               Foreground="{DynamicResource ForegroundBrush}"/>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
