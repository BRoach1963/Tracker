<UserControl x:Class="Tracker.Controls.CustomControls.ProgressRing"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="60" d:DesignWidth="60"
             x:Name="Root">
    
    <Grid Width="{Binding Size, ElementName=Root}" Height="{Binding Size, ElementName=Root}">
        <!-- Background Ring -->
        <Ellipse Stroke="{DynamicResource SurfaceAltBrush}" 
                 StrokeThickness="{Binding StrokeWidth, ElementName=Root}"
                 Fill="Transparent"/>
        
        <!-- Progress Arc -->
        <Path x:Name="ProgressArc" 
              Stroke="{Binding ProgressColor, ElementName=Root}"
              StrokeThickness="{Binding StrokeWidth, ElementName=Root}"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"
              Fill="Transparent"/>
        
        <!-- Center Content -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="PercentText"
                       Text="0%"
                       FontSize="{Binding FontSize, ElementName=Root}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource ForegroundBrush}"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="LabelText"
                       Text="{Binding Label, ElementName=Root}"
                       FontSize="10"
                       Foreground="{DynamicResource HintTextBrush}"
                       HorizontalAlignment="Center"
                       Visibility="{Binding ShowLabel, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </StackPanel>
    </Grid>
</UserControl>
