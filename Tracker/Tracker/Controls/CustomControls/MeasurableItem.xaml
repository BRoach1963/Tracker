<UserControl x:Class="Tracker.Controls.CustomControls.MeasurableItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Tracker.Controls.CustomControls"
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="350"
             x:Name="Root">
    
    <Border Background="{DynamicResource SurfaceBrush}"
            CornerRadius="6"
            Padding="10,8"
            Margin="0,0,0,6">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- Type Icon -->
            <Border Width="28" Height="28" CornerRadius="6" Margin="0,0,10,0"
                    Background="{Binding TypeIconBackground, ElementName=Root}">
                <Path Data="{Binding TypeIconPath, ElementName=Root}"
                      Fill="{DynamicResource SurfaceBrush}"
                      Width="14" Height="14"
                      Stretch="Uniform"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
            </Border>
            
            <!-- Name and Type -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding DisplayName, ElementName=Root}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ForegroundBrush}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding TypeLabel, ElementName=Root}"
                           FontSize="10"
                           Foreground="{DynamicResource HintTextBrush}"/>
            </StackPanel>
            
            <!-- Progress/Value Display -->
            <TextBlock Grid.Column="2" 
                       Text="{Binding DisplayValue, ElementName=Root}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0"/>
            
            <!-- Remove Button -->
            <Button Grid.Column="3" 
                    x:Name="RemoveButton"
                    Style="{StaticResource GridActionButtonStyle}"
                    Click="RemoveButton_Click"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Visibility="{Binding CanRemove, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}"
                    ToolTip="Remove">
                <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                      Fill="{DynamicResource HintTextBrush}"
                      Width="10" Height="10" Stretch="Uniform"/>
            </Button>
        </Grid>
    </Border>
</UserControl>

