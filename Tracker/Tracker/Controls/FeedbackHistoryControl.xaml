<UserControl x:Class="Tracker.Controls.FeedbackHistoryControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Tracker.Controls"
             xmlns:converters="clr-namespace:Tracker.Common.Converters"
             xmlns:viewModels="clr-namespace:Tracker.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200"
             d:DataContext="{d:DesignInstance Type=viewModels:TrackerMainViewModel}">
    
    <UserControl.Resources>
        <!-- Card Style -->
        <Style x:Key="FeedbackCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.15" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Stat Card Style (Clickable) -->
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.12" Color="Black"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Section Header Style -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource HintTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        
        <!-- Stat Value Style -->
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
        </Style>
        
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>
    
    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- ============================================== -->
        <!-- ROW 0: HEADER - Title + Actions -->
        <!-- ============================================== -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel>
                <TextBlock Text="Feedback" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource ForegroundBrush}"/>
                <TextBlock FontSize="14" 
                           Foreground="{DynamicResource HintTextBrush}"
                           Margin="0,4,0,0">
                    <Run Text="Document and track feedback for your team"/>
                </TextBlock>
            </StackPanel>
            
            <!-- Quick Action Buttons -->
            <Button Grid.Column="1" 
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding AddFeedbackCommand}"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M9,22A1,1 0 0,1 8,21V18H4A2,2 0 0,1 2,16V4C2,2.89 2.9,2 4,2H20A2,2 0 0,1 22,4V16A2,2 0 0,1 20,18H13.9L10.2,21.71C10,21.9 9.75,22 9.5,22V22H9M10,16V19.08L13.08,16H20V4H4V16H10M17,11H15V9H17V11M13,11H11V9H13V11M9,11H7V9H9V11Z"
                          Fill="{DynamicResource BackgroundBrush}"
                          Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                    <TextBlock Text="Add Feedback"/>
                </StackPanel>
            </Button>
        </Grid>
        
        <!-- ============================================== -->
        <!-- ROW 1: STATS BAR (Horizontal) -->
        <!-- ============================================== -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Total -->
            <Border Grid.Column="0" Style="{StaticResource StatCardStyle}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="TOTAL" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Text="{Binding FeedbackCount, FallbackValue='0'}" 
                               Style="{StaticResource StatValue}"/>
                </StackPanel>
            </Border>
            
            <!-- This Month -->
            <Border Grid.Column="1" Style="{StaticResource StatCardStyle}" Margin="4,0">
                <StackPanel>
                    <TextBlock Text="THIS MONTH" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Text="{Binding FeedbackThisMonth, FallbackValue='0'}" 
                               Style="{StaticResource StatValue}"
                               Foreground="{DynamicResource AccentBrush}"/>
                </StackPanel>
            </Border>
            
            <!-- Positive -->
            <Border Grid.Column="2" Style="{StaticResource StatCardStyle}" Margin="4,0">
                <StackPanel>
                    <TextBlock Text="POSITIVE" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Text="{Binding PositiveFeedbackCount, FallbackValue='0'}" 
                               Style="{StaticResource StatValue}"
                               Foreground="#10B981"/>
                </StackPanel>
            </Border>
            
            <!-- Constructive -->
            <Border Grid.Column="3" Style="{StaticResource StatCardStyle}" Margin="4,0">
                <StackPanel>
                    <TextBlock Text="CONSTRUCTIVE" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Text="{Binding ConstructiveFeedbackCount, FallbackValue='0'}" 
                               Style="{StaticResource StatValue}"
                               Foreground="#F59E0B"/>
                </StackPanel>
            </Border>
            
            <!-- Recognition -->
            <Border Grid.Column="4" Style="{StaticResource StatCardStyle}" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="RECOGNITION" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Text="{Binding RecognitionFeedbackCount, FallbackValue='0'}" 
                               Style="{StaticResource StatValue}"
                               Foreground="#8B5CF6"/>
                </StackPanel>
            </Border>
        </Grid>
        
        <!-- ============================================== -->
        <!-- ROW 2: SEARCH & FILTER BAR -->
        <!-- ============================================== -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- Search Box -->
            <Border Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="8"
                    Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                          Fill="{DynamicResource HintTextBrush}"
                          Width="16" Height="16" Stretch="Uniform"
                          VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" 
                             Text="{Binding FeedbackSearchText, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{DynamicResource ForegroundBrush}"
                             VerticalAlignment="Center"
                             Margin="10,0,0,0"
                             FontSize="13">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="Search feedback..." 
                                                                   Foreground="{DynamicResource HintTextBrush}"
                                                                   FontSize="13"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>
            </Border>
            
            <!-- Filter Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                <RadioButton x:Name="ShowAllFeedback" 
                             Content="All" 
                             IsChecked="True"
                             GroupName="FeedbackFilter"
                             Style="{StaticResource SegmentedButtonStyle}"/>
                <RadioButton x:Name="ShowPositive" 
                             Content="Positive" 
                             GroupName="FeedbackFilter"
                             Style="{StaticResource SegmentedButtonStyle}"/>
                <RadioButton x:Name="ShowConstructive" 
                             Content="Constructive" 
                             GroupName="FeedbackFilter"
                             Style="{StaticResource SegmentedButtonStyle}"/>
                <RadioButton x:Name="ShowRecognition" 
                             Content="Recognition" 
                             GroupName="FeedbackFilter"
                             Style="{StaticResource SegmentedButtonStyle}"/>
            </StackPanel>
            
            <!-- Team Member Filter -->
            <StackPanel Grid.Column="3" Orientation="Horizontal">
                <TextBlock Text="Member:" 
                           Foreground="{DynamicResource HintTextBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{Binding TeamMembers}"
                          SelectedItem="{Binding SelectedFeedbackFilterMember}"
                          DisplayMemberPath="FullName"
                          Width="150"
                          Style="{StaticResource {x:Type ComboBox}}"/>
            </StackPanel>
        </Grid>
        
        <!-- ============================================== -->
        <!-- ROW 3: MAIN CONTENT - Cards + Detail Panel -->
        <!-- ============================================== -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>
            
            <!-- Feedback Cards Grid (Multi-column) -->
            <ScrollViewer Grid.Column="0" 
                          VerticalScrollBarVisibility="Auto" 
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="0,0,16,0">
                <Grid>
                    <!-- Empty State -->
                    <StackPanel VerticalAlignment="Center" 
                                HorizontalAlignment="Center" 
                                Margin="0,100,0,0"
                                Visibility="{Binding HasNoFeedback, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                        <Path Data="M9,22A1,1 0 0,1 8,21V18H4A2,2 0 0,1 2,16V4C2,2.89 2.9,2 4,2H20A2,2 0 0,1 22,4V16A2,2 0 0,1 20,18H13.9L10.2,21.71C10,21.9 9.75,22 9.5,22V22H9"
                              Fill="{DynamicResource HintTextBrush}"
                              Width="64" Height="64" Stretch="Uniform"
                              HorizontalAlignment="Center"
                              Opacity="0.4"/>
                        <TextBlock Text="No feedback recorded yet"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource HintTextBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,20,0,8"/>
                        <TextBlock Text="Add your first feedback entry"
                                   FontSize="14"
                                   Foreground="{DynamicResource HintTextBrush}"
                                   HorizontalAlignment="Center"
                                   Opacity="0.7"/>
                    </StackPanel>
                    
                    <!-- Cards -->
                    <ItemsControl ItemsSource="{Binding Feedbacks}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="300" 
                                    Style="{StaticResource FeedbackCardStyle}"
                                    Margin="0,0,12,12"
                                    MouseLeftButtonUp="FeedbackItem_Click"
                                    Tag="{Binding}"
                                    Cursor="Hand">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <!-- Header: Avatar + Name + Date -->
                                    <Grid Grid.Row="0" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Avatar -->
                                        <Grid Width="40" Height="40">
                                            <Ellipse Fill="{DynamicResource AccentBrush}"/>
                                            <TextBlock Text="{Binding TeamMember.Initials, Mode=OneWay}" 
                                                       FontSize="14" 
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource BackgroundBrush}"
                                                       HorizontalAlignment="Center" 
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                        
                                        <!-- Name -->
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TeamMember.FullName, Mode=OneWay}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource ForegroundBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Date, StringFormat='{}{0:MMM dd, yyyy}', Mode=OneWay}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource HintTextBrush}"/>
                                        </StackPanel>
                                        
                                        <!-- Type Badge -->
                                        <Border Grid.Column="2" 
                                                CornerRadius="10" 
                                                Padding="8,3" 
                                                VerticalAlignment="Top"
                                                Background="{Binding Type, Converter={x:Static converters:FeedbackTypeToColorConverter.Instance}}">
                                            <TextBlock Text="{Binding Type, Mode=OneWay}" 
                                                       FontSize="9"
                                                       FontWeight="SemiBold"
                                                       Foreground="White"/>
                                        </Border>
                                    </Grid>
                                    
                                    <!-- Title -->
                                    <TextBlock Grid.Row="1" 
                                               Text="{Binding Title, Mode=OneWay}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,8"/>
                                    
                                    <!-- Content Preview -->
                                    <TextBlock Grid.Row="2" 
                                               Text="{Binding Content, Mode=OneWay}"
                                               FontSize="12"
                                               Foreground="{DynamicResource HintTextBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="Wrap"
                                               MaxHeight="40"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </Grid>
            </ScrollViewer>
            
            <!-- ============================================== -->
            <!-- RIGHT SIDEBAR: Selected Feedback Details -->
            <!-- ============================================== -->
            <Border Grid.Column="1" 
                    Style="{StaticResource FeedbackCardStyle}"
                    Visibility="{Binding SelectedFeedback, Converter={x:Static converters:NullToVisibilityConverter.Instance}}"
                    Margin="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        
                        <!-- Feedback Header -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Grid Width="56" Height="56">
                                <Ellipse Fill="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="{Binding SelectedFeedback.TeamMember.Initials, Mode=OneWay}" 
                                           FontSize="20" 
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource BackgroundBrush}"
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                            </Grid>
                            
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedFeedback.TeamMember.FullName, Mode=OneWay}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource ForegroundBrush}"/>
                                <TextBlock Text="{Binding SelectedFeedback.Date, StringFormat='{}{0:MMMM dd, yyyy}', Mode=OneWay}"
                                           FontSize="12"
                                           Foreground="{DynamicResource HintTextBrush}"/>
                            </StackPanel>
                        </Grid>
                        
                        <!-- Type Badge -->
                        <Border CornerRadius="8" 
                                Padding="10,6"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,16"
                                Background="{Binding SelectedFeedback.Type, Converter={x:Static converters:FeedbackTypeToColorConverter.Instance}}">
                            <TextBlock Text="{Binding SelectedFeedback.Type, Mode=OneWay}" 
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="White"/>
                        </Border>
                        
                        <!-- Title -->
                        <TextBlock Text="TITLE" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding SelectedFeedback.Title, Mode=OneWay}"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,16"/>
                        
                        <!-- Content -->
                        <TextBlock Text="FEEDBACK" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                        <Border Background="{DynamicResource BackgroundBrush}"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,0,0,16">
                            <TextBlock Text="{Binding SelectedFeedback.Content, Mode=OneWay}"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap"
                                       FontSize="13"
                                       LineHeight="20"/>
                        </Border>
                        
                        <!-- Context -->
                        <TextBlock Text="CONTEXT" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"
                                   Visibility="{Binding SelectedFeedback.Context, Converter={x:Static converters:NullToVisibilityConverter.Instance}}"/>
                        <TextBlock Text="{Binding SelectedFeedback.Context, Mode=OneWay}"
                                   Foreground="{DynamicResource HintTextBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="13"
                                   Margin="0,0,0,16"
                                   Visibility="{Binding SelectedFeedback.Context, Converter={x:Static converters:NullToVisibilityConverter.Instance}}"/>
                        
                        <!-- Actions -->
                        <Border BorderThickness="0,1,0,0"
                                BorderBrush="{DynamicResource BorderBrush}"
                                Padding="0,16,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="Edit"
                                        Command="{Binding EditFeedbackCommand}"
                                        CommandParameter="{Binding SelectedFeedback}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Margin="0,0,8,0"/>
                                <Button Content="Delete"
                                        Command="{Binding DeleteFeedbackCommand}"
                                        CommandParameter="{Binding SelectedFeedback}"
                                        Style="{StaticResource SecondaryButtonStyle}"/>
                            </StackPanel>
                        </Border>
                        
                    </StackPanel>
                </ScrollViewer>
            </Border>
            
            <!-- Placeholder when no feedback selected -->
            <Border Grid.Column="1" 
                    Style="{StaticResource FeedbackCardStyle}"
                    Visibility="{Binding SelectedFeedback, Converter={x:Static converters:NullToVisibilityConverter.InverseInstance}}"
                    Margin="0">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Path Data="M9,22A1,1 0 0,1 8,21V18H4A2,2 0 0,1 2,16V4C2,2.89 2.9,2 4,2H20A2,2 0 0,1 22,4V16A2,2 0 0,1 20,18H13.9L10.2,21.71C10,21.9 9.75,22 9.5,22V22H9"
                          Fill="{DynamicResource HintTextBrush}"
                          Width="48" Height="48" Stretch="Uniform"
                          HorizontalAlignment="Center"
                          Opacity="0.5"/>
                    <TextBlock Text="Select feedback"
                               FontSize="14"
                               Foreground="{DynamicResource HintTextBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,16,0,4"/>
                    <TextBlock Text="to view details"
                               FontSize="12"
                               Foreground="{DynamicResource HintTextBrush}"
                               HorizontalAlignment="Center"
                               Opacity="0.7"/>
                </StackPanel>
            </Border>
            
        </Grid>
    </Grid>
</UserControl>
