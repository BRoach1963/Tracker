<UserControl x:Class="Tracker.Controls.PerformanceReviewsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:Tracker.Common.Converters"
             xmlns:enums="clr-namespace:Tracker.Common.Enums"
             xmlns:viewModels="clr-namespace:Tracker.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1200"
             d:DataContext="{d:DesignInstance Type=viewModels:PerformanceReviewsViewModel}"
             AutomationProperties.Name="Performance Reviews"
             AutomationProperties.HelpText="Manage performance review templates and cycles">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles/DialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Review Status Colors -->
            <SolidColorBrush x:Key="NotStartedBrush" Color="#9E9E9E"/>
            <SolidColorBrush x:Key="InProgressBrush" Color="#2196F3"/>
            <SolidColorBrush x:Key="CompletedBrush" Color="#4CAF50"/>
            <SolidColorBrush x:Key="SharedBrush" Color="#9C27B0"/>
            
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="12"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel>
                <TextBlock Text="Performance Reviews" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}"/>
                <TextBlock Text="Create templates, manage review cycles, and track team performance" FontSize="14" Foreground="{DynamicResource HintTextBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            
            <Button Grid.Column="1" 
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    VerticalAlignment="Center"
                    ToolTip="Refresh data">
                <Path Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"
                      Fill="{DynamicResource ForegroundBrush}" Width="16" Height="16" Stretch="Uniform"/>
            </Button>
        </Grid>
        
        <!-- MAIN CONTENT - TABS -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent" BorderThickness="0">
            
            <!-- TAB 1: TEMPLATES -->
            <TabItem Header="Templates">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Left: Template List -->
                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="12" Margin="0,0,12,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock Text="REVIEW TEMPLATES" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource HintTextBrush}" Margin="0,0,0,12"/>
                            
                            <ListBox Grid.Row="1" ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardStyle}" Padding="10">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}"/>
                                                <TextBlock Text="{Binding ReviewType}" FontSize="11" Foreground="{DynamicResource HintTextBrush}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            
                            <Button Grid.Row="2" Command="{Binding NewTemplateCommand}" Content="+ New Template" Style="{StaticResource SecondaryButtonStyle}" Margin="0,12,0,0"/>
                        </Grid>
                    </Border>
                    
                    <!-- Right: Template Detail -->
                    <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock Text="Select a template to view details" Foreground="{DynamicResource HintTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.RowSpan="4"
                                       Visibility="{Binding HasSelectedTemplate, Converter={x:Static converters:ReverseBoolToVisibilityConverter.Instance}}"/>
                            
                            <!-- Template Header -->
                            <Grid Visibility="{Binding HasSelectedTemplate, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel>
                                    <TextBox Text="{Binding EditTemplateName, UpdateSourceTrigger=PropertyChanged}" FontSize="24" FontWeight="Bold" IsReadOnly="{Binding IsReadOnly}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBox Text="{Binding EditTemplateDescription, UpdateSourceTrigger=PropertyChanged}" FontSize="14" TextWrapping="Wrap" IsReadOnly="{Binding IsReadOnly}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource HintTextBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Command="{Binding EditTemplateCommand}" Content="Edit" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                                    <Button Command="{Binding DeleteTemplateCommand}" Content="Delete" Style="{StaticResource DangerButtonStyle}"/>
                                </StackPanel>
                            </Grid>
                            
                            <!-- Template Settings -->
                            <StackPanel Grid.Row="1" Margin="0,16,0,0" Visibility="{Binding HasSelectedTemplate, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Type:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox ItemsSource="{Binding ReviewTypes}" SelectedItem="{Binding EditReviewType}" IsEnabled="{Binding IsEditing}" Width="150" Style="{StaticResource ModernComboBoxStyle}" ItemContainerStyle="{StaticResource ModernComboBoxItemStyle}"/>
                                    <CheckBox Content="Default Template" IsChecked="{Binding EditIsDefault}" IsEnabled="{Binding IsEditing}" Margin="20,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            
                            <!-- Template Sections -->
                            <Grid Grid.Row="2" Margin="0,16,0,0" Visibility="{Binding HasSelectedTemplate, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Text="SECTIONS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource HintTextBrush}" Margin="0,0,0,8"/>
                                
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding SelectedTemplateSections}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource HintTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Questions.Count, StringFormat='{}{0} questions'}" FontSize="11" Foreground="{DynamicResource AccentBrush}" Margin="0,8,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                            
                            <!-- Action Buttons -->
                            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Button Command="{Binding CancelCommand}" Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,12,0"/>
                                <Button Command="{Binding SaveTemplateCommand}" Content="Save Template" Style="{StaticResource PrimaryButtonStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
            
            <!-- TAB 2: REVIEW CYCLES -->
            <TabItem Header="Review Cycles">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Left: Cycle List -->
                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="12" Margin="0,0,12,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock Text="REVIEW CYCLES" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource HintTextBrush}" Margin="0,0,0,12"/>
                            
                            <ListBox Grid.Row="1" ItemsSource="{Binding Cycles}" SelectedItem="{Binding SelectedCycle}" Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardStyle}" Padding="10">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <Border CornerRadius="4" Padding="6,2" Background="{DynamicResource SurfaceAltBrush}">
                                                        <TextBlock Text="{Binding StatusDisplay}" FontSize="11" Foreground="{DynamicResource HintTextBrush}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Reviews.Count, StringFormat='{}{0} reviews'}" FontSize="11" Foreground="{DynamicResource HintTextBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            
                            <Button Grid.Row="2" Command="{Binding NewCycleCommand}" Content="+ New Cycle" Style="{StaticResource SecondaryButtonStyle}" Margin="0,12,0,0"/>
                        </Grid>
                    </Border>
                    
                    <!-- Right: Cycle Detail -->
                    <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock Text="Select a cycle to view details" Foreground="{DynamicResource HintTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.RowSpan="4"
                                       Visibility="{Binding HasSelectedCycle, Converter={x:Static converters:ReverseBoolToVisibilityConverter.Instance}}"/>
                            
                            <!-- Cycle Header -->
                            <Grid Visibility="{Binding HasSelectedCycle, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel>
                                    <TextBox Text="{Binding EditCycleName, UpdateSourceTrigger=PropertyChanged}" FontSize="24" FontWeight="Bold" IsReadOnly="{Binding IsReadOnly}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBox Text="{Binding EditCycleDescription, UpdateSourceTrigger=PropertyChanged}" FontSize="14" TextWrapping="Wrap" IsReadOnly="{Binding IsReadOnly}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource HintTextBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Command="{Binding EditCycleCommand}" Content="Edit" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                                    <Button Command="{Binding StartCycleCommand}" Content="Start" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
                                    <Button Command="{Binding CompleteCycleCommand}" Content="Complete" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                                    <Button Command="{Binding DeleteCycleCommand}" Content="Delete" Style="{StaticResource DangerButtonStyle}"/>
                                </StackPanel>
                            </Grid>
                            
                            <!-- Cycle Timeline -->
                            <Grid Grid.Row="1" Margin="0,16,0,0" Visibility="{Binding HasSelectedCycle, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Self-Review Start" FontSize="11" Foreground="{DynamicResource HintTextBrush}"/>
                                    <DatePicker SelectedDate="{Binding EditSelfReviewStartDate}" IsEnabled="{Binding IsEditing}" Margin="0,4,0,0" Style="{StaticResource DatePickerStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                    <TextBlock Text="Self-Review Due" FontSize="11" Foreground="{DynamicResource HintTextBrush}"/>
                                    <DatePicker SelectedDate="{Binding EditSelfReviewDueDate}" IsEnabled="{Binding IsEditing}" Margin="0,4,0,0" Style="{StaticResource DatePickerStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                    <TextBlock Text="Manager Review Start" FontSize="11" Foreground="{DynamicResource HintTextBrush}"/>
                                    <DatePicker SelectedDate="{Binding EditManagerReviewStartDate}" IsEnabled="{Binding IsEditing}" Margin="0,4,0,0" Style="{StaticResource DatePickerStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="Manager Review Due" FontSize="11" Foreground="{DynamicResource HintTextBrush}"/>
                                    <DatePicker SelectedDate="{Binding EditManagerReviewDueDate}" IsEnabled="{Binding IsEditing}" Margin="0,4,0,0" Style="{StaticResource DatePickerStyle}"/>
                                </StackPanel>
                            </Grid>
                            
                            <!-- Reviews in Cycle -->
                            <Grid Grid.Row="2" Margin="0,16,0,0" Visibility="{Binding HasSelectedCycle, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Text="REVIEWS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource HintTextBrush}" Margin="0,0,0,8"/>
                                
                                <DataGrid Grid.Row="1" ItemsSource="{Binding SelectedCycleReviews}" SelectedItem="{Binding SelectedReview}" AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent" BorderThickness="0" GridLinesVisibility="None">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Team Member" Binding="{Binding TeamMember.FullName}" Width="*"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding StatusDisplay}" Width="150"/>
                                        <DataGridTextColumn Header="Rating" Binding="{Binding RatingDisplay}" Width="100"/>
                                        <DataGridTemplateColumn Header="Actions" Width="150">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Command="{Binding DataContext.OpenReviewCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" Content="Open" Style="{StaticResource LinkButtonStyle}" Margin="0,0,8,0"/>
                                                        <Button Command="{Binding DataContext.ShareReviewCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" Content="Share" Style="{StaticResource LinkButtonStyle}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                            
                            <!-- Action Buttons -->
                            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Button Command="{Binding CancelCommand}" Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,12,0"/>
                                <Button Command="{Binding SaveCycleCommand}" Content="Save Cycle" Style="{StaticResource PrimaryButtonStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
        
        <!-- Loading Overlay -->
        <Border Grid.RowSpan="2" Background="#80000000" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200"/>
                <TextBlock Text="Loading..." Foreground="White" Margin="0,8,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
