<UserControl x:Class="Tracker.Controls.TeamMemberFeedbackControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:Tracker.Common.Converters"
             mc:Ignorable="d"
             d:DesignHeight="200" d:DesignWidth="400">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles/DialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" 
                Background="{DynamicResource AccentBrush}" 
                CornerRadius="6,6,0,0"
                Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Feedback History" 
                           FontWeight="SemiBold" 
                           FontSize="14"
                           Foreground="{DynamicResource BackgroundBrush}"/>
                <TextBlock Grid.Column="1" 
                           Text="{Binding FeedbackCount, StringFormat='{}{0} entries'}"
                           FontSize="12"
                           Foreground="{DynamicResource BackgroundBrush}"
                           Opacity="0.8"
                           Margin="0,0,12,0"/>
                <Button Grid.Column="2"
                        Content="+ Add"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        Command="{Binding AddFeedbackCommand}"
                        Padding="8,4"
                        FontSize="11"
                        MinWidth="50"/>
            </Grid>
        </Border>
        
        <!-- Feedback List -->
        <Border Grid.Row="1" 
                BorderBrush="{DynamicResource ForegroundBrush}" 
                BorderThickness="1,0,1,1"
                CornerRadius="0,0,6,6"
                Background="{DynamicResource BackgroundBrush}">
            <Grid>
                <!-- Empty State -->
                <StackPanel HorizontalAlignment="Center" 
                            VerticalAlignment="Center"
                            Visibility="{Binding HasNoFeedback, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}">
                    <TextBlock Text="No feedback recorded" 
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource HintTextBrush}"
                               Opacity="0.6"
                               FontSize="13"/>
                    <TextBlock Text="Click '+ Add' to record feedback" 
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource HintTextBrush}"
                               Opacity="0.4"
                               FontSize="11"
                               Margin="0,4,0,0"/>
                </StackPanel>
                
                <!-- Feedback List -->
                <ListView ItemsSource="{Binding Feedbacks}"
                          SelectedItem="{Binding SelectedFeedback}"
                          BorderThickness="0"
                          Background="Transparent"
                          Visibility="{Binding HasFeedback, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,8" 
                                    BorderBrush="{DynamicResource BorderBrush}" 
                                    BorderThickness="0,0,0,1"
                                    Background="Transparent"
                                    Cursor="Hand">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <!-- Date -->
                                    <TextBlock Grid.Column="0" Grid.Row="0"
                                               Text="{Binding Date, StringFormat='{}{0:MMM dd, yyyy}'}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                    
                                    <!-- Type Badge -->
                                    <Border Grid.Column="2" Grid.Row="0"
                                            Background="{Binding Type, Converter={x:Static converters:FeedbackTypeToColorConverter.Instance}}"
                                            CornerRadius="4"
                                            Padding="6,2">
                                        <TextBlock Text="{Binding Type}"
                                                   FontSize="10"
                                                   Foreground="White"/>
                                    </Border>
                                    
                                    <!-- Summary -->
                                    <TextBlock Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1"
                                               Text="{Binding Summary}"
                                               Foreground="{DynamicResource HintTextBrush}"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,4,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</UserControl>

