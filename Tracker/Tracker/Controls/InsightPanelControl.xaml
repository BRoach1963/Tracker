<UserControl x:Class="Tracker.Controls.InsightPanelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:Tracker.Common.Converters"
             xmlns:datamodels="clr-namespace:Tracker.DataModels"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="400"
             AutomationProperties.Name="Insights Panel"
             AutomationProperties.HelpText="View proactive insights and recommendations">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles/DialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Insight Severity Colors -->
            <SolidColorBrush x:Key="InfoBrush" Color="#2196F3"/>
            <SolidColorBrush x:Key="WarningBrush" Color="#FF9800"/>
            <SolidColorBrush x:Key="CriticalBrush" Color="#F44336"/>
            
            <converters:InsightSeverityToBrushConverter x:Key="SeverityToBrushConverter"/>
            <converters:ReadToOpacityConverter x:Key="ReadToOpacityConverter"/>
            
            <Style x:Key="InsightCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="3,0,0,0"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Padding" Value="12"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            
            <Style x:Key="DismissButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Width" Value="24"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="Transparent" CornerRadius="12">
                                <Path x:Name="icon" Width="12" Height="12" Stretch="Uniform"
                                      Fill="{DynamicResource HintTextBrush}"
                                      Data="M19,6.41L17.59,5 12,10.59 6.41,5 5,6.41 10.59,12 5,17.59 6.41,19 12,13.41 17.59,19 19,17.59 13.41,12z"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                                    <Setter TargetName="icon" Property="Fill" Value="{DynamicResource ForegroundBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource BackgroundBrush}" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel>
                    <TextBlock Text="Insights" FontSize="18" FontWeight="SemiBold" 
                               Foreground="{DynamicResource ForegroundBrush}"/>
                    <TextBlock Text="{Binding InsightCountText}" FontSize="12" 
                               Foreground="{DynamicResource HintTextBrush}" Margin="0,2,0,0"/>
                </StackPanel>
                
                <Button Grid.Column="1" Content="Mark All Read" 
                        Command="{Binding MarkAllReadCommand}"
                        Visibility="{Binding HasUnreadInsights, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        FontSize="12" Padding="12,6"/>
            </Grid>
        </Border>
        
        <!-- Insights List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Insights}" Padding="12">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type datamodels:Insight}">
                        <Border Style="{StaticResource InsightCardStyle}"
                                BorderBrush="{Binding Severity, Converter={StaticResource SeverityToBrushConverter}}"
                                Opacity="{Binding IsRead, Converter={StaticResource ReadToOpacityConverter}}">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" 
                                              Command="{Binding DataContext.OpenInsightCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              CommandParameter="{Binding}"/>
                            </Border.InputBindings>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Severity Icon -->
                                <Ellipse Grid.Column="0" Width="8" Height="8" Margin="0,4,12,0"
                                         VerticalAlignment="Top"
                                         Fill="{Binding Severity, Converter={StaticResource SeverityToBrushConverter}}"/>
                                
                                <!-- Content -->
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Description}" FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextWrapping="Wrap" Margin="0,4,0,0"
                                               MaxHeight="48" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding GeneratedAt, StringFormat='{}{0:MMM d, h:mm tt}'}" 
                                               FontSize="11"
                                               Foreground="{DynamicResource HintTextBrush}"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                                
                                <!-- Dismiss Button -->
                                <Button Grid.Column="2" Style="{StaticResource DismissButtonStyle}"
                                        Command="{Binding DataContext.DismissInsightCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Dismiss this insight"
                                        VerticalAlignment="Top"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        
        <!-- Empty State -->
        <Border Grid.Row="1" 
                Visibility="{Binding HasNoInsights, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Path Width="48" Height="48" Stretch="Uniform"
                      Fill="{DynamicResource HintTextBrush}"
                      Data="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4M11,16.5L6.5,12L7.91,10.59L11,13.67L16.59,8.09L18,9.5L11,16.5Z"/>
                <TextBlock Text="All caught up!" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           HorizontalAlignment="Center" Margin="0,12,0,4"/>
                <TextBlock Text="No new insights right now" FontSize="13"
                           Foreground="{DynamicResource HintTextBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
        
        <!-- Footer with Refresh -->
        <Border Grid.Row="2" Background="{DynamicResource BackgroundBrush}" Padding="12,8">
            <Button Content="Refresh Insights" Command="{Binding RefreshCommand}"
                    HorizontalAlignment="Center"
                    Style="{StaticResource SecondaryButtonStyle}"
                    FontSize="12"/>
        </Border>
    </Grid>
</UserControl>
