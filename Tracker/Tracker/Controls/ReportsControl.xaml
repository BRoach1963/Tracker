                                <Border Grid.Column="3" Style="{StaticResource ContentCard}" Margin="6,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="AVG GOAL PROGRESS" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding R10_AvgGoalProgress, StringFormat='{}{0:F0}%'}" FontSize="32" FontWeight="Bold" Foreground="#8B5CF6"/>
                                        <TextBlock Text="across all goals" FontSize="11" Foreground="{DynamicResource HintTextBrush}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            
                            <!-- Charts Row -->
                            <Grid Grid.Row="1" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Task Completion by Member -->
                                <Border Grid.Column="0" Style="{StaticResource ContentCard}" Margin="0,0,6,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="200"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="TASK COMPLETION BY MEMBER" Style="{StaticResource SectionHeader}"/>
                                        <lvc:CartesianChart Grid.Row="1" Series="{Binding R10_TaskCompletionSeries}" LegendLocation="None">
                                            <lvc:CartesianChart.AxisX>
                                                <lvc:Axis Labels="{Binding R10_TaskCompletionLabels}" ShowLabels="True" FontSize="9" Foreground="{DynamicResource HintTextBrush}" LabelsRotation="45"/>
                                            </lvc:CartesianChart.AxisX>
                                            <lvc:CartesianChart.AxisY>
                                                <lvc:Axis MinValue="0" MaxValue="100" ShowLabels="True" FontSize="10" Foreground="{DynamicResource HintTextBrush}" Title="%"/>
                                            </lvc:CartesianChart.AxisY>
                                        </lvc:CartesianChart>
                                    </Grid>
                                </Border>
                                
                                <!-- Engagement by Member -->
                                <Border Grid.Column="1" Style="{StaticResource ContentCard}" Margin="6,0,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="200"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="ENGAGEMENT BY MEMBER" Style="{StaticResource SectionHeader}"/>
                                        <lvc:CartesianChart Grid.Row="1" Series="{Binding R10_EngagementSeries}" LegendLocation="Top">
                                            <lvc:CartesianChart.AxisX>
                                                <lvc:Axis Labels="{Binding R10_EngagementLabels}" ShowLabels="True" FontSize="9" Foreground="{DynamicResource HintTextBrush}" LabelsRotation="45"/>
                                            </lvc:CartesianChart.AxisX>
                                            <lvc:CartesianChart.AxisY>
                                                <lvc:Axis MinValue="0" ShowLabels="True" FontSize="10" Foreground="{DynamicResource HintTextBrush}"/>
                                            </lvc:CartesianChart.AxisY>
                                        </lvc:CartesianChart>
                                    </Grid>
                                </Border>
                            </Grid>
                            
                            <!-- Comparison Table -->
                            <Border Grid.Row="2" Style="{StaticResource ContentCard}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="TEAM MEMBER COMPARISON" Style="{StaticResource SectionHeader}"/>
                                    <DataGrid Grid.Row="1"
                                              ItemsSource="{Binding R10_ComparisonList}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              HeadersVisibility="Column"
                                              GridLinesVisibility="Horizontal"
                                              BorderThickness="0"
                                              Background="Transparent"
                                              RowBackground="Transparent"
                                              AlternatingRowBackground="{DynamicResource HoverBrush}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Team Member" Binding="{Binding TeamMemberName}" Width="*"/>
                                            <DataGridTextColumn Header="Tasks" Binding="{Binding TotalTasks}" Width="60"/>
                                            <DataGridTextColumn Header="Completed" Binding="{Binding CompletedTasks}" Width="80"/>
                                            <DataGridTextColumn Header="Completion %" Binding="{Binding TaskCompletionRate, StringFormat='{}{0:F0}%'}" Width="95"/>
                                            <DataGridTextColumn Header="1:1 Meetings" Binding="{Binding MeetingCount}" Width="90"/>
                                            <DataGridTextColumn Header="Goals" Binding="{Binding GoalCount}" Width="55"/>
                                            <DataGridTextColumn Header="Goal Progress" Binding="{Binding GoalProgress, StringFormat='{}{0:F0}%'}" Width="95"/>
                                            <DataGridTextColumn Header="Feedback" Binding="{Binding FeedbackCount}" Width="70"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </Grid>
                        
                        <!-- ============================================== -->
                        <!-- REPORT 11: Performance Review Prep -->
                        <!-- ============================================== -->
                        <Grid Visibility="{Binding IsReport11Selected, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Selected Member Header -->
                            <Border Grid.Row="0" Style="{StaticResource ContentCard}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel>
                                        <TextBlock Text="PERFORMANCE REVIEW FOR" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding R11_SelectedMemberName}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Text="Select a team member from the filter above" FontSize="11" Foreground="{DynamicResource HintTextBrush}" 
                                                   Visibility="{Binding R11_TotalMeetings, Converter={x:Static converters:IntToVisibilityConverter.InverseInstance}}"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="1" Margin="20,0">
                                        <TextBlock Text="TOTAL 1:1s" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding R11_TotalMeetings}" FontSize="24" FontWeight="Bold" Foreground="#3B82F6"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="2" Margin="20,0">
                                        <TextBlock Text="TASK COMPLETION" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding R11_TaskCompletionRate, StringFormat='{}{0:F0}%'}" FontSize="24" FontWeight="Bold" Foreground="#10B981"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="3" Margin="20,0">
                                        <TextBlock Text="GOAL COMPLETION" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding R11_GoalCompletionRate, StringFormat='{}{0:F0}%'}" FontSize="24" FontWeight="Bold" Foreground="#8B5CF6"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="4" Margin="20,0,0,0">
                                        <TextBlock Text="FEEDBACK" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                                        <TextBlock FontSize="24" FontWeight="Bold" Foreground="#F59E0B">
                                            <Run Text="{Binding R11_PositiveFeedbackCount}"/><Run Text="/" Foreground="{DynamicResource HintTextBrush}"/><Run Text="{Binding R11_FeedbackCount}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            
                            <!-- Performance Trend Chart -->
                            <Border Grid.Row="1" Style="{StaticResource ContentCard}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="180"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="PERFORMANCE TREND (Last 6 Months)" Style="{StaticResource SectionHeader}"/>
                                    <lvc:CartesianChart Grid.Row="1" Series="{Binding R11_PerformanceTrendSeries}" LegendLocation="Top">
                                        <lvc:CartesianChart.AxisX>
                                            <lvc:Axis Labels="{Binding R11_PerformanceTrendLabels}" ShowLabels="True" FontSize="10" Foreground="{DynamicResource HintTextBrush}"/>
                                        </lvc:CartesianChart.AxisX>
                                        <lvc:CartesianChart.AxisY>
                                            <lvc:Axis MinValue="0" ShowLabels="True" FontSize="10" Foreground="{DynamicResource HintTextBrush}"/>
                                        </lvc:CartesianChart.AxisY>
                                    </lvc:CartesianChart>
                                </Grid>
                            </Border>
                            
                            <!-- Data Tables Row -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Meeting History -->
                                <Border Grid.Column="0" Style="{StaticResource ContentCard}" Margin="0,0,6,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="1:1 MEETING HISTORY" Style="{StaticResource SectionHeader}"/>
                                        <DataGrid Grid.Row="1"
                                                  ItemsSource="{Binding R11_MeetingHistory}"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  HeadersVisibility="Column"
                                                  GridLinesVisibility="Horizontal"
                                                  BorderThickness="0"
                                                  Background="Transparent"
                                                  RowBackground="Transparent"
                                                  AlternatingRowBackground="{DynamicResource HoverBrush}"
                                                  MaxHeight="300">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat='{}{0:MMM d, yyyy}'}" Width="100"/>
                                                <DataGridTextColumn Header="Duration" Binding="{Binding Duration.TotalMinutes, StringFormat='{}{0:F0} min'}" Width="70"/>
                                                <DataGridTextColumn Header="Agenda Items" Binding="{Binding AgendaItems.Count}" Width="90"/>
                                                <DataGridTextColumn Header="Actions" Binding="{Binding Tasks.Count}" Width="70"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>
                                
                                <!-- Feedback History -->
                                <Border Grid.Column="1" Style="{StaticResource ContentCard}" Margin="6,0,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="FEEDBACK HISTORY" Style="{StaticResource SectionHeader}"/>
                                        <DataGrid Grid.Row="1"
                                                  ItemsSource="{Binding R11_FeedbackHistory}"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  HeadersVisibility="Column"
                                                  GridLinesVisibility="Horizontal"
                                                  BorderThickness="0"
                                                  Background="Transparent"
                                                  RowBackground="Transparent"
                                                  AlternatingRowBackground="{DynamicResource HoverBrush}"
                                                  MaxHeight="300">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                                                <DataGridTemplateColumn Header="Type" Width="100">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{Binding TypeColor}" CornerRadius="4" Padding="8,2" HorizontalAlignment="Left">
                                                                <TextBlock Text="{Binding Type}" FontSize="11" Foreground="White"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="90"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                        
                        <!-- ============================================== -->
                        <!-- REPORT 12: Executive Summary -->
                        <!-- ============================================== -->
                        <Grid Visibility="{Binding IsReport12Selected, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Overall Health Score Card -->
                            <Border Grid.Row="0" Style="{StaticResource ContentCard}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Health Score Circle -->
                                    <Border Width="120" Height="120" CornerRadius="60" BorderBrush="{Binding R12_OverallHealthColor}" BorderThickness="6" Background="Transparent">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding R12_OverallHealthScore}" FontSize="42" FontWeight="Bold" Foreground="{Binding R12_OverallHealthColor}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="HEALTH" FontSize="10" Foreground="{DynamicResource HintTextBrush}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    
                                    <!-- Summary Metrics -->
                                    <Grid Grid.Column="1" Margin="24,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="TEAM" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                                            <TextBlock FontSize="20" FontWeight="Bold" Foreground="#3B82F6">
                                                <Run Text="{Binding R12_ActiveMembers}"/><Run Text="/" Foreground="{DynamicResource HintTextBrush}"/><Run Text="{Binding R12_TotalTeamMembers}"/>
                                            </TextBlock>
                                            <TextBlock Text="Active" FontSize="10" Foreground="{DynamicResource HintTextBrush}"/>
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="1:1s" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding R12_MeetingCadencePercent, StringFormat='{}{0}%'}" FontSize="20" FontWeight="Bold" Foreground="#10B981"/>
                                            <TextBlock Text="Cadence" FontSize="10" Foreground="{DynamicResource HintTextBrush}"/>
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="TASKS" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding R12_TaskCompletionPercent, StringFormat='{}{0}%'}" FontSize="20" FontWeight="Bold" Foreground="#8B5CF6"/>
                                            <TextBlock Text="Complete" FontSize="10" Foreground="{DynamicResource HintTextBrush}"/>
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Column="3">
                                            <TextBlock Text="OKRs" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding R12_OkrHealthPercent, StringFormat='{}{0}%'}" FontSize="20" FontWeight="Bold" Foreground="#EC4899"/>
                                            <TextBlock Text="On Track" FontSize="10" Foreground="{DynamicResource HintTextBrush}"/>
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="KPIs" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding R12_KpiHealthPercent, StringFormat='{}{0}%'}" FontSize="20" FontWeight="Bold" Foreground="#F59E0B"/>
                                            <TextBlock Text="On Target" FontSize="10" Foreground="{DynamicResource HintTextBrush}"/>
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Column="5">
                                            <TextBlock Text="GOALS" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding R12_GoalCompletionPercent, StringFormat='{}{0}%'}" FontSize="20" FontWeight="Bold" Foreground="#06B6D4"/>
                                            <TextBlock Text="Complete" FontSize="10" Foreground="{DynamicResource HintTextBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                            
                            <!-- Charts Row -->
                            <Grid Grid.Row="1" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Metrics Breakdown Pie Chart -->
                                <Border Grid.Column="0" Style="{StaticResource ContentCard}" Margin="0,0,6,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="200"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="METRICS BREAKDOWN" Style="{StaticResource SectionHeader}"/>
                                        <lvc:PieChart Grid.Row="1" Series="{Binding R12_MetricsSummarySeries}" LegendLocation="Right" InnerRadius="50">
                                            <lvc:PieChart.ChartLegend>
                                                <lvc:DefaultLegend BulletSize="10" Foreground="{DynamicResource ForegroundBrush}"/>
                                            </lvc:PieChart.ChartLegend>
                                        </lvc:PieChart>
                                    </Grid>
                                </Border>
                                
                                <!-- Health Trend Chart -->
                                <Border Grid.Column="1" Style="{StaticResource ContentCard}" Margin="6,0,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="200"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="TEAM HEALTH TREND (6 Month)" Style="{StaticResource SectionHeader}"/>
                                        <lvc:CartesianChart Grid.Row="1" Series="{Binding R12_HealthTrendSeries}" LegendLocation="None">
                                            <lvc:CartesianChart.AxisX>
                                                <lvc:Axis Labels="{Binding R12_HealthTrendLabels}" ShowLabels="True" FontSize="10" Foreground="{DynamicResource HintTextBrush}"/>
                                            </lvc:CartesianChart.AxisX>
                                            <lvc:CartesianChart.AxisY>
                                                <lvc:Axis MinValue="0" MaxValue="100" ShowLabels="True" FontSize="10" Foreground="{DynamicResource HintTextBrush}"/>
                                            </lvc:CartesianChart.AxisY>
                                        </lvc:CartesianChart>
                                    </Grid>
                                </Border>
                            </Grid>
                            
                            <!-- Highlights & Concerns Row -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Key Highlights -->
                                <Border Grid.Column="0" Style="{StaticResource ContentCard}" Margin="0,0,6,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <TextBlock Text="🌟" FontSize="16" Margin="0,0,8,0"/>
                                            <TextBlock Text="KEY HIGHLIGHTS" Style="{StaticResource SectionHeader}"/>
                                        </StackPanel>
                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding R12_KeyHighlights}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Icon}" FontSize="20" VerticalAlignment="Top" Foreground="{Binding IconColor}" Margin="0,0,12,0"/>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource ForegroundBrush}"/>
                                                                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource HintTextBrush}" TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                                
                                <!-- Areas of Concern -->
                                <Border Grid.Column="1" Style="{StaticResource ContentCard}" Margin="6,0,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <TextBlock Text="⚠️" FontSize="16" Margin="0,0,8,0"/>
                                            <TextBlock Text="AREAS OF CONCERN" Style="{StaticResource SectionHeader}"/>
                                        </StackPanel>
                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding R12_AreasOfConcern}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Icon}" FontSize="20" VerticalAlignment="Top" Foreground="{Binding IconColor}" Margin="0,0,12,0"/>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource ForegroundBrush}"/>
                                                                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource HintTextBrush}" TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                        
                        <!-- ============================================== -->
                        <!-- PLACEHOLDER for other reports -->
                        <!-- ============================================== -->
                        <Border Style="{StaticResource ContentCard}"
                                Visibility="{Binding IsPlaceholderReport, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40">
                                <TextBlock Text="🚧" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                <TextBlock Text="{Binding SelectedReportTitle}"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="This report is coming soon!"
                                           FontSize="14"
                                           Foreground="{DynamicResource HintTextBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,8,0,24"/>
                                <TextBlock Text="{Binding SelectedReportDescription}"
                                           FontSize="13"
                                           Foreground="{DynamicResource HintTextBrush}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           MaxWidth="400"
                                           HorizontalAlignment="Center"/>
                                
                                <!-- What this report will show -->
                                <Border Background="{DynamicResource BackgroundBrush}"
                                        CornerRadius="8"
                                        Padding="20"
                                        Margin="0,24,0,0"
                                        MaxWidth="500">
                                    <StackPanel>
                                        <TextBlock Text="What you'll see here:"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                   Margin="0,0,0,12"/>
                                        <ItemsControl ItemsSource="{Binding SelectedReportFeatures}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Margin="0,4" FontSize="13">
                                                        <Run Text="✓ " Foreground="#10B981"/>
                                                        <Run Text="{Binding}" Foreground="{DynamicResource ForegroundBrush}"/>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
        
        <!-- Loading Overlay -->
        <Border Background="#80000000"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Loading report..."
                           FontSize="16"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
