<UserControl x:Class="Tracker.Controls.ReportsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             xmlns:viewModels="clr-namespace:Tracker.ViewModels.DialogViewModels"
             xmlns:converters="clr-namespace:Tracker.Common.Converters"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1400"
             d:DataContext="{d:DesignInstance Type=viewModels:ReportsViewModel}"
             AutomationProperties.Name="Reports"
             AutomationProperties.HelpText="View performance reports and analytics for your team">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles.xaml"/>
                <ResourceDictionary Source="/Resources/Styles/DialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Report Card Style -->
            <Style x:Key="ReportCard" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="16"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            
            <!-- Selected Report Card Style -->
            <Style x:Key="SelectedReportCard" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="16"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>
            
            <!-- Section Header -->
            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{DynamicResource HintTextBrush}"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
            </Style>
            
            <!-- Report Nav Item Style -->
            <Style x:Key="ReportNavItem" TargetType="RadioButton">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid Margin="0,2">
                                <!-- Background layer (can be semi-transparent without affecting text) -->
                                <Border x:Name="Bd" 
                                        Background="Transparent" 
                                        CornerRadius="6"/>
                                <!-- Content layer (always full opacity) -->
                                <Border CornerRadius="6" Padding="12,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="IconText"
                                                   Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ContentText"
                                                   Grid.Column="1" 
                                                   Text="{TemplateBinding Content}"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                   VerticalAlignment="Center"/>
                                        <Border x:Name="StatusBadge" 
                                                Grid.Column="2"
                                                Background="{DynamicResource HintTextBrush}"
                                                CornerRadius="8"
                                                Padding="6,2"
                                                Visibility="Collapsed">
                                            <TextBlock Text="Soon" FontSize="9" Foreground="White"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.2"/>
                                    <Setter TargetName="ContentText" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                    <Setter TargetName="ContentText" Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            
            <!-- Content Card -->
            <Style x:Key="ContentCard" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="20"/>
            </Style>
            
            <!-- Icon Button Style -->
            <Style x:Key="IconButtonStyle" TargetType="{x:Type Button}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                <Setter Property="Padding" Value="8"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid Margin="20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>  <!-- Sidebar -->
                <ColumnDefinition Width="*"/>    <!-- Content -->
            </Grid.ColumnDefinitions>
            
            <!-- ============================================== -->
            <!-- LEFT SIDEBAR - Report Navigation -->
            <!-- ============================================== -->
            <Border Grid.Column="0" 
                    Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Header -->
                    <StackPanel Margin="8,4,8,16">
                        <TextBlock Text="Reports"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                        <TextBlock Text="Analytics &amp; Insights"
                                   FontSize="12"
                                   Foreground="{DynamicResource HintTextBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    
                    <!-- Report List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- PERFORMANCE Section -->
                            <TextBlock Text="PERFORMANCE" Style="{StaticResource SectionHeader}" Margin="8,8,8,8"/>
                            
                            <RadioButton x:Name="Report1" 
                                         Tag="📊" Content="1:1 Effectiveness"
                                         GroupName="Reports"
                                         IsChecked="{Binding IsReport1Selected, Mode=TwoWay}"
                                         Style="{StaticResource ReportNavItem}"/>
                            
                            <RadioButton x:Name="Report2" 
                                         Tag="📅" Content="Meeting Cadence"
                                         GroupName="Reports"
                                         IsChecked="{Binding IsReport2Selected, Mode=TwoWay}"
                                         Style="{StaticResource ReportNavItem}"/>
                            
                            <RadioButton x:Name="Report3" 
                                         Tag="✓" Content="Task Completion"
                                         GroupName="Reports"
                                         IsChecked="{Binding IsReport3Selected, Mode=TwoWay}"
                                         Style="{StaticResource ReportNavItem}"/>
                            
                            <RadioButton x:Name="Report4" 
                                         Tag="📋" Content="Action Item Follow-Up"
                                         GroupName="Reports"
                                         IsChecked="{Binding IsReport4Selected, Mode=TwoWay}"
                                         Style="{StaticResource ReportNavItem}"/>
                            
                            <!-- GOALS Section -->
                            <TextBlock Text="GOALS &amp; METRICS" Style="{StaticResource SectionHeader}" Margin="8,20,8,8"/>
                            
                            <RadioButton x:Name="Report5" 
                                         Tag="🎯" Content="OKR Progress"
                                         GroupName="Reports"
                                         IsChecked="{Binding IsReport5Selected, Mode=TwoWay}"
                                         Style="{StaticResource ReportNavItem}"/>
                            
                            <RadioButton x:Name="Report6" 
                                         Tag="📈" Content="KPI Performance"
                                         GroupName="Reports"
                                         IsChecked="{Binding IsReport6Selected, Mode=TwoWay}"
                                         Style="{StaticResource ReportNavItem}"/>
                            
                            <RadioButton x:Name="Report7" 
                                         Tag="🏆" Content="Goal Tracker"
                                         GroupName="Reports"
                                         IsChecked="{Binding IsReport7Selected, Mode=TwoWay}"
                                         Style="{StaticResource ReportNavItem}"/>
                            
                            <RadioButton x:Name="Report8" 
                                         Tag="📁" Content="Project Health"
                                         GroupName="Reports"
                                         IsChecked="{Binding IsReport8Selected, Mode=TwoWay}"
                                         Style="{StaticResource ReportNavItem}"/>
                            
                            <!-- PEOPLE Section -->
                            <TextBlock Text="PEOPLE" Style="{StaticResource SectionHeader}" Margin="8,20,8,8"/>
                            
                            <RadioButton x:Name="Report9" 
                                         Tag="💬" Content="Feedback Trends"
                                         GroupName="Reports"
                                         IsChecked="{Binding IsReport9Selected, Mode=TwoWay}"
                                         Style="{StaticResource ReportNavItem}"/>
                            
                            <RadioButton x:Name="Report10" 
                                         Tag="👥" Content="Team Comparison"
                                         GroupName="Reports"
                                         IsChecked="{Binding IsReport10Selected, Mode=TwoWay}"
                                         Style="{StaticResource ReportNavItem}"/>
                            
                            <RadioButton x:Name="Report11" 
                                         Tag="👤" Content="Performance Review Prep"
                                         GroupName="Reports"
                                         IsChecked="{Binding IsReport11Selected, Mode=TwoWay}"
                                         Style="{StaticResource ReportNavItem}"/>
                            
                            <!-- SUMMARY Section -->
                            <TextBlock Text="SUMMARY" Style="{StaticResource SectionHeader}" Margin="8,20,8,8"/>
                            
                            <RadioButton x:Name="Report12" 
                                         Tag="📑" Content="Executive Summary"
                                         GroupName="Reports"
                                         IsChecked="{Binding IsReport12Selected, Mode=TwoWay}"
                                         Style="{StaticResource ReportNavItem}"/>
                        </StackPanel>
                    </ScrollViewer>
                    
                    <!-- Export Section -->
                    <Border Grid.Row="2" 
                            BorderBrush="{DynamicResource BorderBrush}" 
                            BorderThickness="0,1,0,0"
                            Padding="8,16,8,8"
                            Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="QUICK EXPORT" Style="{StaticResource SectionHeader}" Margin="0"/>
                            <Button Content="📤 Export All Data"
                                    Command="{Binding ExportAllCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    Padding="12,10"
                                    Margin="0,0,0,8"/>
                            <Button Content="📊 Export Current Report"
                                    Command="{Binding ExportCurrentReportCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    Padding="12,10"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            
            <!-- ============================================== -->
            <!-- MAIN CONTENT - Selected Report -->
            <!-- ============================================== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Toolbar -->
                    <RowDefinition Height="*"/>     <!-- Content -->
                </Grid.RowDefinitions>
                
                <!-- Toolbar / Filters -->
                <Border Grid.Row="0" 
                        Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="8"
                        Padding="16,12"
                        Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Report Title & Description -->
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedReportTitle}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"/>
                            <TextBlock Text="{Binding SelectedReportDescription}"
                                       FontSize="12"
                                       Foreground="{DynamicResource HintTextBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        
                        <!-- Filters -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Team Member Filter (for applicable reports) -->
                            <StackPanel Orientation="Horizontal" 
                                        Margin="0,0,16,0"
                                        Visibility="{Binding ShowTeamMemberFilter, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="Team Member:"
                                           FontSize="12"
                                           Foreground="{DynamicResource HintTextBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <ComboBox ItemsSource="{Binding TeamMemberFilterOptions}"
                                          SelectedItem="{Binding SelectedTeamMemberFilter}"
                                          DisplayMemberPath="FullName"
                                          Width="160"
                                          Style="{StaticResource ModernComboBoxStyle}"/>
                            </StackPanel>
                            
                            <!-- Date Range -->
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Period:"
                                           FontSize="12"
                                           Foreground="{DynamicResource HintTextBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <ComboBox ItemsSource="{Binding DateRangeOptions}"
                                          SelectedItem="{Binding SelectedDateRange}"
                                          Width="140"
                                          Style="{StaticResource ModernComboBoxStyle}"/>
                            </StackPanel>
                            
                            <!-- Refresh Button -->
                            <Button Content="↻"
                                    Command="{Binding RefreshReportCommand}"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTip="Refresh Data"
                                    Margin="12,0,0,0"
                                    FontSize="16"
                                    Padding="8"/>
                        </StackPanel>
                    </Grid>
                </Border>
                
                <!-- Report Content Area -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <!-- ============================================== -->
                        <!-- REPORT 1: 1:1 Effectiveness -->
                        <!-- ============================================== -->
                        <Grid Visibility="{Binding IsReport1Selected, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <!-- KPI Summary Cards -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Total Meetings -->
                                <Border Grid.Column="0" Style="{StaticResource ContentCard}" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="TOTAL 1:1s" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding R1_TotalMeetings}" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Text="meetings held" FontSize="11" Foreground="{DynamicResource HintTextBrush}"/>
                                    </StackPanel>
                                </Border>
                                
                                <!-- Avg Duration -->
                                <Border Grid.Column="1" Style="{StaticResource ContentCard}" Margin="6,0">
                                    <StackPanel>
                                        <TextBlock Text="AVG DURATION" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding R1_AvgDuration, StringFormat='{}{0} min'}" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}"/>
                                        <TextBlock Text="per meeting" FontSize="11" Foreground="{DynamicResource HintTextBrush}"/>
                                    </StackPanel>
                                </Border>
                                
                                <!-- Action Items Created -->
                                <Border Grid.Column="2" Style="{StaticResource ContentCard}" Margin="6,0">
                                    <StackPanel>
                                        <TextBlock Text="ACTIONS CREATED" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding R1_ActionsCreated}" FontSize="32" FontWeight="Bold" Foreground="#F59E0B"/>
                                        <TextBlock Text="from meetings" FontSize="11" Foreground="{DynamicResource HintTextBrush}"/>
                                    </StackPanel>
                                </Border>
                                
                                <!-- Completion Rate -->
                                <Border Grid.Column="3" Style="{StaticResource ContentCard}" Margin="6,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="COMPLETION RATE" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding R1_CompletionRate, StringFormat='{}{0}%'}" FontSize="32" FontWeight="Bold" Foreground="#10B981"/>
                                        <TextBlock Text="actions completed" FontSize="11" Foreground="{DynamicResource HintTextBrush}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            
                            <!-- Charts Row -->
                            <Grid Grid.Row="1" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Meeting Frequency Chart -->
                                <Border Grid.Column="0" Style="{StaticResource ContentCard}" Margin="0,0,6,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="200"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="MEETING FREQUENCY OVER TIME" Style="{StaticResource SectionHeader}"/>
                                        <lvc:CartesianChart Grid.Row="1" Series="{Binding R1_MeetingFrequencySeries}" LegendLocation="None">
                                            <lvc:CartesianChart.AxisX>
                                                <lvc:Axis Labels="{Binding R1_MeetingFrequencyLabels}" ShowLabels="True" FontSize="10" Foreground="{DynamicResource HintTextBrush}"/>
                                            </lvc:CartesianChart.AxisX>
                                            <lvc:CartesianChart.AxisY>
                                                <lvc:Axis MinValue="0" ShowLabels="True" FontSize="10" Foreground="{DynamicResource HintTextBrush}"/>
                                            </lvc:CartesianChart.AxisY>
                                        </lvc:CartesianChart>
                                    </Grid>
                                </Border>
                                
                                <!-- Agenda Topics Distribution -->
                                <Border Grid.Column="1" Style="{StaticResource ContentCard}" Margin="6,0,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="200"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="AGENDA TOPICS DISTRIBUTION" Style="{StaticResource SectionHeader}"/>
                                        <lvc:PieChart Grid.Row="1" 
                                                      Series="{Binding R1_AgendaTopicsSeries}" 
                                                      LegendLocation="Right"
                                                      InnerRadius="50">
                                        </lvc:PieChart>
                                    </Grid>
                                </Border>
                            </Grid>
                            
                            <!-- Recent Meetings Table -->
                            <Border Grid.Row="2" Style="{StaticResource ContentCard}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="RECENT 1:1 MEETINGS" Style="{StaticResource SectionHeader}"/>
                                    <DataGrid Grid.Row="1"
                                              ItemsSource="{Binding R1_RecentMeetings}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              HeadersVisibility="Column"
                                              GridLinesVisibility="Horizontal"
                                              BorderThickness="0"
                                              Background="Transparent"
                                              RowBackground="Transparent"
                                              AlternatingRowBackground="{DynamicResource HoverBrush}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Team Member" Binding="{Binding TeamMember.FullName}" Width="*"/>
                                            <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat='{}{0:MMM d, yyyy}'}" Width="120"/>
                                            <DataGridTextColumn Header="Duration" Binding="{Binding Duration.TotalMinutes, StringFormat='{}{0:F0} min'}" Width="80"/>
                                            <DataGridTextColumn Header="Agenda Items" Binding="{Binding AgendaItems.Count}" Width="100"/>
                                            <DataGridTextColumn Header="Actions" Binding="{Binding Tasks.Count}" Width="80"/>
                                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </Grid>
                        
                        <!-- ============================================== -->
                        <!-- REPORT 2: Meeting Cadence -->
                        <!-- ============================================== -->
                        <Grid Visibility="{Binding IsReport2Selected, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <!-- KPI Summary Cards -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Total Team Members -->
                                <Border Grid.Column="0" Style="{StaticResource ContentCard}" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="TEAM MEMBERS" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding R2_TotalTeamMembers}" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Text="active members" FontSize="11" Foreground="{DynamicResource HintTextBrush}"/>
                                    </StackPanel>
                                </Border>
                                
                                <!-- On Track -->
                                <Border Grid.Column="1" Style="{StaticResource ContentCard}" Margin="6,0">
                                    <StackPanel>
                                        <TextBlock Text="ON TRACK" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding R2_OnTrackCount}" FontSize="32" FontWeight="Bold" Foreground="#10B981"/>
                                        <TextBlock Text="met within 2 weeks" FontSize="11" Foreground="{DynamicResource HintTextBrush}"/>
                                    </StackPanel>
                                </Border>
                                
                                <!-- Overdue -->
                                <Border Grid.Column="2" Style="{StaticResource ContentCard}" Margin="6,0">
                                    <StackPanel>
                                        <TextBlock Text="OVERDUE" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding R2_OverdueCount}" FontSize="32" FontWeight="Bold" Foreground="#EF4444"/>
                                        <TextBlock Text="need scheduling" FontSize="11" Foreground="{DynamicResource HintTextBrush}"/>
                                    </StackPanel>
                                </Border>
                                
                                <!-- Cadence Compliance -->
                                <Border Grid.Column="3" Style="{StaticResource ContentCard}" Margin="6,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="COMPLIANCE" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding R2_CadenceCompliancePercent, StringFormat='{}{0}%'}" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}"/>
                                        <TextBlock Text="cadence met" FontSize="11" Foreground="{DynamicResource HintTextBrush}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            
                            <!-- Chart -->
                            <Border Grid.Row="1" Style="{StaticResource ContentCard}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="200"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="CADENCE STATUS DISTRIBUTION" Style="{StaticResource SectionHeader}"/>
                                    <lvc:PieChart Grid.Row="1" 
                                                  Series="{Binding R2_CadenceDistributionSeries}" 
                                                  LegendLocation="Right"
                                                  InnerRadius="50">
                                    </lvc:PieChart>
                                </Grid>
                            </Border>
                            
                            <!-- Member Cadence Table -->
                            <Border Grid.Row="2" Style="{StaticResource ContentCard}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="TEAM MEMBER CADENCE" Style="{StaticResource SectionHeader}" Margin="0,0,16,0"/>
                                        <TextBlock Text="⚠" FontSize="14" Foreground="#EF4444" VerticalAlignment="Center" Margin="0,0,4,12" Visibility="{Binding R2_OverdueCount, Converter={x:Static converters:IntToVisibilityConverter.Instance}}"/>
                                        <TextBlock Text="{Binding R2_OverdueCount, StringFormat='{}{0} overdue'}" FontSize="11" Foreground="#EF4444" VerticalAlignment="Center" Margin="0,0,0,12" Visibility="{Binding R2_OverdueCount, Converter={x:Static converters:IntToVisibilityConverter.Instance}}"/>
                                    </StackPanel>
                                    <DataGrid Grid.Row="1"
                                              ItemsSource="{Binding R2_MemberCadenceList}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              HeadersVisibility="Column"
                                              GridLinesVisibility="Horizontal"
                                              BorderThickness="0"
                                              Background="Transparent"
                                              RowBackground="Transparent"
                                              AlternatingRowBackground="{DynamicResource HoverBrush}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Team Member" Binding="{Binding TeamMemberName}" Width="*"/>
                                            <DataGridTextColumn Header="Days Since Last" Binding="{Binding DaysSinceLast}" Width="110"/>
                                            <DataGridTextColumn Header="Last Meeting" Binding="{Binding LastMeetingDate}" Width="100"/>
                                            <DataGridTextColumn Header="Next Scheduled" Binding="{Binding NextScheduled}" Width="110"/>
                                            <DataGridTemplateColumn Header="Status" Width="100">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{Binding StatusColor}" CornerRadius="4" Padding="8,2" HorizontalAlignment="Left">
                                                            <TextBlock Text="{Binding Status}" FontSize="11" Foreground="White"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Total 1:1s" Binding="{Binding MeetingCount}" Width="80"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </Grid>
                        
                        <!-- ============================================== -->
                        <!-- REPORT 3: Task Completion -->
                        <!-- ============================================== -->
