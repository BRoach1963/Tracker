<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-x86</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Images\Tracker.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    
    <!-- Suppress NuGet warnings for packages that work fine despite framework differences -->
    <NoWarn>$(NoWarn);NU1603;NU1701</NoWarn>
    <!-- Suppress nullable reference warnings - mostly false positives in WPF data binding -->
    <NoWarn>$(NoWarn);CS8602;CS8603;CS8604;CS8625</NoWarn>
    <!-- Suppress obsolete API warnings for Google Calendar (using recommended DateTimeOffset alternatives causes issues) -->
    <NoWarn>$(NoWarn);CS0618</NoWarn>
    <!-- Suppress async warnings that are intentional -->
    <NoWarn>$(NoWarn);CS1998;CS4014</NoWarn>
    <!-- Suppress non-nullable field warnings for fields initialized in OnApplyTemplate -->
    <NoWarn>$(NoWarn);CS8618</NoWarn>
    
    <!-- Company Info -->
    <Company>Prickly Cactus Software</Company>
    <Authors>Prickly Cactus Software</Authors>
    <Copyright>Copyright © 2024-2025 Prickly Cactus Software. All rights reserved.</Copyright>
    <Product>Team Tracker</Product>
    <Description>Team management and 1:1 meeting tracker for engineering leaders</Description>
  </PropertyGroup>

  <!-- Npgsql 6.0+ requires this to use DateTime with PostgreSQL timestamptz columns -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="Npgsql.EnableLegacyTimestampBehavior" Value="true" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Images\profile.png" />
    <None Remove="Views\TrackerSplash.png" />
    <None Remove="Images\Tracker.ico" />
    <None Remove="Assets\tracker.ico" />
    <None Remove="Assets\tracker-icon.png" />
    <None Remove="Resources\tracer-new.png" />
    <None Remove="Resources\trackernobg.png" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Images\Tracker.ico" />
    <Resource Include="Assets\tracker.ico" />
    <Resource Include="Assets\tracker-icon.png" />
    <Resource Include="Resources\tracer-new.png" />
    <Resource Include="Resources\trackernobg.png" />
    <Content Include="Images\Tracker.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Help System Files -->
  <ItemGroup>
    <Content Include="Resources\Help\**\*.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\Help\toc.json" Condition="Exists('Resources\Help\toc.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Common\Managers\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.0.0" />
    <PackageReference Include="Google.Apis.Calendar.v3" Version="1.68.0.3520" />
    <PackageReference Include="Google.Apis.Auth" Version="1.73.0" />
    <PackageReference Include="Google.Apis.Gmail.v1" Version="1.73.0.3987" />
    <PackageReference Include="Google.Apis.PeopleService.v1" Version="1.72.0.3973" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.11" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.0.2" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.0.2" />
    <PackageReference Include="Dapper" Version="2.1.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Graph" Version="5.56.0" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.61.3" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="MimeKit" Version="4.14.0" />
    <PackageReference Include="Supabase" Version="1.1.1" />
    <PackageReference Include="Syncfusion.SfSchedule.WPF" Version="18.3.0.53" />
    <PackageReference Include="EPPlus" Version="7.5.2" />
    <PackageReference Include="LiveCharts.Wpf" Version="0.9.7" />
    <PackageReference Include="Microsoft.Office.Interop.Outlook" Version="15.0.4797.1004" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Images\profile.png" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="DeepEndControls">
      <HintPath>..\..\..\DeepEndControls\DeepEndControls\bin\Release\net8.0-windows\DeepEndControls.dll</HintPath>
    </Reference>
  </ItemGroup>
  
  <ItemGroup>
    <Compile Remove="GenerateUserManual\**" />
    <Compile Remove="Tools\GenerateUserManual.cs" />
    <Compile Remove="Tools\ManualGenerator.cs" />
    <None Remove="GenerateUserManual\**" />
    <None Remove="Tools\GenerateUserManual.cs" />
    <None Remove="Tools\ManualGenerator.cs" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Views\TrackerSplash.png" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources\Languages\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\Languages\Resources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
