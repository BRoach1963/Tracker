<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Modern Theme - Contemporary indigo/purple -->
    
    <Color x:Key="BackgroundColor">#F8FAFC</Color>
    <Color x:Key="ForegroundColor">#6366F1</Color>
    
    <SolidColorBrush x:Key="BackgroundBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="ForegroundBrush" Color="#6366F1"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="#334155"/>
    <SolidColorBrush x:Key="HintTextBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="DisabledBrush" Color="Gray"/>
    
    <SolidColorBrush x:Key="PrimaryBrush" Color="#6366F1"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#8B5CF6"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="TextBrush" Color="#334155"/>
    
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PopupBorderBrush" Color="#E2E8F0"/>
    
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#EEF2FF"/>
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="#6366F1"/>
    
    <SolidColorBrush x:Key="ToolTipBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ToolTipForeground" Color="#334155"/>
    
    <SolidColorBrush x:Key="SelectionBrush" Color="#E0E7FF"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F8FAFC"/>
    
    <!-- DataGrid Specific - White cells with blue text, blue headers with white text -->
    <SolidColorBrush x:Key="DataGridCellBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DataGridCellForegroundBrush" Color="#6366F1"/>
    <SolidColorBrush x:Key="DataGridCellBorderBrush" Color="#6366F1"/>
    <SolidColorBrush x:Key="DataGridHeaderBackgroundBrush" Color="#6366F1"/>
    <SolidColorBrush x:Key="DataGridHeaderForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DataGridRowAlternateBrush" Color="#F8FAFC"/>
    
    <!-- Status Indicator Brushes -->
    <SolidColorBrush x:Key="StatusDefaultBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="StatusOnTrackBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="StatusAtRiskBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="StatusOffTrackBrush" Color="#EF4444"/>
    
    <!-- Semantic Colors -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#3B82F6"/>
    
    <!-- Danger Button -->
    <SolidColorBrush x:Key="DangerButtonBackgroundBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="DangerButtonHoverBrush" Color="#B91C1C"/>
    <SolidColorBrush x:Key="DangerButtonForegroundBrush" Color="#FFFFFF"/>
    
    <!-- Warning Background (for alert boxes) -->
    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#FEF3C7"/>
</ResourceDictionary>

