<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================================= -->
    <!-- APPLICATION BACKGROUND & SURFACES -->
    <!-- ========================================================= -->

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F7F8F6"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#ECEFEA"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#D3D9D2"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#D3D9D2"/>

    <!-- ========================================================= -->
    <!-- TEXT / FOREGROUND -->
    <!-- ========================================================= -->

    <SolidColorBrush x:Key="PrimaryForegroundBrush" Color="#1E2421"/>
    <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="#5F6B66"/>
    <SolidColorBrush x:Key="TertiaryForegroundBrush" Color="#7A857F"/>
    <SolidColorBrush x:Key="DisabledForegroundBrush" Color="#9AA6A0"/>
    <SolidColorBrush x:Key="InverseForegroundBrush" Color="#FFFFFF"/>

    <!-- ========================================================= -->
    <!-- BRAND COLORS -->
    <!-- ========================================================= -->

    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="#1F3D36"/>
    <SolidColorBrush x:Key="BrandSecondaryBrush" Color="#243A52"/>

    <!-- ========================================================= -->
    <!-- INTERACTIVE / ACCENT -->
    <!-- ========================================================= -->

    <SolidColorBrush x:Key="AccentBrush" Color="#3A6F6B"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#4C7F7A"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#2F5C59"/>

    <!-- ========================================================= -->
    <!-- BUTTONS -->
    <!-- ========================================================= -->

    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="#1F3D36"/>
    <SolidColorBrush x:Key="PrimaryButtonHoverBrush" Color="#294F46"/>
    <SolidColorBrush x:Key="PrimaryButtonPressedBrush" Color="#18312C"/>
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="#ECEFEA"/>
    <SolidColorBrush x:Key="SecondaryButtonHoverBrush" Color="#E0E4DE"/>
    <SolidColorBrush x:Key="SecondaryButtonPressedBrush" Color="#D3D9D2"/>
    <SolidColorBrush x:Key="SecondaryButtonForegroundBrush" Color="#1E2421"/>

    <!-- ========================================================= -->
    <!-- STATES / FEEDBACK -->
    <!-- ========================================================= -->

    <SolidColorBrush x:Key="SuccessBrush" Color="#2F6B4F"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#B68C4A"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#8B3A3A"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#3A6F6B"/>

    <!-- ========================================================= -->
    <!-- SELECTION / FOCUS -->
    <!-- ========================================================= -->

    <SolidColorBrush x:Key="SelectionBackgroundBrush" Color="#D9E4DF"/>
    <SolidColorBrush x:Key="SelectionForegroundBrush" Color="#1E2421"/>
    <SolidColorBrush x:Key="FocusRingBrush" Color="#3A6F6B"/>

    <!-- ========================================================= -->
    <!-- INPUT CONTROLS -->
    <!-- ========================================================= -->

    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#D3D9D2"/>
    <SolidColorBrush x:Key="InputBorderFocusedBrush" Color="#3A6F6B"/>
    <SolidColorBrush x:Key="InputForegroundBrush" Color="#1E2421"/>
    <SolidColorBrush x:Key="InputPlaceholderForegroundBrush" Color="#9AA6A0"/>

</ResourceDictionary>
