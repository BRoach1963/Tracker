<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================================= -->
    <!-- APPLICATION BACKGROUND & SURFACES -->
    <!-- ========================================================= -->

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0F1413"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#151C1A"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1B2422"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#2B3532"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#2B3532"/>

    <!-- ========================================================= -->
    <!-- TEXT / FOREGROUND -->
    <!-- ========================================================= -->

    <SolidColorBrush x:Key="PrimaryForegroundBrush" Color="#E7EEE9"/>
    <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="#B7C3BD"/>
    <SolidColorBrush x:Key="TertiaryForegroundBrush" Color="#93A09A"/>
    <SolidColorBrush x:Key="DisabledForegroundBrush" Color="#6F7C77"/>
    <SolidColorBrush x:Key="InverseForegroundBrush" Color="#0F1413"/>

    <!-- ========================================================= -->
    <!-- BRAND COLORS -->
    <!-- ========================================================= -->

    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="#2C5B50"/>
    <SolidColorBrush x:Key="BrandSecondaryBrush" Color="#2F4B66"/>

    <!-- ========================================================= -->
    <!-- INTERACTIVE / ACCENT -->
    <!-- ========================================================= -->

    <SolidColorBrush x:Key="AccentBrush" Color="#58A39D"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#67B3AD"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#4C8E89"/>

    <!-- ========================================================= -->
    <!-- BUTTONS -->
    <!-- ========================================================= -->

    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="#2C5B50"/>
    <SolidColorBrush x:Key="PrimaryButtonHoverBrush" Color="#356B5E"/>
    <SolidColorBrush x:Key="PrimaryButtonPressedBrush" Color="#244C43"/>
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="#E7EEE9"/>

    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="#1B2422"/>
    <SolidColorBrush x:Key="SecondaryButtonHoverBrush" Color="#232E2B"/>
    <SolidColorBrush x:Key="SecondaryButtonPressedBrush" Color="#2B3532"/>
    <SolidColorBrush x:Key="SecondaryButtonForegroundBrush" Color="#E7EEE9"/>

    <!-- ========================================================= -->
    <!-- STATES / FEEDBACK -->
    <!-- ========================================================= -->

    <SolidColorBrush x:Key="SuccessBrush" Color="#4FB07F"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#D1A35C"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#D06A6A"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#58A39D"/>

    <!-- ========================================================= -->
    <!-- SELECTION / FOCUS -->
    <!-- ========================================================= -->

    <SolidColorBrush x:Key="SelectionBackgroundBrush" Color="#233330"/>
    <SolidColorBrush x:Key="SelectionForegroundBrush" Color="#E7EEE9"/>
    <SolidColorBrush x:Key="FocusRingBrush" Color="#58A39D"/>

    <!-- ========================================================= -->
    <!-- INPUT CONTROLS -->
    <!-- ========================================================= -->

    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#151C1A"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#2B3532"/>
    <SolidColorBrush x:Key="InputBorderFocusedBrush" Color="#58A39D"/>
    <SolidColorBrush x:Key="InputForegroundBrush" Color="#E7EEE9"/>
    <SolidColorBrush x:Key="InputPlaceholderForegroundBrush" Color="#6F7C77"/>

</ResourceDictionary>

