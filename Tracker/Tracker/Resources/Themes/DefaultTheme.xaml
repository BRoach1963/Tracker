<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Default CLEZ Theme - Gold on Black -->
    <!-- Note: These are fallback values. ThemeManager injects the actual theme at runtime. -->
    
    <Color x:Key="BackgroundColor">#1A1A1A</Color>
    <Color x:Key="ForegroundColor">#FFB612</Color>
    
    <SolidColorBrush x:Key="BackgroundBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="ForegroundBrush" Color="#FFB612"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HintTextBrush" Color="#808080"/>
    <SolidColorBrush x:Key="DisabledBrush" Color="Gray"/>
    
    <SolidColorBrush x:Key="PrimaryBrush" Color="#FFB612"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#FFD700"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#FFB612"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF4444"/>
    <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF"/>
    
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="PopupBorderBrush" Color="#FFB612"/>
    
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#000000"/>
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="#FFB612"/>
    
    <SolidColorBrush x:Key="ToolTipBackground" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="ToolTipForeground" Color="#FFFFFF"/>
    
    <SolidColorBrush x:Key="SelectionBrush" Color="#4D3800"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1F1F1F"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#252525"/>
    
    <!-- DataGrid Specific - Default keeps dark cells with gold -->
    <SolidColorBrush x:Key="DataGridCellBackgroundBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="DataGridCellForegroundBrush" Color="#FFB612"/>
    <SolidColorBrush x:Key="DataGridCellBorderBrush" Color="#FFB612"/>
    <SolidColorBrush x:Key="DataGridHeaderBackgroundBrush" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="DataGridHeaderForegroundBrush" Color="#FFB612"/>
    <SolidColorBrush x:Key="DataGridRowAlternateBrush" Color="#222222"/>
    
    <!-- Status Indicator Brushes -->
    <SolidColorBrush x:Key="StatusDefaultBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="StatusOnTrackBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="StatusAtRiskBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="StatusOffTrackBrush" Color="#EF4444"/>
    
    <!-- Semantic Colors -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#3B82F6"/>
    
    <!-- Danger Button -->
    <SolidColorBrush x:Key="DangerButtonBackgroundBrush" Color="#7F1D1D"/>
    <SolidColorBrush x:Key="DangerButtonHoverBrush" Color="#991B1B"/>
    <SolidColorBrush x:Key="DangerButtonForegroundBrush" Color="#FFFFFF"/>
    
    <!-- Warning Background (for alert boxes) -->
    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#2D1F00"/>
</ResourceDictionary>

