<Window x:Class="Tracker.Views.SplashScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="False"
        Title="Tracker"
        Icon="/Images/Tracker.ico"
        Height="520"
        Width="480"
        Loaded="Window_Loaded">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Themes/TrackerTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Glow effect for logo -->
            <DropShadowEffect x:Key="LogoGlow" 
                              BlurRadius="30" 
                              ShadowDepth="0" 
                              Color="#C7A44F" 
                              Opacity="0.5"/>
            
            <!-- Subtle shadow for container -->
            <DropShadowEffect x:Key="ContainerShadow" 
                              BlurRadius="40" 
                              ShadowDepth="5" 
                              Direction="270"
                              Color="#000000" 
                              Opacity="0.6"/>
            
            <!-- Loading spinner rotation storyboard -->
            <Storyboard x:Key="SpinnerAnimation" RepeatBehavior="Forever">
                <DoubleAnimation Storyboard.TargetName="SpinnerTransform"
                                 Storyboard.TargetProperty="Angle"
                                 From="0" To="360"
                                 Duration="0:0:1.5"/>
            </Storyboard>
            
            <!-- Pulse animation for logo -->
            <Storyboard x:Key="LogoPulse" RepeatBehavior="Forever" AutoReverse="True">
                <DoubleAnimation Storyboard.TargetName="LogoPath"
                                 Storyboard.TargetProperty="Effect.Opacity"
                                 From="0.3" To="0.7"
                                 Duration="0:0:1.5"/>
            </Storyboard>
            
            <!-- TextBox style for login -->
            <Style x:Key="LoginTextBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="#2D3741"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="CaretBrush" Value="#C7A44F"/>
                <Setter Property="BorderBrush" Value="#404040"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,10"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter Property="BorderBrush" Value="#C7A44F"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            
            <!-- PasswordBox style for login -->
            <Style x:Key="LoginPasswordBoxStyle" TargetType="PasswordBox">
                <Setter Property="Background" Value="#2D3741"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="CaretBrush" Value="#C7A44F"/>
                <Setter Property="BorderBrush" Value="#404040"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,10"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="PasswordBox">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter Property="BorderBrush" Value="#C7A44F"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            
            <!-- Login Button style -->
            <Style x:Key="LoginButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#C7A44F"/>
                <Setter Property="Foreground" Value="#1A2028"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Padding" Value="20,12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#E6A410"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#CC900E"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    
    <Border CornerRadius="16"
            Effect="{StaticResource ContainerShadow}"
            Margin="20">
        <!-- Gradient background -->
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#141414" Offset="0"/>
                <GradientStop Color="#0A0A0A" Offset="0.5"/>
                <GradientStop Color="#141414" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        
        <!-- Subtle border -->
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#C7A44F" Offset="0"/>
                <GradientStop Color="#806B0A" Offset="0.5"/>
                <GradientStop Color="#C7A44F" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.BorderThickness>
            <Thickness>1</Thickness>
        </Border.BorderThickness>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- ================================================== -->
            <!-- LOGO AND BRANDING -->
            <!-- ================================================== -->
            <StackPanel Grid.Row="0" 
                        HorizontalAlignment="Center"
                        Margin="0,30,0,0">
                
                <!-- Tracker Logo Icon -->
                <Viewbox Width="80" Height="80" Margin="0,0,0,12">
                    <Path x:Name="LogoPath"
                          Effect="{StaticResource LogoGlow}"
                          Fill="#C7A44F"
                          Data="M22,5.5A3.5,3.5 0 0,0 18.5,2A3.5,3.5 0 0,0 15,5.5V6A3,3 0 0,1 12,9C10,9 9,6 6,6A4,4 0 0,0 2,10V11H4V10A2,2 0 0,1 6,8C6.86,8 7.42,8.45 8.32,9.24C9.28,10.27 10.6,10.9 12,11A5,5 0 0,0 17,6V5.5A1.5,1.5 0 0,1 18.5,4A1.5,1.5 0 0,1 20,5.5C19.86,6.35 19.58,7.18 19.17,7.94C18.5,9.2 18.11,10.58 18,12C18.09,13.37 18.5,14.71 19.21,15.89C19.6,16.54 19.87,17.25 20,18A2,2 0 0,1 18,20A2,2 0 0,1 16,18A3.75,3.75 0 0,0 12.25,14.25A3.75,3.75 0 0,0 8.5,18V18.5A1.5,1.5 0 0,1 7,20A3,3 0 0,1 4,17V15H6V13H0V15H2V17A5,5 0 0,0 7,22A3.5,3.5 0 0,0 10.5,18.5V18A1.75,1.75 0 0,1 12.25,16.25A1.75,1.75 0 0,1 14,18A4,4 0 0,0 18,22A4,4 0 0,0 22,18C22,16 20,14 20,12C20,10 22,7.5 22,5.5Z"/>
                </Viewbox>
                
                <!-- App Title -->
                <TextBlock Text="Tracker"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="#C7A44F"
                           HorizontalAlignment="Center"
                           FontFamily="Segoe UI">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#C7A44F" Opacity="0.3"/>
                    </TextBlock.Effect>
                </TextBlock>
                
                <!-- Tagline -->
                <TextBlock Text="Team Management Made Simple"
                           FontSize="13"
                           Foreground="#707070"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"
                           FontFamily="Segoe UI"/>
            </StackPanel>
            
            <!-- ================================================== -->
            <!-- CONTENT AREA (Loading OR Login) -->
            <!-- ================================================== -->
            <Grid Grid.Row="1" Margin="40,20">
                
                <!-- Loading Panel (visible when not showing login) -->
                <StackPanel x:Name="LoadingPanel" 
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Visibility="Visible">
                    
                    <!-- Custom spinner -->
                    <Canvas Width="36" Height="36" HorizontalAlignment="Center" Margin="0,0,0,20">
                        <Canvas.RenderTransform>
                            <RotateTransform x:Name="SpinnerTransform" CenterX="18" CenterY="18"/>
                        </Canvas.RenderTransform>
                        
                        <!-- Spinner dots -->
                        <Ellipse Width="7" Height="7" Fill="#C7A44F" Canvas.Left="14.5" Canvas.Top="0" Opacity="1"/>
                        <Ellipse Width="7" Height="7" Fill="#C7A44F" Canvas.Left="25" Canvas.Top="3.5" Opacity="0.875"/>
                        <Ellipse Width="7" Height="7" Fill="#C7A44F" Canvas.Left="29" Canvas.Top="14.5" Opacity="0.75"/>
                        <Ellipse Width="7" Height="7" Fill="#C7A44F" Canvas.Left="25" Canvas.Top="25.5" Opacity="0.625"/>
                        <Ellipse Width="7" Height="7" Fill="#C7A44F" Canvas.Left="14.5" Canvas.Top="29" Opacity="0.5"/>
                        <Ellipse Width="7" Height="7" Fill="#C7A44F" Canvas.Left="4" Canvas.Top="25.5" Opacity="0.375"/>
                        <Ellipse Width="7" Height="7" Fill="#C7A44F" Canvas.Left="0" Canvas.Top="14.5" Opacity="0.25"/>
                        <Ellipse Width="7" Height="7" Fill="#C7A44F" Canvas.Left="4" Canvas.Top="3.5" Opacity="0.125"/>
                    </Canvas>
                    
                    <!-- Status Text -->
                    <TextBlock x:Name="StatusText"
                               Text="Initializing..."
                               FontSize="13"
                               Foreground="#909090"
                               HorizontalAlignment="Center"
                               FontFamily="Segoe UI"/>
                </StackPanel>
                
                <!-- Login Panel (hidden by default) -->
                <StackPanel x:Name="LoginPanel" 
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            Opacity="0">
                    
                    <!-- Login Form -->
                    <StackPanel Width="300">
                        
                        <!-- Username -->
                        <TextBlock Text="Username"
                                   FontSize="12"
                                   Foreground="#909090"
                                   Margin="0,0,0,6"
                                   FontFamily="Segoe UI"/>
                        <TextBox x:Name="UsernameTextBox"
                                 Style="{StaticResource LoginTextBoxStyle}"
                                 KeyDown="TextBox_KeyDown"/>
                        
                        <!-- Password -->
                        <TextBlock Text="Password"
                                   FontSize="12"
                                   Foreground="#909090"
                                   Margin="0,16,0,6"
                                   FontFamily="Segoe UI"/>
                        <PasswordBox x:Name="PasswordBox"
                                     Style="{StaticResource LoginPasswordBoxStyle}"
                                     KeyDown="PasswordBox_KeyDown"/>
                        
                        <!-- Error Message -->
                        <TextBlock x:Name="ErrorText"
                                   Text=""
                                   FontSize="12"
                                   Foreground="#FF6B6B"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,0"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"/>
                        
                        <!-- Login Button -->
                        <Button x:Name="LoginButton"
                                Content="Sign In"
                                Style="{StaticResource LoginButtonStyle}"
                                Margin="0,20,0,0"
                                Click="LoginButton_Click"/>
                        
                        <!-- Windows Auth Option -->
                    </StackPanel>
                </StackPanel>
            </Grid>
            
            <!-- ================================================== -->
            <!-- FOOTER -->
            <!-- ================================================== -->
            <StackPanel Grid.Row="2" 
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,20">
                
                <!-- Progress Bar (only visible during loading) -->
                <Border x:Name="ProgressBarContainer"
                        Height="3"
                        Width="200"
                        Margin="0,0,0,15"
                        CornerRadius="1.5"
                        Background="#2D3741">
                    <Border x:Name="ProgressFill"
                            HorizontalAlignment="Left"
                            Width="0"
                            CornerRadius="1.5"
                            Background="#C7A44F"/>
                </Border>
                
                <TextBlock Text="© 2024 Prickly Cactus Software"
                           FontSize="10"
                           Foreground="#404040"
                           HorizontalAlignment="Center"
                           FontFamily="Segoe UI"/>
                <TextBlock x:Name="VersionText"
                           Text="Version 1.0.0"
                           FontSize="9"
                           Foreground="#353535"
                           HorizontalAlignment="Center"
                           FontFamily="Segoe UI"
                           Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
