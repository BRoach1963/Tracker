<Window x:Class="Tracker.Views.SplashScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="False"
        Title="Tracker"
        Icon="/Assets/tracker.ico"
        Height="400"
        Width="360"
        Loaded="Window_Loaded">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Themes/TrackerTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Glow effect for logo - uses AccentColor from theme -->
            <DropShadowEffect x:Key="LogoGlow" 
                              BlurRadius="30" 
                              ShadowDepth="0" 
                              Color="{StaticResource AccentColor}" 
                              Opacity="0.5"/>
            
            <!-- Subtle shadow for container - black is theme-neutral -->
            <DropShadowEffect x:Key="ContainerShadow" 
                              BlurRadius="40" 
                              ShadowDepth="5" 
                              Direction="270"
                              Color="#000000" 
                              Opacity="0.6"/>
            
            <!-- Loading spinner rotation storyboard -->
            <Storyboard x:Key="SpinnerAnimation" RepeatBehavior="Forever">
                <DoubleAnimation Storyboard.TargetName="SpinnerTransform"
                                 Storyboard.TargetProperty="Angle"
                                 From="0" To="360"
                                 Duration="0:0:1.5"/>
            </Storyboard>
            
            <!-- Pulse animation for logo -->
            <Storyboard x:Key="LogoPulse" RepeatBehavior="Forever" AutoReverse="True">
                <DoubleAnimation Storyboard.TargetName="LogoBorder"
                                 Storyboard.TargetProperty="Effect.Opacity"
                                 From="0.3" To="0.7"
                                 Duration="0:0:1.5"/>
            </Storyboard>
            
            <!-- TextBox style for login -->
            <Style x:Key="LoginTextBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,10"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            
            <!-- PasswordBox style for login -->
            <Style x:Key="LoginPasswordBoxStyle" TargetType="PasswordBox">
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,10"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="PasswordBox">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            
            <!-- Login Button style -->
            <Style x:Key="LoginButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Padding" Value="20,12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    
    <Border CornerRadius="12"
            Effect="{StaticResource ContainerShadow}"
            Margin="15"
            Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- ================================================== -->
            <!-- LOGO AND BRANDING -->
            <!-- ================================================== -->
            <StackPanel Grid.Row="0" 
                        HorizontalAlignment="Center"
                        Margin="0,30,0,0">
                
                <!-- Tracker Logo Icon -->
                <Border x:Name="LogoBorder" Width="80" Height="80" Margin="0,0,0,12"
                        Effect="{StaticResource LogoGlow}">
                    <Image Source="/Resources/trackernobg.png" Stretch="Uniform"/>
                </Border>
                
                <!-- App Title -->
                <TextBlock Text="Tracker™"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}"
                           HorizontalAlignment="Center"
                           FontFamily="Segoe UI Semibold"/>
                
                <!-- Tagline -->
                <TextBlock Text="Team Performance, Simplified"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"
                           FontFamily="Segoe UI"/>
            </StackPanel>
            
            <!-- ================================================== -->
            <!-- CONTENT AREA (Loading OR Login) -->
            <!-- ================================================== -->
            <Grid Grid.Row="1" Margin="40,20">
                
                <!-- Loading Panel (visible when not showing login) -->
                <StackPanel x:Name="LoadingPanel" 
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Visibility="Visible">
                    
                    <!-- Custom spinner -->
                    <Canvas Width="36" Height="36" HorizontalAlignment="Center" Margin="0,0,0,20">
                        <Canvas.RenderTransform>
                            <RotateTransform x:Name="SpinnerTransform" CenterX="18" CenterY="18"/>
                        </Canvas.RenderTransform>
                        
                        <!-- Spinner dots -->
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" Canvas.Left="15" Canvas.Top="0" Opacity="1"/>
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" Canvas.Left="25" Canvas.Top="4" Opacity="0.85"/>
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" Canvas.Left="29" Canvas.Top="15" Opacity="0.7"/>
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" Canvas.Left="25" Canvas.Top="25" Opacity="0.55"/>
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" Canvas.Left="15" Canvas.Top="29" Opacity="0.4"/>
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" Canvas.Left="4" Canvas.Top="25" Opacity="0.3"/>
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" Canvas.Left="0" Canvas.Top="15" Opacity="0.2"/>
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" Canvas.Left="4" Canvas.Top="4" Opacity="0.1"/>
                    </Canvas>
                    
                    <!-- Status Text -->
                    <TextBlock x:Name="StatusText"
                               Text="Initializing..."
                               FontSize="12"
                               Foreground="{DynamicResource HintTextBrush}"
                               HorizontalAlignment="Center"
                               FontFamily="Segoe UI"/>
                </StackPanel>
                
                <!-- Login Panel (hidden by default) -->
                <StackPanel x:Name="LoginPanel" 
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            Opacity="0">
                    
                    <!-- Login Form -->
                    <StackPanel Width="300">
                        
                        <!-- Username -->
                        <TextBlock Text="Username"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,6"
                                   FontFamily="Segoe UI"/>
                        <TextBox x:Name="UsernameTextBox"
                                 Style="{StaticResource LoginTextBoxStyle}"
                                 KeyDown="TextBox_KeyDown"/>
                        
                        <!-- Password -->
                        <TextBlock Text="Password"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,16,0,6"
                                   FontFamily="Segoe UI"/>
                        <PasswordBox x:Name="PasswordBox"
                                     Style="{StaticResource LoginPasswordBoxStyle}"
                                     KeyDown="PasswordBox_KeyDown"/>
                        
                        <!-- Error Message -->
                        <TextBlock x:Name="ErrorText"
                                   Text=""
                                   FontSize="12"
                                   Foreground="{DynamicResource DangerBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,0"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"/>
                        
                        <!-- Login Button -->
                        <Button x:Name="LoginButton"
                                Content="Sign In"
                                Style="{StaticResource LoginButtonStyle}"
                                Margin="0,20,0,0"
                                Click="LoginButton_Click"/>
                        
                        <!-- Windows Auth Option -->
                    </StackPanel>
                </StackPanel>
            </Grid>
            
            <!-- ================================================== -->
            <!-- FOOTER -->
            <!-- ================================================== -->
            <StackPanel Grid.Row="2" 
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,20">
                
                <!-- Progress Bar -->
                <Border x:Name="ProgressBarContainer"
                        Height="3"
                        Width="180"
                        Margin="0,0,0,12"
                        CornerRadius="1.5"
                        Background="{DynamicResource SurfaceAltBrush}">
                    <Border x:Name="ProgressFill"
                            HorizontalAlignment="Left"
                            Width="0"
                            CornerRadius="1.5"
                            Background="{DynamicResource AccentBrush}"/>
                </Border>
                
                <TextBlock Text="© 2024-2026 Prickly Cactus Software™"
                           FontSize="10"
                           Foreground="{DynamicResource HintTextBrush}"
                           HorizontalAlignment="Center"
                           FontFamily="Segoe UI"/>
                <TextBlock x:Name="VersionText"
                           Text="v2.0"
                           FontSize="9"
                           Foreground="{DynamicResource HintTextBrush}"
                           Opacity="0.7"
                           HorizontalAlignment="Center"
                           FontFamily="Segoe UI"
                           Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
