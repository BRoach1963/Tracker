<Window x:Class="Tracker.Views.LoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tracker Loading" 
        Height="250" 
        Width="400"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True"
        Loaded="Window_Loaded">
    
    <Window.Resources>
        <!-- Smooth spinner animation (continuous rotation) -->
        <Storyboard x:Key="SpinnerAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="SpinnerTransform"
                           Storyboard.TargetProperty="Angle"
                           From="0" To="360"
                           Duration="0:0:1.2"
                           RepeatBehavior="Forever"/>
        </Storyboard>
    </Window.Resources>
    
    <Border Background="#2C2C2C" 
            CornerRadius="12"
            BorderBrush="#3E3E42"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" 
                            Direction="270" 
                            ShadowDepth="4" 
                            BlurRadius="20" 
                            Opacity="0.5"/>
        </Border.Effect>
        
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Welcome message -->
            <TextBlock x:Name="WelcomeText"
                      Grid.Row="0"
                      Text="Welcome!"
                      FontSize="24"
                      FontWeight="SemiBold"
                      Foreground="#FFFFFF"
                      HorizontalAlignment="Center"
                      TextAlignment="Center"/>
            
            <!-- Smooth Dot Spinner (same as SplashScreen) -->
            <Canvas Grid.Row="2" 
                    Width="48" 
                    Height="48" 
                    HorizontalAlignment="Center">
                <Canvas.RenderTransform>
                    <RotateTransform x:Name="SpinnerTransform" 
                                   Angle="0" 
                                   CenterX="24" 
                                   CenterY="24"/>
                </Canvas.RenderTransform>
                
                <!-- 8 dots with fading opacity for smooth rotation effect -->
                <Ellipse Width="9" Height="9" Fill="#FFB612" Canvas.Left="19.5" Canvas.Top="0" Opacity="1"/>
                <Ellipse Width="9" Height="9" Fill="#FFB612" Canvas.Left="33" Canvas.Top="5" Opacity="0.875"/>
                <Ellipse Width="9" Height="9" Fill="#FFB612" Canvas.Left="39" Canvas.Top="19.5" Opacity="0.75"/>
                <Ellipse Width="9" Height="9" Fill="#FFB612" Canvas.Left="33" Canvas.Top="34" Opacity="0.625"/>
                <Ellipse Width="9" Height="9" Fill="#FFB612" Canvas.Left="19.5" Canvas.Top="39" Opacity="0.5"/>
                <Ellipse Width="9" Height="9" Fill="#FFB612" Canvas.Left="6" Canvas.Top="34" Opacity="0.375"/>
                <Ellipse Width="9" Height="9" Fill="#FFB612" Canvas.Left="0" Canvas.Top="19.5" Opacity="0.25"/>
                <Ellipse Width="9" Height="9" Fill="#FFB612" Canvas.Left="6" Canvas.Top="5" Opacity="0.125"/>
            </Canvas>
            
            <!-- Status message -->
            <TextBlock Grid.Row="4"
                      Text="Tracker is initializing, one moment..."
                      FontSize="14"
                      Foreground="#B0B0B0"
                      HorizontalAlignment="Center"
                      TextAlignment="Center"/>
        </Grid>
    </Border>
</Window>
