<controls:BaseWindow x:Class="Tracker.Views.AdminWindow"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:controls="clr-namespace:Tracker.Controls"
                     xmlns:converters="clr-namespace:Tracker.Common.Converters"
                     mc:Ignorable="d"
                     Title="Tracker Admin Tools" 
                     Height="800" 
                     Width="1200"
                     MinHeight="600"
                     MinWidth="900"
                     WindowStartupLocation="CenterScreen"
                     WindowStyle="None"
                     ResizeMode="CanResize"
                     AllowsTransparency="True"
                     Background="Transparent"
                     Icon="/Images/Tracker.ico">
    
    <Border Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0"
                    Background="{DynamicResource BackgroundBrush}"
                    CornerRadius="10,10,0,0">
                <controls:DialogTitleBar x:Name="TitleBar"
                                         DialogTitle="Administrator Tools"
                                         ShowThemeSelector="False"
                                         ShowProfileButton="False"
                                         CloseClicked="TitleBar_CloseClicked"
                                         MinimizeClicked="TitleBar_MinimizeClicked"
                                         MaximizeClicked="TitleBar_MaximizeClicked"
                                         RestoreClicked="TitleBar_RestoreClicked"/>
            </Border>

            <!-- Main Content with Tabs -->
            <TabControl Grid.Row="1" 
                        Style="{StaticResource DialogTabControlStyle}"
                        Margin="20,10,20,20">
                
                <!-- Overview Tab -->
                <TabItem Header="📊 Overview" Style="{StaticResource DialogTabItemStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="15">
                        <StackPanel>
                            
                            <!-- Database Connection Info Card -->
                            <Border Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource AccentBrush}"
                                    BorderThickness="2"
                                    CornerRadius="8"
                                    Padding="20"
                                    Margin="0,0,0,20">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                        <TextBlock Text="🔌 Database Connection" 
                                                   FontSize="18" 
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ForegroundBrush}"/>
                                        <TextBlock Text="{Binding ConnectionStatus}" 
                                                   FontSize="14" 
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="15,0,0,0"/>
                                    </StackPanel>
                                    
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        
                                        <TextBlock Grid.Row="0" Grid.Column="0" 
                                                   Text="Type:" 
                                                   FontSize="13" 
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                   Margin="0,0,15,8"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" 
                                                   Text="{Binding DatabaseType}" 
                                                   FontSize="13" 
                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                   Margin="0,0,0,8"/>
                                        
                                        <TextBlock Grid.Row="1" Grid.Column="0" 
                                                   Text="Path:" 
                                                   FontSize="13" 
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                   Margin="0,0,15,0"
                                                   VerticalAlignment="Top"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" 
                                                 Text="{Binding DatabasePath, Mode=OneWay}" 
                                                 FontSize="12" 
                                                 FontFamily="Consolas"
                                                 Foreground="{DynamicResource ForegroundBrush}"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 IsReadOnly="True"
                                                 TextWrapping="Wrap"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            
                            <!-- Database Statistics Card -->
                            <Border Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="25"
                                    Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="📊 Database Statistics" 
                                               FontSize="18" 
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               Margin="0,0,0,20"/>
                                    
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Total Users" 
                                                       FontSize="12" 
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       Margin="0,0,0,5"/>
                                            <TextBlock Text="{Binding TotalUsers}" 
                                                       FontSize="32" 
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentBrush}"/>
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Total Records" 
                                                       FontSize="12" 
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       Margin="0,0,0,5"/>
                                            <TextBlock Text="{Binding TotalRecords}" 
                                                       FontSize="32" 
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentBrush}"/>
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Database Size" 
                                                       FontSize="12" 
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       Margin="0,0,0,5"/>
                                            <TextBlock Text="{Binding DatabaseSize}" 
                                                       FontSize="32" 
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- User Management Card -->
                            <Border Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="25">
                                <StackPanel>
                                    <TextBlock Text="👥 User Management" 
                                               FontSize="18" 
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               Margin="0,0,0,20"/>
                                    
                                    <DataGrid ItemsSource="{Binding Users}"
                                              SelectedItem="{Binding SelectedUser}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              Height="200"
                                              Margin="0,0,0,15">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                                            <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="*"/>
                                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                                            <DataGridCheckBoxColumn Header="Admin" Binding="{Binding IsAdmin}" Width="70"/>
                                            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="70"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="View Details" 
                                                Command="{Binding ViewUserCommand}"
                                                Style="{DynamicResource SecondaryButtonStyle}"
                                                Margin="0,0,10,0"
                                                Padding="15,8"/>
                                        <Button Content="Merge Users" 
                                                Command="{Binding MergeUsersCommand}"
                                                Style="{DynamicResource SecondaryButtonStyle}"
                                                Margin="0,0,10,0"
                                                Padding="15,8"/>
                                        <Button Content="Delete User" 
                                                Command="{Binding DeleteUserCommand}"
                                                Style="{DynamicResource DangerButtonStyle}"
                                                Padding="15,8"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Database Tools Tab -->
                <TabItem Header="🛠️ Database Tools" Style="{StaticResource DialogTabItemStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="15">
                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="25">
                            <StackPanel>
                                <TextBlock Text="🛠️ Database Tools" 
                                           FontSize="18" 
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           Margin="0,0,0,20"/>
                                
                                <UniformGrid Columns="3" Rows="2">
                                    <Button Content="Backup Database" 
                                            Command="{Binding BackupDatabaseCommand}"
                                            Style="{DynamicResource PrimaryButtonStyle}"
                                            Margin="0,0,10,10"
                                            Padding="20,15"/>
                                    <Button Content="Restore Database" 
                                            Command="{Binding RestoreDatabaseCommand}"
                                            Style="{DynamicResource SecondaryButtonStyle}"
                                            Margin="0,0,10,10"
                                            Padding="20,15"/>
                                    <Button Content="Optimize Database" 
                                            Command="{Binding OptimizeDatabaseCommand}"
                                            Style="{DynamicResource SecondaryButtonStyle}"
                                            Margin="0,0,0,10"
                                            Padding="20,15"/>
                                    <Button Content="Export Data" 
                                            Command="{Binding ExportDataCommand}"
                                            Style="{DynamicResource SecondaryButtonStyle}"
                                            Margin="0,0,10,0"
                                            Padding="20,15"/>
                                    <Button Content="Import Data" 
                                            Command="{Binding ImportDataCommand}"
                                            Style="{DynamicResource SecondaryButtonStyle}"
                                            Margin="0,0,10,0"
                                            Padding="20,15"/>
                                    <Button Content="Clear All Data" 
                                            Command="{Binding ClearDataCommand}"
                                            Style="{DynamicResource DangerButtonStyle}"
                                            Padding="20,15"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </TabItem>

                <!-- Query Editor Tab -->
                <TabItem Header="⚡ Query Editor" Style="{StaticResource DialogTabItemStyle}">
                    <Grid Margin="15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Table List -->
                        <Border Grid.Column="0" 
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="15"
                                Margin="0,0,15,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top"
                                           Text="📋 Tables" 
                                           FontSize="14" 
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           Margin="0,0,0,10"/>
                                
                                <Button DockPanel.Dock="Bottom"
                                        Content="Refresh Schema" 
                                        Command="{Binding RefreshTablesCommand}"
                                        Style="{DynamicResource SecondaryButtonStyle}"
                                        Margin="0,10,0,0"
                                        Padding="10,6"/>
                                
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Tables}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" 
                                                           FontSize="12"
                                                           FontFamily="Consolas"
                                                           Foreground="{DynamicResource ForegroundBrush}"
                                                           Padding="5,3"
                                                           Cursor="Hand"
                                                           ToolTip="Double-click to insert"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <!-- Query Panel -->
                        <DockPanel Grid.Column="1">
                            <TextBlock DockPanel.Dock="Top"
                                       Text="⚡ SQL Query Editor (separate queries with ;)" 
                                       FontSize="16" 
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,10"/>

                            <!-- Query Input with autocomplete hint -->
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBox x:Name="SqlQueryTextBox"
                                         Text="{Binding SqlQuery, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         AcceptsTab="True"
                                         TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         FontFamily="Consolas"
                                         FontSize="13"
                                         Height="150"
                                         Padding="10"
                                         SpellCheck.IsEnabled="False"/>
                                
                                <!-- Autocomplete popup -->
                                <Popup x:Name="AutocompletePopup"
                                       PlacementTarget="{Binding ElementName=SqlQueryTextBox}"
                                       Placement="Bottom"
                                       IsOpen="{Binding ShowAutoComplete}"
                                       StaysOpen="False"
                                       AllowsTransparency="True">
                                    <Border Background="{DynamicResource CardBackgroundBrush}"
                                            BorderBrush="{DynamicResource AccentBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            MaxHeight="200">
                                        <ListBox ItemsSource="{Binding AutocompleteSuggestions}"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 MaxWidth="300">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}"
                                                               FontFamily="Consolas"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource ForegroundBrush}"
                                                               Padding="8,4"/>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                </Popup>
                            </Grid>

                            <!-- Execute Row -->
                            <StackPanel DockPanel.Dock="Top"
                                        Orientation="Horizontal" 
                                        Margin="0,0,0,10">
                                <Button Content="▶ Execute (F5)" 
                                        Command="{Binding ExecuteQueryCommand}"
                                        Style="{DynamicResource PrimaryButtonStyle}"
                                        Padding="20,10"/>
                                <TextBlock Text="{Binding QueryStatus}"
                                           FontSize="12"
                                           Foreground="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Center"
                                           Margin="15,0,0,0"/>
                            </StackPanel>

                            <!-- Multiple Results Grids -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding QueryResultSets}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource CardBackgroundBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Margin="0,0,0,10"
                                                    Padding="10">
                                                <StackPanel>
                                                    <!-- Query header -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                        <TextBlock Text="{Binding Message}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AccentBrush}"/>
                                                    </StackPanel>
                                                    
                                                    <!-- Result grid (only if has results) -->
                                                    <DataGrid ItemsSource="{Binding Results.DefaultView}"
                                                              Visibility="{Binding HasResults, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}"
                                                              AutoGenerateColumns="True"
                                                              IsReadOnly="True"
                                                              CanUserAddRows="False"
                                                              MaxHeight="300"
                                                              FontFamily="Consolas"
                                                              FontSize="12"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>
                </TabItem>

            </TabControl>
        </Grid>
    </Border>
</controls:BaseWindow>
