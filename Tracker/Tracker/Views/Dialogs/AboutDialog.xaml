<controls:BaseWindow x:Class="Tracker.Views.Dialogs.AboutDialog"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:controls="clr-namespace:Tracker.Controls"
                     Title="About Tracker"
                     Height="420" Width="400"
                     WindowStyle="None"
                     AllowsTransparency="True"
                     ResizeMode="NoResize"
                     WindowStartupLocation="CenterOwner"
                     Background="Transparent">
    
    <Border Background="{DynamicResource BackgroundBrush}"
            BorderThickness="1"
            BorderBrush="{DynamicResource BorderBrush}"
            CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Title Bar -->
            <Border Grid.Row="0" 
                    Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="12,12,0,0"
                    Padding="16,12"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="About Tracker"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ForegroundBrush}"
                               VerticalAlignment="Center"/>
                    <Button HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            Click="Close_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" 
                                        Background="Transparent" 
                                        CornerRadius="4"
                                        Padding="4">
                                    <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                          Width="14" Height="14"
                                          Fill="{DynamicResource HintTextBrush}"
                                          Stretch="Uniform"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
            
            <!-- Content -->
            <ScrollViewer Grid.Row="1" 
                          VerticalScrollBarVisibility="Auto"
                          Padding="24,16">
                <StackPanel>
                    <!-- App Icon and Name -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <Image Source="/Images/Tracker.ico" Width="64" Height="64" Margin="0,0,16,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Tracker"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource ForegroundBrush}"/>
                            <TextBlock x:Name="VersionText"
                                       Text="Version 1.0.0"
                                       FontSize="13"
                                       Foreground="{DynamicResource HintTextBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <!-- Description -->
                    <TextBlock Text="Professional relationship management for engineering leaders. Track 1:1 meetings, goals, OKRs, KPIs, and team performance."
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               FontSize="13"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,0,0,20"/>
                    
                    <!-- Company Info -->
                    <Border Background="{DynamicResource SurfaceBrush}"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="© 2024-2026 Prickly Cactus Software LLC"
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="All rights reserved."
                                       FontSize="12"
                                       Foreground="{DynamicResource HintTextBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Links -->
                    <StackPanel Margin="0,8,0,0">
                        <Button Content="📄 Terms of Service"
                                Style="{DynamicResource LinkButtonStyle}"
                                Click="TermsOfService_Click"
                                HorizontalAlignment="Center"
                                Margin="0,4"/>
                        <Button Content="🔒 Privacy Policy"
                                Style="{DynamicResource LinkButtonStyle}"
                                Click="PrivacyPolicy_Click"
                                HorizontalAlignment="Center"
                                Margin="0,4"/>
                        <Button Content="🌐 Website"
                                Style="{DynamicResource LinkButtonStyle}"
                                Click="Website_Click"
                                HorizontalAlignment="Center"
                                Margin="0,4"/>
                        <Button Content="📧 Contact Support"
                                Style="{DynamicResource LinkButtonStyle}"
                                Click="Support_Click"
                                HorizontalAlignment="Center"
                                Margin="0,4"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            
            <!-- Footer -->
            <Border Grid.Row="2"
                    Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="0,0,12,12"
                    Padding="16,12">
                <Button Content="Close"
                        Click="Close_Click"
                        HorizontalAlignment="Center"
                        MinWidth="100"
                        Padding="16,8"
                        Style="{DynamicResource PrimaryButtonStyle}"/>
            </Border>
        </Grid>
    </Border>
</controls:BaseWindow>
