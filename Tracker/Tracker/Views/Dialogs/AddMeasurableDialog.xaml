<controls:BaseWindow x:Class="Tracker.Views.Dialogs.AddMeasurableDialog"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:controls="clr-namespace:Tracker.Controls"
                    xmlns:commands="clr-namespace:Tracker.Command"
                    xmlns:dialogViewModels="clr-namespace:Tracker.ViewModels.DialogViewModels"
                    xmlns:converters="clr-namespace:Tracker.Common.Converters"
                    mc:Ignorable="d"
                    Title="Add Measurable"
                    MouseDown="OnDragHandleMouseDown"
                    WindowStyle="None"
                    ResizeMode="CanResize"
                    Foreground="{DynamicResource ForegroundBrush}"
                    AllowsTransparency="True"
                    SizeToContent="WidthAndHeight"
                    Background="Transparent"
                    d:DataContext="{d:DesignInstance Type=dialogViewModels:MeasurableViewModel}"
                    MinWidth="480"
                    MinHeight="400"
                    AutomationProperties.Name="Add Measurable Dialog"
                    AutomationProperties.HelpText="Link a KPI or Project to a Key Result">
    <controls:BaseWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles/DialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </controls:BaseWindow.Resources>
    
    <Grid>
        <Border Background="{DynamicResource BackgroundBrush}"
                BorderThickness="1"
                BorderBrush="{DynamicResource BorderBrush}"
                CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Title Bar -->
                <Border Grid.Row="0" CornerRadius="12,12,0,0">
                    <controls:DialogTitleBar x:Name="TitleBar"
                                             DialogTitle="Link Measurable"
                                             IconData="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"
                                             CloseClicked="Close_Click"
                                             MinimizeClicked="Minimize_Click"
                                             MaximizeClicked="Maximize_Click"
                                             RestoreClicked="Restore_Click"/>
                </Border>
                
                <!-- Content Area -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,16,24,16">
                        
                        <!-- Type Selection -->
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Select Type" Style="{StaticResource FieldLabel}"/>
                            <UniformGrid Columns="2" Margin="0,8,0,0">
                                <RadioButton Content="KPI"
                                             IsChecked="{Binding IsKpiSelected}"
                                             GroupName="MeasurableType"
                                             Style="{StaticResource ModernRadioButtonStyle}"
                                             Margin="0,0,8,0"
                                             AutomationProperties.Name="KPI Type"
                                             TabIndex="1"/>
                                <RadioButton Content="Project"
                                             IsChecked="{Binding IsProjectSelected}"
                                             GroupName="MeasurableType"
                                             Style="{StaticResource ModernRadioButtonStyle}"
                                             AutomationProperties.Name="Project Type"
                                             TabIndex="2"/>
                            </UniformGrid>
                        </StackPanel>
                        
                        <!-- Available Items List -->
                        <StackPanel>
                            <TextBlock Text="Select Item" Style="{StaticResource FieldLabel}"/>
                            <Border Background="{DynamicResource SurfaceBrush}"
                                    CornerRadius="8"
                                    MinHeight="180"
                                    MaxHeight="250"
                                    Margin="0,8,0,0">
                                <Grid>
                                    <ListBox ItemsSource="{Binding CurrentItems}"
                                             SelectedItem="{Binding SelectedItem}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             AutomationProperties.Name="Available Items"
                                             TabIndex="4">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource BackgroundBrush}"
                                                        CornerRadius="6"
                                                        Padding="12,10"
                                                        Margin="8,4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="13"
                                                                       Foreground="{DynamicResource ForegroundBrush}"/>
                                                            <TextBlock Text="{Binding DisplayValue}"
                                                                       Foreground="{DynamicResource HintTextBrush}" 
                                                                       FontSize="11"
                                                                       Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                        
                                                        <StackPanel Grid.Column="1" 
                                                                    VerticalAlignment="Center"
                                                                    HorizontalAlignment="Right">
                                                            <TextBlock Text="{Binding Progress, StringFormat={}{0:N0}%}"
                                                                       FontWeight="Bold"
                                                                       FontSize="16"
                                                                       Foreground="{DynamicResource AccentBrush}"
                                                                       HorizontalAlignment="Right"/>
                                                            <TextBlock Text="progress"
                                                                       FontSize="9"
                                                                       Foreground="{DynamicResource HintTextBrush}"
                                                                       HorizontalAlignment="Right"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    
                                    <!-- Empty state -->
                                    <TextBlock Text="No items available"
                                               Foreground="{DynamicResource HintTextBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               Visibility="{Binding CurrentItems.Count, Converter={x:Static converters:ZeroToVisibilityConverter.Instance}}"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                        
                        <!-- Aggregation Type -->
                        <StackPanel Style="{StaticResource FormFieldGroup}" Margin="0,16,0,0">
                            <TextBlock Text="Aggregation" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding AggregationTypes}"
                                      SelectedItem="{Binding SelectedAggregationType}"
                                      DisplayMemberPath="Description"
                                      HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="Aggregation Type"
                                      TabIndex="5"/>
                            <TextBlock Text="How to combine this value with other measurables" 
                                       Style="{StaticResource FieldHint}"/>
                        </StackPanel>
                        
                    </StackPanel>
                </ScrollViewer>
                
                <!-- Footer with Buttons -->
                <Border Grid.Row="2" Style="{StaticResource DialogFooterStyle}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel"
                                Style="{StaticResource DialogSecondaryButtonStyle}"
                                Margin="0,0,12,0"
                                Command="{x:Static commands:DialogCommands.CloseDialogCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type controls:BaseWindow}}}"
                                AutomationProperties.Name="Cancel"
                                TabIndex="6"/>
                        <Button Content="Link Measurable"
                                Style="{StaticResource DialogPrimaryButtonStyle}"
                                Command="{Binding AddCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type controls:BaseWindow}}}"
                                AutomationProperties.Name="Link Measurable"
                                TabIndex="7"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</controls:BaseWindow>
