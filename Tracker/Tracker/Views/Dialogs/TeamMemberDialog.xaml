<controls:BaseWindow x:Class="Tracker.Views.Dialogs.TeamMemberDialog"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:local="clr-namespace:Tracker.Views.Dialogs"
                     xmlns:controls="clr-namespace:Tracker.Controls"
                     xmlns:languages="clr-namespace:Tracker.Resources.Languages"
                     xmlns:deenums="clr-namespace:DeepEndControls.Enums;assembly=DeepEndControls"
                     xmlns:dialogViewModels="clr-namespace:Tracker.ViewModels.DialogViewModels"
                     xmlns:converters="clr-namespace:Tracker.Common.Converters"
                     xmlns:commands="clr-namespace:Tracker.Command"
                     xmlns:customControls="clr-namespace:Tracker.Controls.CustomControls"
                     xmlns:help="clr-namespace:Tracker.Help.Attributes"
                     xmlns:attachedProperties="clr-namespace:Tracker.AttachedProperties"
                     mc:Ignorable="d"
                     MouseDown="OnDragHandleMouseDown"
                     WindowStyle="None"
                     ResizeMode="CanResize"
                     AllowsTransparency="True"
                     Background="Transparent"
                     MinHeight="715"
                     MinWidth="700"
                     SizeToContent="Width"
                     MaxWidth="1400"
                     Height="700"
                     d:DataContext="{d:DesignInstance Type=dialogViewModels:TeamMemberViewModel}"
                     AutomationProperties.Name="Team Member Dialog"
                     AutomationProperties.HelpText="Add or edit team member information">
    <controls:BaseWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles/DialogStyles.xaml"></ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </controls:BaseWindow.Resources>
    <Grid>
        <Border Background="{DynamicResource BackgroundBrush}"
                BorderThickness="1"
                BorderBrush="{DynamicResource BorderBrush}"
                CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="5" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0"
                        Height="Auto"
                        Background="{DynamicResource BackgroundBrush}"
                        CornerRadius="12,12,0,0">
                    <controls:DialogTitleBar x:Name="TitleBar"
                                             d:DialogTitle="Team Member"
                                             DialogTitle="{Binding InEditMode, Converter={x:Static converters:BoolToStringConverter.Instance}, ConverterParameter='Edit Team Member|New Team Member'}"
                                             IconData="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z"
                                             CloseClicked="Close_Click"
                                             MinimizeClicked="Minimize_Click"
                                             MaximizeClicked="Maximize_Click"
                                             RestoreClicked="Restore_Click" />
                </Border>
                <Grid Grid.Row="1"
                      Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition>
                            <ColumnDefinition.Style>
                                <Style TargetType="ColumnDefinition">
                                    <Setter Property="Width" Value="0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding InEditMode}" Value="True">
                                            <Setter Property="Width" Value="15"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ColumnDefinition.Style>
                        </ColumnDefinition>
                        <ColumnDefinition>
                            <ColumnDefinition.Style>
                                <Style TargetType="ColumnDefinition">
                                    <Setter Property="Width" Value="0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding InEditMode}" Value="True">
                                            <Setter Property="Width" Value="400"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ColumnDefinition.Style>
                        </ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <!--<controls:EditableContactCard Grid.Row="0" 
                                                  Grid.Column="0"/>-->
                    <Grid Grid.Row="0"
                          Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- Profile Photo with hover-to-edit -->
                        <Grid Width="100" Height="100"
                              HorizontalAlignment="Center"
                              Margin="0,10,0,10">
                            <!-- Profile image -->
                            <Ellipse Width="100"
                                     Height="100"
                                     Stroke="{DynamicResource ForegroundBrush}"
                                     StrokeThickness="2"
                                     SnapsToDevicePixels="True">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding ProfileImage}"
                                                RenderOptions.BitmapScalingMode="HighQuality"
                                                Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                            <!-- Edit overlay on hover -->
                            <Border x:Name="PhotoEditOverlay"
                                    Background="#80000000"
                                    CornerRadius="50"
                                    Opacity="0"
                                    Cursor="Hand"
                                    MouseEnter="PhotoOverlay_MouseEnter"
                                    MouseLeave="PhotoOverlay_MouseLeave"
                                    MouseDown="ChangePhoto_Click">
                                <Path Data="M3,17.25V21H6.75L17.81,9.94L14.06,6.19L3,17.25ZM20.71,7.04C21.1,6.65 21.1,6.02 20.71,5.63L18.37,3.29C17.98,2.9 17.35,2.9 16.96,3.29L15.13,5.12L18.88,8.87L20.71,7.04Z"
                                      Width="24" Height="24"
                                      Fill="White"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <Label Style="{StaticResource LabelStyle}"
                               Margin="0,0,0, 0"
                               Grid.Column="0"
                               Grid.Row="1"
                               Content="Details" />
                        <Grid Margin="10"
                              Visibility="{Binding ElementName=SaveInfoButton, Path=Visibility}"
                              Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition />
                            </Grid.RowDefinitions>

                            <customControls:TextBoxWithHint TextBoxType="Text"
                                                            Text="{Binding FirstName }"
                                                            HintText="{x:Static languages:Resources.Label_FirstName}"
                                                            Grid.Row="1"
                                                            Grid.Column="0" />
                            <customControls:TextBoxWithHint HintText="{x:Static languages:Resources.Label_LastName}"
                                                            TextBoxType="Text"
                                                            Text="{Binding LastName}"
                                                            Margin="0,5,0, 0"
                                                            Grid.Row="2"
                                                            Grid.Column="0" />
                            <customControls:TextBoxWithHint HintText="{x:Static languages:Resources.Label_Email}"
                                                            TextBoxType="Email"
                                                            Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                                            Margin="0,5,0, 0"
                                                            Grid.Row="3"
                                                            Grid.Column="0" />
                            <customControls:TextBoxWithHint HintText="{x:Static languages:Resources.Label_Cell}"
                                                            TextBoxType="Phone"
                                                            Text="{Binding CellPhone, UpdateSourceTrigger=PropertyChanged}"
                                                            Margin="0,5,0, 0"
                                                            Grid.Row="4"
                                                            Grid.Column="0" />
                            <customControls:TextBoxWithHint HintText="{x:Static languages:Resources.Label_JobTitle}"
                                                            TextBoxType="Text"
                                                            Text="{Binding JobTitle, UpdateSourceTrigger=PropertyChanged}"
                                                            Margin="0,5,0, 0"
                                                            Grid.Row="5"
                                                            Grid.Column="0" />
                            <customControls:TextBoxWithHint HintText="{x:Static languages:Resources.Label_NickName}"
                                                            TextBoxType="Text"
                                                            Text="{Binding NickName, UpdateSourceTrigger=PropertyChanged}"
                                                            Margin="0,5,0, 0"
                                                            Grid.Row="6"
                                                            Grid.Column="0" />
                            <Grid Grid.Row="7"
                                  Margin="0,5,0, 0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <DockPanel HorizontalAlignment="Stretch"
                                           LastChildFill="True">
                                    <Label Style="{StaticResource LabelStyle}"
                                           Margin="0,0,10,0"
                                           Content="{x:Static languages:Resources.Label_Role}" />
                                    <ComboBox HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding Roles}"
                                              SelectedItem="{Binding SelectedRole}"
                                              DisplayMemberPath="Description" />
                                </DockPanel>
                            </Grid>
                            <Grid Grid.Row="8"
                                  Margin="0,5,0, 0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <DockPanel HorizontalAlignment="Stretch"
                                           LastChildFill="True">
                                    <Label Style="{StaticResource LabelStyle}"
                                           Margin="0,0,10,0"
                                           Content="{x:Static languages:Resources.Label_Level}" />
                                    <ComboBox HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding Levels}"
                                              SelectedItem="{Binding SelectedLevel}"
                                              DisplayMemberPath="Description" />
                                </DockPanel>
                            </Grid>
                            <Grid Grid.Row="9"
                                  Margin="0,5,0, 0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <DockPanel HorizontalAlignment="Stretch"
                                           LastChildFill="True">
                                    <Label Style="{StaticResource LabelStyle}"
                                           Margin="0,0,10,0"
                                           Content="{x:Static languages:Resources.Label_Speciality}" />
                                    <ComboBox HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding Specialties}"
                                              SelectedItem="{Binding SelectedSpeciality}"
                                              DisplayMemberPath="Description" />
                                </DockPanel>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- COLUMN 2: Dates and Social -->
                    <Grid Grid.Row="0"
                          Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Label Style="{StaticResource LabelStyle}"
                               Grid.Row="0"
                               Margin="05,0,0, 0"
                               Grid.Column="0"
                               Content="{x:Static languages:Resources.Label_HireDate}" />
                        <customControls:TextBoxWithHint TextBoxType="LongDate"
                                                        Text="{Binding HireDateDisplay, UpdateSourceTrigger=PropertyChanged}"
                                                        Margin="05,0,0, 0"
                                                        Grid.Row="1"
                                                        Grid.ColumnSpan="2"
                                                        Grid.Column="0" />
                        <customControls:CalendarButton Grid.Column="2"
                                                       SelectedDate="{Binding HireDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                       Grid.Row="1" />
                        <Label Style="{StaticResource LabelStyle}"
                               Grid.Row="3"
                               Margin="05,05,0, 0"
                               Grid.Column="0"
                               Content="{x:Static languages:Resources.Label_Birthday}" />
                        <customControls:TextBoxWithHint TextBoxType="ShortDate"
                                                        Text="{Binding BirthDayDisplay, UpdateSourceTrigger=PropertyChanged}"
                                                        Margin="05,0,0, 0"
                                                        Grid.Row="4"
                                                        Grid.ColumnSpan="2"
                                                        Grid.Column="0" />
                        <customControls:CalendarButton Grid.Column="2"
                                                       SelectedDate="{Binding BirthDay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                       Grid.Row="4" />
                        <StackPanel Grid.Row="5"
                                    Grid.Column="0"
                                    Margin="5,05,0,0"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Grid.ColumnSpan="2">
                            <RadioButton x:Name="ActiveStatus"
                                         Style="{StaticResource RadioButtonStyle}"
                                         Content="Active"
                                         IsChecked="{Binding IsActive}"
                                         GroupName="Status"
                                         Margin="0,0,10,0" />
                            <RadioButton x:Name="InactiveStatus"
                                         Style="{StaticResource RadioButtonStyle}"
                                         Content="Inactive"
                                         GroupName="Status" />
                        </StackPanel>
                        <Label Style="{StaticResource LabelStyle}"
                               Visibility="{Binding ElementName=InactiveStatus, Path=IsChecked, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}"
                               Grid.Row="6"
                               Margin="05,05,0, 0"
                               Grid.Column="0"
                               Content="{x:Static languages:Resources.Label_TermDate}" />
                        <customControls:TextBoxWithHint TextBoxType="LongDate"
                                                        Text="{Binding TerminationDateDisplay, UpdateSourceTrigger=PropertyChanged}"
                                                        Margin="05,0,0, 0"
                                                        Grid.Row="7"
                                                        Grid.ColumnSpan="2"
                                                        Grid.Column="0"
                                                        Visibility="{Binding ElementName=InactiveStatus, Path=IsChecked, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}" />
                        <customControls:CalendarButton Grid.Column="2"
                                                       SelectedDate="{Binding TerminationDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                       Grid.Row="7"
                                                       Visibility="{Binding ElementName=InactiveStatus, Path=IsChecked, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}" />
                        <Label Style="{StaticResource LabelStyle}"
                               Grid.Row="8"
                               Grid.Column="0"
                               Grid.ColumnSpan="3"
                               Content="Social" />
                        <Grid Grid.Row="9"
                              Grid.Column="0"
                              Grid.ColumnSpan="3">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <customControls:SocialMediaLinkTextBoxControl Grid.Row="0"
                                                                          SocialHintText="{x:Static languages:Resources.Label_LinkIn}"
                                                                          SocialMediaType="LinkedIn"
                                                                          Text="{Binding LinkedInProfile, UpdateSourceTrigger=PropertyChanged}"
                                                                          Margin="0,5,0, 0"
                                                                          attachedProperties:TooltipProperties.Text="{x:Static languages:Resources.ToolTip_LinkedIn}"/>
                            <customControls:SocialMediaLinkTextBoxControl Grid.Row="1"
                                                                          SocialHintText="{x:Static languages:Resources.Label_Facebook}"
                                                                          SocialMediaType="Facebook"
                                                                          Text="{Binding FacebookProfile, UpdateSourceTrigger=PropertyChanged}"
                                                                          Margin="0,05,0, 0"
                                                                          attachedProperties:TooltipProperties.Text="View or edit Facebook profile link"/>
                            <customControls:SocialMediaLinkTextBoxControl Grid.Row="2"
                                                                          SocialHintText="{x:Static languages:Resources.HintText_Instagram}"
                                                                          SocialMediaType="Instagram"
                                                                          Text="{Binding InstagramProfile, UpdateSourceTrigger=PropertyChanged}"
                                                                          Margin="0,05,0, 0"
                                                                          attachedProperties:TooltipProperties.Text="View or edit Instagram profile link"/>
                            <customControls:SocialMediaLinkTextBoxControl Grid.Row="3"
                                                                          SocialHintText="{x:Static languages:Resources.HintText_XTwitter}"
                                                                          SocialMediaType="XTwitter"
                                                                          Text="{Binding XProfile, UpdateSourceTrigger=PropertyChanged}"
                                                                          Margin="0,05,0, 0"
                                                                          attachedProperties:TooltipProperties.Text="View or edit X/Twitter profile link"/>
                        </Grid>
                    </Grid>
                    
                    <!-- COLUMN 3: Team Member Data Tabs (far right) -->
                    <Grid Grid.Row="0"
                          Grid.Column="4"
                          Visibility="{Binding InEditMode, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}">
                        <TabControl Style="{StaticResource DialogTabControlStyle}">
                            <TabItem Header="Meetings" 
                                     Style="{StaticResource DialogTabItemStyle}"
                                     help:HelpProperties.TopicId="dialogs/add-team-member"
                                     help:HelpProperties.Section="meeting-history">
                                <controls:MeetingHistoryControl DataContext="{Binding}" MinHeight="400"/>
                            </TabItem>
                            <TabItem Header="Feedback" 
                                     Style="{StaticResource DialogTabItemStyle}"
                                     help:HelpProperties.TopicId="dialogs/add-team-member"
                                     help:HelpProperties.Section="feedback-history">
                                <controls:TeamMemberFeedbackControl DataContext="{Binding}" MinHeight="400"/>
                            </TabItem>
                            <TabItem Header="Goals" 
                                     Style="{StaticResource DialogTabItemStyle}"
                                     help:HelpProperties.TopicId="dialogs/add-team-member"
                                     help:HelpProperties.Section="goals-tab">
                                <controls:TeamMemberGoalsControl DataContext="{Binding}" MinHeight="400"/>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Grid>
                <!-- Footer -->
                <Border Grid.Row="2" 
                        Style="{StaticResource DialogFooterStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Left: Quick Message button (when M365 connected) -->
                        <Button Grid.Column="0"
                                Style="{StaticResource DialogSecondaryButtonStyle}"
                                Command="{Binding SendMessageCommand}"
                                ToolTip="Send a quick Teams message or email"
                                Visibility="{Binding CanShowMessaging, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}"
                                Padding="12,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💬" Margin="0,0,6,0"/>
                                <TextBlock Text="Send Message"/>
                            </StackPanel>
                        </Button>
                        
                        <!-- Right: Action buttons -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource DialogSecondaryButtonStyle}"
                                    Margin="0,0,12,0"
                                    Command="{x:Static commands:DialogCommands.CloseDialogCommand}"
                                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type controls:BaseWindow}}}"
                                    Content="Cancel"/>
                            <Button Style="{StaticResource DialogPrimaryButtonStyle}"
                                    Content="Add Team Member"
                                    Command="{Binding AddTeamMemberCommand}"
                                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type controls:BaseWindow}}}"
                                    Visibility="{Binding InEditMode, Converter={x:Static converters:ReverseBoolToVisConverter.Instance}}"/>
                            <Button Style="{StaticResource DialogPrimaryButtonStyle}"
                                    Content="Save Changes"
                                    Margin="10,0,0,0"
                                    Command="{Binding UpdateTeamMemberCommand}"
                                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type controls:BaseWindow}}}"
                                    Visibility="{Binding InEditMode, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</controls:BaseWindow>
