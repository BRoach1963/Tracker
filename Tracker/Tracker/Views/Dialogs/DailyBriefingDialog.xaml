<controls:BaseWindow x:Class="Tracker.Views.Dialogs.DailyBriefingDialog"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:controls="clr-namespace:Tracker.Controls"
                     xmlns:converters="clr-namespace:Tracker.Common.Converters"
                     xmlns:datamodels="clr-namespace:Tracker.DataModels"
                     WindowStyle="None"
                     AllowsTransparency="True"
                     Background="Transparent"
                     ShowInTaskbar="False"
                     ResizeMode="NoResize"
                     Width="520"
                     Height="600"
                     WindowStartupLocation="CenterOwner"
                     Title="Daily Briefing">
    
    <controls:BaseWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles.xaml"/>
                <ResourceDictionary Source="/Resources/Styles/DialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <converters:InsightSeverityToBrushConverter x:Key="SeverityToBrushConverter"/>
            
            <!-- Drop shadow effect -->
            <DropShadowEffect x:Key="DialogShadow" 
                              BlurRadius="30" 
                              ShadowDepth="6" 
                              Direction="270" 
                              Color="#000000" 
                              Opacity="0.5"/>
            
            <!-- Insight type icons -->
            <Geometry x:Key="MeetingIcon">M19,19H5V8H19M16,1V3H8V1H6V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3H18V1M17,12H12V17H17V12Z</Geometry>
            <Geometry x:Key="BirthdayIcon">M12,6A2,2 0 0,0 14,4A2,2 0 0,0 12,2A2,2 0 0,0 10,4A2,2 0 0,0 12,6M12,9A1,1 0 0,0 11,10V11H6V10A1,1 0 0,0 5,9A1,1 0 0,0 4,10V12H2V22H22V12H20V10A1,1 0 0,0 19,9A1,1 0 0,0 18,10V11H13V10A1,1 0 0,0 12,9Z</Geometry>
            <Geometry x:Key="TaskIcon">M19,3H14.82C14.4,1.84 13.3,1 12,1C10.7,1 9.6,1.84 9.18,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M12,3A1,1 0 0,1 13,4A1,1 0 0,1 12,5A1,1 0 0,1 11,4A1,1 0 0,1 12,3M7,7H17V5H19V19H5V5H7V7M7.5,13.5L9,12L11,14L15.5,9.5L17,11L11,17L7.5,13.5Z</Geometry>
            <Geometry x:Key="WarningIcon">M13 14H11V10H13M13 18H11V16H13M1 21H23L12 2L1 21Z</Geometry>
            
            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                <Setter Property="Margin" Value="0,16,0,8"/>
            </Style>
            
            <Style x:Key="InsightItemStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                <Setter Property="BorderThickness" Value="3,0,0,0"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Padding" Value="12,10"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>
        </ResourceDictionary>
    </controls:BaseWindow.Resources>
    
    <Border Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource AccentBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Effect="{StaticResource DialogShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Header -->
            <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="12,12,0,0">
                <Grid Margin="24,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Sun icon -->
                    <Viewbox Grid.Column="0" Width="40" Height="40" Margin="0,0,16,0">
                        <Path Data="M12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,2L14.39,5.42C13.65,5.15 12.84,5 12,5C11.16,5 10.35,5.15 9.61,5.42L12,2M3.34,7L7.5,6.65C6.9,7.16 6.36,7.78 5.94,8.5C5.5,9.24 5.25,10 5.11,10.79L3.34,7M3.36,17L5.12,13.23C5.26,14 5.53,14.78 5.95,15.5C6.37,16.24 6.91,16.86 7.5,17.37L3.36,17M20.65,7L18.88,10.79C18.74,10 18.47,9.23 18.05,8.5C17.63,7.78 17.1,7.15 16.5,6.64L20.65,7M20.64,17L16.5,17.36C17.09,16.85 17.62,16.22 18.04,15.5C18.46,14.77 18.73,14 18.87,13.21L20.64,17M12,22L9.59,18.56C10.33,18.83 11.14,19 12,19C12.82,19 13.63,18.83 14.37,18.56L12,22Z"
                              Fill="{DynamicResource AccentBrush}"
                              Stretch="Uniform"/>
                    </Viewbox>
                    
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Good Morning!" FontSize="22" FontWeight="Bold" 
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                        <TextBlock x:Name="DateText" Text="Saturday, December 28" FontSize="13"
                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    
                    <!-- Close button -->
                    <Button Grid.Column="2" Width="32" Height="32" 
                            Click="CloseButton_Click"
                            ToolTip="Close"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Background="Transparent" BorderThickness="0">
                        <Path Width="12" Height="12" Stretch="Uniform"
                              Fill="{DynamicResource SecondaryTextBrush}"
                              Data="M19,6.41L17.59,5 12,10.59 6.41,5 5,6.41 10.59,12 5,17.59 6.41,19 12,13.41 17.59,19 19,17.59 13.41,12z"/>
                    </Button>
                </Grid>
            </Border>
            
            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,0">
                <StackPanel>
                    <!-- Summary Stats -->
                    <Grid Margin="0,16,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" 
                                CornerRadius="8" Padding="12" Margin="0,0,6,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="MeetingsCountText" Text="0" FontSize="28" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Meetings Today" FontSize="11" 
                                           Foreground="{DynamicResource HintTextBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        
                        <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" 
                                CornerRadius="8" Padding="12" Margin="3,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="TasksCountText" Text="0" FontSize="28" FontWeight="Bold"
                                           Foreground="#FF9800" HorizontalAlignment="Center"/>
                                <TextBlock Text="Open Tasks" FontSize="11" 
                                           Foreground="{DynamicResource HintTextBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        
                        <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" 
                                CornerRadius="8" Padding="12" Margin="6,0,0,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="InsightsCountText" Text="0" FontSize="28" FontWeight="Bold"
                                           Foreground="#F44336" HorizontalAlignment="Center"/>
                                <TextBlock Text="Insights" FontSize="11" 
                                           Foreground="{DynamicResource HintTextBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    
                    <!-- Critical Insights Section -->
                    <TextBlock x:Name="CriticalHeader" Text="⚠️ Needs Attention" 
                               Style="{StaticResource SectionHeaderStyle}"
                               Visibility="Collapsed"/>
                    <ItemsControl x:Name="CriticalInsightsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type datamodels:Insight}">
                                <Border Style="{StaticResource InsightItemStyle}"
                                        BorderBrush="#F44336">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <Ellipse Grid.Column="0" Width="8" Height="8" 
                                                 Fill="#F44336" Margin="0,4,10,0" VerticalAlignment="Top"/>
                                        
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                                                       Foreground="{DynamicResource ForegroundBrush}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Description}" FontSize="12"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap" Margin="0,2,0,0"
                                                       MaxHeight="36" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    
                    <!-- Warnings Section -->
                    <TextBlock x:Name="WarningsHeader" Text="📋 Reminders" 
                               Style="{StaticResource SectionHeaderStyle}"
                               Visibility="Collapsed"/>
                    <ItemsControl x:Name="WarningInsightsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type datamodels:Insight}">
                                <Border Style="{StaticResource InsightItemStyle}"
                                        BorderBrush="#FF9800">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <Ellipse Grid.Column="0" Width="8" Height="8" 
                                                 Fill="#FF9800" Margin="0,4,10,0" VerticalAlignment="Top"/>
                                        
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                                                       Foreground="{DynamicResource ForegroundBrush}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Description}" FontSize="12"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap" Margin="0,2,0,0"
                                                       MaxHeight="36" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    
                    <!-- Info Section -->
                    <TextBlock x:Name="InfoHeader" Text="💡 Good to Know" 
                               Style="{StaticResource SectionHeaderStyle}"
                               Visibility="Collapsed"/>
                    <ItemsControl x:Name="InfoInsightsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type datamodels:Insight}">
                                <Border Style="{StaticResource InsightItemStyle}"
                                        BorderBrush="#2196F3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <Ellipse Grid.Column="0" Width="8" Height="8" 
                                                 Fill="#2196F3" Margin="0,4,10,0" VerticalAlignment="Top"/>
                                        
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                                                       Foreground="{DynamicResource ForegroundBrush}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Description}" FontSize="12"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap" Margin="0,2,0,0"
                                                       MaxHeight="36" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    
                    <!-- Empty state -->
                    <StackPanel x:Name="EmptyState" Visibility="Collapsed" 
                                HorizontalAlignment="Center" Margin="0,40,0,0">
                        <Path Width="48" Height="48" Stretch="Uniform" HorizontalAlignment="Center"
                              Fill="{DynamicResource HintTextBrush}"
                              Data="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4M11,16.5L6.5,12L7.91,10.59L11,13.67L16.59,8.09L18,9.5L11,16.5Z"/>
                        <TextBlock Text="All Clear!" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   HorizontalAlignment="Center" Margin="0,16,0,4"/>
                        <TextBlock Text="No insights or tasks requiring attention" FontSize="13"
                                   Foreground="{DynamicResource HintTextBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                    
                    <Border Height="20"/>
                </StackPanel>
            </ScrollViewer>
            
            <!-- Footer -->
            <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" 
                    CornerRadius="0,0,12,12" Padding="24,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <CheckBox x:Name="DontShowAgainCheckBox" 
                              Content="Don't show on startup"
                              Foreground="{DynamicResource SecondaryTextBrush}"
                              VerticalAlignment="Center"/>
                    
                    <Button Grid.Column="1" Content="Let's Go!" 
                            Click="CloseButton_Click"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Width="120"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</controls:BaseWindow>
