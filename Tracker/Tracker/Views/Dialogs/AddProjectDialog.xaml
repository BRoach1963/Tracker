<controls:BaseWindow x:Class="Tracker.Views.Dialogs.AddProjectDialog"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:controls="clr-namespace:Tracker.Controls"
                    xmlns:languages="clr-namespace:Tracker.Resources.Languages"
                    xmlns:commands="clr-namespace:Tracker.Command"
                    xmlns:dialogViewModels="clr-namespace:Tracker.ViewModels.DialogViewModels"
                    xmlns:converters="clr-namespace:Tracker.Common.Converters"
                    xmlns:customControls="clr-namespace:Tracker.Controls.CustomControls"
                    mc:Ignorable="d"
                    Title="Add Project"
                    MouseDown="OnDragHandleMouseDown"
                    WindowStyle="None"
                    ResizeMode="CanResize"
                    Foreground="{DynamicResource ForegroundBrush}"
                    AllowsTransparency="True"
                    SizeToContent="WidthAndHeight"
                    Background="Transparent"
                    d:DataContext="{d:DesignInstance Type=dialogViewModels:NewProjectViewModel}"
                    MinWidth="600"
                    MinHeight="520"
                    AutomationProperties.Name="Add Project Dialog"
                    AutomationProperties.HelpText="Create a new project">
    <controls:BaseWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles/DialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </controls:BaseWindow.Resources>
    
    <Grid>
        <Border Background="{DynamicResource BackgroundBrush}"
                BorderThickness="1"
                BorderBrush="{DynamicResource BorderBrush}"
                CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Title Bar -->
                <Border Grid.Row="0" CornerRadius="12,12,0,0">
                    <controls:DialogTitleBar x:Name="TitleBar"
                                             DialogTitle="{x:Static languages:Resources.Add_Project}"
                                             IconData="M12.6,2.86C15.27,4.1 18,5.39 20.66,6.63C20.81,6.7 21,6.75 21,6.95C21,7.15 20.81,7.19 20.66,7.26C18,8.5 15.3,9.77 12.62,11C12.21,11.21 11.79,11.21 11.38,11C8.69,9.76 6,8.5 3.32,7.25C3.18,7.19 3,7.14 3,6.94C3,6.76 3.18,6.71 3.31,6.65C6,5.39 8.74,4.1 11.44,2.85C11.73,2.72 12.3,2.73 12.6,2.86Z"
                                             CloseClicked="Close_Click"
                                             MinimizeClicked="Minimize_Click"
                                             MaximizeClicked="Maximize_Click"
                                             RestoreClicked="Restore_Click"/>
                </Border>
                
                <!-- Content Area -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Grid Margin="24,16,24,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Left Column -->
                        <StackPanel Grid.Column="0">
                            
                            <!-- Project Name -->
                            <StackPanel Style="{StaticResource FormFieldGroup}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Project Name" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Style="{StaticResource RequiredIndicator}"/>
                                </StackPanel>
                                <customControls:TextBoxWithHint TextBoxType="Text"
                                                                HintText="Enter project name"
                                                                Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            
                            <!-- Owner -->
                            <StackPanel Style="{StaticResource FormFieldGroup}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Project Owner" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Style="{StaticResource RequiredIndicator}"/>
                                </StackPanel>
                                <ComboBox ItemsSource="{Binding TeamMembers}"
                                          SelectedItem="{Binding SelectedOwner}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Grid Width="24" Height="24" Margin="0,0,8,0">
                                                    <Ellipse Fill="{DynamicResource AccentBrush}"/>
                                                    <TextBlock Text="{Binding Initials}" 
                                                               FontSize="9" FontWeight="Bold"
                                                               Foreground="{DynamicResource BackgroundBrush}"
                                                               HorizontalAlignment="Center" 
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                                <TextBlock VerticalAlignment="Center">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0} {1}">
                                                            <Binding Path="FirstName"/>
                                                            <Binding Path="LastName"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            
                            <!-- Status -->
                            <StackPanel Style="{StaticResource FormFieldGroup}">
                                <TextBlock Text="Status" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding StatusOptions}"
                                          SelectedItem="{Binding SelectedStatus}"
                                          HorizontalAlignment="Stretch"/>
                            </StackPanel>
                            
                            <!-- Budget -->
                            <StackPanel Style="{StaticResource FormFieldGroup}">
                                <TextBlock Text="Budget" Style="{StaticResource FieldLabel}"/>
                                <customControls:TextBoxWithHint TextBoxType="Text"
                                                                HintText="0.00"
                                                                Text="{Binding Budget, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"/>
                            </StackPanel>
                            
                            <!-- Description -->
                            <StackPanel>
                                <customControls:TextBoxWithHint TextBoxType="Text"
                                                                HintText="Describe the project goals and scope..."
                                                                Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                                                AcceptsReturn="True"
                                                                TextWrapping="Wrap"
                                                                VerticalScrollBarVisibility="Auto"
                                                                MinHeight="100"/>
                            </StackPanel>
                            
                        </StackPanel>
                        
                        <!-- Right Column -->
                        <StackPanel Grid.Column="2">
                            
                            <!-- Start Date -->
                            <StackPanel Style="{StaticResource FormFieldGroup}">
                                <TextBlock Text="Start Date" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <customControls:TextBoxWithHint TextBoxType="LongDate"
                                                                    HintText="MM/DD/YYYY"
                                                                    Text="{Binding StartDateDisplay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <customControls:CalendarButton SelectedDate="{Binding StartDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                   Grid.Column="1"
                                                                   Margin="8,0,0,0"/>
                                </Grid>
                            </StackPanel>
                            
                            <!-- End Date -->
                            <StackPanel Style="{StaticResource FormFieldGroup}">
                                <TextBlock Text="End Date" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <customControls:TextBoxWithHint TextBoxType="LongDate"
                                                                    HintText="MM/DD/YYYY"
                                                                    Text="{Binding EndDateDisplay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <customControls:CalendarButton SelectedDate="{Binding EndDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                   Grid.Column="1"
                                                                   Margin="8,0,0,0"/>
                                </Grid>
                            </StackPanel>
                            
                            <!-- Team Members -->
                            <StackPanel>
                                <TextBlock Text="Team Members" Style="{StaticResource FieldLabel}"/>
                                <Border Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        MinHeight="180"
                                        MaxHeight="220">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding TeamMembers}" Margin="8">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Style="{StaticResource ModernCheckBoxStyle}" Margin="0,4">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Grid Width="24" Height="24" Margin="0,0,8,0">
                                                                <Ellipse Fill="{DynamicResource AccentBrush}"/>
                                                                <TextBlock Text="{Binding Initials}" 
                                                                           FontSize="9" FontWeight="Bold"
                                                                           Foreground="{DynamicResource BackgroundBrush}"
                                                                           HorizontalAlignment="Center" 
                                                                           VerticalAlignment="Center"/>
                                                            </Grid>
                                                            <TextBlock VerticalAlignment="Center">
                                                                <TextBlock.Text>
                                                                    <MultiBinding StringFormat="{}{0} {1}">
                                                                        <Binding Path="FirstName"/>
                                                                        <Binding Path="LastName"/>
                                                                    </MultiBinding>
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                            
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
                
                <!-- Footer with Buttons -->
                <Border Grid.Row="2" Style="{StaticResource DialogFooterStyle}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel"
                                Style="{StaticResource DialogSecondaryButtonStyle}"
                                Margin="0,0,12,0"
                                Command="{x:Static commands:DialogCommands.CloseDialogCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type controls:BaseWindow}}}"/>
                        <Button Content="Create Project"
                                Style="{StaticResource DialogPrimaryButtonStyle}"
                                Command="{Binding AddProjectCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type controls:BaseWindow}}}"
                                Visibility="{Binding InEditMode, Converter={x:Static converters:ReverseBoolToVisConverter.Instance}}"/>
                        <Button Content="Save Changes"
                                Style="{StaticResource DialogPrimaryButtonStyle}"
                                Command="{Binding UpdateProjectCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type controls:BaseWindow}}}"
                                Visibility="{Binding InEditMode, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</controls:BaseWindow>
