<Window x:Class="Tracker.Views.Dialogs.PurchaseCreditsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Purchase AI Credits" 
        Height="480" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="SingleBorderWindow"
        Background="{DynamicResource BackgroundBrush}">
    
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Purchase AI Credits" 
                       FontSize="20" 
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}"/>
            <TextBlock Text="Select a credit pack to continue using Oracle"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Margin="0,4,0,0"/>
        </StackPanel>
        
        <!-- Credit Pack Options -->
        <StackPanel Grid.Row="1" VerticalAlignment="Top">
            
            <!-- Starter Pack -->
            <Border x:Name="StarterPackBorder"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,12"
                    Cursor="Hand"
                    MouseLeftButtonDown="StarterPack_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Starter Pack" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="50 credits" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Text="~10 days of light use" FontSize="11" Foreground="{DynamicResource HintTextBrush}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="$1.49" FontSize="18" FontWeight="Bold" 
                               VerticalAlignment="Center" Foreground="{DynamicResource PrimaryBrush}"/>
                </Grid>
            </Border>
            
            <!-- Value Pack (Best Value) -->
            <Border x:Name="ValuePackBorder"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource PrimaryBrush}"
                    BorderThickness="2"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,12"
                    Cursor="Hand"
                    MouseLeftButtonDown="ValuePack_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Value Pack" FontWeight="SemiBold" FontSize="14"/>
                            <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                <TextBlock Text="BEST VALUE" FontSize="10" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="250 credits" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Text="~7 weeks of typical use" FontSize="11" Foreground="{DynamicResource HintTextBrush}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="$5.99" FontSize="18" FontWeight="Bold" 
                               VerticalAlignment="Center" Foreground="{DynamicResource PrimaryBrush}"/>
                </Grid>
            </Border>
            
            <!-- Power User Pack -->
            <Border x:Name="PowerPackBorder"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,12"
                    Cursor="Hand"
                    MouseLeftButtonDown="PowerPack_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Power User Pack" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="1,000 credits" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Text="~6-7 months of typical use" FontSize="11" Foreground="{DynamicResource HintTextBrush}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="$19.99" FontSize="18" FontWeight="Bold" 
                               VerticalAlignment="Center" Foreground="{DynamicResource PrimaryBrush}"/>
                </Grid>
            </Border>
            
            <!-- Info -->
            <TextBlock Text="💡 Purchased credits never expire and are used only after your monthly allowance is exhausted."
                       TextWrapping="Wrap"
                       FontSize="11"
                       Foreground="{DynamicResource HintTextBrush}"
                       Margin="0,8,0,0"/>
            
        </StackPanel>
        
        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" 
                    Style="{StaticResource SecondaryButtonStyle}"
                    Width="80"
                    Click="Cancel_Click"
                    Margin="0,0,8,0"/>
            <Button x:Name="PurchaseButton"
                    Content="Purchase" 
                    Style="{StaticResource PrimaryButtonStyle}"
                    Width="100"
                    Click="Purchase_Click"
                    IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Window>
