<Window x:Class="Tracker.Views.Dialogs.PerformanceReviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:controls="clr-namespace:Tracker.Controls.CustomControls"
        xmlns:converters="clr-namespace:Tracker.Common.Converters"
        mc:Ignorable="d"
        Title="Performance Review"
        Width="900" Height="700"
        MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Style="{StaticResource ModernDialogStyle}">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        
        <!-- Section Card Style -->
        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        
        <!-- Question Card Style -->
        <Style x:Key="QuestionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- HEADER -->
        <Border Background="{DynamicResource SurfaceBrush}" Padding="24,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel>
                    <TextBlock Text="{Binding RevieweeName}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}"/>
                    <TextBlock Text="{Binding CycleName}" FontSize="14" Foreground="{DynamicResource HintTextBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                
                <!-- Progress Ring -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <controls:ProgressRing Value="{Binding CompletedQuestions}" 
                                          Maximum="{Binding TotalQuestions}"
                                          Size="50" StrokeWidth="5"
                                          ShowPercent="False"
                                          ProgressColor="{DynamicResource AccentBrush}"/>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="12" Foreground="{DynamicResource HintTextBrush}">
                            <Run Text="{Binding CompletedQuestions, Mode=OneWay}"/>
                            <Run Text="/"/>
                            <Run Text="{Binding TotalQuestions, Mode=OneWay}"/>
                            <Run Text=" answered"/>
                        </TextBlock>
                        <TextBlock Text="{Binding CurrentSectionName}" FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- MAIN CONTENT - Sections and Questions -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
            <ItemsControl ItemsSource="{Binding Sections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource SectionCardStyle}">
                            <StackPanel>
                                <!-- Section Header -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Section Number Badge -->
                                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="12" 
                                            Width="24" Height="24" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding SectionNumber}" 
                                                   FontSize="12" FontWeight="Bold"
                                                   Foreground="{DynamicResource BackgroundBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}"/>
                                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource HintTextBrush}" 
                                                   TextWrapping="Wrap" Margin="0,4,0,0"
                                                   Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </StackPanel>
                                    
                                    <!-- Section Progress -->
                                    <TextBlock Grid.Column="2" FontSize="12" Foreground="{DynamicResource HintTextBrush}" VerticalAlignment="Center">
                                        <Run Text="{Binding AnsweredCount, Mode=OneWay}"/>
                                        <Run Text="/"/>
                                        <Run Text="{Binding QuestionCount, Mode=OneWay}"/>
                                    </TextBlock>
                                </Grid>
                                
                                <!-- Questions -->
                                <ItemsControl ItemsSource="{Binding Questions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource QuestionCardStyle}">
                                                <StackPanel>
                                                    <!-- Question Text -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                        <TextBlock Text="{Binding Text}" FontSize="14" 
                                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                                   TextWrapping="Wrap"/>
                                                        <TextBlock Text=" *" FontSize="14" Foreground="{DynamicResource DangerBrush}"
                                                                   Visibility="{Binding IsRequired, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    </StackPanel>
                                                    
                                                    <!-- Answer Input - Based on QuestionType -->
                                                    <ContentControl Content="{Binding}">
                                                        <ContentControl.Style>
                                                            <Style TargetType="ContentControl">
                                                                <Style.Triggers>
                                                                    <!-- Long Text -->
                                                                    <DataTrigger Binding="{Binding QuestionType}" Value="LongText">
                                                                        <Setter Property="ContentTemplate">
                                                                            <Setter.Value>
                                                                                <DataTemplate>
                                                                                    <TextBox Text="{Binding Answer, UpdateSourceTrigger=PropertyChanged}"
                                                                                             AcceptsReturn="True" TextWrapping="Wrap"
                                                                                             MinHeight="100" MaxHeight="200"
                                                                                             VerticalScrollBarVisibility="Auto"
                                                                                             Style="{StaticResource ModernTextBoxStyle}"/>
                                                                                </DataTemplate>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </DataTrigger>
                                                                    
                                                                    <!-- Short Text -->
                                                                    <DataTrigger Binding="{Binding QuestionType}" Value="ShortText">
                                                                        <Setter Property="ContentTemplate">
                                                                            <Setter.Value>
                                                                                <DataTemplate>
                                                                                    <TextBox Text="{Binding Answer, UpdateSourceTrigger=PropertyChanged}"
                                                                                             MaxLength="500"
                                                                                             Style="{StaticResource ModernTextBoxStyle}"/>
                                                                                </DataTemplate>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </DataTrigger>
                                                                    
                                                                    <!-- Rating -->
                                                                    <DataTrigger Binding="{Binding QuestionType}" Value="Rating">
                                                                        <Setter Property="ContentTemplate">
                                                                            <Setter.Value>
                                                                                <DataTemplate>
                                                                                    <controls:StarRating Value="{Binding RatingValue, Mode=TwoWay}"/>
                                                                                </DataTemplate>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </DataTrigger>
                                                                    
                                                                    <!-- Yes/No -->
                                                                    <DataTrigger Binding="{Binding QuestionType}" Value="YesNo">
                                                                        <Setter Property="ContentTemplate">
                                                                            <Setter.Value>
                                                                                <DataTemplate>
                                                                                    <StackPanel Orientation="Horizontal">
                                                                                        <RadioButton Content="Yes" GroupName="{Binding QuestionId}"
                                                                                                     IsChecked="{Binding IsYes}" Margin="0,0,20,0"/>
                                                                                        <RadioButton Content="No" GroupName="{Binding QuestionId}"
                                                                                                     IsChecked="{Binding IsNo}"/>
                                                                                    </StackPanel>
                                                                                </DataTemplate>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ContentControl.Style>
                                                    </ContentControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        
        <!-- FOOTER -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Auto-save indicator -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M17,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3M19,19H5V5H16.17L19,7.83V19M12,12C10.34,12 9,13.34 9,15S10.34,18 12,18S15,16.66 15,15S13.66,12 12,12M6,6H15V10H6V6Z"
                          Width="14" Height="14" Stretch="Uniform"
                          Fill="{DynamicResource HintTextBrush}" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding SaveStatus}" FontSize="12" Foreground="{DynamicResource HintTextBrush}"/>
                </StackPanel>
                
                <!-- Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Command="{Binding SaveDraftCommand}" Content="Save Draft" 
                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,12,0"/>
                    <Button Command="{Binding SubmitCommand}" Content="Submit Review"
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsEnabled="{Binding CanSubmit}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
