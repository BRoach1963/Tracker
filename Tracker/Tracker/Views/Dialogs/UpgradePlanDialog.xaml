<controls:BaseWindow x:Class="Tracker.Views.Dialogs.UpgradePlanDialog"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Tracker.Controls"
                    Title="Upgrade Your Plan"
                    Height="620" Width="700"
                    WindowStyle="None"
                    AllowsTransparency="True"
                    ResizeMode="NoResize"
                    WindowStartupLocation="CenterOwner"
                    Background="Transparent">
    
    <Border Background="{DynamicResource BackgroundBrush}"
            BorderThickness="1"
            BorderBrush="{DynamicResource BorderBrush}"
            CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Title Bar -->
            <controls:DialogTitleBar Grid.Row="0"
                                     DialogTitle="Choose Your Plan"
                                     IconData="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M11,16.5L18,9.5L16.59,8.09L11,13.67L7.91,10.59L6.5,12L11,16.5Z"
                                     ToolBarStyle="CloseOnly"
                                     CloseClicked="Close_Click"/>
            
            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16">
                <StackPanel>
                    
                    <!-- Billing Toggle -->
                    <Border Background="{DynamicResource SurfaceBrush}"
                            CornerRadius="8"
                            Padding="8"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,24">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="MonthlyToggle"
                                         Content="Monthly"
                                         GroupName="BillingCadence"
                                         IsChecked="True"
                                         Style="{StaticResource ToggleRadioButtonStyle}"
                                         Checked="BillingToggle_Changed"/>
                            <RadioButton x:Name="AnnualToggle"
                                         Content="Annual"
                                         GroupName="BillingCadence"
                                         Style="{StaticResource ToggleRadioButtonStyle}"
                                         Checked="BillingToggle_Changed"
                                         Margin="8,0,0,0"/>
                            <Border Background="{DynamicResource AccentBrush}"
                                    CornerRadius="4"
                                    Padding="8,4"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="Save 17%"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource BackgroundBrush}"/>
                            </Border>
                        </StackPanel>
                    </Border>
                    
                    <!-- Plan Cards -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Standard Plan -->
                        <Border x:Name="StandardCard"
                                Grid.Column="0"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="2"
                                CornerRadius="12"
                                Padding="20"
                                Cursor="Hand"
                                MouseDown="StandardCard_Click">
                            <StackPanel>
                                <TextBlock Text="Standard"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource ForegroundBrush}"/>
                                <TextBlock Text="For growing teams"
                                           FontSize="12"
                                           Foreground="{DynamicResource HintTextBrush}"
                                           Margin="0,4,0,16"/>
                                
                                <!-- Price -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock x:Name="StandardPrice"
                                               Text="$9.99"
                                               FontSize="32"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBlock x:Name="StandardPeriod"
                                               Text="/mo"
                                               FontSize="14"
                                               Foreground="{DynamicResource HintTextBrush}"
                                               VerticalAlignment="Bottom"
                                               Margin="4,0,0,6"/>
                                </StackPanel>
                                <TextBlock x:Name="StandardEffective"
                                           Text=""
                                           FontSize="11"
                                           Foreground="{DynamicResource HintTextBrush}"
                                           Margin="0,0,0,16"
                                           Visibility="Collapsed"/>
                                
                                <!-- Features -->
                                <StackPanel Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <Path Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"
                                              Width="14" Height="14" Stretch="Uniform"
                                              Fill="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                                        <TextBlock Text="Up to 10 team members" FontSize="12" Foreground="{DynamicResource ForegroundBrush}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <Path Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"
                                              Width="14" Height="14" Stretch="Uniform"
                                              Fill="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                                        <TextBlock Text="Unlimited 1:1s &amp; tasks" FontSize="12" Foreground="{DynamicResource ForegroundBrush}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <Path Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"
                                              Width="14" Height="14" Stretch="Uniform"
                                              Fill="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                                        <TextBlock Text="Calendar sync" FontSize="12" Foreground="{DynamicResource ForegroundBrush}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <Path Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"
                                              Width="14" Height="14" Stretch="Uniform"
                                              Fill="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                                        <TextBlock Text="Basic reports" FontSize="12" Foreground="{DynamicResource ForegroundBrush}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <Path Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"
                                              Width="14" Height="14" Stretch="Uniform"
                                              Fill="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                                        <TextBlock Text="Email support" FontSize="12" Foreground="{DynamicResource ForegroundBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                                
                                <!-- Select Button -->
                                <Button x:Name="StandardButton"
                                        Content="Select Standard"
                                        Margin="0,20,0,0"
                                        Padding="0,12"
                                        Click="SelectStandard_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{DynamicResource SurfaceBrush}"
                                                    BorderBrush="{DynamicResource AccentBrush}"
                                                    BorderThickness="2"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Border>
                        
                        <!-- Pro Plan -->
                        <Border x:Name="ProCard"
                                Grid.Column="2"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="2"
                                CornerRadius="12"
                                Padding="20"
                                Cursor="Hand"
                                MouseDown="ProCard_Click">
                            <Grid>
                                <StackPanel>
                                    <!-- Popular Badge -->
                                    <Border Background="{DynamicResource AccentBrush}"
                                            CornerRadius="4"
                                            Padding="8,4"
                                            HorizontalAlignment="Left"
                                            Margin="0,0,0,8">
                                        <TextBlock Text="MOST POPULAR"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource BackgroundBrush}"/>
                                    </Border>
                                    
                                    <TextBlock Text="Pro"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBlock Text="For serious leaders"
                                               FontSize="12"
                                               Foreground="{DynamicResource HintTextBrush}"
                                               Margin="0,4,0,16"/>
                                    
                                    <!-- Price -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock x:Name="ProPrice"
                                                   Text="$19.99"
                                                   FontSize="32"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource ForegroundBrush}"/>
                                        <TextBlock x:Name="ProPeriod"
                                                   Text="/mo"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource HintTextBrush}"
                                                   VerticalAlignment="Bottom"
                                                   Margin="4,0,0,6"/>
                                    </StackPanel>
                                    <TextBlock x:Name="ProEffective"
                                               Text=""
                                               FontSize="11"
                                               Foreground="{DynamicResource HintTextBrush}"
                                               Margin="0,0,0,16"
                                               Visibility="Collapsed"/>
                                    
                                    <!-- Features -->
                                    <StackPanel Margin="0,8,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,4">
                                            <Path Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"
                                                  Width="14" Height="14" Stretch="Uniform"
                                                  Fill="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                                            <TextBlock Text="Unlimited team members" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4">
                                            <Path Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"
                                                  Width="14" Height="14" Stretch="Uniform"
                                                  Fill="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                                            <TextBlock Text="All Standard features" FontSize="12" Foreground="{DynamicResource ForegroundBrush}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4">
                                            <Path Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"
                                                  Width="14" Height="14" Stretch="Uniform"
                                                  Fill="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                                            <TextBlock Text="AI Assistant &amp; insights" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4">
                                            <Path Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"
                                                  Width="14" Height="14" Stretch="Uniform"
                                                  Fill="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                                            <TextBlock Text="Advanced reports" FontSize="12" Foreground="{DynamicResource ForegroundBrush}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4">
                                            <Path Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"
                                                  Width="14" Height="14" Stretch="Uniform"
                                                  Fill="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                                            <TextBlock Text="Priority support" FontSize="12" Foreground="{DynamicResource ForegroundBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    
                                    <!-- Select Button -->
                                    <Button x:Name="ProButton"
                                            Content="Select Pro"
                                            Margin="0,20,0,0"
                                            Padding="0,12"
                                            Click="SelectPro_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{DynamicResource AccentBrush}"
                                                        CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Button.Foreground>
                                            <SolidColorBrush Color="White"/>
                                        </Button.Foreground>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                    
                    <!-- Current Plan Notice -->
                    <TextBlock x:Name="CurrentPlanNotice"
                               Text=""
                               FontSize="12"
                               Foreground="{DynamicResource HintTextBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,20,0,0"
                               TextWrapping="Wrap"/>
                    
                </StackPanel>
            </ScrollViewer>
            
            <!-- Footer -->
            <Border Grid.Row="2"
                    Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="0,0,12,12"
                    Padding="24,16">
                <Grid>
                    <TextBlock Text="Questions? Contact support@pricklycactus.com"
                               FontSize="11"
                               Foreground="{DynamicResource HintTextBrush}"
                               VerticalAlignment="Center"/>
                    <Button Content="Maybe Later"
                            HorizontalAlignment="Right"
                            Padding="16,8"
                            Click="Close_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</controls:BaseWindow>


