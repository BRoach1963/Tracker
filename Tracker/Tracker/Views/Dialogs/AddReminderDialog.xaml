<Window x:Class="Tracker.Views.Dialogs.AddReminderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Tracker.Controls"
        xmlns:converters="clr-namespace:Tracker.Common.Converters"
        xmlns:customControls="clr-namespace:Tracker.Controls.CustomControls"
        Title="Add Reminder"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterOwner"
        Width="480"
        Height="480"
        MinWidth="420"
        MinHeight="400">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles/DialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        </ResourceDictionary>
    </Window.Resources>
    
    <Border Background="{DynamicResource BackgroundBrush}" 
            BorderBrush="{DynamicResource BorderBrush}" 
            BorderThickness="1" 
            CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Title Bar -->
            <Border Grid.Row="0" 
                    Background="{DynamicResource BackgroundBrush}" 
                    CornerRadius="12,12,0,0" 
                    Padding="20,16"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22C6.47,22 2,17.5 2,12A10,10 0 0,1 12,2M12.5,7V12.25L17,14.92L16.25,16.15L11,13V7H12.5Z"
                              Fill="{DynamicResource AccentBrush}" 
                              Width="20" Height="20" 
                              Stretch="Uniform"
                              Margin="0,0,12,0"/>
                        <TextBlock Text="Add Reminder" 
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                    </StackPanel>
                    <Button Content="✕" 
                            HorizontalAlignment="Right" 
                            VerticalAlignment="Center"
                            Click="CloseButton_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource HintTextBrush}"
                            FontSize="14"
                            Cursor="Hand"
                            Padding="8,4"/>
                </Grid>
            </Border>
            
            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,8,24,16">
                    
                    <!-- Title -->
                    <StackPanel Style="{StaticResource FormFieldGroup}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Title" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Style="{StaticResource RequiredIndicator}"/>
                        </StackPanel>
                        <customControls:TextBoxWithHint x:Name="TitleTextBox"
                                                        TextBoxType="Text"
                                                        HintText="e.g., Follow up with John"
                                                        Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    
                    <!-- Message -->
                    <StackPanel Style="{StaticResource FormFieldGroup}">
                        <customControls:TextBoxWithHint x:Name="MessageTextBox"
                                                        TextBoxType="Text"
                                                        HintText="Add details about the reminder..."
                                                        Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}"
                                                        TextWrapping="Wrap"
                                                        AcceptsReturn="True"
                                                        MinHeight="60"
                                                        MaxHeight="80"/>
                    </StackPanel>
                    
                    <!-- Date/Time -->
                    <StackPanel Style="{StaticResource FormFieldGroup}">
                        <TextBlock Text="Remind me on" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <DatePicker x:Name="DatePicker"
                                        SelectedDate="{Binding ReminderDate}"
                                        HorizontalAlignment="Stretch"
                                        Style="{StaticResource DatePickerStyle}"/>
                            <ComboBox Grid.Column="1"
                                      x:Name="HourComboBox"
                                      SelectedItem="{Binding SelectedHour}"
                                      Width="55"
                                      Margin="10,0,0,0">
                                <ComboBox.ItemsSource>
                                    <x:Array Type="sys:Int32" xmlns:sys="clr-namespace:System;assembly=mscorlib">
                                        <sys:Int32>1</sys:Int32>
                                        <sys:Int32>2</sys:Int32>
                                        <sys:Int32>3</sys:Int32>
                                        <sys:Int32>4</sys:Int32>
                                        <sys:Int32>5</sys:Int32>
                                        <sys:Int32>6</sys:Int32>
                                        <sys:Int32>7</sys:Int32>
                                        <sys:Int32>8</sys:Int32>
                                        <sys:Int32>9</sys:Int32>
                                        <sys:Int32>10</sys:Int32>
                                        <sys:Int32>11</sys:Int32>
                                        <sys:Int32>12</sys:Int32>
                                    </x:Array>
                                </ComboBox.ItemsSource>
                            </ComboBox>
                            <TextBlock Grid.Column="2" Text=":" VerticalAlignment="Center" 
                                       Margin="4,0" Foreground="{DynamicResource ForegroundBrush}"/>
                            <ComboBox Grid.Column="3"
                                      x:Name="MinuteComboBox"
                                      SelectedItem="{Binding SelectedMinute}"
                                      Width="55">
                                <ComboBox.ItemsSource>
                                    <x:Array Type="sys:Int32" xmlns:sys="clr-namespace:System;assembly=mscorlib">
                                        <sys:Int32>0</sys:Int32>
                                        <sys:Int32>15</sys:Int32>
                                        <sys:Int32>30</sys:Int32>
                                        <sys:Int32>45</sys:Int32>
                                    </x:Array>
                                </ComboBox.ItemsSource>
                            </ComboBox>
                            <ComboBox Grid.Column="4"
                                      x:Name="AmPmComboBox"
                                      SelectedItem="{Binding SelectedAmPm}"
                                      Width="60"
                                      Margin="4,0,0,0">
                                <ComboBoxItem Content="AM"/>
                                <ComboBoxItem Content="PM"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                    
                    <!-- Quick select -->
                    <StackPanel Style="{StaticResource FormFieldGroup}">
                        <TextBlock Text="Quick Select" Style="{StaticResource FieldLabel}"/>
                        <WrapPanel>
                            <Button Content="In 15 min" Style="{StaticResource DialogSecondaryButtonStyle}" 
                                    Click="QuickSelect_Click" Tag="15" Margin="0,0,8,8" Padding="12,8"/>
                            <Button Content="In 1 hour" Style="{StaticResource DialogSecondaryButtonStyle}" 
                                    Click="QuickSelect_Click" Tag="60" Margin="0,0,8,8" Padding="12,8"/>
                            <Button Content="Tomorrow 9am" Style="{StaticResource DialogSecondaryButtonStyle}" 
                                    Click="QuickSelect_Click" Tag="tomorrow9" Margin="0,0,8,8" Padding="12,8"/>
                            <Button Content="Next Monday" Style="{StaticResource DialogSecondaryButtonStyle}" 
                                    Click="QuickSelect_Click" Tag="monday" Margin="0,0,8,8" Padding="12,8"/>
                        </WrapPanel>
                    </StackPanel>
                    
                    <!-- Recurring -->
                    <Border Style="{StaticResource DialogCardStyle}" Margin="0">
                        <StackPanel>
                            <CheckBox x:Name="RecurringCheckBox"
                                      Content="Repeat this reminder"
                                      IsChecked="{Binding IsRecurring}"
                                      Foreground="{DynamicResource ForegroundBrush}"
                                      Style="{StaticResource ModernCheckBoxStyle}"/>
                            <StackPanel Orientation="Horizontal" 
                                        Visibility="{Binding IsRecurring, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Margin="24,12,0,0">
                                <TextBlock Text="Repeat every" VerticalAlignment="Center" 
                                           Foreground="{DynamicResource ForegroundBrush}" FontSize="13"/>
                                <ComboBox SelectedValue="{Binding RecurrenceIntervalDays}" 
                                          SelectedValuePath="Tag"
                                          Width="120" 
                                          Margin="12,0,0,0">
                                    <ComboBoxItem Content="Daily" Tag="1"/>
                                    <ComboBoxItem Content="Weekly" Tag="7"/>
                                    <ComboBoxItem Content="Bi-weekly" Tag="14"/>
                                    <ComboBoxItem Content="Monthly" Tag="30"/>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                </StackPanel>
            </ScrollViewer>
            
            <!-- Footer -->
            <Border Grid.Row="2" Style="{StaticResource DialogFooterStyle}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" 
                            Style="{StaticResource DialogSecondaryButtonStyle}" 
                            Click="CancelButton_Click"
                            Margin="0,0,12,0"/>
                    <Button Content="Create Reminder" 
                            Style="{StaticResource DialogPrimaryButtonStyle}" 
                            Click="SaveButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
