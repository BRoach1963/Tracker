<controls:BaseWindow x:Class="Tracker.Views.Dialogs.AddOkrDialog"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:controls="clr-namespace:Tracker.Controls"
                    xmlns:languages="clr-namespace:Tracker.Resources.Languages"
                    xmlns:commands="clr-namespace:Tracker.Command"
                    xmlns:dialogViewModels="clr-namespace:Tracker.ViewModels.DialogViewModels"
                    xmlns:converters="clr-namespace:Tracker.Common.Converters"
                    xmlns:customControls="clr-namespace:Tracker.Controls.CustomControls"
                    mc:Ignorable="d"
                    Title="Add OKR"
                    MouseDown="OnDragHandleMouseDown"
                    WindowStyle="None"
                    ResizeMode="CanResize"
                    Foreground="{DynamicResource ForegroundBrush}"
                    AllowsTransparency="True"
                    SizeToContent="WidthAndHeight"
                    Background="Transparent"
                    d:DataContext="{d:DesignInstance Type=dialogViewModels:NewOkrViewModel}"
                    MinWidth="680"
                    MinHeight="550"
                    AutomationProperties.Name="Add OKR Dialog"
                    AutomationProperties.HelpText="Create a new Objective and Key Results">
    <controls:BaseWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles/DialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </controls:BaseWindow.Resources>
    
    <Grid>
        <Border Background="{DynamicResource BackgroundBrush}"
                BorderThickness="1"
                BorderBrush="{DynamicResource BorderBrush}"
                CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Title Bar -->
                <Border Grid.Row="0" CornerRadius="12,12,0,0">
                    <controls:DialogTitleBar x:Name="TitleBar"
                                             DialogTitle="{x:Static languages:Resources.Add_Okr}"
                                             IconData="M11,2V4.07C7.38,4.53 4.53,7.38 4.07,11H2V13H4.07C4.53,16.62 7.38,19.47 11,19.93V22H13V19.93C16.62,19.47 19.47,16.62 19.93,13H22V11H19.93C19.47,7.38 16.62,4.53 13,4.07V2M12,11A1,1 0 0,0 11,12A1,1 0 0,0 12,13A1,1 0 0,0 13,12A1,1 0 0,0 12,11Z"
                                             CloseClicked="Close_Click"
                                             MinimizeClicked="Minimize_Click"
                                             MaximizeClicked="Maximize_Click"
                                             RestoreClicked="Restore_Click"/>
                </Border>
                
                <!-- Content Area -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Grid Margin="24,16,24,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Left Column - Objective Info -->
                        <StackPanel Grid.Column="0">
                            
                            <!-- Objective Title -->
                            <StackPanel Style="{StaticResource FormFieldGroup}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Objective Title" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Style="{StaticResource RequiredIndicator}"/>
                                </StackPanel>
                                <customControls:TextBoxWithHint TextBoxType="Text"
                                                                HintText="e.g., Improve Customer Satisfaction"
                                                                Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            
                            <!-- Owner -->
                            <StackPanel Style="{StaticResource FormFieldGroup}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Owner" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Style="{StaticResource RequiredIndicator}"/>
                                </StackPanel>
                                <ComboBox ItemsSource="{Binding TeamMembers}"
                                          SelectedItem="{Binding SelectedOwner}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Grid Width="24" Height="24" Margin="0,0,8,0">
                                                    <!-- Background for initials fallback -->
                                                    <Ellipse Fill="{DynamicResource AccentBrush}"
                                                             Visibility="{Binding ProfileImage, Converter={x:Static converters:ByteArrayToVisibilityConverter.InverseInstance}}"/>
                                                    <TextBlock Text="{Binding Initials}" 
                                                               FontSize="9" FontWeight="Bold"
                                                               Foreground="{DynamicResource BackgroundBrush}"
                                                               HorizontalAlignment="Center" 
                                                               VerticalAlignment="Center"
                                                               Visibility="{Binding ProfileImage, Converter={x:Static converters:ByteArrayToVisibilityConverter.InverseInstance}}"/>
                                                    <!-- Profile Image -->
                                                    <Ellipse Visibility="{Binding ProfileImage, Converter={x:Static converters:ByteArrayToVisibilityConverter.Instance}}">
                                                        <Ellipse.Fill>
                                                            <ImageBrush ImageSource="{Binding ProfileImage, Converter={x:Static converters:ByteArrayToImageSourceConverter.Instance}}"
                                                                        RenderOptions.BitmapScalingMode="HighQuality"
                                                                        Stretch="UniformToFill"/>
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                </Grid>
                                                <TextBlock VerticalAlignment="Center">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0} {1}">
                                                            <Binding Path="FirstName"/>
                                                            <Binding Path="LastName"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            
                            <!-- Link to Project -->
                            <StackPanel Style="{StaticResource FormFieldGroup}">
                                <TextBlock Text="Link to Project (Optional)" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding AvailableProjects}"
                                          SelectedItem="{Binding SelectedProject}"
                                          DisplayMemberPath="Name"
                                          HorizontalAlignment="Stretch"/>
                            </StackPanel>
                            
                            <!-- Date Range -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel>
                                    <TextBlock Text="Start Date" Style="{StaticResource FieldLabel}"/>
                                    <customControls:CalendarButton SelectedDate="{Binding StartDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                   HorizontalAlignment="Left"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="End Date" Style="{StaticResource FieldLabel}"/>
                                    <customControls:CalendarButton SelectedDate="{Binding EndDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                   HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Grid>
                            
                            <!-- Status & Progress Card -->
                            <Border Style="{StaticResource DialogCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel>
                                        <TextBlock Text="STATUS" FontSize="10" FontWeight="Bold" 
                                                   Foreground="{DynamicResource HintTextBrush}" Margin="0,0,0,4"/>
                                        <Border CornerRadius="6" Padding="10,5">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#64748B"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="OnTrack">
                                                            <Setter Property="Background" Value="#10B981"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="AtRisk">
                                                            <Setter Property="Background" Value="#F59E0B"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="OffTrack">
                                                            <Setter Property="Background" Value="#EF4444"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" Foreground="White" 
                                                       FontWeight="Bold" FontSize="11"/>
                                        </Border>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="PROGRESS" FontSize="10" FontWeight="Bold" 
                                                   Foreground="{DynamicResource HintTextBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding CompletionPercentage, StringFormat={}{0:N0}%}"
                                                   FontSize="20" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            
                            <!-- Description -->
                            <StackPanel Margin="0,16,0,0">
                                <customControls:TextBoxWithHint TextBoxType="Text"
                                                                HintText="Describe your objective..."
                                                                Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                                                AcceptsReturn="True"
                                                                TextWrapping="Wrap"
                                                                VerticalScrollBarVisibility="Auto"
                                                                MinHeight="60"/>
                            </StackPanel>
                            
                        </StackPanel>
                        
                        <!-- Right Column - Key Results -->
                        <StackPanel Grid.Column="2">
                            
                            <TextBlock Text="KEY RESULTS" 
                                       FontSize="11" FontWeight="Bold" 
                                       Foreground="{DynamicResource AccentBrush}"
                                       Margin="0,0,0,12"/>
                            
                            <!-- Current Key Results List -->
                            <Border Background="{DynamicResource SurfaceBrush}"
                                    CornerRadius="8"
                                    MinHeight="200"
                                    MaxHeight="260"
                                    Margin="0,0,0,12">
                                <Grid>
                                    <ListBox ItemsSource="{Binding KeyResults}"
                                             SelectedItem="{Binding SelectedKeyResult}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource BackgroundBrush}"
                                                        CornerRadius="6"
                                                        Padding="10,8"
                                                        Margin="8,4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="12"
                                                                       Foreground="{DynamicResource ForegroundBrush}"/>
                                                            <TextBlock Foreground="{DynamicResource HintTextBrush}" FontSize="11">
                                                                <TextBlock.Text>
                                                                    <MultiBinding StringFormat="{}{0} / {1}">
                                                                        <Binding Path="Value"/>
                                                                        <Binding Path="TargetValue"/>
                                                                    </MultiBinding>
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <Border Grid.Column="1" CornerRadius="4" Padding="6,3" VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#64748B"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Status}" Value="OnTarget">
                                                                            <Setter Property="Background" Value="#10B981"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="CloseToTarget">
                                                                            <Setter Property="Background" Value="#F59E0B"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="OffTarget">
                                                                            <Setter Property="Background" Value="#EF4444"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding Status}" Foreground="White" FontSize="9" FontWeight="Bold"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    
                                    <!-- Empty state -->
                                    <TextBlock Text="No Key Results added yet"
                                               Foreground="{DynamicResource HintTextBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               Visibility="{Binding KeyResults.Count, Converter={x:Static converters:ZeroToVisibilityConverter.Instance}}"/>
                                </Grid>
                            </Border>
                            
                            <!-- Remove Button -->
                            <Button Content="Remove Selected"
                                    Style="{StaticResource DialogSecondaryButtonStyle}"
                                    Command="{Binding RemoveKeyResultCommand}"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,16"
                                    Padding="12,8"/>
                            
                            <!-- Add KPI Section -->
                            <Border Style="{StaticResource DialogCardStyle}" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="Add KPI as Key Result" Style="{StaticResource FieldLabel}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox ItemsSource="{Binding AvailableKpis}"
                                                  SelectedItem="{Binding SelectedAvailableKpi}"
                                                  DisplayMemberPath="Name"
                                                  HorizontalAlignment="Stretch"/>
                                        <Button Grid.Column="1"
                                                Content="+ Add"
                                                Style="{StaticResource DialogPrimaryButtonStyle}"
                                                Command="{Binding AddKeyResultCommand}"
                                                Margin="12,0,0,0"
                                                Padding="16,8"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
                
                <!-- Footer with Buttons -->
                <Border Grid.Row="2" Style="{StaticResource DialogFooterStyle}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel"
                                Style="{StaticResource DialogSecondaryButtonStyle}"
                                Margin="0,0,12,0"
                                Command="{x:Static commands:DialogCommands.CloseDialogCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type controls:BaseWindow}}}"/>
                        <Button Content="Create OKR"
                                Style="{StaticResource DialogPrimaryButtonStyle}"
                                Command="{Binding AddOkrCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type controls:BaseWindow}}}"
                                Visibility="{Binding InEditMode, Converter={x:Static converters:ReverseBoolToVisConverter.Instance}}"/>
                        <Button Content="Save Changes"
                                Style="{StaticResource DialogPrimaryButtonStyle}"
                                Command="{Binding UpdateOkrCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type controls:BaseWindow}}}"
                                Visibility="{Binding InEditMode, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</controls:BaseWindow>
