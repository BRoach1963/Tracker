<controls:BaseWindow x:Class="Tracker.Views.Dialogs.InputDialog"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:controls="clr-namespace:Tracker.Controls"
                     Title="Input"
                     Height="220" Width="420"
                     WindowStyle="None"
                     AllowsTransparency="True"
                     ResizeMode="NoResize"
                     WindowStartupLocation="CenterOwner"
                     Background="Transparent">
    
    <Border Background="{DynamicResource BackgroundBrush}"
            BorderThickness="1"
            BorderBrush="{DynamicResource BorderBrush}"
            CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Title Bar -->
            <Border Grid.Row="0" 
                    Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="12,12,0,0"
                    Padding="16,12">
                <Grid>
                    <TextBlock x:Name="TitleText"
                               Text="Enter Value"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ForegroundBrush}"
                               VerticalAlignment="Center"/>
                    <Button HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            Click="Close_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" 
                                        Background="Transparent" 
                                        CornerRadius="4"
                                        Padding="4">
                                    <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                          Width="14" Height="14"
                                          Fill="{DynamicResource HintTextBrush}"
                                          Stretch="Uniform"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
            
            <!-- Content -->
            <StackPanel Grid.Row="1" Margin="24,20">
                <TextBlock x:Name="PromptText"
                           Text="Enter a value:"
                           FontSize="13"
                           Foreground="{DynamicResource ForegroundBrush}"
                           Margin="0,0,0,12"/>
                
                <TextBox x:Name="InputTextBox"
                         FontSize="14"
                         Padding="12,10"
                         Background="{DynamicResource SurfaceBrush}"
                         Foreground="{DynamicResource ForegroundBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"
                         BorderThickness="1"
                         KeyDown="InputTextBox_KeyDown">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>
                
                <TextBlock x:Name="ErrorText"
                           FontSize="11"
                           Foreground="#EF4444"
                           Margin="0,8,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>
            
            <!-- Buttons -->
            <Border Grid.Row="2"
                    Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="0,0,12,12"
                    Padding="16,12">
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Right">
                    <Button Content="Cancel"
                            Padding="20,10"
                            Margin="0,0,8,0"
                            Click="Cancel_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd"
                                        Background="{DynamicResource BackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" 
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="ConfirmButton"
                            Content="Confirm"
                            Padding="20,10"
                            Foreground="{DynamicResource BackgroundBrush}"
                            Click="Confirm_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd"
                                        Background="{DynamicResource AccentBrush}"
                                        CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" 
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</controls:BaseWindow>


