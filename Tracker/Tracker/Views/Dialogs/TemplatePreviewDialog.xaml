<controls:BaseWindow x:Class="Tracker.Views.Dialogs.TemplatePreviewDialog"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:controls="clr-namespace:Tracker.Controls"
                     xmlns:converters="clr-namespace:Tracker.Common.Converters"
                     mc:Ignorable="d"
                     Title="Template Preview" 
                     Height="700" 
                     Width="850"
                     MinHeight="500"
                     MinWidth="600"
                     WindowStartupLocation="CenterOwner"
                     WindowStyle="None"
                     ResizeMode="CanResize"
                     AllowsTransparency="True"
                     Background="Transparent">
    
    <controls:BaseWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles/DialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </controls:BaseWindow.Resources>
    
    <Border CornerRadius="12" Background="{DynamicResource BackgroundBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.4"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- HEADER -->
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12,12,0,0" Padding="24,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <!-- Eye icon for preview -->
                            <Path Data="M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5Z" 
                                  Fill="{DynamicResource AccentBrush}" Width="24" Height="24" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="TEMPLATE PREVIEW" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource HintTextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TemplateNameText" Text="{Binding TemplateName}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}" Margin="0,8,0,0"/>
                        <TextBlock x:Name="TemplateDescText" Text="{Binding TemplateDescription}" FontSize="14" Foreground="{DynamicResource HintTextBrush}" TextWrapping="Wrap" MaxWidth="500" HorizontalAlignment="Left"/>
                    </StackPanel>
                    
                    <!-- Close Button -->
                    <Button Grid.Column="1" Click="CloseButton_Click" Style="{StaticResource SecondaryButtonStyle}" Width="32" Height="32" Padding="0" VerticalAlignment="Top">
                        <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" 
                              Fill="{DynamicResource ForegroundBrush}" Width="16" Height="16" Stretch="Uniform"/>
                    </Button>
                </Grid>
            </Border>
            
            <!-- CONTENT - Preview of sections and questions -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16">
                <ItemsControl x:Name="SectionsContainer" ItemsSource="{Binding Sections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="20" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <!-- Section Header -->
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="4" Background="{DynamicResource AccentBrush}" CornerRadius="2" Margin="0,0,12,0"/>
                                            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" FontSize="13" Foreground="{DynamicResource HintTextBrush}" Margin="16,4,0,0" TextWrapping="Wrap"
                                                   Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </StackPanel>
                                    
                                    <!-- Questions -->
                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Questions}" Margin="0,16,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        
                                                        <!-- Question Header -->
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            
                                                            <TextBlock Text="{Binding Text}" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource ForegroundBrush}" TextWrapping="Wrap"/>
                                                            
                                                            <!-- Question Type Badge -->
                                                            <Border Grid.Column="1" CornerRadius="10" Padding="8,4" Background="{DynamicResource AccentBrush}" Opacity="0.8" Margin="12,0,0,0" VerticalAlignment="Top">
                                                                <TextBlock Text="{Binding QuestionTypeDisplay}" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                                            </Border>
                                                        </Grid>
                                                        
                                                        <!-- Help Text -->
                                                        <TextBlock Grid.Row="1" Text="{Binding HelpText}" FontSize="12" Foreground="{DynamicResource HintTextBrush}" 
                                                                   Margin="0,4,0,0" TextWrapping="Wrap"
                                                                   Visibility="{Binding HasHelpText, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        
                                                        <!-- Preview of Input Type -->
                                                        <ContentControl Grid.Row="2" Margin="0,12,0,0" IsEnabled="False" Opacity="0.6">
                                                            <ContentControl.Style>
                                                                <Style TargetType="ContentControl">
                                                                    <Style.Triggers>
                                                                        <!-- Long Text -->
                                                                        <DataTrigger Binding="{Binding QuestionType}" Value="LongText">
                                                                            <Setter Property="Content">
                                                                                <Setter.Value>
                                                                                    <TextBox Height="80" AcceptsReturn="True" TextWrapping="Wrap" IsReadOnly="True"
                                                                                             Text="[Text area for detailed response...]" Background="{DynamicResource BackgroundBrush}"
                                                                                             Foreground="{DynamicResource HintTextBrush}"/>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                        </DataTrigger>
                                                                        <!-- Short Text -->
                                                                        <DataTrigger Binding="{Binding QuestionType}" Value="ShortText">
                                                                            <Setter Property="Content">
                                                                                <Setter.Value>
                                                                                    <TextBox Height="32" IsReadOnly="True"
                                                                                             Text="[Short text response...]" Background="{DynamicResource BackgroundBrush}"
                                                                                             Foreground="{DynamicResource HintTextBrush}"/>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                        </DataTrigger>
                                                                        <!-- Rating -->
                                                                        <DataTrigger Binding="{Binding QuestionType}" Value="Rating">
                                                                            <Setter Property="Content">
                                                                                <Setter.Value>
                                                                                    <StackPanel Orientation="Horizontal">
                                                                                        <Path Data="M12,17.27L18.18,21L16.54,13.97L22,9.24L14.81,8.62L12,2L9.19,8.62L2,9.24L7.45,13.97L5.82,21L12,17.27Z" Fill="#9E9E9E" Width="24" Height="24" Stretch="Uniform" Margin="0,0,4,0"/>
                                                                                        <Path Data="M12,17.27L18.18,21L16.54,13.97L22,9.24L14.81,8.62L12,2L9.19,8.62L2,9.24L7.45,13.97L5.82,21L12,17.27Z" Fill="#9E9E9E" Width="24" Height="24" Stretch="Uniform" Margin="0,0,4,0"/>
                                                                                        <Path Data="M12,17.27L18.18,21L16.54,13.97L22,9.24L14.81,8.62L12,2L9.19,8.62L2,9.24L7.45,13.97L5.82,21L12,17.27Z" Fill="#9E9E9E" Width="24" Height="24" Stretch="Uniform" Margin="0,0,4,0"/>
                                                                                        <Path Data="M12,17.27L18.18,21L16.54,13.97L22,9.24L14.81,8.62L12,2L9.19,8.62L2,9.24L7.45,13.97L5.82,21L12,17.27Z" Fill="#9E9E9E" Width="24" Height="24" Stretch="Uniform" Margin="0,0,4,0"/>
                                                                                        <Path Data="M12,17.27L18.18,21L16.54,13.97L22,9.24L14.81,8.62L12,2L9.19,8.62L2,9.24L7.45,13.97L5.82,21L12,17.27Z" Fill="#9E9E9E" Width="24" Height="24" Stretch="Uniform"/>
                                                                                        <TextBlock Text="[1-5 Rating]" Foreground="{DynamicResource HintTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                                                    </StackPanel>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                        </DataTrigger>
                                                                        <!-- Yes/No -->
                                                                        <DataTrigger Binding="{Binding QuestionType}" Value="YesNo">
                                                                            <Setter Property="Content">
                                                                                <Setter.Value>
                                                                                    <StackPanel Orientation="Horizontal">
                                                                                        <RadioButton Content="Yes" GroupName="YesNo" IsEnabled="False" Margin="0,0,20,0"/>
                                                                                        <RadioButton Content="No" GroupName="YesNo" IsEnabled="False"/>
                                                                                    </StackPanel>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ContentControl.Style>
                                                        </ContentControl>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            
            <!-- FOOTER -->
            <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="0,0,12,12" Padding="24,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Stats -->
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M19,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M19,19H5V5H19V19M17,17H7V7H17V17Z" 
                              Fill="{DynamicResource HintTextBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="SectionCountText" Text="{Binding SectionCount, StringFormat='{}{0} Sections'}" Foreground="{DynamicResource HintTextBrush}" FontSize="13" VerticalAlignment="Center"/>
                        
                        <Ellipse Width="4" Height="4" Fill="{DynamicResource HintTextBrush}" Margin="12,0"/>
                        
                        <Path Data="M12,4C14.21,4 16,5.79 16,8C16,10.21 14.21,12 12,12C9.79,12 8,10.21 8,8C8,5.79 9.79,4 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z" 
                              Fill="{DynamicResource HintTextBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="QuestionCountText" Text="{Binding QuestionCount, StringFormat='{}{0} Questions'}" Foreground="{DynamicResource HintTextBrush}" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <Button Grid.Column="1" Content="Close" Click="CloseButton_Click" Style="{StaticResource PrimaryButtonStyle}" Width="100"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</controls:BaseWindow>
