<Window x:Class="Tracker.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Tracker.ViewModels"
        xmlns:converters="clr-namespace:Tracker.Common.Converters"
        mc:Ignorable="d"
        Title="Tracker"
        Height="650"
        Width="1000"
        MinHeight="550"
        MinWidth="850"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        d:DataContext="{d:DesignInstance Type=vm:LoginWindowViewModel}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Themes/TrackerTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Converters -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

            <!-- Modern TextBox Style (uses theme resources) -->
            <Style x:Key="ModernTextBox" TargetType="TextBox">
                <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="16,14"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Focusable="false"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"
                                              Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                                <Trigger Property="IsFocused" Value="true">
                                    <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="BorderThickness" TargetName="border" Value="2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Modern PasswordBox Style (uses theme resources) -->
            <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
                <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="16,14"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="PasswordBox">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Focusable="false"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"
                                              Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                                <Trigger Property="IsFocused" Value="true">
                                    <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="BorderThickness" TargetName="border" Value="2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Primary Button Style (uses theme resources with accent hover) -->
            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="24,14"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="8"
                                    SnapsToDevicePixels="True"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" TargetName="border" Value="{DynamicResource AccentHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Background" TargetName="border" Value="{DynamicResource AccentPressedBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Background" TargetName="border" Value="{DynamicResource SurfaceAltBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource HintTextBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Link Button Style (uses theme resources) -->
            <Style x:Key="LinkButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <TextBlock x:Name="text"
                                       Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       TextDecorations="None"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="TextDecorations" TargetName="text" Value="Underline"/>
                                    <Setter Property="Foreground" TargetName="text" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- CheckBox Style (Light Theme) -->
            <Style x:Key="ModernCheckBox" TargetType="CheckBox">
                <Setter Property="Foreground" Value="#4B5563"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="checkBorder"
                                        Width="20" Height="20"
                                        Background="{DynamicResource BackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Margin="0,0,10,0">
                                    <Path x:Name="checkMark"
                                          Data="M2,5 L5,8 L10,2"
                                          Stroke="{DynamicResource TextBrush}"
                                          StrokeThickness="2"
                                          Stretch="Uniform"
                                          Width="10" Height="8"
                                          Visibility="Collapsed"/>
                                </Border>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="true">
                                    <Setter Property="Visibility" TargetName="checkMark" Value="Visible"/>
                                    <Setter Property="BorderBrush" TargetName="checkBorder" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="BorderBrush" TargetName="checkBorder" Value="{DynamicResource HintTextBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Main Container with Drop Shadow -->
    <Border Background="{DynamicResource BackgroundBrush}"
            CornerRadius="12"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" 
                              ShadowDepth="3"
                              Opacity="0.15"
                              Color="Black"/>
        </Border.Effect>

        <Grid>
            <!-- Two-Column Layout -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="350"/>
                <ColumnDefinition Width="1.1*" MinWidth="400"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL - Branding with slate blue accent strip -->
            <Grid Grid.Column="0" MouseLeftButtonDown="BrandingPanel_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Bold vertical accent bar - Primary Blue with gold accent -->
                <Border Grid.Column="0" 
                        CornerRadius="12,0,0,12">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#2E3843" Offset="0"/>
                            <GradientStop Color="#C7A450" Offset="0.4"/>
                            <GradientStop Color="#C7A450" Offset="0.6"/>
                            <GradientStop Color="#2E3843" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                
                <!-- Main branding area with subtle gradient -->
                <Border Grid.Column="1">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FAFAFA" Offset="0"/>
                            <GradientStop Color="#F5F3EF" Offset="0.5"/>
                            <GradientStop Color="#F0EDE7" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Margin="40">
                            <!-- Logo with gold accent ring and glow -->
                            <Border Width="120" Height="120"
                                    Margin="0,0,0,24">
                                <Border.Effect>
                                    <DropShadowEffect Color="#C7A450" BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
                                </Border.Effect>
                                <Border BorderThickness="4" CornerRadius="60"
                                        Padding="6">
                                    <Border.BorderBrush>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#C7A450" Offset="0"/>
                                            <GradientStop Color="#D4B466" Offset="0.5"/>
                                            <GradientStop Color="#C7A450" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.BorderBrush>
                                    <Image Source="/Resources/trackernobg.png" Stretch="Uniform"/>
                                </Border>
                            </Border>

                            <!-- App Name with accent underline -->
                            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,6">
                                <TextBlock Text="Tracker"
                                           FontSize="40"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextBrush}"
                                           HorizontalAlignment="Center"/>
                                <Rectangle Width="80" Height="4" 
                                           RadiusX="2" RadiusY="2"
                                           Fill="{DynamicResource AccentBrush}"
                                           Margin="0,6,0,0"/>
                            </StackPanel>

                            <!-- Tagline -->
                            <TextBlock Text="Team Performance, Simplified"
                                       FontSize="14"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,32"/>

                            <!-- Feature Highlights with alternating color bullets -->
                            <StackPanel Margin="0,16,0,0" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Ellipse Width="10" Height="10" Fill="{DynamicResource AccentBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Track team goals &amp; metrics"
                                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" FontWeight="Medium"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Ellipse Width="10" Height="10" Fill="{DynamicResource TextBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Streamline 1:1 meetings"
                                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" FontWeight="Medium"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Ellipse Width="10" Height="10" Fill="{DynamicResource AccentBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Give meaningful feedback"
                                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" FontWeight="Medium"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="10" Height="10" Fill="{DynamicResource TextBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Develop your people"
                                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" FontWeight="Medium"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- Version at bottom with accent -->
                        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20">
                            <Rectangle Width="30" Height="2" Fill="{DynamicResource AccentBrush}" RadiusX="1" RadiusY="1" Margin="0,0,0,8"/>
                            <TextBlock Text="Version 2.0"
                                       FontSize="11"
                                       Foreground="{DynamicResource HintTextBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- RIGHT PANEL - Login Form -->
            <Grid Grid.Column="1" Background="{DynamicResource BackgroundBrush}" Margin="44,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Window Controls -->
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,0,0,16">
                    <Button x:Name="CloseButton"
                            Click="CloseButton_Click"
                            Width="36" Height="36"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="Close">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" 
                                                    Background="Transparent" 
                                                    CornerRadius="6"
                                                    Width="{TemplateBinding Width}"
                                                    Height="{TemplateBinding Height}">
                                                <Path x:Name="icon"
                                                      Data="M18 6L6 18M6 6l12 12"
                                                      Stroke="#9CA3AF"
                                                      StrokeThickness="2.5"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      Width="14" Height="14"
                                                      Stretch="Uniform"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#FEE2E2"/>
                                                    <Setter TargetName="icon" Property="Stroke" Value="#DC2626"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#FECACA"/>
                                                    <Setter TargetName="icon" Property="Stroke" Value="#B91C1C"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- Login Form Content -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,0,20,0">
                    <!-- Welcome Text with accent underline -->
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="Welcome back"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <Rectangle Width="50" Height="3" 
                                   Fill="{DynamicResource AccentBrush}" 
                                   RadiusX="1.5" RadiusY="1.5"
                                   HorizontalAlignment="Left"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                    <TextBlock Text="Sign in to continue to Tracker"
                               FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,8,0,36"/>

                    <!-- Email -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Email"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,8"/>
                        <TextBox x:Name="EmailTextBox"
                                 Style="{StaticResource ModernTextBox}"
                                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="EmailTextBox_KeyDown"/>
                    </StackPanel>

                    <!-- Password -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Password"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,8"/>
                        <Grid>
                            <PasswordBox x:Name="PasswordBox"
                                         Style="{StaticResource ModernPasswordBox}"
                                         PasswordChanged="PasswordBox_PasswordChanged"
                                         KeyDown="PasswordBox_KeyDown"/>
                            <TextBox x:Name="PasswordTextBox"
                                     Style="{StaticResource ModernTextBox}"
                                     TextChanged="PasswordTextBox_TextChanged"
                                     KeyDown="PasswordBox_KeyDown"
                                     Visibility="Collapsed"/>
                            <Button x:Name="ShowPasswordButton"
                                    Click="ShowPasswordButton_Click"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Width="36" Height="36"
                                    Margin="0,0,4,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    ToolTip="Show password">
                                <Path x:Name="EyeIcon"
                                      Data="M12,4.5C7,4.5 2.73,7.61 1,12c1.73,4.39 6,7.5 11,7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5M12,17c-2.76,0-5-2.24-5-5s2.24-5 5-5 5,2.24 5,5-2.24,5-5,5m0-8c-1.66,0-3,1.34-3,3s1.34,3 3,3 3-1.34 3-3-1.34-3-3-3"
                                      Fill="{DynamicResource HintTextBrush}"
                                      Width="18" Height="18"
                                      Stretch="Uniform"/>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Keep Me Signed In & Forgot Password Row -->
                    <Grid Margin="0,0,0,28">
                        <CheckBox Content="Keep me signed in"
                                  Style="{StaticResource ModernCheckBox}"
                                  IsChecked="{Binding KeepMeSignedIn}"
                                  ToolTip="Skip the login screen next time by storing your session securely on this Windows account"
                                  HorizontalAlignment="Left"/>
                        <Button Content="Forgot password?"
                                Style="{StaticResource LinkButton}"
                                Command="{Binding ForgotPasswordCommand}"
                                HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Error Message -->
                    <Border x:Name="ErrorBorder"
                            Background="{DynamicResource WarningBackgroundBrush}"
                            BorderBrush="{DynamicResource DangerBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="0,0,0,20"
                            Padding="14,10"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M12,2C6.48,2 2,6.48 2,12s4.48,10 10,10 10-4.48 10-10S17.52,2 12,2m1,15h-2v-2h2v2m0-4h-2V7h2v6z"
                                  Fill="{DynamicResource DangerBrush}"
                                  Width="18" Height="18"
                                  Stretch="Uniform"
                                  Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding ErrorMessage}"
                                       Foreground="{DynamicResource DangerBrush}"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Sign In Button -->
                    <Button x:Name="SignInButton"
                            Content="Sign In"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding SignInCommand}"
                            IsEnabled="{Binding CanSignIn}"
                            Margin="0,0,0,16"/>

                    <!-- Loading Indicator -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                                Margin="0,0,0,16">
                        <TextBlock Text="Signing in..."
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="13"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Footer -->
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,16,0,8">
                    <Button Content="Help"
                            Style="{StaticResource LinkButton}"
                            Command="{Binding HelpCommand}"
                            Margin="0,0,20,0"/>
                    <Button Content="Privacy"
                            Style="{StaticResource LinkButton}"
                            Command="{Binding PrivacyCommand}"
                            Margin="0,0,20,0"/>
                    <Button Content="Terms"
                            Style="{StaticResource LinkButton}"
                            Command="{Binding TermsCommand}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
