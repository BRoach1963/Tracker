<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:ProCohere.Avalonia"
             xmlns:converters="using:ProCohere.Avalonia.Converters"
             xmlns:vm="using:ProCohere.Avalonia.ViewModels"
             x:Class="ProCohere.Avalonia.App"
             x:DataType="vm:TrayIconViewModel"
             RequestedThemeVariant="Light">
    
    <!-- System Tray Icon -->
    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/procohere.ico"
                      ToolTipText="{Binding ToolTipText}"
                      IsVisible="True">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Open ProCohere" 
                                        Command="{Binding OpenCommand}" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Reminders Enabled" 
                                        ToggleType="CheckBox"
                                        IsChecked="{Binding RemindersEnabled}" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Exit" 
                                        Command="{Binding ExitCommand}" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://ProCohere.Avalonia/Themes/LightTheme.axaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Converters -->
            <converters:EnumEqualConverter x:Key="EnumEqualConverter"/>
            <converters:EnumNotEqualConverter x:Key="EnumNotEqualConverter"/>
            <converters:IntEqualConverter x:Key="IntEqualConverter"/>
            <converters:NavWidthConverter x:Key="NavWidthConverter"/>
            <converters:CollapseIconConverter x:Key="CollapseIconConverter"/>
            <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
            <converters:MeetingStatusColorConverter x:Key="MeetingStatusColorConverter"/>
            <converters:EqualToZeroConverter x:Key="EqualToZeroConverter"/>
            <converters:BoolToWidthConverter x:Key="BoolToWidthConverter"/>
            <converters:BoolToHighlightBackgroundConverter x:Key="BoolToHighlightBackgroundConverter"/>
            <converters:BoolToForegroundConverter x:Key="BoolToForegroundConverter"/>
            <converters:GoalStatusToBackgroundConverter x:Key="GoalStatusToBackgroundConverter"/>
            <converters:GoalDerivedHealthToBackgroundConverter x:Key="GoalDerivedHealthToBackgroundConverter"/>
            <converters:GoalDerivedHealthToDisplayConverter x:Key="GoalDerivedHealthToDisplayConverter"/>
            <converters:GoalDerivedHealthToPromptConverter x:Key="GoalDerivedHealthToPromptConverter"/>
            <converters:TaskStatusToBackgroundConverter x:Key="TaskStatusToBackgroundConverter"/>
            <converters:TaskStatusToForegroundConverter x:Key="TaskStatusToForegroundConverter"/>
            <converters:PriorityToBrushConverter x:Key="PriorityToBrushConverter"/>
            <converters:RecurrencePatternToUnitConverter x:Key="RecurrencePatternToUnitConverter"/>
            <converters:PrepItemStatusToBackgroundConverter x:Key="PrepItemStatusToBackgroundConverter"/>
            <converters:PrepItemStatusToForegroundConverter x:Key="PrepItemStatusToForegroundConverter"/>
            <converters:PrepItemStatusToTextConverter x:Key="PrepItemStatusToTextConverter"/>
            <converters:PrepItemVisibilityToIconConverter x:Key="PrepItemVisibilityToIconConverter"/>
            <converters:PrepItemVisibilityToTextConverter x:Key="PrepItemVisibilityToTextConverter"/>
            <converters:TreeDepthToMarginConverter x:Key="TreeDepthToMarginConverter"/>
            <converters:GreaterThanZeroConverter x:Key="GreaterThanZeroConverter"/>
            <converters:TopOffsetToMarginConverter x:Key="TopOffsetToMarginConverter"/>
            <converters:BoolToStrikethroughConverter x:Key="BoolToStrikethroughConverter"/>
            <converters:BoolToOverdueColorConverter x:Key="BoolToOverdueColorConverter"/>
            <converters:PriorityToBgColorConverter x:Key="PriorityToBgColorConverter"/>
            <converters:PriorityToFgColorConverter x:Key="PriorityToFgColorConverter"/>
            <converters:GuidIsEmptyToNewOrEditConverter x:Key="GuidIsEmptyToNewOrEditConverter"/>
            <converters:GoalTypeToIndexConverter x:Key="GoalTypeToIndexConverter"/>
            <converters:GoalHealthToDisplayConverter x:Key="GoalHealthToDisplayConverter"/>
            <converters:GoalHealthToBackgroundConverter x:Key="GoalHealthToBackgroundConverter"/>
            <converters:GoalHealthToPromptConverter x:Key="GoalHealthToPromptConverter"/>
            <converters:StringEqualConverter x:Key="StringEqualConverter"/>
            <converters:GuidIsNotEmptyConverter x:Key="GuidIsNotEmptyConverter"/>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <converters:CategoryToColorConverter x:Key="CategoryToColorConverter"/>
            <converters:CategoryToAccentConverter x:Key="CategoryToAccentConverter"/>
            <converters:MetricTrendToColorConverter x:Key="MetricTrendToColorConverter"/>
            <converters:MetricTrendToSignalBrushConverter x:Key="MetricTrendToSignalBrushConverter"/>
            <converters:DateTimeToAgeConverter x:Key="DateTimeToAgeConverter"/>
            <converters:AgendaStatusToBrushConverter x:Key="AgendaStatusToBrushConverter"/>
            <converters:PercentToWidthConverter x:Key="PercentToWidthConverter"/>
        </ResourceDictionary>
    </Application.Resources>
  
    <Application.Styles>
        <!-- FluentTheme - modern Windows 11 style -->
        <FluentTheme />
        
        <!-- Dark Navigation Button Styles (for dark sidebar) -->
        <Style Selector="Button.nav-item-dark">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.nav-item-dark /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.nav-item-dark:pointerover">
            <Setter Property="Background" Value="#25FFFFFF"/>
            <Setter Property="BorderBrush" Value="#80FFFFFF"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="Button.nav-item-dark:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#25FFFFFF"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="Button.nav-item-dark:pointerover TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="Button.nav-item-dark.selected">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushHighlight}"/>
        </Style>
        <Style Selector="Button.nav-item-dark.selected TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrushHighlight}"/>
        </Style>
        <Style Selector="Button.nav-item-dark TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="Button.nav-item-dark PathIcon">
            <Setter Property="Foreground" Value="#90A4AE"/>
        </Style>
        <Style Selector="Button.nav-item-dark:pointerover PathIcon">
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="Button.nav-item-dark.selected PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource BrushHighlight}"/>
        </Style>
        
        <!-- Nav indicator (left accent bar) -->
        <Style Selector="Border.nav-indicator">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.nav-indicator.selected">
            <Setter Property="Background" Value="{DynamicResource BrushHighlight}"/>
        </Style>
        
        <!-- Collapse button for dark sidebar -->
        <Style Selector="Button.nav-collapse">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#607D8B"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
        <Style Selector="Button.nav-collapse /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.nav-collapse:pointerover">
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="Button.nav-collapse:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.nav-collapse PathIcon">
            <Setter Property="Foreground" Value="#607D8B"/>
        </Style>
        <Style Selector="Button.nav-collapse:pointerover PathIcon">
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <!-- Navigation Button Styles (light sidebar - keeping for reference) -->
        <Style Selector="Button.nav-item">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusSmall}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.nav-item:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}"/>
        </Style>
        <Style Selector="Button.nav-item.selected">
            <Setter Property="Background" Value="{DynamicResource BrushHighlightSoft}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushPrimary}"/>
        </Style>
        <Style Selector="Button.nav-item.selected PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource BrushHighlight}"/>
        </Style>
        <Style Selector="Button.nav-item PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextTertiary}"/>
        </Style>
        <Style Selector="Button.nav-item:pointerover PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource BrushHighlight}"/>
        </Style>

        <!-- Action Button Style -->
        <Style Selector="Button.action-button">
            <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusSmall}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.action-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushHighlight}"/>
        </Style>

        <!-- Secondary Button Style -->
        <Style Selector="Button.secondary-button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusSmall}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.secondary-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushHighlight}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        </Style>

        <!-- Icon Button Style -->
        <Style Selector="Button.icon-button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextTertiary}"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.icon-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushHighlight}"/>
        </Style>

        <!-- Segmented Button Style (for tab-like selection) -->
        <Style Selector="Button.segmented-button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="Button.segmented-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.segmented-button.selected">
            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.segmented-button.selected:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- User Avatar Button Style -->
        <Style Selector="Button.user-avatar-button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.user-avatar-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}"/>
        </Style>

        <!-- Menu Item Button Style (for dropdowns) -->
        <Style Selector="Button.menu-item">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.menu-item:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}"/>
        </Style>
        <Style Selector="Button.menu-item.danger:pointerover">
            <Setter Property="Background" Value="#FEE2E2"/>
        </Style>
        
        <!-- ============================================ -->
        <!-- STANDARD BUTTON CLASSES                     -->
        <!-- ============================================ -->
        
        <!-- Accent/Affirmative Button (Save, OK, Yes, Confirm, etc.) -->
        <!-- Gold background, white text. Hover: white bg, gold text/border -->
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{DynamicResource BrushHighlight}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushHighlight}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushHighlight}"/>
            <Setter Property="TextElement.Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.accent TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.accent:pointerover">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushHighlight}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushHighlight}"/>
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="White"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource BrushHighlight}"/>
        </Style>
        <Style Selector="Button.accent:pointerover TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrushHighlight}"/>
        </Style>
        <Style Selector="Button.accent:pressed">
            <Setter Property="Background" Value="{DynamicResource BrushHighlightSoft}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushHighlightPressed}"/>
        </Style>
        <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushHighlightSoft}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource BrushHighlightPressed}"/>
        </Style>
        <Style Selector="Button.accent:pressed TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrushHighlightPressed}"/>
        </Style>
        <Style Selector="Button.accent:disabled">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>
        <Style Selector="Button.accent:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushHighlight}"/>
        </Style>
        
        <!-- Cancel/Negative Button (Cancel, No, Close, etc.) -->
        <!-- Gray background, white text. Hover: white bg, gray text -->
        <Style Selector="Button.cancel-btn">
            <Setter Property="Background" Value="#5A6A7A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#5A6A7A"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.cancel-btn /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#5A6A7A"/>
            <Setter Property="TextElement.Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.cancel-btn TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.cancel-btn:pointerover">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#5A6A7A"/>
            <Setter Property="BorderBrush" Value="#5A6A7A"/>
        </Style>
        <Style Selector="Button.cancel-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="White"/>
            <Setter Property="TextElement.Foreground" Value="#5A6A7A"/>
        </Style>
        <Style Selector="Button.cancel-btn:pointerover TextBlock">
            <Setter Property="Foreground" Value="#5A6A7A"/>
        </Style>
        <Style Selector="Button.cancel-btn:pressed">
            <Setter Property="Background" Value="#E8EAED"/>
            <Setter Property="Foreground" Value="#3A4A5A"/>
        </Style>
        <Style Selector="Button.cancel-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#E8EAED"/>
            <Setter Property="TextElement.Foreground" Value="#3A4A5A"/>
        </Style>
        <Style Selector="Button.cancel-btn:pressed TextBlock">
            <Setter Property="Foreground" Value="#3A4A5A"/>
        </Style>
        <Style Selector="Button.cancel-btn:disabled">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>
        <Style Selector="Button.cancel-btn:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#5A6A7A"/>
        </Style>
        
        <!-- Destructive Button (Delete, Remove, etc.) -->
        <!-- Red outline, red text; fills red on hover -->
        <Style Selector="Button.destructive">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushError}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushError}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.destructive /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource BrushError}"/>
        </Style>
        <Style Selector="Button.destructive TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrushError}"/>
        </Style>
        <Style Selector="Button.destructive:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushError}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.destructive:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushError}"/>
            <Setter Property="TextElement.Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.destructive:pointerover TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.destructive:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#9A1B12"/>
            <Setter Property="TextElement.Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.destructive:pressed TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Application.Styles>
</Application>