<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ProCohere.Avalonia.ViewModels"
             xmlns:models="using:ProCohere.Avalonia.Models"
             xmlns:markup="using:ProCohere.Avalonia.Markup"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="ProCohere.Avalonia.Views.ProjectsView"
             x:DataType="vm:ProjectsViewModel">
    
    <Design.DataContext>
        <vm:ProjectsViewModel/>
    </Design.DataContext>

    <UserControl.Styles>
        <!-- Tab Button Style -->
        <Style Selector="Button.tab-button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style Selector="Button.tab-button /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.tab-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        </Style>
        <Style Selector="Button.tab-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}"/>
        </Style>
        <Style Selector="Button.tab-button.selected">
            <Setter Property="Foreground" Value="{DynamicResource BrushPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.tab-button.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        
        <!-- Stat card style -->
        <Style Selector="Border.stat-card">
            <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinWidth" Value="100"/>
        </Style>
        
        <!-- Project card style -->
        <Style Selector="Border.project-card">
            <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.project-card:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushHighlight}"/>
        </Style>
        <!-- Completed project cards are subdued -->
        <Style Selector="Border.project-card.completed">
            <Setter Property="Opacity" Value="0.65"/>
        </Style>
        <Style Selector="Border.project-card.completed:pointerover">
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
        
        <!-- Status badge style -->
        <Style Selector="Border.status-badge">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        <Style Selector="Border.status-badge.active">
            <Setter Property="Background" Value="{DynamicResource BrushSuccessSoft}"/>
        </Style>
        <Style Selector="Border.status-badge.paused">
            <Setter Property="Background" Value="{DynamicResource BrushWarningSoft}"/>
        </Style>
        <Style Selector="Border.status-badge.completed">
            <Setter Property="Background" Value="{DynamicResource BrushInfoSoft}"/>
        </Style>
        
        <!-- Detail flyout panel style -->
        <Style Selector="Border.detail-panel">
            <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RenderTransform" Value="translate(400px, 0)"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="CubicEaseOut"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.detail-panel.open">
            <Setter Property="RenderTransform" Value="translate(0, 0)"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        
        <!-- Flyout Tab Button - Matches navigation rail style -->
        <Style Selector="Button.flyout-tab">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Padding" Value="8,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Width" Value="52"/>
        </Style>
        <Style Selector="Button.flyout-tab PathIcon">
            <Setter Property="Foreground" Value="#94A3B8"/>
        </Style>
        <Style Selector="Button.flyout-tab TextBlock">
            <Setter Property="Foreground" Value="#94A3B8"/>
        </Style>
        <Style Selector="Button.flyout-tab:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushSecondaryHover}"/>
        </Style>
        <Style Selector="Button.flyout-tab:pointerover PathIcon">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.flyout-tab:pointerover TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.flyout-tab.selected">
            <Setter Property="Background" Value="{DynamicResource BrushSecondaryHover}"/>
        </Style>
        <Style Selector="Button.flyout-tab.selected PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource BrushHighlight}"/>
        </Style>
        <Style Selector="Button.flyout-tab.selected TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        
        <!-- Detail Section Header -->
        <Style Selector="TextBlock.detail-section-header">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextTertiary}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        
        <!-- Link item card style -->
        <Style Selector="Border.link-item">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Border.link-item:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushSecondaryHover}"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*">
        
        <!-- Row 0: Header with title, stats, and actions -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- Title and subtitle -->
            <TextBlock Grid.Column="0" 
                       Text="{markup:Localize Key=Projects_Subtitle}"
                       FontSize="13" 
                       Foreground="{DynamicResource BrushTextSecondary}"
                       VerticalAlignment="Center"/>
            
            <!-- Stats -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="0,0,16,0">
                <!-- Refresh Status Chip (Updating.../Updated) -->
                <Border Background="{DynamicResource BrushSurfaceSecondary}" 
                        CornerRadius="10" 
                        Padding="8,4"
                        VerticalAlignment="Center"
                        IsVisible="{Binding ShowRefreshStatus}">
                    <Border.Transitions>
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.25" Easing="CubicEaseOut"/>
                        </Transitions>
                    </Border.Transitions>
                    <TextBlock Text="{Binding RefreshStatusText}" 
                               FontSize="11" 
                               Foreground="{DynamicResource BrushTextSecondary}"/>
                </Border>
                <Border Classes="stat-card">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{Binding TotalProjectsCount}"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                        <TextBlock Text="{markup:Localize Key=Projects_Total}"
                                   FontSize="11"
                                   Foreground="{DynamicResource BrushTextSecondary}"/>
                    </StackPanel>
                </Border>
                <Border Classes="stat-card">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{Binding ActiveProjectsCount}"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource BrushSuccess}"/>
                        <TextBlock Text="{markup:Localize Key=Status_Active}"
                                   FontSize="11"
                                   Foreground="{DynamicResource BrushTextSecondary}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            
            <!-- Actions -->
            <Button Grid.Column="2"
                    Classes="primary"
                    Command="{Binding ShowCreateDialogCommand}"
                    ToolTip.Tip="Create a new project">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="14"/>
                    <TextBlock Text="{markup:Localize Key=Projects_NewProject}"/>
                </StackPanel>
            </Button>
        </Grid>
        
        <!-- Row 1: Filter tabs -->
        <Border Grid.Row="1" 
                Background="{DynamicResource BrushSurfaceAlt}"
                CornerRadius="8"
                Margin="0,0,0,16"
                Padding="4">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Classes="tab-button"
                        Classes.selected="{Binding IsStatusAll}"
                        Command="{Binding SetStatusFilterCommand}"
                        CommandParameter="0"
                        Content="{markup:Localize Key=Projects_AllProjects}"/>
                <Button Classes="tab-button"
                        Classes.selected="{Binding IsStatusActive}"
                        Command="{Binding SetStatusFilterCommand}"
                        CommandParameter="1"
                        Content="{markup:Localize Key=Status_Active}"/>
                <Button Classes="tab-button"
                        Classes.selected="{Binding IsStatusPaused}"
                        Command="{Binding SetStatusFilterCommand}"
                        CommandParameter="2"
                        Content="{markup:Localize Key=Projects_Paused}"/>
                <Button Classes="tab-button"
                        Classes.selected="{Binding IsStatusCompleted}"
                        Command="{Binding SetStatusFilterCommand}"
                        CommandParameter="3"
                        Content="{markup:Localize Key=Status_Completed}"/>
            </StackPanel>
        </Border>

        <!-- Row 2: Main content area -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- Projects List -->
            <ScrollViewer Grid.Column="0" 
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Margin="0,0,16,0">
                
                <!-- Loading indicator -->
                <Panel>
                    <ProgressBar IsIndeterminate="True"
                                 IsVisible="{Binding IsLoading}"
                                 Height="4"
                                 VerticalAlignment="Top"/>
                    
                    <!-- Error message -->
                    <Border IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            Background="{DynamicResource BrushDangerSoft}"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,8,0,0"
                            VerticalAlignment="Top">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{DynamicResource BrushDanger}"
                                   TextWrapping="Wrap"/>
                    </Border>
                    
                    <!-- Empty state: No projects at all -->
                    <StackPanel IsVisible="{Binding HasNoProjects}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Spacing="16">
                        <PathIcon Data="M10 4H4C2.89 4 2 4.89 2 6V18C2 19.11 2.89 20 4 20H20C21.11 20 22 19.11 22 18V8C22 6.89 21.11 6 20 6H12L10 4Z"
                                  Width="48" Height="48"
                                  Foreground="{DynamicResource BrushTextTertiary}"/>
                        <TextBlock Text="{markup:Localize Key=Projects_NoProjectsYet}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{markup:Localize Key=Projects_CreateFirstProject}"
                                   FontSize="13"
                                   Foreground="{DynamicResource BrushTextTertiary}"
                                   HorizontalAlignment="Center"/>
                        <Button Classes="primary"
                                Command="{Binding ShowCreateDialogCommand}"
                                HorizontalAlignment="Center"
                                Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="14"/>
                                <TextBlock Text="{markup:Localize Key=Projects_CreateProject}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    
                    <!-- Empty state: No projects match filter -->
                    <StackPanel IsVisible="{Binding HasNoFilteredResults}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Spacing="12">
                        <PathIcon Data="M15.5 14H14.71L14.43 13.73C15.41 12.59 16 11.11 16 9.5C16 5.91 13.09 3 9.5 3S3 5.91 3 9.5S5.91 16 9.5 16C11.11 16 12.59 15.41 13.73 14.43L14 14.71V15.5L19 20.49L20.49 19L15.5 14M9.5 14C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5S14 7.01 14 9.5S11.99 14 9.5 14Z"
                                  Width="40" Height="40"
                                  Foreground="{DynamicResource BrushTextTertiary}"/>
                        <TextBlock Text="{markup:Localize Key=Projects_NoProjectsMatchFilter}"
                                   FontSize="16"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   HorizontalAlignment="Center"/>
                        <Button Classes="ghost"
                                Command="{Binding SetStatusFilterCommand}"
                                CommandParameter="0"
                                Content="{markup:Localize Key=Projects_ViewAllProjects}"
                                HorizontalAlignment="Center"/>
                    </StackPanel>
                    
                    <!-- Projects list -->
                    <ItemsControl ItemsSource="{Binding Projects}"
                                  IsVisible="{Binding HasProjects}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:Project}">
                                <Border Classes="project-card"
                                        Classes.completed="{Binding IsCompleted}"
                                        PointerPressed="OnProjectCardPressed">
                                    <Grid RowDefinitions="Auto,Auto,Auto">
                                        <!-- Header: Name and status -->
                                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Name}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource BrushTextPrimary}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Border Grid.Column="1"
                                                    Classes="status-badge"
                                                    Classes.active="{Binding IsActive}"
                                                    Classes.paused="{Binding IsPaused}"
                                                    Classes.completed="{Binding IsCompleted}">
                                                <TextBlock Text="{Binding StatusDisplay}"
                                                           FontSize="11"
                                                           FontWeight="Medium"
                                                           Foreground="{DynamicResource BrushTextPrimary}"/>
                                            </Border>
                                        </Grid>
                                        
                                        <!-- Description -->
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Description}"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="2"
                                                   Margin="0,8,0,0"
                                                   IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        
                                        <!-- Footer: Due date and counts -->
                                        <StackPanel Grid.Row="2" 
                                                    Orientation="Horizontal" 
                                                    Spacing="16"
                                                    Margin="0,12,0,0">
                                            <!-- Due date -->
                                            <StackPanel Orientation="Horizontal" 
                                                        Spacing="6"
                                                        IsVisible="{Binding DueDate, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                <TextBlock Text="&#xE787;"
                                                           FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource BrushTextTertiary}"/>
                                                <TextBlock Text="{Binding DueDate, StringFormat='{}{0:MMM d, yyyy}'}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource BrushTextTertiary}"/>
                                            </StackPanel>
                                            
                                            <!-- Member count -->
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="&#xE77B;"
                                                           FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource BrushTextTertiary}"/>
                                                <TextBlock Text="{Binding MemberCount}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource BrushTextTertiary}"/>
                                            </StackPanel>
                                            
                                            <!-- Link count -->
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="&#xE71B;"
                                                           FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource BrushTextTertiary}"/>
                                                <TextBlock Text="{Binding LinkCount}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource BrushTextTertiary}"/>
                                            </StackPanel>
                                            
                                            <!-- Signal badges (overdue tasks + goals needing attention) -->
                                            <Border Background="{DynamicResource BrushWarningSoft}"
                                                    CornerRadius="10"
                                                    Padding="8,2"
                                                    IsVisible="{Binding HasSignals}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <!-- Overdue tasks badge -->
                                                    <StackPanel Orientation="Horizontal" Spacing="4"
                                                                IsVisible="{Binding OverdueTaskCount, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                        <TextBlock Text="&#xE783;"
                                                                   FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource BrushWarning}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding OverdueTaskCount}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource BrushWarning}"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <!-- Goals needing attention badge -->
                                                    <StackPanel Orientation="Horizontal" Spacing="4"
                                                                IsVisible="{Binding GoalsNeedingAttention, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                        <TextBlock Text="&#xE734;"
                                                                   FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource BrushWarning}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding GoalsNeedingAttention}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource BrushWarning}"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Panel>
            </ScrollViewer>
            
            <!-- Detail Panel (slides in from right) -->
            <Border Grid.Column="1"
                    Classes="detail-panel"
                    Classes.open="{Binding IsDetailFlyoutOpen}"
                    Width="400"
                    IsVisible="{Binding HasSelectedProject}">
                <Grid RowDefinitions="Auto,*">
                    
                    <!-- Top Header Bar - Navy like other flyouts -->
                    <Border Grid.Row="0" Background="{DynamicResource BrushSecondary}" CornerRadius="8,8,0,0" Padding="16,12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" 
                                       Text="{Binding SelectedProject.Name}"
                                       FontSize="14" FontWeight="SemiBold" 
                                       Foreground="White" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <Button Grid.Column="1" Classes="icon-button" ToolTip.Tip="Close"
                                    Command="{Binding CloseDetailCommand}">
                                <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                          Width="14" Height="14" Foreground="White"/>
                            </Button>
                        </Grid>
                    </Border>
                    
                    <!-- Content with vertical tabs -->
                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
                    
                    <!-- Vertical Tab Bar - Navy blue like navigation -->
                    <Border Grid.Column="0" Background="{DynamicResource BrushSecondary}" CornerRadius="0,0,0,12">
                        <StackPanel Spacing="2" Margin="0,8">
                            <Button Classes="flyout-tab" ToolTip.Tip="Overview"
                                    Classes.selected="{Binding ProjectDetailTab, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:ProjectDetailTab.Overview}}"
                                    Command="{Binding SetProjectDetailTabCommand}" CommandParameter="{x:Static vm:ProjectDetailTab.Overview}">
                                <StackPanel Spacing="4">
                                    <PathIcon Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12,6A6,6 0 0,0 6,12A6,6 0 0,0 12,18A6,6 0 0,0 18,12A6,6 0 0,0 12,6M12,8A4,4 0 0,1 16,12A4,4 0 0,1 12,16A4,4 0 0,1 8,12A4,4 0 0,1 12,8Z"
                                              Width="16" Height="16"/>
                                    <TextBlock Text="{markup:Localize Key=Projects_Info}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="flyout-tab" ToolTip.Tip="Goals"
                                    Classes.selected="{Binding ProjectDetailTab, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:ProjectDetailTab.Goals}}"
                                    Command="{Binding SetProjectDetailTabCommand}" CommandParameter="{x:Static vm:ProjectDetailTab.Goals}">
                                <StackPanel Spacing="4">
                                    <PathIcon Data="M19,3H14.82C14.4,1.84 13.3,1 12,1C10.7,1 9.6,1.84 9.18,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M12,3A1,1 0 0,1 13,4A1,1 0 0,1 12,5A1,1 0 0,1 11,4A1,1 0 0,1 12,3M7,7H17V5H19V19H5V5H7V7M7.5,13.5L9,12L11,14L15.5,9.5L17,11L11,17L7.5,13.5Z"
                                              Width="16" Height="16"/>
                                    <TextBlock Text="{markup:Localize Key=Nav_Goals}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="flyout-tab" ToolTip.Tip="Tasks"
                                    Classes.selected="{Binding ProjectDetailTab, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:ProjectDetailTab.Tasks}}"
                                    Command="{Binding SetProjectDetailTabCommand}" CommandParameter="{x:Static vm:ProjectDetailTab.Tasks}">
                                <StackPanel Spacing="4">
                                    <PathIcon Data="M3,5H9V11H3V5M5,7V9H7V7H5M11,7H21V9H11V7M11,15H21V17H11V15M5,20L1.5,16.5L2.91,15.09L5,17.17L9.59,12.59L11,14L5,20Z"
                                              Width="16" Height="16"/>
                                    <TextBlock Text="{markup:Localize Key=Circle_Tasks}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="flyout-tab" ToolTip.Tip="Meetings"
                                    Classes.selected="{Binding ProjectDetailTab, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:ProjectDetailTab.Meetings}}"
                                    Command="{Binding SetProjectDetailTabCommand}" CommandParameter="{x:Static vm:ProjectDetailTab.Meetings}">
                                <StackPanel Spacing="4">
                                    <PathIcon Data="M12,5.5A3.5,3.5 0 0,1 15.5,9A3.5,3.5 0 0,1 12,12.5A3.5,3.5 0 0,1 8.5,9A3.5,3.5 0 0,1 12,5.5M5,8C5.56,8 6.08,8.15 6.53,8.42C6.38,9.85 6.8,11.27 7.66,12.38C7.16,13.34 6.16,14 5,14A3,3 0 0,1 2,11A3,3 0 0,1 5,8M19,8A3,3 0 0,1 22,11A3,3 0 0,1 19,14C17.84,14 16.84,13.34 16.34,12.38C17.2,11.27 17.62,9.85 17.47,8.42C17.92,8.15 18.44,8 19,8M5.5,18.25C5.5,16.18 8.41,14.5 12,14.5C15.59,14.5 18.5,16.18 18.5,18.25V20H5.5V18.25Z"
                                              Width="16" Height="16"/>
                                    <TextBlock Text="{markup:Localize Key=Projects_Meets}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                    
                    <!-- Content Area -->
                    <Grid Grid.Column="1" RowDefinitions="*,Auto">
                        
                        <!-- ===== OVERVIEW TAB ===== -->
                        <ScrollViewer Grid.Row="0" 
                                      VerticalScrollBarVisibility="Auto"
                                      Padding="12,8,12,12"
                                      IsVisible="{Binding ProjectDetailTab, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:ProjectDetailTab.Overview}}">
                            <StackPanel Spacing="16">
                                <!-- Status Badge -->
                                <Border Classes="status-badge"
                                        Classes.active="{Binding SelectedProject.IsActive}"
                                        Classes.paused="{Binding SelectedProject.IsPaused}"
                                        Classes.completed="{Binding SelectedProject.IsCompleted}"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding SelectedProject.StatusDisplay}"
                                               FontSize="12"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource BrushTextPrimary}"/>
                                </Border>
                                
                                <!-- Status Change (owner only) -->
                                <StackPanel Spacing="6" IsVisible="{Binding IsCurrentUserOwner}">
                                    <TextBlock Text="{markup:Localize Key=Projects_ChangeStatus}" Classes="detail-section-header"/>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button Classes="secondary" Padding="8,4"
                                                Classes.primary="{Binding SelectedProject.IsActive}"
                                                Command="{Binding SetProjectStatusCommand}"
                                                CommandParameter="active">
                                            <TextBlock Text="{markup:Localize Key=Status_Active}" FontSize="11"/>
                                        </Button>
                                        <Button Classes="secondary" Padding="8,4"
                                                Classes.primary="{Binding SelectedProject.IsPaused}"
                                                Command="{Binding SetProjectStatusCommand}"
                                                CommandParameter="paused">
                                            <TextBlock Text="{markup:Localize Key=Projects_Paused}" FontSize="11"/>
                                        </Button>
                                        <Button Classes="secondary" Padding="8,4"
                                                Classes.primary="{Binding SelectedProject.IsCompleted}"
                                                Command="{Binding SetProjectStatusCommand}"
                                                CommandParameter="completed">
                                            <TextBlock Text="{markup:Localize Key=Status_Completed}" FontSize="11"/>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                                
                                <!-- Description -->
                                <StackPanel Spacing="4"
                                            IsVisible="{Binding SelectedProject.Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock Text="{markup:Localize Key=Label_Description}" Classes="detail-section-header"/>
                                    <TextBlock Text="{Binding SelectedProject.Description}"
                                               FontSize="13"
                                               Foreground="{DynamicResource BrushTextPrimary}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                
                                <!-- Due Date -->
                                <StackPanel Spacing="4"
                                            IsVisible="{Binding SelectedProject.DueDate, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <TextBlock Text="{markup:Localize Key=Projects_DueDate}" Classes="detail-section-header"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="M19,4H18V2H16V4H8V2H6V4H5C3.89,4 3,4.9 3,6V20A2,2 0 0,0 5,22H19A2,2 0 0,0 21,20V6A2,2 0 0,0 19,4M19,20H5V10H19V20M19,8H5V6H19V8Z"
                                                  Width="14" Height="14" Foreground="{DynamicResource BrushTextTertiary}"/>
                                        <TextBlock Text="{Binding SelectedProject.DueDate, StringFormat='{}{0:MMMM d, yyyy}'}"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                                    </StackPanel>
                                </StackPanel>
                                
                                <!-- Owner -->
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{markup:Localize Key=Label_Owner}" Classes="detail-section-header"/>
                                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding !SelectedProject.IsOrphaned}">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                            <Border Width="24" Height="24" CornerRadius="12"
                                                    Background="{DynamicResource BrushPrimary}">
                                                <TextBlock Text="{Binding SelectedProject.OwnerInitials}"
                                                           FontSize="10" FontWeight="SemiBold"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding SelectedProject.OwnerDisplayName}"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource BrushTextPrimary}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="secondary" Padding="6,3"
                                                Command="{Binding ShowOwnerSelectorCommand}"
                                                IsVisible="{Binding IsCurrentUserOwner}"
                                                ToolTip.Tip="Transfer ownership">
                                            <TextBlock Text="{markup:Localize Key=Projects_Transfer}" FontSize="11"/>
                                        </Button>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding SelectedProject.IsOrphaned}">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                            <PathIcon Data="M12,2L1,21H23M12,6L19.53,19H4.47M11,10V14H13V10M11,16V18H13V16"
                                                      Width="16" Height="16" Foreground="{DynamicResource BrushWarning}"/>
                                            <TextBlock Text="{markup:Localize Key=Projects_Unassigned}"
                                                       FontSize="13" FontWeight="Medium"
                                                       Foreground="{DynamicResource BrushWarning}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="secondary" Padding="6,3"
                                                Command="{Binding ShowOwnerSelectorCommand}"
                                                IsVisible="{Binding IsAdmin}"
                                                ToolTip.Tip="Assign owner">
                                            <TextBlock Text="{markup:Localize Key=Projects_Assign}" FontSize="11"/>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                                
                                <!-- Members -->
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{markup:Localize Key=Projects_Members}" Classes="detail-section-header"/>
                                    <ItemsControl ItemsSource="{Binding SelectedProject.Members}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:ProjectMember}">
                                                <Border Classes="link-item">
                                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                                        <Border Grid.Column="0" Width="24" Height="24" CornerRadius="12"
                                                                Background="{DynamicResource BrushTextTertiary}" Margin="0,0,8,0">
                                                            <PathIcon Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z"
                                                                      Width="12" Height="12" Foreground="White"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding TeamMember.DisplayName, FallbackValue='Team Member'}"
                                                                   FontSize="13"
                                                                   Foreground="{DynamicResource BrushTextPrimary}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding RoleDisplay}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource BrushTextTertiary}"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{markup:Localize Key=Projects_NoMembersAddedYet}"
                                               FontSize="12"
                                               Foreground="{DynamicResource BrushTextTertiary}"
                                               IsVisible="{Binding !SelectedProject.Members.Count}"/>
                                </StackPanel>
                                
                                <!-- Chronicle Notes -->
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{markup:Localize Key=Projects_ChronicleNotes}" Classes="detail-section-header"/>
                                    <ItemsControl ItemsSource="{Binding LinkedNotes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:Note">
                                                <Button Classes="ghost"
                                                        Command="{Binding $parent[UserControl].((vm:ProjectsViewModel)DataContext).OpenNoteCommand}"
                                                        CommandParameter="{Binding}"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Stretch"
                                                        Padding="0" Margin="0,0,0,4">
                                                    <Border Classes="link-item" Margin="0">
                                                        <Grid ColumnDefinitions="Auto,*">
                                                            <PathIcon Grid.Column="0"
                                                                      Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M14,18H6V16H14V18M16,14H6V12H16V14M13,9V3.5L18.5,9H13Z"
                                                                      Width="14" Height="14"
                                                                      Foreground="{DynamicResource BrushTextTertiary}"
                                                                      Margin="0,0,10,0"/>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding DisplayTitle}"
                                                                       FontSize="13"
                                                                       Foreground="{DynamicResource BrushTextPrimary}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{markup:Localize Key=Projects_NoChronicleNotesLinked}"
                                               FontSize="12"
                                               Foreground="{DynamicResource BrushTextTertiary}"
                                               IsVisible="{Binding !HasLinkedNotes}"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                        
                        <!-- ===== GOALS TAB ===== -->
                        <ScrollViewer Grid.Row="0" 
                                      VerticalScrollBarVisibility="Auto"
                                      Padding="12,8,12,12"
                                      IsVisible="{Binding ProjectDetailTab, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:ProjectDetailTab.Goals}}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{markup:Localize Key=Projects_LinkedGoals}" Classes="detail-section-header" Margin="0,8,0,8"/>
                                <ItemsControl ItemsSource="{Binding LinkedGoals}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:ProjectLink}">
                                            <Border Classes="link-item">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <PathIcon Grid.Column="0"
                                                              Data="M19,3H14.82C14.4,1.84 13.3,1 12,1C10.7,1 9.6,1.84 9.18,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M12,3A1,1 0 0,1 13,4A1,1 0 0,1 12,5A1,1 0 0,1 11,4A1,1 0 0,1 12,3M7,7H17V5H19V19H5V5H7V7M7.5,13.5L9,12L11,14L15.5,9.5L17,11L11,17L7.5,13.5Z"
                                                              Width="16" Height="16"
                                                              Foreground="{DynamicResource BrushHighlight}"
                                                              Margin="0,0,10,0"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding DisplayTitle}"
                                                               FontSize="13"
                                                               Foreground="{DynamicResource BrushTextPrimary}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel IsVisible="{Binding !HasLinkedGoals}" 
                                            HorizontalAlignment="Center" 
                                            Margin="0,32,0,0" Spacing="8">
                                    <PathIcon Data="M19,3H14.82C14.4,1.84 13.3,1 12,1C10.7,1 9.6,1.84 9.18,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M12,3A1,1 0 0,1 13,4A1,1 0 0,1 12,5A1,1 0 0,1 11,4A1,1 0 0,1 12,3"
                                              Width="32" Height="32" Foreground="{DynamicResource BrushTextTertiary}"
                                              HorizontalAlignment="Center" Opacity="0.5"/>
                                    <TextBlock Text="{markup:Localize Key=Projects_NoGoalsLinked}"
                                               FontSize="13"
                                               Foreground="{DynamicResource BrushTextTertiary}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{markup:Localize Key=Projects_LinkGoalsFromCircle}"
                                               FontSize="11"
                                               Foreground="{DynamicResource BrushTextTertiary}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                        
                        <!-- ===== TASKS TAB ===== -->
                        <ScrollViewer Grid.Row="0" 
                                      VerticalScrollBarVisibility="Auto"
                                      Padding="12,8,12,12"
                                      IsVisible="{Binding ProjectDetailTab, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:ProjectDetailTab.Tasks}}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{markup:Localize Key=Projects_LinkedTasks}" Classes="detail-section-header" Margin="0,8,0,8"/>
                                <ItemsControl ItemsSource="{Binding LinkedTasks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:ProjectLink}">
                                            <Border Classes="link-item">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <PathIcon Grid.Column="0"
                                                              Data="M3,5H9V11H3V5M5,7V9H7V7H5M11,7H21V9H11V7M11,15H21V17H11V15M5,20L1.5,16.5L2.91,15.09L5,17.17L9.59,12.59L11,14L5,20Z"
                                                              Width="16" Height="16"
                                                              Foreground="{DynamicResource BrushInfo}"
                                                              Margin="0,0,10,0"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding DisplayTitle}"
                                                               FontSize="13"
                                                               Foreground="{DynamicResource BrushTextPrimary}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel IsVisible="{Binding !HasLinkedTasks}" 
                                            HorizontalAlignment="Center" 
                                            Margin="0,32,0,0" Spacing="8">
                                    <PathIcon Data="M3,5H9V11H3V5M5,7V9H7V7H5M11,7H21V9H11V7M11,15H21V17H11V15M5,20L1.5,16.5L2.91,15.09L5,17.17L9.59,12.59L11,14L5,20Z"
                                              Width="32" Height="32" Foreground="{DynamicResource BrushTextTertiary}"
                                              HorizontalAlignment="Center" Opacity="0.5"/>
                                    <TextBlock Text="{markup:Localize Key=Projects_NoTasksLinked}"
                                               FontSize="13"
                                               Foreground="{DynamicResource BrushTextTertiary}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{markup:Localize Key=Projects_LinkTasksFromPulse}"
                                               FontSize="11"
                                               Foreground="{DynamicResource BrushTextTertiary}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                        
                        <!-- ===== MEETINGS TAB ===== -->
                        <ScrollViewer Grid.Row="0" 
                                      VerticalScrollBarVisibility="Auto"
                                      Padding="12,8,12,12"
                                      IsVisible="{Binding ProjectDetailTab, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:ProjectDetailTab.Meetings}}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{markup:Localize Key=Projects_LinkedMeetings}" Classes="detail-section-header" Margin="0,8,0,8"/>
                                <ItemsControl ItemsSource="{Binding LinkedMeetings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:ProjectLink}">
                                            <Border Classes="link-item">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <PathIcon Grid.Column="0"
                                                              Data="M12,5.5A3.5,3.5 0 0,1 15.5,9A3.5,3.5 0 0,1 12,12.5A3.5,3.5 0 0,1 8.5,9A3.5,3.5 0 0,1 12,5.5M5,8C5.56,8 6.08,8.15 6.53,8.42C6.38,9.85 6.8,11.27 7.66,12.38C7.16,13.34 6.16,14 5,14A3,3 0 0,1 2,11A3,3 0 0,1 5,8M19,8A3,3 0 0,1 22,11A3,3 0 0,1 19,14C17.84,14 16.84,13.34 16.34,12.38C17.2,11.27 17.62,9.85 17.47,8.42C17.92,8.15 18.44,8 19,8M5.5,18.25C5.5,16.18 8.41,14.5 12,14.5C15.59,14.5 18.5,16.18 18.5,18.25V20H5.5V18.25Z"
                                                              Width="16" Height="16"
                                                              Foreground="{DynamicResource BrushPrimary}"
                                                              Margin="0,0,10,0"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding DisplayTitle}"
                                                               FontSize="13"
                                                               Foreground="{DynamicResource BrushTextPrimary}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel IsVisible="{Binding !HasLinkedMeetings}" 
                                            HorizontalAlignment="Center" 
                                            Margin="0,32,0,0" Spacing="8">
                                    <PathIcon Data="M12,5.5A3.5,3.5 0 0,1 15.5,9A3.5,3.5 0 0,1 12,12.5A3.5,3.5 0 0,1 8.5,9A3.5,3.5 0 0,1 12,5.5M5,8C5.56,8 6.08,8.15 6.53,8.42C6.38,9.85 6.8,11.27 7.66,12.38"
                                              Width="32" Height="32" Foreground="{DynamicResource BrushTextTertiary}"
                                              HorizontalAlignment="Center" Opacity="0.5"/>
                                    <TextBlock Text="{markup:Localize Key=Projects_NoMeetingsLinked}"
                                               FontSize="13"
                                               Foreground="{DynamicResource BrushTextTertiary}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{markup:Localize Key=Projects_LinkMeetingsFromCircle}"
                                               FontSize="11"
                                               Foreground="{DynamicResource BrushTextTertiary}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                        
                        <!-- Footer actions -->
                        <Border Grid.Row="1" 
                                BorderBrush="{DynamicResource BrushBorder}"
                                BorderThickness="0,1,0,0"
                                Padding="12,10">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button Classes="ghost danger" Padding="8,6"
                                        Command="{Binding DeleteProjectCommand}"
                                        ToolTip.Tip="Delete project">
                                    <PathIcon Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"
                                              Width="14" Height="14"/>
                                </Button>
                                <Button Classes="secondary" Padding="12,6"
                                        Command="{Binding EditProjectCommand}">
                                    <TextBlock Text="{markup:Localize Key=Button_Edit}" FontSize="12"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>