<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ProCohere.Avalonia.ViewModels"
             xmlns:models="using:ProCohere.Avalonia.Models"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="ProCohere.Avalonia.Views.ProjectsView"
             x:DataType="vm:ProjectsViewModel">
    
    <Design.DataContext>
        <vm:ProjectsViewModel/>
    </Design.DataContext>

    <UserControl.Styles>
        <!-- Tab Button Style -->
        <Style Selector="Button.tab-button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style Selector="Button.tab-button /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.tab-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        </Style>
        <Style Selector="Button.tab-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}"/>
        </Style>
        <Style Selector="Button.tab-button.selected">
            <Setter Property="Foreground" Value="{DynamicResource BrushPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.tab-button.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        
        <!-- Stat card style -->
        <Style Selector="Border.stat-card">
            <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinWidth" Value="100"/>
        </Style>
        
        <!-- Project card style -->
        <Style Selector="Border.project-card">
            <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Border.project-card:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceHover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}"/>
        </Style>
        <!-- Completed project cards are subdued -->
        <Style Selector="Border.project-card.completed">
            <Setter Property="Opacity" Value="0.65"/>
        </Style>
        <Style Selector="Border.project-card.completed:pointerover">
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
        
        <!-- Status badge style -->
        <Style Selector="Border.status-badge">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        <Style Selector="Border.status-badge.active">
            <Setter Property="Background" Value="{DynamicResource BrushSuccessSoft}"/>
        </Style>
        <Style Selector="Border.status-badge.paused">
            <Setter Property="Background" Value="{DynamicResource BrushWarningSoft}"/>
        </Style>
        <Style Selector="Border.status-badge.completed">
            <Setter Property="Background" Value="{DynamicResource BrushInfoSoft}"/>
        </Style>
        
        <!-- Detail flyout panel style -->
        <Style Selector="Border.detail-panel">
            <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RenderTransform" Value="translate(400px, 0)"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="CubicEaseOut"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.detail-panel.open">
            <Setter Property="RenderTransform" Value="translate(0, 0)"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*">
        
        <!-- Row 0: Header with title, stats, and actions -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- Title and subtitle -->
            <TextBlock Grid.Column="0" 
                       Text="Initiatives that organize long-term work"
                       FontSize="13" 
                       Foreground="{DynamicResource BrushTextSecondary}"
                       VerticalAlignment="Center"/>
            
            <!-- Stats -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="0,0,16,0">
                <Border Classes="stat-card">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{Binding TotalProjectsCount}"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                        <TextBlock Text="Total"
                                   FontSize="11"
                                   Foreground="{DynamicResource BrushTextSecondary}"/>
                    </StackPanel>
                </Border>
                <Border Classes="stat-card">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{Binding ActiveProjectsCount}"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource BrushSuccess}"/>
                        <TextBlock Text="Active"
                                   FontSize="11"
                                   Foreground="{DynamicResource BrushTextSecondary}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            
            <!-- Actions -->
            <Button Grid.Column="2"
                    Classes="primary"
                    Command="{Binding ShowCreateDialogCommand}"
                    ToolTip.Tip="Create a new project">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="14"/>
                    <TextBlock Text="New Project"/>
                </StackPanel>
            </Button>
        </Grid>
        
        <!-- Row 1: Filter tabs -->
        <Border Grid.Row="1" 
                Background="{DynamicResource BrushSurfaceAlt}"
                CornerRadius="8"
                Margin="0,0,0,16"
                Padding="4">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Classes="tab-button"
                        Classes.selected="{Binding IsStatusAll}"
                        Command="{Binding SetStatusFilterCommand}"
                        CommandParameter="0"
                        Content="All Projects"/>
                <Button Classes="tab-button"
                        Classes.selected="{Binding IsStatusActive}"
                        Command="{Binding SetStatusFilterCommand}"
                        CommandParameter="1"
                        Content="Active"/>
                <Button Classes="tab-button"
                        Classes.selected="{Binding IsStatusPaused}"
                        Command="{Binding SetStatusFilterCommand}"
                        CommandParameter="2"
                        Content="Paused"/>
                <Button Classes="tab-button"
                        Classes.selected="{Binding IsStatusCompleted}"
                        Command="{Binding SetStatusFilterCommand}"
                        CommandParameter="3"
                        Content="Completed"/>
            </StackPanel>
        </Border>

        <!-- Row 2: Main content area -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- Projects List -->
            <ScrollViewer Grid.Column="0" 
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Margin="0,0,16,0">
                
                <!-- Loading indicator -->
                <Panel>
                    <ProgressBar IsIndeterminate="True"
                                 IsVisible="{Binding IsLoading}"
                                 Height="4"
                                 VerticalAlignment="Top"/>
                    
                    <!-- Error message -->
                    <Border IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            Background="{DynamicResource BrushDangerSoft}"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,8,0,0"
                            VerticalAlignment="Top">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{DynamicResource BrushDanger}"
                                   TextWrapping="Wrap"/>
                    </Border>
                    
                    <!-- Empty state: No projects at all -->
                    <StackPanel IsVisible="{Binding HasNoProjects}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Spacing="16">
                        <PathIcon Data="M10 4H4C2.89 4 2 4.89 2 6V18C2 19.11 2.89 20 4 20H20C21.11 20 22 19.11 22 18V8C22 6.89 21.11 6 20 6H12L10 4Z"
                                  Width="48" Height="48"
                                  Foreground="{DynamicResource BrushTextTertiary}"/>
                        <TextBlock Text="No projects yet"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Create your first project to organize long-term work"
                                   FontSize="13"
                                   Foreground="{DynamicResource BrushTextTertiary}"
                                   HorizontalAlignment="Center"/>
                        <Button Classes="primary"
                                Command="{Binding ShowCreateDialogCommand}"
                                HorizontalAlignment="Center"
                                Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="14"/>
                                <TextBlock Text="Create Project"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    
                    <!-- Empty state: No projects match filter -->
                    <StackPanel IsVisible="{Binding HasNoFilteredResults}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Spacing="12">
                        <PathIcon Data="M15.5 14H14.71L14.43 13.73C15.41 12.59 16 11.11 16 9.5C16 5.91 13.09 3 9.5 3S3 5.91 3 9.5S5.91 16 9.5 16C11.11 16 12.59 15.41 13.73 14.43L14 14.71V15.5L19 20.49L20.49 19L15.5 14M9.5 14C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5S14 7.01 14 9.5S11.99 14 9.5 14Z"
                                  Width="40" Height="40"
                                  Foreground="{DynamicResource BrushTextTertiary}"/>
                        <TextBlock Text="No projects match this filter"
                                   FontSize="16"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   HorizontalAlignment="Center"/>
                        <Button Classes="ghost"
                                Command="{Binding SetStatusFilterCommand}"
                                CommandParameter="0"
                                Content="View all projects"
                                HorizontalAlignment="Center"/>
                    </StackPanel>
                    
                    <!-- Projects list -->
                    <ItemsControl ItemsSource="{Binding Projects}"
                                  IsVisible="{Binding HasProjects}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:Project}">
                                <Border Classes="project-card"
                                        Classes.completed="{Binding IsCompleted}"
                                        PointerPressed="OnProjectCardPressed">
                                    <Grid RowDefinitions="Auto,Auto,Auto">
                                        <!-- Header: Name and status -->
                                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Name}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource BrushTextPrimary}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Border Grid.Column="1"
                                                    Classes="status-badge"
                                                    Classes.active="{Binding IsActive}"
                                                    Classes.paused="{Binding IsPaused}"
                                                    Classes.completed="{Binding IsCompleted}">
                                                <TextBlock Text="{Binding StatusDisplay}"
                                                           FontSize="11"
                                                           FontWeight="Medium"
                                                           Foreground="{DynamicResource BrushTextPrimary}"/>
                                            </Border>
                                        </Grid>
                                        
                                        <!-- Description -->
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Description}"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="2"
                                                   Margin="0,8,0,0"
                                                   IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        
                                        <!-- Footer: Due date and counts -->
                                        <StackPanel Grid.Row="2" 
                                                    Orientation="Horizontal" 
                                                    Spacing="16"
                                                    Margin="0,12,0,0">
                                            <!-- Due date -->
                                            <StackPanel Orientation="Horizontal" 
                                                        Spacing="6"
                                                        IsVisible="{Binding DueDate, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                <TextBlock Text="&#xE787;"
                                                           FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource BrushTextTertiary}"/>
                                                <TextBlock Text="{Binding DueDate, StringFormat='{}{0:MMM d, yyyy}'}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource BrushTextTertiary}"/>
                                            </StackPanel>
                                            
                                            <!-- Member count -->
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="&#xE77B;"
                                                           FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource BrushTextTertiary}"/>
                                                <TextBlock Text="{Binding MemberCount}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource BrushTextTertiary}"/>
                                            </StackPanel>
                                            
                                            <!-- Link count -->
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="&#xE71B;"
                                                           FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource BrushTextTertiary}"/>
                                                <TextBlock Text="{Binding LinkCount}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource BrushTextTertiary}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Panel>
            </ScrollViewer>
            
            <!-- Detail Panel (slides in from right) -->
            <Border Grid.Column="1"
                    Classes="detail-panel"
                    Classes.open="{Binding IsDetailFlyoutOpen}"
                    Width="400"
                    IsVisible="{Binding HasSelectedProject}">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Header -->
                    <Border Grid.Row="0" 
                            Background="{DynamicResource BrushSurfaceAlt}"
                            CornerRadius="12,12,0,0"
                            Padding="20,16">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding SelectedProject.Name}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextPrimary}"
                                       TextTrimming="CharacterEllipsis"/>
                            <Button Grid.Column="1"
                                    Classes="ghost"
                                    Command="{Binding CloseDetailCommand}"
                                    ToolTip.Tip="Close">
                                <TextBlock Text="&#xE8BB;"
                                           FontFamily="{StaticResource SymbolThemeFontFamily}"
                                           FontSize="14"/>
                            </Button>
                        </Grid>
                    </Border>
                    
                    <!-- Content -->
                    <ScrollViewer Grid.Row="1" Padding="20,16">
                        <StackPanel Spacing="20">
                            <!-- Status (owner can change) -->
                            <StackPanel Spacing="8" IsVisible="{Binding IsCurrentUserOwner}">
                                <TextBlock Text="Status"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushTextSecondary}"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Classes="secondary"
                                            Classes.primary="{Binding SelectedProject.IsActive}"
                                            Command="{Binding SetProjectStatusCommand}"
                                            CommandParameter="active"
                                            Content="Active"/>
                                    <Button Classes="secondary"
                                            Classes.primary="{Binding SelectedProject.IsPaused}"
                                            Command="{Binding SetProjectStatusCommand}"
                                            CommandParameter="paused"
                                            Content="Paused"/>
                                    <Button Classes="secondary"
                                            Classes.primary="{Binding SelectedProject.IsCompleted}"
                                            Command="{Binding SetProjectStatusCommand}"
                                            CommandParameter="completed"
                                            Content="Completed"/>
                                </StackPanel>
                            </StackPanel>
                            
                            <!-- Status (read-only for non-owners) -->
                            <StackPanel Spacing="8" IsVisible="{Binding !IsCurrentUserOwner}">
                                <TextBlock Text="Status"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushTextSecondary}"/>
                                <Border Classes="status-badge"
                                        Classes.active="{Binding SelectedProject.IsActive}"
                                        Classes.paused="{Binding SelectedProject.IsPaused}"
                                        Classes.completed="{Binding SelectedProject.IsCompleted}"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding SelectedProject.StatusDisplay}"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource BrushTextPrimary}"/>
                                </Border>
                            </StackPanel>
                            
                            <!-- Owner Section -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="Owner"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushTextSecondary}"/>
                                
                                <!-- Normal owner display (not orphaned) -->
                                <Grid ColumnDefinitions="*,Auto"
                                      IsVisible="{Binding !SelectedProject.IsOrphaned}">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <!-- Owner avatar with initials -->
                                        <Border Width="28" Height="28"
                                                CornerRadius="14"
                                                Background="{DynamicResource BrushPrimary}">
                                            <TextBlock Text="{Binding SelectedProject.OwnerInitials}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding SelectedProject.OwnerDisplayName}"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource BrushTextPrimary}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <!-- Transfer button (visible only to current owner) -->
                                    <Button Grid.Column="1" 
                                            Classes="secondary"
                                            Padding="8,4"
                                            Command="{Binding ShowOwnerSelectorCommand}"
                                            IsVisible="{Binding IsCurrentUserOwner}"
                                            ToolTip.Tip="Transfer ownership">
                                        <TextBlock Text="Transfer" FontSize="12"/>
                                    </Button>
                                </Grid>
                                
                                <!-- Orphaned project display -->
                                <Grid ColumnDefinitions="*,Auto"
                                      IsVisible="{Binding SelectedProject.IsOrphaned}">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <!-- Warning icon -->
                                        <PathIcon Data="M12,2L1,21H23M12,6L19.53,19H4.47M11,10V14H13V10M11,16V18H13V16"
                                                  Width="18" Height="18"
                                                  Foreground="{DynamicResource BrushWarning}"/>
                                        <TextBlock Text="Unassigned"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource BrushWarning}"
                                                   FontWeight="Medium"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <!-- Assign owner button (visible only to admins) -->
                                    <Button Grid.Column="1" 
                                            Classes="secondary"
                                            Padding="8,4"
                                            Command="{Binding ShowOwnerSelectorCommand}"
                                            IsVisible="{Binding IsAdmin}"
                                            ToolTip.Tip="Assign owner">
                                        <TextBlock Text="Assign Owner" FontSize="12"/>
                                    </Button>
                                </Grid>
                            </StackPanel>
                            
                            <!-- Description -->
                            <StackPanel Spacing="8" 
                                        IsVisible="{Binding SelectedProject.Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="Description"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushTextSecondary}"/>
                                <TextBlock Text="{Binding SelectedProject.Description}"
                                           FontSize="14"
                                           Foreground="{DynamicResource BrushTextPrimary}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            
                            <!-- Due Date -->
                            <StackPanel Spacing="8"
                                        IsVisible="{Binding SelectedProject.DueDate, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <TextBlock Text="Due Date"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushTextSecondary}"/>
                                <TextBlock Text="{Binding SelectedProject.DueDate, StringFormat='{}{0:MMMM d, yyyy}'}"
                                           FontSize="14"
                                           Foreground="{DynamicResource BrushTextPrimary}"/>
                            </StackPanel>
                            
                            <!-- Members -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="Members"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushTextSecondary}"/>
                                <ItemsControl ItemsSource="{Binding SelectedProject.Members}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:ProjectMember}">
                                            <Border Background="{DynamicResource BrushSurfaceAlt}"
                                                    CornerRadius="8"
                                                    Padding="12,8"
                                                    Margin="0,0,0,8">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding TeamMember.DisplayName, FallbackValue='Team Member'}"
                                                               FontSize="13"
                                                               Foreground="{DynamicResource BrushTextPrimary}"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding RoleDisplay}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource BrushTextTertiary}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="No members added yet"
                                           FontSize="13"
                                           Foreground="{DynamicResource BrushTextTertiary}"
                                           IsVisible="{Binding !SelectedProject.Members.Count}"/>
                            </StackPanel>
                            
                            <!-- Links -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="Linked Items"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushTextSecondary}"/>
                                <ItemsControl ItemsSource="{Binding SelectedProject.Links}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:ProjectLink}">
                                            <Border Background="{DynamicResource BrushSurfaceAlt}"
                                                    CornerRadius="8"
                                                    Padding="12,8"
                                                    Margin="0,0,0,8">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding EntityTypeIcon}"
                                                               FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                               FontSize="14"
                                                               Foreground="{DynamicResource BrushTextTertiary}"
                                                               Margin="0,0,12,0"
                                                               VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding EntityTitleSnapshot, FallbackValue='Linked Item'}"
                                                                   FontSize="13"
                                                                   Foreground="{DynamicResource BrushTextPrimary}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding EntityTypeDisplay}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource BrushTextTertiary}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="No linked items yet"
                                           FontSize="13"
                                           Foreground="{DynamicResource BrushTextTertiary}"
                                           IsVisible="{Binding !SelectedProject.Links.Count}"/>
                            </StackPanel>
                            
                            <!-- Chronicle Notes -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="Chronicle Notes"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushTextSecondary}"/>
                                <ItemsControl ItemsSource="{Binding LinkedNotes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:Note">
                                            <Button Classes="ghost"
                                                    Command="{Binding $parent[UserControl].((vm:ProjectsViewModel)DataContext).OpenNoteCommand}"
                                                    CommandParameter="{Binding}"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    Padding="0"
                                                    Margin="0,0,0,4">
                                                <Border Background="{DynamicResource BrushSurfaceAlt}"
                                                        CornerRadius="8"
                                                        Padding="12,8">
                                                    <Grid ColumnDefinitions="Auto,*">
                                                        <PathIcon Grid.Column="0"
                                                                  Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M14,18H6V16H14V18M16,14H6V12H16V14M13,9V3.5L18.5,9H13Z"
                                                                  Width="14" Height="14"
                                                                  Foreground="{DynamicResource BrushTextTertiary}"
                                                                  Margin="0,0,12,0"
                                                                  VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding DisplayTitle}"
                                                                   FontSize="13"
                                                                   Foreground="{DynamicResource BrushTextPrimary}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="No Chronicle notes linked"
                                           FontSize="13"
                                           Foreground="{DynamicResource BrushTextTertiary}"
                                           IsVisible="{Binding !HasLinkedNotes}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    
                    <!-- Footer actions -->
                    <Border Grid.Row="2" 
                            Background="{DynamicResource BrushSurfaceAlt}"
                            CornerRadius="0,0,12,12"
                            Padding="20,12">
                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                            <Button Classes="ghost danger"
                                    Command="{Binding DeleteProjectCommand}"
                                    ToolTip.Tip="Delete project">
                                <TextBlock Text="&#xE74D;"
                                           FontFamily="{StaticResource SymbolThemeFontFamily}"
                                           FontSize="14"/>
                            </Button>
                            <Button Classes="secondary"
                                    Command="{Binding EditProjectCommand}"
                                    Content="Edit"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>