<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:ProCohere.Avalonia.Views.Controls"
             xmlns:models="clr-namespace:ProCohere.Avalonia.Models"
             xmlns:vm="using:ProCohere.Avalonia.ViewModels.Controls"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="300"
             x:Class="ProCohere.Avalonia.Views.Controls.CarryForwardSuggestionsPanel"
             x:DataType="vm:CarryForwardSuggestionsPanelViewModel"
             x:Name="Root">

    <UserControl.Styles>
        <Style Selector="Border.suggestion-card">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="#FFA000" />
            <Setter Property="BorderThickness" Value="0,0,0,3" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        
        <Style Selector="Border.suggestion-card:pointerover">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
        </Style>
        
        <Style Selector="TextBlock.suggestion-title">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        
        <Style Selector="TextBlock.suggestion-meta">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        
        <Style Selector="TextBlock.carry-forward-badge">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FFA000" />
            <Setter Property="Background" Value="#33FFA000" />
            <Setter Property="Padding" Value="6,2" />
        </Style>
    </UserControl.Styles>

    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            CornerRadius="6"
            Padding="12">
        <Grid RowDefinitions="Auto,*">
            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <PathIcon Grid.Column="0"
                              Height="16" Width="16"
                              Foreground="#FFA000"
                              Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M16.2,16.2L11,13V7H12.5V12.2L17,14.9L16.2,16.2Z"
                              Margin="0,0,8,0" />
                    <TextBlock Grid.Column="1"
                               Text="Pending Items to Discuss"
                               FontWeight="SemiBold"
                               FontSize="14"
                               VerticalAlignment="Center" />
                    <Border Grid.Column="2"
                            Background="#FFA000"
                            CornerRadius="10"
                            Padding="8,2"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding ItemCount}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="White" />
                    </Border>
                </Grid>
                <TextBlock Text="These items were deferred from previous meetings and are waiting to be discussed."
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,6,0,0" />
            </StackPanel>
            
            <!-- Items List -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding PendingItems}"
                              IsVisible="{Binding HasItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:MeetingAgendaItem">
                            <Border Classes="suggestion-card">
                                <Grid RowDefinitions="Auto,Auto,Auto">
                                    <!-- Title Row -->
                                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Title}"
                                                   Classes="suggestion-title" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                            <TextBlock Classes="carry-forward-badge"
                                                       Text="{Binding CarryForwardMeetingCount, StringFormat='Meeting #{0}'}" />
                                        </StackPanel>
                                    </Grid>
                                    
                                    <!-- Meta Row -->
                                    <TextBlock Grid.Row="1"
                                               Classes="suggestion-meta"
                                               Text="{Binding CreatedAt, StringFormat='Originally from {0:MMM d}'}"
                                               Margin="0,4,0,0" />
                                    
                                    <!-- Actions Row -->
                                    <StackPanel Grid.Row="2" 
                                                Orientation="Horizontal" 
                                                Spacing="8"
                                                Margin="0,8,0,0">
                                        <Button Classes="accent"
                                                Content="Add to Meeting"
                                                FontSize="11"
                                                Padding="10,4"
                                                Command="{Binding #Root.((vm:CarryForwardSuggestionsPanelViewModel)DataContext).AddToMeetingCommand}"
                                                CommandParameter="{Binding}" />
                                        <Button Classes="cancel-btn"
                                                Content="Skip This Time"
                                                FontSize="11"
                                                Padding="10,4"
                                                Command="{Binding #Root.((vm:CarryForwardSuggestionsPanelViewModel)DataContext).SkipCommand}"
                                                CommandParameter="{Binding}" />
                                        <Button Classes="cancel-btn"
                                                Content="Mark Resolved"
                                                FontSize="11"
                                                Padding="10,4"
                                                Command="{Binding #Root.((vm:CarryForwardSuggestionsPanelViewModel)DataContext).MarkResolvedCommand}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            
            <!-- Empty State -->
            <StackPanel Grid.Row="1"
                        IsVisible="{Binding IsEmpty}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
                <PathIcon Height="32" Width="32"
                          Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                          Data="M9,5V9H21V5M9,19H21V15H9M9,14H21V10H9M4,9H8V5H4M4,19H8V15H4M4,14H8V10H4V14Z"
                          HorizontalAlignment="Center" />
                <TextBlock Text="No pending items"
                           FontSize="13"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="All carry-forward items have been addressed."
                           FontSize="11"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
