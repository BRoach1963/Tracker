<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ProCohere.Avalonia.ViewModels"
             xmlns:models="using:ProCohere.Avalonia.Models"
             xmlns:markup="using:ProCohere.Avalonia.Markup"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="600"
             x:Class="ProCohere.Avalonia.Views.Controls.GoalEditorFlyout"
             x:DataType="vm:GoalsViewModel">
    
    <!-- 
    GoalEditorFlyout - Create/edit goals with narrative-first philosophy.
    
    Philosophy: "Goals express intent, Metrics observe reality, Humans decide."
    NO progress fields, NO automatic goal creation.
    -->
    
    <Border Background="{DynamicResource BrushSurface}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1,0,0,0"
            CornerRadius="8,0,0,8">
        <Grid RowDefinitions="Auto,*,Auto">
            
            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="20,16">
                <TextBlock Text="{Binding EditingGoal.Id, Converter={StaticResource GuidIsEmptyToNewOrEditConverter}}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushTextPrimary}"/>
                <Button Grid.Column="1"
                        Command="{Binding CloseEditorFlyoutCommand}"
                        Classes="icon-button"
                        ToolTip.Tip="Close">
                    <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" 
                              Width="16" Height="16"
                              Foreground="{DynamicResource BrushTextSecondary}"/>
                </Button>
            </Grid>
            
            <!-- Form Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,0" Spacing="20" DataContext="{Binding EditingGoal}">
                    
                    <!-- Title -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="{markup:Localize Key=GoalEditor_TitleLabel}" FontWeight="Medium" FontSize="12" 
                                   Foreground="{DynamicResource BrushTextSecondary}"/>
                        <TextBox Text="{Binding Title, Mode=TwoWay}"
                                 Watermark="{markup:Localize Key=GoalEditor_TitleWatermark}"
                                 FontSize="14"/>
                    </StackPanel>
                    
                    <!-- Description -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="{markup:Localize Key=GoalEditor_DescriptionLabel}" FontWeight="Medium" FontSize="12" 
                                   Foreground="{DynamicResource BrushTextSecondary}"/>
                        <TextBox Text="{Binding Description, Mode=TwoWay}"
                                 Watermark="{markup:Localize Key=GoalEditor_DescriptionWatermark}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="100"
                                 FontSize="14"/>
                    </StackPanel>
                    
                    <!-- Goal Type -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="{markup:Localize Key=GoalEditor_GoalTypeLabel}" FontWeight="Medium" FontSize="12" 
                                   Foreground="{DynamicResource BrushTextSecondary}"/>
                        <ComboBox SelectedIndex="{Binding GoalType, Mode=TwoWay, Converter={StaticResource GoalTypeToIndexConverter}}"
                                  HorizontalAlignment="Stretch">
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="M16,6L18.29,8.29L13.41,13.17L9.41,9.17L2,16.59L3.41,18L9.41,12L13.41,16L19.71,9.71L22,12V6H16Z"
                                              Width="16" Height="16"/>
                                    <TextBlock Text="{markup:Localize Key=GoalEditor_GoalTypeGrowth}"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="M19,3H14.82C14.4,1.84 13.3,1 12,1C10.7,1 9.6,1.84 9.18,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M12,3A1,1 0 0,1 13,4A1,1 0 0,1 12,5A1,1 0 0,1 11,4A1,1 0 0,1 12,3M7,7H17V5H19V19H5V5H7V7M10,17L15,12L13.59,10.59L10,14.17L8.41,12.58L7,14L10,17Z"
                                              Width="16" Height="16"/>
                                    <TextBlock Text="{markup:Localize Key=GoalEditor_GoalTypeExecution}"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"
                                              Width="16" Height="16"/>
                                    <TextBlock Text="{markup:Localize Key=GoalEditor_GoalTypeOperational}"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="M12,2L4.5,20.29L5.21,21L12,18L18.79,21L19.5,20.29L12,2Z"
                                              Width="16" Height="16"/>
                                    <TextBlock Text="{markup:Localize Key=GoalEditor_GoalTypeDirectional}"/>
                                </StackPanel>
                            </ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                    
                    <!-- Time Period -->
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                        <TextBlock Grid.ColumnSpan="2" Text="{markup:Localize Key=GoalEditor_TimePeriodLabel}" FontWeight="Medium" FontSize="12" 
                                   Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,6"/>
                        
                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                            <TextBlock Text="{markup:Localize Key=GoalEditor_Start}" FontSize="11" Opacity="0.6"/>
                            <CalendarDatePicker SelectedDate="{Binding StartDate, Mode=TwoWay}"
                                                HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4" Margin="8,0,0,0">
                            <TextBlock Text="{markup:Localize Key=GoalEditor_End}" FontSize="11" Opacity="0.6"/>
                            <CalendarDatePicker SelectedDate="{Binding DueDate, Mode=TwoWay}"
                                                HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Grid>
                    
                    <!-- Health (only show for existing goals) -->
                    <StackPanel Spacing="6" IsVisible="{Binding Id, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock Text="{markup:Localize Key=GoalEditor_CurrentHealth}" FontWeight="Medium" FontSize="12" 
                                   Foreground="{DynamicResource BrushTextSecondary}"/>
                        <Border Background="{DynamicResource BrushSurfaceAlt}"
                                CornerRadius="8"
                                Padding="12">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding HealthDisplay}" 
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{markup:Localize Key=GoalEditor_HealthUpdateHint}"
                                           FontSize="11"
                                           Opacity="0.6"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            
            <!-- Footer Actions -->
            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="0,1,0,0"
                    Padding="20,16">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <Button Content="{markup:Localize Key=Button_Cancel}"
                            Command="{Binding CloseEditorFlyoutCommand}"
                            Classes="secondary-button"/>
                    <Button Grid.Column="2"
                            Content="{markup:Localize Key=GoalEditor_SaveGoal}"
                            Command="{Binding SaveGoalCommand}"
                            Classes="primary-button"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
