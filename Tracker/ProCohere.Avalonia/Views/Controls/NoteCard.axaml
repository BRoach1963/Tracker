<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:ProCohere.Avalonia.Models"
             xmlns:local="using:ProCohere.Avalonia.Views.Controls"
             xmlns:markup="using:ProCohere.Avalonia.Markup"
             mc:Ignorable="d" d:DesignWidth="320" d:DesignHeight="160"
             x:Class="ProCohere.Avalonia.Views.Controls.NoteCard"
             x:DataType="models:Note">
    
    <!-- 
    NoteCard - Reusable card control for displaying a note in grid/list context.
    
    Usage:
        <controls:NoteCard DataContext="{Binding SomeNote}" 
                          ShowPinIndicator="True"
                          CardClicked="OnNoteCardClicked"/>
    
    Properties:
        - ShowPinIndicator (bool): Whether to show the pinned badge. Default false.
        - CardClicked (event): Fired when the card is clicked.
    -->
    
    <UserControl.Styles>
        <!-- Card base style with hover animation -->
        <Style Selector="Border.note-card">
            <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="280"/>
            <Setter Property="MaxWidth" Value="400"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="RenderTransform" Value="scale(1)"/>
            <Setter Property="BoxShadow" Value="0 1 3 0 #1a000000"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.note-card:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceHover}"/>
            <Setter Property="RenderTransform" Value="scale(1.02)"/>
            <Setter Property="BoxShadow" Value="0 4 12 0 #26000000"/>
        </Style>
        
        <!-- Pinned indicator style -->
        <Style Selector="Border.pin-indicator">
            <Setter Property="Background" Value="{DynamicResource BrushHighlight}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,2"/>
        </Style>
        
        <!-- Category badge style -->
        <Style Selector="Border.category-badge">
            <Setter Property="Background" Value="{DynamicResource BrushPrimarySubtle}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        
        <!-- Entity link badge style -->
        <Style Selector="Border.link-badge">
            <Setter Property="Background" Value="{DynamicResource BrushSecondary}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>
    </UserControl.Styles>
    
    <Border Classes="note-card"
            PointerPressed="OnCardPointerPressed"
            x:Name="CardBorder">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto">
            
            <!-- Row 0: Pin indicator + Category -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
                <!-- Pin indicator (visibility controlled by ShowPinIndicator property) -->
                <Border Grid.Column="0" Classes="pin-indicator"
                        x:Name="PinIndicatorBorder"
                        IsVisible="False">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <PathIcon Data="M16,12V4H17V2H7V4H8V12L6,14V16H11.2V22H12.8V16H18V14L16,12Z" 
                                  Width="10" Height="10" Foreground="{DynamicResource BrushSecondary}"/>
                        <TextBlock Text="{markup:Localize Key=Note_Pinned}" FontSize="10" 
                                   Foreground="{DynamicResource BrushSecondary}"/>
                    </StackPanel>
                </Border>
                
                <!-- Category badge with color coding -->
                <Border Grid.Column="2" CornerRadius="4" Padding="8,4"
                        Background="{Binding Category, Converter={StaticResource CategoryToColorConverter}}"
                        IsVisible="{Binding Category, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding Category}" FontSize="11" FontWeight="Medium"
                               Foreground="{Binding Category, Converter={StaticResource CategoryToAccentConverter}, FallbackValue={DynamicResource BrushPrimary}}"/>
                </Border>
            </Grid>
            
            <!-- Row 1: Title -->
            <TextBlock Grid.Row="1" 
                       Text="{Binding DisplayTitle}"
                       FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushTextPrimary}"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,0,0,6"/>
            
            <!-- Row 2: Content preview -->
            <TextBlock Grid.Row="2" 
                       Text="{Binding ContentPreview}"
                       FontSize="13"
                       Foreground="{DynamicResource BrushTextSecondary}"
                       TextWrapping="Wrap"
                       MaxLines="3"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,0,0,10"/>
            
            <!-- Row 3: Link badge + Date -->
            <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
                <!-- Link badge - single indicator that note has links -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Classes="link-badge" 
                            IsVisible="{Binding HasLinks}"
                            ToolTip.Tip="{Binding LinkCount, StringFormat='Linked to {0} item(s)'}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <PathIcon Data="M3.9,12C3.9,10.29 5.29,8.9 7,8.9H11V7H7A5,5 0 0,0 2,12A5,5 0 0,0 7,17H11V15.1H7C5.29,15.1 3.9,13.71 3.9,12M8,13H16V11H8V13M17,7H13V8.9H17C18.71,8.9 20.1,10.29 20.1,12C20.1,13.71 18.71,15.1 17,15.1H13V17H17A5,5 0 0,0 22,12A5,5 0 0,0 17,7Z" 
                                      Width="12" Height="12" Foreground="White"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                
                <!-- Relative timestamp -->
                <TextBlock Grid.Column="1" 
                           Text="{Binding DisplayTimestamp}"
                           FontSize="11"
                           Foreground="{DynamicResource BrushTextTertiary}"
                           VerticalAlignment="Center"
                           ToolTip.Tip="{Binding CreatedAt, StringFormat='Created: {0:MMMM d, yyyy h:mm tt}'}"/>
            </Grid>
        </Grid>
    </Border>
    
    <!-- Tooltip with extended content preview -->
    <ToolTip.Tip>
        <Border Background="{DynamicResource BrushSurface}" 
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="1" CornerRadius="8" 
                Padding="12" MaxWidth="350">
            <StackPanel Spacing="8">
                <TextBlock Text="{Binding DisplayTitle}" 
                           FontWeight="SemiBold" FontSize="14"
                           Foreground="{DynamicResource BrushTextPrimary}"
                           TextWrapping="Wrap"/>
                <TextBlock Text="{Binding ContentPreviewExtended}" 
                           FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource BrushTextSecondary}"
                           MaxLines="10"/>
                <TextBlock Text="{Binding CreatedAt, StringFormat='Created {0:MMMM d, yyyy}'}"
                           FontSize="10" 
                           Foreground="{DynamicResource BrushTextTertiary}"/>
            </StackPanel>
        </Border>
    </ToolTip.Tip>
</UserControl>
