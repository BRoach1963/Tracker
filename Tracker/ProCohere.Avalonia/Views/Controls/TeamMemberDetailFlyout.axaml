<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ProCohere.Avalonia.ViewModels"
             xmlns:models="using:ProCohere.Avalonia.Models"
             xmlns:local="using:ProCohere.Avalonia.Converters"
             mc:Ignorable="d" d:DesignWidth="280" d:DesignHeight="400"
             x:Class="ProCohere.Avalonia.Views.Controls.TeamMemberDetailFlyout"
             x:DataType="vm:CircleViewModel">
    
    <UserControl.Styles>
        <!-- Flyout Tab Button - Matches navigation rail style -->
        <Style Selector="Button.flyout-tab">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Padding" Value="8,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Width" Value="52"/>
        </Style>
        <!-- Unselected state -->
        <Style Selector="Button.flyout-tab PathIcon">
            <Setter Property="Foreground" Value="#94A3B8"/>
        </Style>
        <Style Selector="Button.flyout-tab TextBlock">
            <Setter Property="Foreground" Value="#94A3B8"/>
        </Style>
        <!-- Hover state -->
        <Style Selector="Button.flyout-tab:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushSecondaryHover}"/>
        </Style>
        <Style Selector="Button.flyout-tab:pointerover PathIcon">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.flyout-tab:pointerover TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <!-- Selected state - gold icon, white text -->
        <Style Selector="Button.flyout-tab.selected">
            <Setter Property="Background" Value="{DynamicResource BrushSecondaryHover}"/>
        </Style>
        <Style Selector="Button.flyout-tab.selected PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource BrushHighlight}"/>
        </Style>
        <Style Selector="Button.flyout-tab.selected TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        
        <!-- Detail Section Header -->
        <Style Selector="TextBlock.detail-section-header">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextTertiary}"/>
            <Setter Property="Margin" Value="0,16,0,8"/>
        </Style>
    </UserControl.Styles>
    
    <Grid ColumnDefinitions="Auto,*">
        
        <!-- Vertical Tab Bar - Navy blue like navigation -->
        <Border Grid.Column="0" Background="{DynamicResource BrushSecondary}" CornerRadius="8,0,0,8">
            <StackPanel Spacing="2" Margin="0,8">
                <Button Classes="flyout-tab" ToolTip.Tip="Overview"
                        Classes.selected="{Binding MemberDetailTab, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:MemberDetailTab.Overview}}"
                        Command="{Binding SetMemberDetailTabCommand}" CommandParameter="{x:Static vm:MemberDetailTab.Overview}">
                    <StackPanel Spacing="4">
                        <PathIcon Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z"
                                  Width="16" Height="16"/>
                        <TextBlock Text="Info" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Classes="flyout-tab" ToolTip.Tip="Goals"
                        Classes.selected="{Binding MemberDetailTab, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:MemberDetailTab.Goals}}"
                        Command="{Binding SetMemberDetailTabCommand}" CommandParameter="{x:Static vm:MemberDetailTab.Goals}">
                    <StackPanel Spacing="4">
                        <PathIcon Data="M5,21L7.5,13L1,9H8.5L11,1L13.5,9H21L14.5,13L17,21L11,16L5,21Z"
                                  Width="16" Height="16"/>
                        <TextBlock Text="Goals" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Classes="flyout-tab" ToolTip.Tip="Tasks"
                        Classes.selected="{Binding MemberDetailTab, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:MemberDetailTab.Tasks}}"
                        Command="{Binding SetMemberDetailTabCommand}" CommandParameter="{x:Static vm:MemberDetailTab.Tasks}">
                    <StackPanel Spacing="4">
                        <PathIcon Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20M11.2,18.46L8.45,15.46L9.61,14.3L11.2,15.88L14.78,12.3L15.94,13.64L11.2,18.46Z"
                                  Width="16" Height="16"/>
                        <TextBlock Text="Tasks" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Classes="flyout-tab" ToolTip.Tip="Meetings"
                        Classes.selected="{Binding MemberDetailTab, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:MemberDetailTab.Meetings}}"
                        Command="{Binding SetMemberDetailTabCommand}" CommandParameter="{x:Static vm:MemberDetailTab.Meetings}">
                    <StackPanel Spacing="4">
                        <PathIcon Data="M19,19H5V8H19M16,1V3H8V1H6V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3H18V1"
                                  Width="16" Height="16"/>
                        <TextBlock Text="Mtgs" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Classes="flyout-tab" ToolTip.Tip="Feedback"
                        Classes.selected="{Binding MemberDetailTab, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:MemberDetailTab.Feedback}}"
                        Command="{Binding SetMemberDetailTabCommand}" CommandParameter="{x:Static vm:MemberDetailTab.Feedback}">
                    <StackPanel Spacing="4">
                        <PathIcon Data="M20,2H4A2,2 0 0,0 2,4V22L6,18H20A2,2 0 0,0 22,16V4C22,2.89 21.1,2 20,2"
                                  Width="16" Height="16"/>
                        <TextBlock Text="Feed" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <!-- Team Tab - Only visible for managers -->
                <Button Classes="flyout-tab" ToolTip.Tip="Direct Reports"
                        IsVisible="{Binding SelectedMemberIsManager}"
                        Classes.selected="{Binding MemberDetailTab, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:MemberDetailTab.Team}}"
                        Command="{Binding SetMemberDetailTabCommand}" CommandParameter="{x:Static vm:MemberDetailTab.Team}">
                    <StackPanel Spacing="4">
                        <PathIcon Data="M16,13C15.71,13 15.38,13 15.03,13.05C16.19,13.89 17,15 17,16.5V19H23V16.5C23,14.17 18.33,13 16,13M8,13C5.67,13 1,14.17 1,16.5V19H15V16.5C15,14.17 10.33,13 8,13M8,11A3,3 0 0,0 11,8A3,3 0 0,0 8,5A3,3 0 0,0 5,8A3,3 0 0,0 8,11M16,11A3,3 0 0,0 19,8A3,3 0 0,0 16,5A3,3 0 0,0 13,8A3,3 0 0,0 16,11Z"
                                  Width="16" Height="16"/>
                        <TextBlock Text="Team" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
        
        <!-- Content Area -->
        <Grid Grid.Column="1">
            <!-- Close Button (always visible) -->
            <Button Classes="icon-button" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,8,8,0" ZIndex="10" ToolTip.Tip="Close"
                    Command="{Binding CloseDetailPanelCommand}">
                <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                          Width="14" Height="14" Foreground="{DynamicResource BrushTextSecondary}"/>
            </Button>
            
            <!-- ===== OVERVIEW TAB ===== -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding MemberDetailTab, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:MemberDetailTab.Overview}}">
                <StackPanel DataContext="{Binding SelectedTeamMember}" Margin="12,8,18,12">
                    
                    <!-- Profile Header -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,24,0,16">
                        <Border Width="64" Height="64" CornerRadius="32" ClipToBounds="True" HorizontalAlignment="Center">
                            <Panel>
                                <!-- Initials fallback -->
                                <Border Background="{DynamicResource BrushPrimary}" CornerRadius="32"
                                        IsVisible="{Binding AvatarUrl, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                                    <TextBlock Text="{Binding Initials}" FontSize="22" FontWeight="SemiBold"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <!-- Avatar image -->
                                <Image Source="{Binding AvatarUrl}" Stretch="UniformToFill" Width="64" Height="64"
                                       IsVisible="{Binding AvatarUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            </Panel>
                        </Border>
                        <TextBlock Text="{Binding FullName}" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center"
                                   Margin="0,10,0,2"/>
                        <TextBlock Text="{Binding JobTitle}" FontSize="12"
                                   Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center"/>
                        <Border CornerRadius="10" Padding="10,3" Margin="0,6,0,0" HorizontalAlignment="Center">
                            <Border.Background>
                                <MultiBinding Converter="{StaticResource BoolToColorConverter}">
                                    <Binding Path="IsActive"/>
                                </MultiBinding>
                            </Border.Background>
                            <TextBlock Text="{Binding StatusDisplay}" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                        </Border>
                    </StackPanel>
                    
                    <!-- Contact -->
                    <TextBlock Text="CONTACT" Classes="detail-section-header"/>
                    <Grid Margin="0,0,0,6" ColumnDefinitions="Auto,*">
                        <PathIcon Data="M20,8L12,13L4,8V6L12,11L20,6M20,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V6C22,4.89 21.1,4 20,4Z"
                                  Width="12" Height="12" Foreground="{DynamicResource BrushTextTertiary}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Email}" FontSize="12"
                                   Foreground="{DynamicResource BrushTextPrimary}" Margin="8,0,0,0"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,0,0,6" ColumnDefinitions="Auto,*" IsVisible="{Binding HasPhone}">
                        <PathIcon Data="M6.62,10.79C8.06,13.62 10.38,15.94 13.21,17.38L15.41,15.18C15.69,14.9 16.08,14.82 16.43,14.93C17.55,15.3 18.75,15.5 20,15.5A1,1 0 0,1 21,16.5V20A1,1 0 0,1 20,21A17,17 0 0,1 3,4A1,1 0 0,1 4,3H7.5A1,1 0 0,1 8.5,4C8.5,5.25 8.7,6.45 9.07,7.57C9.18,7.92 9.1,8.31 8.82,8.59L6.62,10.79Z"
                                  Width="12" Height="12" Foreground="{DynamicResource BrushTextTertiary}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Phone}" FontSize="12"
                                   Foreground="{DynamicResource BrushTextPrimary}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    
                    <!-- Details -->
                    <TextBlock Text="DETAILS" Classes="detail-section-header"/>
                    <Grid Margin="0,0,0,4" ColumnDefinitions="70,*">
                        <TextBlock Text="Tenure" FontSize="11" Foreground="{DynamicResource BrushTextTertiary}"/>
                        <TextBlock Grid.Column="1" Text="{Binding TenureFromHireDate}" FontSize="11" FontWeight="Medium"
                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                    </Grid>
                    <Grid Margin="0,0,0,4" ColumnDefinitions="70,*">
                        <TextBlock Text="Hire Date" FontSize="11" Foreground="{DynamicResource BrushTextTertiary}"/>
                        <TextBlock Grid.Column="1" Text="{Binding HireDateDisplay}" FontSize="11" FontWeight="Medium"
                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                    </Grid>
                    <Grid Margin="0,0,0,4" ColumnDefinitions="70,*">
                        <TextBlock Text="Birthday" FontSize="11" Foreground="{DynamicResource BrushTextTertiary}"/>
                        <TextBlock Grid.Column="1" Text="{Binding BirthdayDisplay}" FontSize="11" FontWeight="Medium"
                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                    </Grid>
                    
                    <!-- Quick Actions -->
                    <StackPanel Margin="0,16,0,0" Spacing="6">
                        <Button Classes="action-button" HorizontalAlignment="Stretch"
                                Command="{Binding $parent[UserControl;1].((vm:CircleViewModel)DataContext).ScheduleMeetingCommand}"
                                CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="M19,19H5V8H19M16,1V3H8V1H6V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3H18V1" Width="12" Height="12"/>
                                <TextBlock Text="Schedule Meeting" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="secondary-button" HorizontalAlignment="Stretch"
                                Command="{Binding $parent[UserControl;1].((vm:CircleViewModel)DataContext).EditTeamMemberCommand}"
                                CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z" Width="12" Height="12"/>
                                <TextBlock Text="Edit Details" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            
            <!-- ===== GOALS TAB ===== -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding MemberDetailTab, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:MemberDetailTab.Goals}}">
                <StackPanel Margin="12,8,12,12">
                    <TextBlock Text="GOALS" Classes="detail-section-header" Margin="0,24,0,8"/>
                    
                    <!-- Empty state -->
                    <TextBlock Text="No goals assigned" FontSize="12" Opacity="0.5" Margin="0,8,0,0"
                               IsVisible="{Binding MemberGoals.Count, Converter={StaticResource EqualToZeroConverter}}"/>
                    
                    <!-- Goal list -->
                    <ItemsControl ItemsSource="{Binding MemberGoals}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:GoalDetail">
                                <Border Background="{DynamicResource BrushSurfaceAlt}" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource BrushTextPrimary}" TextWrapping="Wrap"/>
                                            <Border Grid.Column="1" CornerRadius="4" Padding="6,2">
                                                <Border.Background>
                                                    <SolidColorBrush Color="{Binding Status, Converter={StaticResource GoalStatusToBackgroundConverter}}"/>
                                                </Border.Background>
                                                <TextBlock Text="{Binding StatusDisplay}" FontSize="9" Foreground="White"/>
                                            </Border>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <ProgressBar Classes="goal-progress" Value="{Binding Progress}" Minimum="0" Maximum="100"/>
                                            <TextBlock Grid.Column="1" FontSize="10" Margin="8,0,0,0"
                                                       Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center">
                                                <Run Text="{Binding Progress}"/><Run Text="%"/>
                                            </TextBlock>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
            
            <!-- ===== TASKS TAB ===== -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding MemberDetailTab, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:MemberDetailTab.Tasks}}">
                <StackPanel Margin="12,8,12,12">
                    <TextBlock Text="TASKS" Classes="detail-section-header" Margin="0,24,0,8"/>
                    
                    <!-- Task count -->
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,0,12">
                        <TextBlock Text="{Binding MemberTasks.Count}" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource BrushPrimary}"/>
                        <TextBlock Text="open tasks" FontSize="13" VerticalAlignment="Bottom" Margin="0,0,0,2"
                                   Foreground="{DynamicResource BrushTextSecondary}"/>
                    </StackPanel>
                    
                    <!-- Empty state -->
                    <TextBlock Text="No open tasks" FontSize="12" Opacity="0.5" Margin="0,8,0,0"
                               IsVisible="{Binding MemberTasks.Count, Converter={StaticResource EqualToZeroConverter}}"/>
                    
                    <!-- Task list -->
                    <ItemsControl ItemsSource="{Binding MemberTasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:TaskDetail">
                                <Border Background="{DynamicResource BrushSurfaceAlt}" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                    <StackPanel Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource BrushTextPrimary}" TextWrapping="Wrap"/>
                                            <Border Grid.Column="1" CornerRadius="4" Padding="6,2"
                                                    Background="{DynamicResource BrushPrimarySoft}">
                                                <TextBlock Text="{Binding StatusDisplay}" FontSize="9" 
                                                           Foreground="{DynamicResource BrushPrimary}"/>
                                            </Border>
                                        </Grid>
                                        <!-- Due date if set -->
                                        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasDueDate}">
                                            <PathIcon Data="M19,19H5V8H19M16,1V3H8V1H6V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3H18V1"
                                                      Width="10" Height="10" Foreground="{DynamicResource BrushTextTertiary}"/>
                                            <TextBlock Text="{Binding DueDateText}" FontSize="10"
                                                       Foreground="{Binding IsOverdue, Converter={x:Static local:BoolToOverdueColorConverter.Instance}}"/>
                                        </StackPanel>
                                        <!-- Priority -->
                                        <TextBlock Text="{Binding PriorityDisplay}" FontSize="10"
                                                   Foreground="{DynamicResource BrushTextSecondary}"/>
                                        <!-- Provenance if from source -->
                                        <Border CornerRadius="4" Padding="6,2" 
                                                Background="{DynamicResource BrushPrimarySoft}"
                                                IsVisible="{Binding HasSource}"
                                                HorizontalAlignment="Left" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding ProvenanceShort}" FontSize="9"
                                                       Foreground="{DynamicResource BrushPrimary}"
                                                       ToolTip.Tip="{Binding ProvenanceDisplay}"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
            
            <!-- ===== MEETINGS TAB ===== -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding MemberDetailTab, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:MemberDetailTab.Meetings}}">
                <StackPanel Margin="12,8,12,12">
                    <TextBlock Text="MEETINGS" Classes="detail-section-header" Margin="0,24,0,8"/>
                    
                    <!-- Empty state -->
                    <TextBlock Text="No meetings scheduled" FontSize="12" Opacity="0.5" Margin="0,8,0,0"
                               IsVisible="{Binding MemberMeetings.Count, Converter={StaticResource EqualToZeroConverter}}"/>
                    
                    <!-- Meeting list -->
                    <ItemsControl ItemsSource="{Binding MemberMeetings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:MeetingDetail">
                                <Border Background="{DynamicResource BrushSurfaceAlt}" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <PathIcon Data="M12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22C6.47,22 2,17.5 2,12A10,10 0 0,1 12,2M12.5,7V12.25L17,14.92L16.25,16.15L11,13V7H12.5Z"
                                                      Width="10" Height="10" Foreground="{DynamicResource BrushTextTertiary}"/>
                                            <TextBlock Text="{Binding ScheduledText}" FontSize="11"
                                                       Foreground="{DynamicResource BrushTextSecondary}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding TimeRangeDisplay}" FontSize="10"
                                                   Foreground="{DynamicResource BrushTextTertiary}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
            
            <!-- ===== FEEDBACK TAB ===== -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding MemberDetailTab, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:MemberDetailTab.Feedback}}">
                <StackPanel Margin="12,8,12,12">
                    <TextBlock Text="FEEDBACK" Classes="detail-section-header" Margin="0,24,0,8"/>
                    
                    <!-- Empty state -->
                    <TextBlock Text="No feedback yet" FontSize="12" Opacity="0.5" Margin="0,8,0,0"
                               IsVisible="{Binding MemberFeedback.Count, Converter={StaticResource EqualToZeroConverter}}"/>
                    
                    <!-- Feedback list -->
                    <ItemsControl ItemsSource="{Binding MemberFeedback}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:FeedbackDetail">
                                <Border Background="{DynamicResource BrushSurfaceAlt}" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                    <StackPanel Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Binding TypeDisplay}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding DateDisplay}" FontSize="10"
                                                       Foreground="{DynamicResource BrushTextTertiary}"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Content}" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource BrushTextSecondary}" MaxLines="3"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    
                    <!-- Add Feedback Button -->
                    <Button Classes="secondary-button" HorizontalAlignment="Stretch" Margin="0,8,0,0"
                            Command="{Binding GiveFeedbackCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Width="12" Height="12"/>
                            <TextBlock Text="Give Feedback" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
            
            <!-- ===== TEAM TAB ===== -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding MemberDetailTab, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:MemberDetailTab.Team}}">
                <StackPanel Margin="12,8,12,12">
                    <TextBlock Text="DIRECT REPORTS" Classes="detail-section-header" Margin="0,24,0,8"/>
                    
                    <!-- Report count -->
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,0,12">
                        <TextBlock Text="{Binding MemberDirectReports.Count}" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource BrushPrimary}"/>
                        <TextBlock Text="team members" FontSize="13" VerticalAlignment="Bottom" Margin="0,0,0,2"
                                   Foreground="{DynamicResource BrushTextSecondary}"/>
                    </StackPanel>
                    
                    <!-- Empty state -->
                    <TextBlock Text="No direct reports" FontSize="12" Opacity="0.5" Margin="0,8,0,0"
                               IsVisible="{Binding MemberDirectReports.Count, Converter={StaticResource EqualToZeroConverter}}"/>
                    
                    <!-- Direct reports list -->
                    <ItemsControl ItemsSource="{Binding MemberDirectReports}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:TeamMemberDetail">
                                <Border Background="{DynamicResource BrushSurfaceAlt}" CornerRadius="6" Padding="10" Margin="0,0,0,8"
                                        Cursor="Hand">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <!-- Avatar with image or initials -->
                                        <Border Width="36" Height="36" CornerRadius="18" ClipToBounds="True">
                                            <Panel>
                                                <!-- Initials fallback -->
                                                <Border Background="{DynamicResource BrushPrimary}" CornerRadius="18"
                                                        IsVisible="{Binding AvatarUrl, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                                                    <TextBlock Text="{Binding Initials}" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource BrushTextOnPrimary}" 
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <!-- Avatar image -->
                                                <Image Source="{Binding AvatarUrl}" Stretch="UniformToFill" Width="36" Height="36"
                                                       IsVisible="{Binding AvatarUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                            </Panel>
                                        </Border>
                                        
                                        <!-- Name and Title -->
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FullName}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <TextBlock Text="{Binding JobTitle}" FontSize="10"
                                                       Foreground="{DynamicResource BrushTextTertiary}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        
                                        <!-- Status indicator -->
                                        <Border Grid.Column="2" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                                            <Border.Background>
                                                <MultiBinding Converter="{StaticResource BoolToColorConverter}">
                                                    <Binding Path="IsActive"/>
                                                </MultiBinding>
                                            </Border.Background>
                                            <TextBlock Text="{Binding StatusDisplay}" FontSize="9" FontWeight="SemiBold" 
                                                       Foreground="{DynamicResource BrushTextOnPrimary}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
