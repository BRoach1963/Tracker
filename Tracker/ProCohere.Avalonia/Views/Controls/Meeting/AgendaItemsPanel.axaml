<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:ProCohere.Avalonia.Models"
             xmlns:dialogs="using:ProCohere.Avalonia.Models.Dialogs"
             xmlns:vm="using:ProCohere.Avalonia.ViewModels.Dialogs"
             xmlns:local="using:ProCohere.Avalonia.Views.Controls.Meeting"
             x:Class="ProCohere.Avalonia.Views.Controls.Meeting.AgendaItemsPanel"
             x:DataType="vm:EditMeetingDialogViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel Spacing="12" Margin="0,0,0,20">
            
            <!-- Section Header -->
            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,4,0,8">
                <StackPanel>
                    <TextBlock Text="AGENDA" 
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushSecondary}" 
                               Margin="0"/>
                    <TextBlock Text="Topics to cover in this meeting" 
                               FontSize="12"
                               Foreground="{DynamicResource BrushTextSecondary}"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Classes="icon-button" Padding="6" Margin="0,0,4,0"
                        ToolTip.Tip="Link to existing task, goal, or metric"
                        Command="{Binding ShowEntityPickerForAgendaCommand}">
                    <PathIcon Data="M10.59,13.41C11,13.8 11,14.44 10.59,14.83C10.2,15.22 9.56,15.22 9.17,14.83C6.22,11.88 6.22,7.1 9.17,4.15C12.12,1.2 16.9,1.2 19.85,4.15C22.8,7.1 22.8,11.88 19.85,14.83L18.44,13.41C20.6,11.25 20.6,7.73 18.44,5.56C16.28,3.4 12.76,3.4 10.59,5.56C8.43,7.73 8.43,11.25 10.59,13.41M13.41,9.17C13.8,8.78 14.44,8.78 14.83,9.17C17.78,12.12 17.78,16.9 14.83,19.85C11.88,22.8 7.1,22.8 4.15,19.85C1.2,16.9 1.2,12.12 4.15,9.17L5.56,10.59C3.4,12.75 3.4,16.27 5.56,18.44C7.73,20.6 11.25,20.6 13.41,18.44C15.58,16.27 15.58,12.75 13.41,10.59C13,10.2 13,9.56 13.41,9.17Z" 
                              Width="14" Height="14"/>
                </Button>
                <Button Grid.Column="2"
                        Classes="icon-button" Padding="6"
                        ToolTip.Tip="Add new agenda item"
                        Command="{Binding AddAgendaItemCommand}">
                    <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" 
                              Width="14" Height="14"/>
                </Button>
            </Grid>
            
            <!-- Add agenda inline form - REMOVED, now uses dialog -->
            <!-- The ShowAddAgendaPanelCommand triggers a dialog in the code-behind -->
            
            <!-- Agenda items list -->
            <ItemsControl ItemsSource="{Binding AgendaItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="dialogs:DialogAgendaItem">
                        <local:AgendaItemCard />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            
            <!-- Empty state -->
            <Border Background="{DynamicResource BrushSurface}" 
                    BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="1" CornerRadius="8"
                    Padding="32" 
                    IsVisible="{Binding !HasAgendaItems}">
                <StackPanel HorizontalAlignment="Center" Spacing="8">
                    <Border Width="48" Height="48" CornerRadius="24" 
                            Background="{DynamicResource BrushSurfaceAlt}">
                        <PathIcon Data="M3,5H9V11H3V5M5,7V9H7V7H5M11,7H21V9H11V7M11,15H21V17H11V15M5,20L1.5,16.5L2.91,15.09L5,17.17L9.59,12.59L11,14L5,20Z"
                                  Width="24" Height="24" 
                                  Foreground="{DynamicResource BrushTextTertiary}"/>
                    </Border>
                    <TextBlock Text="No agenda items yet" FontSize="14" FontWeight="Medium"
                               Foreground="{DynamicResource BrushTextSecondary}" 
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Add topics or link to existing tasks, goals, or metrics" FontSize="12"
                               Foreground="{DynamicResource BrushTextTertiary}"
                               HorizontalAlignment="Center" TextWrapping="Wrap"
                               TextAlignment="Center"/>
                </StackPanel>
            </Border>
            
        </StackPanel>
    </ScrollViewer>
</UserControl>
