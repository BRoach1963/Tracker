<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:ProCohere.Avalonia.Models"
             xmlns:vm="using:ProCohere.Avalonia.ViewModels.Dialogs"
             xmlns:local="using:ProCohere.Avalonia.Views.Controls.Meeting"
             xmlns:markup="using:ProCohere.Avalonia.Markup"
             x:Class="ProCohere.Avalonia.Views.Controls.Meeting.PrepItemsPanel"
             x:DataType="vm:EditMeetingDialogViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel Spacing="12">
            
            <!-- Section Header -->
            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,4,0,8">
                <StackPanel>
                    <TextBlock Text="{markup:Localize Key=PrepPanel_Header}" 
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushSecondary}" 
                               Margin="0"/>
                    <TextBlock Text="{markup:Localize Key=PrepPanel_Description}" 
                               FontSize="12"
                               Foreground="{DynamicResource BrushTextSecondary}"/>
                </StackPanel>
                <Button Grid.Column="1" 
                        Classes="icon-button" Padding="6" Margin="0,0,4,0"
                        ToolTip.Tip="{markup:Localize Key=PrepPanel_AddFromExisting}"
                        Command="{Binding ShowEntityPickerForPrepCommand}">
                    <PathIcon Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4M15,9V12H12V14H15V17H17V14H20V12H17V9H15Z" 
                              Width="14" Height="14"/>
                </Button>
                <Button Grid.Column="2" 
                        Classes="icon-button" Padding="6"
                        ToolTip.Tip="{markup:Localize Key=PrepPanel_AddNewPrepItem}"
                        Command="{Binding AddPrepItemCommand}">
                    <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" 
                              Width="14" Height="14"/>
                </Button>
            </Grid>
            
            <!-- Add prep item inline form - REMOVED, now uses dialog -->
            <!-- The ShowAddPrepPanelCommand triggers a dialog in the code-behind -->
            
            <!-- Prep items list -->
            <ItemsControl ItemsSource="{Binding PrepItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:MeetingPrepItem">
                        <local:PrepItemCard />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            
            <!-- Empty state -->
            <Border Background="{DynamicResource BrushSurface}" 
                    BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="1" CornerRadius="8" 
                    Padding="32" 
                    IsVisible="{Binding !HasPrepItems}">
                <StackPanel HorizontalAlignment="Center" Spacing="8">
                    <Border Width="48" Height="48" CornerRadius="24" 
                            Background="{DynamicResource BrushSurfaceAlt}">
                        <PathIcon Data="M9,5V9H21V5M9,19H21V15H9M9,14H21V10H9M4,9H8V5H4M4,19H8V15H4M4,14H8V10H4V14Z"
                                  Width="24" Height="24" 
                                  Foreground="{DynamicResource BrushTextTertiary}"/>
                    </Border>
                    <TextBlock Text="{markup:Localize Key=PrepPanel_NoItemsYet}" FontSize="14" FontWeight="Medium"
                               Foreground="{DynamicResource BrushTextSecondary}" 
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{markup:Localize Key=PrepPanel_AddThingsHint}" FontSize="12"
                               Foreground="{DynamicResource BrushTextTertiary}"
                               HorizontalAlignment="Center" TextWrapping="Wrap"
                               TextAlignment="Center"/>
                </StackPanel>
            </Border>
            
        </StackPanel>
    </ScrollViewer>
</UserControl>
