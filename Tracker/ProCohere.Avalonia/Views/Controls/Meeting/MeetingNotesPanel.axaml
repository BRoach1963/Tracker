<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ProCohere.Avalonia.ViewModels.Dialogs"
             x:Class="ProCohere.Avalonia.Views.Controls.Meeting.MeetingNotesPanel"
             x:DataType="vm:EditMeetingDialogViewModel">

    <Grid Margin="16" RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0" Margin="0,4,0,12">
            <TextBlock Text="MEETING NOTES" 
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushSecondary}" 
                       Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="M12,17A2,2 0 0,0 14,15C14,13.89 13.1,13 12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10C4,8.89 4.9,8 6,8H7V6A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18M12,3A3,3 0 0,0 9,6V8H15V6A3,3 0 0,0 12,3Z" 
                          Width="12" Height="12" Foreground="{DynamicResource BrushTextTertiary}"/>
                <TextBlock Text="Only you can see these notes" FontSize="12"
                           Foreground="{DynamicResource BrushTextSecondary}"/>
            </StackPanel>
        </StackPanel>
        <Border Grid.Row="1" Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                CornerRadius="6" Padding="0">
            <TextBox Text="{Binding Notes}"
                     Watermark="Add your notes here..."
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     BorderThickness="0"
                     VerticalContentAlignment="Top"/>
        </Border>
    </Grid>
</UserControl>
