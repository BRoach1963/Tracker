<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:ProCohere.Avalonia.Models"
             xmlns:vm="using:ProCohere.Avalonia.ViewModels.Dialogs"
             xmlns:controls="using:ProCohere.Avalonia.Views.Controls"
             xmlns:asyncImageLoader="using:AsyncImageLoader"
             xmlns:markup="using:ProCohere.Avalonia.Markup"
             x:Class="ProCohere.Avalonia.Views.Controls.Meeting.MeetingDetailsPanel"
             x:DataType="vm:EditMeetingDialogViewModel">

    <Border Background="{DynamicResource BrushSurfaceAlt}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="0,0,1,0">
        <ScrollViewer VerticalScrollBarVisibility="Visible"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="14" Margin="16,16,16,24">
                
                <TextBlock Text="{markup:Localize Key=MeetingPanel_DetailsHeader}" 
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushTextTertiary}"
                           Margin="0,0,0,8"/>
                
                <!-- Title -->
                <StackPanel Spacing="4">
                    <TextBlock Text="{markup:Localize Key=MeetingPanel_TitleLabel}" FontSize="12" />
                    <TextBox Text="{Binding Title}"
                             Watermark="{markup:Localize Key=MeetingPanel_TitlePlaceholder}" />
                </StackPanel>
                
                <!-- Meeting Type -->
                <StackPanel Spacing="4">
                    <TextBlock Text="{markup:Localize Key=MeetingPanel_TypeLabel}" FontSize="12" />
                    <ComboBox x:Name="MeetingTypeComboBox"
                              HorizontalAlignment="Stretch"
                              SelectedIndex="0"
                              SelectionChanged="MeetingTypeComboBox_SelectionChanged">
                        <ComboBoxItem Content="{markup:Localize Key=MeetingPanel_TypeOneOnOne}" Tag="one_on_one" />
                        <ComboBoxItem Content="{markup:Localize Key=MeetingPanel_TypeTeam}" Tag="team" />
                        <ComboBoxItem Content="{markup:Localize Key=MeetingPanel_TypeProjectReview}" Tag="project" />
                        <ComboBoxItem Content="{markup:Localize Key=MeetingPanel_TypePerformanceReview}" Tag="performance" />
                        <ComboBoxItem Content="{markup:Localize Key=MeetingPanel_TypeOther}" Tag="other" />
                    </ComboBox>
                    <TextBlock Text="{Binding MeetingTypeDescription}" 
                               FontSize="11" FontStyle="Italic"
                               Foreground="{DynamicResource BrushTextTertiary}"
                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
                
                <!-- Attendee (for 1:1) -->
                <StackPanel Spacing="4" IsVisible="{Binding ShowAttendeeSelector}">
                    <TextBlock Text="{markup:Localize Key=MeetingPanel_WithLabel}" FontSize="12" />
                    <ComboBox ItemsSource="{Binding SelectableAttendees}"
                              SelectedItem="{Binding SelectedAttendee}"
                              HorizontalAlignment="Stretch"
                              PlaceholderText="{markup:Localize Key=MeetingPanel_SelectTeamMember}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:TeamMemberDetail">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="24" Height="24"
                                            CornerRadius="12"
                                            ClipToBounds="True">
                                        <Panel>
                                            <Border Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                    CornerRadius="12"
                                                    IsVisible="{Binding UserAvatarUrl, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                                                <TextBlock Text="{Binding Initials}"
                                                           FontSize="10"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <Image asyncImageLoader:ImageLoader.Source="{Binding UserAvatarUrl}"
                                                   Stretch="UniformToFill" Width="24" Height="24"
                                                   IsVisible="{Binding UserAvatarUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        </Panel>
                                    </Border>
                                    <TextBlock Text="{Binding FullName}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                
                <!-- Team Attendees (for team meetings) -->
                <StackPanel Spacing="4" IsVisible="{Binding ShowTeamAttendeesSelector}">
                    <!-- Team Picker -->
                    <TextBlock Text="{markup:Localize Key=MeetingPanel_TeamLabel}" FontSize="12" />
                    <ComboBox ItemsSource="{Binding AvailableTeams}"
                              SelectedItem="{Binding SelectedTeam}"
                              HorizontalAlignment="Stretch"
                              PlaceholderText="{markup:Localize Key=MeetingPanel_SelectTeamPlaceholder}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:Team">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="24" Height="24"
                                            CornerRadius="4"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}">
                                        <TextBlock Text="T"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="12"/>
                                        <TextBlock FontSize="10"
                                                   Foreground="{DynamicResource BrushTextTertiary}">
                                            <Run Text="{Binding MemberCount}"/>
                                            <Run Text="{markup:Localize Key=MeetingPanel_Members}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{markup:Localize Key=MeetingPanel_TeamMembersHint}"
                               FontSize="11" FontStyle="Italic"
                               Foreground="{DynamicResource BrushTextTertiary}"
                               Margin="0,0,0,8"/>
                    
                    <TextBlock Text="{markup:Localize Key=MeetingPanel_AttendeesLabel}" FontSize="12" />
                    <TextBlock Text="{markup:Localize Key=MeetingPanel_AttendeesHint}" FontSize="11"
                               Foreground="{DynamicResource BrushTextTertiary}" Margin="0,0,0,4"/>
                    <Border Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="6"
                            MaxHeight="140">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SelectableAttendees}" Margin="4">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:TeamMemberDetail">
                                        <Border Padding="4,2" Margin="0,2">
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Border Width="24" Height="24"
                                                            CornerRadius="12"
                                                            ClipToBounds="True">
                                                        <Panel>
                                                            <Border Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                                    CornerRadius="12"
                                                                    IsVisible="{Binding UserAvatarUrl, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                                                                <TextBlock Text="{Binding Initials}"
                                                                           FontSize="10"
                                                                           Foreground="White"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                            </Border>
                                                            <Image asyncImageLoader:ImageLoader.Source="{Binding UserAvatarUrl}"
                                                                   Stretch="UniformToFill" Width="24" Height="24"
                                                                   IsVisible="{Binding UserAvatarUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                        </Panel>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FullName}" FontSize="12"/>
                                                        <TextBlock Text="{Binding RelationDisplay}" FontSize="10"
                                                                   Foreground="{DynamicResource BrushTextTertiary}"
                                                                   IsVisible="{Binding RelationDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </CheckBox>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
                
                <!-- Date and Time -->
                <StackPanel Spacing="4">
                    <TextBlock Text="{markup:Localize Key=MeetingPanel_WhenLabel}" FontSize="12" />
                    <controls:DateTimeSelector x:Name="DateTimeSelector" 
                                               SelectedDateTime="{Binding ScheduledDateTime, Mode=TwoWay}" />
                </StackPanel>
                
                <!-- Duration -->
                <StackPanel Spacing="4">
                    <TextBlock Text="{markup:Localize Key=MeetingPanel_DurationLabel}" FontSize="12" />
                    <ComboBox x:Name="DurationComboBox"
                              HorizontalAlignment="Stretch"
                              SelectedIndex="1"
                              SelectionChanged="DurationComboBox_SelectionChanged">
                        <ComboBoxItem Content="{markup:Localize Key=MeetingPanel_Duration15}" Tag="15" />
                        <ComboBoxItem Content="{markup:Localize Key=MeetingPanel_Duration30}" Tag="30" />
                        <ComboBoxItem Content="{markup:Localize Key=MeetingPanel_Duration45}" Tag="45" />
                        <ComboBoxItem Content="{markup:Localize Key=MeetingPanel_Duration60}" Tag="60" />
                        <ComboBoxItem Content="{markup:Localize Key=MeetingPanel_Duration90}" Tag="90" />
                        <ComboBoxItem Content="{markup:Localize Key=MeetingPanel_Duration120}" Tag="120" />
                    </ComboBox>
                </StackPanel>
                
                <!-- Location -->
                <StackPanel Spacing="4">
                    <TextBlock Text="{markup:Localize Key=MeetingPanel_LocationLabel}" FontSize="12" />
                    <TextBox Text="{Binding Location}"
                             Watermark="{markup:Localize Key=MeetingPanel_LocationPlaceholder}" />
                </StackPanel>
                
                <!-- Video Link -->
                <StackPanel Spacing="4">
                    <TextBlock Text="{markup:Localize Key=MeetingPanel_VideoLinkLabel}" FontSize="12" />
                    <TextBox Text="{Binding VideoLink}"
                             Watermark="{markup:Localize Key=MeetingPanel_VideoLinkPlaceholder}" />
                </StackPanel>
                
                <!-- Recurrence -->
                <Border Background="{DynamicResource BrushSurface}"
                        BorderBrush="{DynamicResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12">
                    <StackPanel Spacing="10">
                        <CheckBox IsChecked="{Binding IsRecurringEnabled}"
                                  Content="{markup:Localize Key=MeetingPanel_RepeatMeeting}"
                                  FontSize="12"
                                  FontWeight="Medium"/>
                        
                        <StackPanel Spacing="8" IsVisible="{Binding IsRecurringEnabled}">
                            <!-- Pattern -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="{markup:Localize Key=MeetingPanel_FrequencyLabel}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                                <ComboBox SelectedIndex="{Binding RecurrencePatternIndex}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="{markup:Localize Key=MeetingPanel_FrequencyDaily}" />
                                    <ComboBoxItem Content="{markup:Localize Key=MeetingPanel_FrequencyWeekly}" />
                                    <ComboBoxItem Content="{markup:Localize Key=MeetingPanel_FrequencyMonthly}" />
                                </ComboBox>
                            </StackPanel>
                            
                            <!-- Interval -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="{markup:Localize Key=MeetingPanel_RepeatEveryLabel}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                                <Grid ColumnDefinitions="Auto,*">
                                    <NumericUpDown Value="{Binding RecurrenceInterval}"
                                                   Minimum="1" Maximum="365"
                                                   Width="80"
                                                   Increment="1"
                                                   FormatString="0"/>
                                    <TextBlock Grid.Column="1" 
                                               Text="{Binding RecurrencePatternIndex, Converter={StaticResource RecurrencePatternToUnitConverter}}"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0"
                                               FontSize="12"/>
                                </Grid>
                            </StackPanel>
                            
                            <!-- End Date -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="{markup:Localize Key=MeetingPanel_EndsOnLabel}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                                <DatePicker SelectedDate="{Binding RecurrenceEndDate}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
                
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
