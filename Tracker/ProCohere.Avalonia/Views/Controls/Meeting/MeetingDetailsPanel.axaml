<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:ProCohere.Avalonia.Models"
             xmlns:vm="using:ProCohere.Avalonia.ViewModels.Dialogs"
             xmlns:controls="using:ProCohere.Avalonia.Views.Controls"
             xmlns:asyncImageLoader="using:AsyncImageLoader"
             x:Class="ProCohere.Avalonia.Views.Controls.Meeting.MeetingDetailsPanel"
             x:DataType="vm:EditMeetingDialogViewModel">

    <Border Background="{DynamicResource BrushSurfaceAlt}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="0,0,1,0">
        <ScrollViewer VerticalScrollBarVisibility="Visible"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="14" Margin="16,16,16,24">
                
                <TextBlock Text="DETAILS" 
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushTextTertiary}"
                           Margin="0,0,0,8"/>
                
                <!-- Title -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Title *" FontSize="12" />
                    <TextBox Text="{Binding Title}"
                             Watermark="Meeting title" />
                </StackPanel>
                
                <!-- Meeting Type -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Type" FontSize="12" />
                    <ComboBox x:Name="MeetingTypeComboBox"
                              HorizontalAlignment="Stretch"
                              SelectedIndex="0"
                              SelectionChanged="MeetingTypeComboBox_SelectionChanged">
                        <ComboBoxItem Content="1:1 Meeting" Tag="one_on_one" />
                        <ComboBoxItem Content="Team Meeting" Tag="team" />
                        <ComboBoxItem Content="Project Review" Tag="project" />
                        <ComboBoxItem Content="Performance Review" Tag="performance" />
                        <ComboBoxItem Content="Other" Tag="other" />
                    </ComboBox>
                    <TextBlock Text="{Binding MeetingTypeDescription}" 
                               FontSize="11" FontStyle="Italic"
                               Foreground="{DynamicResource BrushTextTertiary}"
                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
                
                <!-- Attendee (for 1:1) -->
                <StackPanel Spacing="4" IsVisible="{Binding ShowAttendeeSelector}">
                    <TextBlock Text="With" FontSize="12" />
                    <ComboBox ItemsSource="{Binding SelectableAttendees}"
                              SelectedItem="{Binding SelectedAttendee}"
                              HorizontalAlignment="Stretch"
                              PlaceholderText="Select team member">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:TeamMemberDetail">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="24" Height="24"
                                            CornerRadius="12"
                                            ClipToBounds="True">
                                        <Panel>
                                            <Border Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                    CornerRadius="12"
                                                    IsVisible="{Binding UserAvatarUrl, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                                                <TextBlock Text="{Binding Initials}"
                                                           FontSize="10"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <Image asyncImageLoader:ImageLoader.Source="{Binding UserAvatarUrl}"
                                                   Stretch="UniformToFill" Width="24" Height="24"
                                                   IsVisible="{Binding UserAvatarUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        </Panel>
                                    </Border>
                                    <TextBlock Text="{Binding FullName}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                
                <!-- Team Attendees (for team meetings) -->
                <StackPanel Spacing="4" IsVisible="{Binding ShowTeamAttendeesSelector}">
                    <!-- Team Picker -->
                    <TextBlock Text="Team" FontSize="12" />
                    <ComboBox ItemsSource="{Binding AvailableTeams}"
                              SelectedItem="{Binding SelectedTeam}"
                              HorizontalAlignment="Stretch"
                              PlaceholderText="Select a team to auto-add members">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:Team">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="24" Height="24"
                                            CornerRadius="4"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}">
                                        <TextBlock Text="T"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="12"/>
                                        <TextBlock FontSize="10"
                                                   Foreground="{DynamicResource BrushTextTertiary}">
                                            <Run Text="{Binding MemberCount}"/>
                                            <Run Text=" members"/>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="Selecting a team will add all its members as attendees"
                               FontSize="11" FontStyle="Italic"
                               Foreground="{DynamicResource BrushTextTertiary}"
                               Margin="0,0,0,8"/>
                    
                    <TextBlock Text="Attendees" FontSize="12" />
                    <TextBlock Text="Team members will be pre-selected when you pick a team" FontSize="11"
                               Foreground="{DynamicResource BrushTextTertiary}" Margin="0,0,0,4"/>
                    <Border Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="6"
                            MaxHeight="140">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SelectableAttendees}" Margin="4">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:TeamMemberDetail">
                                        <Border Padding="4,2" Margin="0,2">
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Border Width="24" Height="24"
                                                            CornerRadius="12"
                                                            ClipToBounds="True">
                                                        <Panel>
                                                            <Border Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                                    CornerRadius="12"
                                                                    IsVisible="{Binding UserAvatarUrl, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                                                                <TextBlock Text="{Binding Initials}"
                                                                           FontSize="10"
                                                                           Foreground="White"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                            </Border>
                                                            <Image asyncImageLoader:ImageLoader.Source="{Binding UserAvatarUrl}"
                                                                   Stretch="UniformToFill" Width="24" Height="24"
                                                                   IsVisible="{Binding UserAvatarUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                        </Panel>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FullName}" FontSize="12"/>
                                                        <TextBlock Text="{Binding RelationDisplay}" FontSize="10"
                                                                   Foreground="{DynamicResource BrushTextTertiary}"
                                                                   IsVisible="{Binding RelationDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </CheckBox>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
                
                <!-- Date and Time -->
                <StackPanel Spacing="4">
                    <TextBlock Text="When *" FontSize="12" />
                    <controls:DateTimeSelector x:Name="DateTimeSelector" 
                                               SelectedDateTime="{Binding ScheduledDateTime, Mode=TwoWay}" />
                </StackPanel>
                
                <!-- Duration -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Duration" FontSize="12" />
                    <ComboBox x:Name="DurationComboBox"
                              HorizontalAlignment="Stretch"
                              SelectedIndex="1"
                              SelectionChanged="DurationComboBox_SelectionChanged">
                        <ComboBoxItem Content="15 minutes" Tag="15" />
                        <ComboBoxItem Content="30 minutes" Tag="30" />
                        <ComboBoxItem Content="45 minutes" Tag="45" />
                        <ComboBoxItem Content="1 hour" Tag="60" />
                        <ComboBoxItem Content="1.5 hours" Tag="90" />
                        <ComboBoxItem Content="2 hours" Tag="120" />
                    </ComboBox>
                </StackPanel>
                
                <!-- Location -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Location" FontSize="12" />
                    <TextBox Text="{Binding Location}"
                             Watermark="Room, office, or link" />
                </StackPanel>
                
                <!-- Video Link -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Video Link" FontSize="12" />
                    <TextBox Text="{Binding VideoLink}"
                             Watermark="Zoom, Teams, Meet URL" />
                </StackPanel>
                
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
