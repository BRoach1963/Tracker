<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ProCohere.Avalonia.ViewModels"
             xmlns:models="using:ProCohere.Avalonia.Models"
             xmlns:markup="using:ProCohere.Avalonia.Markup"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="600"
             x:Class="ProCohere.Avalonia.Views.Controls.NoteEditorFlyout"
             x:DataType="vm:ChronicleViewModel">
    
    <!-- 
    NoteEditorFlyout - Create/edit notes in the Chronicle tab.
    
    Design Philosophy:
    - Clean, focused editing experience
    - Category selection for organization
    - Entity linking support (deferred to Phase 4)
    - Privacy toggle for personal vs shared notes
    -->
    
    <UserControl.Styles>
        <!-- Category chip style -->
        <Style Selector="ToggleButton.category-chip">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="ToggleButton.category-chip:checked">
            <Setter Property="Background" Value="{DynamicResource BrushPrimarySoft}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="ToggleButton.category-chip:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceHover}"/>
        </Style>
        <Style Selector="ToggleButton.category-chip:checked:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushPrimarySoft}"/>
        </Style>
        
        <!-- Field label style -->
        <Style Selector="TextBlock.field-label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        
        <!-- Privacy toggle style -->
        <Style Selector="Border.privacy-option">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Border.privacy-option.selected">
            <Setter Property="Background" Value="{DynamicResource BrushPrimarySoft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}"/>
        </Style>
        <Style Selector="Border.privacy-option:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}"/>
        </Style>
    </UserControl.Styles>
    
    <Border Background="{DynamicResource BrushSurface}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1,0,0,0"
            CornerRadius="8,0,0,8">
        <Grid RowDefinitions="Auto,*,Auto">
            
            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="20,16">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <PathIcon Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z"
                              Width="20" Height="20" Foreground="{DynamicResource BrushPrimary}"/>
                    <TextBlock Text="{Binding EditingNote.Id, Converter={StaticResource GuidIsEmptyToNewOrEditConverter}, ConverterParameter=Note}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTextPrimary}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Command="{Binding CloseNoteEditorCommand}"
                        Classes="icon-button"
                        ToolTip.Tip="Close">
                    <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" 
                              Width="16" Height="16"
                              Foreground="{DynamicResource BrushTextSecondary}"/>
                </Button>
            </Grid>
            
            <!-- Form Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,0,20,20" Spacing="20" DataContext="{Binding EditingNote}">
                    
                    <!-- Title -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="{markup:Localize Key=NoteEditor_TitleLabel}" Classes="field-label"/>
                        <TextBox Text="{Binding Title, Mode=TwoWay}"
                                 Watermark="{markup:Localize Key=NoteEditor_TitleWatermark}"
                                 FontSize="14"/>
                    </StackPanel>
                    
                    <!-- Content -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="{markup:Localize Key=NoteEditor_ContentLabel}" Classes="field-label"/>
                        <TextBox Text="{Binding Content, Mode=TwoWay}"
                                 Watermark="{markup:Localize Key=NoteEditor_ContentWatermark}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="200"
                                 FontSize="14"/>
                    </StackPanel>
                    
                    <!-- Category Selection -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="{markup:Localize Key=NoteEditor_CategoryLabel}" Classes="field-label"/>
                        <WrapPanel Orientation="Horizontal">
                            <ToggleButton Classes="category-chip" Content="{markup:Localize Key=NoteEditor_CategoryMeetingNotes}" Margin="0,0,8,8"
                                          IsChecked="{Binding Category, Mode=TwoWay, Converter={StaticResource StringEqualConverter}, ConverterParameter=Meeting Notes}"/>
                            <ToggleButton Classes="category-chip" Content="{markup:Localize Key=NoteEditor_CategoryIdeas}" Margin="0,0,8,8"
                                          IsChecked="{Binding Category, Mode=TwoWay, Converter={StaticResource StringEqualConverter}, ConverterParameter=Ideas}"/>
                            <ToggleButton Classes="category-chip" Content="{markup:Localize Key=NoteEditor_CategoryActionItems}" Margin="0,0,8,8"
                                          IsChecked="{Binding Category, Mode=TwoWay, Converter={StaticResource StringEqualConverter}, ConverterParameter=Action Items}"/>
                            <ToggleButton Classes="category-chip" Content="{markup:Localize Key=NoteEditor_CategoryResearch}" Margin="0,0,8,8"
                                          IsChecked="{Binding Category, Mode=TwoWay, Converter={StaticResource StringEqualConverter}, ConverterParameter=Research}"/>
                            <ToggleButton Classes="category-chip" Content="{markup:Localize Key=NoteEditor_CategoryPersonal}" Margin="0,0,8,8"
                                          IsChecked="{Binding Category, Mode=TwoWay, Converter={StaticResource StringEqualConverter}, ConverterParameter=Personal}"/>
                            <ToggleButton Classes="category-chip" Content="{markup:Localize Key=NoteEditor_CategoryFollowUp}" Margin="0,0,8,8"
                                          IsChecked="{Binding Category, Mode=TwoWay, Converter={StaticResource StringEqualConverter}, ConverterParameter=Follow-up}"/>
                        </WrapPanel>
                    </StackPanel>
                    
                    <!-- Linked Entities Section (placeholder for Phase 4) -->
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{markup:Localize Key=NoteEditor_LinkToLabel}" Classes="field-label" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Padding="8,4"
                                    Cursor="Hand" CornerRadius="4"
                                    Background="{DynamicResource BrushSurfaceAlt}"
                                    BorderBrush="{DynamicResource BrushBorder}"
                                    BorderThickness="1"
                                    PointerPressed="OnAddLinkPressed"
                                    ToolTip.Tip="{markup:Localize Key=NoteEditor_LinkTooltip}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" 
                                              Width="12" Height="12" 
                                              Foreground="{DynamicResource BrushTextSecondary}"/>
                                    <TextBlock Text="{markup:Localize Key=NoteEditor_AddLink}" FontSize="11"
                                               Foreground="{DynamicResource BrushTextSecondary}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        
                        <!-- Links indicator - simplified for multiple links -->
                        <Border Background="{DynamicResource BrushSecondary}" CornerRadius="4" 
                                Padding="8,4" Margin="0,4,0,0"
                                Cursor="Hand"
                                PointerPressed="OnRemoveLinkPressed"
                                ToolTip.Tip="{markup:Localize Key=NoteEditor_RemoveLinkTooltip}"
                                IsVisible="{Binding $parent[UserControl].((vm:ChronicleViewModel)DataContext).EditingNoteHasLink}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <PathIcon Data="M3.9,12C3.9,10.29 5.29,8.9 7,8.9H11V7H7A5,5 0 0,0 2,12A5,5 0 0,0 7,17H11V15.1H7C5.29,15.1 3.9,13.71 3.9,12M8,13H16V11H8V13M17,7H13V8.9H17C18.71,8.9 20.1,10.29 20.1,12C20.1,13.71 18.71,15.1 17,15.1H13V17H17A5,5 0 0,0 22,12A5,5 0 0,0 17,7Z" 
                                          Width="10" Height="10" Foreground="White"/>
                                <TextBlock Text="{markup:Localize Key=NoteEditor_Linked}"
                                           FontSize="10" Foreground="White"/>
                                <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" 
                                          Width="8" Height="8" Foreground="White" Opacity="0.7"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    
                    <!-- Privacy Toggle (binds to parent ViewModel, not EditingNote) -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="{markup:Localize Key=NoteEditor_VisibilityLabel}" Classes="field-label"/>
                        <Grid ColumnDefinitions="*,*">
                            <Border Grid.Column="0" Classes="privacy-option" Margin="0,0,6,0"
                                    Classes.selected="{Binding $parent[UserControl].((vm:ChronicleViewModel)DataContext).EditingNoteIsPrivate, Converter={StaticResource InverseBoolConverter}}"
                                    PointerPressed="OnSharedOptionPressed">
                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                    <PathIcon Data="M12,5.5A3.5,3.5 0 0,1 15.5,9A3.5,3.5 0 0,1 12,12.5A3.5,3.5 0 0,1 8.5,9A3.5,3.5 0 0,1 12,5.5M5,8C5.56,8 6.08,8.15 6.53,8.42C6.38,9.85 6.8,11.27 7.66,12.38C7.16,13.34 6.16,14 5,14A3,3 0 0,1 2,11A3,3 0 0,1 5,8M19,8A3,3 0 0,1 22,11A3,3 0 0,1 19,14C17.84,14 16.84,13.34 16.34,12.38C17.2,11.27 17.62,9.85 17.47,8.42C17.92,8.15 18.44,8 19,8M5.5,18.25C5.5,16.18 8.41,14.5 12,14.5C15.59,14.5 18.5,16.18 18.5,18.25V20H5.5V18.25M0,20V18.5C0,17.11 1.89,15.94 4.45,15.6C3.86,16.28 3.5,17.22 3.5,18.25V20H0M24,20H20.5V18.25C20.5,17.22 20.14,16.28 19.55,15.6C22.11,15.94 24,17.11 24,18.5V20Z"
                                              Width="18" Height="18" Foreground="{DynamicResource BrushPrimary}"/>
                                    <TextBlock Text="{markup:Localize Key=NoteEditor_Shared}" FontSize="12" FontWeight="Medium"
                                               Foreground="{DynamicResource BrushTextPrimary}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{markup:Localize Key=NoteEditor_VisibleToTeam}" FontSize="10"
                                               Foreground="{DynamicResource BrushTextTertiary}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Classes="privacy-option" Margin="6,0,0,0"
                                    Classes.selected="{Binding $parent[UserControl].((vm:ChronicleViewModel)DataContext).EditingNoteIsPrivate}"
                                    PointerPressed="OnPrivateOptionPressed">
                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                    <PathIcon Data="M12,17A2,2 0 0,0 14,15C14,13.89 13.1,13 12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10C4,8.89 4.9,8 6,8H7V6A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18M12,3A3,3 0 0,0 9,6V8H15V6A3,3 0 0,0 12,3Z"
                                              Width="18" Height="18" Foreground="{DynamicResource BrushHighlight}"/>
                                    <TextBlock Text="{markup:Localize Key=NoteEditor_Private}" FontSize="12" FontWeight="Medium"
                                               Foreground="{DynamicResource BrushTextPrimary}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{markup:Localize Key=NoteEditor_OnlyYou}" FontSize="10"
                                               Foreground="{DynamicResource BrushTextTertiary}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                    
                    <!-- Pin Option (for existing notes) -->
                    <StackPanel Spacing="6" IsVisible="{Binding Id, Converter={StaticResource GuidIsNotEmptyConverter}}">
                        <CheckBox IsChecked="{Binding IsPinned, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="M16,12V4H17V2H7V4H8V12L6,14V16H11.2V22H12.8V16H18V14L16,12Z"
                                          Width="14" Height="14" Foreground="{DynamicResource BrushHighlight}"/>
                                <TextBlock Text="{markup:Localize Key=NoteEditor_PinNote}" FontSize="13"
                                           Foreground="{DynamicResource BrushTextPrimary}"/>
                            </StackPanel>
                        </CheckBox>
                        <TextBlock Text="{markup:Localize Key=NoteEditor_PinDescription}"
                                   FontSize="11" Foreground="{DynamicResource BrushTextTertiary}"
                                   Margin="26,0,0,0"/>
                    </StackPanel>
                    
                </StackPanel>
            </ScrollViewer>
            
            <!-- Footer Actions -->
            <Border Grid.Row="2" 
                    Background="{DynamicResource BrushSurfaceAlt}"
                    BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="0,1,0,0"
                    Padding="20,16">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- Cancel -->
                    <Button Grid.Column="0"
                            Content="{markup:Localize Key=Button_Cancel}"
                            Classes="secondary-button"
                            Command="{Binding CloseNoteEditorCommand}"
                            Padding="16,10"/>
                    
                    <!-- Save -->
                    <Button Grid.Column="2"
                            Command="{Binding SaveNoteCommand}"
                            IsEnabled="{Binding !IsLoading}"
                            Background="{DynamicResource BrushPrimary}"
                            Foreground="{DynamicResource BrushTextOnPrimary}"
                            Padding="24,10"
                            CornerRadius="6"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="M17,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3M19,19H5V5H16.17L19,7.83V19M12,12A3,3 0 0,1 15,15A3,3 0 0,1 12,18A3,3 0 0,1 9,15A3,3 0 0,1 12,12M5,6H15V10H5V6Z"
                                      Width="14" Height="14" Foreground="{DynamicResource BrushTextOnPrimary}"
                                      IsVisible="{Binding !IsLoading}"/>
                            <PathIcon Data="M12,4V2A10,10 0 0,0 2,12H4A8,8 0 0,1 12,4Z"
                                      Width="14" Height="14" Foreground="{DynamicResource BrushTextOnPrimary}"
                                      IsVisible="{Binding IsLoading}"
                                      Classes="spinning"/>
                            <TextBlock Text="{markup:Localize Key=NoteEditor_SaveNote}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
            
        </Grid>
    </Border>
</UserControl>
