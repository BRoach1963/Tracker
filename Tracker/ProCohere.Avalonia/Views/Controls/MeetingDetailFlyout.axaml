<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ProCohere.Avalonia.ViewModels"
             xmlns:models="using:ProCohere.Avalonia.Models"
             mc:Ignorable="d" d:DesignWidth="280" d:DesignHeight="400"
             x:Class="ProCohere.Avalonia.Views.Controls.MeetingDetailFlyout"
             x:DataType="vm:CircleViewModel">
    
    <UserControl.Styles>
        <!-- Flyout Tab Button - Matches navigation rail style -->
        <Style Selector="Button.flyout-tab">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Padding" Value="8,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Width" Value="52"/>
        </Style>
        <!-- Unselected state -->
        <Style Selector="Button.flyout-tab PathIcon">
            <Setter Property="Foreground" Value="#94A3B8"/>
        </Style>
        <Style Selector="Button.flyout-tab TextBlock">
            <Setter Property="Foreground" Value="#94A3B8"/>
        </Style>
        <!-- Hover state -->
        <Style Selector="Button.flyout-tab:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushSecondaryHover}"/>
        </Style>
        <Style Selector="Button.flyout-tab:pointerover PathIcon">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.flyout-tab:pointerover TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <!-- Selected state - gold icon, white text -->
        <Style Selector="Button.flyout-tab.selected">
            <Setter Property="Background" Value="{DynamicResource BrushSecondaryHover}"/>
        </Style>
        <Style Selector="Button.flyout-tab.selected PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource BrushHighlight}"/>
        </Style>
        <Style Selector="Button.flyout-tab.selected TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        
        <!-- Detail Section Header -->
        <Style Selector="TextBlock.detail-section-header">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextTertiary}"/>
            <Setter Property="Margin" Value="0,16,0,8"/>
        </Style>
        
        <!-- Status chip button style -->
        <Style Selector="Button.status-chip">
            <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        <Style Selector="Button.status-chip:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushPrimarySoft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}"/>
        </Style>
        <Style Selector="Button.status-chip:pointerover TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrushPrimary}"/>
        </Style>
    </UserControl.Styles>
    
    <Grid ColumnDefinitions="Auto,*">
        
        <!-- Vertical Tab Bar - Navy blue like navigation -->
        <Border Grid.Column="0" Background="{DynamicResource BrushSecondary}" CornerRadius="8,0,0,8">
            <StackPanel Spacing="2" Margin="0,8">
                <Button Classes="flyout-tab" ToolTip.Tip="Overview"
                        Classes.selected="{Binding MeetingDetailTab, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:MeetingDetailTab.Overview}}"
                        Command="{Binding SetMeetingDetailTabCommand}" CommandParameter="{x:Static vm:MeetingDetailTab.Overview}">
                    <StackPanel Spacing="4">
                        <PathIcon Data="M12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22C6.47,22 2,17.5 2,12A10,10 0 0,1 12,2M12.5,7V12.25L17,14.92L16.25,16.15L11,13V7H12.5Z"
                                  Width="16" Height="16"/>
                        <TextBlock Text="Info" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Classes="flyout-tab" ToolTip.Tip="Agenda"
                        Classes.selected="{Binding MeetingDetailTab, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:MeetingDetailTab.Agenda}}"
                        Command="{Binding SetMeetingDetailTabCommand}" CommandParameter="{x:Static vm:MeetingDetailTab.Agenda}">
                    <StackPanel Spacing="4">
                        <PathIcon Data="M3,5H9V11H3V5M5,7V9H7V7H5M11,7H21V9H11V7M11,15H21V17H11V15M5,20L1.5,16.5L2.91,15.09L5,17.17L9.59,12.59L11,14L5,20Z"
                                  Width="16" Height="16"/>
                        <TextBlock Text="Agenda" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Classes="flyout-tab" ToolTip.Tip="Attendees"
                        Classes.selected="{Binding MeetingDetailTab, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:MeetingDetailTab.Attendees}}"
                        Command="{Binding SetMeetingDetailTabCommand}" CommandParameter="{x:Static vm:MeetingDetailTab.Attendees}">
                    <StackPanel Spacing="4">
                        <PathIcon Data="M12,5.5A3.5,3.5 0 0,1 15.5,9A3.5,3.5 0 0,1 12,12.5A3.5,3.5 0 0,1 8.5,9A3.5,3.5 0 0,1 12,5.5M5,8C5.56,8 6.08,8.15 6.53,8.42C6.38,9.85 6.8,11.27 7.66,12.38C7.16,13.34 6.16,14 5,14A3,3 0 0,1 2,11A3,3 0 0,1 5,8M19,8A3,3 0 0,1 22,11A3,3 0 0,1 19,14C17.84,14 16.84,13.34 16.34,12.38C17.2,11.27 17.62,9.85 17.47,8.42C17.92,8.15 18.44,8 19,8M5.5,18.25C5.5,16.18 8.41,14.5 12,14.5C15.59,14.5 18.5,16.18 18.5,18.25V20H5.5V18.25Z"
                                  Width="16" Height="16"/>
                        <TextBlock Text="People" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Classes="flyout-tab" ToolTip.Tip="Notes"
                        Classes.selected="{Binding MeetingDetailTab, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:MeetingDetailTab.Notes}}"
                        Command="{Binding SetMeetingDetailTabCommand}" CommandParameter="{x:Static vm:MeetingDetailTab.Notes}">
                    <StackPanel Spacing="4">
                        <PathIcon Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20M13,13V18H10V13H13Z"
                                  Width="16" Height="16"/>
                        <TextBlock Text="Notes" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
        
        <!-- Content Area -->
        <Grid Grid.Column="1">
            <!-- Close Button -->
            <Button Classes="icon-button" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,8,8,0" ZIndex="10" ToolTip.Tip="Close"
                    Command="{Binding CloseMeetingDetailCommand}">
                <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                          Width="14" Height="14" Foreground="{DynamicResource BrushTextSecondary}"/>
            </Button>
            
            <!-- ===== OVERVIEW TAB ===== -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding MeetingDetailTab, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:MeetingDetailTab.Overview}}">
                <StackPanel DataContext="{Binding SelectedMeeting}" Margin="12,8,12,12">
                    
                    <!-- Meeting Header -->
                    <StackPanel Margin="0,24,0,16">
                        <Border CornerRadius="6" Padding="8,4" Background="{Binding TypeColor}" 
                                HorizontalAlignment="Left" Margin="0,0,0,10">
                            <TextBlock Text="{Binding TypeDisplay}" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                        </Border>
                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource BrushTextPrimary}" TextWrapping="Wrap"/>
                    </StackPanel>
                    
                    <!-- Time -->
                    <TextBlock Text="TIME" Classes="detail-section-header"/>
                    <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,8">
                        <PathIcon Data="M12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22C6.47,22 2,17.5 2,12A10,10 0 0,1 12,2M12.5,7V12.25L17,14.92L16.25,16.15L11,13V7H12.5Z"
                                  Width="12" Height="12" Foreground="{DynamicResource BrushTextTertiary}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="{Binding ScheduledText}" FontSize="12" FontWeight="Medium"
                                       Foreground="{DynamicResource BrushTextPrimary}"/>
                            <TextBlock FontSize="11" Foreground="{DynamicResource BrushTextSecondary}">
                                <Run Text="{Binding TimeRangeDisplay}"/><Run Text=" · "/><Run Text="{Binding DurationText}"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                    
                    <!-- Location -->
                    <StackPanel IsVisible="{Binding HasLocation}">
                        <TextBlock Text="LOCATION" Classes="detail-section-header"/>
                        <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,8">
                            <PathIcon Data="M12,11.5A2.5,2.5 0 0,1 9.5,9A2.5,2.5 0 0,1 12,6.5A2.5,2.5 0 0,1 14.5,9A2.5,2.5 0 0,1 12,11.5M12,2A7,7 0 0,0 5,9C5,14.25 12,22 12,22C12,22 19,14.25 19,9A7,7 0 0,0 12,2Z"
                                      Width="12" Height="12" Foreground="{DynamicResource BrushTextTertiary}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Location}" FontSize="12"
                                       Foreground="{DynamicResource BrushTextPrimary}" Margin="8,0,0,0"/>
                        </Grid>
                    </StackPanel>
                    
                    <!-- Video Link -->
                    <StackPanel IsVisible="{Binding HasVideoLink}" Margin="0,0,0,8">
                        <Button Classes="action-button" HorizontalAlignment="Stretch"
                                Command="{Binding $parent[UserControl;1].((vm:CircleViewModel)DataContext).OpenUrlCommand}"
                                CommandParameter="{Binding VideoLink}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="M17,10.5V7A1,1 0 0,0 16,6H4A1,1 0 0,0 3,7V17A1,1 0 0,0 4,18H16A1,1 0 0,0 17,17V13.5L21,17.5V6.5L17,10.5Z" Width="12" Height="12"/>
                                <TextBlock Text="Join Video Call" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    
                    <!-- Quick Stats -->
                    <Grid ColumnDefinitions="*,*" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <PathIcon Data="M12,5.5A3.5,3.5 0 0,1 15.5,9A3.5,3.5 0 0,1 12,12.5A3.5,3.5 0 0,1 8.5,9A3.5,3.5 0 0,1 12,5.5" 
                                      Width="12" Height="12" Foreground="{DynamicResource BrushTextTertiary}"/>
                            <TextBlock Text="{Binding AttendeeCountDisplay}" FontSize="11"
                                       Foreground="{DynamicResource BrushTextSecondary}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <PathIcon Data="M3,5H9V11H3V5M5,7V9H7V7H5M11,7H21V9H11V7M11,15H21V17H11V15" 
                                      Width="12" Height="12" Foreground="{DynamicResource BrushTextTertiary}"/>
                            <TextBlock FontSize="11" Foreground="{DynamicResource BrushTextSecondary}">
                                <Run Text="{Binding AgendaItems.Count}"/><Run Text=" items"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                    
                    <!-- Actions -->
                    <StackPanel Margin="0,16,0,0" Spacing="6">
                        <Button Classes="secondary-button" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z" Width="12" Height="12"/>
                                <TextBlock Text="Edit Meeting" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            
            <!-- ===== AGENDA TAB ===== -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding MeetingDetailTab, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:MeetingDetailTab.Agenda}}">
                <StackPanel DataContext="{Binding SelectedMeeting}" Margin="12,8,12,12">
                    <TextBlock Text="AGENDA ITEMS" Classes="detail-section-header" Margin="0,24,0,8"/>
                    
                    <!-- Empty state -->
                    <TextBlock Text="No agenda items" FontSize="12" Opacity="0.5" Margin="0,8,0,0"
                               IsVisible="{Binding !AgendaItems.Count}"/>
                    
                    <!-- Agenda items -->
                    <ItemsControl ItemsSource="{Binding AgendaItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:MeetingAgendaItem">
                                <Border Background="{DynamicResource BrushSurfaceAlt}" CornerRadius="6" 
                                        Padding="10" Margin="0,0,0,6">
                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto">
                                        <!-- Row 0: Checkbox + Title + Status Badge -->
                                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                                            <CheckBox IsChecked="{Binding IsCompleted}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12"
                                                       Foreground="{DynamicResource BrushTextPrimary}" 
                                                       TextWrapping="Wrap" Margin="8,0,8,0"
                                                       TextDecorations="{Binding IsCompleted, Converter={StaticResource BoolToStrikethroughConverter}}"/>
                                            <!-- Status Badge -->
                                            <Border Grid.Column="2" CornerRadius="4" Padding="6,2" VerticalAlignment="Top"
                                                    IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                <Border.Background>
                                                    <SolidColorBrush Color="{Binding StatusColor}"/>
                                                </Border.Background>
                                                <TextBlock Text="{Binding StatusDisplay}" FontSize="9" Foreground="White" FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>
                                        
                                        <!-- Row 1: Description (if any) -->
                                        <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="11"
                                                   Foreground="{DynamicResource BrushTextSecondary}" 
                                                   TextWrapping="Wrap" Margin="28,4,0,0"
                                                   IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        
                                        <!-- Row 2: Status change buttons -->
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4" Margin="28,8,0,0">
                                            <TextBlock Text="Set:" FontSize="9" Foreground="{DynamicResource BrushTextTertiary}" 
                                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <!-- Open -->
                                            <Button Classes="status-chip" ToolTip.Tip="Mark as Open"
                                                    Command="{Binding $parent[UserControl;1].((vm:CircleViewModel)DataContext).SetAgendaItemOpenCommand}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="Open" FontSize="9"/>
                                            </Button>
                                            <!-- Discussed -->
                                            <Button Classes="status-chip" ToolTip.Tip="Mark as Discussed"
                                                    Command="{Binding $parent[UserControl;1].((vm:CircleViewModel)DataContext).SetAgendaItemDiscussedCommand}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="Discussed" FontSize="9"/>
                                            </Button>
                                            <!-- Deferred -->
                                            <Button Classes="status-chip" ToolTip.Tip="Defer to next meeting"
                                                    Command="{Binding $parent[UserControl;1].((vm:CircleViewModel)DataContext).SetAgendaItemDeferredCommand}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="Defer" FontSize="9"/>
                                            </Button>
                                            <!-- Dropped -->
                                            <Button Classes="status-chip" ToolTip.Tip="Drop this item"
                                                    Command="{Binding $parent[UserControl;1].((vm:CircleViewModel)DataContext).SetAgendaItemDroppedCommand}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="Drop" FontSize="9"/>
                                            </Button>
                                        </StackPanel>
                                        
                                        <!-- Row 3: Actions -->
                                        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="28,6,0,0">
                                            <!-- Create Task button (only if not already an action) -->
                                            <Button Classes="icon-button" ToolTip.Tip="Create Task from this item"
                                                    IsVisible="{Binding !HasLinkedEntity}"
                                                    Command="{Binding $parent[UserControl;1].((vm:CircleViewModel)DataContext).CreateTaskFromAgendaItemCommand}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <PathIcon Data="M9,5H7A2,2 0 0,0 5,7V19A2,2 0 0,0 7,21H17A2,2 0 0,0 19,19V7A2,2 0 0,0 17,5H15V7H17V19H7V7H9V5M12,2A2,2 0 0,1 14,4V6H10V4A2,2 0 0,1 12,2M11,11H13V14H16V16H13V19H11V16H8V14H11V11Z" 
                                                              Width="12" Height="12" Foreground="{DynamicResource BrushPrimary}"/>
                                                    <TextBlock Text="Create Task" FontSize="10" Foreground="{DynamicResource BrushPrimary}"/>
                                                </StackPanel>
                                            </Button>
                                            <!-- Linked entity indicator -->
                                            <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasLinkedEntity}">
                                                <PathIcon Data="M10.59,13.41C11,13.8 11,14.44 10.59,14.83C10.2,15.22 9.56,15.22 9.17,14.83C7.22,12.88 7.22,9.71 9.17,7.76V7.76L12.71,4.22C14.66,2.27 17.83,2.27 19.78,4.22C21.73,6.17 21.73,9.34 19.78,11.29L18.29,12.78C18.3,11.96 18.17,11.14 17.89,10.36L18.36,9.88C19.54,8.71 19.54,6.81 18.36,5.64C17.19,4.46 15.29,4.46 14.12,5.64L10.59,9.17C9.41,10.34 9.41,12.24 10.59,13.41M13.41,9.17C13.8,8.78 14.44,8.78 14.83,9.17C16.78,11.12 16.78,14.29 14.83,16.24V16.24L11.29,19.78C9.34,21.73 6.17,21.73 4.22,19.78C2.27,17.83 2.27,14.66 4.22,12.71L5.71,11.22C5.7,12.04 5.83,12.86 6.11,13.65L5.64,14.12C4.46,15.29 4.46,17.19 5.64,18.36C6.81,19.54 8.71,19.54 9.88,18.36L13.41,14.83C14.59,13.66 14.59,11.76 13.41,10.59C13,10.2 13,9.56 13.41,9.17Z" 
                                                          Width="10" Height="10" Foreground="{DynamicResource BrushSuccess}"/>
                                                <TextBlock Text="{Binding LinkedEntityTypeDisplay}" FontSize="10" Foreground="{DynamicResource BrushSuccess}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    
                    <!-- Add Item Button -->
                    <Button Classes="secondary-button" HorizontalAlignment="Stretch" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Width="12" Height="12"/>
                            <TextBlock Text="Add Agenda Item" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
            
            <!-- ===== ATTENDEES TAB ===== -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding MeetingDetailTab, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:MeetingDetailTab.Attendees}}">
                <StackPanel DataContext="{Binding SelectedMeeting}" Margin="12,8,12,12">
                    <TextBlock Text="ATTENDEES" Classes="detail-section-header" Margin="0,24,0,8"/>
                    <TextBlock Text="{Binding AttendeeCountDisplay}" FontSize="11" 
                               Foreground="{DynamicResource BrushTextTertiary}" Margin="0,0,0,12"/>
                    
                    <!-- Attendee list -->
                    <ItemsControl ItemsSource="{Binding Attendees}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:MeetingAttendee">
                                <Border Background="{DynamicResource BrushSurfaceAlt}" CornerRadius="6" 
                                        Padding="10" Margin="0,0,0,6">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Border Width="32" Height="32" CornerRadius="16" 
                                                Background="{DynamicResource BrushPrimary}">
                                            <TextBlock Text="{Binding Initials}" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Medium"
                                                       Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <TextBlock Text="{Binding Email}" FontSize="10"
                                                       Foreground="{DynamicResource BrushTextTertiary}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="Organizer" FontSize="9" 
                                                   Foreground="{DynamicResource BrushPrimary}" VerticalAlignment="Center"
                                                   IsVisible="{Binding IsOrganizer}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    
                    <!-- Add Attendee Button -->
                    <Button Classes="secondary-button" HorizontalAlignment="Stretch" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Width="12" Height="12"/>
                            <TextBlock Text="Add Attendee" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
            
            <!-- ===== NOTES TAB ===== -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding MeetingDetailTab, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:MeetingDetailTab.Notes}}">
                <StackPanel DataContext="{Binding SelectedMeeting}" Margin="12,8,12,12">
                    <TextBlock Text="MEETING NOTES" Classes="detail-section-header" Margin="0,24,0,8"/>
                    
                    <!-- Notes content -->
                    <Border Background="{DynamicResource BrushSurfaceAlt}" CornerRadius="6" Padding="12" MinHeight="200">
                        <Panel>
                            <TextBlock Text="{Binding Notes}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource BrushTextPrimary}" LineHeight="20"
                                       IsVisible="{Binding Notes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <TextBlock Text="No notes yet. Click to add notes..." FontSize="12" Opacity="0.5"
                                       IsVisible="{Binding Notes, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
                        </Panel>
                    </Border>
                    
                    <!-- Edit Notes Button -->
                    <Button Classes="secondary-button" HorizontalAlignment="Stretch" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z" Width="12" Height="12"/>
                            <TextBlock Text="Edit Notes" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
