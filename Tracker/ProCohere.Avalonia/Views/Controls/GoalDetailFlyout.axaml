<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ProCohere.Avalonia.ViewModels"
             xmlns:models="using:ProCohere.Avalonia.Models"
             xmlns:local="using:ProCohere.Avalonia.Converters"
             mc:Ignorable="d" d:DesignWidth="320" d:DesignHeight="600"
             x:Class="ProCohere.Avalonia.Views.Controls.GoalDetailFlyout"
             x:DataType="vm:GoalsViewModel">
    
    <UserControl.Styles>
        <!-- Detail Section Header -->
        <Style Selector="TextBlock.detail-section-header">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextTertiary}"/>
            <Setter Property="Margin" Value="0,16,0,8"/>
        </Style>
        
        <!-- Health/Lifecycle Badge Button -->
        <Style Selector="Button.badge-button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.badge-button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Opacity" Value="0.8"/>
        </Style>
    </UserControl.Styles>
    
    <Border Background="{DynamicResource BrushSurface}" CornerRadius="8">
        <Grid RowDefinitions="Auto,*">
            
            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Background="{DynamicResource BrushSecondary}">
                <TextBlock Text="Goal Details" FontSize="14" FontWeight="SemiBold"
                           Foreground="White" VerticalAlignment="Center" Margin="16,12"/>
                <Button Grid.Column="1" Classes="icon-button" ToolTip.Tip="Close"
                        Command="{Binding CloseDetailFlyoutCommand}" Margin="0,0,8,0">
                    <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                              Width="14" Height="14" Foreground="{DynamicResource BrushTextSecondary}"/>
                </Button>
            </Grid>
            
            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel DataContext="{Binding SelectedGoal}" Margin="16,12,16,16">
                    
                    <!-- Goal Type & Lifecycle Badges -->
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                        <!-- Goal Type Badge -->
                        <Border CornerRadius="4" Padding="8,4" Background="{DynamicResource BrushPrimarySoft}">
                            <TextBlock Text="{Binding GoalType}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushPrimary}"/>
                        </Border>
                        
                        <!-- Lifecycle Badge (clickable) -->
                        <Button Classes="badge-button" ToolTip.Tip="Click to change lifecycle"
                                Command="{Binding $parent[UserControl].((vm:GoalsViewModel)DataContext).OpenLifecycleDialogCommand}">
                            <Border CornerRadius="4" Padding="8,4" Background="#334155">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{Binding Lifecycle}" FontSize="11" FontWeight="Medium"
                                               Foreground="#94A3B8"/>
                                    <PathIcon Data="M7.41,8.58L12,13.17L16.59,8.58L18,10L12,16L6,10L7.41,8.58Z"
                                              Width="10" Height="10" Foreground="#94A3B8"/>
                                </StackPanel>
                            </Border>
                        </Button>
                    </StackPanel>
                    
                    <!-- Title -->
                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextPrimary}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    
                    <!-- Health Section - Narrative approach, NO progress bars -->
                    <TextBlock Text="HEALTH" Classes="detail-section-header"/>
                    <Button Classes="badge-button" HorizontalAlignment="Left" ToolTip.Tip="Click to update health"
                            Command="{Binding $parent[UserControl].((vm:GoalsViewModel)DataContext).OpenHealthDialogCommand}">
                        <Border CornerRadius="6" Padding="12,8" Background="{Binding Health, Converter={StaticResource GoalHealthToBackgroundConverter}}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Health, Converter={StaticResource GoalHealthToDisplayConverter}}" 
                                           FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                <PathIcon Data="M7.41,8.58L12,13.17L16.59,8.58L18,10L12,16L6,10L7.41,8.58Z"
                                          Width="12" Height="12" Foreground="White" Opacity="0.7"/>
                            </StackPanel>
                        </Border>
                    </Button>
                    
                    <!-- Health Context (if available) -->
                    <TextBlock Text="{Binding HealthReason}" FontSize="12" FontStyle="Italic"
                               Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               IsVisible="{Binding HealthReason, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    
                    <!-- Philosophy reminder - subtle guidance -->
                    <Border Background="{DynamicResource BrushSurfaceAlt}" CornerRadius="4" Padding="10,8" Margin="0,12,0,0">
                        <StackPanel Spacing="4">
                            <TextBlock Text="💡 Reflection Prompt" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextTertiary}"/>
                            <TextBlock Text="{Binding Health, Converter={StaticResource GoalHealthToPromptConverter}}" 
                                       FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Owner Section -->
                    <TextBlock Text="OWNER" Classes="detail-section-header"/>
                    <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,8">
                        <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource BrushPrimary}">
                            <PathIcon Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z"
                                      Width="16" Height="16" Foreground="White"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding OwnerName}" FontSize="13" FontWeight="Medium"
                                   Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </Grid>
                    
                    <!-- Timeline Section -->
                    <TextBlock Text="TIME PERIOD" Classes="detail-section-header"/>
                    <Grid RowDefinitions="Auto,Auto" Margin="0,0,0,4">
                        <Grid Grid.Row="0" ColumnDefinitions="70,*">
                            <TextBlock Text="From" FontSize="11" Foreground="{DynamicResource BrushTextTertiary}"/>
                            <TextBlock Grid.Column="1" Text="{Binding StartDate, StringFormat='{}{0:MMM d, yyyy}'}" 
                                       FontSize="11" FontWeight="Medium" Foreground="{DynamicResource BrushTextPrimary}"/>
                        </Grid>
                        <Grid Grid.Row="1" ColumnDefinitions="70,*" Margin="0,4,0,0">
                            <TextBlock Text="To" FontSize="11" Foreground="{DynamicResource BrushTextTertiary}"/>
                            <TextBlock Grid.Column="1" Text="{Binding EndDate, StringFormat='{}{0:MMM d, yyyy}'}" 
                                       FontSize="11" FontWeight="Medium" Foreground="{DynamicResource BrushTextPrimary}"/>
                        </Grid>
                    </Grid>
                    
                    <!-- Description Section -->
                    <TextBlock Text="DESCRIPTION" Classes="detail-section-header"/>
                    <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,8"/>
                    <TextBlock Text="No description provided." FontSize="12" FontStyle="Italic"
                               Foreground="{DynamicResource BrushTextTertiary}"
                               IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
                    
                    <!-- Quick Actions -->
                    <StackPanel Margin="0,24,0,0" Spacing="8">
                        <Button Classes="action-button" HorizontalAlignment="Stretch"
                                Command="{Binding $parent[UserControl].((vm:GoalsViewModel)DataContext).EditGoalCommand}"
                                CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z" Width="12" Height="12"/>
                                <TextBlock Text="Edit Goal" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="secondary-button" HorizontalAlignment="Stretch"
                                Command="{Binding $parent[UserControl].((vm:GoalsViewModel)DataContext).DeleteGoalCommand}"
                                CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z" Width="12" Height="12" Foreground="#DC2626"/>
                                <TextBlock Text="Delete Goal" FontSize="12" Foreground="#DC2626"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
