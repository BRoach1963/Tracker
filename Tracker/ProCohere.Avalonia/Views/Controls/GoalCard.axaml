<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:ProCohere.Avalonia.Models"
             xmlns:markup="using:ProCohere.Avalonia.Markup"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="120"
             x:Class="ProCohere.Avalonia.Views.Controls.GoalCard"
             x:DataType="models:GoalDetail">
    
    <!-- 
    GoalCard - Displays a goal in a list context.
    
    Philosophy: "Goals express intent, Metrics observe reality, Humans decide."
    NO progress bars, percentages, or red/yellow/green status indicators.
    Uses neutral blue/navy color palette only.
    -->
    
    <UserControl.Styles>
        <!-- Health badge base style -->
        <Style Selector="Border.health-badge">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        
        <!-- On Track - Light blue -->
        <Style Selector="Border.health-on-track">
            <Setter Property="Background" Value="#E0F2FE"/>
        </Style>
        <Style Selector="Border.health-on-track TextBlock">
            <Setter Property="Foreground" Value="#0369A1"/>
        </Style>
        
        <!-- Needs Attention - Slightly darker blue -->
        <Style Selector="Border.health-needs-attention">
            <Setter Property="Background" Value="#DBEAFE"/>
        </Style>
        <Style Selector="Border.health-needs-attention TextBlock">
            <Setter Property="Foreground" Value="#1E40AF"/>
        </Style>
        
        <!-- At Risk - Navy -->
        <Style Selector="Border.health-at-risk">
            <Setter Property="Background" Value="#E2E8F0"/>
        </Style>
        <Style Selector="Border.health-at-risk TextBlock">
            <Setter Property="Foreground" Value="#334155"/>
        </Style>
        
        <!-- Reframing Needed - Slate -->
        <Style Selector="Border.health-reframing">
            <Setter Property="Background" Value="#F1F5F9"/>
        </Style>
        <Style Selector="Border.health-reframing TextBlock">
            <Setter Property="Foreground" Value="#475569"/>
        </Style>
        
        <!-- Lifecycle badge -->
        <Style Selector="Border.lifecycle-badge">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Background" Value="#F8FAFC"/>
        </Style>
        <Style Selector="Border.lifecycle-badge TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#64748B"/>
        </Style>
    </UserControl.Styles>
    
    <Border Background="{DynamicResource BrushSurface}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16,12"
            Cursor="Hand"
            x:Name="CardBorder">
        
        <Border.Styles>
            <Style Selector="Border#CardBorder:pointerover">
                <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}"/>
                <Setter Property="Background" Value="{DynamicResource BrushSurfaceHover}"/>
            </Style>
        </Border.Styles>
        
        <Grid RowDefinitions="Auto,Auto,Auto">
            <!-- Row 0: Health badge + Lifecycle + Owner -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto">
                
                <!-- Health badge - On Track -->
                <Border Grid.Column="0" 
                        Classes="health-badge health-on-track"
                        IsVisible="{Binding Health, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static models:GoalHealth.OnTrack}}">
                    <TextBlock Text="{markup:Localize Key=GoalHealth_OnTrack}" FontSize="11" FontWeight="Medium"/>
                </Border>
                
                <!-- Health badge - Needs Attention -->
                <Border Grid.Column="0" 
                        Classes="health-badge health-needs-attention"
                        IsVisible="{Binding Health, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static models:GoalHealth.NeedsAttention}}">
                    <TextBlock Text="{markup:Localize Key=GoalHealth_NeedsAttention}" FontSize="11" FontWeight="Medium"/>
                </Border>
                
                <!-- Health badge - At Risk -->
                <Border Grid.Column="0" 
                        Classes="health-badge health-at-risk"
                        IsVisible="{Binding Health, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static models:GoalHealth.AtRisk}}">
                    <TextBlock Text="{markup:Localize Key=GoalHealth_AtRisk}" FontSize="11" FontWeight="Medium"/>
                </Border>
                
                <!-- Health badge - Reframing Needed -->
                <Border Grid.Column="0" 
                        Classes="health-badge health-reframing"
                        IsVisible="{Binding Health, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static models:GoalHealth.ReframingNeeded}}">
                    <TextBlock Text="{markup:Localize Key=GoalHealth_Reframing}" FontSize="11" FontWeight="Medium"/>
                </Border>
                
                <!-- Lifecycle badge (if not Active) -->
                <Border Grid.Column="1" 
                        Classes="lifecycle-badge"
                        Margin="8,0,0,0"
                        IsVisible="{Binding Lifecycle, Converter={StaticResource EnumNotEqualConverter}, ConverterParameter={x:Static models:GoalLifecycle.Active}}">
                    <TextBlock Text="{Binding LifecycleDisplay}"/>
                </Border>
                
                <!-- Owner name -->
                <TextBlock Grid.Column="3"
                           Text="{Binding OwnerName, FallbackValue='Unassigned'}"
                           FontSize="12"
                           Opacity="0.6"
                           VerticalAlignment="Center"/>
            </Grid>
            
            <!-- Row 1: Title and description -->
            <StackPanel Grid.Row="1" Margin="0,10,0,0" Spacing="4">
                <TextBlock Text="{Binding Title}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource BrushTextPrimary}"/>
                <TextBlock Text="{Binding Description}"
                           FontSize="13"
                           Opacity="0.7"
                           TextTrimming="CharacterEllipsis"
                           MaxLines="2"
                           TextWrapping="Wrap"
                           IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
            
            <!-- Row 2: Goal type + Time period info -->
            <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,10,0,0">
                <!-- Goal type icon + label -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                    <!-- Growth goal icon -->
                    <PathIcon Data="M16,6L18.29,8.29L13.41,13.17L9.41,9.17L2,16.59L3.41,18L9.41,12L13.41,16L19.71,9.71L22,12V6H16Z"
                              Width="14" Height="14"
                              Foreground="{DynamicResource BrushTextTertiary}"
                              IsVisible="{Binding GoalType, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static models:GoalType.Growth}}"/>
                    <!-- Execution goal icon -->
                    <PathIcon Data="M19,3H14.82C14.4,1.84 13.3,1 12,1C10.7,1 9.6,1.84 9.18,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M12,3A1,1 0 0,1 13,4A1,1 0 0,1 12,5A1,1 0 0,1 11,4A1,1 0 0,1 12,3M7,7H17V5H19V19H5V5H7V7M10,17L15,12L13.59,10.59L10,14.17L8.41,12.58L7,14L10,17Z"
                              Width="14" Height="14"
                              Foreground="{DynamicResource BrushTextTertiary}"
                              IsVisible="{Binding GoalType, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static models:GoalType.Execution}}"/>
                    <!-- Operational goal icon -->
                    <PathIcon Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"
                              Width="14" Height="14"
                              Foreground="{DynamicResource BrushTextTertiary}"
                              IsVisible="{Binding GoalType, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static models:GoalType.Operational}}"/>
                    <!-- Directional goal icon -->
                    <PathIcon Data="M12,2L4.5,20.29L5.21,21L12,18L18.79,21L19.5,20.29L12,2Z"
                              Width="14" Height="14"
                              Foreground="{DynamicResource BrushTextTertiary}"
                              IsVisible="{Binding GoalType, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static models:GoalType.Directional}}"/>
                    
                    <TextBlock Text="{Binding GoalTypeDisplay}"
                               FontSize="11"
                               Opacity="0.5"/>
                </StackPanel>
                
                <!-- Time period / due date -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <PathIcon Data="M19,19H5V8H19M16,1V3H8V1H6V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3H18V1"
                              Width="12" Height="12"
                              Foreground="{DynamicResource BrushTextTertiary}"
                              IsVisible="{Binding DueDate, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <TextBlock Text="{Binding DueDateDisplay}"
                               FontSize="11"
                               Opacity="0.5"
                               IsVisible="{Binding DueDate, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
