<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ProCohere.Avalonia.ViewModels"
             xmlns:models="using:ProCohere.Avalonia.Models"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="600"
             x:Class="ProCohere.Avalonia.Views.Controls.LifecycleChangeDialog"
             x:DataType="vm:GoalsViewModel">
    
    <UserControl.Styles>
        <!-- Lifecycle Option Button -->
        <Style Selector="Button.lifecycle-option">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.lifecycle-option:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}"/>
        </Style>
        <Style Selector="Button.lifecycle-option.selected">
            <Setter Property="Background" Value="{DynamicResource BrushPrimarySoft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
    </UserControl.Styles>
    
    <!-- Modal Overlay -->
    <Border Background="#80000000">
        <Border Background="{DynamicResource BrushSurface}" CornerRadius="12" 
                Width="420" MaxHeight="620" VerticalAlignment="Center" HorizontalAlignment="Center"
                BoxShadow="0 8 32 0 #40000000">
            <Grid RowDefinitions="Auto,*,Auto">
                
                <!-- Header -->
                <Border Grid.Row="0" Background="{DynamicResource BrushSecondary}" CornerRadius="12,12,0,0" Padding="20,16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Update Lifecycle" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                            <TextBlock Text="{Binding SelectedGoal.Title}" FontSize="12" Foreground="#94A3B8"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="icon-button" ToolTip.Tip="Cancel"
                                Command="{Binding CancelLifecycleDialogCommand}">
                            <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                      Width="14" Height="14" Foreground="{DynamicResource BrushTextSecondary}"/>
                        </Button>
                    </Grid>
                </Border>
                
                <!-- Content -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,16,20,20" Spacing="16">
                        
                        <!-- Philosophy Banner -->
                        <Border Background="{DynamicResource BrushSurfaceAlt}" CornerRadius="8" Padding="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="🔄 Goal Evolution" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushPrimary}"/>
                                <TextBlock Text="Goals evolve. This captures where the goal is in its journey, not whether it 'succeeded' or 'failed'." 
                                           FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- Lifecycle Options -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="SELECT LIFECYCLE STATE" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextTertiary}"/>
                            
                            <!-- Active -->
                            <Button Classes="lifecycle-option"
                                    Classes.selected="{Binding SelectedLifecycle, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static models:GoalLifecycle.Active}}"
                                    Command="{Binding SelectLifecycleCommand}" CommandParameter="{x:Static models:GoalLifecycle.Active}">
                                <Grid ColumnDefinitions="Auto,*">
                                    <PathIcon Data="M12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,7A5,5 0 0,0 7,12A5,5 0 0,0 12,17A5,5 0 0,0 17,12A5,5 0 0,0 12,7Z"
                                              Width="20" Height="20" Foreground="#3B82F6" Margin="0,0,12,0"/>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="Active" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                                        <TextBlock Text="Being actively worked on" FontSize="11"
                                                   Foreground="{DynamicResource BrushTextSecondary}"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                            
                            <!-- Evolving -->
                            <Button Classes="lifecycle-option"
                                    Classes.selected="{Binding SelectedLifecycle, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static models:GoalLifecycle.Evolving}}"
                                    Command="{Binding SelectLifecycleCommand}" CommandParameter="{x:Static models:GoalLifecycle.Evolving}">
                                <Grid ColumnDefinitions="Auto,*">
                                    <PathIcon Data="M12,6V9L16,5L12,1V4A8,8 0 0,0 4,12C4,13.57 4.46,15.03 5.24,16.26L6.7,14.8C6.25,13.97 6,13 6,12A6,6 0 0,1 12,6M18.76,7.74L17.3,9.2C17.74,10.04 18,11 18,12A6,6 0 0,1 12,18V15L8,19L12,23V20A8,8 0 0,0 20,12C20,10.43 19.54,8.97 18.76,7.74Z"
                                              Width="20" Height="20" Foreground="#6366F1" Margin="0,0,12,0"/>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="Evolving" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                                        <TextBlock Text="Scope or direction is changing" FontSize="11"
                                                   Foreground="{DynamicResource BrushTextSecondary}"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                            
                            <!-- Paused -->
                            <Button Classes="lifecycle-option"
                                    Classes.selected="{Binding SelectedLifecycle, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static models:GoalLifecycle.Paused}}"
                                    Command="{Binding SelectLifecycleCommand}" CommandParameter="{x:Static models:GoalLifecycle.Paused}">
                                <Grid ColumnDefinitions="Auto,*">
                                    <PathIcon Data="M14,19H18V5H14M6,19H10V5H6V19Z"
                                              Width="20" Height="20" Foreground="#94A3B8" Margin="0,0,12,0"/>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="Paused" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                                        <TextBlock Text="Temporarily on hold" FontSize="11"
                                                   Foreground="{DynamicResource BrushTextSecondary}"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                            
                            <!-- Superseded -->
                            <Button Classes="lifecycle-option"
                                    Classes.selected="{Binding SelectedLifecycle, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static models:GoalLifecycle.Superseded}}"
                                    Command="{Binding SelectLifecycleCommand}" CommandParameter="{x:Static models:GoalLifecycle.Superseded}">
                                <Grid ColumnDefinitions="Auto,*">
                                    <PathIcon Data="M14,3V5H17.59L7.76,14.83L9.17,16.24L19,6.41V10H21V3M19,19H5V5H12V3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V12H19V19Z"
                                              Width="20" Height="20" Foreground="#A855F7" Margin="0,0,12,0"/>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="Superseded" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                                        <TextBlock Text="Replaced by another goal" FontSize="11"
                                                   Foreground="{DynamicResource BrushTextSecondary}"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                            
                            <!-- Retired -->
                            <Button Classes="lifecycle-option"
                                    Classes.selected="{Binding SelectedLifecycle, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static models:GoalLifecycle.Retired}}"
                                    Command="{Binding SelectLifecycleCommand}" CommandParameter="{x:Static models:GoalLifecycle.Retired}">
                                <Grid ColumnDefinitions="Auto,*">
                                    <PathIcon Data="M19,19H5V5H19M19,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3M16.5,16.25C16.5,14.75 13.5,14 12,14C10.5,14 7.5,14.75 7.5,16.25V17H16.5M12,12.25A2.25,2.25 0 0,0 14.25,10A2.25,2.25 0 0,0 12,7.75A2.25,2.25 0 0,0 9.75,10A2.25,2.25 0 0,0 12,12.25Z"
                                              Width="20" Height="20" Foreground="#64748B" Margin="0,0,12,0"/>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="Retired" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                                        <TextBlock Text="No longer relevant, kept for history" FontSize="11"
                                                   Foreground="{DynamicResource BrushTextSecondary}"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </StackPanel>
                        
                        <!-- Superseded By Picker (only visible when Superseded is selected) -->
                        <StackPanel Spacing="8" IsVisible="{Binding ShowSupersededByPicker}">
                            <TextBlock Text="SUPERSEDED BY" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextTertiary}"/>
                            <ComboBox ItemsSource="{Binding AvailableGoalsForSupersede}"
                                      SelectedValue="{Binding SupersededById}"
                                      SelectedValueBinding="{Binding Id}"
                                      DisplayMemberBinding="{Binding Title}"
                                      PlaceholderText="Select the replacement goal..."
                                      HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        
                        <!-- Reflection Prompt -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="REFLECTION" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextTertiary}"/>
                            <Border Background="{DynamicResource BrushPrimarySoft}" CornerRadius="6" Padding="10,8">
                                <TextBlock Text="{Binding LifecycleReflectionPrompt}" FontSize="12" FontStyle="Italic"
                                           TextWrapping="Wrap" Foreground="{DynamicResource BrushPrimary}"/>
                            </Border>
                            <TextBox Text="{Binding LifecycleReason}" 
                                     Watermark="What led to this change..."
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="80" MaxHeight="120"/>
                        </StackPanel>
                        
                    </StackPanel>
                </ScrollViewer>
                
                <!-- Actions -->
                <Border Grid.Row="2" Background="{DynamicResource BrushSurfaceAlt}" CornerRadius="0,0,12,12" Padding="20,16">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBlock Text="This change will be recorded in the goal's history."
                                   FontSize="10" Foreground="{DynamicResource BrushTextTertiary}"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Classes="secondary-button" Content="Cancel" Margin="0,0,8,0"
                                Command="{Binding CancelLifecycleDialogCommand}"/>
                        <Button Grid.Column="2" Classes="action-button" Content="Save Lifecycle"
                                Command="{Binding SaveLifecycleChangeCommand}"/>
                    </Grid>
                </Border>
                
            </Grid>
        </Border>
    </Border>
</UserControl>
