<Window
    x:Class="ProCohere.Avalonia.Views.HelpWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ProCohere.Avalonia.ViewModels"
    xmlns:models="using:ProCohere.Avalonia.Models"
    xmlns:markup="using:ProCohere.Avalonia.Markup"
    Title="{markup:Localize Key=Help_WindowTitle}"
    Width="800"
    Height="600"
    WindowStartupLocation="CenterScreen"
    Icon="{DynamicResource AppIcon}"
    x:DataType="vm:HelpWindowViewModel">
    
    <Design.DataContext>
        <vm:HelpWindowViewModel />
    </Design.DataContext>
    
    <Grid RowDefinitions="Auto,*">
        
        <!-- Search Header -->
        <Border Grid.Row="0" 
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                Padding="16">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <!-- Search Box -->
                <TextBox Grid.Column="0"
                         Text="{Binding SearchQuery}"
                         Watermark="{markup:Localize Key=Help_SearchWatermark}"
                         Margin="0,0,12,0" />
                         
                <!-- Search Button -->
                <Button Grid.Column="1"
                        Content="{markup:Localize Key=Button_Search}"
                        Command="{Binding SearchCommand}"
                        Margin="0,0,12,0" />
                        
                <!-- Close Button -->
                <Button Grid.Column="2"
                        Content="{markup:Localize Key=Button_Close}"
                        Command="{Binding CloseCommand}"
                        CommandParameter="{Binding $parent[Window]}" />
            </Grid>
        </Border>
        
        <!-- Content Area -->
        <Grid Grid.Row="1" ColumnDefinitions="250,*">
            
            <!-- Topic List Sidebar -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SystemControlBackgroundChromeLowBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- Category Header -->
                    <TextBlock DockPanel.Dock="Top"
                               Text="{markup:Localize Key=Help_TopicsHeader}"
                               FontWeight="SemiBold"
                               Margin="16,16,16,8" />
                    
                    <!-- Topics List -->
                    <ListBox ItemsSource="{Binding Topics}"
                             SelectedItem="{Binding SelectedTopic}"
                             Background="Transparent"
                             Margin="8,0,8,8">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="models:HelpTopic">
                                <StackPanel Margin="8,4">
                                    <TextBlock Text="{Binding Title}" 
                                               FontWeight="Medium"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Category}"
                                               FontSize="11"
                                               Opacity="0.7"
                                               IsVisible="{Binding Category, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            
            <!-- Help Content -->
            <Border Grid.Column="1" Padding="16">
                <ScrollViewer>
                    <StackPanel Spacing="16">
                        <!-- Topic Title -->
                        <TextBlock Text="{Binding SelectedTopic.Title}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   IsVisible="{Binding SelectedTopic, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        
                        <!-- Topic Content -->
                        <SelectableTextBlock Text="{Binding SelectedTopic.Content}"
                                            TextWrapping="Wrap"
                                            IsVisible="{Binding SelectedTopic, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        
                        <!-- No Topic Selected -->
                        <StackPanel IsVisible="{Binding SelectedTopic, Converter={x:Static ObjectConverters.IsNull}}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Spacing="8">
                            <TextBlock Text="{markup:Localize Key=Help_SelectTopicPrompt}"
                                       FontSize="16"
                                       HorizontalAlignment="Center"
                                       Opacity="0.7" />
                            <TextBlock Text="{markup:Localize Key=Help_SearchPrompt}"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       Opacity="0.5" />
                        </StackPanel>
                        
                        <!-- Related Topics -->
                        <StackPanel IsVisible="{Binding !!SelectedTopic.RelatedTopics.Count}"
                                    Spacing="8">
                            <TextBlock Text="{markup:Localize Key=Help_RelatedTopics}"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Margin="0,16,0,0" />
                            <ItemsControl ItemsSource="{Binding RelatedTopics}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="models:HelpTopic">
                                        <Button Content="{Binding Title}"
                                                Command="{Binding $parent[Window].((vm:HelpWindowViewModel)DataContext).SelectTopicCommand}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Foreground="{DynamicResource SystemAccentColor}"
                                                HorizontalAlignment="Left"
                                                Padding="0,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>