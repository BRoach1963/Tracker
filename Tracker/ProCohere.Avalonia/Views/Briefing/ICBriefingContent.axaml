<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ProCohere.Avalonia.ViewModels"
             xmlns:models="using:ProCohere.Avalonia.Models"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="ProCohere.Avalonia.Views.Briefing.ICBriefingContent"
             x:DataType="vm:BriefingViewModel">

    <!-- IC (Individual Contributor) Briefing
         
         PURPOSE: "What do I need to work on next? What's coming up that affects me?"
         
         This is NOT a dashboard.
         This is NOT "Manager Briefing minus team members".
         This is a work-prep snapshot for someone who thinks in sequence, not totals.
         
         STRUCTURE:
         - Week View: Sparkline → Tasks → Meetings → Quick Actions
         - Day View: Tasks → Meetings → Quick Actions (ZERO charts)
         
         RULES:
         - No summary metric cards (no counts)
         - No goals section
         - Tasks are visually dominant (full width)
         - Meetings are secondary (stacked below, not side-by-side)
         - Quick Actions: Task, Note, Meeting (in that order)
         
         SMELL TEST:
         - If I remove the user name, can I tell this is for an IC?
         - If yes → correct
         - If no → wrong
    -->

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto">

        <!-- Row 0: Sparkline (WEEK VIEW ONLY) -->
        <Border Grid.Row="0" 
                Background="{DynamicResource BrushSurface}" 
                CornerRadius="10" 
                Padding="16,14"
                Margin="0,0,0,12" 
                BorderBrush="{DynamicResource BrushBorder}" 
                BorderThickness="1"
                IsVisible="{Binding IsWeekScope}">
            <Grid RowDefinitions="Auto,Auto">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                    <TextBlock Text="My week" 
                               FontSize="13" 
                               FontWeight="Medium" 
                               Foreground="{DynamicResource BrushTextSecondary}" 
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" 
                               Text="next 7 days" 
                               FontSize="11" 
                               Foreground="{DynamicResource BrushTextTertiary}" 
                               VerticalAlignment="Center"/>
                </Grid>

                <ItemsControl Grid.Row="1" ItemsSource="{Binding WeeklyLoad}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" Columns="7"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:DailyLoad">
                            <Grid RowDefinitions="*,Auto" Margin="4,0" Height="50">
                                <Border Grid.Row="0" VerticalAlignment="Bottom">
                                    <Border CornerRadius="3,3,0,0" 
                                            MinHeight="4" 
                                            Height="{Binding BarHeight}"
                                            Background="{Binding BarColor}"
                                            ToolTip.Tip="{Binding Tooltip}"/>
                                </Border>
                                <TextBlock Grid.Row="1" 
                                           Text="{Binding DayLabel}" 
                                           FontSize="10" 
                                           HorizontalAlignment="Center" 
                                           Margin="0,4,0,0"
                                           Foreground="{DynamicResource BrushTextTertiary}"
                                           FontWeight="{Binding DayLabelWeight}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- Row 1: AI Insights (only visible when HasAIInsights = true) -->
        <Border Grid.Row="1" IsVisible="{Binding HasAIInsights}"
                Background="{DynamicResource BrushSurface}" CornerRadius="10" Padding="14"
                Margin="0,4,0,12" BorderBrush="{DynamicResource BrushPrimarySoft}" BorderThickness="1"
                MaxHeight="300">
            <Grid RowDefinitions="Auto,*">
                <!-- Header -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,10">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,16.5L6.5,12L7.91,10.59L11,13.67L16.59,8.09L18,9.5L11,16.5Z" 
                                  Width="16" Height="16" 
                                  Foreground="{DynamicResource BrushPrimary}"/>
                        <TextBlock Text="AI Insights" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Insights List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding AIInsights}">
                        <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- InsightCard component - State flows FROM ViewModel TO View -->
                            <Border Background="{DynamicResource BrushBackground}" 
                                    CornerRadius="8" Padding="12" Margin="0,0,0,8"
                                    BorderBrush="{Binding SeverityColor}" BorderThickness="1">
                                <Grid RowDefinitions="Auto,Auto,Auto">
                                    <!-- Row 0: Header with icon, title, time -->
                                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,6">
                                        <PathIcon Grid.Column="0" Data="{Binding SeverityIcon}" 
                                                  Width="16" Height="16" 
                                                  Foreground="{Binding SeverityColor}"
                                                  Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" 
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BrushTextPrimary}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="2" Text="{Binding RelativeTime}" 
                                                   FontSize="10" 
                                                   Foreground="{DynamicResource BrushTextTertiary}"
                                                   Margin="8,0,0,0"/>
                                    </Grid>

                                    <!-- Row 1: Description -->
                                    <TextBlock Grid.Row="1" Text="{Binding Content}" 
                                               FontSize="12" 
                                               Foreground="{DynamicResource BrushTextSecondary}"
                                               TextWrapping="Wrap"
                                               Margin="24,0,0,8"/>

                                    <!-- Row 2: Actions - Commands flow FROM View TO ViewModel -->
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="24,4,0,0">
                                        <Button Command="{Binding $parent[UserControl].((vm:BriefingViewModel)DataContext).ViewInsightCommand}"
                                                CommandParameter="{Binding}"
                                                Classes="text-button"
                                                IsVisible="{Binding EntityId, Converter={x:Static ObjectConverters.IsNotNull}}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <PathIcon Data="M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5Z" 
                                                          Width="12" Height="12"/>
                                                <TextBlock Text="View" FontSize="11"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding $parent[UserControl].((vm:BriefingViewModel)DataContext).SnoozeInsightCommand}"
                                                CommandParameter="{Binding}"
                                                Classes="text-button">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <PathIcon Data="M9,2V4H7V6H9V7.09C6.16,7.57 4,10.03 4,13A7,7 0 0,0 11,20C14.38,20 17.16,17.45 17.74,14H15.69C15.14,16.34 13,18 11,18A5,5 0 0,1 6,13C6,10.92 7.21,9.16 9,8.35V11H11V2M18,6V8H20V10H18V12H16V10H14V8H16V6H18Z" 
                                                          Width="12" Height="12"/>
                                                <TextBlock Text="Snooze 24h" FontSize="11"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding $parent[UserControl].((vm:BriefingViewModel)DataContext).DismissInsightCommand}"
                                                CommandParameter="{Binding}"
                                                Classes="text-button">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" 
                                                          Width="12" Height="12"/>
                                                <TextBlock Text="Dismiss" FontSize="11"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Row 2: My Tasks (DOMINANT - full width, this is why IC opens Briefing) -->
        <Border Grid.Row="2"
                Background="{DynamicResource BrushSurface}" 
                CornerRadius="10"
                Margin="0,0,0,12" 
                BorderBrush="{DynamicResource BrushBorder}" 
                BorderThickness="1"
                ClipToBounds="True">
            <Grid RowDefinitions="Auto,*">
                <!-- Header Banner -->
                <Border Grid.Row="0" Background="{DynamicResource BrushSecondarySubtle}" Padding="16,10" CornerRadius="10,10,0,0" Margin="-1,-1,-1,0">
                    <TextBlock Text="My Tasks" 
                               FontSize="15" 
                               FontWeight="SemiBold" 
                               Foreground="{DynamicResource BrushTextOnPrimary}"/>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="16,12,16,16">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding SortedUpcomingTasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:TaskDetail">
                                    <Border Padding="12,10" 
                                            Margin="0,0,0,8" 
                                            Background="{DynamicResource BrushBackground}" 
                                            CornerRadius="8" 
                                            Cursor="Hand">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <!-- Checkbox -->
                                            <Border Grid.Column="0" 
                                                    Width="20" 
                                                    Height="20" 
                                                    CornerRadius="4" 
                                                    BorderBrush="{DynamicResource BrushBorder}" 
                                                    BorderThickness="1.5" 
                                                    Margin="0,1,12,0" 
                                                    VerticalAlignment="Top"/>
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock Text="{Binding Title}" 
                                                           FontSize="14" 
                                                           FontWeight="Medium"
                                                           Foreground="{DynamicResource BrushTextPrimary}" 
                                                           TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding DueDateText}" 
                                                               FontSize="12" 
                                                               Foreground="{Binding DueDateBrush}"/>
                                                    <!-- Project label (quiet, non-interactive) -->
                                                    <TextBlock Text="•" FontSize="12" 
                                                               Foreground="{DynamicResource BrushTextTertiary}"
                                                               IsVisible="{Binding HasProject}"/>
                                                    <TextBlock Text="{Binding ProjectTitle}" 
                                                               FontSize="12" 
                                                               Foreground="{DynamicResource BrushTextTertiary}"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="150"
                                                               IsVisible="{Binding HasProject}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty state -->
                        <Border IsVisible="{Binding !UpcomingTasks.Count}" 
                                Padding="24" 
                                Background="{DynamicResource BrushBackground}" 
                                CornerRadius="8">
                            <TextBlock Text="Nothing due — you're clear" 
                                       FontSize="13" 
                                       Foreground="{DynamicResource BrushTextTertiary}" 
                                       HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Row 3: My Meetings (SECONDARY - stacked below tasks, not side-by-side) -->
        <Border Grid.Row="3" 
                Background="{DynamicResource BrushSurface}" 
                CornerRadius="10"
                Margin="0,0,0,12" 
                BorderBrush="{DynamicResource BrushBorder}" 
                BorderThickness="1"
                MaxHeight="200"
                ClipToBounds="True">
            <Grid RowDefinitions="Auto,*">
                <!-- Header Banner -->
                <Border Grid.Row="0" Background="{DynamicResource BrushSecondarySubtle}" Padding="16,10" CornerRadius="10,10,0,0" Margin="-1,-1,-1,0">
                    <TextBlock Text="My Meetings" 
                               FontSize="14" 
                               FontWeight="SemiBold" 
                               Foreground="{DynamicResource BrushTextOnPrimary}"/>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="16,10,16,14">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding UpcomingMeetings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:MeetingDetail">
                                    <Border Padding="10,8" 
                                            Margin="0,0,0,6" 
                                            Background="{DynamicResource BrushBackground}" 
                                            CornerRadius="6" 
                                            Cursor="Hand">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <Border Grid.Column="0" 
                                                    Width="4" 
                                                    CornerRadius="2" 
                                                    Background="{DynamicResource BrushPrimary}" 
                                                    Margin="0,0,10,0"/>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="{Binding Title}" 
                                                           FontSize="13" 
                                                           FontWeight="Medium"
                                                           Foreground="{DynamicResource BrushTextPrimary}" 
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding ScheduledText}" 
                                                           FontSize="11" 
                                                           Foreground="{DynamicResource BrushTextSecondary}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty state -->
                        <Border IsVisible="{Binding !UpcomingMeetings.Count}" 
                                Padding="16" 
                                Background="{DynamicResource BrushBackground}" 
                                CornerRadius="6">
                            <TextBlock Text="No meetings scheduled" 
                                       FontSize="12" 
                                       Foreground="{DynamicResource BrushTextTertiary}" 
                                       HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Row 4: Project Signals (Passive awareness - click navigates to Projects) -->
        <Border Grid.Row="4" 
                Background="{DynamicResource BrushSurface}" 
                CornerRadius="10" 
                Padding="16,14"
                Margin="0,0,0,12" 
                BorderBrush="{DynamicResource BrushBorder}" 
                BorderThickness="1"
                IsVisible="{Binding HasProjectSignals}">
            <Grid RowDefinitions="Auto,Auto">
                <TextBlock Grid.Row="0" 
                           Text="Project Signals" 
                           FontSize="13" 
                           FontWeight="Medium" 
                           Foreground="{DynamicResource BrushTextSecondary}" 
                           Margin="0,0,0,8"/>
                
                <ItemsControl Grid.Row="1" ItemsSource="{Binding ProjectSignals}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:ProjectSignal">
                            <Button Classes="ghost"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Command="{Binding $parent[UserControl].((vm:BriefingViewModel)DataContext).NavigateToProjectCommand}"
                                    CommandParameter="{Binding}"
                                    Padding="10,8" 
                                    Margin="0,0,0,4"
                                    CornerRadius="6">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <!-- Signal Icon -->
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding IconGlyph}"
                                               FontFamily="{StaticResource SymbolThemeFontFamily}"
                                               FontSize="14"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"
                                               Foreground="{DynamicResource BrushTextSecondary}"/>
                                    <!-- Project Name + Summary -->
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Text="{Binding ProjectName}" 
                                                   FontSize="13" 
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource BrushTextPrimary}" 
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Summary}" 
                                                   FontSize="11" 
                                                   Foreground="{DynamicResource BrushTextTertiary}"/>
                                    </StackPanel>
                                    <!-- Navigate arrow -->
                                    <TextBlock Grid.Column="2"
                                               Text="&#xE76C;"
                                               FontFamily="{StaticResource SymbolThemeFontFamily}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource BrushTextTertiary}"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- Row 5: Quick Actions (Task, Note, Meeting - in that order) -->
        <Border Grid.Row="5" 
                Background="{DynamicResource BrushPrimarySubtle}" 
                CornerRadius="8" 
                Padding="12,10"
                BorderBrush="{DynamicResource BrushPrimarySoft}" 
                BorderThickness="1">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                <Button Command="{Binding AddTaskCommand}" 
                        Classes="action-button" 
                        ToolTip.Tip="Add a task">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" 
                                  Width="12" Height="12"/>
                        <TextBlock Text="Task" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding AddNoteCommand}" 
                        Classes="action-button" 
                        ToolTip.Tip="Capture a thought">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="M14,10H19.5L14,4.5V10M5,3H15L21,9V19A2,2 0 0,1 19,21H5A2,2 0 0,1 3,19V5A2,2 0 0,1 5,3M5,5V19H19V12H12V5H5Z" 
                                  Width="12" Height="12"/>
                        <TextBlock Text="Note" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding AddMeetingCommand}" 
                        Classes="action-button" 
                        ToolTip.Tip="Schedule a meeting">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="M19,19H5V8H19M16,1V3H8V1H6V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3H18V1" 
                                  Width="12" Height="12"/>
                        <TextBlock Text="Meeting" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
