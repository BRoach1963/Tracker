<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ProCohere.Avalonia.ViewModels"
             xmlns:local="using:ProCohere.Avalonia.Views.Briefing"
             xmlns:markup="using:ProCohere.Avalonia.Markup"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="ProCohere.Avalonia.Views.Briefing.BriefingView"
             x:DataType="vm:BriefingViewModel">
    
    <Design.DataContext>
        <vm:BriefingViewModel/>
    </Design.DataContext>

    <UserControl.Styles>
        <!-- Toggle button style for Today/Week selector -->
        <Style Selector="Button.toggle-button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.toggle-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceHover}"/>
        </Style>
        <Style Selector="Button.toggle-button.selected">
            <Setter Property="Background" Value="{DynamicResource BrushPrimary}"/>
        </Style>
        <Style Selector="Button.toggle-button.selected TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </UserControl.Styles>

    <!-- Main layout: Header + Role-Based Content -->
    <Grid RowDefinitions="Auto,*">
        
        <!-- Row 0: Shared Header (Welcome, Date, Scope Toggle, Refresh) -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- Welcome + Date -->
            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding WelcomeMessage}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushTextPrimary}"/>
                <TextBlock Text="{Binding DateRangeText}"
                           FontSize="12"
                           Foreground="{DynamicResource BrushTextSecondary}"/>
            </StackPanel>
            
            <!-- Today/Week toggle + Insights Badge + Refresh button -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <!-- Insights Badge (shows count of critical insights) -->
                <Border Background="#FEF3C7" 
                        BorderBrush="#FCD34D" 
                        BorderThickness="1"
                        CornerRadius="12" 
                        Padding="8,4"
                        VerticalAlignment="Center"
                        IsVisible="{Binding HasCriticalInsights}"
                        ToolTip.Tip="Critical insights require your attention. View in Pulse.">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="💡" FontSize="12"/>
                        <TextBlock Text="{Binding CriticalInsightCount}" 
                                   FontSize="12" 
                                   FontWeight="SemiBold"
                                   Foreground="#92400E"/>
                    </StackPanel>
                </Border>
                
                <!-- Scope Toggle -->
                <Border Background="{DynamicResource BrushSurface}" 
                        CornerRadius="6" 
                        BorderBrush="{DynamicResource BrushBorder}" 
                        BorderThickness="1"
                        Padding="2">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Classes="toggle-button" 
                                Classes.selected="{Binding IsTodayScope}"
                                Command="{Binding SetScopeCommand}"
                                CommandParameter="Today"
                                Padding="10,4">
                            <TextBlock Text="{markup:Localize Key=Briefing_Today}" FontSize="12"/>
                        </Button>
                        <Button Classes="toggle-button"
                                Classes.selected="{Binding IsWeekScope}"
                                Command="{Binding SetScopeCommand}"
                                CommandParameter="Week"
                                Padding="10,4">
                            <TextBlock Text="{markup:Localize Key=Briefing_Week}" FontSize="12"/>
                        </Button>
                    </StackPanel>
                </Border>
                
                <!-- Refresh Status Chip (Updating.../Updated) -->
                <Border Background="{DynamicResource BrushSurfaceSecondary}" 
                        CornerRadius="10" 
                        Padding="8,4"
                        VerticalAlignment="Center"
                        IsVisible="{Binding ShowRefreshStatus}">
                    <Border.Transitions>
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.25" Easing="CubicEaseOut"/>
                        </Transitions>
                    </Border.Transitions>
                    <TextBlock Text="{Binding RefreshStatusText}" 
                               FontSize="11" 
                               Foreground="{DynamicResource BrushTextSecondary}"/>
                </Border>
                
                <!-- Refresh button -->
                <Button Command="{Binding RefreshCommand}" Classes="icon-button" ToolTip.Tip="{markup:Localize Key=Briefing_Refresh}">
                    <PathIcon Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z" Width="18" Height="18"/>
                </Button>
            </StackPanel>
        </Grid>
        
        <!-- Row 1: Role-Based Content Area -->
        <Grid Grid.Row="1">
            <!-- Manager View: Shows when IsManager = true -->
            <local:ManagerBriefingContent IsVisible="{Binding IsManager}"
                                          DataContext="{Binding}"/>
            
            <!-- IC View: Shows when IsManager = false (IsIndividualContributor = true) -->
            <local:ICBriefingContent IsVisible="{Binding IsIndividualContributor}"
                                     DataContext="{Binding}"/>
            
            <!-- Loading State -->
            <Border IsVisible="{Binding IsLoading}" 
                    Background="{DynamicResource BrushSurface}" 
                    CornerRadius="8" 
                    Padding="24">
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="200"/>
                    <TextBlock Text="{markup:Localize Key=Briefing_LoadingBriefing}" 
                               Foreground="{DynamicResource BrushTextSecondary}" 
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            
            <!-- Error State -->
            <Border IsVisible="{Binding HasError}" 
                    Background="#FEF2F2" 
                    BorderBrush="#FECACA" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="16" 
                    VerticalAlignment="Top">
                <TextBlock Text="{Binding ErrorMessage}" 
                           Foreground="#DC2626" 
                           TextWrapping="Wrap"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
