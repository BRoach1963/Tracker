<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ProCohere.Avalonia.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="ProCohere.Avalonia.Views.TodayView"
             x:DataType="vm:TodayViewModel">
    
    <Design.DataContext>
        <vm:TodayViewModel/>
    </Design.DataContext>

    <UserControl.Styles>
        <!-- Toggle button style for Today/Week selector -->
        <Style Selector="Button.toggle-button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.toggle-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceHover}"/>
        </Style>
        <Style Selector="Button.toggle-button.selected">
            <Setter Property="Background" Value="{DynamicResource BrushPrimary}"/>
        </Style>
        <Style Selector="Button.toggle-button.selected TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </UserControl.Styles>

    <!-- Main grid layout - no scrolling needed -->
    <Grid RowDefinitions="Auto,Auto,Auto,*">
        
        <!-- Row 0: Header with welcome, date, refresh -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- Welcome + Date -->
            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding WelcomeMessage}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushTextPrimary}"/>
                <TextBlock Text="{Binding DateRangeText}"
                           FontSize="12"
                           Foreground="{DynamicResource BrushTextSecondary}"/>
            </StackPanel>
            
            <!-- Today/Week toggle + Refresh button -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <!-- Scope Toggle -->
                <Border Background="{DynamicResource BrushSurface}" 
                        CornerRadius="6" 
                        BorderBrush="{DynamicResource BrushBorder}" 
                        BorderThickness="1"
                        Padding="2">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Classes="toggle-button" 
                                Classes.selected="{Binding IsTodayScope}"
                                Command="{Binding SetScopeCommand}"
                                CommandParameter="Today"
                                Padding="10,4">
                            <TextBlock Text="Today" FontSize="12"/>
                        </Button>
                        <Button Classes="toggle-button"
                                Classes.selected="{Binding IsWeekScope}"
                                Command="{Binding SetScopeCommand}"
                                CommandParameter="Week"
                                Padding="10,4">
                            <TextBlock Text="Week" FontSize="12"/>
                        </Button>
                    </StackPanel>
                </Border>
                
                <!-- Refresh button -->
                <Button Command="{Binding RefreshCommand}" Classes="icon-button" ToolTip.Tip="Refresh">
                    <PathIcon Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z" Width="18" Height="18"/>
                </Button>
            </StackPanel>
        </Grid>
        
        <!-- Row 1: Compact Stat Cards -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" Margin="0,0,0,12" IsVisible="{Binding !IsLoading}">
            <Grid.Styles>
                <Style Selector="Border.stat-card-compact">
                    <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
                    <Setter Property="CornerRadius" Value="8"/>
                    <Setter Property="Padding" Value="12,10"/>
                    <Setter Property="Margin" Value="0,0,8,0"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                </Style>
            </Grid.Styles>
            
            <Border Grid.Column="0" Classes="stat-card-compact">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="{Binding TeamMemberCountText}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                    <TextBlock Text="team members" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            
            <Border Grid.Column="1" Classes="stat-card-compact">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="{Binding TaskCompletionText}" FontSize="28" FontWeight="Bold" Foreground="{Binding TaskCompletionColor}" VerticalAlignment="Center"/>
                    <TextBlock Text="tasks complete" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            
            <Border Grid.Column="2" Classes="stat-card-compact">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="{Binding GoalsOnTrackText}" FontSize="28" FontWeight="Bold" Foreground="{Binding GoalsOnTrackColor}" VerticalAlignment="Center"/>
                    <TextBlock Text="goals on track" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            
            <Border Grid.Column="3" Classes="stat-card-compact" Margin="0">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="{Binding ActiveProjectCountText}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                    <TextBlock Text="active projects" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
        
        <!-- Row 2: Quick Actions -->
        <Border Grid.Row="2" Background="{DynamicResource BrushSurface}" CornerRadius="8" Padding="12,10"
                Margin="0,0,0,12" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                IsVisible="{Binding !IsLoading}">
            <Grid ColumnDefinitions="Auto,*">
                <TextBlock Grid.Column="0" Text="Quick Actions" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"
                           Margin="0,0,16,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Command="{Binding AddTaskCommand}" Classes="action-button" ToolTip.Tip="Create a new task">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Width="12" Height="12"/>
                            <TextBlock Text="Task" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding AddGoalCommand}" Classes="action-button" ToolTip.Tip="Create a new goal">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="M5,21L7.5,13L1,9H8.5L11,1L13.5,9H21L14.5,13L17,21L11,16L5,21Z" Width="12" Height="12"/>
                            <TextBlock Text="Goal" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding AddMeetingCommand}" Classes="action-button" ToolTip.Tip="Schedule a meeting">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="M19,19H5V8H19M16,1V3H8V1H6V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3H18V1" Width="12" Height="12"/>
                            <TextBlock Text="Meeting" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding AddNoteCommand}" Classes="action-button" ToolTip.Tip="Write a note">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="M14,10H19.5L14,4.5V10M5,3H15L21,9V19A2,2 0 0,1 19,21H5A2,2 0 0,1 3,19V5A2,2 0 0,1 5,3M5,5V19H19V12H12V5H5Z" Width="12" Height="12"/>
                            <TextBlock Text="Note" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Row 3: Main 2x2 Grid -->
        <Grid Grid.Row="3" RowDefinitions="*,*" ColumnDefinitions="*,*" IsVisible="{Binding !IsLoading}">
            
            <!-- Top-Left: Team Overview -->
            <Border Grid.Row="0" Grid.Column="0" 
                    Background="{DynamicResource BrushSurface}" CornerRadius="10" Padding="14"
                    Margin="0,0,8,8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Text="Team" FontSize="14" FontWeight="SemiBold" 
                               Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,10"/>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding TeamMembers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,6" Margin="0,0,0,4" Background="{DynamicResource BrushBackground}" 
                                            CornerRadius="6" Cursor="Hand">
                                        <!-- Tooltip with team member details (1 second delay) -->
                                        <ToolTip.Tip>
                                            <Border Background="{DynamicResource BrushSurface}" 
                                                    CornerRadius="8" Padding="16" MinWidth="280"
                                                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                                                <StackPanel Spacing="12">
                                                    <!-- Header with avatar and name -->
                                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                                        <Border Width="44" Height="44" CornerRadius="22" ClipToBounds="True">
                                                            <Panel>
                                                                <!-- Initials fallback -->
                                                                <Border Background="{DynamicResource BrushPrimary}" CornerRadius="22"
                                                                        IsVisible="{Binding AvatarUrl, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                                                                    <TextBlock Text="{Binding Initials}" FontSize="14" FontWeight="SemiBold"
                                                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <!-- Avatar image when available -->
                                                                <Image Source="{Binding AvatarUrl}" Stretch="UniformToFill" Width="44" Height="44"
                                                                       IsVisible="{Binding AvatarUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                            </Panel>
                                                        </Border>
                                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                                            <TextBlock Text="{Binding FullName}" FontSize="14" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource BrushTextPrimary}"/>
                                                            <TextBlock Text="{Binding JobTitle}" FontSize="12" 
                                                                       Foreground="{DynamicResource BrushTextSecondary}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    
                                                    <!-- Divider -->
                                                    <Border Height="1" Background="{DynamicResource BrushBorder}" Margin="0,2"/>
                                                    
                                                    <!-- Info Grid -->
                                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="12">
                                                        <!-- Email -->
                                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Email" FontSize="11" 
                                                                   Foreground="{DynamicResource BrushTextTertiary}" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Email}" FontSize="11" 
                                                                   Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                                        
                                                        <!-- Birthday -->
                                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Birthday" FontSize="11" 
                                                                   Foreground="{DynamicResource BrushTextTertiary}" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding BirthdayDisplay}" FontSize="11" 
                                                                   Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                                        
                                                        <!-- Hire Date -->
                                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Hire Date" FontSize="11" 
                                                                   Foreground="{DynamicResource BrushTextTertiary}" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding HireDateDisplay}" FontSize="11" 
                                                                   Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                                    </Grid>
                                                    
                                                    <!-- Divider -->
                                                    <Border Height="1" Background="{DynamicResource BrushBorder}" Margin="0,2"/>
                                                    
                                                    <!-- Stats row - evenly spaced -->
                                                    <Grid ColumnDefinitions="*,*,*">
                                                        <StackPanel Grid.Column="0" HorizontalAlignment="Center" Spacing="2">
                                                            <TextBlock Text="{Binding OpenTaskCount}" FontSize="18" FontWeight="Bold"
                                                                       Foreground="{DynamicResource BrushPrimary}" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="Tasks" FontSize="10" 
                                                                       Foreground="{DynamicResource BrushTextTertiary}" HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="2">
                                                            <TextBlock Text="{Binding ActiveGoalCount}" FontSize="18" FontWeight="Bold"
                                                                       Foreground="{DynamicResource BrushPrimary}" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="Goals" FontSize="10" 
                                                                       Foreground="{DynamicResource BrushTextTertiary}" HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="2">
                                                            <TextBlock Text="{Binding LastMeetingText}" FontSize="14" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource BrushPrimary}" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="Last Meeting" FontSize="10" 
                                                                       Foreground="{DynamicResource BrushTextTertiary}" HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </ToolTip.Tip>
                                        <ToolTip.ShowDelay>1000</ToolTip.ShowDelay>
                                        
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" ClipToBounds="True" Margin="0,0,8,0">
                                                <Panel>
                                                    <!-- Initials fallback -->
                                                    <Border Background="{DynamicResource BrushPrimary}" CornerRadius="14"
                                                            IsVisible="{Binding AvatarUrl, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                                                        <TextBlock Text="{Binding Initials}" FontSize="10" FontWeight="Medium"
                                                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <!-- Avatar image -->
                                                    <Image Source="{Binding AvatarUrl}" Stretch="UniformToFill" Width="28" Height="28"
                                                           IsVisible="{Binding AvatarUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                </Panel>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FullName}" FontSize="12" FontWeight="Medium"
                                                           Foreground="{DynamicResource BrushTextPrimary}"/>
                                                <TextBlock Text="{Binding JobTitle}" FontSize="10" 
                                                           Foreground="{DynamicResource BrushTextTertiary}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                <TextBlock FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center">
                                                    <Run Text="{Binding OpenTaskCount}"/>
                                                    <Run Text="tasks"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding LastMeetingText}" FontSize="10" 
                                                           Foreground="{DynamicResource BrushTextTertiary}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
            
            <!-- Top-Right: Upcoming Tasks -->
            <Border Grid.Row="0" Grid.Column="1" 
                    Background="{DynamicResource BrushSurface}" CornerRadius="10" Padding="14"
                    Margin="0,0,0,8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Text="Upcoming Tasks" FontSize="14" FontWeight="SemiBold" 
                               Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,10"/>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding UpcomingTasks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,6" Margin="0,0,0,4" Background="{DynamicResource BrushBackground}" 
                                                CornerRadius="6" Cursor="Hand">
                                            <Grid ColumnDefinitions="Auto,*">
                                                <Border Grid.Column="0" Width="16" Height="16" CornerRadius="3" 
                                                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1.5" Margin="0,2,8,0" VerticalAlignment="Top"/>
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Medium"
                                                               Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="{Binding DueDateText}" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}"/>
                                                        <TextBlock Text="•" FontSize="10" Foreground="{DynamicResource BrushTextTertiary}"
                                                                   IsVisible="{Binding OwnerName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                        <TextBlock Text="{Binding OwnerName}" FontSize="10" Foreground="{DynamicResource BrushTextTertiary}"
                                                                   IsVisible="{Binding OwnerName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            
                            <!-- Empty state -->
                            <Border IsVisible="{Binding !UpcomingTasks.Count}" Padding="16" Background="{DynamicResource BrushBackground}" CornerRadius="6">
                                <TextBlock Text="No upcoming tasks" FontSize="12" Foreground="{DynamicResource BrushTextTertiary}" HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
            
            <!-- Bottom-Left: Focus Areas (Goals) -->
            <Border Grid.Row="1" Grid.Column="0" 
                    Background="{DynamicResource BrushSurface}" CornerRadius="10" Padding="14"
                    Margin="0,0,8,0" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Text="Focus Areas" FontSize="14" FontWeight="SemiBold" 
                               Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,10"/>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Goals}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,6" Margin="0,0,0,4" Background="{DynamicResource BrushBackground}" 
                                                CornerRadius="6" Cursor="Hand">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0" Spacing="2">
                                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Medium"
                                                               Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="{Binding StatusDisplay}" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}"/>
                                                        <TextBlock Text="•" FontSize="10" Foreground="{DynamicResource BrushTextTertiary}"
                                                                   IsVisible="{Binding OwnerName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                        <TextBlock Text="{Binding OwnerName}" FontSize="10" Foreground="{DynamicResource BrushTextTertiary}"
                                                                   IsVisible="{Binding OwnerName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Progress, StringFormat={}{0}%}" FontSize="12" FontWeight="Medium"
                                                           Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            
                            <!-- Empty state -->
                            <Border IsVisible="{Binding !Goals.Count}" Padding="16" Background="{DynamicResource BrushBackground}" CornerRadius="6">
                                <TextBlock Text="No active goals" FontSize="12" Foreground="{DynamicResource BrushTextTertiary}" HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
            
            <!-- Bottom-Right: Upcoming Meetings -->
            <Border Grid.Row="1" Grid.Column="1" 
                    Background="{DynamicResource BrushSurface}" CornerRadius="10" Padding="14"
                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Text="Upcoming Meetings" FontSize="14" FontWeight="SemiBold" 
                               Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,10"/>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding UpcomingMeetings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,6" Margin="0,0,0,4" Background="{DynamicResource BrushBackground}" 
                                                CornerRadius="6" Cursor="Hand">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Medium"
                                                           Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding ScheduledText}" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}"/>
                                                    <TextBlock Text="•" FontSize="10" Foreground="{DynamicResource BrushTextTertiary}"
                                                               IsVisible="{Binding TeamMemberName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                    <TextBlock Text="{Binding TeamMemberName}" FontSize="10" Foreground="{DynamicResource BrushTextTertiary}"
                                                               IsVisible="{Binding TeamMemberName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            
                            <!-- Empty state -->
                            <Border IsVisible="{Binding !UpcomingMeetings.Count}" Padding="16" Background="{DynamicResource BrushBackground}" CornerRadius="6">
                                <StackPanel Spacing="8" HorizontalAlignment="Center">
                                    <TextBlock Text="No upcoming meetings" FontSize="12" Foreground="{DynamicResource BrushTextTertiary}" HorizontalAlignment="Center"/>
                                    <Button Command="{Binding AddMeetingCommand}" Classes="text" Padding="6,2" HorizontalAlignment="Center">
                                        <TextBlock Text="Schedule one" FontSize="11" Foreground="{DynamicResource BrushPrimary}"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        
        <!-- Loading State -->
        <Border Grid.Row="3" IsVisible="{Binding IsLoading}" Background="{DynamicResource BrushSurface}" CornerRadius="8" Padding="24">
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200"/>
                <TextBlock Text="Loading dashboard..." Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
        
        <!-- Error State -->
        <Border Grid.Row="3" IsVisible="{Binding HasError}" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="16" VerticalAlignment="Top">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>
