<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:vm="using:ProCohere.Avalonia.ViewModels"
             xmlns:models="using:ProCohere.Avalonia.Models"
             xmlns:controls="using:ProCohere.Avalonia.Views.Controls"
             xmlns:markup="using:ProCohere.Avalonia.Markup"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="ProCohere.Avalonia.Views.ChronicleView"
             x:DataType="vm:ChronicleViewModel">
    
    <Design.DataContext>
        <vm:ChronicleViewModel/>
    </Design.DataContext>

    <UserControl.Styles>
        <!-- Tab Button Style (consistent with PulseView/CircleView) -->
        <Style Selector="Button.tab-button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style Selector="Button.tab-button /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.tab-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        </Style>
        <Style Selector="Button.tab-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}"/>
        </Style>
        <Style Selector="Button.tab-button.selected">
            <Setter Property="Foreground" Value="{DynamicResource BrushPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.tab-button.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        
        <!-- Section header style -->
        <Style Selector="TextBlock.section-header">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
            <Setter Property="Margin" Value="0,16,0,12"/>
        </Style>
        
        <!-- Search TextBox style -->
        <Style Selector="TextBox.search-box">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="TextBox.search-box:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}"/>
        </Style>
        
        <!-- Stat card style -->
        <Style Selector="Border.stat-card">
            <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinWidth" Value="100"/>
        </Style>
        
        <!-- Detail flyout panel style -->
        <Style Selector="Border.detail-panel">
            <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RenderTransform" Value="translate(320px, 0)"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="CubicEaseOut"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.detail-panel.open">
            <Setter Property="RenderTransform" Value="translate(0, 0)"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        
        <!-- Category filter chip style -->
        <Style Selector="ToggleButton.category-filter">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style Selector="ToggleButton.category-filter:checked">
            <Setter Property="Background" Value="{DynamicResource BrushPrimarySoft}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="ToggleButton.category-filter:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceHover}"/>
        </Style>
        <Style Selector="ToggleButton.category-filter:checked:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushPrimarySoft}"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,*">
        
        <!-- Row 0: Header with title, stats, and actions -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- Title and subtitle -->
            <TextBlock Grid.Column="0" 
                       Text="{markup:Localize Key=Chronicle_Subtitle}"
                       FontSize="13" 
                       Foreground="{DynamicResource BrushTextSecondary}"
                       VerticalAlignment="Center"/>
            
            <!-- Stats -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="0,0,16,0">
                <Border Classes="stat-card">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{Binding TotalCountText}" 
                                   FontSize="20" FontWeight="Bold" 
                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                        <TextBlock Text="{markup:Localize Key=Chronicle_TotalNotes}" FontSize="11" 
                                   Foreground="{DynamicResource BrushTextTertiary}"/>
                    </StackPanel>
                </Border>
                <Border Classes="stat-card">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{Binding PinnedCountText}" 
                                   FontSize="20" FontWeight="Bold" 
                                   Foreground="{DynamicResource BrushHighlight}"/>
                        <TextBlock Text="{markup:Localize Key=Chronicle_Pinned}" FontSize="11" 
                                   Foreground="{DynamicResource BrushTextTertiary}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            
            <!-- New Note button -->
            <Button Grid.Column="2" 
                    Command="{Binding CreateNewNoteCommand}"
                    Background="{DynamicResource BrushPrimary}"
                    Foreground="{DynamicResource BrushTextOnPrimary}"
                    Padding="16,10"
                    CornerRadius="8"
                    Cursor="Hand">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" 
                              Width="16" Height="16"
                              Foreground="{DynamicResource BrushTextOnPrimary}"/>
                    <TextBlock Text="{markup:Localize Key=Chronicle_NewNote}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
        
        <!-- Row 1: Search bar and tab bar -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Search box -->
            <TextBox Grid.Column="0" 
                     Classes="search-box"
                     Text="{Binding SearchQuery, Mode=TwoWay}"
                     Watermark="{markup:Localize Key=Chronicle_SearchNotesPlaceholder}"
                     KeyDown="OnSearchKeyDown">
                <TextBox.InnerLeftContent>
                    <PathIcon Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                              Width="16" Height="16" Margin="8,0,4,0"
                              Foreground="{DynamicResource BrushTextTertiary}"/>
                </TextBox.InnerLeftContent>
            </TextBox>
            
            <!-- Sub-tab bar -->
            <Border Grid.Column="1" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1" Margin="24,0,0,0">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Classes="tab-button"
                            Classes.selected="{Binding IsNotesTabSelected}"
                            Command="{Binding SelectSubTabCommand}">
                        <Button.CommandParameter>
                            <sys:Int32>0</sys:Int32>
                        </Button.CommandParameter>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z" 
                                      Width="16" Height="16"/>
                            <TextBlock Text="{markup:Localize Key=Chronicle_TabNotes}"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Classes="tab-button"
                            Classes.selected="{Binding IsReportsTabSelected}"
                            Command="{Binding SelectSubTabCommand}"
                            IsEnabled="False"
                            ToolTip.Tip="{markup:Localize Key=Chronicle_ReportsComingSoon}">
                        <Button.CommandParameter>
                            <sys:Int32>1</sys:Int32>
                        </Button.CommandParameter>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="M16,11.78L20.24,4.45L21.97,5.45L16.74,14.5L10.23,10.75L5.46,19H22V21H2V3H4V17.54L9.5,8L16,11.78Z" 
                                      Width="16" Height="16"/>
                            <TextBlock Text="{markup:Localize Key=Chronicle_TabReports}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
        
        <!-- Row 2: Category filter pills -->
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <ToggleButton Classes="category-filter"
                              IsChecked="{Binding IsCategoryFilterAll}"
                              Command="{Binding FilterByCategoryCommand}"
                              CommandParameter="">
                    <TextBlock Text="{markup:Localize Key=Chronicle_FilterAll}"/>
                </ToggleButton>
                <ToggleButton Classes="category-filter"
                              IsChecked="{Binding IsCategoryFilterMeetingNotes}"
                              Command="{Binding FilterByCategoryCommand}"
                              CommandParameter="Meeting Notes">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="8" Height="8" Fill="#2196F3"/>
                        <TextBlock Text="{markup:Localize Key=Chronicle_FilterMeetingNotes}"/>
                    </StackPanel>
                </ToggleButton>
                <ToggleButton Classes="category-filter"
                              IsChecked="{Binding IsCategoryFilterIdeas}"
                              Command="{Binding FilterByCategoryCommand}"
                              CommandParameter="Ideas">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="8" Height="8" Fill="#9C27B0"/>
                        <TextBlock Text="{markup:Localize Key=Chronicle_FilterIdeas}"/>
                    </StackPanel>
                </ToggleButton>
                <ToggleButton Classes="category-filter"
                              IsChecked="{Binding IsCategoryFilterActionItems}"
                              Command="{Binding FilterByCategoryCommand}"
                              CommandParameter="Action Items">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="8" Height="8" Fill="#F44336"/>
                        <TextBlock Text="{markup:Localize Key=Chronicle_FilterActionItems}"/>
                    </StackPanel>
                </ToggleButton>
                <ToggleButton Classes="category-filter"
                              IsChecked="{Binding IsCategoryFilterResearch}"
                              Command="{Binding FilterByCategoryCommand}"
                              CommandParameter="Research">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="8" Height="8" Fill="#4CAF50"/>
                        <TextBlock Text="{markup:Localize Key=Chronicle_FilterResearch}"/>
                    </StackPanel>
                </ToggleButton>
                <ToggleButton Classes="category-filter"
                              IsChecked="{Binding IsCategoryFilterPersonal}"
                              Command="{Binding FilterByCategoryCommand}"
                              CommandParameter="Personal">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="8" Height="8" Fill="#FF9800"/>
                        <TextBlock Text="{markup:Localize Key=Chronicle_FilterPersonal}"/>
                    </StackPanel>
                </ToggleButton>
                <ToggleButton Classes="category-filter"
                              IsChecked="{Binding IsCategoryFilterFollowUp}"
                              Command="{Binding FilterByCategoryCommand}"
                              CommandParameter="Follow-up">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="8" Height="8" Fill="#E91E63"/>
                        <TextBlock Text="{markup:Localize Key=Chronicle_FilterFollowUp}"/>
                    </StackPanel>
                </ToggleButton>
            </StackPanel>
        </ScrollViewer>
        
        <!-- Row 3: Content area with card grid + detail panel -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- Main content: Card grid -->
            <Grid Grid.Column="0">
                
                <!-- Loading state with skeleton cards -->
                <WrapPanel IsVisible="{Binding IsLoading}" 
                           Orientation="Horizontal"
                           Margin="0,16,0,0">
                    <controls:SkeletonNoteCard/>
                    <controls:SkeletonNoteCard/>
                    <controls:SkeletonNoteCard/>
                    <controls:SkeletonNoteCard/>
                    <controls:SkeletonNoteCard/>
                    <controls:SkeletonNoteCard/>
                </WrapPanel>
                
                <!-- Error state -->
                <StackPanel IsVisible="{Binding HasError}" 
                            VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                    <PathIcon Data="M13,13H11V7H13M13,17H11V15H13M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z" 
                              Width="48" Height="48" 
                              Foreground="{DynamicResource BrushError}"/>
                    <TextBlock Text="{Binding ErrorMessage}" 
                               Foreground="{DynamicResource BrushError}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="400"/>
                    <Button Content="{markup:Localize Key=Chronicle_TryAgain}" 
                            Command="{Binding LoadNotesCommand}"
                            HorizontalAlignment="Center"
                            Padding="16,8"
                            Margin="0,8,0,0"/>
                </StackPanel>
                
                <!-- Notes content (when loaded) -->
                <ScrollViewer x:Name="NotesScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    
                    <StackPanel Margin="0,0,16,0">
                        
                        <!-- Pinned Notes Section -->
                        <StackPanel IsVisible="{Binding PinnedNotes.Count}">
                            <StackPanel Classes="section-header" Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="M16,12V4H17V2H7V4H8V12L6,14V16H11.2V22H12.8V16H18V14L16,12Z" 
                                          Width="14" Height="14" Foreground="{DynamicResource BrushTextSecondary}"/>
                                <TextBlock Text="{markup:Localize Key=Chronicle_Pinned}" VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <ItemsControl ItemsSource="{Binding PinnedNotes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="models:Note">
                                        <controls:NoteCard ShowPinIndicator="True" 
                                                          CardClicked="OnNoteCardClicked"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        
                        <!-- All Notes Section -->
                        <StackPanel>
                            <TextBlock Classes="section-header" Text="{markup:Localize Key=Chronicle_AllNotes}"
                                       IsVisible="{Binding Notes.Count}"/>
                            
                            <ItemsControl ItemsSource="{Binding Notes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="models:Note">
                                        <controls:NoteCard ShowPinIndicator="False" 
                                                          CardClicked="OnNoteCardClicked"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        
                        <!-- Empty state when no notes exist -->
                        <StackPanel x:Name="EmptyState"
                                    VerticalAlignment="Center" 
                                    HorizontalAlignment="Center" 
                                    Spacing="20"
                                    Margin="0,80,0,0">
                            <!-- Illustration circle with icon -->
                            <Border Background="{DynamicResource BrushPrimarySoft}"
                                    CornerRadius="60"
                                    Width="120" Height="120"
                                    HorizontalAlignment="Center"
                                    Opacity="0.8">
                                <PathIcon Data="M19,1L14,6V17L19,12.5V1M21,5V18.5C19.9,18.15 18.7,18 17.5,18C15.8,18 13.35,18.65 12,19.5V6C10.55,4.9 8.45,4.5 6.5,4.5C4.55,4.5 2.45,4.9 1,6V20.65C1,20.9 1.25,21.15 1.5,21.15C1.6,21.15 1.65,21.1 1.75,21.1C3.1,20.45 5.05,20 6.5,20C8.45,20 10.55,20.4 12,21.5C13.35,20.65 15.8,20 17.5,20C19.15,20 20.85,20.3 22.25,21.05C22.35,21.1 22.4,21.1 22.5,21.1C22.75,21.1 23,20.85 23,20.6V6C22.4,5.55 21.75,5.25 21,5Z" 
                                          Width="48" Height="48" 
                                          Foreground="{DynamicResource BrushPrimary}"/>
                            </Border>
                            
                            <!-- Title and description -->
                            <StackPanel Spacing="8" HorizontalAlignment="Center">
                                <TextBlock Text="{markup:Localize Key=Chronicle_EmptyStateTitle}"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushTextPrimary}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{markup:Localize Key=Chronicle_EmptyStateDescription}"
                                           FontSize="14"
                                           Foreground="{DynamicResource BrushTextSecondary}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           LineHeight="22"/>
                            </StackPanel>
                            
                            <!-- CTA Button -->
                            <Button Command="{Binding CreateNewNoteCommand}"
                                    Background="{DynamicResource BrushPrimary}"
                                    Foreground="{DynamicResource BrushTextOnPrimary}"
                                    Padding="24,14"
                                    CornerRadius="10"
                                    HorizontalAlignment="Center"
                                    Cursor="Hand"
                                    FontWeight="Medium">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" 
                                              Width="18" Height="18"
                                              Foreground="{DynamicResource BrushTextOnPrimary}"/>
                                    <TextBlock Text="{markup:Localize Key=Chronicle_CreateFirstNote}" 
                                               VerticalAlignment="Center"
                                               FontSize="14"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            
            <!-- Detail flyout panel (right side) - shown when viewing a note -->
            <controls:EntityDetailFlyout Grid.Column="1"
                                         Width="320"
                                         Margin="16,0,0,0"
                                         FlyoutContent="{Binding SelectedNote}"
                                         IsOpen="{Binding IsNoteDetailOpen}"/>
            
            <!-- Editor flyout panel (right side) - shown when creating/editing a note -->
            <Border Grid.Column="1" 
                    Classes="detail-panel"
                    Classes.open="{Binding IsNoteEditorOpen}"
                    Width="400"
                    Margin="16,0,0,0"
                    IsVisible="{Binding IsNoteEditorOpen}">
                <controls:NoteEditorFlyout DataContext="{Binding}"/>
            </Border>
            
        </Grid>
        
    </Grid>
</UserControl>
