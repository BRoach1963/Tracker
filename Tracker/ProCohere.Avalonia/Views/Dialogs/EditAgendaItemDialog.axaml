<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ProCohere.Avalonia.ViewModels.Dialogs"
        xmlns:models="clr-namespace:ProCohere.Avalonia.Models"
        xmlns:markup="clr-namespace:ProCohere.Avalonia.Markup"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="700"
        x:Class="ProCohere.Avalonia.Views.Dialogs.EditAgendaItemDialog"
        x:DataType="vm:EditAgendaItemDialogViewModel"
        Title="{markup:Localize Key=Dialog_EditAgenda_Title}"
        Width="500" Height="700"
        MinWidth="400" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        ShowInTaskbar="False"
        SystemDecorations="BorderOnly"
        Background="Transparent">
    
    <Border Background="{DynamicResource BrushSurface}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1"
            CornerRadius="8"
            ClipToBounds="True">
        <Grid RowDefinitions="Auto,*,Auto">
            
            <!-- Header (green with icon) -->
            <Border Grid.Row="0" Background="{DynamicResource BrushPrimary}" Padding="20,16">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <!-- Agenda icon -->
                    <Border Width="36" Height="36" CornerRadius="8" 
                            Background="{DynamicResource BrushPrimaryPressed}" 
                            VerticalAlignment="Center">
                        <PathIcon Data="M3,5H9V11H3V5M5,7V9H7V7H5M11,7H21V9H11V7M11,15H21V17H11V15M5,20L1.5,16.5L2.91,15.09L5,17.17L9.59,12.59L11,14L5,20Z" 
                                  Width="18" Height="18" Foreground="White"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{markup:Localize Key=Dialog_EditAgenda_Title}" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="{markup:Localize Key=Dialog_EditAgenda_Subtitle}" FontSize="12" Foreground="#FFFFFFCC"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        
        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel Spacing="16">
                
                <!-- Title -->
                <StackPanel Spacing="4">
                    <TextBlock Text="{markup:Localize Key=Dialog_EditAgenda_TitleLabel}" FontSize="11" FontWeight="SemiBold" 
                               Foreground="{DynamicResource BrushTextSecondary}"/>
                    <TextBox x:Name="TitleTextBox" Text="{Binding Title}" Watermark="{markup:Localize Key=Dialog_EditAgenda_TitleWatermark}"/>
                </StackPanel>
                
                <!-- Display Title (optional) -->
                <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{markup:Localize Key=Dialog_EditAgenda_DisplayTitle}" FontSize="11" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource BrushTextSecondary}"/>
                        <TextBlock Grid.Column="1" Text="{markup:Localize Key=Dialog_EditAgenda_Optional}" FontSize="10" 
                                   Foreground="{DynamicResource BrushTextTertiary}" FontStyle="Italic"/>
                    </Grid>
                    <TextBox x:Name="DisplayTitleTextBox" Text="{Binding DisplayTitle}"
                             Watermark="{markup:Localize Key=Dialog_EditAgenda_DisplayTitleWatermark}"/>
                    <TextBlock Text="{markup:Localize Key=Dialog_EditAgenda_DisplayTitleHint}" 
                               FontSize="11" Foreground="{DynamicResource BrushTextTertiary}" TextWrapping="Wrap"/>
                </StackPanel>
                
                <!-- Visibility -->
                <StackPanel Spacing="4">
                    <TextBlock Text="{markup:Localize Key=Dialog_EditAgenda_Visibility}" FontSize="11" FontWeight="SemiBold" 
                               Foreground="{DynamicResource BrushTextSecondary}"/>
                    <ComboBox x:Name="VisibilityComboBox" HorizontalAlignment="Stretch"
                              SelectedIndex="{Binding VisibilityIndex}">
                        <ComboBoxItem Tag="meeting">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z" 
                                          Width="14" Height="14"/>
                                <TextBlock Text="{markup:Localize Key=Dialog_EditAgenda_VisibilityShared}"/>
                            </StackPanel>
                        </ComboBoxItem>
                        <ComboBoxItem Tag="personal">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="M12,17A2,2 0 0,0 14,15C14,13.89 13.1,13 12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10C4,8.89 4.9,8 6,8H7V6A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18M12,3A3,3 0 0,0 9,6V8H15V6A3,3 0 0,0 12,3Z" 
                                          Width="14" Height="14"/>
                                <TextBlock Text="{markup:Localize Key=Dialog_EditAgenda_VisibilityPersonal}"/>
                            </StackPanel>
                        </ComboBoxItem>
                    </ComboBox>
                </StackPanel>
                
                <!-- Link to Entity (per GOALS_SPEC) -->
                <StackPanel Spacing="4">
                    <TextBlock Text="{markup:Localize Key=Dialog_EditAgenda_LinkTo}" FontSize="11" FontWeight="SemiBold" 
                               Foreground="{DynamicResource BrushTextSecondary}"/>
                    
                    <!-- Currently linked entity (if any) -->
                    <Border IsVisible="{Binding HasLinkedEntity}"
                            Background="{DynamicResource BrushSurfaceAlt}"
                            CornerRadius="4" Padding="10,8">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <PathIcon Grid.Column="0" Width="14" Height="14" Margin="0,0,8,0"
                                      Data="{Binding LinkedEntityIcon}"
                                      Foreground="{DynamicResource BrushPrimary}"/>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{Binding LinkedEntityTypeDisplay}" FontSize="10" 
                                           Foreground="{DynamicResource BrushTextTertiary}"/>
                                <TextBlock Text="{Binding LinkedEntityTitle}" FontSize="12" FontWeight="Medium"
                                           Foreground="{DynamicResource BrushTextPrimary}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button Grid.Column="2" Classes="icon-button" ToolTip.Tip="{markup:Localize Key=Dialog_EditAgenda_RemoveLink}"
                                    Command="{Binding ClearLinkedEntityCommand}">
                                <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                          Width="10" Height="10" Foreground="{DynamicResource BrushTextTertiary}"/>
                            </Button>
                        </Grid>
                    </Border>
                    
                    <!-- Link button (show when no entity linked) -->
                    <Button IsVisible="{Binding !HasLinkedEntity}"
                            Classes="secondary-button" HorizontalAlignment="Left"
                            Command="{Binding ShowEntityPickerCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="M3.9,12C3.9,10.29 5.29,8.9 7,8.9H11V7H7A5,5 0 0,0 2,12A5,5 0 0,0 7,17H11V15.1H7C5.29,15.1 3.9,13.71 3.9,12M8,13H16V11H8V13M17,7H13V8.9H17C18.71,8.9 20.1,10.29 20.1,12C20.1,13.71 18.71,15.1 17,15.1H13V17H17A5,5 0 0,0 22,12A5,5 0 0,0 17,7Z" 
                                      Width="12" Height="12"/>
                            <TextBlock Text="{markup:Localize Key=Dialog_EditAgenda_LinkToGoalMetricTask}" FontSize="11"/>
                        </StackPanel>
                    </Button>
                    
                    <!-- Entity Picker Panel -->
                    <Border IsVisible="{Binding IsEntityPickerVisible}"
                            Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,4,0,0">
                        <StackPanel Spacing="8">
                            <TabControl x:Name="EntityTypeTab" SelectedIndex="{Binding EntityTypeTabIndex}"
                                        Padding="0" Margin="0">
                                <!-- Goals Tab -->
                                <TabItem Header="{markup:Localize Key=Dialog_EditAgenda_Goals}">
                                    <Border MaxHeight="150">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding AvailableGoals}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:GoalDetail">
                                                        <Button Classes="list-item-button" HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Left" Margin="0,0,0,2"
                                                                Command="{Binding $parent[ItemsControl].((vm:EditAgendaItemDialogViewModel)DataContext).SelectGoalCommand}"
                                                                CommandParameter="{Binding}">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <PathIcon Data="M5,16L3,5L8.5,10L12,4L15.5,10L21,5L19,16H5M19,19C19,19.55 18.55,20 18,20H6C5.45,20 5,19.55 5,19V18H19V19Z"
                                                                          Width="12" Height="12" Foreground="{DynamicResource BrushPrimary}"/>
                                                                <TextBlock Text="{Binding Title}" FontSize="12"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </TabItem>
                                <!-- Metrics Tab -->
                                <TabItem Header="{markup:Localize Key=Dialog_EditAgenda_Metrics}">
                                    <Border MaxHeight="150">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding AvailableMetrics}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:MetricDetail">
                                                        <Button Classes="list-item-button" HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Left" Margin="0,0,0,2"
                                                                Command="{Binding $parent[ItemsControl].((vm:EditAgendaItemDialogViewModel)DataContext).SelectMetricCommand}"
                                                                CommandParameter="{Binding}">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <PathIcon Data="M22,21H2V3H4V19H6V10H10V19H12V6H16V19H18V14H22V21Z"
                                                                          Width="12" Height="12" Foreground="#9B59B6"/>
                                                                <TextBlock Text="{Binding Name}" FontSize="12"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </TabItem>
                                <!-- Tasks Tab -->
                                <TabItem Header="{markup:Localize Key=Dialog_EditAgenda_Tasks}">
                                    <Border MaxHeight="150">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding AvailableTasks}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:TaskDetail">
                                                        <Button Classes="list-item-button" HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Left" Margin="0,0,0,2"
                                                                Command="{Binding $parent[ItemsControl].((vm:EditAgendaItemDialogViewModel)DataContext).SelectTaskCommand}"
                                                                CommandParameter="{Binding}">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <PathIcon Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"
                                                                          Width="12" Height="12" Foreground="#3498DB"/>
                                                                <TextBlock Text="{Binding Title}" FontSize="12"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </TabItem>
                            </TabControl>
                            
                            <!-- Loading indicator -->
                            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsLoadingEntities}"
                                        HorizontalAlignment="Center" Margin="0,8,0,0">
                                <ProgressBar IsIndeterminate="True" Width="60" Height="4"/>
                                <TextBlock Text="{markup:Localize Key=Dialog_EditAgenda_Loading}" FontSize="11" Foreground="{DynamicResource BrushTextTertiary}"/>
                            </StackPanel>
                            
                            <!-- Cancel button -->
                            <Button Content="{markup:Localize Key=Button_Cancel}" Classes="cancel-btn" HorizontalAlignment="Right"
                                    Command="{Binding HideEntityPickerCommand}"/>
                        </StackPanel>
                    </Border>
                    
                    <TextBlock Text="{markup:Localize Key=Dialog_EditAgenda_LinkHint}" FontSize="11" 
                               Foreground="{DynamicResource BrushTextTertiary}" TextWrapping="Wrap"/>
                </StackPanel>
                
                <!-- Shared Context -->
                <StackPanel Spacing="4">
                    <TextBlock Text="{markup:Localize Key=Dialog_EditAgenda_SharedContext}" FontSize="11" FontWeight="SemiBold" 
                               Foreground="{DynamicResource BrushTextSecondary}"/>
                    <TextBox x:Name="SharedContextTextBox" Text="{Binding SharedContext}"
                             Watermark="{markup:Localize Key=Dialog_EditAgenda_SharedContextWatermark}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="60" MaxHeight="120"/>
                    <TextBlock Text="{markup:Localize Key=Dialog_EditAgenda_SharedContextHint}" FontSize="11" 
                               Foreground="{DynamicResource BrushTextTertiary}"/>
                </StackPanel>
                
                <!-- Private Context -->
                <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="Auto,*">
                        <PathIcon Data="M12,17A2,2 0 0,0 14,15C14,13.89 13.1,13 12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10C4,8.89 4.9,8 6,8H7V6A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18M12,3A3,3 0 0,0 9,6V8H15V6A3,3 0 0,0 12,3Z" 
                                  Width="12" Height="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,6,0"/>
                        <TextBlock Grid.Column="1" Text="{markup:Localize Key=Dialog_EditAgenda_PrivateNotes}" FontSize="11" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource BrushTextSecondary}"/>
                    </Grid>
                    <TextBox x:Name="PrivateContextTextBox" Text="{Binding PrivateContext}"
                             Watermark="{markup:Localize Key=Dialog_EditAgenda_PrivateNotesWatermark}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="60" MaxHeight="120"/>
                    <TextBlock Text="{markup:Localize Key=Dialog_EditAgenda_PrivateNotesHint}" FontSize="11" 
                               Foreground="{DynamicResource BrushTextTertiary}"/>
                </StackPanel>
                
                <!-- Talking Points -->
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{markup:Localize Key=Dialog_EditAgenda_TalkingPoints}" FontSize="11" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource BrushTextSecondary}"/>
                        <Button x:Name="AddTalkingPointButton" Grid.Column="1" 
                                Classes="icon-button" Padding="4"
                                ToolTip.Tip="{markup:Localize Key=Dialog_EditAgenda_AddTalkingPoint}"
                                Command="{Binding ShowAddPanelCommand}">
                            <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Width="12" Height="12"/>
                        </Button>
                    </Grid>
                    
                    <!-- Add talking point inline -->
                    <Border x:Name="AddTalkingPointPanel" IsVisible="{Binding IsAddPanelVisible}"
                            Background="{DynamicResource BrushSurfaceAlt}"
                            CornerRadius="4" Padding="8">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBox x:Name="NewTalkingPointTextBox" Grid.Column="0"
                                     Text="{Binding NewTalkingPointText}"
                                     Watermark="{markup:Localize Key=Dialog_EditAgenda_TalkingPointWatermark}"
                                     KeyDown="NewTalkingPointTextBox_KeyDown"/>
                            <Button Grid.Column="1" Content="{markup:Localize Key=Dialog_EditAgenda_Add}" Classes="accent" Margin="8,0,0,0"
                                    Command="{Binding ConfirmAddCommand}"/>
                            <Button Grid.Column="2" Content="{markup:Localize Key=Button_Cancel}" Classes="cancel-btn" Margin="4,0,0,0"
                                    Command="{Binding CancelAddCommand}"/>
                        </Grid>
                    </Border>
                    
                    <!-- Talking points list (scrollable within dialog) -->
                    <Border MaxHeight="200">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="TalkingPointsControl" ItemsSource="{Binding TalkingPoints}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:TalkingPoint">
                                        <Border Background="{DynamicResource BrushSurface}"
                                                BorderBrush="{DynamicResource BrushBorder}"
                                                BorderThickness="1" CornerRadius="4" 
                                                Padding="8" Margin="0,0,0,4">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <PathIcon Grid.Column="0" 
                                                          Data="M9,22A1,1 0 0,1 8,21V18H4A2,2 0 0,1 2,16V4C2,2.89 2.9,2 4,2H20A2,2 0 0,1 22,4V16A2,2 0 0,1 20,18H13.9L10.2,21.71C10,21.9 9.75,22 9.5,22V22H9Z"
                                                          Width="12" Height="12" 
                                                          Foreground="{DynamicResource BrushTextTertiary}"
                                                          Margin="0,0,8,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Text}" 
                                                           FontSize="12" VerticalAlignment="Center"
                                                           TextWrapping="Wrap"/>
                                                <!-- More menu for Edit/Delete -->
                                                <Button Grid.Column="2" Classes="icon-button" Padding="4"
                                                        ToolTip.Tip="{markup:Localize Key=Dialog_EditAgenda_Options}">
                                                    <Button.Flyout>
                                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                            <MenuItem Header="{markup:Localize Key=Dialog_EditAgenda_Edit}" 
                                                                      Command="{Binding $parent[ItemsControl].((vm:EditAgendaItemDialogViewModel)DataContext).EditTalkingPointCommand}"
                                                                      CommandParameter="{Binding}">
                                                                <MenuItem.Icon>
                                                                    <PathIcon Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z" Width="12" Height="12"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="{markup:Localize Key=Dialog_EditAgenda_Delete}"
                                                                      Command="{Binding $parent[ItemsControl].((vm:EditAgendaItemDialogViewModel)DataContext).RemoveTalkingPointCommand}"
                                                                      CommandParameter="{Binding}">
                                                                <MenuItem.Icon>
                                                                    <PathIcon Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z" Width="12" Height="12"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                        </MenuFlyout>
                                                    </Button.Flyout>
                                                    <PathIcon Data="M12,16A2,2 0 0,1 14,18A2,2 0 0,1 12,20A2,2 0 0,1 10,18A2,2 0 0,1 12,16M12,10A2,2 0 0,1 14,12A2,2 0 0,1 12,14A2,2 0 0,1 10,12A2,2 0 0,1 12,10M12,4A2,2 0 0,1 14,6A2,2 0 0,1 12,8A2,2 0 0,1 10,6A2,2 0 0,1 12,4Z" 
                                                              Width="12" Height="12" 
                                                              Foreground="{DynamicResource BrushTextTertiary}"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                    
                    <!-- Empty state for talking points -->
                    <Border x:Name="TalkingPointsEmptyState"
                            Background="{DynamicResource BrushSurfaceAlt}"
                            CornerRadius="4" Padding="16" IsVisible="{Binding !HasTalkingPoints}">
                        <TextBlock Text="{markup:Localize Key=Dialog_EditAgenda_NoTalkingPoints}"
                                   FontSize="11" Foreground="{DynamicResource BrushTextTertiary}"
                                   TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>
                
            </StackPanel>
            </ScrollViewer>
            
            <!-- Footer (blue) -->
            <Border Grid.Row="2" Background="{DynamicResource BrushSecondary}" 
                    Padding="20,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Content="{markup:Localize Key=Button_Cancel}" 
                            Classes="cancel-btn"
                            Command="{Binding CancelCommand}"/>
                    <Button Content="{markup:Localize Key=Dialog_EditAgenda_SaveChanges}" 
                            Classes="accent"
                            Command="{Binding SaveCommand}"/>
                </StackPanel>
            </Border>
            
        </Grid>
    </Border>
</Window>
