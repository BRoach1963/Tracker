<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ProCohere.Avalonia.ViewModels.Dialogs"
        xmlns:models="using:ProCohere.Avalonia.Models.Dialogs"
        xmlns:markup="clr-namespace:ProCohere.Avalonia.Markup"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="550"
        x:Class="ProCohere.Avalonia.Views.Dialogs.EntityPickerDialog"
        x:DataType="vm:EntityPickerDialogViewModel"
        Title="Link to Existing Item"
        Width="520" Height="580"
        MinWidth="400" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        ShowInTaskbar="False"
        SystemDecorations="BorderOnly"
        Background="Transparent">

    <Window.Styles>
        <!-- Filter Tab Button Style -->
        <Style Selector="Border.filter-tab">
            <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Border.filter-tab:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushHighlight}"/>
        </Style>
        <Style Selector="Border.filter-tab.selected">
            <Setter Property="Background" Value="{DynamicResource BrushPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}"/>
        </Style>
        <Style Selector="Border.filter-tab.selected TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        
        <!-- Result Item Style -->
        <Style Selector="Border.result-item">
            <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Border.result-item:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushHighlight}"/>
        </Style>
        <Style Selector="ListBoxItem:selected Border.result-item">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}"/>
        </Style>
    </Window.Styles>
    
    <Border Background="{DynamicResource BrushSurface}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1"
            CornerRadius="8"
            ClipToBounds="True">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
        
            <!-- Header (green with icon) -->
            <Border Grid.Row="0" Background="{DynamicResource BrushPrimary}" Padding="20,16">
                <Grid ColumnDefinitions="Auto,*">
                    <!-- Link icon -->
                    <Border Width="36" Height="36" CornerRadius="8" 
                            Background="{DynamicResource BrushPrimaryPressed}" 
                            Margin="0,0,12,0" VerticalAlignment="Center">
                        <PathIcon Data="M10.59,13.41C11,13.8 11,14.44 10.59,14.83C10.2,15.22 9.56,15.22 9.17,14.83C7.22,12.88 7.22,9.71 9.17,7.76V7.76L12.71,4.22C14.66,2.27 17.83,2.27 19.78,4.22C21.73,6.17 21.73,9.34 19.78,11.29L18.29,12.78C18.3,11.96 18.17,11.14 17.89,10.36L18.36,9.88C19.54,8.71 19.54,6.81 18.36,5.64C17.19,4.46 15.29,4.46 14.12,5.64L10.59,9.17C9.41,10.34 9.41,12.24 10.59,13.41M13.41,9.17C13.8,8.78 14.44,8.78 14.83,9.17C16.78,11.12 16.78,14.29 14.83,16.24V16.24L11.29,19.78C9.34,21.73 6.17,21.73 4.22,19.78C2.27,17.83 2.27,14.66 4.22,12.71L5.71,11.22C5.7,12.04 5.83,12.86 6.11,13.65L5.64,14.12C4.46,15.29 4.46,17.19 5.64,18.36C6.81,19.54 8.71,19.54 9.88,18.36L13.41,14.83C14.59,13.66 14.59,11.76 13.41,10.59C13,10.2 13,9.56 13.41,9.17Z" 
                                  Width="18" Height="18" Foreground="White"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{markup:Localize Key=Dialog_EntityPicker_Title}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="White" />
                        <TextBlock Text="{markup:Localize Key=Dialog_EntityPicker_Subtitle}"
                                   FontSize="12"
                                   Foreground="#FFFFFFCC"/>
                    </StackPanel>
                </Grid>
            </Border>
        
        <!-- Search and Filter -->
        <Border Grid.Row="1" 
                Background="{DynamicResource BrushSurfaceAlt}"
                Padding="16,12"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="0,0,0,1">
            <StackPanel Spacing="12">
                <!-- Search box -->
                <TextBox x:Name="SearchTextBox"
                         Watermark="{markup:Localize Key=Dialog_EntityPicker_SearchPlaceholder}"
                         Text="{Binding SearchText}"/>
                
                <!-- Filter tabs -->
                <StackPanel x:Name="FilterPanel" Orientation="Horizontal" Spacing="6"
                            IsVisible="{Binding ShowFilters}">
                    <Border x:Name="AllFilterBorder" Classes="filter-tab selected"
                            PointerPressed="FilterBorder_PointerPressed" Tag="all">
                        <TextBlock Text="{markup:Localize Key=Dialog_EntityPicker_All}" FontSize="12" FontWeight="Medium"/>
                    </Border>
                    <Border x:Name="TaskFilterBorder" Classes="filter-tab"
                            PointerPressed="FilterBorder_PointerPressed" Tag="task">
                        <TextBlock Text="{markup:Localize Key=Dialog_EntityPicker_Tasks}" FontSize="12" FontWeight="Medium"
                                   Foreground="{DynamicResource BrushTextSecondary}"/>
                    </Border>
                    <Border x:Name="GoalFilterBorder" Classes="filter-tab"
                            PointerPressed="FilterBorder_PointerPressed" Tag="goal">
                        <TextBlock Text="{markup:Localize Key=Dialog_EntityPicker_Goals}" FontSize="12" FontWeight="Medium"
                                   Foreground="{DynamicResource BrushTextSecondary}"/>
                    </Border>
                    <Border x:Name="MetricFilterBorder" Classes="filter-tab"
                            PointerPressed="FilterBorder_PointerPressed" Tag="metric">
                        <TextBlock Text="{markup:Localize Key=Dialog_EntityPicker_Metrics}" FontSize="12" FontWeight="Medium"
                                   Foreground="{DynamicResource BrushTextSecondary}"/>
                    </Border>
                    <Border x:Name="ProjectFilterBorder" Classes="filter-tab"
                            PointerPressed="FilterBorder_PointerPressed" Tag="project">
                        <TextBlock Text="{markup:Localize Key=Dialog_EntityPicker_Projects}" FontSize="12" FontWeight="Medium"
                                   Foreground="{DynamicResource BrushTextSecondary}"/>
                    </Border>
                    <Border x:Name="PersonFilterBorder" Classes="filter-tab"
                            PointerPressed="FilterBorder_PointerPressed" Tag="person">
                        <TextBlock Text="{markup:Localize Key=Dialog_EntityPicker_People}" FontSize="12" FontWeight="Medium"
                                   Foreground="{DynamicResource BrushTextSecondary}"/>
                    </Border>
                    <Border x:Name="MeetingFilterBorder" Classes="filter-tab"
                            PointerPressed="FilterBorder_PointerPressed" Tag="meeting">
                        <TextBlock Text="{markup:Localize Key=Dialog_EntityPicker_Meetings}" FontSize="12" FontWeight="Medium"
                                   Foreground="{DynamicResource BrushTextSecondary}"/>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>
        
        <!-- Results list -->
        <Border Grid.Row="2" Padding="12" Background="{DynamicResource BrushSurface}">
            <Grid>
                <!-- Loading indicator -->
                <StackPanel x:Name="LoadingPanel" 
                            IsVisible="{Binding IsLoading}"
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center"
                            Spacing="8">
                    <ProgressBar IsIndeterminate="True" Width="100"/>
                    <TextBlock Text="{markup:Localize Key=Dialog_EntityPicker_Loading}" 
                               FontSize="13"
                               Foreground="{DynamicResource BrushTextSecondary}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
                
                <!-- Empty state -->
                <StackPanel x:Name="EmptyPanel"
                            IsVisible="{Binding !HasItems}"
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center"
                            Spacing="12">
                    <Border Width="64" Height="64" CornerRadius="32"
                            Background="{DynamicResource BrushSurfaceAlt}">
                        <PathIcon Data="M15.5,12C18,12 20,14 20,16.5C20,17.38 19.75,18.21 19.31,18.9L22.39,22L21,23.39L17.88,20.32C17.19,20.75 16.37,21 15.5,21C13,21 11,19 11,16.5C11,14 13,12 15.5,12M15.5,14A2.5,2.5 0 0,0 13,16.5A2.5,2.5 0 0,0 15.5,19A2.5,2.5 0 0,0 18,16.5A2.5,2.5 0 0,0 15.5,14M5,3H19C20.11,3 21,3.89 21,5V13.03C20.5,12.23 19.81,11.54 19,11V5H5V19H9.5C9.81,19.75 10.26,20.42 10.81,21H5C3.89,21 3,20.11 3,19V5C3,3.89 3.89,3 5,3M7,7H17V9H7V7M7,11H12.03C11.23,11.5 10.54,12.19 10,13H7V11M7,15H9.17C9.06,15.5 9,16 9,16.5V17H7V15Z"
                                  Width="28" Height="28"
                                  Foreground="{DynamicResource BrushTextTertiary}"/>
                    </Border>
                    <TextBlock Text="{markup:Localize Key=Dialog_EntityPicker_NoItems}" 
                               FontSize="14"
                               FontWeight="Medium"
                               Foreground="{DynamicResource BrushTextSecondary}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{markup:Localize Key=Dialog_EntityPicker_TryDifferent}"
                               FontSize="12"
                               Foreground="{DynamicResource BrushTextTertiary}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
                
                <!-- Results -->
                <ListBox x:Name="ResultsListBox"
                         Background="Transparent"
                         ItemsSource="{Binding FilteredItems}"
                         SelectedItem="{Binding SelectedItem}"
                         IsVisible="{Binding HasItems}"
                         DoubleTapped="ResultsListBox_DoubleTapped">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:EntityPickerItem">
                            <Border Classes="result-item">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <!-- Type icon -->
                                    <Border Grid.Column="0" 
                                            Width="36" Height="36"
                                            CornerRadius="8"
                                            Background="{Binding TypeColor}"
                                            Margin="0,0,12,0">
                                        <PathIcon Data="{Binding TypeIcon}"
                                                  Width="18" Height="18"
                                                  Foreground="White"/>
                                    </Border>
                                    
                                    <!-- Title and subtitle -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource BrushTextPrimary}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subtitle}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                    
                                    <!-- Status badge -->
                                    <Border Grid.Column="2"
                                            Background="{DynamicResource BrushSurfaceAlt}"
                                            CornerRadius="4"
                                            Padding="8,4"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding HasStatus}">
                                        <TextBlock Text="{Binding StatusText}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource BrushTextTertiary}"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
        
        <!-- Footer with ProCohere navy blue background -->
        <Border Grid.Row="3"
                Background="{DynamicResource BrushSecondary}"
                Padding="20,12">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding SelectionHint}"
                           FontSize="12"
                           Foreground="#FFFFFFCC"
                           VerticalAlignment="Center"/>
                           
                <!-- Cancel button -->
                <Button Grid.Column="1" 
                        Content="{markup:Localize Key=Button_Cancel}"
                        Background="Transparent" 
                        Foreground="White"
                        BorderThickness="1"
                        BorderBrush="White"
                        Margin="0,0,8,0"
                        Padding="16,8"
                        x:Name="CancelButton"
                        Command="{Binding CancelCommand}">
                    <Button.Styles>
                        <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="TextBlock.Foreground" Value="{DynamicResource BrushSecondary}"/>
                        </Style>
                    </Button.Styles>
                </Button>
                
                <!-- Link button -->
                <Button Grid.Column="2"
                        x:Name="LinkButton"
                        Content="{markup:Localize Key=Dialog_EntityPicker_Link}"
                        Foreground="{DynamicResource BrushPrimary}"
                        FontWeight="SemiBold"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource BrushPrimary}"
                        Padding="20,8"
                        IsEnabled="{Binding CanLink}"
                        Command="{Binding SelectCommand}">
                    <Button.Styles>
                        <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
                            <Setter Property="Background" Value="White"/>
                        </Style>
                        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                            <Setter Property="Background" Value="{DynamicResource BrushPrimary}"/>
                            <Setter Property="TextBlock.Foreground" Value="White"/>
                        </Style>
                    </Button.Styles>
                </Button>
            </Grid>
        </Border>
        </Grid>
    </Border>
</Window>
