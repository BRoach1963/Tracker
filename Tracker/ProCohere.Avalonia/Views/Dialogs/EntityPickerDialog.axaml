<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:dialogs="using:ProCohere.Avalonia.Views.Dialogs"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="550"
        x:Class="ProCohere.Avalonia.Views.Dialogs.EntityPickerDialog"
        Title="Link to Existing Item"
        Width="500" Height="550"
        MinWidth="400" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        ShowInTaskbar="False"
        SystemDecorations="Full"
        Background="{DynamicResource SystemChromeMediumLowColor}">

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!-- Header -->
        <Border Grid.Row="0" 
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                Padding="20,16">
            <StackPanel>
                <TextBlock Text="Link to Existing Item"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="Search for a task, goal, metric, or project to discuss"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
        
        <!-- Search and Filter -->
        <Border Grid.Row="1" 
                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                Padding="16,12">
            <StackPanel Spacing="12">
                <!-- Search box -->
                <TextBox x:Name="SearchTextBox"
                         Watermark="Search by title..."
                         TextChanged="SearchTextBox_TextChanged"/>
                
                <!-- Filter tabs -->
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button x:Name="AllFilterButton" 
                            Classes="segmented-button selected"
                            Content="All"
                            Click="FilterButton_Click"
                            Tag="all"/>
                    <Button x:Name="TaskFilterButton"
                            Classes="segmented-button"
                            Content="Tasks"
                            Click="FilterButton_Click"
                            Tag="task"/>
                    <Button x:Name="GoalFilterButton"
                            Classes="segmented-button"
                            Content="Goals"
                            Click="FilterButton_Click"
                            Tag="goal"/>
                    <Button x:Name="MetricFilterButton"
                            Classes="segmented-button"
                            Content="Metrics"
                            Click="FilterButton_Click"
                            Tag="metric"/>
                    <Button x:Name="ProjectFilterButton"
                            Classes="segmented-button"
                            Content="Projects"
                            Click="FilterButton_Click"
                            Tag="project"/>
                </StackPanel>
            </StackPanel>
        </Border>
        
        <!-- Results list -->
        <Border Grid.Row="2" Padding="8">
            <Grid>
                <!-- Loading indicator -->
                <StackPanel x:Name="LoadingPanel" 
                            IsVisible="False"
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center"
                            Spacing="8">
                    <ProgressBar IsIndeterminate="True" Width="100"/>
                    <TextBlock Text="Loading..." 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
                
                <!-- Empty state -->
                <StackPanel x:Name="EmptyPanel"
                            IsVisible="False"
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center"
                            Spacing="8">
                    <PathIcon Data="M15.5,12C18,12 20,14 20,16.5C20,17.38 19.75,18.21 19.31,18.9L22.39,22L21,23.39L17.88,20.32C17.19,20.75 16.37,21 15.5,21C13,21 11,19 11,16.5C11,14 13,12 15.5,12M15.5,14A2.5,2.5 0 0,0 13,16.5A2.5,2.5 0 0,0 15.5,19A2.5,2.5 0 0,0 18,16.5A2.5,2.5 0 0,0 15.5,14M5,3H19C20.11,3 21,3.89 21,5V13.03C20.5,12.23 19.81,11.54 19,11V5H5V19H9.5C9.81,19.75 10.26,20.42 10.81,21H5C3.89,21 3,20.11 3,19V5C3,3.89 3.89,3 5,3M7,7H17V9H7V7M7,11H12.03C11.23,11.5 10.54,12.19 10,13H7V11M7,15H9.17C9.06,15.5 9,16 9,16.5V17H7V15Z"
                              Width="32" Height="32"
                              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                              Opacity="0.5"/>
                    <TextBlock Text="No items found" 
                               FontSize="13"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Try a different search or filter"
                               FontSize="11"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Opacity="0.7"
                               HorizontalAlignment="Center"/>
                </StackPanel>
                
                <!-- Results -->
                <ListBox x:Name="ResultsListBox"
                         Background="Transparent"
                         SelectionChanged="ResultsListBox_SelectionChanged"
                         DoubleTapped="ResultsListBox_DoubleTapped">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="dialogs:EntityPickerItem">
                            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                    CornerRadius="6" Padding="12" Margin="4">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <!-- Type icon -->
                                    <Border Grid.Column="0" 
                                            Width="32" Height="32"
                                            CornerRadius="6"
                                            Background="{Binding TypeColor}"
                                            Margin="0,0,12,0">
                                        <PathIcon Data="{Binding TypeIcon}"
                                                  Width="16" Height="16"
                                                  Foreground="White"/>
                                    </Border>
                                    
                                    <!-- Title and subtitle -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subtitle}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Opacity="0.8"/>
                                    </StackPanel>
                                    
                                    <!-- Status badge -->
                                    <Border Grid.Column="2"
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                            CornerRadius="4"
                                            Padding="8,4"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding HasStatus}">
                                        <TextBlock Text="{Binding StatusText}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
        
        <!-- Footer -->
        <Border Grid.Row="3"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                Padding="20,12">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0"
                           x:Name="SelectionHint"
                           Text="Select an item to link"
                           FontSize="11"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Content="Cancel"
                        MinWidth="80"
                        Margin="0,0,8,0"
                        Click="CancelButton_Click" />
                <Button Grid.Column="2"
                        x:Name="SelectButton"
                        Content="Link"
                        Classes="accent"
                        MinWidth="80"
                        IsEnabled="False"
                        Click="SelectButton_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
