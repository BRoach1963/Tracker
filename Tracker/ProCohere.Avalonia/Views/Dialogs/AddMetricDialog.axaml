<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="using:ProCohere.Avalonia.Models"
        xmlns:vm="using:ProCohere.Avalonia.ViewModels.Dialogs"
        xmlns:asyncImageLoader="using:AsyncImageLoader"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="650"
        x:Class="ProCohere.Avalonia.Views.Dialogs.AddMetricDialog"
        x:DataType="vm:AddMetricDialogViewModel"
        Title="New Metric"
        Width="520" Height="650"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        SystemDecorations="BorderOnly"
        Background="Transparent">
    
    <Border Background="{DynamicResource BrushSurface}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1"
            CornerRadius="8"
            ClipToBounds="True">
        <Grid RowDefinitions="Auto,*,Auto">
            <!-- Header (green with icon) -->
            <Border Grid.Row="0" Background="{DynamicResource BrushPrimary}" Padding="20,16">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <!-- Analytics/chart icon -->
                    <Border Width="36" Height="36" CornerRadius="8" 
                            Background="{DynamicResource BrushPrimaryPressed}" 
                            VerticalAlignment="Center">
                        <PathIcon Data="M22,21H2V3H4V19H6V10H10V19H12V6H16V19H18V14H22V21Z" 
                                  Width="18" Height="18" Foreground="White"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="New Metric" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="Configure your measurement" FontSize="12" Foreground="#FFFFFFCC"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        
        <!-- Content -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto"
                      Padding="20,16">
            <StackPanel Spacing="16">
                
                <!-- Name -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Name *" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}"/>
                    <TextBox Text="{Binding Name}"
                             Watermark="What are you measuring?" />
                </StackPanel>
                
                <!-- Description -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Description" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}"/>
                    <TextBox Text="{Binding Description}"
                             Watermark="What does this metric tell us? Why does it matter?"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="60" />
                </StackPanel>
                
                <!-- Category -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Category" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}"/>
                    <TextBox Text="{Binding Category}"
                             Watermark="e.g., Performance, Engagement, Revenue" />
                </StackPanel>
                
                <!-- Values Row -->
                <Grid ColumnDefinitions="*,12,*,12,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="Current Value" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}"/>
                        <TextBox Text="{Binding CurrentValueText}"
                                 Watermark="0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="Target Value" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}"/>
                        <TextBox Text="{Binding TargetValueText}"
                                 Watermark="Optional" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" Spacing="4">
                        <TextBlock Text="Baseline" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}"/>
                        <TextBox Text="{Binding BaselineValueText}"
                                 Watermark="Optional" />
                    </StackPanel>
                </Grid>
                
                <!-- Unit and Direction -->
                <Grid ColumnDefinitions="*,12,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="Unit" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}"/>
                        <TextBox Text="{Binding Unit}"
                                 Watermark="%, count, $, etc." />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="Direction" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}"/>
                        <ComboBox SelectedIndex="{Binding DirectionIndex}"
                                  HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Higher is better" Tag="higher_is_better" />
                            <ComboBoxItem Content="Lower is better" Tag="lower_is_better" />
                            <ComboBoxItem Content="Neutral" Tag="neutral" />
                        </ComboBox>
                    </StackPanel>
                </Grid>
                
                <!-- Source and Scope -->
                <Grid ColumnDefinitions="*,12,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="Data Source" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}"/>
                        <ComboBox SelectedIndex="{Binding SourceIndex}"
                                  HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="System" Tag="system" />
                            <ComboBoxItem Content="Survey" Tag="survey" />
                            <ComboBoxItem Content="Manual" Tag="manual" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="Scope" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}"/>
                        <ComboBox SelectedIndex="{Binding ScopeIndex}"
                                  HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Individual" Tag="individual" />
                            <ComboBoxItem Content="Team" Tag="team" />
                            <ComboBoxItem Content="Organization" Tag="organization" />
                        </ComboBox>
                    </StackPanel>
                </Grid>
                
                <!-- Frequency -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Update Frequency" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}"/>
                    <ComboBox SelectedIndex="{Binding FrequencyIndex}"
                              HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Daily" Tag="daily" />
                        <ComboBoxItem Content="Weekly" Tag="weekly" />
                        <ComboBoxItem Content="Monthly" Tag="monthly" />
                        <ComboBoxItem Content="Quarterly" Tag="quarterly" />
                    </ComboBox>
                </StackPanel>
                
                <!-- Owner/Steward -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Steward" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}"/>
                    <ComboBox ItemsSource="{Binding TeamMembers}"
                              SelectedItem="{Binding SelectedOwner}"
                              HorizontalAlignment="Stretch"
                              PlaceholderText="Select steward">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:TeamMemberDetail">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="24" Height="24" CornerRadius="12" ClipToBounds="True">
                                        <Panel>
                                            <Border Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                    CornerRadius="12"
                                                    IsVisible="{Binding UserAvatarUrl, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                                                <TextBlock Text="{Binding Initials}"
                                                           FontSize="10"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <Image asyncImageLoader:ImageLoader.Source="{Binding UserAvatarUrl}"
                                                   Stretch="UniformToFill" Width="24" Height="24"
                                                   IsVisible="{Binding UserAvatarUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        </Panel>
                                    </Border>
                                    <TextBlock Text="{Binding FullName}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                
                <!-- Visibility and Sensitivity -->
                <Grid ColumnDefinitions="*,12,Auto">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="Visibility" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}"/>
                        <ComboBox SelectedIndex="{Binding VisibilityIndex}"
                                  HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Private (only me)" Tag="private" />
                            <ComboBoxItem Content="Team" Tag="team" />
                            <ComboBoxItem Content="Organization" Tag="organization" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Bottom">
                        <CheckBox IsChecked="{Binding IsSensitive}"
                                  Content="Sensitive data" />
                    </StackPanel>
                </Grid>
                
            </StackPanel>
        </ScrollViewer>
        
            <!-- Footer (blue) -->
            <Border Grid.Row="2" Background="{DynamicResource BrushSecondary}" Padding="20,12">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <Button Grid.Column="1"
                            Content="Cancel"
                            Background="Transparent"
                            Foreground="White"
                            BorderBrush="White"
                            BorderThickness="1"
                            MinWidth="80"
                            Margin="0,0,8,0"
                            Command="{Binding CancelCommand}">
                        <Button.Styles>
                            <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="TextBlock.Foreground" Value="{DynamicResource BrushSecondary}"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                    <Button Grid.Column="2"
                            Content="Create Metric"
                            Foreground="{DynamicResource BrushPrimary}"
                            FontWeight="SemiBold"
                            BorderBrush="{DynamicResource BrushPrimary}"
                            BorderThickness="1"
                            MinWidth="120"
                            Command="{Binding SaveCommand}">
                        <Button.Styles>
                            <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="White"/>
                            </Style>
                            <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource BrushPrimary}"/>
                                <Setter Property="TextBlock.Foreground" Value="White"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
