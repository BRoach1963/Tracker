<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="using:ProCohere.Avalonia.Models"
        xmlns:vm="using:ProCohere.Avalonia.ViewModels.Dialogs"
        xmlns:asyncImageLoader="using:AsyncImageLoader"
        xmlns:markup="clr-namespace:ProCohere.Avalonia.Markup"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="700"
        x:Class="ProCohere.Avalonia.Views.Dialogs.EditMetricDialog"
        x:DataType="vm:EditMetricDialogViewModel"
        Title="Metric"
        Width="520" Height="700"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        SystemDecorations="BorderOnly"
        Background="Transparent">
    
    <Border Background="{DynamicResource BrushSurface}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1"
            CornerRadius="8"
            ClipToBounds="True">
        <Grid RowDefinitions="Auto,*,Auto">
            <!-- Header (green with icon) -->
            <Border Grid.Row="0" Background="{DynamicResource BrushPrimary}" Padding="20,16">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <!-- Analytics/chart icon -->
                    <Border Width="36" Height="36" CornerRadius="8" 
                            Background="{DynamicResource BrushPrimaryPressed}" 
                            VerticalAlignment="Center">
                        <PathIcon Data="M22,21H2V3H4V19H6V10H10V19H12V6H16V19H18V14H22V21Z" 
                                  Width="18" Height="18" Foreground="White"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding DialogTitle}" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="{markup:Localize Key=Dialog_Metric_Subtitle}" FontSize="12" Foreground="#FFFFFFCC"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        
        <!-- Content -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto"
                      Padding="20,16">
            <StackPanel Spacing="16">
                
                <!-- Name -->
                <StackPanel Spacing="4">
                    <TextBlock Text="{markup:Localize Key=Dialog_Metric_Name}" FontSize="12" />
                    <TextBox Text="{Binding Name}"
                             Watermark="{markup:Localize Key=Dialog_Metric_NameWatermark}" />
                </StackPanel>
                
                <!-- Description -->
                <StackPanel Spacing="4">
                    <TextBlock Text="{markup:Localize Key=Label_Description}" FontSize="12" />
                    <TextBox Text="{Binding Description}"
                             Watermark="{markup:Localize Key=Dialog_Metric_DescriptionWatermark}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="60" />
                </StackPanel>
                
                <!-- Category -->
                <StackPanel Spacing="4">
                    <TextBlock Text="{markup:Localize Key=Dialog_Metric_Category}" FontSize="12" />
                    <TextBox Text="{Binding Category}"
                             Watermark="{markup:Localize Key=Dialog_Metric_CategoryWatermark}" />
                </StackPanel>
                
                <!-- Values Row -->
                <Grid ColumnDefinitions="*,12,*,12,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="{markup:Localize Key=Dialog_Metric_CurrentValue}" FontSize="12" />
                        <TextBox Text="{Binding CurrentValueText}"
                                 Watermark="0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="{markup:Localize Key=Dialog_Metric_TargetValue}" FontSize="12" />
                        <TextBox Text="{Binding TargetValueText}"
                                 Watermark="{markup:Localize Key=Dialog_Metric_Optional}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" Spacing="4">
                        <TextBlock Text="{markup:Localize Key=Dialog_Metric_Baseline}" FontSize="12" />
                        <TextBox Text="{Binding BaselineValueText}"
                                 Watermark="{markup:Localize Key=Dialog_Metric_Optional}" />
                    </StackPanel>
                </Grid>
                
                <!-- Unit and Direction -->
                <Grid ColumnDefinitions="*,12,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="{markup:Localize Key=Dialog_Metric_Unit}" FontSize="12" />
                        <TextBox Text="{Binding Unit}"
                                 Watermark="{markup:Localize Key=Dialog_Metric_UnitWatermark}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="{markup:Localize Key=Dialog_Metric_Direction}" FontSize="12" />
                        <ComboBox SelectedIndex="{Binding DirectionIndex}"
                                  HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="{markup:Localize Key=Dialog_Metric_HigherBetter}" Tag="higher_is_better" />
                            <ComboBoxItem Content="{markup:Localize Key=Dialog_Metric_LowerBetter}" Tag="lower_is_better" />
                            <ComboBoxItem Content="{markup:Localize Key=Dialog_Metric_Neutral}" Tag="neutral" />
                        </ComboBox>
                    </StackPanel>
                </Grid>
                
                <!-- Source and Scope -->
                <Grid ColumnDefinitions="*,12,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="{markup:Localize Key=Dialog_Metric_DataSource}" FontSize="12" />
                        <ComboBox SelectedIndex="{Binding SourceIndex}"
                                  HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="{markup:Localize Key=Dialog_Metric_SourceSystem}" Tag="system" />
                            <ComboBoxItem Content="{markup:Localize Key=Dialog_Metric_SourceSurvey}" Tag="survey" />
                            <ComboBoxItem Content="{markup:Localize Key=Dialog_Metric_SourceManual}" Tag="manual" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="{markup:Localize Key=Dialog_Metric_Scope}" FontSize="12" />
                        <ComboBox SelectedIndex="{Binding ScopeIndex}"
                                  HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="{markup:Localize Key=Dialog_Metric_ScopeIndividual}" Tag="individual" />
                            <ComboBoxItem Content="{markup:Localize Key=Dialog_Metric_ScopeTeam}" Tag="team" />
                            <ComboBoxItem Content="{markup:Localize Key=Dialog_Metric_ScopeOrganization}" Tag="organization" />
                        </ComboBox>
                    </StackPanel>
                </Grid>
                
                <!-- Frequency -->
                <StackPanel Spacing="4">
                    <TextBlock Text="{markup:Localize Key=Dialog_Metric_UpdateFrequency}" FontSize="12" />
                    <ComboBox SelectedIndex="{Binding FrequencyIndex}"
                              HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="{markup:Localize Key=Dialog_Metric_FrequencyDaily}" Tag="daily" />
                        <ComboBoxItem Content="{markup:Localize Key=Dialog_Metric_FrequencyWeekly}" Tag="weekly" />
                        <ComboBoxItem Content="{markup:Localize Key=Dialog_Metric_FrequencyMonthly}" Tag="monthly" />
                        <ComboBoxItem Content="{markup:Localize Key=Dialog_Metric_FrequencyQuarterly}" Tag="quarterly" />
                    </ComboBox>
                </StackPanel>
                
                <!-- Owner/Steward -->
                <StackPanel Spacing="4">
                    <TextBlock Text="{markup:Localize Key=Dialog_Metric_Steward}" FontSize="12" />
                    <ComboBox ItemsSource="{Binding TeamMembers}"
                              SelectedItem="{Binding SelectedOwner}"
                              HorizontalAlignment="Stretch"
                              PlaceholderText="{markup:Localize Key=Dialog_Metric_SelectSteward}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:TeamMemberDetail">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="24" Height="24" CornerRadius="12" ClipToBounds="True">
                                        <Panel>
                                            <Border Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                    CornerRadius="12"
                                                    IsVisible="{Binding UserAvatarUrl, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                                                <TextBlock Text="{Binding Initials}"
                                                           FontSize="10"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <Image asyncImageLoader:ImageLoader.Source="{Binding UserAvatarUrl}"
                                                   Stretch="UniformToFill" Width="24" Height="24"
                                                   IsVisible="{Binding UserAvatarUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        </Panel>
                                    </Border>
                                    <TextBlock Text="{Binding FullName}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                
                <!-- Lifecycle (only in edit mode) -->
                <StackPanel Spacing="4" IsVisible="{Binding IsLifecycleVisible}">
                    <TextBlock Text="{markup:Localize Key=Dialog_Metric_Lifecycle}" FontSize="12" />
                    <ComboBox SelectedIndex="{Binding LifecycleIndex}"
                              HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="{markup:Localize Key=Dialog_Metric_LifecycleActive}" Tag="active" />
                        <ComboBoxItem Content="{markup:Localize Key=Dialog_Metric_LifecycleDormant}" Tag="dormant" />
                        <ComboBoxItem Content="{markup:Localize Key=Dialog_Metric_LifecycleRetired}" Tag="retired" />
                    </ComboBox>
                </StackPanel>
                
                <!-- Visibility and Sensitivity -->
                <Grid ColumnDefinitions="*,12,Auto">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="{markup:Localize Key=Label_Visibility}" FontSize="12" />
                        <ComboBox SelectedIndex="{Binding VisibilityIndex}"
                                  HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="{markup:Localize Key=Visibility_PrivateOnlyMe}" Tag="private" />
                            <ComboBoxItem Content="{markup:Localize Key=Visibility_Team}" Tag="team" />
                            <ComboBoxItem Content="{markup:Localize Key=Visibility_Organization}" Tag="organization" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Bottom">
                        <CheckBox IsChecked="{Binding IsSensitive}"
                                  Content="{markup:Localize Key=Dialog_Metric_SensitiveData}" />
                    </StackPanel>
                </Grid>
                
            </StackPanel>
        </ScrollViewer>
        
            <!-- Footer (blue) -->
            <Border Grid.Row="2" Background="{DynamicResource BrushSecondary}" Padding="20,12">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <Button Grid.Column="0"
                            Content="{markup:Localize Key=Button_Delete}"
                            Background="Transparent"
                            Foreground="#E74C3C"
                            BorderBrush="#E74C3C"
                            BorderThickness="1"
                            IsVisible="{Binding IsDeleteVisible}"
                            Command="{Binding DeleteCommand}">
                        <Button.Styles>
                            <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="#E74C3C"/>
                                <Setter Property="TextBlock.Foreground" Value="White"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                    <Button Grid.Column="2"
                            Content="{markup:Localize Key=Button_Cancel}"
                            Background="Transparent"
                            Foreground="White"
                            BorderBrush="White"
                            BorderThickness="1"
                            MinWidth="80"
                            Margin="0,0,8,0"
                            Command="{Binding CancelCommand}">
                        <Button.Styles>
                            <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="TextBlock.Foreground" Value="{DynamicResource BrushSecondary}"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                    <Button Grid.Column="3"
                            Content="{Binding SaveButtonText}"
                            Foreground="{DynamicResource BrushPrimary}"
                            FontWeight="SemiBold"
                            BorderBrush="{DynamicResource BrushPrimary}"
                            BorderThickness="1"
                            MinWidth="100"
                            Command="{Binding SaveCommand}">
                        <Button.Styles>
                            <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="White"/>
                            </Style>
                            <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource BrushPrimary}"/>
                                <Setter Property="TextBlock.Foreground" Value="White"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
