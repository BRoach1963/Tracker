<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ProCohere.Avalonia.ViewModels.Dialogs"
        xmlns:models="using:ProCohere.Avalonia.Models"
        xmlns:asyncImageLoader="using:AsyncImageLoader"
        xmlns:markup="clr-namespace:ProCohere.Avalonia.Markup"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="700"
        x:Class="ProCohere.Avalonia.Views.Dialogs.TeamMemberDetailsDialog"
        x:DataType="vm:TeamMemberDetailsDialogViewModel"
        Title="{markup:Localize Key=Dialog_TeamMember_Title}"
        Width="520" Height="700"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        SystemDecorations="BorderOnly"
        Background="Transparent">
    
    <Border Background="{DynamicResource BrushSurface}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1"
            CornerRadius="8"
            ClipToBounds="True">
        <Grid RowDefinitions="Auto,*,Auto">
            <!-- Header (green with avatar) -->
            <Border Grid.Row="0" Background="{DynamicResource BrushPrimary}" Padding="20,16">
                <Grid ColumnDefinitions="Auto,*">
                    <!-- Avatar -->
                    <Border Grid.Column="0" Width="56" Height="56" CornerRadius="28" ClipToBounds="True" Margin="0,0,16,0"
                            Background="{DynamicResource BrushSecondary}">
                        <Panel>
                            <!-- Initials fallback -->
                            <Border Background="{DynamicResource BrushSecondary}"
                                    CornerRadius="28"
                                    IsVisible="{Binding AvatarUrl, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                                <TextBlock Text="{Binding Initials}"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <!-- Avatar Image -->
                            <Image asyncImageLoader:ImageLoader.Source="{Binding AvatarUrl}"
                                   Stretch="UniformToFill" Width="56" Height="56"
                                   IsVisible="{Binding AvatarUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </Panel>
                    </Border>
                    
                    <!-- Name and Email -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding FullName}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="White" />
                        <TextBlock Text="{Binding Email}"
                                   FontSize="13"
                                   Foreground="#FFFFFFCC" />
                    </StackPanel>
                </Grid>
            </Border>
        
        <!-- Content -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto"
                      Padding="20,16">
            <StackPanel Spacing="20">
                
                <!-- Personal Info Section (View Only) -->
                <StackPanel Spacing="12">
                    <TextBlock Text="{markup:Localize Key=Dialog_TeamMember_PersonalInfo}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Margin="0,0,0,4" />
                    
                    <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                            CornerRadius="8"
                            Padding="16">
                        <StackPanel Spacing="12">
                            <!-- Phone -->
                            <Grid ColumnDefinitions="100,*" IsVisible="{Binding HasPhone}">
                                <TextBlock Grid.Column="0" Text="{markup:Localize Key=Dialog_TeamMember_Phone}" FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding Phone}" FontSize="12" />
                            </Grid>
                            
                            <!-- Birthday -->
                            <Grid ColumnDefinitions="100,*">
                                <TextBlock Grid.Column="0" Text="{markup:Localize Key=Dialog_TeamMember_Birthday}" FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding BirthdayDisplay}" FontSize="12" />
                            </Grid>
                            
                            <!-- LinkedIn -->
                            <Grid ColumnDefinitions="100,*" IsVisible="{Binding HasLinkedIn}">
                                <TextBlock Grid.Column="0" Text="{markup:Localize Key=Dialog_TeamMember_LinkedIn}" FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Button Grid.Column="1" 
                                        Content="{Binding LinkedInUrl}"
                                        Command="{Binding OpenLinkedInCommand}"
                                        Classes="hyperlink"
                                        Padding="0"
                                        FontSize="12" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    
                    <TextBlock Text="{markup:Localize Key=Dialog_TeamMember_PersonalInfoNote}"
                               FontSize="11"
                               FontStyle="Italic"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                
                <!-- Organization Details Section (Editable) -->
                <StackPanel Spacing="12">
                    <TextBlock Text="{markup:Localize Key=Dialog_TeamMember_OrgDetails}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Margin="0,0,0,4" />
                    
                    <!-- Job Title -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="{markup:Localize Key=Dialog_TeamMember_JobTitle}" FontSize="12" />
                        <TextBox Text="{Binding JobTitle}"
                                 Watermark="{markup:Localize Key=Dialog_TeamMember_JobTitleWatermark}" />
                    </StackPanel>
                    
                    <!-- Manager -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="{markup:Localize Key=Dialog_TeamMember_Manager}" FontSize="12" />
                        <ComboBox ItemsSource="{Binding AvailableManagers}"
                                  SelectedItem="{Binding SelectedManager}"
                                  HorizontalAlignment="Stretch"
                                  PlaceholderText="{markup:Localize Key=Dialog_TeamMember_SelectManager}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:TeamMemberDetail">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="24" Height="24" CornerRadius="12" ClipToBounds="True">
                                            <Panel>
                                                <Border Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                        CornerRadius="12"
                                                        IsVisible="{Binding UserAvatarUrl, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                                                    <TextBlock Text="{Binding Initials}"
                                                               FontSize="10"
                                                               Foreground="White"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <Image asyncImageLoader:ImageLoader.Source="{Binding UserAvatarUrl}"
                                                       Stretch="UniformToFill" Width="24" Height="24"
                                                       IsVisible="{Binding UserAvatarUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                            </Panel>
                                        </Border>
                                        <TextBlock Text="{Binding FullName}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    
                    <!-- Hire Date -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="{markup:Localize Key=Dialog_TeamMember_HireDate}" FontSize="12" />
                        <CalendarDatePicker x:Name="HireDatePicker"
                                            HorizontalAlignment="Stretch"
                                            Watermark="{markup:Localize Key=Dialog_TeamMember_SelectDate}"
                                            IsTodayHighlighted="True"/>
                    </StackPanel>
                    
                    <!-- Active Status -->
                    <CheckBox IsChecked="{Binding IsActive}"
                              Content="{markup:Localize Key=Dialog_TeamMember_ActiveMember}"
                              Margin="0,4,0,0" />
                </StackPanel>
                
                <!-- Manager Notes Section -->
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{markup:Localize Key=Dialog_TeamMember_ManagerNotes}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" 
                                Content="{markup:Localize Key=Dialog_TeamMember_AddNote}"
                                Classes="accent" 
                                Padding="8,4" 
                                FontSize="11"
                                Click="AddNoteButton_Click" />
                    </Grid>
                    
                    <TextBlock Text="{markup:Localize Key=Dialog_TeamMember_ManagerNotesHint}"
                               FontSize="11"
                               FontStyle="Italic"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap" />
                    
                    <!-- Notes List -->
                    <ItemsControl ItemsSource="{Binding Notes}" MaxHeight="200">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="models:Note">
                                <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="6" Padding="10" Margin="0,0,0,6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"
                                                       IsVisible="{Binding Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            <TextBlock Text="{Binding Content}" FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       MaxLines="3" />
                                            <TextBlock FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0:MMM d, yyyy}">
                                                        <Binding Path="CreatedAt" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="✕" Padding="4,2" FontSize="10"
                                                VerticalAlignment="Top" Classes="subtle"
                                                Command="{Binding $parent[Window].((vm:TeamMemberDetailsDialogViewModel)DataContext).DeleteNoteCommand}"
                                                CommandParameter="{Binding Id}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    
                    <TextBlock Text="{markup:Localize Key=Dialog_TeamMember_NoNotes}"
                               FontSize="11"
                               FontStyle="Italic"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               IsVisible="{Binding !Notes.Count}" />
                </StackPanel>
                
                <!-- Error Message -->
                <TextBlock Text="{Binding ErrorMessage}"
                           FontSize="12"
                           Foreground="#E74C3C"
                           TextWrapping="Wrap"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                
            </StackPanel>
        </ScrollViewer>
        
            <!-- Footer (blue) -->
            <Border Grid.Row="2" Background="{DynamicResource BrushSecondary}" Padding="20,12">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <Button Grid.Column="0"
                            Content="{markup:Localize Key=Dialog_TeamMember_Deactivate}"
                            Background="Transparent"
                            Foreground="#E74C3C"
                            BorderBrush="#E74C3C"
                            BorderThickness="1"
                            Command="{Binding DeactivateCommand}">
                        <Button.Styles>
                            <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="#E74C3C"/>
                                <Setter Property="TextBlock.Foreground" Value="White"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                    <Button Grid.Column="2"
                            Content="{markup:Localize Key=Button_Cancel}"
                            Background="Transparent"
                            Foreground="White"
                            BorderBrush="White"
                            BorderThickness="1"
                            MinWidth="80"
                            Margin="0,0,8,0"
                            Command="{Binding CancelCommand}">
                        <Button.Styles>
                            <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="TextBlock.Foreground" Value="{DynamicResource BrushSecondary}"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                    <Button Grid.Column="3"
                            Content="{markup:Localize Key=Dialog_TeamMember_SaveChanges}"
                            Foreground="{DynamicResource BrushPrimary}"
                            FontWeight="SemiBold"
                            BorderBrush="{DynamicResource BrushPrimary}"
                            BorderThickness="1"
                            MinWidth="100"
                            Command="{Binding SaveCommand}">
                        <Button.Styles>
                            <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="White"/>
                            </Style>
                            <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource BrushPrimary}"/>
                                <Setter Property="TextBlock.Foreground" Value="White"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
