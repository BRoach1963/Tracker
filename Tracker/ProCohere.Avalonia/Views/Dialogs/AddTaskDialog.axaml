<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ProCohere.Avalonia.ViewModels.Dialogs"
        xmlns:models="using:ProCohere.Avalonia.Models"
        xmlns:markup="clr-namespace:ProCohere.Avalonia.Markup"
        mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="520"
        x:Class="ProCohere.Avalonia.Views.Dialogs.AddTaskDialog"
        x:DataType="vm:AddTaskDialogViewModel"
        Title="Task"
        Width="450"
        Height="520"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        SystemDecorations="BorderOnly"
        Background="Transparent">

    <Border Background="{DynamicResource BrushSurface}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1"
            CornerRadius="8"
            ClipToBounds="True">
        <Grid RowDefinitions="Auto,*,Auto">
            <!-- Header (green with icon) -->
            <Border Grid.Row="0" 
                    Background="{DynamicResource BrushPrimary}"
                    Padding="20,16">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <!-- Task icon -->
                    <Border Width="36" Height="36" CornerRadius="8" 
                            Background="{DynamicResource BrushPrimaryPressed}" 
                            VerticalAlignment="Center">
                        <PathIcon Data="M19,3H5C3.89,3 3,3.89 3,5V19C3,20.1 3.9,21 5,21H19C20.1,21 21,20.1 21,19V5C21,3.89 20.1,3 19,3M10,17L5,12L6.41,10.58L10,14.17L17.59,6.58L19,8L10,17Z" 
                                  Width="18" Height="18" Foreground="White"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding DialogTitleText}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="White" />
                        <TextBlock Text="{markup:Localize Key=Dialog_Task_Subtitle}"
                                   FontSize="12"
                                   Foreground="#FFFFFFCC"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            
            <!-- Form Content -->
            <ScrollViewer Grid.Row="1" Padding="24,16">
                <StackPanel Spacing="16">
                    <!-- Task Title -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="{markup:Localize Key=Dialog_Task_TitleLabel}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource BrushTextSecondary}"/>
                        <TextBox x:Name="TitleTextBox"
                                 Text="{Binding Title}"
                                 Watermark="{markup:Localize Key=Dialog_Task_TitlePlaceholder}"
                                 FontSize="14"/>
                    </StackPanel>
                    
                    <!-- Description -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="{markup:Localize Key=Label_Description}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource BrushTextSecondary}"/>
                        <TextBox x:Name="DescriptionTextBox"
                                 Text="{Binding Description}"
                                 Watermark="{markup:Localize Key=Dialog_Task_DescriptionPlaceholder}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="80"
                                 MaxHeight="120"/>
                    </StackPanel>
                    
                    <!-- Priority and Due Date Row -->
                    <Grid ColumnDefinitions="*,*">
                        <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,8,0">
                            <TextBlock Text="{markup:Localize Key=Label_Priority}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource BrushTextSecondary}"/>
                            <ComboBox x:Name="PriorityComboBox" 
                                      HorizontalAlignment="Stretch"
                                      SelectedIndex="{Binding PriorityIndex}"
                                      PlaceholderText="{markup:Localize Key=Dialog_Task_SelectPriority}">
                                <ComboBoxItem Content="{markup:Localize Key=Priority_High}" Tag="high"/>
                                <ComboBoxItem Content="{markup:Localize Key=Priority_Medium}" Tag="medium"/>
                                <ComboBoxItem Content="{markup:Localize Key=Priority_Low}" Tag="low"/>
                            </ComboBox>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1" Spacing="6" Margin="8,0,0,0">
                            <TextBlock Text="{markup:Localize Key=Label_DueDate}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource BrushTextSecondary}"/>
                            <CalendarDatePicker x:Name="DueDatePicker" 
                                                SelectedDate="{Binding DueDate}"
                                                HorizontalAlignment="Stretch"
                                                Watermark="{markup:Localize Key=Dialog_Task_SelectDate}"
                                                IsTodayHighlighted="True"/>
                        </StackPanel>
                    </Grid>
                    
                    <!-- Status (only in edit mode) -->
                    <StackPanel x:Name="StatusSection" Spacing="6" IsVisible="{Binding IsEditMode}">
                        <TextBlock Text="{markup:Localize Key=Label_Status}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource BrushTextSecondary}"/>
                        <ComboBox x:Name="StatusComboBox" 
                                  HorizontalAlignment="Stretch"
                                  SelectedIndex="{Binding StatusIndex}">
                            <ComboBoxItem Content="{markup:Localize Key=Status_NotStarted}" Tag="not_started"/>
                            <ComboBoxItem Content="{markup:Localize Key=Status_InProgress}" Tag="in_progress"/>
                            <ComboBoxItem Content="{markup:Localize Key=Status_Completed}" Tag="completed"/>
                            <ComboBoxItem Content="{markup:Localize Key=Status_Blocked}" Tag="blocked"/>
                        </ComboBox>
                    </StackPanel>
                    
                    <!-- Assignee -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="{markup:Localize Key=Dialog_Assignee}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource BrushTextSecondary}"/>
                        <ComboBox x:Name="AssigneeComboBox" 
                                  HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding TeamMembers}"
                                  SelectedItem="{Binding SelectedAssignee}"
                                  PlaceholderText="{markup:Localize Key=Dialog_Task_AssignTo}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:TeamMemberDetail">
                                    <TextBlock Text="{Binding FullName}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    
                    <!-- Goal -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="{markup:Localize Key=Dialog_Goal}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource BrushTextSecondary}"/>
                        <ComboBox x:Name="GoalComboBox" 
                                  HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding Goals}"
                                  SelectedItem="{Binding SelectedGoal}"
                                  PlaceholderText="{markup:Localize Key=Dialog_Task_LinkGoal}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:GoalDetail">
                                    <TextBlock Text="{Binding Title}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    
                    <!-- Recurrence Section -->
                    <Border BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,8,0,0">
                        <StackPanel Spacing="12">
                            <!-- Recurrence Toggle -->
                            <CheckBox Content="{markup:Localize Key=Dialog_Task_RepeatTask}" 
                                      FontSize="13" FontWeight="Medium" 
                                      Foreground="{DynamicResource BrushTextPrimary}"
                                      IsChecked="{Binding IsRecurringEnabled}"/>
                            
                            <!-- Recurrence Settings (visible when enabled) -->
                            <StackPanel Spacing="12" IsVisible="{Binding IsRecurringEnabled}">
                                <!-- Pattern -->
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{markup:Localize Key=Dialog_Task_Frequency}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource BrushTextSecondary}"/>
                                    <ComboBox x:Name="RecurrencePatternComboBox" 
                                              HorizontalAlignment="Stretch"
                                              SelectedIndex="{Binding RecurrencePatternIndex}">
                                        <ComboBoxItem Content="{markup:Localize Key=Recurrence_Daily}" Tag="daily"/>
                                        <ComboBoxItem Content="{markup:Localize Key=Recurrence_Weekly}" Tag="weekly"/>
                                        <ComboBoxItem Content="{markup:Localize Key=Recurrence_Monthly}" Tag="monthly"/>
                                    </ComboBox>
                                </StackPanel>
                                
                                <!-- Interval -->
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{markup:Localize Key=Dialog_Task_RepeatEvery}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource BrushTextSecondary}"/>
                                    <Grid ColumnDefinitions="Auto,*">
                                        <NumericUpDown Grid.Column="0" 
                                                       Width="80"
                                                       Minimum="1" 
                                                       Maximum="365"
                                                       Value="{Binding RecurrenceInterval}"
                                                       ShowButtonSpinner="True"
                                                       AllowSpin="True"/>
                                        <TextBlock Grid.Column="1" 
                                                   VerticalAlignment="Center" 
                                                   Margin="8,0,0,0"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource BrushTextTertiary}">
                                            <Run Text="{Binding RecurrencePatternIndex, Converter={StaticResource RecurrencePatternToUnitConverter}}"/>
                                        </TextBlock>
                                    </Grid>
                                </StackPanel>
                                
                                <!-- End Date -->
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{markup:Localize Key=Dialog_Task_EndsOptional}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource BrushTextSecondary}"/>
                                    <DatePicker SelectedDate="{Binding RecurrenceEndDate}" 
                                                HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            
            <!-- Footer (blue) -->
            <Border Grid.Row="2"
                    Background="{DynamicResource BrushSecondary}"
                    Padding="20,12">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <Button Grid.Column="0"
                            Content="{markup:Localize Key=Button_Delete}"
                            Background="Transparent"
                            Foreground="{DynamicResource BrushError}"
                            BorderBrush="{DynamicResource BrushError}"
                            BorderThickness="1"
                            IsVisible="{Binding IsEditMode}"
                            Command="{Binding DeleteCommand}">
                        <Button.Styles>
                            <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource BrushError}"/>
                                <Setter Property="TextBlock.Foreground" Value="White"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                    
                    <Button Grid.Column="2"
                            Content="{markup:Localize Key=Button_Cancel}"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="1"
                            BorderBrush="White"
                            Padding="16,8"
                            Margin="0,0,8,0"
                            Command="{Binding CancelCommand}">
                        <Button.Styles>
                            <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="TextBlock.Foreground" Value="{DynamicResource BrushSecondary}"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                    
                    <Button Grid.Column="3"
                            Content="{Binding SaveButtonText}"
                            Foreground="{DynamicResource BrushPrimary}"
                            FontWeight="SemiBold"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource BrushPrimary}"
                            Padding="16,8"
                            Command="{Binding SaveCommand}">
                        <Button.Styles>
                            <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="White"/>
                            </Style>
                            <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource BrushPrimary}"/>
                                <Setter Property="TextBlock.Foreground" Value="White"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
