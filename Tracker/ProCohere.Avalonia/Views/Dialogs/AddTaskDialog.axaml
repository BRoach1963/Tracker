<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="using:ProCohere.Avalonia.Models"
        mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="400"
        x:Class="ProCohere.Avalonia.Views.Dialogs.AddTaskDialog"
        Title="New Task"
        Width="450"
        Height="420"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        SystemDecorations="Full"
        ExtendClientAreaToDecorationsHint="False">

    <Window.Styles>
        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="*,Auto" Margin="24">
        <!-- Form Content -->
        <StackPanel Grid.Row="0" Spacing="16">
            <!-- Task Title -->
            <StackPanel Spacing="6">
                <TextBlock Text="Title" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource BrushTextSecondary}"/>
                <TextBox x:Name="TitleTextBox"
                         Watermark="What needs to be done?"
                         FontSize="14"/>
            </StackPanel>
            
            <!-- Description -->
            <StackPanel Spacing="6">
                <TextBlock Text="Description" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource BrushTextSecondary}"/>
                <TextBox x:Name="DescriptionTextBox"
                         Watermark="Add more details (optional)"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="80"
                         MaxHeight="120"/>
            </StackPanel>
            
            <!-- Priority and Due Date Row -->
            <Grid ColumnDefinitions="*,*">
                <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,8,0">
                    <TextBlock Text="Priority" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource BrushTextSecondary}"/>
                    <ComboBox x:Name="PriorityComboBox" 
                              HorizontalAlignment="Stretch"
                              PlaceholderText="Select priority">
                        <ComboBoxItem Content="High"/>
                        <ComboBoxItem Content="Medium"/>
                        <ComboBoxItem Content="Low"/>
                    </ComboBox>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Spacing="6" Margin="8,0,0,0">
                    <TextBlock Text="Due Date" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource BrushTextSecondary}"/>
                    <DatePicker x:Name="DueDatePicker" 
                                HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Grid>
            
            <!-- Assignee -->
            <StackPanel Spacing="6">
                <TextBlock Text="Assignee" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource BrushTextSecondary}"/>
                <ComboBox x:Name="AssigneeComboBox" 
                          HorizontalAlignment="Stretch"
                          PlaceholderText="Assign to someone">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:TeamMemberDetail">
                            <TextBlock Text="{Binding FullName}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </StackPanel>
        
        <!-- Action Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
            <Button x:Name="CancelButton" 
                    Content="Cancel" 
                    Classes="secondary-button"
                    Padding="16,8"
                    Click="CancelButton_Click"/>
            <Button x:Name="CreateButton" 
                    Content="Create Task" 
                    Classes="primary-button"
                    Padding="16,8"
                    Click="CreateButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
