<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ProCohere.Avalonia.ViewModels.Dialogs"
        xmlns:models="clr-namespace:ProCohere.Avalonia.Models"
        xmlns:markup="clr-namespace:ProCohere.Avalonia.Markup"
        mc:Ignorable="d" d:DesignWidth="550" d:DesignHeight="500"
        x:Class="ProCohere.Avalonia.Views.Dialogs.ApplyTemplateDialog"
        x:DataType="vm:ApplyTemplateDialogViewModel"
        Title="{markup:Localize Key=Dialog_Template_Title}"
        Width="550" Height="500"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        SystemDecorations="BorderOnly"
        Background="Transparent">

    <Window.Styles>
        <Style Selector="Border.template-card">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        
        <Style Selector="Border.template-card:pointerover">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        </Style>
        
        <Style Selector="Border.template-card.selected">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        
        <Style Selector="TextBlock.template-name">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        
        <Style Selector="TextBlock.template-description">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        
        <Style Selector="TextBlock.template-meta">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>
        
        <Style Selector="Border.category-badge">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,2" />
        </Style>
    </Window.Styles>
    
    <Border Background="{DynamicResource BrushSurface}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1"
            CornerRadius="8"
            ClipToBounds="True">
        <Grid RowDefinitions="Auto,*,Auto">
            <!-- Header (green with icon) -->
            <Border Grid.Row="0" Background="{DynamicResource BrushPrimary}" Padding="20,16">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <!-- Template icon -->
                    <Border Width="36" Height="36" CornerRadius="8" 
                            Background="{DynamicResource BrushPrimaryPressed}" 
                            VerticalAlignment="Center">
                        <PathIcon Data="M19,3H14.82C14.4,1.84 13.3,1 12,1C10.7,1 9.6,1.84 9.18,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M12,3A1,1 0 0,1 13,4A1,1 0 0,1 12,5A1,1 0 0,1 11,4A1,1 0 0,1 12,3M7,7H17V5H19V19H5V5H7V7M12,9L7,14H10V18H14V14H17L12,9Z" 
                                  Width="18" Height="18" Foreground="White"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{markup:Localize Key=Dialog_Template_Title}" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock x:Name="MeetingTitleText"
                                   Text="{Binding MeetingTitleText}"
                                   FontSize="12" Foreground="#FFFFFFCC" TextTrimming="CharacterEllipsis" MaxWidth="400"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        
        <!-- Content -->
        <Grid Grid.Row="1" Margin="20,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            
            <!-- Category Filter -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                <TextBlock Text="{markup:Localize Key=Dialog_Template_Filter}"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ComboBox x:Name="CategoryFilterComboBox"
                          Width="150"
                          SelectedIndex="{Binding CategoryFilterIndex}">
                    <ComboBoxItem Content="{markup:Localize Key=Dialog_Template_AllTemplates}" Tag="" />
                    <ComboBoxItem Content="{markup:Localize Key=Dialog_Template_OneOnOne}" Tag="one_on_one" />
                    <ComboBoxItem Content="{markup:Localize Key=Dialog_Template_TeamMeeting}" Tag="team" />
                    <ComboBoxItem Content="{markup:Localize Key=Dialog_Template_ProjectReview}" Tag="project" />
                    <ComboBoxItem Content="{markup:Localize Key=Dialog_Template_Custom}" Tag="custom" />
                </ComboBox>
            </StackPanel>
            
            <!-- Templates List -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding HasTemplates}">
                <ItemsControl x:Name="TemplatesItemsControl" ItemsSource="{Binding FilteredTemplates}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:MeetingTemplateDetail">
                            <Border Classes="template-card"
                                    Tag="{Binding}"
                                    PointerPressed="TemplateCard_PointerPressed">
                                <Grid RowDefinitions="Auto,Auto,Auto">
                                    <!-- Header Row -->
                                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                                        <PathIcon Grid.Column="0"
                                                  Height="20" Width="20"
                                                  Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                                  Data="{Binding CategoryIcon}"
                                                  Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   Classes="template-name"
                                                   VerticalAlignment="Center" />
                                        <Border Grid.Column="2"
                                                Classes="category-badge"
                                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                            <TextBlock Text="{Binding CategoryDisplay}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                    </Grid>
                                    
                                    <!-- Description Row -->
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding Description}"
                                               Classes="template-description"
                                               Margin="30,4,0,0"
                                               MaxLines="2"
                                               TextTrimming="CharacterEllipsis" />
                                    
                                    <!-- Meta Row -->
                                    <StackPanel Grid.Row="2" 
                                                Orientation="Horizontal"
                                                Spacing="12"
                                                Margin="30,8,0,0">
                                        <TextBlock Classes="template-meta">
                                            <Run Text="{Binding ItemCountDisplay}" />
                                        </TextBlock>
                                        <TextBlock Classes="template-meta"
                                                   IsVisible="{Binding IsSystemTemplate}">
                                            <Run Text="{markup:Localize Key=Dialog_Template_SystemTemplate}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            
            <!-- Empty State -->
            <StackPanel x:Name="EmptyStatePanel"
                        IsVisible="{Binding !HasTemplates}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
                <PathIcon Height="40" Width="40"
                          Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                          Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z"
                          HorizontalAlignment="Center" />
                <TextBlock Text="{markup:Localize Key=Dialog_Template_NoTemplates}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{markup:Localize Key=Dialog_Template_TryDifferentFilter}"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>
            
            <!-- Loading State -->
            <StackPanel x:Name="LoadingPanel"
                        IsVisible="{Binding IsLoading}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                <ProgressBar IsIndeterminate="True"
                             Width="100"
                             Height="4" />
                <TextBlock Text="{markup:Localize Key=Dialog_Template_Loading}"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
        
            <!-- Footer (blue) -->
            <Border Grid.Row="2" Background="{DynamicResource BrushSecondary}" Padding="20,12">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <StackPanel Grid.Column="0" 
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="SelectedTemplateText"
                                   Text="{Binding SelectedTemplateText, TargetNullValue='No template selected'}"
                                   FontSize="12"
                                   Foreground="#FFFFFFCC" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="{markup:Localize Key=Button_Cancel}"
                            Background="Transparent"
                            Foreground="White"
                            BorderBrush="White"
                            BorderThickness="1"
                            MinWidth="80"
                            Margin="0,0,8,0"
                            Command="{Binding CancelCommand}">
                        <Button.Styles>
                            <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="TextBlock.Foreground" Value="{DynamicResource BrushSecondary}"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                    <Button Grid.Column="2"
                            x:Name="ApplyButton"
                            Content="{Binding ApplyButtonText}"
                            Foreground="{DynamicResource BrushPrimary}"
                            FontWeight="SemiBold"
                            BorderBrush="{DynamicResource BrushPrimary}"
                            BorderThickness="1"
                            MinWidth="120"
                            IsEnabled="{Binding IsApplyEnabled}"
                            Command="{Binding ApplyCommand}">
                        <Button.Styles>
                            <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="White"/>
                            </Style>
                            <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource BrushPrimary}"/>
                                <Setter Property="TextBlock.Foreground" Value="White"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
