<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ProCohere.Avalonia.ViewModels.Dialogs"
        xmlns:local="using:ProCohere.Avalonia.Views.Dialogs"
        mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="520"
        x:Class="ProCohere.Avalonia.Views.Dialogs.WhatIfDialog"
        x:DataType="vm:WhatIfDialogViewModel"
        Title="What-If Scenario"
        Width="480" Height="520"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        SystemDecorations="BorderOnly"
        Background="Transparent">

    <Border Background="{DynamicResource BrushSurface}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1"
            CornerRadius="8"
            ClipToBounds="True">
        <Grid RowDefinitions="Auto,*,Auto">
            <!-- Header (purple/secondary with chart icon) -->
            <Border Grid.Row="0" 
                    Background="{DynamicResource BrushSecondary}"
                    Padding="20,16">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <!-- Chart/scenario icon -->
                    <Border Width="36" Height="36" CornerRadius="8" 
                            Background="#FFFFFF33" 
                            VerticalAlignment="Center">
                        <PathIcon Data="M3,22V8H7V22H3M10,22V2H14V22H10M17,22V14H21V22H17Z" 
                                  Width="18" Height="18" Foreground="White"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="What-If Scenario"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="White" />
                        <TextBlock Text="{Binding GoalTitle}"
                                   FontSize="12"
                                   Foreground="#FFFFFFCC"
                                   MaxWidth="320"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            
            <!-- Content -->
            <ScrollViewer Grid.Row="1" 
                          VerticalScrollBarVisibility="Auto"
                          Padding="20,16">
                <StackPanel Spacing="20">
                    
                    <!-- Current Status Card -->
                    <Border Background="{DynamicResource BrushSurfaceVariant}"
                            CornerRadius="8"
                            Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Current Trajectory"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextSecondary}"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" 
                                           Text="{Binding CurrentStatusDisplay}"
                                           FontSize="16"
                                           FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" 
                                           Text="{Binding CurrentProbabilityDisplay}"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource BrushPrimary}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Scenario Type Selection -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Scenario Type" 
                                   FontSize="12" 
                                   Foreground="{DynamicResource BrushTextSecondary}"/>
                        <ComboBox SelectedIndex="{Binding SelectedScenarioIndex}"
                                  HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Velocity Change - What if we worked faster/slower?" />
                            <ComboBoxItem Content="Timeline Change - What if we adjusted the deadline?" />
                            <ComboBoxItem Content="Target Change - What if we changed the target?" />
                        </ComboBox>
                    </StackPanel>

                    <!-- Velocity Adjustment (visible when index = 0) -->
                    <StackPanel Spacing="8" 
                                IsVisible="{Binding SelectedScenarioIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=0}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Velocity Adjustment" 
                                       FontSize="12" 
                                       Foreground="{DynamicResource BrushTextSecondary}"/>
                            <TextBlock Grid.Column="1" 
                                       Text="{Binding VelocityDisplayText}"
                                       FontSize="12"
                                       FontWeight="SemiBold"/>
                        </Grid>
                        <Slider Minimum="-50" Maximum="100" 
                                Value="{Binding VelocityAdjustment}"
                                TickFrequency="10"
                                IsSnapToTickEnabled="True"/>
                        <TextBlock Text="Adjust how fast your team is progressing towards the goal"
                                   FontSize="11"
                                   Foreground="{DynamicResource BrushTextTertiary}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Timeline Adjustment (visible when index = 1) -->
                    <StackPanel Spacing="8" 
                                IsVisible="{Binding SelectedScenarioIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=1}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Timeline Adjustment" 
                                       FontSize="12" 
                                       Foreground="{DynamicResource BrushTextSecondary}"/>
                            <TextBlock Grid.Column="1" 
                                       Text="{Binding TimelineDisplayText}"
                                       FontSize="12"
                                       FontWeight="SemiBold"/>
                        </Grid>
                        <Slider Minimum="-30" Maximum="60" 
                                Value="{Binding TimelineAdjustmentDays}"
                                TickFrequency="5"
                                IsSnapToTickEnabled="True"/>
                        <TextBlock Text="Extend or compress the deadline for this goal"
                                   FontSize="11"
                                   Foreground="{DynamicResource BrushTextTertiary}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Target Adjustment (visible when index = 2) -->
                    <StackPanel Spacing="8" 
                                IsVisible="{Binding SelectedScenarioIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=2}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Target Adjustment" 
                                       FontSize="12" 
                                       Foreground="{DynamicResource BrushTextSecondary}"/>
                            <TextBlock Grid.Column="1" 
                                       Text="{Binding TargetDisplayText}"
                                       FontSize="12"
                                       FontWeight="SemiBold"/>
                        </Grid>
                        <Slider Minimum="-50" Maximum="50" 
                                Value="{Binding TargetAdjustment}"
                                TickFrequency="10"
                                IsSnapToTickEnabled="True"/>
                        <TextBlock Text="Increase or decrease the target scope"
                                   FontSize="11"
                                   Foreground="{DynamicResource BrushTextTertiary}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Simulation Result Card -->
                    <Border Background="{DynamicResource BrushSurfaceVariant}"
                            CornerRadius="8"
                            Padding="16"
                            IsVisible="{Binding HasResult}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Simulated Outcome"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextSecondary}"/>
                            
                            <!-- Probability Comparison -->
                            <Grid ColumnDefinitions="*,Auto,*" RowDefinitions="Auto,Auto">
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Current"
                                               FontSize="10"
                                               Foreground="{DynamicResource BrushTextTertiary}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding CurrentProbabilityDisplay}"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="→"
                                               FontSize="20"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource BrushTextSecondary}"/>
                                    <TextBlock Text="{Binding ProbabilityChangeDisplay}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               Foreground="{Binding IsPositiveChange, Converter={x:Static local:WhatIfDialog.PositiveChangeColorConverter}}"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Simulated"
                                               FontSize="10"
                                               Foreground="{DynamicResource BrushTextTertiary}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding SimulatedProbabilityDisplay}"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Foreground="{Binding IsPositiveChange, Converter={x:Static local:WhatIfDialog.PositiveChangeColorConverter}}"/>
                                </StackPanel>
                            </Grid>
                            
                            <!-- Status Change -->
                            <Border Background="{DynamicResource BrushSurface}"
                                    CornerRadius="4"
                                    Padding="12,8">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding SimulatedStatusDisplay}"
                                               FontSize="14"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding ImpactDescription}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource BrushTextSecondary}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- No Result Placeholder -->
                    <Border Background="{DynamicResource BrushSurfaceVariant}"
                            CornerRadius="8"
                            Padding="16"
                            IsVisible="{Binding !HasResult}">
                        <TextBlock Text="Adjust the slider above to see the simulated outcome"
                                   FontSize="12"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   HorizontalAlignment="Center"/>
                    </Border>

                </StackPanel>
            </ScrollViewer>
            
            <!-- Footer (blue) -->
            <Border Grid.Row="2"
                    Background="{DynamicResource BrushSecondary}"
                    Padding="20,12">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Button Grid.Column="0"
                            Content="Reset"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="1"
                            BorderBrush="#FFFFFF66"
                            MinWidth="70"
                            Command="{Binding ResetCommand}">
                        <Button.Styles>
                            <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="#FFFFFF22"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                    
                    <Button Grid.Column="2"
                            Content="Close"
                            Foreground="{DynamicResource BrushSecondary}"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            MinWidth="80"
                            Command="{Binding CloseCommand}">
                        <Button.Styles>
                            <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="White"/>
                            </Style>
                            <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="#FFFFFFDD"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
