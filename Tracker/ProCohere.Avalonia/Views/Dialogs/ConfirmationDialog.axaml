<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ProCohere.Avalonia.Views.Dialogs.ConfirmationDialog"
        Title="Confirm"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="BorderOnly"
        CanResize="False"
        ShowInTaskbar="False">
    
    <Window.Resources>
        <!-- Icon paths -->
        <StreamGeometry x:Key="QuestionIcon">M15.07,11.25L14.17,12.17C13.45,12.89 13,13.5 13,15H11V14.5C11,13.39 11.45,12.39 12.17,11.67L13.41,10.41C13.78,10.05 14,9.55 14,9C14,7.89 13.1,7 12,7A2,2 0 0,0 10,9H8A4,4 0 0,1 12,5A4,4 0 0,1 16,9C16,9.88 15.64,10.67 15.07,11.25M13,19H11V17H13M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12C22,6.47 17.5,2 12,2Z</StreamGeometry>
        <StreamGeometry x:Key="WarningIcon">M13 14H11V10H13M13 18H11V16H13M1 21H23L12 2L1 21Z</StreamGeometry>
        <StreamGeometry x:Key="DeleteIcon">M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z</StreamGeometry>
    </Window.Resources>
    
    <Border Background="{DynamicResource BrushSurface}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1"
            CornerRadius="{DynamicResource CornerRadiusControl}"
            Padding="24">
        <Grid RowDefinitions="Auto,Auto,Auto">
            
            <!-- Icon and Title -->
            <StackPanel Grid.Row="0" 
                        Orientation="Horizontal" 
                        Margin="0,0,0,16">
                <Viewbox Width="32" 
                         Height="32"
                         Margin="0,0,12,0">
                    <PathIcon x:Name="DialogIcon"
                              Data="{StaticResource QuestionIcon}"
                              Foreground="{DynamicResource BrushWarning}"/>
                </Viewbox>
                <TextBlock x:Name="TitleText"
                           Text="Confirm Action"
                           FontSize="{DynamicResource FontSizeTitle}"
                           FontWeight="SemiBold"
                           FontFamily="{DynamicResource FontFamilyDefault}"
                           Foreground="{DynamicResource BrushTextPrimary}"
                           VerticalAlignment="Center"/>
            </StackPanel>
            
            <!-- Message -->
            <TextBlock x:Name="MessageText"
                       Grid.Row="1"
                       Text="Are you sure you want to proceed?"
                       FontSize="{DynamicResource FontSizeBody}"
                       FontFamily="{DynamicResource FontFamilyDefault}"
                       Foreground="{DynamicResource BrushTextSecondary}"
                       TextWrapping="Wrap"
                       MaxWidth="360"
                       Margin="0,0,0,24"/>
            
            <!-- Buttons -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="12">
                <Button x:Name="CancelButton"
                        Content="Cancel"
                        MinWidth="80"
                        Click="CancelButton_Click"
                        Classes="secondary"/>
                <Button x:Name="ConfirmButton"
                        Content="Confirm"
                        MinWidth="80"
                        Click="ConfirmButton_Click"
                        Classes="primary"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
