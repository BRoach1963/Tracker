<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:markup="clr-namespace:ProCohere.Avalonia.Markup"
        x:Class="ProCohere.Avalonia.Views.Dialogs.ConfirmationDialog"
        Title="Confirm"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="BorderOnly"
        CanResize="False"
        ShowInTaskbar="False"
        Background="Transparent">
    
    <Window.Resources>
        <!-- Icon paths -->
        <StreamGeometry x:Key="QuestionIcon">M15.07,11.25L14.17,12.17C13.45,12.89 13,13.5 13,15H11V14.5C11,13.39 11.45,12.39 12.17,11.67L13.41,10.41C13.78,10.05 14,9.55 14,9C14,7.89 13.1,7 12,7A2,2 0 0,0 10,9H8A4,4 0 0,1 12,5A4,4 0 0,1 16,9C16,9.88 15.64,10.67 15.07,11.25M13,19H11V17H13M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12C22,6.47 17.5,2 12,2Z</StreamGeometry>
        <StreamGeometry x:Key="WarningIcon">M13 14H11V10H13M13 18H11V16H13M1 21H23L12 2L1 21Z</StreamGeometry>
        <StreamGeometry x:Key="DeleteIcon">M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z</StreamGeometry>
        <!-- Exit/logout icon (door with arrow) -->
        <StreamGeometry x:Key="ExitIcon">M16,17V14H9V10H16V7L21,12L16,17M14,2A2,2 0 0,1 16,4V6H14V4H5V20H14V18H16V20A2,2 0 0,1 14,22H5A2,2 0 0,1 3,20V4A2,2 0 0,1 5,2H14Z</StreamGeometry>
    </Window.Resources>
    
    <Border Background="{DynamicResource BrushSurface}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1"
            CornerRadius="8"
            ClipToBounds="True">
        <Grid RowDefinitions="Auto,*,Auto">
            
            <!-- Header with blue background -->
            <Border Grid.Row="0" 
                    Background="{DynamicResource BrushPrimary}"
                    Padding="20,16">
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="24" 
                             Height="24"
                             Margin="0,0,12,0">
                        <PathIcon x:Name="DialogIcon"
                                  Data="{StaticResource QuestionIcon}"
                                  Foreground="White"/>
                    </Viewbox>
                    <TextBlock x:Name="TitleText"
                               Text="{markup:Localize Key=Dialog_ConfirmAction_Title}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               FontFamily="{DynamicResource FontFamilyDefault}"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            
            <!-- Message -->
            <Border Grid.Row="1" Padding="24,20">
                <TextBlock x:Name="MessageText"
                           Text="{markup:Localize Key=Dialog_ConfirmAction_Message}"
                           FontSize="{DynamicResource FontSizeBody}"
                           FontFamily="{DynamicResource FontFamilyDefault}"
                           Foreground="{DynamicResource BrushTextSecondary}"
                           TextWrapping="Wrap"
                           LineHeight="22"/>
            </Border>
            
            <!-- Buttons (same blue background as other dialog footers) -->
            <Border Grid.Row="2"
                    Background="{DynamicResource BrushSecondary}"
                    Padding="20,12">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <Button Grid.Column="1"
                            x:Name="CancelButton"
                            Content="{markup:Localize Key=Button_Cancel}"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="1"
                            BorderBrush="White"
                            Padding="16,8"
                            Margin="0,0,8,0"
                            Click="CancelButton_Click">
                        <Button.Styles>
                            <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="TextBlock.Foreground" Value="{DynamicResource BrushSecondary}"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                    <Button Grid.Column="2"
                            x:Name="ConfirmButton"
                            Foreground="{DynamicResource BrushPrimary}"
                            FontWeight="SemiBold"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource BrushPrimary}"
                            Padding="16,8"
                            Click="ConfirmButton_Click">
                        <TextBlock x:Name="ConfirmButtonText" Text="{markup:Localize Key=Button_Confirm}"/>
                        <Button.Styles>
                            <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="White"/>
                            </Style>
                            <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource BrushPrimary}"/>
                                <Setter Property="TextBlock.Foreground" Value="White"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
