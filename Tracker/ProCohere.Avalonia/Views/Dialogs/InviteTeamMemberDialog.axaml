<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ProCohere.Avalonia.ViewModels.Dialogs"
        xmlns:models="using:ProCohere.Avalonia.Models"
        xmlns:asyncImageLoader="using:AsyncImageLoader"
        xmlns:markup="clr-namespace:ProCohere.Avalonia.Markup"
        mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="420"
        x:Class="ProCohere.Avalonia.Views.Dialogs.InviteTeamMemberDialog"
        x:DataType="vm:InviteTeamMemberDialogViewModel"
        Title="Invite Team Member"
        Width="440" Height="480"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        SystemDecorations="BorderOnly"
        Background="Transparent">

    <Border Background="{DynamicResource BrushSurface}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1"
            CornerRadius="8"
            ClipToBounds="True">
        <Grid RowDefinitions="Auto,*,Auto">
            <!-- Header (green with icon) -->
            <Border Grid.Row="0" 
                    Background="{DynamicResource BrushPrimary}"
                    Padding="20,16">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <!-- Person add icon -->
                    <Border Width="36" Height="36" CornerRadius="8" 
                            Background="{DynamicResource BrushPrimaryPressed}" 
                            VerticalAlignment="Center">
                        <PathIcon Data="M15,14C12.33,14 7,15.33 7,18V20H23V18C23,15.33 17.67,14 15,14M6,10V7H4V10H1V12H4V15H6V12H9V10M15,12A4,4 0 0,0 19,8A4,4 0 0,0 15,4A4,4 0 0,0 11,8A4,4 0 0,0 15,12Z" 
                                  Width="18" Height="18" Foreground="White"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{markup:Localize Key=Dialog_Invite_Title}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="White" />
                        <TextBlock Text="{markup:Localize Key=Dialog_Invite_Subtitle}"
                                   FontSize="12"
                                   Foreground="#FFFFFFCC"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            
            <!-- Content -->
            <ScrollViewer Grid.Row="1" 
                          VerticalScrollBarVisibility="Auto"
                          Padding="20,16">
                <StackPanel Spacing="16">
                    
                    <!-- Email (Required) -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="{markup:Localize Key=Dialog_Invite_EmailLabel}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}"/>
                        <TextBox Text="{Binding Email}"
                                 Watermark="{markup:Localize Key=Dialog_Invite_EmailPlaceholder}" />
                        <TextBlock Text="{Binding EmailError}"
                                   FontSize="11"
                                   Foreground="{DynamicResource BrushError}"
                                   IsVisible="{Binding EmailError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                    
                    <!-- Job Title -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="{markup:Localize Key=Dialog_Invite_JobTitle}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}"/>
                        <TextBox Text="{Binding JobTitle}"
                                 Watermark="{markup:Localize Key=Dialog_Invite_PositionRole}" />
                    </StackPanel>
                    
                    <!-- Manager -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="{markup:Localize Key=Dialog_Invite_Manager}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}"/>
                        <ComboBox ItemsSource="{Binding AvailableManagers}"
                                  SelectedItem="{Binding SelectedManager}"
                                  HorizontalAlignment="Stretch"
                                  PlaceholderText="{markup:Localize Key=Dialog_Invite_SelectManager}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:TeamMemberDetail">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="24" Height="24" CornerRadius="12" ClipToBounds="True">
                                            <Panel>
                                                <Border Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                        CornerRadius="12"
                                                        IsVisible="{Binding UserAvatarUrl, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                                                    <TextBlock Text="{Binding Initials}"
                                                               FontSize="10"
                                                               Foreground="White"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <Image asyncImageLoader:ImageLoader.Source="{Binding UserAvatarUrl}"
                                                       Stretch="UniformToFill" Width="24" Height="24"
                                                       IsVisible="{Binding UserAvatarUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                            </Panel>
                                        </Border>
                                        <TextBlock Text="{Binding FullName}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    
                    <!-- Personal Message -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="{markup:Localize Key=Dialog_Invite_PersonalMessage}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}"/>
                        <TextBox Text="{Binding PersonalMessage}"
                                 Watermark="{markup:Localize Key=Dialog_Invite_PersonalNote}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="80" />
                    </StackPanel>
                    
                    <!-- Error Message -->
                    <TextBlock Text="{Binding ErrorMessage}"
                               FontSize="12"
                               Foreground="{DynamicResource BrushError}"
                               TextWrapping="Wrap"
                               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    
                </StackPanel>
            </ScrollViewer>
            
            <!-- Footer (blue) -->
            <Border Grid.Row="2"
                    Background="{DynamicResource BrushSecondary}"
                    Padding="20,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Content="{markup:Localize Key=Button_Cancel}"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="1"
                            BorderBrush="White"
                            MinWidth="80"
                            Command="{Binding CancelCommand}">
                        <Button.Styles>
                            <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="TextBlock.Foreground" Value="{DynamicResource BrushSecondary}"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                    <Button Content="{markup:Localize Key=Dialog_Invite_SendInvite}"
                            Foreground="{DynamicResource BrushPrimary}"
                            FontWeight="SemiBold"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource BrushPrimary}"
                            MinWidth="100"
                            Command="{Binding SendInviteCommand}">
                        <Button.Styles>
                            <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="White"/>
                            </Style>
                            <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource BrushPrimary}"/>
                                <Setter Property="TextBlock.Foreground" Value="White"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
