<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ProCohere.Avalonia.ViewModels.Dialogs"
        xmlns:models="using:ProCohere.Avalonia.Models"
        xmlns:asyncImageLoader="using:AsyncImageLoader"
        mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="420"
        x:Class="ProCohere.Avalonia.Views.Dialogs.InviteTeamMemberDialog"
        x:DataType="vm:InviteTeamMemberDialogViewModel"
        Title="Invite Team Member"
        Width="440" Height="420"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        SystemDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        Background="{DynamicResource SystemChromeMediumLowColor}">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header -->
        <Border Grid.Row="0" 
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                Padding="20,16">
            <StackPanel Spacing="4">
                <TextBlock Text="Invite Team Member"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="Send an invitation to join your team"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Border>
        
        <!-- Content -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto"
                      Padding="20,16">
            <StackPanel Spacing="16">
                
                <!-- Email (Required) -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Email Address *" FontSize="12" />
                    <TextBox Text="{Binding Email}"
                             Watermark="colleague@example.com" />
                    <TextBlock Text="{Binding EmailError}"
                               FontSize="11"
                               Foreground="#E74C3C"
                               IsVisible="{Binding EmailError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
                
                <!-- Job Title -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Job Title" FontSize="12" />
                    <TextBox Text="{Binding JobTitle}"
                             Watermark="Position or role" />
                </StackPanel>
                
                <!-- Manager -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Manager" FontSize="12" />
                    <ComboBox ItemsSource="{Binding AvailableManagers}"
                              SelectedItem="{Binding SelectedManager}"
                              HorizontalAlignment="Stretch"
                              PlaceholderText="Select manager (optional)">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:TeamMemberDetail">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="24" Height="24" CornerRadius="12" ClipToBounds="True">
                                        <Panel>
                                            <Border Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                    CornerRadius="12"
                                                    IsVisible="{Binding UserAvatarUrl, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                                                <TextBlock Text="{Binding Initials}"
                                                           FontSize="10"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <Image asyncImageLoader:ImageLoader.Source="{Binding UserAvatarUrl}"
                                                   Stretch="UniformToFill" Width="24" Height="24"
                                                   IsVisible="{Binding UserAvatarUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        </Panel>
                                    </Border>
                                    <TextBlock Text="{Binding FullName}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                
                <!-- Personal Message -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Personal Message (optional)" FontSize="12" />
                    <TextBox Text="{Binding PersonalMessage}"
                             Watermark="Add a personal note to the invitation..."
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="80" />
                </StackPanel>
                
                <!-- Error Message -->
                <TextBlock Text="{Binding ErrorMessage}"
                           FontSize="12"
                           Foreground="#E74C3C"
                           TextWrapping="Wrap"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                
            </StackPanel>
        </ScrollViewer>
        
        <!-- Footer -->
        <Border Grid.Row="2"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                Padding="20,12">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <Button Grid.Column="1"
                        Content="Cancel"
                        MinWidth="80"
                        Margin="0,0,8,0"
                        Command="{Binding CancelCommand}" />
                <Button Grid.Column="2"
                        Content="Send Invite"
                        Classes="accent"
                        MinWidth="100"
                        Command="{Binding SendInviteCommand}" />
            </Grid>
        </Border>
    </Grid>
</Window>
