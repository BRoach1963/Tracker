<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="using:ProCohere.Avalonia.Models"
        xmlns:vm="using:ProCohere.Avalonia.ViewModels.Dialogs"
        xmlns:asyncImageLoader="using:AsyncImageLoader"
        mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="520"
        x:Class="ProCohere.Avalonia.Views.Dialogs.DeferAgendaItemDialog"
        x:DataType="vm:DeferAgendaItemDialogViewModel"
        Title="Defer Agenda Item"
        Width="450"
        Height="520"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        SystemDecorations="BorderOnly"
        Background="Transparent">

    <Border Background="{DynamicResource BrushSurface}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1"
            CornerRadius="8"
            ClipToBounds="True">
        <Grid RowDefinitions="Auto,*,Auto">
            
            <!-- Header (green with icon) -->
            <Border Grid.Row="0" 
                    Background="{DynamicResource BrushPrimary}"
                    Padding="20,16">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <!-- Defer/forward icon -->
                    <Border Width="36" Height="36" CornerRadius="8" 
                            Background="{DynamicResource BrushPrimaryPressed}" 
                            VerticalAlignment="Center">
                        <PathIcon Data="M12.5,8C9.85,8 7.45,9 5.6,10.6L2,7V16H11L7.38,12.38C8.77,11.22 10.54,10.5 12.5,10.5C16.04,10.5 19.05,12.81 20.1,16L22.47,15.22C21.08,11.03 17.15,8 12.5,8Z" 
                                  Width="18" Height="18" Foreground="White"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Defer Agenda Item"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="White" />
                        <TextBlock Text="Carry forward to a future meeting"
                                   FontSize="12"
                                   Foreground="#FFFFFFCC"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            
            <!-- Form Content -->
            <ScrollViewer Grid.Row="1" Padding="20,16">
                <StackPanel Spacing="16">
                    
                    <!-- Header with agenda item context -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Deferring:" FontSize="11" Foreground="{DynamicResource BrushTextTertiary}"/>
                        <TextBlock Text="{Binding AgendaItemTitle}" 
                                   FontSize="14" 
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    
                    <!-- Explanation -->
                    <Border Background="{DynamicResource BrushSurfaceAlt}" 
                            CornerRadius="6" 
                            Padding="12">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="M12.5,8C9.85,8 7.45,9 5.6,10.6L2,7V16H11L7.38,12.38C8.77,11.22 10.54,10.5 12.5,10.5C16.04,10.5 19.05,12.81 20.1,16L22.47,15.22C21.08,11.03 17.15,8 12.5,8Z" 
                                          Width="14" Height="14" Foreground="{DynamicResource BrushPrimary}"/>
                                <TextBlock Text="Carry Forward" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Text="This item will be suggested in the next meeting with the selected person. It will expire after 30 days or 2 meeting opportunities."
                                       FontSize="11" 
                                       Foreground="{DynamicResource BrushTextSecondary}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Anchor Person Selection -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Anchor to Person" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource BrushTextSecondary}"/>
                        <TextBlock Text="This item will appear when you have meetings with this person."
                                   FontSize="11" Foreground="{DynamicResource BrushTextTertiary}"/>
                        <ComboBox ItemsSource="{Binding TeamMembers}"
                                  SelectedItem="{Binding SelectedTeamMember}"
                                  HorizontalAlignment="Stretch"
                                  PlaceholderText="Select team member...">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:TeamMemberDetail">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="24" Height="24" CornerRadius="12" ClipToBounds="True">
                                            <Panel>
                                                <Border Background="{DynamicResource BrushPrimarySoft}"
                                                        CornerRadius="12"
                                                        IsVisible="{Binding UserAvatarUrl, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                                                    <TextBlock Text="{Binding Initials}" 
                                                               FontSize="10" 
                                                               HorizontalAlignment="Center" 
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource BrushPrimary}"/>
                                                </Border>
                                                <Image asyncImageLoader:ImageLoader.Source="{Binding UserAvatarUrl}"
                                                       Stretch="UniformToFill" Width="24" Height="24"
                                                       IsVisible="{Binding UserAvatarUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                            </Panel>
                                        </Border>
                                        <TextBlock Text="{Binding FullName}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    
                    <!-- Custom Expiration (optional) -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Expiration (optional)" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource BrushTextSecondary}"/>
                        <ComboBox HorizontalAlignment="Stretch"
                                  SelectedIndex="{Binding SelectedExpirationIndex}">
                            <ComboBoxItem Content="1 week"/>
                            <ComboBoxItem Content="30 days (default)"/>
                            <ComboBoxItem Content="60 days"/>
                            <ComboBoxItem Content="90 days"/>
                        </ComboBox>
                    </StackPanel>
                    
                    <!-- Optional note -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Note (optional)" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource BrushTextSecondary}"/>
                        <TextBox Text="{Binding Note}"
                                 Watermark="Add context for when this resurfaces..."
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="60"
                                 MaxHeight="80"/>
                    </StackPanel>
                    
                </StackPanel>
            </ScrollViewer>
            
            <!-- Footer (blue) -->
            <Border Grid.Row="2"
                    Background="{DynamicResource BrushSecondary}"
                    Padding="20,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Content="Cancel" 
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="1"
                            BorderBrush="White"
                            Padding="16,8"
                            Command="{Binding CancelCommand}">
                        <Button.Styles>
                            <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="TextBlock.Foreground" Value="{DynamicResource BrushSecondary}"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                    <Button Content="Defer Item" 
                            Foreground="{DynamicResource BrushPrimary}"
                            FontWeight="SemiBold"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource BrushPrimary}"
                            Padding="16,8"
                            Command="{Binding DeferCommand}">
                        <Button.Styles>
                            <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="White"/>
                            </Style>
                            <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource BrushPrimary}"/>
                                <Setter Property="TextBlock.Foreground" Value="White"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
