<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ProCohere.Avalonia.ViewModels.Dialogs"
        xmlns:meeting="using:ProCohere.Avalonia.Views.Controls.Meeting"
        xmlns:markup="clr-namespace:ProCohere.Avalonia.Markup"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="700"
        x:Class="ProCohere.Avalonia.Views.Dialogs.EditMeetingDialog"
        x:DataType="vm:EditMeetingDialogViewModel"
        Title="Meeting"
        Width="800" Height="700"
        MinWidth="700" MinHeight="550"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        ShowInTaskbar="False"
        SystemDecorations="Full"
        Background="{DynamicResource BrushSurface}">
    
    <Window.Styles>
        <!-- Dialog Tab Button Style -->
        <Style Selector="Button.dialog-tab">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style Selector="Button.dialog-tab /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.dialog-tab:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        </Style>
        <Style Selector="Button.dialog-tab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}"/>
        </Style>
        <Style Selector="Button.dialog-tab.selected">
            <Setter Property="Foreground" Value="{DynamicResource BrushSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushSecondary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.dialog-tab.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        
        <!-- Header -->
        <Border Grid.Row="0" 
                Background="{DynamicResource BrushPrimary}"
                Padding="20,16">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Meeting icon -->
                <Border Width="36" Height="36" CornerRadius="8" 
                        Background="{DynamicResource BrushPrimaryPressed}" 
                        Margin="0,0,12,0" VerticalAlignment="Center">
                    <PathIcon Data="M19,19H5V8H19M16,1V3H8V1H6V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3H18V1" 
                              Width="18" Height="18" Foreground="White"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DialogTitle}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="White" />
                    <TextBlock Text="{markup:Localize Key=Dialog_Meeting_Subtitle}"
                               FontSize="12"
                               Foreground="#FFFFFFCC"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Content: Two-column layout -->
        <Grid Grid.Row="1" ColumnDefinitions="280,*">
            
            <!-- LEFT COLUMN: Meeting Details -->
            <meeting:MeetingDetailsPanel x:Name="DetailsPanel" Grid.Column="0" />
            
            <!-- RIGHT COLUMN: Workspace Tabs -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*">
                
                <!-- Tab Header -->
                <Border Grid.Row="0" Background="{DynamicResource BrushSurface}"
                        BorderBrush="{DynamicResource BrushBorder}"
                        BorderThickness="0,0,0,1"
                        Padding="12,0">
                    <StackPanel Orientation="Horizontal" Spacing="0">
                        <Button Classes="dialog-tab"
                                Classes.selected="{Binding IsPrepTabActive}"
                                Command="{Binding SetPrepTabCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="M9,5V9H21V5M9,19H21V15H9M9,14H21V10H9M4,9H8V5H4M4,19H8V15H4M4,14H8V10H4V14Z" 
                                          Width="14" Height="14"/>
                                <TextBlock Text="{markup:Localize Key=Dialog_Meeting_Tab_Prep}"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="dialog-tab"
                                Classes.selected="{Binding IsAgendaTabActive}"
                                Command="{Binding SetAgendaTabCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="M3,5H9V11H3V5M5,7V9H7V7H5M11,7H21V9H11V7M11,15H21V17H11V15M5,20L1.5,16.5L2.91,15.09L5,17.17L9.59,12.59L11,14L5,20Z" 
                                          Width="14" Height="14"/>
                                <TextBlock Text="{markup:Localize Key=Dialog_Meeting_Tab_Agenda}"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="dialog-tab"
                                Classes.selected="{Binding IsNotesTabActive}"
                                Command="{Binding SetNotesTabCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="M14,10H19.5L14,4.5V10M5,3H15L21,9V19A2,2 0 0,1 19,21H5C3.89,21 3,20.1 3,19V5C3,3.89 3.89,3 5,3M5,5V19H19V12H12V5H5Z" 
                                          Width="14" Height="14"/>
                                <TextBlock Text="{markup:Localize Key=Dialog_Meeting_Tab_Notes}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
                
                <!-- Tab Content -->
                <Grid Grid.Row="1">
                    <meeting:PrepItemsPanel IsVisible="{Binding IsPrepTabActive}" />
                    <meeting:AgendaItemsPanel IsVisible="{Binding IsAgendaTabActive}" />
                    <meeting:MeetingNotesPanel IsVisible="{Binding IsNotesTabActive}" />
                </Grid>
            </Grid>
            
        </Grid>
        
        <!-- Footer -->
        <Border Grid.Row="2"
                Background="{DynamicResource BrushSecondary}"
                Padding="20,12">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <Button Grid.Column="0"
                        Content="{markup:Localize Key=Button_Delete}"
                        Background="{DynamicResource BrushError}"
                        Foreground="White"
                        BorderThickness="0"
                        IsVisible="{Binding CanDelete}"
                        Command="{Binding DeleteCommand}" />
                
                <Button Grid.Column="2"
                        Content="{markup:Localize Key=Button_Cancel}"
                        Classes="cancel-btn"
                        Margin="0,0,8,0"
                        Command="{Binding CancelCommand}"/>
                
                <Button Grid.Column="3"
                        Content="{markup:Localize Key=Button_Save}"
                        Classes="accent"
                        Command="{Binding SaveCommand}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
