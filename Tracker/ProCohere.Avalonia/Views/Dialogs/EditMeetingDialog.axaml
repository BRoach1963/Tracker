<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="using:ProCohere.Avalonia.Models"
        xmlns:dialogs="using:ProCohere.Avalonia.Views.Dialogs"
        xmlns:controls="using:ProCohere.Avalonia.Views.Controls"
        xmlns:asyncImageLoader="using:AsyncImageLoader"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="700"
        x:Class="ProCohere.Avalonia.Views.Dialogs.EditMeetingDialog"
        Title="Meeting"
        Width="800" Height="700"
        MinWidth="700" MinHeight="550"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        ShowInTaskbar="False"
        SystemDecorations="Full"
        Background="{DynamicResource BrushSurface}">
    
    <Window.Styles>
        <!-- Dialog Tab Button Style (matching PulseView pattern) -->
        <Style Selector="Button.dialog-tab">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style Selector="Button.dialog-tab /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.dialog-tab:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        </Style>
        <Style Selector="Button.dialog-tab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}"/>
        </Style>
        <Style Selector="Button.dialog-tab.selected">
            <Setter Property="Foreground" Value="{DynamicResource BrushPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.dialog-tab.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        
        <!-- Section Header Style -->
        <Style Selector="TextBlock.section-header">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextTertiary}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        
        <!-- Visibility Indicator Style -->
        <Style Selector="Border.visibility-badge">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header with accent bar -->
        <Border Grid.Row="0" 
                Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="0,0,0,1"
                Padding="20,16">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Meeting icon -->
                <Border Width="36" Height="36" CornerRadius="8" 
                        Background="{DynamicResource BrushPrimary}" 
                        Margin="0,0,12,0" VerticalAlignment="Center">
                    <PathIcon Data="M19,19H5V8H19M16,1V3H8V1H6V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3H18V1" 
                              Width="18" Height="18" Foreground="White"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="DialogTitle"
                               Text="New Meeting"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTextPrimary}" />
                    <TextBlock Text="Schedule and prepare for your meeting"
                               FontSize="12"
                               Foreground="{DynamicResource BrushTextSecondary}"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Content: Two-column layout -->
        <Grid Grid.Row="1" ColumnDefinitions="280,*">
            
            <!-- LEFT COLUMN: Essential Details (always visible) -->
            <Border Grid.Column="0" 
                    Background="{DynamicResource BrushSurfaceAlt}"
                    BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,16">
                    <StackPanel Spacing="14">
                        
                        <TextBlock Text="DETAILS" Classes="section-header"/>
                        
                        <!-- Title -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Title *" FontSize="12" />
                            <TextBox x:Name="TitleTextBox"
                                     Watermark="Meeting title" />
                        </StackPanel>
                        
                        <!-- Meeting Type -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Type" FontSize="12" />
                            <ComboBox x:Name="MeetingTypeComboBox"
                                      HorizontalAlignment="Stretch"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="1:1 Meeting" Tag="one_on_one" />
                                <ComboBoxItem Content="Team Meeting" Tag="team" />
                                <ComboBoxItem Content="Project Review" Tag="project" />
                                <ComboBoxItem Content="Performance Review" Tag="performance" />
                                <ComboBoxItem Content="Other" Tag="other" />
                            </ComboBox>
                        </StackPanel>
                        
                        <!-- Attendee (for 1:1) -->
                        <StackPanel x:Name="AttendeeSection" Spacing="4">
                            <TextBlock Text="With" FontSize="12" />
                            <ComboBox x:Name="AttendeeComboBox"
                                      HorizontalAlignment="Stretch"
                                      PlaceholderText="Select team member">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:TeamMemberDetail">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Width="24" Height="24"
                                                    CornerRadius="12"
                                                    ClipToBounds="True">
                                                <Panel>
                                                    <Border Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                            CornerRadius="12"
                                                            IsVisible="{Binding AvatarUrl, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                                                        <TextBlock Text="{Binding Initials}"
                                                                   FontSize="10"
                                                                   Foreground="White"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                    <Image asyncImageLoader:ImageLoader.Source="{Binding AvatarUrl}"
                                                           Stretch="UniformToFill" Width="24" Height="24"
                                                           IsVisible="{Binding AvatarUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                </Panel>
                                            </Border>
                                            <TextBlock Text="{Binding FullName}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        
                        <!-- Date and Time -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="When *" FontSize="12" />
                            <controls:DateTimeSelector x:Name="DateTimeSelector" />
                        </StackPanel>
                        
                        <!-- Duration -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Duration" FontSize="12" />
                            <ComboBox x:Name="DurationComboBox"
                                      HorizontalAlignment="Stretch"
                                      SelectedIndex="1">
                                <ComboBoxItem Content="15 minutes" Tag="15" />
                                <ComboBoxItem Content="30 minutes" Tag="30" />
                                <ComboBoxItem Content="45 minutes" Tag="45" />
                                <ComboBoxItem Content="1 hour" Tag="60" />
                                <ComboBoxItem Content="1.5 hours" Tag="90" />
                                <ComboBoxItem Content="2 hours" Tag="120" />
                            </ComboBox>
                        </StackPanel>
                        
                        <!-- Location -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Location" FontSize="12" />
                            <TextBox x:Name="LocationTextBox"
                                     Watermark="Room, office, or link" />
                        </StackPanel>
                        
                        <!-- Video Link -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Video Link" FontSize="12" />
                            <TextBox x:Name="VideoLinkTextBox"
                                     Watermark="Zoom, Teams, Meet URL" />
                        </StackPanel>
                        
                    </StackPanel>
                </ScrollViewer>
            </Border>
            
            <!-- RIGHT COLUMN: Workspace Tabs (optional content) -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*">
                
                <!-- Tab Header -->
                <Border Grid.Row="0" Background="{DynamicResource BrushSurface}"
                        BorderBrush="{DynamicResource BrushBorder}"
                        BorderThickness="0,0,0,1"
                        Padding="12,0">
                    <StackPanel Orientation="Horizontal" Spacing="0">
                        <Button x:Name="PrepTabButton" 
                                Classes="dialog-tab"
                                Click="PrepTab_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="M9,5V9H21V5M9,19H21V15H9M9,14H21V10H9M4,9H8V5H4M4,19H8V15H4M4,14H8V10H4V14Z" 
                                          Width="14" Height="14"/>
                                <TextBlock Text="Prep"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="AgendaTabButton"
                                Classes="dialog-tab"
                                Click="AgendaTab_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="M3,5H9V11H3V5M5,7V9H7V7H5M11,7H21V9H11V7M11,15H21V17H11V15M5,20L1.5,16.5L2.91,15.09L5,17.17L9.59,12.59L11,14L5,20Z" 
                                          Width="14" Height="14"/>
                                <TextBlock Text="Agenda"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NotesTabButton"
                                Classes="dialog-tab"
                                Click="NotesTab_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="M14,10H19.5L14,4.5V10M5,3H15L21,9V19A2,2 0 0,1 19,21H5C3.89,21 3,20.1 3,19V5C3,3.89 3.89,3 5,3M5,5V19H19V12H12V5H5Z" 
                                          Width="14" Height="14"/>
                                <TextBlock Text="Notes"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
                
                <!-- Tab Content -->
                <Grid Grid.Row="1">
                    
                    <!-- PREP TAB -->
                    <ScrollViewer x:Name="PrepTabContent" VerticalScrollBarVisibility="Auto" Padding="16">
                        <StackPanel Spacing="12">
                            
                            <!-- Section Header -->
                            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,4,0,8">
                                <StackPanel>
                                    <TextBlock Text="PREP ITEMS" Classes="section-header" Margin="0"/>
                                    <TextBlock Text="Things to prepare before this meeting" FontSize="12"
                                               Foreground="{DynamicResource BrushTextSecondary}"/>
                                </StackPanel>
                                <Button x:Name="AddFromExistingPrepButton" Grid.Column="1" 
                                        Classes="icon-button" Padding="6" Margin="0,0,4,0"
                                        ToolTip.Tip="Add from existing task/goal"
                                        Click="AddFromExistingPrep_Click">
                                    <PathIcon Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4M15,9V12H12V14H15V17H17V14H20V12H17V9H15Z" 
                                              Width="14" Height="14"/>
                                </Button>
                                <Button x:Name="AddPrepButton" Grid.Column="2" 
                                        Classes="icon-button" Padding="6"
                                        ToolTip.Tip="Add new prep item"
                                        Click="AddPrepItem_Click">
                                    <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" 
                                              Width="14" Height="14"/>
                                </Button>
                            </Grid>
                            
                            <!-- Add prep item inline (expanded form with assignment) -->
                            <Border x:Name="AddPrepPanel" 
                                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                    CornerRadius="6" Padding="12" IsVisible="False">
                                <StackPanel Spacing="10">
                                    <TextBox x:Name="NewPrepTitleTextBox" 
                                             Watermark="What needs to be prepared?"
                                             KeyDown="NewPrepTitleTextBox_KeyDown"/>
                                    
                                    <!-- Visibility scope selector -->
                                    <Grid ColumnDefinitions="*,8,*">
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Text="Visibility" FontSize="11" 
                                                       Foreground="{DynamicResource BrushTextSecondary}"/>
                                            <ComboBox x:Name="PrepVisibilityComboBox" 
                                                      HorizontalAlignment="Stretch"
                                                      SelectedIndex="0">
                                                <ComboBoxItem Tag="personal">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <PathIcon Data="M12,17A2,2 0 0,0 14,15C14,13.89 13.1,13 12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10C4,8.89 4.9,8 6,8H7V6A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18M12,3A3,3 0 0,0 9,6V8H15V6A3,3 0 0,0 12,3Z" 
                                                                  Width="14" Height="14" Foreground="{DynamicResource BrushTextSecondary}"/>
                                                        <TextBlock Text="Only me"/>
                                                    </StackPanel>
                                                </ComboBoxItem>
                                                <ComboBoxItem Tag="assigned">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <PathIcon Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z" 
                                                                  Width="14" Height="14" Foreground="{DynamicResource BrushTextSecondary}"/>
                                                        <TextBlock Text="Assigned person"/>
                                                    </StackPanel>
                                                </ComboBoxItem>
                                                <ComboBoxItem Tag="meeting">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <PathIcon Data="M16,13C15.71,13 15.38,13 15.03,13.05C16.19,13.89 17,15 17,16.5V19H23V16.5C23,14.17 18.33,13 16,13M8,13C5.67,13 1,14.17 1,16.5V19H15V16.5C15,14.17 10.33,13 8,13M8,11A3,3 0 0,0 11,8A3,3 0 0,0 8,5A3,3 0 0,0 5,8A3,3 0 0,0 8,11M16,11A3,3 0 0,0 19,8A3,3 0 0,0 16,5A3,3 0 0,0 13,8A3,3 0 0,0 16,11Z" 
                                                                  Width="14" Height="14" Foreground="{DynamicResource BrushTextSecondary}"/>
                                                        <TextBlock Text="All attendees"/>
                                                    </StackPanel>
                                                </ComboBoxItem>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="4" x:Name="PrepAssigneePanel" IsVisible="False">
                                            <TextBlock Text="Assign to" FontSize="11" 
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <ComboBox x:Name="PrepAssigneeComboBox"
                                                      HorizontalAlignment="Stretch"
                                                      PlaceholderText="Select person">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="models:TeamMemberDetail">
                                                        <TextBlock Text="{Binding FullName}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                    
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                        <Button Content="Cancel" Click="CancelAddPrep_Click" />
                                        <Button Content="Add" Classes="accent" Click="ConfirmAddPrep_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            
                            <!-- Prep items list -->
                            <ItemsControl x:Name="PrepItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:MeetingPrepItem">
                                        <Border Background="{DynamicResource BrushSurface}" 
                                                BorderBrush="{DynamicResource BrushBorder}"
                                                BorderThickness="1"
                                                CornerRadius="6" Padding="10" Margin="0,0,0,6">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"
                                                          IsChecked="{Binding IsComplete, Mode=TwoWay}"
                                                          Checked="PrepItem_CheckedChanged"
                                                          Unchecked="PrepItem_CheckedChanged"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="13"
                                                               Foreground="{DynamicResource BrushTextPrimary}"/>
                                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0"
                                                                IsVisible="{Binding HasAssigneeOrScope}">
                                                        <PathIcon Data="{Binding VisibilityIconPath}" Width="12" Height="12"
                                                                  Foreground="{DynamicResource BrushTextTertiary}"/>
                                                        <TextBlock Text="{Binding AssigneeNameDisplay}" FontSize="11"
                                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                                   IsVisible="{Binding HasAssignee}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <!-- Linked item indicator -->
                                                <Border Grid.Column="2" 
                                                        IsVisible="{Binding HasLinkedEntity}"
                                                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                        CornerRadius="3" Padding="4,2" Margin="4,0"
                                                        VerticalAlignment="Center"
                                                        Opacity="0.8">
                                                    <TextBlock Text="{Binding LinkedEntityTypeDisplay}" FontSize="9" Foreground="White"/>
                                                </Border>
                                                <Button Grid.Column="3" Classes="icon-button" Padding="4"
                                                        ToolTip.Tip="Delete"
                                                        Click="DeletePrepItem_Click"
                                                        Tag="{Binding}">
                                                    <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                                              Width="10" Height="10" 
                                                              Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            
                            <!-- Empty state -->
                            <Border x:Name="PrepEmptyState"
                                    Background="{DynamicResource BrushSurface}" 
                                    BorderBrush="{DynamicResource BrushBorder}"
                                    BorderThickness="1" CornerRadius="8" 
                                    Padding="32" IsVisible="True">
                                <StackPanel HorizontalAlignment="Center" Spacing="8">
                                    <Border Width="48" Height="48" CornerRadius="24" 
                                            Background="{DynamicResource BrushSurfaceAlt}">
                                        <PathIcon Data="M9,5V9H21V5M9,19H21V15H9M9,14H21V10H9M4,9H8V5H4M4,19H8V15H4M4,14H8V10H4V14Z"
                                                  Width="24" Height="24" 
                                                  Foreground="{DynamicResource BrushTextTertiary}"/>
                                    </Border>
                                    <TextBlock Text="No prep items yet" FontSize="14" FontWeight="Medium"
                                               Foreground="{DynamicResource BrushTextSecondary}" 
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Add things to prepare before this meeting" FontSize="12"
                                               Foreground="{DynamicResource BrushTextTertiary}"
                                               HorizontalAlignment="Center" TextWrapping="Wrap"
                                               TextAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            
                        </StackPanel>
                    </ScrollViewer>
                    
                    <!-- AGENDA TAB -->
                    <ScrollViewer x:Name="AgendaTabContent" VerticalScrollBarVisibility="Auto" Padding="16" IsVisible="False">
                        <StackPanel Spacing="12">
                            
                            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,4,0,8">
                                <StackPanel>
                                    <TextBlock Text="AGENDA" Classes="section-header" Margin="0"/>
                                    <TextBlock Text="Topics to cover in this meeting" FontSize="12"
                                               Foreground="{DynamicResource BrushTextSecondary}"/>
                                </StackPanel>
                                <Button x:Name="LinkExistingAgendaButton" Grid.Column="1"
                                        Classes="icon-button" Padding="6" Margin="0,0,4,0"
                                        ToolTip.Tip="Link to existing task, goal, or metric"
                                        Click="LinkExistingAgendaItem_Click">
                                    <PathIcon Data="M10.59,13.41C11,13.8 11,14.44 10.59,14.83C10.2,15.22 9.56,15.22 9.17,14.83C6.22,11.88 6.22,7.1 9.17,4.15C12.12,1.2 16.9,1.2 19.85,4.15C22.8,7.1 22.8,11.88 19.85,14.83L18.44,13.41C20.6,11.25 20.6,7.73 18.44,5.56C16.28,3.4 12.76,3.4 10.59,5.56C8.43,7.73 8.43,11.25 10.59,13.41M13.41,9.17C13.8,8.78 14.44,8.78 14.83,9.17C17.78,12.12 17.78,16.9 14.83,19.85C11.88,22.8 7.1,22.8 4.15,19.85C1.2,16.9 1.2,12.12 4.15,9.17L5.56,10.59C3.4,12.75 3.4,16.27 5.56,18.44C7.73,20.6 11.25,20.6 13.41,18.44C15.58,16.27 15.58,12.75 13.41,10.59C13,10.2 13,9.56 13.41,9.17Z" 
                                              Width="14" Height="14"/>
                                </Button>
                                <Button x:Name="AddAgendaButton" Grid.Column="2"
                                        Classes="icon-button" Padding="6"
                                        ToolTip.Tip="Add new agenda item"
                                        Click="AddAgendaItem_Click">
                                    <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" 
                                              Width="14" Height="14"/>
                                </Button>
                            </Grid>
                            
                            <!-- Add agenda inline -->
                            <Border x:Name="AddAgendaPanel"
                                    Background="{DynamicResource BrushSurface}"
                                    BorderBrush="{DynamicResource BrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="6" Padding="12" IsVisible="False">
                                <StackPanel Spacing="8">
                                    <TextBox x:Name="NewAgendaTitleTextBox" 
                                             Watermark="Agenda item title"
                                             KeyDown="NewAgendaTitleTextBox_KeyDown"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                        <Button Content="Cancel" Click="CancelAddAgenda_Click" />
                                        <Button Content="Add" Classes="accent" Click="ConfirmAddAgenda_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            
                            <!-- Agenda items list -->
                            <ItemsControl x:Name="AgendaItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="dialogs:DialogAgendaItem">
                                        <Border Background="{DynamicResource BrushSurface}" 
                                                BorderBrush="{DynamicResource BrushBorder}"
                                                BorderThickness="1"
                                                CornerRadius="6" Padding="10" Margin="0,0,0,6">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                <!-- Type indicator (icon or bullet) -->
                                                <Border Grid.Column="0" 
                                                        Width="24" Height="24"
                                                        CornerRadius="6"
                                                        Background="{Binding TypeColor}"
                                                        Margin="0,0,10,0"
                                                        VerticalAlignment="Center"
                                                        IsVisible="{Binding HasLinkedEntity}">
                                                    <PathIcon Data="{Binding TypeIcon}" Width="12" Height="12" Foreground="White"/>
                                                </Border>
                                                <Border Grid.Column="0" 
                                                        Width="24" Height="24"
                                                        CornerRadius="6"
                                                        Background="{DynamicResource BrushSurfaceAlt}"
                                                        Margin="0,0,10,0"
                                                        VerticalAlignment="Center"
                                                        IsVisible="{Binding !HasLinkedEntity}">
                                                    <PathIcon Data="M3,5H9V11H3V5M5,7V9H7V7H5M11,7H21V9H11V7M11,15H21V17H11V15M5,20L1.5,16.5L2.91,15.09L5,17.17L9.59,12.59L11,14L5,20Z"
                                                              Width="12" Height="12" Foreground="{DynamicResource BrushTextTertiary}"/>
                                                </Border>
                                                           
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="13"
                                                               Foreground="{DynamicResource BrushTextPrimary}"/>
                                                    <TextBlock Text="{Binding LinkedEntityTitle}" FontSize="11"
                                                               Foreground="{DynamicResource BrushTextSecondary}"
                                                               IsVisible="{Binding HasLinkedEntity}"/>
                                                </StackPanel>
                                                
                                                <!-- Linked type badge -->
                                                <Border Grid.Column="2"
                                                        Background="{DynamicResource BrushSurfaceAlt}"
                                                        CornerRadius="4" Padding="8,4" Margin="8,0"
                                                        VerticalAlignment="Center"
                                                        IsVisible="{Binding HasLinkedEntity}">
                                                    <TextBlock Text="{Binding LinkedEntityTypeDisplay}" FontSize="10"
                                                               Foreground="{DynamicResource BrushTextSecondary}"/>
                                                </Border>
                                                
                                                <Button Grid.Column="3" Classes="icon-button" Padding="4"
                                                        ToolTip.Tip="Delete"
                                                        Click="DeleteAgendaItem_Click"
                                                        Tag="{Binding}">
                                                    <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                                              Width="10" Height="10" 
                                                              Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            
                            <!-- Empty state -->
                            <Border x:Name="AgendaEmptyState"
                                    Background="{DynamicResource BrushSurface}" 
                                    BorderBrush="{DynamicResource BrushBorder}"
                                    BorderThickness="1" CornerRadius="8"
                                    Padding="32" IsVisible="True">
                                <StackPanel HorizontalAlignment="Center" Spacing="8">
                                    <Border Width="48" Height="48" CornerRadius="24" 
                                            Background="{DynamicResource BrushSurfaceAlt}">
                                        <PathIcon Data="M3,5H9V11H3V5M5,7V9H7V7H5M11,7H21V9H11V7M11,15H21V17H11V15M5,20L1.5,16.5L2.91,15.09L5,17.17L9.59,12.59L11,14L5,20Z"
                                                  Width="24" Height="24" 
                                                  Foreground="{DynamicResource BrushTextTertiary}"/>
                                    </Border>
                                    <TextBlock Text="No agenda items yet" FontSize="14" FontWeight="Medium"
                                               Foreground="{DynamicResource BrushTextSecondary}" 
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Add topics or link to existing tasks, goals, or metrics" FontSize="12"
                                               Foreground="{DynamicResource BrushTextTertiary}"
                                               HorizontalAlignment="Center" TextWrapping="Wrap"
                                               TextAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            
                        </StackPanel>
                    </ScrollViewer>
                    
                    <!-- NOTES TAB -->
                    <Grid x:Name="NotesTabContent" IsVisible="False" Margin="16">
                        <Grid RowDefinitions="Auto,*">
                            <StackPanel Grid.Row="0" Margin="0,4,0,12">
                                <TextBlock Text="MEETING NOTES" Classes="section-header" Margin="0,0,0,4"/>
                                <TextBlock Text="Private notes for this meeting" FontSize="12"
                                           Foreground="{DynamicResource BrushTextSecondary}"/>
                            </StackPanel>
                            <Border Grid.Row="1" Background="{DynamicResource BrushSurface}"
                                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                                    CornerRadius="6" Padding="0">
                                <TextBox x:Name="MeetingNotesTextBox"
                                         Watermark="Add your notes here..."
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         BorderThickness="0"
                                         VerticalContentAlignment="Top"/>
                            </Border>
                        </Grid>
                    </Grid>
                    
                </Grid>
            </Grid>
            
        </Grid>
        
        <!-- Footer -->
        <Border Grid.Row="2"
                Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <Button x:Name="DeleteButton"
                        Grid.Column="0"
                        Content="Delete"
                        Classes="danger"
                        IsVisible="False"
                        Click="DeleteButton_Click" />
                <Button Grid.Column="2"
                        Content="Cancel"
                        MinWidth="80"
                        Margin="0,0,8,0"
                        Click="CancelButton_Click" />
                <Button Grid.Column="3"
                        x:Name="SaveButton"
                        Content="Save"
                        Classes="accent"
                        MinWidth="100"
                        Click="SaveButton_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
