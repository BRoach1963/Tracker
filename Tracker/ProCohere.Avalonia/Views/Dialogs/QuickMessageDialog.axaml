<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ProCohere.Avalonia.ViewModels.Dialogs"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="480"
        x:Class="ProCohere.Avalonia.Views.Dialogs.QuickMessageDialog"
        x:DataType="vm:QuickMessageDialogViewModel"
        Title="Quick Message"
        Width="520" Height="480"
        MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ExtendClientAreaToDecorationsHint="False">

    <Grid RowDefinitions="Auto,*,Auto">
        
        <!-- Header -->
        <Border Grid.Row="0" Background="#3B82F6" Padding="20,16">
            <Grid ColumnDefinitions="Auto,*">
                <!-- Message Icon -->
                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="#60A5FA" 
                        VerticalAlignment="Center" Margin="0,0,12,0">
                    <PathIcon Data="M20,2H4A2,2 0 0,0 2,4V22L6,18H20A2,2 0 0,0 22,16V4C22,2.89 21.1,2 20,2M6,9H18V11H6M14,14H6V12H14M18,8H6V6H18" 
                              Width="18" Height="18" Foreground="White"/>
                </Border>
                
                <!-- Title -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Quick Message" FontSize="16" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="{Binding RecipientName}" FontSize="13" Foreground="#BFDBFE" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,16,20,12" Spacing="16">
                
                <!-- Provider Indicator -->
                <Border Background="{DynamicResource BrushSurfaceAlt}" CornerRadius="6" Padding="12,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="M13,14C9.64,14 8.54,15.35 8.18,16.24C9.25,16.7 10,17.76 10,19A3,3 0 0,1 7,22A3,3 0 0,1 4,19C4,17.69 4.83,16.58 6,16.17V7.83C4.83,7.42 4,6.31 4,5A3,3 0 0,1 7,2A3,3 0 0,1 10,5C10,6.31 9.17,7.42 8,7.83V13.12C8.88,12.47 10.16,12 12,12C14.67,12 15.56,10.66 15.85,9.77C14.77,9.32 14,8.25 14,7A3,3 0 0,1 17,4A3,3 0 0,1 20,7C20,8.34 19.12,9.5 17.91,9.86C17.65,11.29 16.68,14 13,14M7,18A1,1 0 0,0 6,19A1,1 0 0,0 7,20A1,1 0 0,0 8,19A1,1 0 0,0 7,18M7,4A1,1 0 0,0 6,5A1,1 0 0,0 7,6A1,1 0 0,0 8,5A1,1 0 0,0 7,4M17,6A1,1 0 0,0 16,7A1,1 0 0,0 17,8A1,1 0 0,0 18,7A1,1 0 0,0 17,6Z"
                                  Width="16" Height="16" Foreground="{DynamicResource BrushPrimary}"/>
                        <TextBlock Text="{Binding ProviderDisplayText}" FontSize="12" FontWeight="Medium"
                                   Foreground="{DynamicResource BrushTextSecondary}"/>
                    </StackPanel>
                </Border>

                <!-- Message Input -->
                <StackPanel Spacing="8">
                    <TextBlock Text="MESSAGE" FontSize="10" FontWeight="SemiBold" 
                               Foreground="{DynamicResource BrushTextTertiary}"/>
                    <TextBox Text="{Binding Message}" 
                             AcceptsReturn="True" 
                             TextWrapping="Wrap"
                             Watermark="Type your message..."
                             Height="180"
                             VerticalContentAlignment="Top"
                             Padding="12,10"
                             IsEnabled="{Binding !IsSending}"/>
                    
                    <!-- Character Counter -->
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock FontSize="11" Foreground="{DynamicResource BrushTextTertiary}">
                            <Run Text="{Binding MessageCharacterCount}"/>
                            <Run Text="/ 500 characters"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <!-- Error Display -->
                <Border Background="{DynamicResource BrushError}" CornerRadius="4" Padding="12,8"
                        IsVisible="{Binding HasError}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="M13,13H11V7H13M13,17H11V15H13M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z"
                                  Width="16" Height="16" Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="White" 
                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Sending Indicator -->
                <Border Background="{DynamicResource BrushSurfaceAlt}" CornerRadius="4" Padding="12,8"
                        IsVisible="{Binding IsSending}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Width="16" Height="16" VerticalAlignment="Center">
                            <Border.RenderTransform>
                                <RotateTransform/>
                            </Border.RenderTransform>
                            <Border.Styles>
                                <Style Selector="Border">
                                    <Style.Animations>
                                        <Animation Duration="0:0:1" IterationCount="INFINITE">
                                            <KeyFrame Cue="0%">
                                                <Setter Property="RenderTransform" Value="rotate(0deg)"/>
                                            </KeyFrame>
                                            <KeyFrame Cue="100%">
                                                <Setter Property="RenderTransform" Value="rotate(360deg)"/>
                                            </KeyFrame>
                                        </Animation>
                                    </Style.Animations>
                                </Style>
                            </Border.Styles>
                            <PathIcon Data="M12,4V2A10,10 0 0,0 2,12H4A8,8 0 0,1 12,4Z" 
                                      Width="16" Height="16" Foreground="{DynamicResource BrushPrimary}"/>
                        </Border>
                        <TextBlock Text="Sending message..." FontSize="12" 
                                   Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Actions -->
        <Border Grid.Row="2" Background="{DynamicResource BrushSurfaceAlt}" 
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BrushBorder}"
                Padding="20,12">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="Cancel" 
                            Command="{Binding CancelCommand}"
                            Classes="secondary-button"
                            Width="100"
                            IsEnabled="{Binding !IsSending}"/>
                    <Button Content="Send" 
                            Command="{Binding SendCommand}"
                            Classes="primary-button"
                            Width="100"
                            IsEnabled="{Binding CanSend}"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
