<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ProCohere.Avalonia.ViewModels.Dialogs"
        xmlns:models="using:ProCohere.Avalonia.Models"
        xmlns:markup="clr-namespace:ProCohere.Avalonia.Markup"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="620"
        x:Class="ProCohere.Avalonia.Views.Dialogs.AddFeedbackDialog"
        x:DataType="vm:AddFeedbackDialogViewModel"
        Title="Give Feedback"
        Width="520" Height="620"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        SystemDecorations="BorderOnly"
        Background="Transparent">
    
    <Border Background="{DynamicResource BrushSurface}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1"
            CornerRadius="8"
            ClipToBounds="True">
        <Grid RowDefinitions="Auto,*,Auto">
            <!-- Header (green with icon) -->
            <Border Grid.Row="0" Background="{DynamicResource BrushPrimary}" Padding="20,16">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <!-- Comment/feedback icon -->
                    <Border Width="36" Height="36" CornerRadius="8" 
                            Background="{DynamicResource BrushPrimaryPressed}" 
                            VerticalAlignment="Center">
                        <PathIcon Data="M9,22A1,1 0 0,1 8,21V18H4A2,2 0 0,1 2,16V4C2,2.89 2.9,2 4,2H20A2,2 0 0,1 22,4V16A2,2 0 0,1 20,18H13.9L10.2,21.71C10,21.9 9.75,22 9.5,22H9M4,4V16H9V19.08L13.08,15H20V4H4Z" 
                                  Width="18" Height="18" Foreground="White"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{markup:Localize Key=Dialog_Feedback_GiveFeedback}" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="{Binding RecipientDisplayName, StringFormat='For {0}'}" FontSize="12" Foreground="#FFFFFFCC"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        
        <!-- Content -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto"
                      Padding="20,16">
            <StackPanel Spacing="16">
                
                <!-- Team Member Selector (shown when no pre-selected recipient) -->
                <StackPanel Spacing="4" IsVisible="{Binding ShowRecipientSelector}">
                    <TextBlock Text="{markup:Localize Key=Dialog_Feedback_GiveFeedbackTo}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}"/>
                    <ComboBox ItemsSource="{Binding AvailableTeamMembers}"
                              SelectedItem="{Binding SelectedTeamMember}"
                              HorizontalAlignment="Stretch"
                              PlaceholderText="{markup:Localize Key=Dialog_Feedback_SelectTeamMember}"
                              IsEnabled="{Binding !IsLoadingTeamMembers}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:TeamMemberDetail">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding FullName}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding JobTitle, StringFormat='({0})'}" 
                                               FontSize="11" 
                                               Foreground="{DynamicResource BrushTextSecondary}"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding JobTitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <!-- Loading indicator -->
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsLoadingTeamMembers}">
                        <TextBlock Text="{markup:Localize Key=Dialog_Feedback_LoadingTeamMembers}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                    </StackPanel>
                </StackPanel>
                
                <!-- Feedback Type -->
                <StackPanel Spacing="4">
                    <TextBlock Text="{markup:Localize Key=Label_Type}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}"/>
                    <ComboBox SelectedIndex="{Binding FeedbackTypeIndex}"
                              HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="{markup:Localize Key=FeedbackType_General}" Tag="general" />
                        <ComboBoxItem Content="{markup:Localize Key=FeedbackType_Praise}" Tag="praise" />
                        <ComboBoxItem Content="{markup:Localize Key=FeedbackType_Constructive}" Tag="constructive" />
                        <ComboBoxItem Content="{markup:Localize Key=FeedbackType_Coaching}" Tag="coaching" />
                        <ComboBoxItem Content="{markup:Localize Key=FeedbackType_Recognition}" Tag="recognition" />
                    </ComboBox>
                </StackPanel>
                
                <!-- Title (Optional) -->
                <StackPanel Spacing="4">
                    <TextBlock Text="{markup:Localize Key=Dialog_Feedback_TitleOptional}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}"/>
                    <TextBox Text="{Binding Title}"
                             Watermark="{markup:Localize Key=Dialog_Feedback_BriefSummary}" />
                </StackPanel>
                
                <!-- Content -->
                <StackPanel Spacing="4">
                    <TextBlock Text="{markup:Localize Key=Dialog_Feedback_FeedbackLabel}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}"/>
                    <TextBox Text="{Binding Content}"
                             Watermark="{markup:Localize Key=Dialog_Feedback_ShareFeedback}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="150" />
                </StackPanel>
                
                <!-- Rating (Optional) -->
                <StackPanel Spacing="4">
                    <TextBlock Text="{markup:Localize Key=Dialog_Feedback_RatingOptional}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}"/>
                    <ComboBox SelectedIndex="{Binding Rating}"
                              HorizontalAlignment="Stretch"
                              PlaceholderText="{markup:Localize Key=Dialog_Feedback_NoRating}">
                        <ComboBoxItem Content="{markup:Localize Key=Rating_1_NeedsImprovement}" />
                        <ComboBoxItem Content="{markup:Localize Key=Rating_2_BelowExpectations}" />
                        <ComboBoxItem Content="{markup:Localize Key=Rating_3_MeetsExpectations}" />
                        <ComboBoxItem Content="{markup:Localize Key=Rating_4_ExceedsExpectations}" />
                        <ComboBoxItem Content="{markup:Localize Key=Rating_5_Outstanding}" />
                    </ComboBox>
                </StackPanel>
                
                <!-- Visibility -->
                <StackPanel Spacing="4">
                    <TextBlock Text="{markup:Localize Key=Label_Visibility}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}"/>
                    <ComboBox SelectedIndex="{Binding VisibilityIndex}"
                              HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="{markup:Localize Key=Dialog_Feedback_PrivateManager}" Tag="private" />
                        <ComboBoxItem Content="{markup:Localize Key=Dialog_Feedback_SharedRecipient}" Tag="shared" />
                    </ComboBox>
                </StackPanel>
                
                <!-- Anonymous Option -->
                <StackPanel Spacing="4">
                    <CheckBox IsChecked="{Binding IsAnonymous}"
                              Content="{markup:Localize Key=Dialog_Feedback_GiveAnonymously}" />
                    <TextBlock Text="{markup:Localize Key=Dialog_Feedback_AnonymousNote}"
                               FontSize="11"
                               Foreground="{DynamicResource BrushTextSecondary}"
                               Margin="28,0,0,0" />
                </StackPanel>
                
            </StackPanel>
        </ScrollViewer>
        
            <!-- Footer (blue) -->
            <Border Grid.Row="2" Background="{DynamicResource BrushSecondary}" Padding="20,12">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <Button Grid.Column="1"
                            Content="{markup:Localize Key=Button_Cancel}"
                            Background="Transparent"
                            Foreground="White"
                            BorderBrush="White"
                            BorderThickness="1"
                            MinWidth="80"
                            Margin="0,0,8,0"
                            Command="{Binding CancelCommand}">
                        <Button.Styles>
                            <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="TextBlock.Foreground" Value="{DynamicResource BrushSecondary}"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                    <Button Grid.Column="2"
                            Content="{markup:Localize Key=Dialog_Feedback_GiveFeedback}"
                            Foreground="{DynamicResource BrushPrimary}"
                            FontWeight="SemiBold"
                            BorderBrush="{DynamicResource BrushPrimary}"
                            BorderThickness="1"
                            MinWidth="120"
                            Command="{Binding SaveCommand}">
                        <Button.Styles>
                            <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="White"/>
                            </Style>
                            <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource BrushPrimary}"/>
                                <Setter Property="TextBlock.Foreground" Value="White"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
