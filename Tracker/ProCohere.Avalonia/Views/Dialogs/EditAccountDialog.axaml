<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ProCohere.Avalonia.ViewModels.Dialogs"
        xmlns:models="using:ProCohere.Avalonia.Models.Dialogs"
        mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="640"
        x:Class="ProCohere.Avalonia.Views.Dialogs.EditAccountDialog"
        x:DataType="vm:EditAccountDialogViewModel"
        Title="Edit Profile"
        Width="480" 
        MinWidth="400"
        MinHeight="500"
        SizeToContent="Height"
        MaxHeight="750"
        WindowStartupLocation="CenterScreen"
        CanResize="True"
        ShowInTaskbar="True"
        SystemDecorations="BorderOnly"
        Background="Transparent">

    <Window.Styles>
        <!-- Section Header Style -->
        <Style Selector="TextBlock.section-header">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Margin" Value="0,16,0,8"/>
        </Style>
        
        <!-- Field Label Style -->
        <Style Selector="TextBlock.field-label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        
        <!-- TextBox Style -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="#3C6248"/>
        </Style>
        <Style Selector="TextBox:disabled">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
        </Style>
        
        <!-- Primary Button -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#3C6248"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2D4A36"/>
        </Style>
        <Style Selector="Button.primary:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="#94A3B8"/>
        </Style>
        
        <!-- Secondary Button -->
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#F8FAFC"/>
        </Style>
        
        <!-- Small Button -->
        <Style Selector="Button.small">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.small:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#F1F5F9"/>
        </Style>
    </Window.Styles>
    
    <Border Background="{DynamicResource BrushSurface}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1"
            CornerRadius="8"
            ClipToBounds="True">
        <Grid RowDefinitions="Auto,*,Auto">
        
            <!-- Header (green with icon) -->
            <Border Grid.Row="0" Background="{DynamicResource BrushPrimary}" Padding="20,16"
                    PointerPressed="Header_PointerPressed">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- Person icon -->
                    <Border Width="36" Height="36" CornerRadius="8" 
                            Background="{DynamicResource BrushPrimaryPressed}" 
                            Margin="0,0,12,0" VerticalAlignment="Center">
                        <PathIcon Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z" 
                                  Width="18" Height="18" Foreground="White"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Edit Profile"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="White" />
                        <TextBlock Text="Update your personal information"
                                   FontSize="12"
                                   Foreground="#FFFFFFCC" />
                    </StackPanel>
                    <Button Grid.Column="2"
                            Content="✕"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            Padding="8,4"
                            FontSize="16"
                            Command="{Binding CancelCommand}"
                            ToolTip.Tip="Close" />
                </Grid>
            </Border>
        
        <!-- Content -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,8,20,20" Spacing="4">
                
                <!-- Avatar Section -->
                <Border Background="White"
                        CornerRadius="8"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        Padding="16"
                        Margin="0,8,0,0">
                    <Grid ColumnDefinitions="Auto,*">
                        <!-- Avatar Display -->
                        <Border Grid.Column="0"
                                Width="72" Height="72"
                                CornerRadius="36"
                                ClipToBounds="True"
                                Background="#3C6248">
                            <Panel>
                                <Image x:Name="AvatarImage"
                                       Source="{Binding AvatarImage}"
                                       Width="72" Height="72"
                                       Stretch="UniformToFill" />
                                <TextBlock x:Name="AvatarInitials"
                                           Text="{Binding Initials}"
                                           IsVisible="{Binding ShowInitials}"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Panel>
                        </Border>
                        
                        <!-- Avatar Actions -->
                        <StackPanel Grid.Column="1" 
                                    VerticalAlignment="Center"
                                    Margin="16,0,0,0"
                                    Spacing="6">
                            <TextBlock Text="Profile Photo"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Foreground="#1E293B" />
                            <TextBlock Text="JPG, PNG, GIF or WebP. Max 5MB."
                                       FontSize="11"
                                       Foreground="#94A3B8" />
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                                <Button x:Name="UploadAvatarButton"
                                        Content="Upload"
                                        Classes="small"
                                        Command="{Binding UploadAvatarCommand}" />
                                <Button x:Name="RemoveAvatarButton"
                                        Content="Remove"
                                        Classes="small"
                                        Command="{Binding RemoveAvatarCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
                
                <!-- Personal Information -->
                <TextBlock Text="PERSONAL INFORMATION" Classes="section-header" />
                
                <Border Background="White"
                        CornerRadius="8"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        Padding="16">
                    <StackPanel Spacing="12">
                        <!-- Name Row -->
                        <Grid ColumnDefinitions="*,12,*">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="First Name" Classes="field-label" />
                                <TextBox Text="{Binding FirstName}" Watermark="First name" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Last Name" Classes="field-label" />
                                <TextBox Text="{Binding LastName}" Watermark="Last name" />
                            </StackPanel>
                        </Grid>
                        
                        <!-- Display Name -->
                        <StackPanel>
                            <TextBlock Text="Display Name" Classes="field-label" />
                            <TextBox Text="{Binding DisplayName}" Watermark="How you want to appear" />
                        </StackPanel>
                        
                        <!-- Email (Read-only) -->
                        <StackPanel>
                            <TextBlock Text="Email" Classes="field-label" />
                            <TextBox Text="{Binding Email}" IsReadOnly="True" IsEnabled="False" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                
                <!-- Work Information -->
                <TextBlock Text="WORK INFORMATION" Classes="section-header" />
                
                <Border Background="White"
                        CornerRadius="8"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        Padding="16">
                    <StackPanel Spacing="12">
                        <StackPanel>
                            <TextBlock Text="Job Title" Classes="field-label" />
                            <TextBox Text="{Binding JobTitle}" Watermark="e.g., Engineering Manager" />
                        </StackPanel>
                        
                        <StackPanel>
                            <TextBlock Text="Company" Classes="field-label" />
                            <TextBox Text="{Binding Company}" Watermark="Your company name" />
                        </StackPanel>
                        
                        <StackPanel>
                            <TextBlock Text="Phone" Classes="field-label" />
                            <TextBox Text="{Binding Phone}" Watermark="+1 (555) 123-4567" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                
                <!-- Dates & Location -->
                <TextBlock Text="DATES &amp; LOCATION" Classes="section-header" />
                
                <Border Background="White"
                        CornerRadius="8"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        Padding="16">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,12,*">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Birthday" Classes="field-label" />
                                <CalendarDatePicker x:Name="BirthdayPicker" 
                                                    SelectedDate="{Binding Birthday}"
                                                    HorizontalAlignment="Stretch"
                                                    Watermark="Select date"
                                                    IsTodayHighlighted="True" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Hire Date" Classes="field-label" />
                                <CalendarDatePicker x:Name="HireDatePicker" 
                                                    SelectedDate="{Binding HireDate}"
                                                    HorizontalAlignment="Stretch"
                                                    Watermark="Select date"
                                                    IsTodayHighlighted="True" />
                            </StackPanel>
                        </Grid>
                        
                        <StackPanel>
                            <TextBlock Text="Timezone" Classes="field-label" />
                            <ComboBox x:Name="TimezoneComboBox" 
                                      ItemsSource="{Binding Timezones}"
                                      SelectedItem="{Binding SelectedTimezone}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:TimezoneItem">
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Border>
                
            </StackPanel>
        </ScrollViewer>
        
            <!-- Footer (blue) -->
            <Border Grid.Row="2" Background="{DynamicResource BrushSecondary}" Padding="20,12">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <!-- Status message -->
                    <TextBlock Text="{Binding StatusText}"
                               Grid.Column="0"
                               FontSize="12"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="220">
                        <TextBlock.Styles>
                            <Style Selector="TextBlock">
                                <Setter Property="Foreground" Value="{Binding StatusColor}" />
                            </Style>
                        </TextBlock.Styles>
                    </TextBlock>
                    
                    <Button Grid.Column="1"
                            Content="Cancel"
                            Background="Transparent"
                            Foreground="White"
                            BorderBrush="White"
                            BorderThickness="1"
                            MinWidth="80"
                            Margin="0,0,8,0"
                            Command="{Binding CancelCommand}">
                        <Button.Styles>
                            <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="TextBlock.Foreground" Value="{DynamicResource BrushSecondary}"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                    <Button Grid.Column="2"
                            x:Name="SaveButton"
                            Content="Save Changes"
                            Foreground="{DynamicResource BrushPrimary}"
                            FontWeight="SemiBold"
                            BorderBrush="{DynamicResource BrushPrimary}"
                            BorderThickness="1"
                            MinWidth="120"
                            Command="{Binding SaveCommand}"
                            IsEnabled="{Binding !IsSaving}">
                        <Button.Styles>
                            <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="White"/>
                            </Style>
                            <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource BrushPrimary}"/>
                                <Setter Property="TextBlock.Foreground" Value="White"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
