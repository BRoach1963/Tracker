<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="using:ProCohere.Avalonia.Models"
        xmlns:vm="using:ProCohere.Avalonia.ViewModels.Dialogs"
        xmlns:asyncImageLoader="using:AsyncImageLoader"
        xmlns:markup="clr-namespace:ProCohere.Avalonia.Markup"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="600"
        x:Class="ProCohere.Avalonia.Views.Dialogs.AddGoalDialog"
        x:DataType="vm:AddGoalDialogViewModel"
        Title="New Goal"
        Width="520" Height="600"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        SystemDecorations="BorderOnly"
        Background="Transparent">

    <Border Background="{DynamicResource BrushSurface}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1"
            CornerRadius="8"
            ClipToBounds="True">
        <Grid RowDefinitions="Auto,*,Auto">
            <!-- Header (green with icon) -->
            <Border Grid.Row="0" 
                    Background="{DynamicResource BrushPrimary}"
                    Padding="20,16">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <!-- Goal/target icon -->
                    <Border Width="36" Height="36" CornerRadius="8" 
                            Background="{DynamicResource BrushPrimaryPressed}" 
                            VerticalAlignment="Center">
                        <PathIcon Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12,6A6,6 0 0,0 6,12A6,6 0 0,0 12,18A6,6 0 0,0 18,12A6,6 0 0,0 12,6M12,8A4,4 0 0,1 16,12A4,4 0 0,1 12,16A4,4 0 0,1 8,12A4,4 0 0,1 12,8M12,10A2,2 0 0,0 10,12A2,2 0 0,0 12,14A2,2 0 0,0 14,12A2,2 0 0,0 12,10Z" 
                                  Width="18" Height="18" Foreground="White"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{markup:Localize Key=Dialog_Goal_NewGoal}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="White" />
                        <TextBlock Text="{markup:Localize Key=Dialog_Goal_Subtitle}"
                                   FontSize="12"
                                   Foreground="#FFFFFFCC"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            
            <!-- Content -->
            <ScrollViewer Grid.Row="1" 
                          VerticalScrollBarVisibility="Auto"
                          Padding="20,16">
                <StackPanel Spacing="16">
                    
                    <!-- Title -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="{markup:Localize Key=Dialog_Task_TitleLabel}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}"/>
                        <TextBox Text="{Binding Title}"
                                 Watermark="{markup:Localize Key=Dialog_Goal_TitlePlaceholder}" />
                    </StackPanel>
                    
                    <!-- Description -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="{markup:Localize Key=Label_Description}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}"/>
                        <TextBox Text="{Binding Description}"
                                 Watermark="{markup:Localize Key=Dialog_Goal_DescriptionPlaceholder}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="80" />
                    </StackPanel>
                    
                    <!-- Goal Type -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="{markup:Localize Key=Dialog_Goal_GoalType}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}"/>
                        <ComboBox SelectedIndex="{Binding GoalTypeIndex}"
                                  HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="{markup:Localize Key=GoalType_Growth}" Tag="growth" />
                            <ComboBoxItem Content="{markup:Localize Key=GoalType_Execution}" Tag="execution" />
                            <ComboBoxItem Content="{markup:Localize Key=GoalType_Operational}" Tag="operational" />
                            <ComboBoxItem Content="{markup:Localize Key=GoalType_Directional}" Tag="directional" />
                        </ComboBox>
                    </StackPanel>
                    
                    <!-- Time Period Row -->
                    <Grid ColumnDefinitions="*,12,Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="{markup:Localize Key=Dialog_Goal_TimePeriod}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}"/>
                            <ComboBox SelectedIndex="{Binding TimePeriodIndex}"
                                      HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Q1" Tag="Q1" />
                                <ComboBoxItem Content="Q2" Tag="Q2" />
                                <ComboBoxItem Content="Q3" Tag="Q3" />
                                <ComboBoxItem Content="Q4" Tag="Q4" />
                                <ComboBoxItem Content="H1" Tag="H1" />
                                <ComboBoxItem Content="H2" Tag="H2" />
                                <ComboBoxItem Content="{markup:Localize Key=TimePeriod_Annual}" Tag="Annual" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Text="{markup:Localize Key=Dialog_Goal_Year}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}"/>
                            <ComboBox ItemsSource="{Binding Years}"
                                      SelectedIndex="{Binding SelectedYearIndex}"
                                      MinWidth="100" />
                        </StackPanel>
                    </Grid>
                    
                    <!-- Date Range -->
                    <Grid ColumnDefinitions="*,12,*">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="{markup:Localize Key=Label_StartDate}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}"/>
                            <CalendarDatePicker SelectedDate="{Binding StartDate}"
                                                HorizontalAlignment="Stretch"
                                                Watermark="{markup:Localize Key=Dialog_Task_SelectDate}"
                                                IsTodayHighlighted="True"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Text="{markup:Localize Key=Label_EndDate}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}"/>
                            <CalendarDatePicker SelectedDate="{Binding EndDate}"
                                                HorizontalAlignment="Stretch"
                                                Watermark="{markup:Localize Key=Dialog_Task_SelectDate}"
                                                IsTodayHighlighted="True"/>
                        </StackPanel>
                    </Grid>
                    
                    <!-- Owner -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="{markup:Localize Key=Label_Owner}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}"/>
                        <ComboBox ItemsSource="{Binding TeamMembers}"
                                  SelectedItem="{Binding SelectedOwner}"
                                  HorizontalAlignment="Stretch"
                                  PlaceholderText="{markup:Localize Key=Dialog_Goal_SelectOwner}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:TeamMemberDetail">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="24" Height="24"
                                                CornerRadius="12"
                                                ClipToBounds="True">
                                            <Panel>
                                                <Border Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                        CornerRadius="12"
                                                        IsVisible="{Binding UserAvatarUrl, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                                                    <TextBlock Text="{Binding Initials}"
                                                               FontSize="10"
                                                               Foreground="White"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <Image asyncImageLoader:ImageLoader.Source="{Binding UserAvatarUrl}"
                                                       Stretch="UniformToFill" Width="24" Height="24"
                                                       IsVisible="{Binding UserAvatarUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                            </Panel>
                                        </Border>
                                        <TextBlock Text="{Binding FullName}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    
                    <!-- Visibility -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="{markup:Localize Key=Label_Visibility}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}"/>
                        <ComboBox SelectedIndex="{Binding VisibilityIndex}"
                                  HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="{markup:Localize Key=Visibility_PrivateOnlyMe}" Tag="private" />
                            <ComboBoxItem Content="{markup:Localize Key=Visibility_Team}" Tag="team" />
                            <ComboBoxItem Content="{markup:Localize Key=Visibility_Organization}" Tag="organization" />
                        </ComboBox>
                    </StackPanel>
                    
                </StackPanel>
            </ScrollViewer>
            
            <!-- Footer (blue) -->
            <Border Grid.Row="2"
                    Background="{DynamicResource BrushSecondary}"
                    Padding="20,12">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <Button Grid.Column="1"
                            Content="{markup:Localize Key=Button_Cancel}"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="1"
                            BorderBrush="White"
                            MinWidth="80"
                            Margin="0,0,8,0"
                            Command="{Binding CancelCommand}">
                        <Button.Styles>
                            <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="TextBlock.Foreground" Value="{DynamicResource BrushSecondary}"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                    
                    <Button Grid.Column="2"
                            Content="{markup:Localize Key=Dialog_Goal_CreateGoal}"
                            Foreground="{DynamicResource BrushPrimary}"
                            FontWeight="SemiBold"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource BrushPrimary}"
                            MinWidth="100"
                            Command="{Binding SaveCommand}">
                        <Button.Styles>
                            <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="White"/>
                            </Style>
                            <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource BrushPrimary}"/>
                                <Setter Property="TextBlock.Foreground" Value="White"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
