<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="using:ProCohere.Avalonia.Models"
        xmlns:asyncImageLoader="using:AsyncImageLoader"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="680"
        x:Class="ProCohere.Avalonia.Views.Dialogs.EditTeamMemberDialog"
        Title="Team Member"
        Width="520" Height="680"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        SystemDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        Background="{DynamicResource SystemChromeMediumLowColor}">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header -->
        <Border Grid.Row="0" 
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                Padding="20,16">
            <TextBlock x:Name="DialogTitle"
                       Text="Add Team Member"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        </Border>
        
        <!-- Content -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto"
                      Padding="20,16">
            <StackPanel Spacing="16">
                
                <!-- Avatar Section -->
                <StackPanel HorizontalAlignment="Center" Spacing="8">
                    <Grid Width="80" Height="80">
                        <!-- Avatar Image -->
                        <Border x:Name="AvatarBorder"
                                Width="80" Height="80"
                                CornerRadius="40"
                                ClipToBounds="True"
                                IsVisible="False">
                            <Image x:Name="AvatarImage"
                                   Stretch="UniformToFill" />
                        </Border>
                        <!-- Initials fallback -->
                        <Border x:Name="InitialsBorder"
                                Width="80" Height="80"
                                CornerRadius="40"
                                Background="{DynamicResource AccentFillColorDefaultBrush}">
                            <TextBlock x:Name="InitialsText"
                                       Text="?"
                                       FontSize="28"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <Button x:Name="UploadAvatarButton"
                                Content="Upload Photo"
                                Click="UploadAvatarButton_Click" />
                        <Button x:Name="RemoveAvatarButton"
                                Content="Remove"
                                IsVisible="False"
                                Click="RemoveAvatarButton_Click" />
                    </StackPanel>
                </StackPanel>
                
                <!-- Name Row -->
                <Grid ColumnDefinitions="*,12,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="First Name *" FontSize="12" />
                        <TextBox x:Name="FirstNameTextBox"
                                 Watermark="First name"
                                 TextChanged="NameTextBox_TextChanged" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="Last Name *" FontSize="12" />
                        <TextBox x:Name="LastNameTextBox"
                                 Watermark="Last name"
                                 TextChanged="NameTextBox_TextChanged" />
                    </StackPanel>
                </Grid>
                
                <!-- Email -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Email *" FontSize="12" />
                    <TextBox x:Name="EmailTextBox"
                             Watermark="email@example.com" />
                </StackPanel>
                
                <!-- Job Title -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Job Title" FontSize="12" />
                    <TextBox x:Name="JobTitleTextBox"
                             Watermark="Position or role" />
                </StackPanel>
                
                <!-- Phone -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Phone" FontSize="12" />
                    <TextBox x:Name="PhoneTextBox"
                             Watermark="+1 (555) 123-4567" />
                </StackPanel>
                
                <!-- Manager -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Manager" FontSize="12" />
                    <ComboBox x:Name="ManagerComboBox"
                              HorizontalAlignment="Stretch"
                              PlaceholderText="Select manager (optional)">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:TeamMemberDetail">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="24" Height="24" CornerRadius="12" ClipToBounds="True">
                                        <Panel>
                                            <Border Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                    CornerRadius="12"
                                                    IsVisible="{Binding AvatarUrl, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                                                <TextBlock Text="{Binding Initials}"
                                                           FontSize="10"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <Image asyncImageLoader:ImageLoader.Source="{Binding AvatarUrl}"
                                                   Stretch="UniformToFill" Width="24" Height="24"
                                                   IsVisible="{Binding AvatarUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        </Panel>
                                    </Border>
                                    <TextBlock Text="{Binding FullName}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                
                <!-- Dates Row -->
                <Grid ColumnDefinitions="*,12,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="Birthday" FontSize="12" />
                        <DatePicker x:Name="BirthdayPicker" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="Hire Date" FontSize="12" />
                        <DatePicker x:Name="HireDatePicker" />
                    </StackPanel>
                </Grid>
                
                <!-- Social Links -->
                <StackPanel Spacing="4">
                    <TextBlock Text="LinkedIn URL" FontSize="12" />
                    <TextBox x:Name="LinkedInTextBox"
                             Watermark="https://linkedin.com/in/username" />
                </StackPanel>
                
                <StackPanel Spacing="4">
                    <TextBlock Text="X (Twitter) URL" FontSize="12" />
                    <TextBox x:Name="XProfileTextBox"
                             Watermark="https://x.com/username" />
                </StackPanel>
                
                <!-- Notes -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Notes" FontSize="12" />
                    <TextBox x:Name="NotesTextBox"
                             Watermark="Private notes about this team member"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="60" />
                </StackPanel>
                
                <!-- Active Status (only in edit mode) -->
                <StackPanel x:Name="StatusSection" IsVisible="False">
                    <CheckBox x:Name="IsActiveCheckBox"
                              Content="Active team member"
                              IsChecked="True" />
                </StackPanel>
                
            </StackPanel>
        </ScrollViewer>
        
        <!-- Footer -->
        <Border Grid.Row="2"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                Padding="20,12">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <Button x:Name="DeleteButton"
                        Grid.Column="0"
                        Content="Delete"
                        Foreground="#E74C3C"
                        IsVisible="False"
                        Click="DeleteButton_Click" />
                <Button Grid.Column="2"
                        Content="Cancel"
                        MinWidth="80"
                        Margin="0,0,8,0"
                        Click="CancelButton_Click" />
                <Button Grid.Column="3"
                        x:Name="SaveButton"
                        Content="Add Member"
                        Classes="accent"
                        MinWidth="100"
                        Click="SaveButton_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
