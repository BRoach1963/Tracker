<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ProCohere.Avalonia.ViewModels.Dialogs"
        xmlns:controls="clr-namespace:ProCohere.Avalonia.Views.Controls"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="600"
        x:Class="ProCohere.Avalonia.Views.Dialogs.CreateProjectDialog"
        x:DataType="vm:CreateProjectDialogViewModel"
        Title="Create Project"
        Width="500"
        MinHeight="400"
        MaxHeight="700"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="BorderOnly"
        CanResize="False"
        ShowInTaskbar="False"
        Background="Transparent">

    <Window.Styles>
        <!-- Work section toggle button -->
        <Style Selector="Button.work-section-toggle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.work-section-toggle:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceHover}"/>
        </Style>
    </Window.Styles>

    <Border Background="{DynamicResource BrushSurface}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1"
            CornerRadius="8"
            ClipToBounds="True">
        <Grid RowDefinitions="Auto,*,Auto">
            <!-- Header (green with icon) -->
            <Border Grid.Row="0" 
                    Background="{DynamicResource BrushPrimary}"
                    Padding="20,16">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <!-- Project icon -->
                    <Border Width="36" Height="36" CornerRadius="8" 
                            Background="{DynamicResource BrushPrimaryPressed}" 
                            VerticalAlignment="Center">
                        <PathIcon Data="M22 11V3h-7v3H9V3H2v8h7V8h2v10H9v-3H2v8h7v-3h6v3h7v-8h-7v3h-2V8h2v3h7zM7 9H4V5h3v4zm0 12H4v-4h3v4zm13-12h-3V5h3v4zm0 12h-3v-4h3v4z" 
                                  Width="18" Height="18" Foreground="White"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Create Project"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="White" />
                        <TextBlock Text="Organize and track your work"
                                   FontSize="12"
                                   Foreground="#FFFFFFCC"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            
            <!-- Form Content (scrollable) -->
            <ScrollViewer Grid.Row="1" 
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="16" Margin="24,16">
                <!-- Project Name (required) -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Project Name *" 
                               FontSize="13" 
                               FontWeight="Medium" 
                               Foreground="{DynamicResource BrushTextSecondary}"/>
                    <TextBox x:Name="NameTextBox"
                             Text="{Binding Name}"
                             Watermark="What's this project about?"
                             FontSize="14"/>
                </StackPanel>
                
                <!-- Description (optional) -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Description" 
                               FontSize="13" 
                               FontWeight="Medium" 
                               Foreground="{DynamicResource BrushTextSecondary}"/>
                    <TextBox Text="{Binding Description}"
                             Watermark="What is this project trying to accomplish?"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="80"
                             MaxHeight="120"/>
                </StackPanel>
                
                <!-- Due Date (optional) -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Due Date" 
                               FontSize="13" 
                               FontWeight="Medium" 
                               Foreground="{DynamicResource BrushTextSecondary}"/>
                    <CalendarDatePicker SelectedDate="{Binding DueDate}"
                                        Watermark="Select due date..."
                                        HorizontalAlignment="Stretch"/>
                </StackPanel>
                
                <!-- Work Staging Section (Collapsible) -->
                <Border CornerRadius="8"
                        BorderBrush="{DynamicResource BrushBorder}"
                        BorderThickness="1"
                        Padding="0">
                    <StackPanel>
                        <!-- Toggle Header -->
                        <Button Classes="work-section-toggle"
                                Command="{Binding ToggleWorkSectionCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <!-- Expand/Collapse Icons (toggle visibility) -->
                                <Panel Grid.Column="0" Width="16" Margin="0,0,8,0">
                                    <!-- Collapsed: ChevronRight -->
                                    <TextBlock Text="&#xE76C;"
                                               FontFamily="{StaticResource SymbolThemeFontFamily}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding !IsWorkSectionExpanded}"/>
                                    <!-- Expanded: ChevronDown -->
                                    <TextBlock Text="&#xE70D;"
                                               FontFamily="{StaticResource SymbolThemeFontFamily}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding IsWorkSectionExpanded}"/>
                                </Panel>
                                <!-- Button Text -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding WorkSectionButtonText}"
                                           FontSize="13"
                                           Foreground="{DynamicResource BrushTextSecondary}"
                                           VerticalAlignment="Center"/>
                                <!-- Summary Badge -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding StagedWorkSummary}"
                                           FontSize="11"
                                           Foreground="{DynamicResource BrushTextTertiary}"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding !IsWorkSectionExpanded}"/>
                            </Grid>
                        </Button>
                        
                        <!-- Expanded Content -->
                        <StackPanel IsVisible="{Binding IsWorkSectionExpanded}"
                                    Margin="8,0,8,8">
                            
                            <!-- Loading indicator -->
                            <ProgressBar IsIndeterminate="True"
                                         IsVisible="{Binding IsLoadingAvailableItems}"
                                         Margin="0,8"/>
                            
                            <!-- Tab Control for Tasks/Goals/Members -->
                            <TabControl SelectedIndex="{Binding SelectedWorkTabIndex}"
                                        IsVisible="{Binding !IsLoadingAvailableItems}">
                                <!-- Tasks Tab -->
                                <TabItem Header="Tasks">
                                    <controls:WorkItemStagingControl x:Name="TaskStagingControl"
                                                                     NewItemTitles="{Binding NewTaskTitles}"
                                                                     AvailableItems="{Binding AvailableTasks}"
                                                                     NewItemPlaceholder="Add task title..."
                                                                     SearchPlaceholder="Search existing tasks..."
                                                                     Margin="0,8,0,0"/>
                                </TabItem>
                                
                                <!-- Goals Tab -->
                                <TabItem Header="Goals">
                                    <controls:WorkItemStagingControl x:Name="GoalStagingControl"
                                                                     NewItemTitles="{Binding NewGoalTitles}"
                                                                     AvailableItems="{Binding AvailableGoals}"
                                                                     NewItemPlaceholder="Add goal title..."
                                                                     SearchPlaceholder="Search existing goals..."
                                                                     Margin="0,8,0,0"/>
                                </TabItem>
                                
                                <!-- Members Tab -->
                                <TabItem Header="Members">
                                    <StackPanel Margin="0,8,0,0" Spacing="8">
                                        <TextBlock Text="Select team members to add"
                                                   FontSize="11"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource BrushTextTertiary}"/>
                                        
                                        <ScrollViewer MaxHeight="150"
                                                      VerticalScrollBarVisibility="Auto">
                                            <StackPanel>
                                                <!-- Empty state -->
                                                <TextBlock Text="No team members available"
                                                           FontSize="12"
                                                           FontStyle="Italic"
                                                           Foreground="{DynamicResource BrushTextTertiary}"
                                                           Margin="4"
                                                           IsVisible="{Binding !AvailableMembers.Count}"/>
                                                
                                                <!-- Member list -->
                                                <ItemsControl ItemsSource="{Binding AvailableMembers}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Padding="8,6"
                                                                    Background="Transparent"
                                                                    Cursor="Hand">
                                                                <Border.Styles>
                                                                    <Style Selector="Border:pointerover">
                                                                        <Setter Property="Background" Value="{DynamicResource BrushSurfaceHover}"/>
                                                                    </Style>
                                                                </Border.Styles>
                                                                <CheckBox IsChecked="{Binding IsSelected}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                                        <TextBlock Text="{Binding Title}"
                                                                                   FontSize="12"
                                                                                   Foreground="{DynamicResource BrushTextPrimary}"
                                                                                   VerticalAlignment="Center"/>
                                                                        <TextBlock Text="{Binding Subtitle}"
                                                                                   FontSize="10"
                                                                                   Foreground="{DynamicResource BrushTextTertiary}"
                                                                                   VerticalAlignment="Center"
                                                                                   IsVisible="{Binding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                                    </StackPanel>
                                                                </CheckBox>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </StackPanel>
                                </TabItem>
                            </TabControl>
                        </StackPanel>
                    </StackPanel>
                </Border>
                
                <!-- Error Message -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource BrushDanger}"
                           FontSize="13"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>
            </ScrollViewer>
            
            <!-- Footer (blue) -->
            <Border Grid.Row="2"
                    Background="{DynamicResource BrushSecondary}"
                    Padding="20,12">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="8">
                    <Button MinWidth="100"
                            Padding="16,10"
                            HorizontalContentAlignment="Center"
                            Command="{Binding CancelCommand}"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="1"
                            BorderBrush="White">
                        <Button.Styles>
                            <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="TextBlock.Foreground" Value="{DynamicResource BrushSecondary}"/>
                            </Style>
                        </Button.Styles>
                        <TextBlock Text="Cancel" HorizontalAlignment="Center"/>
                    </Button>
                    <Button MinWidth="100"
                            Padding="16,10"
                            HorizontalContentAlignment="Center"
                            Command="{Binding CreateCommand}"
                            Foreground="{DynamicResource BrushPrimary}"
                            FontWeight="SemiBold"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource BrushPrimary}">
                        <Button.Styles>
                            <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="White"/>
                            </Style>
                            <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource BrushPrimary}"/>
                                <Setter Property="TextBlock.Foreground" Value="White"/>
                            </Style>
                        </Button.Styles>
                        <TextBlock Text="Create Project" HorizontalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
