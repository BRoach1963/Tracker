<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ProCohere.Avalonia.ViewModels.Dialogs"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="320"
        x:Class="ProCohere.Avalonia.Views.Dialogs.UpdateMetricValueDialog"
        x:DataType="vm:UpdateMetricValueDialogViewModel"
        Title="Update Metric Value"
        Width="420"
        Height="340"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        SystemDecorations="Full"
        ExtendClientAreaToDecorationsHint="False">

    <Window.Styles>
        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="*,Auto" Margin="24">
        <!-- Form Content -->
        <StackPanel Grid.Row="0" Spacing="16">
            <!-- Current Value Display -->
            <Border Background="{DynamicResource BrushSurfaceHover}" 
                    CornerRadius="8" 
                    Padding="12"
                    IsVisible="{Binding ShowCurrentValue}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Current:" FontSize="13" Opacity="0.7" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CurrentValue}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            
            <!-- New Value -->
            <StackPanel Spacing="6">
                <TextBlock Text="New Value" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource BrushTextSecondary}"/>
                <TextBox x:Name="NewValueTextBox"
                         Text="{Binding NewValue}"
                         Watermark="Enter value..."
                         FontSize="14"/>
            </StackPanel>
            
            <!-- What Changed Note -->
            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="What Changed?" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource BrushTextSecondary}"/>
                    <TextBlock Text="(required)" 
                               FontSize="12" 
                               Opacity="0.5"
                               IsVisible="{Binding IsManualMetric}"/>
                </StackPanel>
                <TextBox Text="{Binding WhatChanged}"
                         Watermark="Describe what caused this change..."
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="80"
                         MaxHeight="100"/>
            </StackPanel>
        </StackPanel>
        
        <!-- Action Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
            <Button Content="Cancel" 
                    Classes="secondary-button"
                    Padding="16,8"
                    Command="{Binding CancelCommand}"/>
            <Button Content="Update" 
                    Classes="primary-button"
                    Padding="16,8"
                    Command="{Binding UpdateCommand}"/>
        </StackPanel>
    </Grid>
</Window>
