<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ProCohere.Avalonia.ViewModels"
        xmlns:views="using:ProCohere.Avalonia.Views"
        xmlns:briefing="using:ProCohere.Avalonia.Views.Briefing"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:assists="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
        xmlns:asyncImageLoader="using:AsyncImageLoader"
        mc:Ignorable="d" 
        d:DesignWidth="1200" 
        d:DesignHeight="800"
        x:Class="ProCohere.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/procohere.ico"
        Title="Pro Cohere"
        Width="1200"
        Height="800"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushBackground}">

    <!-- Keyboard Shortcuts -->
    <Window.KeyBindings>
        <!-- Search -->
        <KeyBinding Gesture="Ctrl+K" Command="{Binding OpenSearchCommand}"/>
        <KeyBinding Gesture="Ctrl+F" Command="{Binding OpenSearchCommand}"/>
        <!-- Help -->
        <KeyBinding Gesture="F1" Command="{Binding OpenHelpCommand}"/>
        <!-- Navigation: Ctrl+1-6 -->
        <KeyBinding Gesture="Ctrl+D1" Command="{Binding NavigateToCommand}" CommandParameter="{x:Static vm:NavigationItem.Briefing}"/>
        <KeyBinding Gesture="Ctrl+D2" Command="{Binding NavigateToCommand}" CommandParameter="{x:Static vm:NavigationItem.Me}"/>
        <KeyBinding Gesture="Ctrl+D3" Command="{Binding NavigateToCommand}" CommandParameter="{x:Static vm:NavigationItem.Circle}"/>
        <KeyBinding Gesture="Ctrl+D4" Command="{Binding NavigateToCommand}" CommandParameter="{x:Static vm:NavigationItem.Projects}"/>
        <KeyBinding Gesture="Ctrl+D5" Command="{Binding NavigateToCommand}" CommandParameter="{x:Static vm:NavigationItem.Pulse}"/>
        <KeyBinding Gesture="Ctrl+D6" Command="{Binding NavigateToCommand}" CommandParameter="{x:Static vm:NavigationItem.Chronicle}"/>
        <!-- Toggle sidebar -->
        <KeyBinding Gesture="Ctrl+B" Command="{Binding ToggleNavigationCommand}"/>
    </Window.KeyBindings>

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Navigation Rail -->
            <ColumnDefinition Width="Auto"/>
            <!-- Main Content -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================================ -->
        <!-- NAVIGATION RAIL - Dark navy sidebar -->
        <!-- ================================ -->
        <Border Grid.Column="0"
                Background="{DynamicResource BrushSecondary}"
                Width="{Binding IsNavigationExpanded, Converter={StaticResource NavWidthConverter}}">
            
            <Grid RowDefinitions="Auto,*,Auto">
                
                <!-- Logo / Brand -->
                <StackPanel Grid.Row="0" 
                            Margin="0,16,0,24"
                            HorizontalAlignment="Center">
                    <Ellipse Width="32" Height="32"
                             HorizontalAlignment="Center">
                        <Ellipse.Fill>
                            <ImageBrush Source="/Assets/procohere.png" Stretch="UniformToFill"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="Pro Cohere"
                               FontSize="13"
                               FontWeight="Medium"
                               Foreground="{DynamicResource BrushHighlight}"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"
                               IsVisible="{Binding IsNavigationExpanded}"/>
                </StackPanel>

                <!-- Navigation Items -->
                <StackPanel Grid.Row="1" Spacing="4" Margin="8,0">
                    
                    <!-- Briefing -->
                    <Button Classes="nav-item-dark"
                            Command="{Binding NavigateToCommand}"
                            CommandParameter="{x:Static vm:NavigationItem.Briefing}"
                            Classes.selected="{Binding SelectedNavigation, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:NavigationItem.Briefing}}">
                        <ToolTip.Tip>
                            <TextBlock Text="Briefing (Ctrl+1)" Foreground="#1F2937"/>
                        </ToolTip.Tip>
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Grid.Column="0" Width="3" CornerRadius="2" Margin="-12,2,-4,2"
                                    Classes="nav-indicator"
                                    Classes.selected="{Binding SelectedNavigation, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:NavigationItem.Briefing}}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                                <!-- Material: center_focus_strong - target/focus reticle (Focus/Direction) -->
                                <PathIcon Width="18" Height="18"
                                          Data="M5 15H3v4c0 1.1.9 2 2 2h4v-2H5v-4zM5 5h4V3H5c-1.1 0-2 .9-2 2v4h2V5zm14-2h-4v2h4v4h2V5c0-1.1-.9-2-2-2zm0 16h-4v2h4c1.1 0 2-.9 2-2v-4h-2v4zM12 8c-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4-1.79-4-4-4zm0 6c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z"/>
                                <TextBlock Text="Briefing" VerticalAlignment="Center" FontSize="14"
                                           IsVisible="{Binding IsNavigationExpanded}"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Me (Personal Hub) - Visible to ALL users -->
                    <Button Classes="nav-item-dark"
                            Command="{Binding NavigateToCommand}"
                            CommandParameter="{x:Static vm:NavigationItem.Me}"
                            Classes.selected="{Binding SelectedNavigation, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:NavigationItem.Me}}">
                        <ToolTip.Tip>
                            <TextBlock Text="Me (Ctrl+2)" Foreground="#1F2937"/>
                        </ToolTip.Tip>
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Grid.Column="0" Width="3" CornerRadius="2" Margin="-12,2,-4,2"
                                    Classes="nav-indicator"
                                    Classes.selected="{Binding SelectedNavigation, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:NavigationItem.Me}}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                                <!-- Person icon -->
                                <PathIcon Width="18" Height="18"
                                          Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,5.5A2.5,2.5 0 0,0 9.5,8A2.5,2.5 0 0,0 12,10.5A2.5,2.5 0 0,0 14.5,8A2.5,2.5 0 0,0 12,5.5M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14M12,15.5C8.04,15.5 5.5,17.08 5.5,18V18.5H18.5V18C18.5,17.08 15.96,15.5 12,15.5Z"/>
                                <TextBlock Text="Me" VerticalAlignment="Center" FontSize="14"
                                           IsVisible="{Binding IsNavigationExpanded}"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Circle (Team View) - Visible to MANAGERS ONLY -->
                    <Button Classes="nav-item-dark"
                            Command="{Binding NavigateToCommand}"
                            CommandParameter="{x:Static vm:NavigationItem.Circle}"
                            IsVisible="{Binding HasDirectReports}"
                            Classes.selected="{Binding SelectedNavigation, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:NavigationItem.Circle}}">
                        <ToolTip.Tip>
                            <TextBlock Text="Circle (Ctrl+3)" Foreground="#1F2937"/>
                        </ToolTip.Tip>
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Grid.Column="0" Width="3" CornerRadius="2" Margin="-12,2,-4,2"
                                    Classes="nav-indicator"
                                    Classes.selected="{Binding SelectedNavigation, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:NavigationItem.Circle}}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                                <!-- Fluent: People outline -->
                                <PathIcon Width="18" Height="18"
                                          Data="M14.75 15c.966 0 1.75.784 1.75 1.75l-.001.962c.117 2.19-1.511 3.297-4.432 3.297-2.91 0-4.567-1.09-4.567-3.259v-1c0-.966.784-1.75 1.75-1.75h5.5Zm0 1.5h-5.5a.25.25 0 0 0-.25.25v1c0 1.176.887 1.759 3.067 1.759 2.168 0 2.995-.564 2.933-1.757V16.75a.25.25 0 0 0-.25-.25ZM12 8a3 3 0 1 1 0 6 3 3 0 0 1 0-6Zm0 1.5a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3ZM18.5 9a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5Zm-13 0a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5Zm13 1.5a1 1 0 1 0 0 2 1 1 0 0 0 0-2Zm-13 0a1 1 0 1 0 0 2 1 1 0 0 0 0-2Z"/>
                                <TextBlock Text="Circle" VerticalAlignment="Center" FontSize="14"
                                           IsVisible="{Binding IsNavigationExpanded}"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Projects -->
                    <Button Classes="nav-item-dark"
                            Command="{Binding NavigateToCommand}"
                            CommandParameter="{x:Static vm:NavigationItem.Projects}"
                            Classes.selected="{Binding SelectedNavigation, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:NavigationItem.Projects}}">
                        <ToolTip.Tip>
                            <TextBlock Text="Projects (Ctrl+4)" Foreground="#1F2937"/>
                        </ToolTip.Tip>
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Grid.Column="0" Width="3" CornerRadius="2" Margin="-12,2,-4,2"
                                    Classes="nav-indicator"
                                    Classes.selected="{Binding SelectedNavigation, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:NavigationItem.Projects}}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                                <!-- Material: account_tree - connected nodes (Structure/Build) -->
                                <PathIcon Width="18" Height="18"
                                          Data="M22 11V3h-7v3H9V3H2v8h7V8h2v10H9v-3H2v8h7v-3h6v3h7v-8h-7v3h-2V8h2v3h7zM7 9H4V5h3v4zm0 12H4v-4h3v4zm13-12h-3V5h3v4zm0 12h-3v-4h3v4z"/>
                                <TextBlock Text="Projects" VerticalAlignment="Center" FontSize="14"
                                           IsVisible="{Binding IsNavigationExpanded}"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Pulse -->
                    <Button Classes="nav-item-dark"
                            Command="{Binding NavigateToCommand}"
                            CommandParameter="{x:Static vm:NavigationItem.Pulse}"
                            Classes.selected="{Binding SelectedNavigation, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:NavigationItem.Pulse}}">
                        <ToolTip.Tip>
                            <TextBlock Text="Pulse (Ctrl+5)" Foreground="#1F2937"/>
                        </ToolTip.Tip>
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Grid.Column="0" Width="3" CornerRadius="2" Margin="-12,2,-4,2"
                                    Classes="nav-indicator"
                                    Classes.selected="{Binding SelectedNavigation, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:NavigationItem.Pulse}}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                                <!-- Fluent: Pulse/trending outline -->
                                <PathIcon Width="18" Height="18"
                                          Data="M5.25 3A2.25 2.25 0 0 0 3 5.25v13.5A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V5.25A2.25 2.25 0 0 0 18.75 3H5.25ZM4.5 5.25a.75.75 0 0 1 .75-.75h13.5a.75.75 0 0 1 .75.75v13.5a.75.75 0 0 1-.75.75H5.25a.75.75 0 0 1-.75-.75V5.25Zm3.22 7.47 2.25-2.25a.75.75 0 0 1 1.06 0l1.72 1.72 3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L10.5 12.06l-1.72 1.72a.75.75 0 0 1-1.06-1.06Z"/>
                                <TextBlock Text="Pulse" VerticalAlignment="Center" FontSize="14"
                                           IsVisible="{Binding IsNavigationExpanded}"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Chronicle -->
                    <Button Classes="nav-item-dark"
                            Command="{Binding NavigateToCommand}"
                            CommandParameter="{x:Static vm:NavigationItem.Chronicle}"
                            Classes.selected="{Binding SelectedNavigation, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:NavigationItem.Chronicle}}">
                        <ToolTip.Tip>
                            <TextBlock Text="Chronicle (Ctrl+6)" Foreground="#1F2937"/>
                        </ToolTip.Tip>
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Grid.Column="0" Width="3" CornerRadius="2" Margin="-12,2,-4,2"
                                    Classes="nav-indicator"
                                    Classes.selected="{Binding SelectedNavigation, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:NavigationItem.Chronicle}}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                                <!-- Phosphor: book-open-text - open book spine (Memory/Archive) -->
                                <PathIcon Width="18" Height="18"
                                          Data="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25"/>
                                <TextBlock Text="Chronicle" VerticalAlignment="Center" FontSize="14"
                                           IsVisible="{Binding IsNavigationExpanded}"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- Bottom: Settings + Collapse -->
                <StackPanel Grid.Row="2" Spacing="0" Margin="8,0,8,16">
                    <!-- Settings -->
                    <Button Classes="nav-item-dark"
                            Command="{Binding NavigateToCommand}"
                            CommandParameter="{x:Static vm:NavigationItem.Settings}"
                            Classes.selected="{Binding SelectedNavigation, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:NavigationItem.Settings}}">
                        <ToolTip.Tip>
                            <TextBlock Text="Settings (Ctrl+6)" Foreground="#1F2937"/>
                        </ToolTip.Tip>
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Grid.Column="0" Width="3" CornerRadius="2" Margin="-12,2,-4,2"
                                    Classes="nav-indicator"
                                    Classes.selected="{Binding SelectedNavigation, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:NavigationItem.Settings}}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                                <!-- Fluent: Settings outline -->
                                <PathIcon Width="18" Height="18"
                                          Data="M12.012 2.25c.734.008 1.465.093 2.182.253a.75.75 0 0 1 .582.649l.17 1.527a1.384 1.384 0 0 0 1.927 1.116l1.4-.615a.75.75 0 0 1 .85.174 9.793 9.793 0 0 1 2.204 3.792.75.75 0 0 1-.271.825l-1.242.916a1.38 1.38 0 0 0 0 2.226l1.243.916a.75.75 0 0 1 .271.826 9.798 9.798 0 0 1-2.204 3.79.75.75 0 0 1-.848.175l-1.407-.617a1.38 1.38 0 0 0-1.926 1.114l-.169 1.526a.75.75 0 0 1-.572.647 9.518 9.518 0 0 1-4.406 0 .75.75 0 0 1-.572-.647l-.168-1.524a1.382 1.382 0 0 0-1.926-1.11l-1.406.616a.75.75 0 0 1-.849-.175 9.798 9.798 0 0 1-2.204-3.796.75.75 0 0 1 .272-.826l1.243-.916a1.38 1.38 0 0 0 0-2.226l-1.243-.914a.75.75 0 0 1-.271-.826 9.793 9.793 0 0 1 2.204-3.792.75.75 0 0 1 .85-.174l1.4.615a1.387 1.387 0 0 0 1.93-1.118l.17-1.526a.75.75 0 0 1 .583-.65c.718-.159 1.45-.243 2.201-.252ZM12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6Zm-1.5 3a1.5 1.5 0 1 1 3 0 1.5 1.5 0 0 1-3 0Z"/>
                                <TextBlock Text="Settings" VerticalAlignment="Center" FontSize="14"
                                           IsVisible="{Binding IsNavigationExpanded}"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                    
                    <!-- Collapse Toggle - subtle, left-aligned -->
                    <Button Classes="nav-collapse"
                            Command="{Binding ToggleNavigationCommand}">
                        <ToolTip.Tip>
                            <TextBlock Text="Toggle sidebar (Ctrl+B)" Foreground="#1F2937"/>
                        </ToolTip.Tip>
                        <PathIcon Width="14" Height="14"
                                  Data="{Binding IsNavigationExpanded, Converter={StaticResource CollapseIconConverter}}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================================ -->
        <!-- MAIN CONTENT AREA -->
        <!-- ================================ -->
        <Grid Grid.Column="1" 
              Background="{DynamicResource BrushBackground}"
              Margin="0">
            
            <Grid.RowDefinitions>
                <!-- Header bar -->
                <RowDefinition Height="Auto"/>
                <!-- Content -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header Bar -->
            <Border Grid.Row="0"
                    Background="{DynamicResource BrushPrimary}"
                    Padding="24,12"
                    CornerRadius="0,0,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Page Icon + Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <PathIcon Data="{Binding PageIconData}"
                                  Width="22" Height="22"
                                  Foreground="White"/>
                        <TextBlock Text="{Binding PageTitle}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Search + Actions -->
                    <StackPanel Grid.Column="2" 
                                Orientation="Horizontal" 
                                Spacing="8">
                        
                        <!-- Search TextBox -->
                        <Border Background="{DynamicResource BrushSurface}"
                                BorderBrush="{DynamicResource BrushBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="8,6"
                                Width="220">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <PathIcon Grid.Column="0"
                                          Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                                          Width="16" Height="16"
                                          Foreground="{DynamicResource BrushTextTertiary}"
                                          Margin="0,0,8,0"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding SearchText, Mode=TwoWay}"
                                         Watermark="Search..."
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="{DynamicResource BrushTextPrimary}"
                                         FontSize="14"
                                         VerticalAlignment="Center"
                                         AutomationProperties.Name="Search"/>
                            </Grid>
                        </Border>

                        <!-- Help Button -->
                        <Button Classes="icon-button"
                                Command="{Binding OpenHelpCommand}"
                                ToolTip.Tip="Help (F1)"
                                AutomationProperties.Name="Help">
                            <PathIcon Data="M15.07,11.25L14.17,12.17C13.45,12.89 13,13.5 13,15H11V14.5C11,13.39 11.45,12.39 12.17,11.67L13.41,10.41C13.78,10.05 14,9.55 14,9C14,7.89 13.1,7 12,7A2,2 0 0,0 10,9H8A4,4 0 0,1 12,5A4,4 0 0,1 16,9C16,9.88 15.64,10.67 15.07,11.25M13,19H11V17H13M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12C22,6.47 17.5,2 12,2Z"
                                      Width="24" Height="24"/>
                        </Button>

                        <!-- User Avatar / Account Menu -->
                        <Button Classes="user-avatar-button"
                                ToolTip.Tip="Account"
                                AutomationProperties.Name="Account menu">
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                    <Border Background="{DynamicResource BrushSurface}"
                                            CornerRadius="12"
                                            Padding="8"
                                            MinWidth="200">
                                        <StackPanel Spacing="4">
                                            <!-- User Info Header -->
                                            <Border Background="{DynamicResource BrushBackground}"
                                                    CornerRadius="8"
                                                    Padding="12"
                                                    Margin="0,0,0,4">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <!-- Avatar -->
                                                    <Border Grid.Column="0"
                                                            Width="40" Height="40"
                                                            CornerRadius="20"
                                                            ClipToBounds="True"
                                                            Margin="0,0,12,0">
                                                        <Panel>
                                                            <!-- Initials background (shown when no avatar) -->
                                                            <Border Background="{DynamicResource BrushHighlight}"
                                                                    CornerRadius="20"
                                                                    IsVisible="{Binding UserAvatarUrl, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                                                                <TextBlock Text="{Binding UserInitials}"
                                                                           FontSize="14"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="White"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"/>
                                                            </Border>
                                                            <!-- Avatar image (shown when avatar URL exists) -->
                                                            <Image asyncImageLoader:ImageLoader.Source="{Binding UserAvatarUrl}"
                                                                   Stretch="UniformToFill"
                                                                   Width="40" Height="40"
                                                                   IsVisible="{Binding UserAvatarUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                        </Panel>
                                                    </Border>
                                                    <!-- Name and Email -->
                                                    <StackPanel Grid.Column="1" 
                                                                VerticalAlignment="Center"
                                                                Spacing="2">
                                                        <TextBlock Text="{Binding UserDisplayName}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="14"
                                                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                                                        <TextBlock Text="{Binding UserEmail}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource BrushTextTertiary}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            
                                            <!-- Menu Items -->
                                            <Button Classes="menu-item"
                                                    Command="{Binding EditProfileCommand}">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <PathIcon Width="16" Height="16"
                                                              Foreground="{DynamicResource BrushTextSecondary}"
                                                              Data="M12 4a4 4 0 1 1 0 8 4 4 0 0 1 0-8Zm0 1.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5Zm0 7.5c4.418 0 8 1.79 8 4v1.5a.5.5 0 0 1-.5.5h-15a.5.5 0 0 1-.5-.5V17c0-2.21 3.582-4 8-4Zm0 1.5c-3.59 0-6.5 1.343-6.5 2.5v.5h13v-.5c0-1.157-2.91-2.5-6.5-2.5Z"/>
                                                    <TextBlock Text="Edit Profile"
                                                               FontSize="13"
                                                               Foreground="{DynamicResource BrushTextPrimary}"/>
                                                </StackPanel>
                                            </Button>
                                            
                                            <Button Classes="menu-item"
                                                    Command="{Binding NavigateToCommand}"
                                                    CommandParameter="{x:Static vm:NavigationItem.Settings}">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <PathIcon Width="16" Height="16"
                                                              Foreground="{DynamicResource BrushTextSecondary}"
                                                              Data="M12.012 2.25c.734.008 1.465.093 2.182.253a.75.75 0 0 1 .582.649l.17 1.527a1.384 1.384 0 0 0 1.927 1.116l1.4-.615a.75.75 0 0 1 .85.174 9.793 9.793 0 0 1 2.204 3.792.75.75 0 0 1-.271.825l-1.242.916a1.38 1.38 0 0 0 0 2.226l1.243.916a.75.75 0 0 1 .271.826 9.798 9.798 0 0 1-2.204 3.79.75.75 0 0 1-.848.175l-1.407-.617a1.38 1.38 0 0 0-1.926 1.114l-.169 1.526a.75.75 0 0 1-.572.647 9.518 9.518 0 0 1-4.406 0 .75.75 0 0 1-.572-.647l-.168-1.524a1.382 1.382 0 0 0-1.926-1.11l-1.406.616a.75.75 0 0 1-.849-.175 9.798 9.798 0 0 1-2.204-3.796.75.75 0 0 1 .272-.826l1.243-.916a1.38 1.38 0 0 0 0-2.226l-1.243-.914a.75.75 0 0 1-.271-.826 9.793 9.793 0 0 1 2.204-3.792.75.75 0 0 1 .85-.174l1.4.615a1.387 1.387 0 0 0 1.93-1.118l.17-1.526a.75.75 0 0 1 .583-.65c.718-.159 1.45-.243 2.201-.252ZM12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6Zm-1.5 3a1.5 1.5 0 1 1 3 0 1.5 1.5 0 0 1-3 0Z"/>
                                                    <TextBlock Text="Settings"
                                                               FontSize="13"
                                                               Foreground="{DynamicResource BrushTextPrimary}"/>
                                                </StackPanel>
                                            </Button>
                                            
                                            <!-- Divider -->
                                            <Border Height="1" 
                                                    Background="{DynamicResource BrushBorder}"
                                                    Margin="4,4"/>
                                            
                                            <!-- Sign Out -->
                                            <Button Classes="menu-item danger"
                                                    Command="{Binding SignOutCommand}">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <PathIcon Width="16" Height="16"
                                                              Foreground="{DynamicResource BrushError}"
                                                              Data="M12 4.354v6.651l7.442-.001L17.72 9.28a.75.75 0 0 1-.073-.976l.073-.084a.75.75 0 0 1 .976-.073l.084.073 2.997 2.997a.75.75 0 0 1 .073.976l-.073.084-2.996 3.004a.75.75 0 0 1-1.134-.975l.072-.085 1.713-1.717-7.431.001L12 19.25a.75.75 0 0 1-.88.739l-8.5-1.502A.75.75 0 0 1 2 17.75V5.104a.75.75 0 0 1 .615-.738l8.5-1.396a.75.75 0 0 1 .885.738v.646ZM3.5 5.846v11.267l7-.001V4.604l-7 1.152v.09Z"/>
                                                    <TextBlock Text="Sign out"
                                                               FontSize="13"
                                                               Foreground="{DynamicResource BrushError}"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                            <!-- Avatar Circle -->
                            <Border Width="36" Height="36"
                                    CornerRadius="18"
                                    ClipToBounds="True">
                                <Panel>
                                    <!-- Initials background (shown when no avatar) -->
                                    <Border Background="{DynamicResource BrushHighlight}"
                                            CornerRadius="18"
                                            IsVisible="{Binding UserAvatarUrl, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                                        <TextBlock Text="{Binding UserInitials}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <!-- Avatar image (shown when avatar URL exists) -->
                                    <Image asyncImageLoader:ImageLoader.Source="{Binding UserAvatarUrl}"
                                           Stretch="UniformToFill"
                                           Width="36" Height="36"
                                           IsVisible="{Binding UserAvatarUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </Panel>
                            </Border>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content Panels -->
            <Grid Grid.Row="1" Margin="24">
                
                <!-- BRIEFING / Dashboard -->
                <Grid IsVisible="{Binding SelectedNavigation, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:NavigationItem.Briefing}}">
                    <briefing:BriefingView />
                </Grid>

                <!-- ME (Personal Hub) -->
                <Grid IsVisible="{Binding SelectedNavigation, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:NavigationItem.Me}}">
                    <views:MeView />
                </Grid>

                <!-- CIRCLE -->
                <Grid IsVisible="{Binding SelectedNavigation, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:NavigationItem.Circle}}">
                    <views:CircleView />
                </Grid>

                <!-- PROJECTS -->
                <Grid IsVisible="{Binding SelectedNavigation, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:NavigationItem.Projects}}">
                    <views:ProjectsView />
                </Grid>

                <!-- PULSE -->
                <Grid IsVisible="{Binding SelectedNavigation, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:NavigationItem.Pulse}}">
                    <views:PulseView />
                </Grid>

                <!-- CHRONICLE -->
                <Grid IsVisible="{Binding SelectedNavigation, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:NavigationItem.Chronicle}}">
                    <views:ChronicleView />
                </Grid>

                <!-- SETTINGS - DataContext set in code-behind -->
                <Grid IsVisible="{Binding SelectedNavigation, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:NavigationItem.Settings}}">
                    <views:SettingsView x:Name="SettingsView" DataContext="{x:Null}" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>

