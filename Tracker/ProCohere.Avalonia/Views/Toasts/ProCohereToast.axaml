<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ProCohere.Avalonia.Views.Toasts.ProCohereToast"
        Title="Toast"
        Width="400"
        MinHeight="80"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        CanResize="False"
        Opacity="0"
        PointerEntered="Toast_PointerEntered"
        PointerExited="Toast_PointerExited">
    
    <Window.Resources>
        <!-- Toast type colors - using ProCohere theme semantic colors -->
        <SolidColorBrush x:Key="InfoAccentBrush" Color="{DynamicResource ColorInfo}"/>
        <SolidColorBrush x:Key="SuccessAccentBrush" Color="{DynamicResource ColorSuccess}"/>
        <SolidColorBrush x:Key="WarningAccentBrush" Color="{DynamicResource ColorWarning}"/>
        <SolidColorBrush x:Key="ErrorAccentBrush" Color="{DynamicResource ColorError}"/>
        
        <!-- Icon paths -->
        <StreamGeometry x:Key="InfoIcon">M13,9H11V7H13M13,17H11V11H13M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z</StreamGeometry>
        <StreamGeometry x:Key="SuccessIcon">M12 2C6.5 2 2 6.5 2 12S6.5 22 12 22 22 17.5 22 12 17.5 2 12 2M10 17L5 12L6.41 10.59L10 14.17L17.59 6.58L19 8L10 17Z</StreamGeometry>
        <StreamGeometry x:Key="WarningIcon">M13 14H11V10H13M13 18H11V16H13M1 21H23L12 2L1 21Z</StreamGeometry>
        <StreamGeometry x:Key="ErrorIcon">M12,2C17.53,2 22,6.47 22,12C22,17.53 17.53,22 12,22C6.47,22 2,17.53 2,12C2,6.47 6.47,2 12,2M15.59,7L12,10.59L8.41,7L7,8.41L10.59,12L7,15.59L8.41,17L12,13.41L15.59,17L17,15.59L13.41,12L17,8.41L15.59,7Z</StreamGeometry>
    </Window.Resources>
    
    <Border x:Name="ToastBorder"
            CornerRadius="{DynamicResource CornerRadiusControl}"
            Background="{DynamicResource BrushSurface}"
            BorderThickness="1"
            BorderBrush="{DynamicResource BrushBorder}"
            Margin="10"
            BoxShadow="0 8 24 0 #40000000">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="48"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="4"/>
            </Grid.RowDefinitions>
            
            <!-- Accent bar on left -->
            <Border x:Name="AccentBar"
                    Grid.Column="0"
                    Grid.RowSpan="2"
                    CornerRadius="10,0,0,10"
                    Background="{StaticResource InfoAccentBrush}"/>
            
            <!-- Icon -->
            <Viewbox Grid.Column="1" 
                     Grid.Row="0"
                     Width="26" 
                     Height="26"
                     Margin="8,0,0,0">
                <PathIcon x:Name="ToastIcon"
                          Data="{StaticResource InfoIcon}"
                          Foreground="{StaticResource InfoAccentBrush}"/>
            </Viewbox>
            
            <!-- Content -->
            <StackPanel Grid.Column="2" 
                        Grid.Row="0"
                        VerticalAlignment="Center"
                        Margin="10,14,10,14">
                <TextBlock x:Name="ToastTitle"
                           Text="Notification"
                           Foreground="{DynamicResource BrushTextPrimary}"
                           FontWeight="SemiBold"
                           FontSize="{DynamicResource FontSizeBody}"
                           FontFamily="{DynamicResource FontFamilyDefault}"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="ToastMessage"
                           Text="This is a toast notification message."
                           Foreground="{DynamicResource BrushTextSecondary}"
                           FontSize="{DynamicResource FontSizeCaption}"
                           FontFamily="{DynamicResource FontFamilyDefault}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"/>
            </StackPanel>
            
            <!-- Close button -->
            <Button x:Name="CloseButton"
                    Grid.Column="3"
                    Grid.Row="0"
                    Width="28"
                    Height="28"
                    Margin="0,10,10,0"
                    VerticalAlignment="Top"
                    Cursor="Hand"
                    Click="CloseButton_Click"
                    Background="Transparent"
                    BorderThickness="0">
                <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                          Width="12"
                          Height="12"
                          Foreground="{DynamicResource BrushTextTertiary}"/>
            </Button>
            
            <!-- Progress bar for auto-dismiss -->
            <Border Grid.Column="0"
                    Grid.ColumnSpan="4"
                    Grid.Row="1"
                    CornerRadius="0,0,10,10"
                    ClipToBounds="True">
                <Border x:Name="ProgressBar"
                        Background="{StaticResource InfoAccentBrush}"
                        HorizontalAlignment="Left"
                        Opacity="0.5"
                        CornerRadius="0,0,0,10"
                        RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="1"/>
                    </Border.RenderTransform>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>
