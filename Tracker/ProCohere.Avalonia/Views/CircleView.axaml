<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ProCohere.Avalonia.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="ProCohere.Avalonia.Views.CircleView"
             x:DataType="vm:CircleViewModel">
    
    <Design.DataContext>
        <vm:CircleViewModel/>
    </Design.DataContext>

    <UserControl.Styles>
        <!-- Tab Button Style -->
        <Style Selector="Button.tab-button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style Selector="Button.tab-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        </Style>
        <Style Selector="Button.tab-button.selected">
            <Setter Property="Foreground" Value="{DynamicResource BrushPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        
        <!-- Member Card Style -->
        <Style Selector="Border.member-card">
            <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Border.member-card:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushHighlight}"/>
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}"/>
        </Style>
        <Style Selector="Border.member-card.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        
        <!-- Detail Panel Style - with slide animation -->
        <Style Selector="Border.detail-panel">
            <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20,20,6,20"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RenderTransform" Value="translate(320px, 0)"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="CubicEaseOut"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.detail-panel.open">
            <Setter Property="RenderTransform" Value="translate(0, 0)"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        
        <!-- Detail Section Header -->
        <Style Selector="TextBlock.detail-section-header">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextTertiary}"/>
            <Setter Property="Margin" Value="0,16,0,8"/>
        </Style>
        
        <!-- Stat Filter Card -->
        <Style Selector="Border.stat-filter">
            <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Border.stat-filter:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}"/>
        </Style>
        <Style Selector="Border.stat-filter.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}"/>
        </Style>
        
        <!-- Meeting View Mode Button -->
        <Style Selector="Button.view-mode-button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="Button.view-mode-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}"/>
        </Style>
        <Style Selector="Button.view-mode-button.selected">
            <Setter Property="Background" Value="{DynamicResource BrushPrimary}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        
        <!-- Meeting Card Style -->
        <Style Selector="Border.meeting-card">
            <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Border.meeting-card:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushHighlight}"/>
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}"/>
        </Style>
        
        <!-- Calendar Day Cell -->
        <Style Selector="Border.calendar-day">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="MinHeight" Value="80"/>
        </Style>
        <Style Selector="Border.calendar-day.today">
            <Setter Property="Background" Value="#10406D3A"/>
        </Style>
        <Style Selector="Border.calendar-day.other-month">
            <Setter Property="Opacity" Value="0.4"/>
        </Style>
        
        <!-- Calendar Meeting Item (compact) -->
        <Style Selector="Border.calendar-meeting">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,*">
        
        <!-- Row 0: Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="Circle"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{DynamicResource BrushTextPrimary}"/>
                <TextBlock FontSize="13" Foreground="{DynamicResource BrushTextSecondary}">
                    <Run Text="Your team of"/>
                    <Run Text="{Binding TotalMemberCount}" FontWeight="SemiBold"/>
                    <Run Text="people"/>
                </TextBlock>
            </StackPanel>
            
            <!-- Add Member Button -->
            <Button Grid.Column="1" Command="{Binding AddTeamMemberCommand}" Classes="action-button">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="M15,14C12.33,14 7,15.33 7,18V20H23V18C23,15.33 17.67,14 15,14M15,12A4,4 0 0,0 19,8A4,4 0 0,0 15,4A4,4 0 0,0 11,8A4,4 0 0,0 15,12M5,9.59L7.12,7.46L8.54,8.88L6.41,11L8.54,13.12L7.12,14.54L5,12.41L2.88,14.54L1.46,13.12L3.59,11L1.46,8.88L2.88,7.46L5,9.59Z" 
                              Width="16" Height="16"/>
                    <TextBlock Text="Add Member" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
        
        <!-- Row 1: Tab Bar -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Classes="tab-button"
                        Classes.selected="{Binding SelectedTab, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:CircleTab.Team}}"
                        Command="{Binding SelectTabCommand}"
                        CommandParameter="{x:Static vm:CircleTab.Team}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="M12,5.5A3.5,3.5 0 0,1 15.5,9A3.5,3.5 0 0,1 12,12.5A3.5,3.5 0 0,1 8.5,9A3.5,3.5 0 0,1 12,5.5M5,8C5.56,8 6.08,8.15 6.53,8.42C6.38,9.85 6.8,11.27 7.66,12.38C7.16,13.34 6.16,14 5,14A3,3 0 0,1 2,11A3,3 0 0,1 5,8M19,8A3,3 0 0,1 22,11A3,3 0 0,1 19,14C17.84,14 16.84,13.34 16.34,12.38C17.2,11.27 17.62,9.85 17.47,8.42C17.92,8.15 18.44,8 19,8M5.5,18.25C5.5,16.18 8.41,14.5 12,14.5C15.59,14.5 18.5,16.18 18.5,18.25V20H5.5V18.25Z" 
                                  Width="16" Height="16"/>
                        <TextBlock Text="Team"/>
                    </StackPanel>
                </Button>
                
                <Button Classes="tab-button"
                        Classes.selected="{Binding SelectedTab, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:CircleTab.Goals}}"
                        Command="{Binding SelectTabCommand}"
                        CommandParameter="{x:Static vm:CircleTab.Goals}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="M5,21L7.5,13L1,9H8.5L11,1L13.5,9H21L14.5,13L17,21L11,16L5,21Z" 
                                  Width="16" Height="16"/>
                        <TextBlock Text="Goals"/>
                    </StackPanel>
                </Button>
                
                <Button Classes="tab-button"
                        Classes.selected="{Binding SelectedTab, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:CircleTab.Feedback}}"
                        Command="{Binding SelectTabCommand}"
                        CommandParameter="{x:Static vm:CircleTab.Feedback}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="M20,2H4A2,2 0 0,0 2,4V22L6,18H20A2,2 0 0,0 22,16V4C22,2.89 21.1,2 20,2M6,9H18V11H6M14,14H6V12H14M18,8H6V6H18" 
                                  Width="16" Height="16"/>
                        <TextBlock Text="Feedback"/>
                    </StackPanel>
                </Button>
                
                <Button Classes="tab-button"
                        Classes.selected="{Binding SelectedTab, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:CircleTab.Meetings}}"
                        Command="{Binding SelectTabCommand}"
                        CommandParameter="{x:Static vm:CircleTab.Meetings}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="M19,19H5V8H19M16,1V3H8V1H6V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3H18V1M17,12H12V17H17V12Z" 
                                  Width="16" Height="16"/>
                        <TextBlock Text="Meetings"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
        
        <!-- Row 2: Search & Filters (Team tab only) -->
        <Grid Grid.Row="2" Margin="0,0,0,16"
              IsVisible="{Binding SelectedTab, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:CircleTab.Team}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- Search Box -->
            <Border Grid.Column="0" Background="{DynamicResource BrushSurface}"
                    CornerRadius="8" Padding="10,8"
                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                <Grid ColumnDefinitions="Auto,*">
                    <PathIcon Grid.Column="0"
                              Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                              Width="16" Height="16"
                              Foreground="{DynamicResource BrushTextTertiary}"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding SearchText, Mode=TwoWay}"
                             Watermark="Search team members..."
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{DynamicResource BrushTextPrimary}"
                             FontSize="13"
                             Margin="8,0,0,0"
                             VerticalAlignment="Center"/>
                </Grid>
            </Border>
            
            <!-- Filter Stats (clickable) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="16,0,0,0">
                <!-- All -->
                <Border Classes="stat-filter"
                        Classes.selected="{Binding MemberFilter, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:TeamMemberFilter.All}}"
                        Tapped="StatFilter_All_Tapped">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding TotalMemberCountText}" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                        <TextBlock Text="All" FontSize="12" 
                                   Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                
                <!-- Active -->
                <Border Classes="stat-filter"
                        Classes.selected="{Binding MemberFilter, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:TeamMemberFilter.Active}}"
                        Tapped="StatFilter_Active_Tapped">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding ActiveMemberCountText}" FontSize="18" FontWeight="Bold"
                                   Foreground="#10B981"/>
                        <TextBlock Text="Active" FontSize="12" 
                                   Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                
                <!-- Needs Attention (meetings overdue) -->
                <Border Classes="stat-filter"
                        Classes.selected="{Binding MemberFilter, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:TeamMemberFilter.NeedsAttention}}"
                        Tapped="StatFilter_NeedsAttention_Tapped">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding MeetingsOverdueCountText}" FontSize="18" FontWeight="Bold"
                                   Foreground="#EF4444"/>
                        <TextBlock Text="Needs Attention" FontSize="12" 
                                   Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            
            <!-- Showing count -->
            <TextBlock Grid.Column="2" VerticalAlignment="Center"
                       Foreground="{DynamicResource BrushTextTertiary}" FontSize="12">
                <Run Text="Showing"/>
                <Run Text="{Binding FilteredMemberCount}" FontWeight="SemiBold"/>
                <Run Text="of"/>
                <Run Text="{Binding TotalMemberCount}" FontWeight="SemiBold"/>
            </TextBlock>
        </Grid>
        
        <!-- Row 3: Content Area -->
        <Grid Grid.Row="3">
            
            <!-- =============== TEAM TAB =============== -->
            <Grid IsVisible="{Binding SelectedTab, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:CircleTab.Team}}"
                  ColumnDefinitions="*,Auto" ClipToBounds="True">
                
                <!-- Cards Grid - add right margin when panel is open -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" 
                              Padding="0,0,12,0">
                    <ItemsControl ItemsSource="{Binding FilteredTeamMembers}" Margin="0,0,4,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="member-card" Width="280" Margin="0,0,12,12"
                                        Tapped="MemberCard_Tapped"
                                        DoubleTapped="MemberCard_DoubleTapped" Tag="{Binding}">
                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto">
                                        
                                        <!-- Header: Avatar + Name + Status -->
                                        <Grid Grid.Row="0" Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Avatar -->
                                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24" 
                                                    Background="{DynamicResource BrushPrimary}">
                                                <TextBlock Text="{Binding Initials}" FontSize="16" FontWeight="SemiBold"
                                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            
                                            <!-- Name + Title -->
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FullName}" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding JobTitle}" FontSize="11"
                                                           Foreground="{DynamicResource BrushTextSecondary}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            
                                            <!-- Status Badge -->
                                            <Border Grid.Column="2" CornerRadius="10" Padding="8,3" VerticalAlignment="Top">
                                                <Border.Background>
                                                    <MultiBinding Converter="{StaticResource BoolToColorConverter}">
                                                        <Binding Path="IsActive"/>
                                                    </MultiBinding>
                                                </Border.Background>
                                                <TextBlock Text="{Binding StatusDisplay}" FontSize="9" FontWeight="SemiBold" Foreground="White"/>
                                            </Border>
                                        </Grid>
                                        
                                        <!-- Stats Row -->
                                        <Border Grid.Row="1" Background="{DynamicResource BrushBackground}"
                                                CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
                                            <Grid ColumnDefinitions="*,Auto,*,Auto,*">
                                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding Tenure}" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Tenure" FontSize="9"
                                                               Foreground="{DynamicResource BrushTextTertiary}" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                                
                                                <Border Grid.Column="1" Width="1" Background="{DynamicResource BrushBorder}" Margin="8,2"/>
                                                
                                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding OpenTaskCount}" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Tasks" FontSize="9"
                                                               Foreground="{DynamicResource BrushTextTertiary}" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                                
                                                <Border Grid.Column="3" Width="1" Background="{DynamicResource BrushBorder}" Margin="8,2"/>
                                                
                                                <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding ActiveGoalCount}" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Goals" FontSize="9"
                                                               Foreground="{DynamicResource BrushTextTertiary}" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        
                                        <!-- Meeting Status -->
                                        <Grid Grid.Row="2" Margin="0,0,0,12" ColumnDefinitions="*,*">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Last Meeting" FontSize="9" Foreground="{DynamicResource BrushTextTertiary}"/>
                                                <TextBlock Text="{Binding LastMeetingText}" FontSize="12" FontWeight="Medium"
                                                           Foreground="{DynamicResource BrushTextPrimary}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <TextBlock Text="Next Meeting" FontSize="9" Foreground="{DynamicResource BrushTextTertiary}" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding NextMeetingText}" FontSize="12" FontWeight="Medium"
                                                           HorizontalAlignment="Right">
                                                    <TextBlock.Foreground>
                                                        <MultiBinding Converter="{StaticResource MeetingStatusColorConverter}">
                                                            <Binding Path="NeedsAttention"/>
                                                        </MultiBinding>
                                                    </TextBlock.Foreground>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                        
                                        <!-- Quick Actions -->
                                        <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BrushBorder}" Padding="0,10,0,0">
                                            <Grid ColumnDefinitions="*,*,*">
                                                <!-- Schedule Meeting -->
                                                <Button Grid.Column="0" Classes="icon-button" ToolTip.Tip="Schedule Meeting"
                                                        Command="{Binding $parent[ItemsControl].((vm:CircleViewModel)DataContext).ScheduleMeetingCommand}"
                                                        CommandParameter="{Binding}">
                                                    <PathIcon Data="M19,19H5V8H19M16,1V3H8V1H6V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3H18V1M17,12H12V17H17V12Z"
                                                              Width="16" Height="16" Foreground="{DynamicResource BrushPrimary}"/>
                                                </Button>
                                                
                                                <!-- Send Email -->
                                                <Button Grid.Column="1" Classes="icon-button" ToolTip.Tip="Send Email"
                                                        Command="{Binding $parent[ItemsControl].((vm:CircleViewModel)DataContext).SendEmailCommand}"
                                                        CommandParameter="{Binding}">
                                                    <PathIcon Data="M20,8L12,13L4,8V6L12,11L20,6M20,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V6C22,4.89 21.1,4 20,4Z"
                                                              Width="16" Height="16" Foreground="{DynamicResource BrushTextSecondary}"/>
                                                </Button>
                                                
                                                <!-- Edit -->
                                                <Button Grid.Column="2" Classes="icon-button" ToolTip.Tip="Edit Details"
                                                        Command="{Binding $parent[ItemsControl].((vm:CircleViewModel)DataContext).EditTeamMemberCommand}"
                                                        CommandParameter="{Binding}">
                                                    <PathIcon Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"
                                                              Width="16" Height="16" Foreground="{DynamicResource BrushTextSecondary}"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                
                <!-- ======= EXPANDABLE DETAIL PANEL ======= -->
                <!-- Panel container - always present but animated -->
                <Border Grid.Column="1" Width="{Binding IsDetailPanelOpen, Converter={StaticResource BoolToWidthConverter}}"
                        ClipToBounds="True">
                    <Border Classes="detail-panel" Classes.open="{Binding IsDetailPanelOpen}" 
                            Width="320" Margin="8,0,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel DataContext="{Binding SelectedTeamMember}" Margin="0,0,18,0">
                            
                            <!-- Close Button -->
                            <Button Classes="icon-button" HorizontalAlignment="Right" 
                                    ToolTip.Tip="Close"
                                    Command="{Binding $parent[UserControl].((vm:CircleViewModel)DataContext).CloseDetailPanelCommand}">
                                <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                          Width="16" Height="16" Foreground="{DynamicResource BrushTextSecondary}"/>
                            </Button>
                            
                            <!-- Profile Header -->
                            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,20">
                                <Border Width="80" Height="80" CornerRadius="40" 
                                        Background="{DynamicResource BrushPrimary}" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Initials}" FontSize="28" FontWeight="SemiBold"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding FullName}" FontSize="18" FontWeight="Bold"
                                           Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center"
                                           Margin="0,12,0,4"/>
                                <TextBlock Text="{Binding JobTitle}" FontSize="13"
                                           Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center"/>
                                
                                <!-- Status Badge -->
                                <Border CornerRadius="12" Padding="12,4" Margin="0,8,0,0" HorizontalAlignment="Center">
                                    <Border.Background>
                                        <MultiBinding Converter="{StaticResource BoolToColorConverter}">
                                            <Binding Path="IsActive"/>
                                        </MultiBinding>
                                    </Border.Background>
                                    <TextBlock Text="{Binding StatusDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                </Border>
                            </StackPanel>
                            
                            <!-- CONTACT Section -->
                            <TextBlock Text="CONTACT" Classes="detail-section-header"/>
                            
                            <!-- Email -->
                            <Grid Margin="0,0,0,8" ColumnDefinitions="Auto,*">
                                <PathIcon Data="M20,8L12,13L4,8V6L12,11L20,6M20,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V6C22,4.89 21.1,4 20,4Z"
                                          Width="14" Height="14" Foreground="{DynamicResource BrushTextTertiary}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Email}" FontSize="13"
                                           Foreground="{DynamicResource BrushTextPrimary}" Margin="10,0,0,0"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </Grid>
                            
                            <!-- Phone (if available) -->
                            <Grid Margin="0,0,0,8" ColumnDefinitions="Auto,*"
                                  IsVisible="{Binding HasPhone}">
                                <PathIcon Data="M6.62,10.79C8.06,13.62 10.38,15.94 13.21,17.38L15.41,15.18C15.69,14.9 16.08,14.82 16.43,14.93C17.55,15.3 18.75,15.5 20,15.5A1,1 0 0,1 21,16.5V20A1,1 0 0,1 20,21A17,17 0 0,1 3,4A1,1 0 0,1 4,3H7.5A1,1 0 0,1 8.5,4C8.5,5.25 8.7,6.45 9.07,7.57C9.18,7.92 9.1,8.31 8.82,8.59L6.62,10.79Z"
                                          Width="14" Height="14" Foreground="{DynamicResource BrushTextTertiary}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Phone}" FontSize="13"
                                           Foreground="{DynamicResource BrushTextPrimary}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                            
                            <!-- DETAILS Section -->
                            <TextBlock Text="DETAILS" Classes="detail-section-header"/>
                            
                            <Grid Margin="0,0,0,6" ColumnDefinitions="80,*">
                                <TextBlock Text="Tenure" FontSize="12" Foreground="{DynamicResource BrushTextTertiary}"/>
                                <TextBlock Grid.Column="1" Text="{Binding TenureFromHireDate}" FontSize="12" FontWeight="Medium"
                                           Foreground="{DynamicResource BrushTextPrimary}"/>
                            </Grid>
                            
                            <Grid Margin="0,0,0,6" ColumnDefinitions="80,*">
                                <TextBlock Text="Hire Date" FontSize="12" Foreground="{DynamicResource BrushTextTertiary}"/>
                                <TextBlock Grid.Column="1" Text="{Binding HireDateDisplay}" FontSize="12" FontWeight="Medium"
                                           Foreground="{DynamicResource BrushTextPrimary}"/>
                            </Grid>
                            
                            <Grid Margin="0,0,0,6" ColumnDefinitions="80,*">
                                <TextBlock Text="Birthday" FontSize="12" Foreground="{DynamicResource BrushTextTertiary}"/>
                                <TextBlock Grid.Column="1" Text="{Binding BirthdayDisplay}" FontSize="12" FontWeight="Medium"
                                           Foreground="{DynamicResource BrushTextPrimary}"/>
                            </Grid>
                            
                            <!-- ACTIVITY Section -->
                            <TextBlock Text="ACTIVITY" Classes="detail-section-header"/>
                            
                            <Grid Margin="0,0,0,6" ColumnDefinitions="80,*">
                                <TextBlock Text="Tasks" FontSize="12" Foreground="{DynamicResource BrushTextTertiary}"/>
                                <TextBlock Grid.Column="1" FontSize="12" FontWeight="Medium"
                                           Foreground="{DynamicResource BrushTextPrimary}">
                                    <Run Text="{Binding OpenTaskCount}"/>
                                    <Run Text="open"/>
                                </TextBlock>
                            </Grid>
                            
                            <Grid Margin="0,0,0,6" ColumnDefinitions="80,*">
                                <TextBlock Text="Goals" FontSize="12" Foreground="{DynamicResource BrushTextTertiary}"/>
                                <TextBlock Grid.Column="1" FontSize="12" FontWeight="Medium"
                                           Foreground="{DynamicResource BrushTextPrimary}">
                                    <Run Text="{Binding ActiveGoalCount}"/>
                                    <Run Text="active"/>
                                </TextBlock>
                            </Grid>
                            
                            <Grid Margin="0,0,0,6" ColumnDefinitions="80,*">
                                <TextBlock Text="Last Mtg" FontSize="12" Foreground="{DynamicResource BrushTextTertiary}"/>
                                <TextBlock Grid.Column="1" Text="{Binding LastMeetingText}" FontSize="12" FontWeight="Medium"
                                           Foreground="{DynamicResource BrushTextPrimary}"/>
                            </Grid>
                            
                            <Grid Margin="0,0,0,6" ColumnDefinitions="80,*">
                                <TextBlock Text="Next Mtg" FontSize="12" Foreground="{DynamicResource BrushTextTertiary}"/>
                                <TextBlock Grid.Column="1" Text="{Binding NextMeetingText}" FontSize="12" FontWeight="Medium">
                                    <TextBlock.Foreground>
                                        <MultiBinding Converter="{StaticResource MeetingStatusColorConverter}">
                                            <Binding Path="NeedsAttention"/>
                                        </MultiBinding>
                                    </TextBlock.Foreground>
                                </TextBlock>
                            </Grid>
                            
                            <!-- SOCIAL Section (if any links) -->
                            <TextBlock Text="SOCIAL" Classes="detail-section-header"
                                       IsVisible="{Binding HasLinkedIn}"/>
                            
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"
                                        IsVisible="{Binding HasLinkedIn}">
                                <!-- LinkedIn -->
                                <Button Classes="icon-button" ToolTip.Tip="LinkedIn"
                                        IsVisible="{Binding HasLinkedIn}"
                                        Command="{Binding $parent[UserControl].((vm:CircleViewModel)DataContext).OpenUrlCommand}"
                                        CommandParameter="{Binding LinkedInUrl}">
                                    <PathIcon Data="M19 3A2 2 0 0 1 21 5V19A2 2 0 0 1 19 21H5A2 2 0 0 1 3 19V5A2 2 0 0 1 5 3H19M18.5 18.5V13.2A3.26 3.26 0 0 0 15.24 9.94C14.39 9.94 13.4 10.46 12.92 11.24V10.13H10.13V18.5H12.92V13.57C12.92 12.8 13.54 12.17 14.31 12.17A1.4 1.4 0 0 1 15.71 13.57V18.5H18.5M6.88 8.56A1.68 1.68 0 0 0 8.56 6.88C8.56 5.95 7.81 5.19 6.88 5.19A1.69 1.69 0 0 0 5.19 6.88C5.19 7.81 5.95 8.56 6.88 8.56M8.27 18.5V10.13H5.5V18.5H8.27Z"
                                              Width="20" Height="20" Foreground="#0A66C2"/>
                                </Button>
                                
                                <!-- X (Twitter) -->
                                <Button Classes="icon-button" ToolTip.Tip="X (Twitter)"
                                        IsVisible="{Binding HasXProfile}"
                                        Command="{Binding $parent[UserControl].((vm:CircleViewModel)DataContext).OpenUrlCommand}"
                                        CommandParameter="{Binding XProfileUrl}">
                                    <PathIcon Data="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
                                              Width="18" Height="18" Foreground="{DynamicResource BrushTextPrimary}"/>
                                </Button>
                            </StackPanel>
                            
                            <!-- NOTES Section (if any) -->
                            <TextBlock Text="NOTES" Classes="detail-section-header"
                                       IsVisible="{Binding Notes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <TextBlock Text="{Binding Notes}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource BrushTextSecondary}"
                                       IsVisible="{Binding Notes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            
                            <!-- Action Buttons -->
                            <StackPanel Margin="0,24,0,0" Spacing="8">
                                <Button Classes="action-button" HorizontalAlignment="Stretch"
                                        Command="{Binding $parent[UserControl].((vm:CircleViewModel)DataContext).ScheduleMeetingCommand}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="M19,19H5V8H19M16,1V3H8V1H6V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3H18V1M17,12H12V17H17V12Z"
                                                  Width="14" Height="14"/>
                                        <TextBlock Text="Schedule Meeting"/>
                                    </StackPanel>
                                </Button>
                                
                                <Button Classes="secondary-button" HorizontalAlignment="Stretch"
                                        Command="{Binding $parent[UserControl].((vm:CircleViewModel)DataContext).EditTeamMemberCommand}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"
                                                  Width="14" Height="14"/>
                                        <TextBlock Text="Edit Details"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            
                        </StackPanel>
                    </ScrollViewer>
                </Border>
                </Border>
            </Grid>
            
            <!-- =============== GOALS TAB =============== -->
            <Grid IsVisible="{Binding SelectedTab, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:CircleTab.Goals}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
                    <PathIcon Data="M5,21L7.5,13L1,9H8.5L11,1L13.5,9H21L14.5,13L17,21L11,16L5,21Z" 
                              Width="48" Height="48" Opacity="0.3"/>
                    <TextBlock Text="Team Goals" FontSize="18" FontWeight="Light" Opacity="0.5" HorizontalAlignment="Center"/>
                    <TextBlock Text="Goals management coming soon" FontSize="13" Opacity="0.3" HorizontalAlignment="Center"/>
                    <Button Command="{Binding AddGoalCommand}" Classes="action-button" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Width="14" Height="14"/>
                            <TextBlock Text="Add Goal"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
            
            <!-- =============== FEEDBACK TAB =============== -->
            <Grid IsVisible="{Binding SelectedTab, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:CircleTab.Feedback}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
                    <PathIcon Data="M20,2H4A2,2 0 0,0 2,4V22L6,18H20A2,2 0 0,0 22,16V4C22,2.89 21.1,2 20,2M6,9H18V11H6M14,14H6V12H14M18,8H6V6H18" 
                              Width="48" Height="48" Opacity="0.3"/>
                    <TextBlock Text="Team Feedback" FontSize="18" FontWeight="Light" Opacity="0.5" HorizontalAlignment="Center"/>
                    <TextBlock Text="Feedback management coming soon" FontSize="13" Opacity="0.3" HorizontalAlignment="Center"/>
                    <Button Command="{Binding GiveFeedbackCommand}" Classes="action-button" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Width="14" Height="14"/>
                            <TextBlock Text="Give Feedback"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
            
            <!-- =============== MEETINGS TAB =============== -->
            <Grid IsVisible="{Binding SelectedTab, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:CircleTab.Meetings}}"
                  RowDefinitions="Auto,*" ColumnDefinitions="*,Auto">
                
                <!-- Header Row: View Modes + Navigation + Actions -->
                <Grid Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,16" ColumnDefinitions="Auto,*,Auto,Auto">
                    
                    <!-- View Mode Toggle -->
                    <Border Grid.Column="0" Background="{DynamicResource BrushSurfaceAlt}" CornerRadius="8" Padding="4">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button Classes="view-mode-button"
                                    Classes.selected="{Binding MeetingsViewMode, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:MeetingsViewMode.Day}}"
                                    Command="{Binding SetMeetingsViewModeCommand}"
                                    CommandParameter="{x:Static vm:MeetingsViewMode.Day}">
                                <TextBlock Text="Day"/>
                            </Button>
                            <Button Classes="view-mode-button"
                                    Classes.selected="{Binding MeetingsViewMode, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:MeetingsViewMode.Week}}"
                                    Command="{Binding SetMeetingsViewModeCommand}"
                                    CommandParameter="{x:Static vm:MeetingsViewMode.Week}">
                                <TextBlock Text="Week"/>
                            </Button>
                            <Button Classes="view-mode-button"
                                    Classes.selected="{Binding MeetingsViewMode, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:MeetingsViewMode.Month}}"
                                    Command="{Binding SetMeetingsViewModeCommand}"
                                    CommandParameter="{x:Static vm:MeetingsViewMode.Month}">
                                <TextBlock Text="Month"/>
                            </Button>
                            <Button Classes="view-mode-button"
                                    Classes.selected="{Binding MeetingsViewMode, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:MeetingsViewMode.List}}"
                                    Command="{Binding SetMeetingsViewModeCommand}"
                                    CommandParameter="{x:Static vm:MeetingsViewMode.List}">
                                <TextBlock Text="List"/>
                            </Button>
                        </StackPanel>
                    </Border>
                    
                    <!-- Date Navigation -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                        <Button Classes="icon-button" Command="{Binding NavigatePreviousCommand}" ToolTip.Tip="Previous">
                            <PathIcon Data="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z" Width="16" Height="16"/>
                        </Button>
                        <Button Classes="secondary-button" Command="{Binding NavigateTodayCommand}" Padding="12,6">
                            <TextBlock Text="Today" FontSize="12"/>
                        </Button>
                        <Button Classes="icon-button" Command="{Binding NavigateNextCommand}" ToolTip.Tip="Next">
                            <PathIcon Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" Width="16" Height="16"/>
                        </Button>
                        <TextBlock Text="{Binding CurrentDateHeader}" FontSize="16" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    
                    <!-- Schedule Meeting Button -->
                    <Button Grid.Column="3" Command="{Binding ScheduleMeetingCommand}" Classes="action-button">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Width="14" Height="14"/>
                            <TextBlock Text="Schedule Meeting"/>
                        </StackPanel>
                    </Button>
                </Grid>
                
                <!-- Main Content Area + Detail Panel -->
                <Grid Grid.Row="1" Grid.Column="0" ColumnDefinitions="*,Auto" ClipToBounds="True">
                    
                    <!-- ===== LIST VIEW ===== -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                                  IsVisible="{Binding MeetingsViewMode, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:MeetingsViewMode.List}}">
                        <StackPanel Spacing="16" Margin="0,0,12,0">
                            <ItemsControl ItemsSource="{Binding GroupedMeetings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Spacing="8">
                                            <!-- Date Header -->
                                            <TextBlock Text="{Binding Date}" FontSize="14" FontWeight="SemiBold" 
                                                       Foreground="{DynamicResource BrushTextSecondary}" Margin="0,8,0,4"/>
                                            
                                            <!-- Meetings for this date -->
                                            <ItemsControl ItemsSource="{Binding Meetings}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Classes="meeting-card" Margin="0,0,0,8"
                                                                Tapped="MeetingCard_Tapped" Tag="{Binding}">
                                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                                <!-- Time -->
                                                                <StackPanel Grid.Column="0" Width="80" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding StartTimeDisplay}" FontSize="14" FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource BrushTextPrimary}"/>
                                                                    <TextBlock Text="{Binding DurationText}" FontSize="11"
                                                                               Foreground="{DynamicResource BrushTextTertiary}"/>
                                                                </StackPanel>
                                                                
                                                                <!-- Meeting Info -->
                                                                <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Medium"
                                                                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                                                                        <Border CornerRadius="4" Padding="6,2" Background="{Binding TypeColor}">
                                                                            <TextBlock Text="{Binding TypeDisplay}" FontSize="10" Foreground="White"/>
                                                                        </Border>
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding AttendeeCountDisplay}" FontSize="12"
                                                                               Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0"/>
                                                                </StackPanel>
                                                                
                                                                <!-- Attendee Avatars -->
                                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <ItemsControl ItemsSource="{Binding Attendees}" Margin="0,0,8,0">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <StackPanel Orientation="Horizontal" Spacing="-8"/>
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Border Width="28" Height="28" CornerRadius="14" 
                                                                                        Background="{DynamicResource BrushPrimary}"
                                                                                        BorderBrush="{DynamicResource BrushSurface}" BorderThickness="2">
                                                                                    <TextBlock Text="{Binding Initials}" FontSize="10" FontWeight="SemiBold"
                                                                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                    
                                                                    <!-- Video link indicator -->
                                                                    <PathIcon IsVisible="{Binding HasVideoLink}"
                                                                              Data="M17,10.5V7A1,1 0 0,0 16,6H4A1,1 0 0,0 3,7V17A1,1 0 0,0 4,18H16A1,1 0 0,0 17,17V13.5L21,17.5V6.5L17,10.5Z"
                                                                              Width="16" Height="16" Foreground="{DynamicResource BrushPrimary}"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    
                    <!-- ===== DAY VIEW ===== -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                                  IsVisible="{Binding MeetingsViewMode, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:MeetingsViewMode.Day}}">
                        <Grid ColumnDefinitions="60,*" Margin="0,0,12,0">
                            <!-- Hour Labels -->
                            <ItemsControl Grid.Column="0" ItemsSource="{Binding CalendarHours}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Height="60" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
                                            <TextBlock Text="{Binding DisplayText}" FontSize="11" 
                                                       Foreground="{DynamicResource BrushTextTertiary}"
                                                       VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            
                            <!-- Day Column with meetings -->
                            <Grid Grid.Column="1">
                                <!-- Hour grid lines -->
                                <ItemsControl ItemsSource="{Binding CalendarHours}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Height="60" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                
                                <!-- Meetings positioned absolutely -->
                                <ItemsControl ItemsSource="{Binding DayMeetings}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Classes="calendar-meeting" Background="{Binding TypeColor}"
                                                    Tapped="MeetingCard_Tapped" Tag="{Binding}"
                                                    Canvas.Top="{Binding CalendarTopOffset}"
                                                    Width="280" Height="{Binding CalendarHeight}">
                                                <StackPanel Margin="4,2">
                                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" 
                                                               Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding TimeRangeDisplay}" FontSize="10" 
                                                               Foreground="White" Opacity="0.9"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                    
                    <!-- ===== WEEK VIEW ===== -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                                  IsVisible="{Binding MeetingsViewMode, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:MeetingsViewMode.Week}}">
                        <Grid RowDefinitions="Auto,*" Margin="0,0,12,0">
                            <!-- Day Headers -->
                            <Grid Grid.Row="0" ColumnDefinitions="60,*,*,*,*,*,*,*" Margin="0,0,0,8">
                                <Border Grid.Column="0"/> <!-- Spacer for time column -->
                                <ItemsControl Grid.Column="1" Grid.ColumnSpan="7" ItemsSource="{Binding WeekDays}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="7"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding DayName}" FontSize="11" 
                                                           Foreground="{DynamicResource BrushTextTertiary}" HorizontalAlignment="Center"/>
                                                <Border CornerRadius="16" Padding="8,4" Margin="0,4,0,0"
                                                        Background="{Binding IsToday, Converter={StaticResource BoolToHighlightBackgroundConverter}}">
                                                    <TextBlock Text="{Binding DayNumber}" FontSize="14" FontWeight="SemiBold"
                                                               Foreground="{Binding IsToday, Converter={StaticResource BoolToForegroundConverter}}"
                                                               HorizontalAlignment="Center"/>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                            
                            <!-- Week Grid -->
                            <Grid Grid.Row="1" ColumnDefinitions="60,*">
                                <!-- Hour Labels -->
                                <ItemsControl Grid.Column="0" ItemsSource="{Binding CalendarHours}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Height="60" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
                                                <TextBlock Text="{Binding DisplayText}" FontSize="11" 
                                                           Foreground="{DynamicResource BrushTextTertiary}"
                                                           VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                
                                <!-- Day Columns -->
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding WeekDays}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="7"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <!-- Hour grid lines -->
                                                <ItemsControl ItemsSource="{Binding $parent[UserControl].((vm:CircleViewModel)DataContext).CalendarHours}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Height="60" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,1,1"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                
                                                <!-- Meetings for this day -->
                                                <ItemsControl ItemsSource="{Binding Meetings}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <Canvas/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Classes="calendar-meeting" Background="{Binding TypeColor}"
                                                                    Canvas.Top="{Binding CalendarTopOffset}"
                                                                    Width="90" Height="{Binding CalendarHeight}"
                                                                    ToolTip.Tip="{Binding Title}"
                                                                    Tapped="MeetingCard_Tapped" Tag="{Binding}">
                                                                <TextBlock Text="{Binding Title}" FontSize="10" FontWeight="Medium" 
                                                                           Foreground="White" TextTrimming="CharacterEllipsis"
                                                                           Margin="4,2"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                    
                    <!-- ===== MONTH VIEW ===== -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                                  IsVisible="{Binding MeetingsViewMode, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:MeetingsViewMode.Month}}">
                        <Grid RowDefinitions="Auto,*" Margin="0,0,12,0">
                            <!-- Day of Week Headers -->
                            <UniformGrid Grid.Row="0" Columns="7" Margin="0,0,0,8">
                                <TextBlock Text="Sun" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource BrushTextTertiary}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Mon" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource BrushTextTertiary}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Tue" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource BrushTextTertiary}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Wed" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource BrushTextTertiary}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Thu" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource BrushTextTertiary}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Fri" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource BrushTextTertiary}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Sat" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource BrushTextTertiary}" HorizontalAlignment="Center"/>
                            </UniformGrid>
                            
                            <!-- Calendar Grid -->
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding CalendarDays}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="7" Rows="6"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="calendar-day" 
                                                Classes.today="{Binding IsToday}"
                                                Classes.other-month="{Binding !IsCurrentMonth}">
                                            <StackPanel>
                                                <!-- Day Number -->
                                                <TextBlock Text="{Binding DayNumber}" FontSize="12" FontWeight="Medium"
                                                           Foreground="{DynamicResource BrushTextPrimary}"
                                                           HorizontalAlignment="Right" Margin="0,0,4,4"/>
                                                
                                                <!-- Meetings (max 3) -->
                                                <ItemsControl ItemsSource="{Binding Meetings}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Classes="calendar-meeting" Background="{Binding TypeColor}"
                                                                    Tapped="MeetingCard_Tapped" Tag="{Binding}">
                                                                <TextBlock FontSize="9" Foreground="White" TextTrimming="CharacterEllipsis" Margin="2,0">
                                                                    <Run Text="{Binding ShortTimeDisplay}"/>
                                                                    <Run Text="{Binding Title}"/>
                                                                </TextBlock>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                
                                                <!-- More indicator -->
                                                <TextBlock IsVisible="{Binding HasMoreMeetings}" Text="+ more" FontSize="9"
                                                           Foreground="{DynamicResource BrushTextTertiary}" Margin="2,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                    
                    <!-- ===== MEETING DETAIL PANEL ===== -->
                    <Border Grid.Column="1" Width="{Binding IsMeetingDetailOpen, Converter={StaticResource BoolToWidthConverter}}"
                            ClipToBounds="True">
                        <Border Classes="detail-panel" Classes.open="{Binding IsMeetingDetailOpen}" 
                                Width="320" Margin="8,0,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel DataContext="{Binding SelectedMeeting}" Margin="0,0,18,0">
                                
                                <!-- Close Button -->
                                <Button Classes="icon-button" HorizontalAlignment="Right" 
                                        ToolTip.Tip="Close"
                                        Command="{Binding $parent[UserControl].((vm:CircleViewModel)DataContext).CloseMeetingDetailCommand}">
                                    <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                              Width="16" Height="16" Foreground="{DynamicResource BrushTextSecondary}"/>
                                </Button>
                                
                                <!-- Meeting Header -->
                                <StackPanel Margin="0,0,0,20">
                                    <Border CornerRadius="6" Padding="8,4" Background="{Binding TypeColor}" 
                                            HorizontalAlignment="Left" Margin="0,0,0,12">
                                        <TextBlock Text="{Binding TypeDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                    </Border>
                                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold"
                                               Foreground="{DynamicResource BrushTextPrimary}" TextWrapping="Wrap"/>
                                </StackPanel>
                                
                                <!-- TIME Section -->
                                <TextBlock Text="TIME" Classes="detail-section-header"/>
                                <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,8">
                                    <PathIcon Data="M12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22C6.47,22 2,17.5 2,12A10,10 0 0,1 12,2M12.5,7V12.25L17,14.92L16.25,16.15L11,13V7H12.5Z"
                                              Width="14" Height="14" Foreground="{DynamicResource BrushTextTertiary}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding ScheduledText}" FontSize="13" FontWeight="Medium"
                                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                                        <TextBlock FontSize="12" Foreground="{DynamicResource BrushTextSecondary}">
                                            <Run Text="{Binding TimeRangeDisplay}"/>
                                            <Run Text="·"/>
                                            <Run Text="{Binding DurationText}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                                
                                <!-- LOCATION Section -->
                                <StackPanel IsVisible="{Binding HasLocation}">
                                    <TextBlock Text="LOCATION" Classes="detail-section-header"/>
                                    <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,8">
                                        <PathIcon Data="M12,11.5A2.5,2.5 0 0,1 9.5,9A2.5,2.5 0 0,1 12,6.5A2.5,2.5 0 0,1 14.5,9A2.5,2.5 0 0,1 12,11.5M12,2A7,7 0 0,0 5,9C5,14.25 12,22 12,22C12,22 19,14.25 19,9A7,7 0 0,0 12,2Z"
                                                  Width="14" Height="14" Foreground="{DynamicResource BrushTextTertiary}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Location}" FontSize="13"
                                                   Foreground="{DynamicResource BrushTextPrimary}" Margin="10,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                                
                                <!-- VIDEO LINK Section -->
                                <StackPanel IsVisible="{Binding HasVideoLink}">
                                    <TextBlock Text="VIDEO CALL" Classes="detail-section-header"/>
                                    <Button Classes="secondary-button" HorizontalAlignment="Left"
                                            Command="{Binding $parent[UserControl].((vm:CircleViewModel)DataContext).OpenUrlCommand}"
                                            CommandParameter="{Binding VideoLink}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <PathIcon Data="M17,10.5V7A1,1 0 0,0 16,6H4A1,1 0 0,0 3,7V17A1,1 0 0,0 4,18H16A1,1 0 0,0 17,17V13.5L21,17.5V6.5L17,10.5Z"
                                                      Width="14" Height="14"/>
                                            <TextBlock Text="Join Meeting"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                
                                <!-- ATTENDEES Section -->
                                <TextBlock Text="ATTENDEES" Classes="detail-section-header"/>
                                <TextBlock Text="{Binding AttendeeCountDisplay}" FontSize="12" 
                                           Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding Attendees}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,8">
                                                <Border Width="32" Height="32" CornerRadius="16" 
                                                        Background="{DynamicResource BrushPrimary}">
                                                    <TextBlock Text="{Binding Initials}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium"
                                                               Foreground="{DynamicResource BrushTextPrimary}"/>
                                                    <TextBlock Text="{Binding Email}" FontSize="11"
                                                               Foreground="{DynamicResource BrushTextTertiary}"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                
                                <!-- AGENDA Section -->
                                <TextBlock Text="AGENDA" Classes="detail-section-header"/>
                                <ItemsControl ItemsSource="{Binding AgendaItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
                                                <CheckBox IsChecked="{Binding IsCompleted}"/>
                                                <TextBlock Text="{Binding Title}" FontSize="13"
                                                           Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                
                                <!-- NOTES Section -->
                                <TextBlock Text="NOTES" Classes="detail-section-header"/>
                                <TextBlock Text="{Binding Notes}" FontSize="13" TextWrapping="Wrap"
                                           Foreground="{DynamicResource BrushTextSecondary}"
                                           IsVisible="{Binding Notes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                <TextBlock Text="No notes yet" FontSize="13" Opacity="0.5"
                                           IsVisible="{Binding Notes, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
                                
                                <!-- Actions -->
                                <StackPanel Margin="0,20,0,0" Spacing="8">
                                    <Button Classes="secondary-button" HorizontalContentAlignment="Left">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <PathIcon Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"
                                                      Width="14" Height="14"/>
                                            <TextBlock Text="Edit Meeting"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="secondary-button" HorizontalContentAlignment="Left">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <PathIcon Data="M19,13H5V11H19V13Z"
                                                      Width="14" Height="14" Foreground="#DC2626"/>
                                            <TextBlock Text="Cancel Meeting" Foreground="#DC2626"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                
                            </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Border>
                    
                </Grid>
            </Grid>
            
            <!-- Loading State -->
            <Border IsVisible="{Binding IsLoading}" Background="{DynamicResource BrushSurface}" 
                    CornerRadius="8" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ProgressBar IsIndeterminate="True" Width="200"/>
                    <TextBlock Text="Loading..." Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            
            <!-- Empty State (Team tab) -->
            <Border IsVisible="{Binding FilteredMemberCount, Converter={StaticResource EqualToZeroConverter}}"
                    Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                    IsEnabled="{Binding !IsLoading}">
                <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <PathIcon Data="M12,5.5A3.5,3.5 0 0,1 15.5,9A3.5,3.5 0 0,1 12,12.5A3.5,3.5 0 0,1 8.5,9A3.5,3.5 0 0,1 12,5.5M5,8C5.56,8 6.08,8.15 6.53,8.42C6.38,9.85 6.8,11.27 7.66,12.38C7.16,13.34 6.16,14 5,14A3,3 0 0,1 2,11A3,3 0 0,1 5,8M19,8A3,3 0 0,1 22,11A3,3 0 0,1 19,14C17.84,14 16.84,13.34 16.34,12.38C17.2,11.27 17.62,9.85 17.47,8.42C17.92,8.15 18.44,8 19,8M5.5,18.25C5.5,16.18 8.41,14.5 12,14.5C15.59,14.5 18.5,16.18 18.5,18.25V20H5.5V18.25Z"
                              Width="48" Height="48" Opacity="0.2"/>
                    <TextBlock Text="No team members found" FontSize="14" Foreground="{DynamicResource BrushTextTertiary}" HorizontalAlignment="Center"/>
                    <Button Command="{Binding AddTeamMemberCommand}" Classes="action-button" HorizontalAlignment="Center">
                        <TextBlock Text="Add your first team member"/>
                    </Button>
                </StackPanel>
            </Border>
            
            <!-- Error State -->
            <Border IsVisible="{Binding HasError}" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" 
                    CornerRadius="8" Padding="16" VerticalAlignment="Top" HorizontalAlignment="Stretch">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
