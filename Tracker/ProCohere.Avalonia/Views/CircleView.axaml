<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ProCohere.Avalonia.ViewModels"
             xmlns:models="using:ProCohere.Avalonia.Models"
             xmlns:controls="using:ProCohere.Avalonia.Views.Controls"
             xmlns:asyncImageLoader="using:AsyncImageLoader"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="ProCohere.Avalonia.Views.CircleView"
             x:DataType="vm:CircleViewModel">
    
    <Design.DataContext>
        <vm:CircleViewModel/>
    </Design.DataContext>

    <UserControl.Styles>
        <!-- Tab Button Style -->
        <Style Selector="Button.tab-button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style Selector="Button.tab-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        </Style>
        <Style Selector="Button.tab-button.selected">
            <Setter Property="Foreground" Value="{DynamicResource BrushPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        
        <!-- Member Card Style -->
        <Style Selector="Border.member-card">
            <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Border.member-card:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushHighlight}"/>
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}"/>
        </Style>
        <Style Selector="Border.member-card.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        
        <!-- Compact Member Card (Tree View) -->
        <Style Selector="Border.member-card-compact">
            <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Border.member-card-compact:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushHighlight}"/>
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}"/>
        </Style>
        <Style Selector="Border.member-card-compact.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        
        <!-- Detail Panel Style - with slide animation -->
        <Style Selector="Border.detail-panel">
            <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20,20,6,20"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RenderTransform" Value="translate(320px, 0)"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="CubicEaseOut"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.detail-panel.open">
            <Setter Property="RenderTransform" Value="translate(0, 0)"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        
        <!-- Detail Section Header -->
        <Style Selector="TextBlock.detail-section-header">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextTertiary}"/>
            <Setter Property="Margin" Value="0,16,0,8"/>
        </Style>
        
        <!-- Stat Filter Card -->
        <Style Selector="Border.stat-filter">
            <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Border.stat-filter:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}"/>
        </Style>
        <Style Selector="Border.stat-filter.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}"/>
        </Style>
        
        <!-- Meeting View Mode Button -->
        <Style Selector="Button.view-mode-button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="Button.view-mode-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}"/>
        </Style>
        <Style Selector="Button.view-mode-button.selected">
            <Setter Property="Background" Value="{DynamicResource BrushPrimary}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextOnPrimary}"/>
        </Style>
        
        <!-- Team View Toggle Button (Flat/Tree) -->
        <Style Selector="Button.view-toggle-button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextTertiary}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="MinHeight" Value="24"/>
        </Style>
        <Style Selector="Button.view-toggle-button PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextTertiary}"/>
        </Style>
        <Style Selector="Button.view-toggle-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
        </Style>
        <Style Selector="Button.view-toggle-button:pointerover PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
        </Style>
        <Style Selector="Button.view-toggle-button.selected">
            <Setter Property="Background" Value="{DynamicResource BrushPrimary}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextOnPrimary}"/>
        </Style>
        <Style Selector="Button.view-toggle-button.selected PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextOnPrimary}"/>
        </Style>
        <Style Selector="Button.view-toggle-button.selected:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushPrimaryHover}"/>
        </Style>
        
        <!-- View Team Button (on manager cards) - with explicit Template for hover -->
        <Style Selector="Button.view-team-button">
            <Setter Property="Background" Value="{DynamicResource BrushPrimarySubtle}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushPrimary}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.view-team-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushPrimary}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextOnPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}"/>
        </Style>
        <Style Selector="Button.view-team-button:pointerover PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextOnPrimary}"/>
        </Style>
        <Style Selector="Button.view-team-button:pointerover TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextOnPrimary}"/>
        </Style>
        
        <!-- Meeting Card Style -->
        <Style Selector="Border.meeting-card">
            <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Border.meeting-card:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushHighlight}"/>
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}"/>
        </Style>
        
        <!-- Calendar Day Cell -->
        <Style Selector="Border.calendar-day">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="MinHeight" Value="80"/>
        </Style>
        <Style Selector="Border.calendar-day.today">
            <Setter Property="Background" Value="#10406D3A"/>
        </Style>
        <Style Selector="Border.calendar-day.other-month">
            <Setter Property="Opacity" Value="0.4"/>
        </Style>
        
        <!-- Calendar Meeting Item (compact) -->
        <Style Selector="Border.calendar-meeting">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        
        <!-- Goal Card Style -->
        <Style Selector="Border.goal-card">
            <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Border.goal-card:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushHighlight}"/>
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}"/>
        </Style>
        <Style Selector="Border.goal-card.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        
        <!-- Feedback Card Style -->
        <Style Selector="Border.feedback-card">
            <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Border.feedback-card:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushHighlight}"/>
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}"/>
        </Style>
        <Style Selector="Border.feedback-card.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        
        <!-- Metric Card Style (compact row, signal-first per CIRCLE_METRICS_SPEC) -->
        <Style Selector="Border.metric-card">
            <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Border.metric-card:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushHighlight}"/>
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}"/>
        </Style>
        <Style Selector="Border.metric-card.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        
        <!-- Progress Bar Style -->
        <Style Selector="ProgressBar.goal-progress">
            <Setter Property="Height" Value="8"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushPrimary}"/>
        </Style>
        
        <!-- Flyout Vertical Tab Style -->
        <Style Selector="Button.flyout-tab">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextTertiary}"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="0,0,2,0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="6,0,0,6"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Width" Value="70"/>
        </Style>
        <Style Selector="Button.flyout-tab:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        </Style>
        <Style Selector="Button.flyout-tab.selected">
            <Setter Property="Foreground" Value="{DynamicResource BrushPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,*">
        
        <!-- Row 0: Header (subtitle only - page title in MainWindow header) -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Grid.Column="0" FontSize="13" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center">
                <Run Text="Your team of"/>
                <Run Text="{Binding TotalMemberCount}" FontWeight="SemiBold"/>
                <Run Text="people"/>
            </TextBlock>
            
            <!-- Add Member Button -->
            <Button Grid.Column="1" Command="{Binding AddTeamMemberCommand}" Classes="action-button">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="M15,14C12.33,14 7,15.33 7,18V20H23V18C23,15.33 17.67,14 15,14M15,12A4,4 0 0,0 19,8A4,4 0 0,0 15,4A4,4 0 0,0 11,8A4,4 0 0,0 15,12M5,9.59L7.12,7.46L8.54,8.88L6.41,11L8.54,13.12L7.12,14.54L5,12.41L2.88,14.54L1.46,13.12L3.59,11L1.46,8.88L2.88,7.46L5,9.59Z" 
                              Width="16" Height="16"/>
                    <TextBlock Text="Add Member" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
        
        <!-- Row 1: Tab Bar -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Classes="tab-button"
                        Classes.selected="{Binding SelectedTab, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:CircleTab.Team}}"
                        Command="{Binding SelectTabCommand}"
                        CommandParameter="{x:Static vm:CircleTab.Team}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="M12,5.5A3.5,3.5 0 0,1 15.5,9A3.5,3.5 0 0,1 12,12.5A3.5,3.5 0 0,1 8.5,9A3.5,3.5 0 0,1 12,5.5M5,8C5.56,8 6.08,8.15 6.53,8.42C6.38,9.85 6.8,11.27 7.66,12.38C7.16,13.34 6.16,14 5,14A3,3 0 0,1 2,11A3,3 0 0,1 5,8M19,8A3,3 0 0,1 22,11A3,3 0 0,1 19,14C17.84,14 16.84,13.34 16.34,12.38C17.2,11.27 17.62,9.85 17.47,8.42C17.92,8.15 18.44,8 19,8M5.5,18.25C5.5,16.18 8.41,14.5 12,14.5C15.59,14.5 18.5,16.18 18.5,18.25V20H5.5V18.25Z" 
                                  Width="16" Height="16"/>
                        <TextBlock Text="Team"/>
                    </StackPanel>
                </Button>
                
                <Button Classes="tab-button"
                        Classes.selected="{Binding SelectedTab, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:CircleTab.Goals}}"
                        Command="{Binding SelectTabCommand}"
                        CommandParameter="{x:Static vm:CircleTab.Goals}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="M5,21L7.5,13L1,9H8.5L11,1L13.5,9H21L14.5,13L17,21L11,16L5,21Z" 
                                  Width="16" Height="16"/>
                        <TextBlock Text="Goals"/>
                    </StackPanel>
                </Button>
                
                <Button Classes="tab-button"
                        Classes.selected="{Binding SelectedTab, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:CircleTab.Metrics}}"
                        Command="{Binding SelectTabCommand}"
                        CommandParameter="{x:Static vm:CircleTab.Metrics}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="M16,11.78L20.24,4.45L21.97,5.45L16.74,14.5L10.23,10.75L5.46,19H22V21H2V3H4V17.54L9.5,8L16,11.78Z" 
                                  Width="16" Height="16"/>
                        <TextBlock Text="Metrics"/>
                    </StackPanel>
                </Button>
                
                <Button Classes="tab-button"
                        Classes.selected="{Binding SelectedTab, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:CircleTab.Feedback}}"
                        Command="{Binding SelectTabCommand}"
                        CommandParameter="{x:Static vm:CircleTab.Feedback}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="M20,2H4A2,2 0 0,0 2,4V22L6,18H20A2,2 0 0,0 22,16V4C22,2.89 21.1,2 20,2M6,9H18V11H6M14,14H6V12H14M18,8H6V6H18" 
                                  Width="16" Height="16"/>
                        <TextBlock Text="Feedback"/>
                    </StackPanel>
                </Button>
                
                <Button Classes="tab-button"
                        Classes.selected="{Binding SelectedTab, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:CircleTab.Meetings}}"
                        Command="{Binding SelectTabCommand}"
                        CommandParameter="{x:Static vm:CircleTab.Meetings}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="M19,19H5V8H19M16,1V3H8V1H6V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3H18V1M17,12H12V17H17V12Z" 
                                  Width="16" Height="16"/>
                        <TextBlock Text="Meetings"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
        
        <!-- Row 2: Search & Filters (Team tab only) -->
        <Grid Grid.Row="2" Margin="0,0,0,16"
              IsVisible="{Binding SelectedTab, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:CircleTab.Team}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- Search Box -->
            <Border Grid.Column="0" Background="{DynamicResource BrushSurface}"
                    CornerRadius="8" Padding="10,8"
                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                <Grid ColumnDefinitions="Auto,*">
                    <PathIcon Grid.Column="0"
                              Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                              Width="16" Height="16"
                              Foreground="{DynamicResource BrushTextTertiary}"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding SearchText, Mode=TwoWay}"
                             Watermark="Search team members..."
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{DynamicResource BrushTextPrimary}"
                             FontSize="13"
                             Margin="8,0,0,0"
                             VerticalAlignment="Center"/>
                </Grid>
            </Border>
            
            <!-- Filter Stats (clickable) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="16,0,0,0">
                <!-- All -->
                <Border Classes="stat-filter"
                        Classes.selected="{Binding MemberFilter, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:TeamMemberFilter.All}}"
                        Tapped="StatFilter_All_Tapped">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding TotalMemberCountText}" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                        <TextBlock Text="All" FontSize="12" 
                                   Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                
                <!-- Active -->
                <Border Classes="stat-filter"
                        Classes.selected="{Binding MemberFilter, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:TeamMemberFilter.Active}}"
                        Tapped="StatFilter_Active_Tapped">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding ActiveMemberCountText}" FontSize="18" FontWeight="Bold"
                                   Foreground="#10B981"/>
                        <TextBlock Text="Active" FontSize="12" 
                                   Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                
                <!-- Needs Attention (meetings overdue) -->
                <Border Classes="stat-filter"
                        Classes.selected="{Binding MemberFilter, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:TeamMemberFilter.NeedsAttention}}"
                        Tapped="StatFilter_NeedsAttention_Tapped">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding MeetingsOverdueCountText}" FontSize="18" FontWeight="Bold"
                                   Foreground="#EF4444"/>
                        <TextBlock Text="Needs Attention" FontSize="12" 
                                   Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            
            <!-- View Toggle + Showing count -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <!-- Flat/Tree Toggle -->
                <Border Background="{DynamicResource BrushSurface}" CornerRadius="6" Padding="3"
                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Classes="view-toggle-button"
                                Classes.selected="{Binding IsFlatView}"
                                Command="{Binding SetViewModeCommand}"
                                CommandParameter="{x:Static vm:TeamViewMode.Flat}"
                                ToolTip.Tip="Flat View">
                            <PathIcon Data="M3,4H21V8H3V4M3,10H21V14H3V10M3,16H21V20H3V16Z"
                                      Width="14" Height="14"/>
                        </Button>
                        <Button Classes="view-toggle-button"
                                Classes.selected="{Binding IsTreeView}"
                                Command="{Binding SetViewModeCommand}"
                                CommandParameter="{x:Static vm:TeamViewMode.Tree}"
                                ToolTip.Tip="Hierarchy View">
                            <PathIcon Data="M12,5A2,2 0 0,1 14,7A2,2 0 0,1 12,9A2,2 0 0,1 10,7A2,2 0 0,1 12,5M12,11.5C12.83,11.5 13.63,11.57 14.38,11.7L12,18.12L9.62,11.7C10.37,11.57 11.17,11.5 12,11.5M3,19A2,2 0 0,1 5,17A2,2 0 0,1 7,19A2,2 0 0,1 5,21A2,2 0 0,1 3,19M17,19A2,2 0 0,1 19,17A2,2 0 0,1 21,19A2,2 0 0,1 19,21A2,2 0 0,1 17,19M10,19A2,2 0 0,1 12,17A2,2 0 0,1 14,19A2,2 0 0,1 12,21A2,2 0 0,1 10,19Z"
                                      Width="14" Height="14"/>
                        </Button>
                    </StackPanel>
                </Border>
                
                <!-- Showing count -->
                <TextBlock VerticalAlignment="Center"
                           Foreground="{DynamicResource BrushTextTertiary}" FontSize="12">
                    <Run Text="Showing"/>
                    <Run Text="{Binding FilteredMemberCount}" FontWeight="SemiBold"/>
                    <Run Text="of"/>
                    <Run Text="{Binding TotalMemberCount}" FontWeight="SemiBold"/>
                </TextBlock>
            </StackPanel>
        </Grid>
        
        <!-- Row 3: Content Area -->
        <Grid Grid.Row="3" RowDefinitions="Auto,*">
            
            <!-- Manager Filter Banner - More Prominent -->
            <Border Grid.Row="0" Background="{DynamicResource BrushSecondary}" 
                    CornerRadius="8" Padding="16,12" Margin="0,0,0,16"
                    IsVisible="{Binding HasManagerFilter}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- Filter Icon -->
                    <Border Grid.Column="0" Background="{DynamicResource BrushSecondaryHover}" CornerRadius="6" Padding="8" VerticalAlignment="Center">
                        <PathIcon Data="M3,4H21V6H3V4M6,9H18V11H6V9M10,14H14V16H10V14Z"
                                  Width="18" Height="18" Foreground="{DynamicResource BrushTextOnSecondary}"/>
                    </Border>
                    
                    <!-- Filter Text -->
                    <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                        <TextBlock Text="Filtered View" FontSize="11" FontWeight="Medium" 
                                   Foreground="{DynamicResource BrushTextTertiary}"/>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Showing" Foreground="{DynamicResource BrushTextOnSecondary}" FontSize="14"/>
                            <TextBlock Text="{Binding FilterByManagerName}" Foreground="{DynamicResource BrushHighlight}" 
                                       FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="and their direct reports" Foreground="{DynamicResource BrushTextOnSecondary}" FontSize="14"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <!-- Clear Button with hover effect -->
                    <Button Grid.Column="2" 
                            Command="{Binding ClearManagerFilterCommand}"
                            FontWeight="SemiBold" FontSize="13"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="PART_Border" Background="{DynamicResource BrushButtonSurface}" CornerRadius="6" Padding="16,8">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                                  Width="12" Height="12" Foreground="{DynamicResource BrushSecondary}"/>
                                        <TextBlock Text="Show All Team" Foreground="{DynamicResource BrushSecondary}" 
                                                   FontWeight="SemiBold" FontSize="13"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Styles>
                            <Style Selector="Button:pointerover /template/ Border#PART_Border">
                                <Setter Property="Background" Value="{DynamicResource BrushButtonSurfaceHover}"/>
                            </Style>
                            <Style Selector="Button:pressed /template/ Border#PART_Border">
                                <Setter Property="Background" Value="{DynamicResource BrushButtonSurfacePressed}"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                </Grid>
            </Border>
            
            <!-- =============== TEAM TAB =============== -->
            <Grid Grid.Row="1" IsVisible="{Binding SelectedTab, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:CircleTab.Team}}"
                  ColumnDefinitions="*,Auto" ClipToBounds="True">
                
                <!-- Cards Grid - add right margin when panel is open -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" 
                              Padding="0,0,12,0">
                    <Grid>
                        <!-- FLAT VIEW: Card Grid -->
                        <ItemsControl ItemsSource="{Binding FilteredTeamMembers}" Margin="0,0,4,0"
                                      IsVisible="{Binding IsFlatView}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="member-card" Width="280" Margin="0,0,12,12"
                                            Classes.selected="{Binding IsSelected}"
                                            Tapped="MemberCard_Tapped"
                                            DoubleTapped="MemberCard_DoubleTapped" Tag="{Binding}">
                                        <Grid RowDefinitions="Auto,Auto,Auto,Auto">
                                            
                                            <!-- Header: Avatar + Name + Status -->
                                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <!-- Avatar with image or initials -->
                                                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24" ClipToBounds="True">
                                                    <Panel>
                                                        <!-- Initials fallback -->
                                                        <Border Background="{DynamicResource BrushPrimary}" CornerRadius="24"
                                                                IsVisible="{Binding UserAvatarUrl, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                                                            <TextBlock Text="{Binding Initials}" FontSize="16" FontWeight="SemiBold"
                                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <!-- Avatar image -->
                                                        <Image asyncImageLoader:ImageLoader.Source="{Binding UserAvatarUrl}" Stretch="UniformToFill" Width="48" Height="48"
                                                               IsVisible="{Binding UserAvatarUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                    </Panel>
                                                </Border>
                                                
                                                <!-- Name + Title + Hierarchy -->
                                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FullName}" FontSize="14" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding JobTitle}" FontSize="11"
                                                               Foreground="{DynamicResource BrushTextSecondary}" TextTrimming="CharacterEllipsis"/>
                                                    <!-- Hierarchy Info -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0" Spacing="8">
                                                        <TextBlock FontSize="10" Foreground="{DynamicResource BrushTextTertiary}"
                                                                   IsVisible="{Binding ManagerName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                            <Run Text="Reports to: "/><Run Text="{Binding ManagerName}" FontWeight="Medium"/>
                                                        </TextBlock>
                                                        <!-- Clickable View Team Button -->
                                                        <Button Classes="view-team-button"
                                                                IsVisible="{Binding IsManager}"
                                                                Tapped="ManagerBadge_Tapped"
                                                                Tag="{Binding}">
                                                            <ToolTip.Tip>
                                                                <TextBlock Text="View this person's team" Foreground="#1F2937"/>
                                                            </ToolTip.Tip>
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <PathIcon Data="M16,13C15.71,13 15.38,13 15.03,13.05C16.19,13.89 17,15 17,16.5V19H23V16.5C23,14.17 18.33,13 16,13M8,13C5.67,13 1,14.17 1,16.5V19H15V16.5C15,14.17 10.33,13 8,13M8,11A3,3 0 0,0 11,8A3,3 0 0,0 8,5A3,3 0 0,0 5,8A3,3 0 0,0 8,11M16,11A3,3 0 0,0 19,8A3,3 0 0,0 16,5A3,3 0 0,0 13,8A3,3 0 0,0 16,11Z"
                                                                          Width="12" Height="12" Foreground="{DynamicResource BrushPrimary}"/>
                                                                <TextBlock FontSize="10" Foreground="{DynamicResource BrushPrimary}" FontWeight="SemiBold">
                                                                    <Run Text="{Binding DirectReportCount}"/><Run Text=" team"/>
                                                                </TextBlock>
                                                                <PathIcon Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z"
                                                                          Width="10" Height="10" Foreground="{DynamicResource BrushPrimary}"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </StackPanel>
                                                
                                                <!-- Status Badge -->
                                                <Border Grid.Column="2" CornerRadius="10" Padding="8,3" VerticalAlignment="Top">
                                                    <Border.Background>
                                                        <MultiBinding Converter="{StaticResource BoolToColorConverter}">
                                                            <Binding Path="IsActive"/>
                                                        </MultiBinding>
                                                    </Border.Background>
                                                    <TextBlock Text="{Binding StatusDisplay}" FontSize="9" FontWeight="SemiBold" Foreground="White"/>
                                                </Border>
                                            </Grid>
                                            
                                            <!-- Stats Row -->
                                            <Border Grid.Row="1" Background="{DynamicResource BrushBackground}"
                                                    CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
                                                <Grid ColumnDefinitions="*,Auto,*,Auto,*">
                                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding Tenure}" FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Tenure" FontSize="9"
                                                                   Foreground="{DynamicResource BrushTextTertiary}" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                    
                                                    <Border Grid.Column="1" Width="1" Background="{DynamicResource BrushBorder}" Margin="8,2"/>
                                                    
                                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding OpenTaskCount}" FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Tasks" FontSize="9"
                                                                   Foreground="{DynamicResource BrushTextTertiary}" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                    
                                                    <Border Grid.Column="3" Width="1" Background="{DynamicResource BrushBorder}" Margin="8,2"/>
                                                    
                                                    <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding ActiveGoalCount}" FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Goals" FontSize="9"
                                                                   Foreground="{DynamicResource BrushTextTertiary}" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            
                                            <!-- Meeting Status -->
                                            <Grid Grid.Row="2" Margin="0,0,0,12" ColumnDefinitions="*,*">
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Last Meeting" FontSize="9" Foreground="{DynamicResource BrushTextTertiary}"/>
                                                    <TextBlock Text="{Binding LastMeetingText}" FontSize="12" FontWeight="Medium"
                                                               Foreground="{DynamicResource BrushTextPrimary}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                    <TextBlock Text="Next Meeting" FontSize="9" Foreground="{DynamicResource BrushTextTertiary}" HorizontalAlignment="Right"/>
                                                    <TextBlock Text="{Binding NextMeetingText}" FontSize="12" FontWeight="Medium"
                                                               HorizontalAlignment="Right">
                                                        <TextBlock.Foreground>
                                                            <MultiBinding Converter="{StaticResource MeetingStatusColorConverter}">
                                                                <Binding Path="NeedsAttention"/>
                                                            </MultiBinding>
                                                        </TextBlock.Foreground>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                            
                                            <!-- Quick Actions -->
                                            <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BrushBorder}" Padding="0,10,0,0">
                                                <Grid ColumnDefinitions="*,*,*">
                                                    <!-- Schedule Meeting -->
                                                    <Button Grid.Column="0" Classes="icon-button" ToolTip.Tip="Schedule Meeting"
                                                            Command="{Binding $parent[ItemsControl].((vm:CircleViewModel)DataContext).ScheduleMeetingCommand}"
                                                            CommandParameter="{Binding}">
                                                        <PathIcon Data="M19,19H5V8H19M16,1V3H8V1H6V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3H18V1M17,12H12V17H17V12Z"
                                                                  Width="16" Height="16" Foreground="{DynamicResource BrushPrimary}"/>
                                                    </Button>
                                                    
                                                    <!-- Send Email -->
                                                    <Button Grid.Column="1" Classes="icon-button" ToolTip.Tip="Send Email"
                                                            Command="{Binding $parent[ItemsControl].((vm:CircleViewModel)DataContext).SendEmailCommand}"
                                                            CommandParameter="{Binding}">
                                                        <PathIcon Data="M20,8L12,13L4,8V6L12,11L20,6M20,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V6C22,4.89 21.1,4 20,4Z"
                                                                  Width="16" Height="16" Foreground="{DynamicResource BrushTextSecondary}"/>
                                                    </Button>
                                                    
                                                    <!-- Edit -->
                                                    <Button Grid.Column="2" Classes="icon-button" ToolTip.Tip="Edit Details"
                                                            Command="{Binding $parent[ItemsControl].((vm:CircleViewModel)DataContext).EditTeamMemberCommand}"
                                                            CommandParameter="{Binding}">
                                                        <PathIcon Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"
                                                                  Width="16" Height="16" Foreground="{DynamicResource BrushTextSecondary}"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        
                        <!-- TREE VIEW: Compact Hierarchical List -->
                        <ItemsControl ItemsSource="{Binding FilteredTeamMembers}" Margin="0,0,4,0"
                                      IsVisible="{Binding IsTreeView}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="member-card-compact"
                                            Classes.selected="{Binding IsSelected}"
                                            Margin="{Binding DisplayDepth, Converter={StaticResource TreeDepthToMarginConverter}}"
                                            Tapped="MemberCard_Tapped"
                                            DoubleTapped="MemberCard_DoubleTapped" Tag="{Binding}">
                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                                            <!-- Tree Connector (shows for indented items) -->
                                            <TextBlock Grid.Column="0" Text="──" FontSize="11" 
                                                       Foreground="{DynamicResource BrushTextTertiary}"
                                                       VerticalAlignment="Center" Margin="0,0,6,0"
                                                       IsVisible="{Binding DisplayDepth, Converter={StaticResource GreaterThanZeroConverter}}"/>
                                            
                                            <!-- Avatar with image or initials -->
                                            <Border Grid.Column="1" Width="36" Height="36" CornerRadius="18" ClipToBounds="True">
                                                <Panel>
                                                    <!-- Initials fallback -->
                                                    <Border Background="{DynamicResource BrushPrimary}" CornerRadius="18"
                                                            IsVisible="{Binding UserAvatarUrl, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                                                        <TextBlock Text="{Binding Initials}" FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <!-- Avatar image -->
                                                    <Image asyncImageLoader:ImageLoader.Source="{Binding UserAvatarUrl}" Stretch="UniformToFill" Width="36" Height="36"
                                                           IsVisible="{Binding UserAvatarUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                </Panel>
                                            </Border>
                                            
                                            <!-- Name + Title -->
                                            <StackPanel Grid.Column="2" Margin="12,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FullName}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding JobTitle}" FontSize="11"
                                                           Foreground="{DynamicResource BrushTextSecondary}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            
                                            <!-- View Team Button (if manager) -->
                                            <Button Grid.Column="3" Classes="view-team-button"
                                                    IsVisible="{Binding IsManager}" Margin="0,0,8,0"
                                                    Tapped="ManagerBadge_Tapped"
                                                    Tag="{Binding}">
                                                <ToolTip.Tip>
                                                    <TextBlock Text="View this person's team" Foreground="#1F2937"/>
                                                </ToolTip.Tip>
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <PathIcon Data="M16,13C15.71,13 15.38,13 15.03,13.05C16.19,13.89 17,15 17,16.5V19H23V16.5C23,14.17 18.33,13 16,13M8,13C5.67,13 1,14.17 1,16.5V19H15V16.5C15,14.17 10.33,13 8,13M8,11A3,3 0 0,0 11,8A3,3 0 0,0 8,5A3,3 0 0,0 5,8A3,3 0 0,0 8,11M16,11A3,3 0 0,0 19,8A3,3 0 0,0 16,5A3,3 0 0,0 13,8A3,3 0 0,0 16,11Z"
                                                              Width="12" Height="12" Foreground="{DynamicResource BrushPrimary}"/>
                                                    <TextBlock FontSize="10" Foreground="{DynamicResource BrushPrimary}" FontWeight="SemiBold">
                                                        <Run Text="{Binding DirectReportCount}"/>
                                                    </TextBlock>
                                                    <PathIcon Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z"
                                                              Width="10" Height="10" Foreground="{DynamicResource BrushPrimary}"/>
                                                </StackPanel>
                                            </Button>
                                            
                                            <!-- Status Badge -->
                                            <Border Grid.Column="4" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                                                <Border.Background>
                                                    <MultiBinding Converter="{StaticResource BoolToColorConverter}">
                                                        <Binding Path="IsActive"/>
                                                    </MultiBinding>
                                                </Border.Background>
                                                <TextBlock Text="{Binding StatusDisplay}" FontSize="9" FontWeight="SemiBold" Foreground="White"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>
                
                <!-- ======= TEAM MEMBER DETAIL FLYOUT ======= -->
                <controls:EntityDetailFlyout Grid.Column="1"
                                             FlyoutContent="{Binding SelectedTeamMember}"
                                             IsOpen="{Binding IsDetailPanelOpen}"/>
            </Grid>
            
            <!-- =============== GOALS TAB =============== -->
            <Grid Grid.Row="1" IsVisible="{Binding SelectedTab, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:CircleTab.Goals}}"
                  RowDefinitions="Auto,*" ColumnDefinitions="*,Auto">
                
                <!-- Header Row: Stats + Actions -->
                <Grid Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,16" ColumnDefinitions="*,Auto">
                    
                    <!-- Stats Filters -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                        <!-- All -->
                        <Border Classes="stat-filter"
                                Classes.selected="{Binding GoalFilter, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:GoalFilter.All}}"
                                Tapped="GoalFilter_All_Tapped">
                            <StackPanel>
                                <TextBlock Text="ALL GOALS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextTertiary}"/>
                                <TextBlock Text="{Binding TotalGoalsCount}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- On Track -->
                        <Border Classes="stat-filter"
                                Classes.selected="{Binding GoalFilter, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:GoalFilter.OnTrack}}"
                                Tapped="GoalFilter_OnTrack_Tapped">
                            <StackPanel>
                                <TextBlock Text="ON TRACK" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextTertiary}"/>
                                <TextBlock Text="{Binding OnTrackGoalsCount}" FontSize="20" FontWeight="Bold" Foreground="#10B981"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- At Risk -->
                        <Border Classes="stat-filter"
                                Classes.selected="{Binding GoalFilter, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:GoalFilter.AtRisk}}"
                                Tapped="GoalFilter_AtRisk_Tapped">
                            <StackPanel>
                                <TextBlock Text="AT RISK" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextTertiary}"/>
                                <TextBlock Text="{Binding AtRiskGoalsCount}" FontSize="20" FontWeight="Bold" Foreground="#F59E0B"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- Off Track -->
                        <Border Classes="stat-filter"
                                Classes.selected="{Binding GoalFilter, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:GoalFilter.OffTrack}}"
                                Tapped="GoalFilter_OffTrack_Tapped">
                            <StackPanel>
                                <TextBlock Text="OFF TRACK" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextTertiary}"/>
                                <TextBlock Text="{Binding OffTrackGoalsCount}" FontSize="20" FontWeight="Bold" Foreground="#EF4444"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    
                    <!-- Add Goal Button -->
                    <Button Grid.Column="1" Command="{Binding AddGoalCommand}" Classes="action-button">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Width="14" Height="14"/>
                            <TextBlock Text="Add Goal"/>
                        </StackPanel>
                    </Button>
                </Grid>
                
                <!-- Goals List + Detail Panel -->
                <Grid Grid.Row="1" Grid.Column="0" ColumnDefinitions="*,Auto" ClipToBounds="True">
                    
                    <!-- Goals List -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding FilteredGoals}" Margin="0,0,12,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="goal-card" Margin="0,0,0,12"
                                            Tapped="GoalCard_Tapped" Tag="{Binding}">
                                        <Grid RowDefinitions="Auto,Auto,Auto,Auto">
                                            <!-- Header: Derived Health Badge + Owner -->
                                            <!-- Per GOALS_SPEC: Circle uses DerivedHealth from metric signals, NOT legacy status -->
                                            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
                                                <Border CornerRadius="6" Padding="8,4">
                                                    <Border.Background>
                                                        <SolidColorBrush Color="{Binding DerivedHealth, Converter={StaticResource GoalDerivedHealthToBackgroundConverter}}"/>
                                                    </Border.Background>
                                                    <TextBlock Text="{Binding DerivedHealthDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                                </Border>
                                                <TextBlock Grid.Column="2" Text="{Binding OwnerName}" FontSize="12"
                                                           Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                                            </Grid>
                                            
                                            <!-- Title -->
                                            <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource BrushTextPrimary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                            
                                            <!-- Description -->
                                            <TextBlock Grid.Row="2" Text="{Binding Description}" FontSize="13"
                                                       Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap"
                                                       MaxLines="2" TextTrimming="CharacterEllipsis" Margin="0,0,0,12"/>
                                            
                                            <!-- Metrics Count (replaces progress bar per GOALS_SPEC) -->
                                            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="6">
                                                <PathIcon Data="M16,11.78L20.24,4.45L21.97,5.45L16.74,14.5L10.23,10.75L5.46,19H22V21H2V3H4V17.54L9.5,8L16,11.78Z" 
                                                          Width="14" Height="14" Foreground="{DynamicResource BrushTextTertiary}"/>
                                                <TextBlock FontSize="12" Foreground="{DynamicResource BrushTextTertiary}">
                                                    <Run Text="{Binding LinkedMetricsCount}"/>
                                                    <Run Text=" metric(s) linked"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    
                    <!-- Goal Detail Flyout (using new reusable EntityDetailFlyout) -->
                    <controls:EntityDetailFlyout 
                        Grid.Column="1"
                        FlyoutContent="{Binding SelectedGoal}"
                        IsOpen="{Binding IsGoalDetailOpen}"
                        FlyoutWidth="320"
                        Margin="8,0,0,0"/>
                </Grid>
            </Grid>
            
            <!-- =============== METRICS TAB =============== -->
            <!-- Signal-first view per CIRCLE_METRICS_SPEC: No raw values, trends over snapshots -->
            <Grid Grid.Row="1" IsVisible="{Binding SelectedTab, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:CircleTab.Metrics}}"
                  RowDefinitions="Auto,*" ColumnDefinitions="*,Auto">
                
                <!-- Header Row: Signal Stats + Actions -->
                <Grid Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,16" ColumnDefinitions="*,Auto">
                    
                    <!-- Signal Filters (not raw values) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                        <!-- All -->
                        <Border Classes="stat-filter"
                                Classes.selected="{Binding MetricFilter, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:MetricFilter.All}}"
                                Tapped="MetricFilter_All_Tapped">
                            <StackPanel>
                                <TextBlock Text="ALL METRICS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextTertiary}"/>
                                <TextBlock Text="{Binding TotalMetricsCount}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- On Track (signal good) -->
                        <Border Classes="stat-filter"
                                Classes.selected="{Binding MetricFilter, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:MetricFilter.OnTrack}}"
                                Tapped="MetricFilter_OnTrack_Tapped">
                            <StackPanel>
                                <TextBlock Text="ON TRACK" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextTertiary}"/>
                                <TextBlock Text="{Binding OnTrackMetricsCount}" FontSize="20" FontWeight="Bold" Foreground="#10B981"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- Needs Attention (signal warning) -->
                        <Border Classes="stat-filter"
                                Classes.selected="{Binding MetricFilter, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:MetricFilter.NeedsAttention}}"
                                Tapped="MetricFilter_NeedsAttention_Tapped">
                            <StackPanel>
                                <TextBlock Text="NEEDS ATTENTION" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextTertiary}"/>
                                <TextBlock Text="{Binding NeedsAttentionMetricsCount}" FontSize="20" FontWeight="Bold" Foreground="#F59E0B"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- Off Track (signal bad) -->
                        <Border Classes="stat-filter"
                                Classes.selected="{Binding MetricFilter, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:MetricFilter.OffTrack}}"
                                Tapped="MetricFilter_OffTrack_Tapped">
                            <StackPanel>
                                <TextBlock Text="OFF TRACK" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextTertiary}"/>
                                <TextBlock Text="{Binding OffTrackMetricsCount}" FontSize="20" FontWeight="Bold" Foreground="#EF4444"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
                
                <!-- Metrics List + Detail Panel -->
                <Grid Grid.Row="1" Grid.Column="0" ColumnDefinitions="*,Auto" ClipToBounds="True">
                    
                    <!-- Metrics List - Signal-first rows -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding FilteredMetrics}" Margin="0,0,12,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="metric-card" Margin="0,0,0,8"
                                            Tapped="MetricCard_Tapped" Tag="{Binding}">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                            <!-- Signal Indicator (color dot based on trend+direction) -->
                                            <Ellipse Grid.Column="0" Width="12" Height="12" Margin="0,0,12,0" VerticalAlignment="Center"
                                                     Fill="{Binding Trend, Converter={StaticResource MetricTrendToSignalBrushConverter}}"/>
                                            
                                            <!-- Metric Name + Owner -->
                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding StewardName}" FontSize="12"
                                                           Foreground="{DynamicResource BrushTextSecondary}"/>
                                            </StackPanel>
                                            
                                            <!-- Trend Arrow (directional signal, not value) -->
                                            <TextBlock Grid.Column="2" Text="{Binding TrendDisplay}" FontSize="18" Margin="12,0"
                                                       VerticalAlignment="Center" FontWeight="Bold"
                                                       Foreground="{Binding Trend, Converter={StaticResource MetricTrendToColorConverter}}"/>
                                            
                                            <!-- Last Update Age -->
                                            <TextBlock Grid.Column="3" FontSize="12" Margin="8,0"
                                                       Foreground="{DynamicResource BrushTextTertiary}" VerticalAlignment="Center"
                                                       Text="{Binding UpdatedAt, Converter={StaticResource DateTimeToAgeConverter}}"/>
                                            
                                            <!-- Expand indicator -->
                                            <PathIcon Grid.Column="4" Width="14" Height="14" Margin="8,0,0,0" VerticalAlignment="Center"
                                                      Foreground="{DynamicResource BrushTextTertiary}"
                                                      Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    
                    <!-- Metric Detail Flyout (expanded view with value, target, note, micro-trend) -->
                    <Border Grid.Column="1" Width="{Binding IsMetricDetailOpen, Converter={StaticResource BoolToWidthConverter}}"
                            ClipToBounds="True">
                        <Border Classes="detail-panel" Classes.open="{Binding IsMetricDetailOpen}" 
                                Width="320" Margin="8,0,0,0">
                            <!-- Metric detail content -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                                <StackPanel Spacing="16" IsVisible="{Binding SelectedMetric, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <!-- Header with close button -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{Binding SelectedMetric.Name}" FontSize="18" FontWeight="Bold"
                                                   Foreground="{DynamicResource BrushTextPrimary}" TextWrapping="Wrap"/>
                                        <Button Grid.Column="1" Classes="icon-button" Command="{Binding CloseMetricDetailCommand}">
                                            <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" 
                                                      Width="16" Height="16"/>
                                        </Button>
                                    </Grid>
                                    
                                    <!-- Trend Signal (large display) -->
                                    <Border Background="{DynamicResource BrushSurface}" CornerRadius="8" Padding="16">
                                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding SelectedMetric.TrendDisplay}" FontSize="48" FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{Binding SelectedMetric.Trend, Converter={StaticResource MetricTrendToColorConverter}}"/>
                                            <TextBlock Text="Trend Direction" FontSize="12" HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource BrushTextSecondary}"/>
                                        </StackPanel>
                                    </Border>
                                    
                                    <!-- Owner -->
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="OWNER" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextTertiary}"/>
                                        <TextBlock Text="{Binding SelectedMetric.StewardName, TargetNullValue='Unassigned'}" FontSize="14"
                                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                                    </StackPanel>
                                    
                                    <!-- Description -->
                                    <StackPanel Spacing="4" IsVisible="{Binding SelectedMetric.Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <TextBlock Text="DESCRIPTION" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextTertiary}"/>
                                        <TextBlock Text="{Binding SelectedMetric.Description}" FontSize="13" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource BrushTextSecondary}"/>
                                    </StackPanel>
                                    
                                    <!-- Current Value (shown on expand per CIRCLE_METRICS_SPEC) -->
                                    <StackPanel Spacing="4" IsVisible="{Binding SelectedMetric.CurrentValue, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <TextBlock Text="CURRENT VALUE" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextTertiary}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="{Binding SelectedMetric.CurrentValue}" FontSize="20" FontWeight="Bold"
                                                       Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <TextBlock Text="{Binding SelectedMetric.Unit}" FontSize="14" VerticalAlignment="Bottom"
                                                       Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,2"/>
                                        </StackPanel>
                                    </StackPanel>
                                    
                                    <!-- Target (if defined, shown on expand) -->
                                    <StackPanel Spacing="4" IsVisible="{Binding SelectedMetric.TargetValue, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <TextBlock Text="TARGET" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextTertiary}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="{Binding SelectedMetric.TargetValue}" FontSize="16"
                                                       Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <TextBlock Text="{Binding SelectedMetric.Unit}" FontSize="12" VerticalAlignment="Bottom"
                                                       Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,1"/>
                                        </StackPanel>
                                    </StackPanel>
                                    
                                    <!-- Frequency -->
                                    <StackPanel Spacing="4" IsVisible="{Binding SelectedMetric.Frequency, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <TextBlock Text="UPDATE FREQUENCY" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextTertiary}"/>
                                        <TextBlock Text="{Binding SelectedMetric.Frequency}" FontSize="14"
                                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                                    </StackPanel>
                                    
                                    <!-- Last Updated -->
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="LAST UPDATED" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextTertiary}"/>
                                        <TextBlock Text="{Binding SelectedMetric.UpdatedAt, StringFormat='MMM d, yyyy'}" FontSize="14"
                                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                                    </StackPanel>
                                    
                                    <!-- Linked Goals Section -->
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="LINKED GOALS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextTertiary}"/>
                                        
                                        <!-- Linked goals list -->
                                        <ItemsControl ItemsSource="{Binding MetricLinkedGoals}" Margin="0,4,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:GoalDetail">
                                                    <Border Background="{DynamicResource BrushSurfaceAlt}" CornerRadius="6" Padding="10,8" Margin="0,0,0,4"
                                                            Cursor="Hand" Tapped="LinkedGoal_Tapped" Tag="{Binding}">
                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                            <!-- Health indicator dot -->
                                                            <Ellipse Grid.Column="0" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                                                <Ellipse.Fill>
                                                                    <SolidColorBrush Color="{Binding Status, Converter={StaticResource GoalStatusToBackgroundConverter}}"/>
                                                                </Ellipse.Fill>
                                                            </Ellipse>
                                                            <!-- Goal title -->
                                                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12" FontWeight="Medium"
                                                                       Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                            <!-- Navigate arrow indicator -->
                                                            <PathIcon Grid.Column="2" Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z"
                                                                      Width="10" Height="10" Margin="8,0,0,0"
                                                                      Foreground="{DynamicResource BrushTextTertiary}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        
                                        <!-- Loading state -->
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0"
                                                    IsVisible="{Binding IsLoadingLinkedGoals}">
                                            <ProgressBar IsIndeterminate="True" Width="60" Height="4"/>
                                            <TextBlock Text="Loading..." FontSize="11" FontStyle="Italic"
                                                       Foreground="{DynamicResource BrushTextTertiary}"/>
                                        </StackPanel>
                                        
                                        <!-- Empty state (only show when not loading) -->
                                        <TextBlock Text="Not linked to any goals" FontSize="11" FontStyle="Italic"
                                                   Foreground="{DynamicResource BrushTextTertiary}" Margin="0,4,0,0">
                                            <TextBlock.IsVisible>
                                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                    <Binding Path="MetricLinkedGoals.Count" Converter="{StaticResource EqualToZeroConverter}"/>
                                                    <Binding Path="!IsLoadingLinkedGoals"/>
                                                </MultiBinding>
                                            </TextBlock.IsVisible>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Border>
                </Grid>
            </Grid>
            
            <!-- =============== FEEDBACK TAB =============== -->
            <Grid Grid.Row="1" IsVisible="{Binding SelectedTab, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:CircleTab.Feedback}}"
                  RowDefinitions="Auto,*" ColumnDefinitions="*,Auto">
                
                <!-- Header Row: Stats + Actions -->
                <Grid Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,16" ColumnDefinitions="*,Auto">
                    
                    <!-- Stats Filters -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                        <!-- All -->
                        <Border Classes="stat-filter"
                                Classes.selected="{Binding FeedbackFilter, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:FeedbackFilter.All}}"
                                Tapped="FeedbackFilter_All_Tapped">
                            <StackPanel>
                                <TextBlock Text="ALL FEEDBACK" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextTertiary}"/>
                                <TextBlock Text="{Binding TotalFeedbackCount}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- Praise -->
                        <Border Classes="stat-filter"
                                Classes.selected="{Binding FeedbackFilter, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:FeedbackFilter.Praise}}"
                                Tapped="FeedbackFilter_Praise_Tapped">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <PathIcon Data="M12,17.27L18.18,21L16.54,13.97L22,9.24L14.81,8.62L12,2L9.19,8.62L2,9.24L7.45,13.97L5.82,21L12,17.27Z" Width="10" Height="10" Foreground="{DynamicResource BrushTextTertiary}"/>
                                    <TextBlock Text="PRAISE" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextTertiary}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding PraiseFeedbackCount}" FontSize="20" FontWeight="Bold" Foreground="#10B981"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- Constructive -->
                        <Border Classes="stat-filter"
                                Classes.selected="{Binding FeedbackFilter, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:FeedbackFilter.Constructive}}"
                                Tapped="FeedbackFilter_Constructive_Tapped">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <PathIcon Data="M12,2A7,7 0 0,0 5,9C5,11.38 6.19,13.47 8,14.74V17A1,1 0 0,0 9,18H15A1,1 0 0,0 16,17V14.74C17.81,13.47 19,11.38 19,9A7,7 0 0,0 12,2M9,21A1,1 0 0,0 10,22H14A1,1 0 0,0 15,21V20H9V21Z" Width="10" Height="10" Foreground="{DynamicResource BrushTextTertiary}"/>
                                    <TextBlock Text="CONSTRUCTIVE" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextTertiary}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding ConstructiveFeedbackCount}" FontSize="20" FontWeight="Bold" Foreground="#F59E0B"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- Coaching -->
                        <Border Classes="stat-filter"
                                Classes.selected="{Binding FeedbackFilter, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:FeedbackFilter.Coaching}}"
                                Tapped="FeedbackFilter_Coaching_Tapped">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <PathIcon Data="M19,2L14,6.5V17.5L19,13V2M6.5,5C4.55,5 2.45,5.4 1,6.5V21.16C1,21.41 1.25,21.66 1.5,21.66C1.6,21.66 1.65,21.59 1.75,21.59C3.1,20.94 5.05,20.5 6.5,20.5C8.45,20.5 10.55,20.9 12,22C13.35,21.15 15.8,20.5 17.5,20.5C19.15,20.5 20.85,20.81 22.25,21.56C22.35,21.61 22.4,21.59 22.5,21.59C22.75,21.59 23,21.34 23,21.09V6.5C22.4,6.05 21.75,5.75 21,5.5V19C19.9,18.65 18.7,18.5 17.5,18.5C15.8,18.5 13.35,19.15 12,20V6.5C10.55,5.4 8.45,5 6.5,5Z" Width="10" Height="10" Foreground="{DynamicResource BrushTextTertiary}"/>
                                    <TextBlock Text="COACHING" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextTertiary}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding CoachingFeedbackCount}" FontSize="20" FontWeight="Bold" Foreground="#6366F1"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    
                    <!-- Give Feedback Button -->
                    <Button Grid.Column="1" Command="{Binding GiveFeedbackCommand}" Classes="action-button">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Width="14" Height="14"/>
                            <TextBlock Text="Give Feedback"/>
                        </StackPanel>
                    </Button>
                </Grid>
                
                <!-- Feedback List + Detail Panel -->
                <Grid Grid.Row="1" Grid.Column="0" ColumnDefinitions="*,Auto" ClipToBounds="True">
                    
                    <!-- Feedback List -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding FilteredFeedback}" Margin="0,0,12,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="feedback-card" Margin="0,0,0,12"
                                            Tapped="FeedbackCard_Tapped" Tag="{Binding}">
                                        <Grid RowDefinitions="Auto,Auto,Auto">
                                            <!-- Header: Type + Recipient + Date -->
                                            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding TypeDisplay}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource BrushTextSecondary}"/>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding DateDisplay}" FontSize="11"
                                                               Foreground="{DynamicResource BrushTextTertiary}"/>
                                                </StackPanel>
                                            </Grid>
                                            
                                            <!-- Recipient -->
                                            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
                                                <Border Width="28" Height="28" CornerRadius="14" ClipToBounds="True">
                                                    <Panel>
                                                        <Border Background="{DynamicResource BrushPrimary}" CornerRadius="14"
                                                                IsVisible="{Binding RecipientAvatarUrl, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                                                            <TextBlock Text="{Binding RecipientInitials}" FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <Image asyncImageLoader:ImageLoader.Source="{Binding RecipientAvatarUrl}"
                                                               Stretch="UniformToFill" Width="28" Height="28"
                                                               IsVisible="{Binding RecipientAvatarUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                    </Panel>
                                                </Border>
                                                <TextBlock Text="{Binding RecipientName}" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            
                                            <!-- Content Preview -->
                                            <TextBlock Grid.Row="2" Text="{Binding Content}" FontSize="13"
                                                       Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap"
                                                       MaxLines="3" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    
                    <!-- Feedback Detail Panel -->
                    <Border Grid.Column="1" Width="{Binding IsFeedbackDetailOpen, Converter={StaticResource BoolToWidthConverter}}"
                            ClipToBounds="True">
                        <Border Classes="detail-panel" Classes.open="{Binding IsFeedbackDetailOpen}" 
                                Width="320" Margin="8,0,0,0">
                            <Grid RowDefinitions="Auto,*">
                                
                                <!-- Header - Navy bar matching other flyouts -->
                                <Border Grid.Row="0" Background="{DynamicResource BrushSecondary}" CornerRadius="8,8,0,0" Padding="16,12">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="Feedback" FontSize="14" FontWeight="SemiBold" 
                                                   Foreground="White" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Classes="icon-button" ToolTip.Tip="Close"
                                                Command="{Binding CloseFeedbackDetailCommand}">
                                            <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                                      Width="14" Height="14" Foreground="White"/>
                                        </Button>
                                    </Grid>
                                </Border>
                                
                                <!-- Content -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel DataContext="{Binding SelectedFeedback}" Margin="16,12,16,16">
                                
                                <!-- Type Badge -->
                                <TextBlock Text="{Binding TypeDisplay}" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,16"/>
                                
                                <!-- TO Section - showing recipient -->
                                <TextBlock Text="TO" FontSize="10" FontWeight="SemiBold" 
                                           Foreground="{DynamicResource BrushTextTertiary}" Margin="0,0,0,4"/>
                                <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,12">
                                    <Border Width="40" Height="40" CornerRadius="20" ClipToBounds="True">
                                        <Panel>
                                            <Border Background="{DynamicResource BrushPrimary}" CornerRadius="20"
                                                    IsVisible="{Binding RecipientAvatarUrl, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                                                <TextBlock Text="{Binding RecipientInitials}" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Image asyncImageLoader:ImageLoader.Source="{Binding RecipientAvatarUrl}"
                                                   Stretch="UniformToFill" Width="40" Height="40"
                                                   IsVisible="{Binding RecipientAvatarUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        </Panel>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding RecipientName}" FontSize="14" FontWeight="Medium"
                                               Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </Grid>
                                
                                <!-- Context Section -->
                                <TextBlock Text="CONTEXT" Classes="detail-section-header"/>
                                <Border Background="{DynamicResource BrushSurfaceAlt}" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Context}" FontSize="13" Foreground="{DynamicResource BrushTextSecondary}"
                                               IsVisible="{Binding Context, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </Border>
                                <TextBlock Text="No context provided" FontSize="13" Opacity="0.5" Margin="0,0,0,8"
                                           IsVisible="{Binding Context, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
                                
                                <!-- Date Section -->
                                <TextBlock Text="DATE" Classes="detail-section-header"/>
                                <TextBlock FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,8">
                                    <Run Text="{Binding CreatedAt, StringFormat='{}{0:MMMM d, yyyy}'}" FontWeight="Medium"/>
                                    <Run Text="at"/>
                                    <Run Text="{Binding CreatedAt, StringFormat='{}{0:h:mm tt}'}"/>
                                </TextBlock>
                                
                                <!-- Feedback Content Section -->
                                <TextBlock Text="FEEDBACK" Classes="detail-section-header"/>
                                <Border Background="{DynamicResource BrushSurfaceAlt}" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                                    <TextBlock Text="{Binding Content}" FontSize="14" TextWrapping="Wrap" LineHeight="22"
                                               Foreground="{DynamicResource BrushTextPrimary}"/>
                                </Border>
                                
                                <!-- Actions -->
                                <StackPanel Margin="0,8,0,0" Spacing="8">
                                    <Button Classes="secondary-button" HorizontalContentAlignment="Left">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <PathIcon Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"
                                                      Width="14" Height="14"/>
                                            <TextBlock Text="Edit Feedback"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="secondary-button" HorizontalContentAlignment="Left">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <PathIcon Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"
                                                      Width="14" Height="14" Foreground="#DC2626"/>
                                            <TextBlock Text="Delete Feedback" Foreground="#DC2626"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                
                            </StackPanel>
                            </ScrollViewer>
                            </Grid>
                        </Border>
                    </Border>
                </Grid>
            </Grid>
            
            <!-- =============== MEETINGS TAB =============== -->
            <Grid Grid.Row="1" IsVisible="{Binding SelectedTab, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:CircleTab.Meetings}}"
                  RowDefinitions="Auto,*" ColumnDefinitions="*,Auto">
                
                <!-- Header Row: View Modes + Navigation + Actions -->
                <Grid Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,16" ColumnDefinitions="Auto,*,Auto,Auto">
                    
                    <!-- View Mode Toggle -->
                    <Border Grid.Column="0" Background="{DynamicResource BrushSurfaceAlt}" CornerRadius="8" Padding="4">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button Classes="view-mode-button"
                                    Classes.selected="{Binding MeetingsViewMode, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:MeetingsViewMode.Day}}"
                                    Command="{Binding SetMeetingsViewModeCommand}"
                                    CommandParameter="{x:Static vm:MeetingsViewMode.Day}">
                                <TextBlock Text="Day"/>
                            </Button>
                            <Button Classes="view-mode-button"
                                    Classes.selected="{Binding MeetingsViewMode, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:MeetingsViewMode.Week}}"
                                    Command="{Binding SetMeetingsViewModeCommand}"
                                    CommandParameter="{x:Static vm:MeetingsViewMode.Week}">
                                <TextBlock Text="Week"/>
                            </Button>
                            <Button Classes="view-mode-button"
                                    Classes.selected="{Binding MeetingsViewMode, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:MeetingsViewMode.Month}}"
                                    Command="{Binding SetMeetingsViewModeCommand}"
                                    CommandParameter="{x:Static vm:MeetingsViewMode.Month}">
                                <TextBlock Text="Month"/>
                            </Button>
                            <Button Classes="view-mode-button"
                                    Classes.selected="{Binding MeetingsViewMode, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:MeetingsViewMode.List}}"
                                    Command="{Binding SetMeetingsViewModeCommand}"
                                    CommandParameter="{x:Static vm:MeetingsViewMode.List}">
                                <TextBlock Text="List"/>
                            </Button>
                        </StackPanel>
                    </Border>
                    
                    <!-- Date Navigation -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                        <Button Classes="icon-button" Command="{Binding NavigatePreviousCommand}" ToolTip.Tip="Previous">
                            <PathIcon Data="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z" Width="16" Height="16"/>
                        </Button>
                        <Button Classes="secondary-button" Command="{Binding NavigateTodayCommand}" Padding="12,6">
                            <TextBlock Text="Today" FontSize="12"/>
                        </Button>
                        <Button Classes="icon-button" Command="{Binding NavigateNextCommand}" ToolTip.Tip="Next">
                            <PathIcon Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" Width="16" Height="16"/>
                        </Button>
                        <TextBlock Text="{Binding CurrentDateHeader}" FontSize="16" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    
                    <!-- Schedule Meeting Button -->
                    <Button Grid.Column="3" Command="{Binding ScheduleMeetingCommand}" Classes="action-button">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Width="14" Height="14"/>
                            <TextBlock Text="Schedule Meeting"/>
                        </StackPanel>
                    </Button>
                </Grid>
                
                <!-- Main Content Area + Detail Panel -->
                <Grid Grid.Row="1" Grid.Column="0" ColumnDefinitions="*,Auto" ClipToBounds="True">
                    
                    <!-- ===== LIST VIEW ===== -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                                  IsVisible="{Binding MeetingsViewMode, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:MeetingsViewMode.List}}">
                        <StackPanel Spacing="16" Margin="0,0,12,0">
                            <ItemsControl ItemsSource="{Binding GroupedMeetings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Spacing="8">
                                            <!-- Date Header -->
                                            <TextBlock Text="{Binding Date}" FontSize="14" FontWeight="SemiBold" 
                                                       Foreground="{DynamicResource BrushTextSecondary}" Margin="0,8,0,4"/>
                                            
                                            <!-- Meetings for this date -->
                                            <ItemsControl ItemsSource="{Binding Meetings}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Classes="meeting-card" Margin="0,0,0,8"
                                                                Tapped="MeetingCard_Tapped" Tag="{Binding}">
                                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                                <!-- Time -->
                                                                <StackPanel Grid.Column="0" Width="80" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding StartTimeDisplay}" FontSize="14" FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource BrushTextPrimary}"/>
                                                                    <TextBlock Text="{Binding DurationText}" FontSize="11"
                                                                               Foreground="{DynamicResource BrushTextTertiary}"/>
                                                                </StackPanel>
                                                                
                                                                <!-- Meeting Info -->
                                                                <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Medium"
                                                                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                                                                        <Border CornerRadius="4" Padding="6,2" Background="{Binding TypeColor}">
                                                                            <TextBlock Text="{Binding TypeDisplay}" FontSize="10" Foreground="White"/>
                                                                        </Border>
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding AttendeeCountDisplay}" FontSize="12"
                                                                               Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0"/>
                                                                </StackPanel>
                                                                
                                                                <!-- Attendee Avatars -->
                                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <ItemsControl ItemsSource="{Binding Attendees}" Margin="0,0,8,0">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <StackPanel Orientation="Horizontal" Spacing="-8"/>
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Border Width="28" Height="28" CornerRadius="14" 
                                                                                        BorderBrush="{DynamicResource BrushSurface}" BorderThickness="2"
                                                                                        ClipToBounds="True">
                                                                                    <Panel>
                                                                                        <Border Background="{DynamicResource BrushPrimary}" CornerRadius="14"
                                                                                                IsVisible="{Binding AvatarUrl, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                                                                                            <TextBlock Text="{Binding Initials}" FontSize="10" FontWeight="SemiBold"
                                                                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                        </Border>
                                                                                        <Image asyncImageLoader:ImageLoader.Source="{Binding AvatarUrl}"
                                                                                               Stretch="UniformToFill" Width="28" Height="28"
                                                                                               IsVisible="{Binding AvatarUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                                                    </Panel>
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                    
                                                                    <!-- Video link indicator -->
                                                                    <PathIcon IsVisible="{Binding HasVideoLink}"
                                                                              Data="M17,10.5V7A1,1 0 0,0 16,6H4A1,1 0 0,0 3,7V17A1,1 0 0,0 4,18H16A1,1 0 0,0 17,17V13.5L21,17.5V6.5L17,10.5Z"
                                                                              Width="16" Height="16" Foreground="{DynamicResource BrushPrimary}"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    
                    <!-- ===== DAY VIEW ===== -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                                  IsVisible="{Binding MeetingsViewMode, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:MeetingsViewMode.Day}}">
                        <!-- Day view grid built in code-behind -->
                        <Grid x:Name="DayViewGrid" Margin="0,0,12,0"/>
                    </ScrollViewer>
                    
                    <!-- ===== WEEK VIEW ===== -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                                  IsVisible="{Binding MeetingsViewMode, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:MeetingsViewMode.Week}}">
                        <!-- Week view grid built in code-behind -->
                        <Grid x:Name="WeekViewGrid" Margin="0,0,12,0"/>
                    </ScrollViewer>
                    
                    <!-- ===== MONTH VIEW ===== -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                                  IsVisible="{Binding MeetingsViewMode, Converter={StaticResource EnumEqualConverter}, ConverterParameter={x:Static vm:MeetingsViewMode.Month}}">
                        <Grid RowDefinitions="Auto,*" Margin="0,0,12,0">
                            <!-- Day of Week Headers -->
                            <UniformGrid Grid.Row="0" Columns="7" Margin="0,0,0,8">
                                <TextBlock Text="Sun" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource BrushTextTertiary}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Mon" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource BrushTextTertiary}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Tue" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource BrushTextTertiary}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Wed" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource BrushTextTertiary}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Thu" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource BrushTextTertiary}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Fri" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource BrushTextTertiary}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Sat" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource BrushTextTertiary}" HorizontalAlignment="Center"/>
                            </UniformGrid>
                            
                            <!-- Calendar Grid -->
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding CalendarDays}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="7" Rows="6"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="calendar-day" 
                                                Classes.today="{Binding IsToday}"
                                                Classes.other-month="{Binding !IsCurrentMonth}">
                                            <StackPanel>
                                                <!-- Day Number -->
                                                <TextBlock Text="{Binding DayNumber}" FontSize="12" FontWeight="Medium"
                                                           Foreground="{DynamicResource BrushTextPrimary}"
                                                           HorizontalAlignment="Right" Margin="0,0,4,4"/>
                                                
                                                <!-- Meetings (max 3) -->
                                                <ItemsControl ItemsSource="{Binding Meetings}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Classes="calendar-meeting" Background="{Binding TypeColor}"
                                                                    Tapped="MeetingCard_Tapped" Tag="{Binding}">
                                                                <TextBlock FontSize="9" Foreground="White" TextTrimming="CharacterEllipsis" Margin="2,0">
                                                                    <Run Text="{Binding ShortTimeDisplay}"/>
                                                                    <Run Text="{Binding Title}"/>
                                                                </TextBlock>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                
                                                <!-- More indicator -->
                                                <TextBlock IsVisible="{Binding HasMoreMeetings}" Text="+ more" FontSize="9"
                                                           Foreground="{DynamicResource BrushTextTertiary}" Margin="2,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                    
                    <!-- ===== MEETING DETAIL FLYOUT ===== -->
                    <Border Grid.Column="1" Width="{Binding IsMeetingDetailOpen, Converter={StaticResource BoolToWidthConverter}}"
                            ClipToBounds="True">
                        <controls:EntityDetailFlyout
                            Width="320" Margin="8,0,0,0"
                            FlyoutContent="{Binding SelectedMeeting}"
                            IsOpen="{Binding IsMeetingDetailOpen}"/>
                    </Border>
                    
                </Grid>
            </Grid>
            
            <!-- Loading State -->
            <Border IsVisible="{Binding IsLoading}" Background="{DynamicResource BrushSurface}" 
                    CornerRadius="8" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ProgressBar IsIndeterminate="True" Width="200"/>
                    <TextBlock Text="{Binding LoadingStatus}" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            
            <!-- Empty State (Team tab) -->
            <Border IsVisible="{Binding FilteredMemberCount, Converter={StaticResource EqualToZeroConverter}}"
                    Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                    IsEnabled="{Binding !IsLoading}">
                <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <PathIcon Data="M12,5.5A3.5,3.5 0 0,1 15.5,9A3.5,3.5 0 0,1 12,12.5A3.5,3.5 0 0,1 8.5,9A3.5,3.5 0 0,1 12,5.5M5,8C5.56,8 6.08,8.15 6.53,8.42C6.38,9.85 6.8,11.27 7.66,12.38C7.16,13.34 6.16,14 5,14A3,3 0 0,1 2,11A3,3 0 0,1 5,8M19,8A3,3 0 0,1 22,11A3,3 0 0,1 19,14C17.84,14 16.84,13.34 16.34,12.38C17.2,11.27 17.62,9.85 17.47,8.42C17.92,8.15 18.44,8 19,8M5.5,18.25C5.5,16.18 8.41,14.5 12,14.5C15.59,14.5 18.5,16.18 18.5,18.25V20H5.5V18.25Z"
                              Width="48" Height="48" Opacity="0.2"/>
                    <TextBlock Text="No team members found" FontSize="14" Foreground="{DynamicResource BrushTextTertiary}" HorizontalAlignment="Center"/>
                    <Button Command="{Binding AddTeamMemberCommand}" Classes="action-button" HorizontalAlignment="Center">
                        <TextBlock Text="Add your first team member"/>
                    </Button>
                </StackPanel>
            </Border>
            
            <!-- Error State -->
            <Border IsVisible="{Binding HasError}" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" 
                    CornerRadius="8" Padding="16" VerticalAlignment="Top" HorizontalAlignment="Stretch">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
