<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ProCohere.Avalonia.Views.Pulse.TasksTabView">
    
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
            <PathIcon Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20M9,13V19H7V13H9M15,15V19H13V15H15M11,11V19H9V11H11M13,13V19H11V13H13" 
                      Width="48" Height="48" 
                      Foreground="{DynamicResource BrushTextSecondary}"/>
            <TextBlock Text="Tasks" 
                       FontSize="18" 
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushTextPrimary}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Tasks content will go here" 
                       FontSize="13"
                       Foreground="{DynamicResource BrushTextSecondary}"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
