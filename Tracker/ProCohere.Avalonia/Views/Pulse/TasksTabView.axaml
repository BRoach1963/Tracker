<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ProCohere.Avalonia.ViewModels"
             xmlns:controls="using:ProCohere.Avalonia.Views.Controls"
             xmlns:local="using:ProCohere.Avalonia.Views.Pulse"
             xmlns:markup="using:ProCohere.Avalonia.Markup"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="ProCohere.Avalonia.Views.Pulse.TasksTabView"
             x:DataType="vm:TasksViewModel">
    
    <UserControl.Styles>
        <!-- Filter Button Style -->
        <Style Selector="Border.filter-stat">
            <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Border.filter-stat:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}"/>
        </Style>
        <Style Selector="Border.filter-stat.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}"/>
        </Style>
        
        <!-- Task Card Style -->
        <Style Selector="Border.task-card">
            <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style Selector="Border.task-card:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushHighlight}"/>
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}"/>
        </Style>
        <Style Selector="Border.task-card.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        
        <!-- Priority Badge -->
        <Style Selector="Border.priority-badge">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,2"/>
        </Style>
        
        <!-- Detail Panel Style - with slide animation -->
        <Style Selector="Border.detail-panel">
            <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RenderTransform" Value="translate(320px, 0)"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="CubicEaseOut"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.detail-panel.open">
            <Setter Property="RenderTransform" Value="translate(0, 0)"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
    </UserControl.Styles>
    
    <Grid RowDefinitions="Auto,*" ClipToBounds="True">
        
        <!-- Row 0: Filter Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- Filter Stats -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <!-- All -->
                <Border Classes="filter-stat" Classes.selected="{Binding IsFilterAll}"
                        Tapped="FilterAll_Tapped">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding TotalCountText}" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                        <TextBlock Text="{markup:Localize Key=TasksTab_FilterAll}" FontSize="12" 
                                   Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                
                <!-- Today -->
                <Border Classes="filter-stat" Classes.selected="{Binding IsFilterToday}"
                        Tapped="FilterToday_Tapped">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding TodayCountText}" FontSize="18" FontWeight="Bold"
                                   Foreground="#3B82F6"/>
                        <TextBlock Text="{markup:Localize Key=TasksTab_FilterToday}" FontSize="12" 
                                   Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                
                <!-- Upcoming -->
                <Border Classes="filter-stat" Classes.selected="{Binding IsFilterUpcoming}"
                        Tapped="FilterUpcoming_Tapped">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding UpcomingCountText}" FontSize="18" FontWeight="Bold"
                                   Foreground="#8B5CF6"/>
                        <TextBlock Text="{markup:Localize Key=TasksTab_FilterUpcoming}" FontSize="12" 
                                   Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                
                <!-- Overdue -->
                <Border Classes="filter-stat" Classes.selected="{Binding IsFilterOverdue}"
                        Tapped="FilterOverdue_Tapped">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding OverdueCountText}" FontSize="18" FontWeight="Bold"
                                   Foreground="#EF4444"/>
                        <TextBlock Text="{markup:Localize Key=TasksTab_FilterOverdue}" FontSize="12" 
                                   Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                
                <!-- Completed -->
                <Border Classes="filter-stat" Classes.selected="{Binding IsFilterCompleted}"
                        Tapped="FilterCompleted_Tapped">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding CompletedCountText}" FontSize="18" FontWeight="Bold"
                                   Foreground="#10B981"/>
                        <TextBlock Text="{markup:Localize Key=TasksTab_FilterCompleted}" FontSize="12" 
                                   Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            
            <!-- Add Task Button -->
            <Button Grid.Column="1" Classes="button-primary" 
                    Command="{Binding RequestAddTaskDialogCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" 
                              Width="14" Height="14"/>
                    <TextBlock Text="{markup:Localize Key=TasksTab_NewTask}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
        
        <!-- Row 1: Content Area -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
            
            <!-- Task List -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                          Padding="0,0,12,0">
                <Grid>
                    <!-- Loading State -->
                    <Border IsVisible="{Binding ShowLoading, FallbackValue=True}"
                            Background="{DynamicResource BrushSurface}" 
                            CornerRadius="8" 
                            Padding="24"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ProgressBar IsIndeterminate="True" Width="200"/>
                            <TextBlock Text="{markup:Localize Key=TasksTab_Loading}" 
                                       Foreground="{DynamicResource BrushTextSecondary}" 
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Error State -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12"
                                IsVisible="{Binding HasError, FallbackValue=False}">
                        <PathIcon Data="M13,13H11V7H13M13,17H11V15H13M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z" 
                                  Width="32" Height="32" 
                                  Foreground="#EF4444"/>
                        <TextBlock Text="{Binding ErrorMessage}" 
                                   FontSize="14"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   TextWrapping="Wrap"
                                   MaxWidth="300"
                                   TextAlignment="Center"/>
                        <Button Classes="button-secondary" Command="{Binding RefreshCommand}"
                                HorizontalAlignment="Center">
                            <TextBlock Text="{markup:Localize Key=TasksTab_Retry}"/>
                        </Button>
                    </StackPanel>
                    
                    <!-- Empty State (only when not loading, no error, and no tasks) -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12"
                                IsVisible="{Binding ShowEmptyState, FallbackValue=False}">
                        <PathIcon Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20M9,13V19H7V13H9M15,15V19H13V15H15M11,11V19H9V11H11M13,13V19H11V13H13" 
                                  Width="48" Height="48" 
                                  Foreground="{DynamicResource BrushTextTertiary}"/>
                        <TextBlock Text="{markup:Localize Key=TasksTab_NoTasksFound}" 
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushTextSecondary}"/>
                        <TextBlock Text="{markup:Localize Key=TasksTab_CreateFirstTask}" 
                                   FontSize="13"
                                   Foreground="{DynamicResource BrushTextTertiary}"/>
                        <Button Classes="button-primary" Margin="0,8,0,0"
                                Command="{Binding RequestAddTaskDialogCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" 
                                          Width="14" Height="14"/>
                                <TextBlock Text="{markup:Localize Key=TasksTab_CreateTask}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    
                    <!-- Task List (only when not loading, no error, and has tasks) -->
                    <ItemsControl ItemsSource="{Binding FilteredTasks}"
                                  IsVisible="{Binding ShowTaskList, FallbackValue=False}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="task-card" 
                                        Tapped="TaskCard_Tapped" Tag="{Binding}">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        
                                        <!-- Checkbox -->
                                        <CheckBox Grid.Column="0" 
                                                  IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                                  Margin="0,0,12,0"
                                                  VerticalAlignment="Top"
                                                  Command="{Binding $parent[ItemsControl].((vm:TasksViewModel)DataContext).ToggleTaskCompleteCommand}"
                                                  CommandParameter="{Binding}"/>
                                        
                                        <!-- Task Info -->
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <!-- Title - Completed tasks shown with strikethrough -->
                                            <Panel>
                                                <TextBlock Text="{Binding Title}" 
                                                           FontSize="14" FontWeight="Medium"
                                                           Foreground="{DynamicResource BrushTextPrimary}"
                                                           TextTrimming="CharacterEllipsis"
                                                           IsVisible="{Binding !IsCompleted}"/>
                                                <TextBlock Text="{Binding Title}" 
                                                           FontSize="14" FontWeight="Medium"
                                                           Foreground="{DynamicResource BrushTextTertiary}"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextDecorations="Strikethrough"
                                                           IsVisible="{Binding IsCompleted}"/>
                                            </Panel>
                                            
                                            <!-- Meta info -->
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <!-- Due Date -->
                                                <StackPanel Orientation="Horizontal" Spacing="4"
                                                            IsVisible="{Binding HasDueDate}">
                                                    <PathIcon Data="M19,19H5V8H19M16,1V3H8V1H6V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3H18V1" 
                                                              Width="12" Height="12"
                                                              Foreground="{DynamicResource BrushTextTertiary}"/>
                                                    <!-- Normal date (not overdue) -->
                                                    <TextBlock Text="{Binding DueDate, StringFormat='{}{0:MMM d}'}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource BrushTextSecondary}"
                                                               IsVisible="{Binding !IsOverdue}"/>
                                                    <!-- Overdue date (red) -->
                                                    <TextBlock Text="{Binding DueDate, StringFormat='{}{0:MMM d}'}"
                                                               FontSize="12"
                                                               Foreground="#EF4444"
                                                               FontWeight="Medium"
                                                               IsVisible="{Binding IsOverdue}"/>
                                                </StackPanel>
                                                
                                                <!-- Assignee -->
                                                <StackPanel Orientation="Horizontal" Spacing="4"
                                                            IsVisible="{Binding OwnerName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                    <PathIcon Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z" 
                                                              Width="12" Height="12"
                                                              Foreground="{DynamicResource BrushTextTertiary}"/>
                                                    <TextBlock Text="{Binding OwnerName}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource BrushTextSecondary}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                        
                                        <!-- Priority Badge -->
                                        <Border Grid.Column="2" Classes="priority-badge" VerticalAlignment="Top"
                                                IsVisible="{Binding Priority, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                Background="{Binding Priority, Converter={x:Static local:PriorityToBackgroundConverter.Instance}}">
                                            <TextBlock Text="{Binding Priority}" FontSize="11" FontWeight="Medium"
                                                       Foreground="White"/>
                                        </Border>
                                        
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>
            
            <!-- Detail Flyout Panel -->
            <controls:EntityDetailFlyout Grid.Column="1" 
                                         Width="320" Margin="12,0,0,0"
                                         FlyoutContent="{Binding SelectedTask}"
                                         IsOpen="{Binding IsTaskDetailOpen}"/>
            
        </Grid>
        
    </Grid>
</UserControl>
