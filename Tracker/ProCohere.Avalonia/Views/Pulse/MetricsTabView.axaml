<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ProCohere.Avalonia.ViewModels"
             xmlns:models="using:ProCohere.Avalonia.Models"
             xmlns:converters="using:ProCohere.Avalonia.Converters"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="ProCohere.Avalonia.Views.Pulse.MetricsTabView"
             x:DataType="vm:MetricsViewModel">
    
    <UserControl.Resources>
        <converters:BooleanToOpacityConverter x:Key="BoolToOpacity"/>
        <converters:NullToBoolConverter x:Key="NullToBool"/>
        <converters:InverseBoolConverter x:Key="InverseBool"/>
    </UserControl.Resources>
    
    <UserControl.Styles>
        <!-- Filter Button Style -->
        <Style Selector="Border.filter-stat">
            <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Border.filter-stat:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}"/>
        </Style>
        <Style Selector="Border.filter-stat.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}"/>
        </Style>
        
        <!-- Scope Button Style -->
        <Style Selector="Border.scope-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Border.scope-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceHover}"/>
        </Style>
        <Style Selector="Border.scope-btn.selected">
            <Setter Property="Background" Value="{DynamicResource BrushPrimary}"/>
        </Style>
        <Style Selector="Border.scope-btn.selected TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        
        <!-- Metric Card Style -->
        <Style Selector="Border.metric-card">
            <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style Selector="Border.metric-card:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushHighlight}"/>
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}"/>
        </Style>
        <Style Selector="Border.metric-card.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        
        <!-- Signal Indicator -->
        <Style Selector="Ellipse.signal-dot">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
        </Style>
        
        <!-- Detail Panel Style - with slide animation -->
        <Style Selector="Border.detail-panel">
            <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RenderTransform" Value="translate(320px, 0)"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="CubicEaseOut"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.detail-panel.open">
            <Setter Property="RenderTransform" Value="translate(0, 0)"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        
        <!-- Tab Button Style -->
        <Style Selector="Border.tab-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Border.tab-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceHover}"/>
        </Style>
        <Style Selector="Border.tab-btn.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
        </Style>
        <Style Selector="Border.tab-btn.selected TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrushPrimary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Styles>
    
    <Grid RowDefinitions="Auto,Auto,*" ClipToBounds="True">
        
        <!-- Row 0: Filter Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- Filter Stats -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <!-- All -->
                <Border Classes="filter-stat" Classes.selected="{Binding IsLifecycleAll}"
                        Tapped="FilterAll_Tapped">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding TotalMetricsCount}" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                        <TextBlock Text="All" FontSize="12" 
                                   Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                
                <!-- Active -->
                <Border Classes="filter-stat" Classes.selected="{Binding IsLifecycleActive}"
                        Tapped="FilterActive_Tapped">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding ActiveMetricsCount}" FontSize="18" FontWeight="Bold"
                                   Foreground="#10B981"/>
                        <TextBlock Text="Active" FontSize="12" 
                                   Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                
                <!-- Trending Up -->
                <Border Classes="filter-stat" Classes.selected="False"
                        Tapped="FilterTrendingUp_Tapped">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding TrendingUpCount}" FontSize="18" FontWeight="Bold"
                                   Foreground="#3B82F6"/>
                        <PathIcon Data="M16,6L18.29,8.29L13.41,13.17L9.41,9.17L2,16.59L3.41,18L9.41,12L13.41,16L19.71,9.71L22,12V6H16Z" 
                                  Width="14" Height="14" Foreground="#3B82F6" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                
                <!-- Trending Down -->
                <Border Classes="filter-stat" Classes.selected="False"
                        Tapped="FilterTrendingDown_Tapped">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding TrendingDownCount}" FontSize="18" FontWeight="Bold"
                                   Foreground="#EF4444"/>
                        <PathIcon Data="M16,18L18.29,15.71L13.41,10.83L9.41,14.83L2,7.41L3.41,6L9.41,12L13.41,8L19.71,14.29L22,12V18H16Z" 
                                  Width="14" Height="14" Foreground="#EF4444" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            
            <!-- Add Metric Button -->
            <Button Grid.Column="1" Classes="button-primary" 
                    Command="{Binding CreateNewMetricCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" 
                              Width="14" Height="14"/>
                    <TextBlock Text="New Metric" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
        
        <!-- Row 1: Scope Filter + Search -->
        <Grid Grid.Row="1" Margin="0,0,0,16" ColumnDefinitions="Auto,*,Auto">
            <!-- Scope Toggle -->
            <Border Grid.Column="0" Background="{DynamicResource BrushSurfaceAlt}" CornerRadius="8" Padding="4">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Border Classes="scope-btn" Classes.selected="{Binding IsScopeIndividual}"
                            Tapped="ScopeIndividual_Tapped">
                        <TextBlock Text="Individual" FontSize="12"/>
                    </Border>
                    <Border Classes="scope-btn" Classes.selected="{Binding IsScopeTeam}"
                            Tapped="ScopeTeam_Tapped">
                        <TextBlock Text="Team" FontSize="12"/>
                    </Border>
                    <Border Classes="scope-btn" Classes.selected="{Binding IsScopeOrganization}"
                            Tapped="ScopeOrg_Tapped">
                        <TextBlock Text="Organization" FontSize="12"/>
                    </Border>
                    <Border Classes="scope-btn" Classes.selected="{Binding IsScopeAll}"
                            Tapped="ScopeAll_Tapped">
                        <TextBlock Text="All" FontSize="12"/>
                    </Border>
                </StackPanel>
            </Border>
            
            <!-- Search Box -->
            <TextBox Grid.Column="2" 
                     Text="{Binding SearchQuery}"
                     Watermark="Search metrics..."
                     Width="220"
                     Margin="16,0,0,0">
                <TextBox.InnerLeftContent>
                    <PathIcon Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z" 
                              Width="14" Height="14" 
                              Foreground="{DynamicResource BrushTextSecondary}"
                              Margin="8,0,4,0"/>
                </TextBox.InnerLeftContent>
            </TextBox>
        </Grid>
        
        <!-- Row 2: Content Area -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
            
            <!-- Metrics List -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                          Padding="0,0,12,0">
                <Grid>
                    <!-- Loading State -->
                    <StackPanel IsVisible="{Binding IsLoading}" 
                                VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                        <Border Width="32" Height="32" CornerRadius="16" 
                                Background="{DynamicResource BrushPrimary}" Opacity="0.3">
                            <PathIcon Data="M12,4V2A10,10 0 0,0 2,12H4A8,8 0 0,1 12,4Z" 
                                      Width="20" Height="20" Foreground="{DynamicResource BrushPrimary}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Loading metrics..." FontSize="13" 
                                   Foreground="{DynamicResource BrushTextSecondary}"/>
                    </StackPanel>
                    
                    <!-- Empty State (only when not loading AND no metrics) -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                        <StackPanel.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="!IsLoading"/>
                                <Binding Path="!Metrics.Count"/>
                            </MultiBinding>
                        </StackPanel.IsVisible>
                        <PathIcon Data="M22,21H2V3H4V19H6V10H10V19H12V6H16V19H18V14H22V21Z" 
                                  Width="48" Height="48" 
                                  Foreground="{DynamicResource BrushTextSecondary}"/>
                        <TextBlock Text="No metrics found" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Create your first metric to start tracking signals" 
                                   FontSize="13" Foreground="{DynamicResource BrushTextSecondary}" 
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                    
                    <!-- Metrics List (only when not loading AND has metrics) -->
                    <ItemsControl ItemsSource="{Binding Metrics}">
                        <ItemsControl.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="!IsLoading"/>
                                <Binding Path="!!Metrics.Count"/>
                            </MultiBinding>
                        </ItemsControl.IsVisible>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:MetricDetail">
                                <Border Classes="metric-card"
                                        Tapped="MetricCard_Tapped"
                                        Tag="{Binding}">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <!-- Signal Indicator + Trend -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                            <!-- Signal Dot (colored based on trend + direction) -->
                                            <Ellipse Classes="signal-dot">
                                                <Ellipse.Fill>
                                                    <MultiBinding Converter="{x:Static converters:MetricSignalColorConverter.Instance}">
                                                        <Binding Path="Trend"/>
                                                        <Binding Path="TargetDirection"/>
                                                    </MultiBinding>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            
                                            <!-- Trend Arrow -->
                                            <TextBlock Text="{Binding TrendDisplay}" 
                                                       FontSize="20" 
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Foreground>
                                                    <MultiBinding Converter="{x:Static converters:MetricSignalColorConverter.Instance}">
                                                        <Binding Path="Trend"/>
                                                        <Binding Path="TargetDirection"/>
                                                    </MultiBinding>
                                                </TextBlock.Foreground>
                                            </TextBlock>
                                        </StackPanel>
                                        
                                        <!-- Name and Description -->
                                        <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" 
                                                       FontSize="14" 
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource BrushTextPrimary}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Description}" 
                                                       FontSize="12" 
                                                       Foreground="{DynamicResource BrushTextSecondary}"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxLines="1"
                                                       IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        </StackPanel>
                                        
                                        <!-- Badges -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <!-- Frequency Badge -->
                                            <Border Background="{DynamicResource BrushSurfaceAlt}" 
                                                    CornerRadius="4" Padding="8,4"
                                                    IsVisible="{Binding Frequency, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                <TextBlock Text="{Binding Frequency}" 
                                                           FontSize="11" 
                                                           Foreground="{DynamicResource BrushTextSecondary}"/>
                                            </Border>
                                            
                                            <!-- Project Link Indicator -->
                                            <Border Background="#E0F2FE" CornerRadius="4" Padding="6,4"
                                                    IsVisible="{Binding HasProject}"
                                                    ToolTip.Tip="{Binding ProjectTitle}">
                                                <PathIcon Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z" 
                                                          Width="12" Height="12" Foreground="#0284C7"/>
                                            </Border>
                                            
                                            <!-- Chevron -->
                                            <PathIcon Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" 
                                                      Width="16" Height="16" 
                                                      Foreground="{DynamicResource BrushTextSecondary}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>
            
            <!-- Detail Flyout Panel -->
            <Border Grid.Column="1" 
                    Classes="detail-panel"
                    Classes.open="{Binding IsDetailFlyoutOpen}"
                    Width="340"
                    Margin="12,0,0,0"
                    IsVisible="{Binding IsDetailFlyoutOpen}">
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                    
                    <!-- Header -->
                    <Border Grid.Row="0" Background="{DynamicResource BrushPrimary}" 
                            CornerRadius="12,12,0,0" Padding="16">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="{Binding SelectedMetric.Name}" 
                                           FontSize="16" FontWeight="SemiBold" Foreground="White"
                                           TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <!-- Signal Dot -->
                                    <Ellipse Width="8" Height="8">
                                        <Ellipse.Fill>
                                            <MultiBinding Converter="{x:Static converters:MetricSignalColorConverter.Instance}">
                                                <Binding Path="SelectedMetric.Trend"/>
                                                <Binding Path="SelectedMetric.TargetDirection"/>
                                            </MultiBinding>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <TextBlock Text="{Binding SelectedMetricTrendDescription}" 
                                               FontSize="12" Foreground="#FFFFFFCC"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="1" 
                                    Background="Transparent" 
                                    BorderThickness="0"
                                    Padding="4"
                                    Command="{Binding CloseDetailFlyoutCommand}">
                                <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" 
                                          Width="16" Height="16" Foreground="White"/>
                            </Button>
                        </Grid>
                    </Border>
                    
                    <!-- Tab Strip -->
                    <Border Grid.Row="1" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <Border Classes="tab-btn" Classes.selected="{Binding DetailTab, Converter={x:Static converters:EqualityConverter.Instance}, ConverterParameter=0}"
                                    Tapped="TabDetails_Tapped">
                                <TextBlock Text="Details" FontSize="13"/>
                            </Border>
                            <Border Classes="tab-btn" Classes.selected="{Binding DetailTab, Converter={x:Static converters:EqualityConverter.Instance}, ConverterParameter=1}"
                                    Tapped="TabHistory_Tapped">
                                <TextBlock Text="History" FontSize="13"/>
                            </Border>
                            <Border Classes="tab-btn" Classes.selected="{Binding DetailTab, Converter={x:Static converters:EqualityConverter.Instance}, ConverterParameter=2}"
                                    Tapped="TabTrend_Tapped">
                                <TextBlock Text="Trend Analysis" FontSize="13"/>
                            </Border>
                        </StackPanel>
                    </Border>
                    
                    <!-- Tab Content -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <Panel>
                            <!-- Details Tab -->
                            <StackPanel IsVisible="{Binding DetailTab, Converter={x:Static converters:EqualityConverter.Instance}, ConverterParameter=0}"
                                        Spacing="16" Margin="16">
                                
                                <!-- Current Value -->
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Current Value" FontSize="11" 
                                               Foreground="{DynamicResource BrushTextSecondary}" FontWeight="Medium"/>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{Binding SelectedMetric.CurrentValue, StringFormat={}{0:N2}}" 
                                                   FontSize="24" FontWeight="Bold"
                                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                                        <TextBlock Text="{Binding SelectedMetric.Unit}" 
                                                   FontSize="14" 
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                                    </StackPanel>
                                </StackPanel>
                                
                                <!-- Target Value (if set) -->
                                <StackPanel Spacing="4" IsVisible="{Binding SelectedMetric.TargetValue, Converter={StaticResource NullToBool}}">
                                    <TextBlock Text="Target" FontSize="11" 
                                               Foreground="{DynamicResource BrushTextSecondary}" FontWeight="Medium"/>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{Binding SelectedMetric.TargetValue, StringFormat={}{0:N2}}" 
                                                   FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                                        <TextBlock Text="{Binding SelectedMetric.Unit}" 
                                                   FontSize="12" 
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   VerticalAlignment="Bottom"/>
                                    </StackPanel>
                                </StackPanel>
                                
                                <!-- Direction -->
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Direction" FontSize="11" 
                                               Foreground="{DynamicResource BrushTextSecondary}" FontWeight="Medium"/>
                                    <TextBlock Text="{Binding SelectedMetric.TargetDirection}" 
                                               FontSize="13"
                                               Foreground="{DynamicResource BrushTextPrimary}"/>
                                </StackPanel>
                                
                                <!-- Frequency -->
                                <StackPanel Spacing="4" IsVisible="{Binding SelectedMetric.Frequency, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock Text="Update Frequency" FontSize="11" 
                                               Foreground="{DynamicResource BrushTextSecondary}" FontWeight="Medium"/>
                                    <TextBlock Text="{Binding SelectedMetric.Frequency}" 
                                               FontSize="13"
                                               Foreground="{DynamicResource BrushTextPrimary}"/>
                                </StackPanel>
                                
                                <!-- Steward -->
                                <StackPanel Spacing="4" IsVisible="{Binding SelectedMetric.StewardName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock Text="Steward" FontSize="11" 
                                               Foreground="{DynamicResource BrushTextSecondary}" FontWeight="Medium"/>
                                    <TextBlock Text="{Binding SelectedMetric.StewardName}" 
                                               FontSize="13"
                                               Foreground="{DynamicResource BrushTextPrimary}"/>
                                </StackPanel>
                                
                                <!-- Project Link -->
                                <StackPanel Spacing="4" IsVisible="{Binding SelectedMetric.HasProject}">
                                    <TextBlock Text="Linked Project" FontSize="11" 
                                               Foreground="{DynamicResource BrushTextSecondary}" FontWeight="Medium"/>
                                    <Border Background="#E0F2FE" CornerRadius="6" Padding="10,8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <PathIcon Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z" 
                                                      Width="14" Height="14" Foreground="#0284C7"/>
                                            <TextBlock Text="{Binding SelectedMetric.ProjectTitle}" 
                                                       FontSize="13" Foreground="#0284C7"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                
                                <!-- Description -->
                                <StackPanel Spacing="4" IsVisible="{Binding SelectedMetric.Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock Text="Description" FontSize="11" 
                                               Foreground="{DynamicResource BrushTextSecondary}" FontWeight="Medium"/>
                                    <TextBlock Text="{Binding SelectedMetric.Description}" 
                                               FontSize="13"
                                               Foreground="{DynamicResource BrushTextPrimary}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                
                                <!-- Update Value Button -->
                                <Button Classes="button-primary" 
                                        HorizontalAlignment="Stretch"
                                        Margin="0,8,0,0"
                                        Command="{Binding OpenValueUpdateDialogCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                        <PathIcon Data="M16,6L18.29,8.29L13.41,13.17L9.41,9.17L2,16.59L3.41,18L9.41,12L13.41,16L19.71,9.71L22,12V6H16Z" 
                                                  Width="14" Height="14"/>
                                        <TextBlock Text="Update Value"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            
                            <!-- History Tab -->
                            <StackPanel IsVisible="{Binding DetailTab, Converter={x:Static converters:EqualityConverter.Instance}, ConverterParameter=1}"
                                        Margin="16">
                                <!-- Empty History -->
                                <StackPanel IsVisible="{Binding !MetricHistory.Count}" 
                                            VerticalAlignment="Center" HorizontalAlignment="Center" 
                                            Spacing="8" Margin="0,24">
                                    <PathIcon Data="M13.5,8H12V13L16.28,15.54L17,14.33L13.5,12.25V8M13,3A9,9 0 0,0 4,12H1L4.96,16.03L9,12H6A7,7 0 0,1 13,5A7,7 0 0,1 20,12A7,7 0 0,1 13,19C11.07,19 9.32,18.21 8.06,16.94L6.64,18.36C8.27,20 10.5,21 13,21A9,9 0 0,0 22,12A9,9 0 0,0 13,3" 
                                              Width="32" Height="32" 
                                              Foreground="{DynamicResource BrushTextSecondary}"/>
                                    <TextBlock Text="No history yet" FontSize="13" 
                                               Foreground="{DynamicResource BrushTextSecondary}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                                
                                <!-- History List -->
                                <ItemsControl ItemsSource="{Binding MetricHistory}"
                                              IsVisible="{Binding !!MetricHistory.Count}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:MetricHistoryEntry">
                                            <Border Background="{DynamicResource BrushSurfaceAlt}" 
                                                    CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                                <Grid RowDefinitions="Auto,Auto">
                                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding Value, StringFormat={}{0:N2}}" 
                                                                   FontSize="16" FontWeight="Bold"
                                                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                                                        <TextBlock Text="{Binding RecordedAt, StringFormat='{}{0:MMM d yyyy}'}" 
                                                                   FontSize="12" 
                                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Row="1" 
                                                               Text="{Binding Notes}" 
                                                               FontSize="12"
                                                               Foreground="{DynamicResource BrushTextSecondary}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,4,0,0"
                                                               IsVisible="{Binding Notes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            
                            <!-- Trend Analysis Tab -->
                            <StackPanel IsVisible="{Binding DetailTab, Converter={x:Static converters:EqualityConverter.Instance}, ConverterParameter=2}"
                                        Spacing="16" Margin="16">
                                
                                <!-- Loading State -->
                                <StackPanel IsVisible="{Binding IsLoadingTrendAnalysis}"
                                            VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Spacing="8" Margin="0,24">
                                    <PathIcon Data="M12,4V2A10,10 0 0,0 2,12H4A8,8 0 0,1 12,4Z" 
                                              Width="32" Height="32"
                                              Foreground="{DynamicResource BrushAccent}"/>
                                    <TextBlock Text="Analyzing trend..." FontSize="13"
                                               Foreground="{DynamicResource BrushTextSecondary}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                                
                                <!-- No Trend Data -->
                                <StackPanel IsVisible="{Binding !HasTrendAnalysis}"
                                            VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Spacing="8" Margin="0,24">
                                    <PathIcon Data="M16,6L18.29,8.29L13.41,13.17L9.41,9.17L2,16.59L3.41,18L9.41,12L13.41,16L19.71,9.71L22,12V6H16Z"
                                              Width="32" Height="32"
                                              Foreground="{DynamicResource BrushTextSecondary}"/>
                                    <TextBlock Text="Not enough data for trend analysis" FontSize="13"
                                               Foreground="{DynamicResource BrushTextSecondary}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="At least 3 data points are required" FontSize="12"
                                               Foreground="{DynamicResource BrushTextTertiary}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                                
                                <!-- Trend Analysis Content -->
                                <StackPanel IsVisible="{Binding HasTrendAnalysis}" Spacing="16">
                                    
                                    <!-- Trend Direction -->
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Trend Direction" FontSize="11"
                                                   Foreground="{DynamicResource BrushTextSecondary}" FontWeight="Medium"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding TrendAnalysis.TrendArrow}"
                                                       FontSize="32" FontWeight="Bold"
                                                       VerticalAlignment="Center"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TrendAnalysis.Direction, Converter={x:Static converters:MetricTrendDisplayConverter.Instance}}"
                                                           FontSize="16" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource BrushTextPrimary}"/>
                                                <TextBlock Text="{Binding TrendAnalysis.Description}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource BrushTextSecondary}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                    
                                    <!-- Statistics -->
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="Statistics" FontSize="11"
                                                   Foreground="{DynamicResource BrushTextSecondary}" FontWeight="Medium"/>
                                        
                                        <!-- Confidence -->
                                        <Border Background="{DynamicResource BrushSurfaceAlt}"
                                                CornerRadius="8" Padding="12">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="Confidence" FontSize="13"
                                                           Foreground="{DynamicResource BrushTextPrimary}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding TrendConfidenceDescription}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource BrushTextPrimary}"/>
                                            </Grid>
                                        </Border>
                                        
                                        <!-- Slope -->
                                        <Border Background="{DynamicResource BrushSurfaceAlt}"
                                                CornerRadius="8" Padding="12">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="Rate of Change" FontSize="13"
                                                           Foreground="{DynamicResource BrushTextPrimary}"/>
                                                <TextBlock Grid.Column="1" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource BrushTextPrimary}">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0:F2} per day">
                                                            <Binding Path="TrendAnalysis.Slope"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                        
                                        <!-- Data Points -->
                                        <Border Background="{DynamicResource BrushSurfaceAlt}"
                                                CornerRadius="8" Padding="12">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="Data Points Analyzed" FontSize="13"
                                                           Foreground="{DynamicResource BrushTextPrimary}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding TrendAnalysis.DataPointCount}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource BrushTextPrimary}"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                    
                                    <!-- Projection -->
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="30-Day Projection" FontSize="11"
                                                   Foreground="{DynamicResource BrushTextSecondary}" FontWeight="Medium"/>
                                        <Border Background="{DynamicResource BrushSurface}"
                                                BorderBrush="{DynamicResource BrushBorder}"
                                                BorderThickness="1"
                                                CornerRadius="8" Padding="12">
                                            <TextBlock Text="{Binding TrendProjectionDescription}"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource BrushTextPrimary}"
                                                       TextWrapping="Wrap"/>
                                        </Border>
                                    </StackPanel>
                                    
                                    <!-- Value Range -->
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Value Range" FontSize="11"
                                                   Foreground="{DynamicResource BrushTextSecondary}" FontWeight="Medium"/>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Spacing="4">
                                                <TextBlock Text="First Value" FontSize="11"
                                                           Foreground="{DynamicResource BrushTextTertiary}"/>
                                                <TextBlock FontSize="16" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource BrushTextPrimary}">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0:F2}">
                                                            <Binding Path="TrendAnalysis.FirstValue"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                <TextBlock FontSize="11"
                                                           Foreground="{DynamicResource BrushTextTertiary}">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}on {0:MMM d, yyyy}">
                                                            <Binding Path="TrendAnalysis.FirstDate"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                            <PathIcon Grid.Column="1" Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z"
                                                      Width="24" Height="24"
                                                      Foreground="{DynamicResource BrushTextTertiary}"
                                                      VerticalAlignment="Center" Margin="8,0"/>
                                            <StackPanel Grid.Column="2" Spacing="4">
                                                <TextBlock Text="Latest Value" FontSize="11"
                                                           Foreground="{DynamicResource BrushTextTertiary}"/>
                                                <TextBlock FontSize="16" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource BrushTextPrimary}">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0:F2}">
                                                            <Binding Path="TrendAnalysis.LatestValue"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                <TextBlock FontSize="11"
                                                           Foreground="{DynamicResource BrushTextTertiary}">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}on {0:MMM d, yyyy}">
                                                            <Binding Path="TrendAnalysis.LatestDate"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                    
                                </StackPanel>
                            </StackPanel>
                        </Panel>
                    </ScrollViewer>
                    
                    <!-- Footer Actions -->
                    <Border Grid.Row="3" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0" Padding="12">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Background="Transparent" 
                                    BorderThickness="1" 
                                    BorderBrush="{DynamicResource BrushBorder}"
                                    Padding="12,8"
                                    Command="{Binding EditMetricCommand}"
                                    CommandParameter="{Binding SelectedMetric}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z" 
                                              Width="14" Height="14"/>
                                    <TextBlock Text="Edit"/>
                                </StackPanel>
                            </Button>
                            <Button Background="#FEE2E2" 
                                    BorderThickness="0"
                                    Padding="12,8"
                                    Command="{Binding DeleteMetricCommand}"
                                    CommandParameter="{Binding SelectedMetric}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z" 
                                              Width="14" Height="14" Foreground="#DC2626"/>
                                    <TextBlock Text="Delete" Foreground="#DC2626"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
