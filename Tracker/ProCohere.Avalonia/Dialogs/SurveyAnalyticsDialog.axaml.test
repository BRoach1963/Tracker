<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ProCohere.Avalonia.ViewModels"
        x:Class="ProCohere.Avalonia.Dialogs.SurveyAnalyticsDialog"
        x:DataType="vm:SurveyAnalyticsViewModel"
        Title="Survey Analytics Test"
        Width="900" Height="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushBackground}">
    <StackPanel>
        <TextBlock Text="Test" />
        <Button Content="Close" Click="OnCloseClick" />
    </StackPanel>
</Window>
