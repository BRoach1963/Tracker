<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ProCohere.Avalonia.ViewModels"
        x:Class="ProCohere.Avalonia.Dialogs.SurveyAnalyticsDialog"
        x:DataType="vm:SurveyAnalyticsViewModel"
        Title="Survey Analytics"
        Width="900" Height="700"
        MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/logo.ico"
        Background="{DynamicResource BrushBackground}">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header -->
        <Border Grid.Row="0" 
                Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="0,0,0,1"
                Padding="24,16">
            <StackPanel Spacing="8">
                <TextBlock Text="{Binding Title}" 
                           FontSize="18" 
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding Description}" 
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource BrushTextSecondary}"
                           IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding SurveyTypeDisplay}" 
                               FontSize="12" 
                               Foreground="{DynamicResource BrushTextTertiary}"/>
                    <TextBlock Text=" • " 
                               FontSize="12" 
                               Foreground="{DynamicResource BrushTextTertiary}"/>
                    <TextBlock Text="{Binding DatesDisplay}" 
                               FontSize="12" 
                               Foreground="{DynamicResource BrushTextTertiary}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" Padding="24">
            <StackPanel Spacing="24">
                <!-- Response Statistics -->
                <StackPanel Spacing="12">
                    <TextBlock Text="Response Statistics" 
                               FontSize="16" 
                               FontWeight="SemiBold" />
                    
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                        <Border Grid.Column="0" 
                                Background="{DynamicResource BrushSurface}"
                                BorderBrush="{DynamicResource BrushBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Total Responses" 
                                           FontSize="12" 
                                           Foreground="{DynamicResource BrushTextSecondary}" />
                                <TextBlock Text="{Binding TotalResponses}" 
                                           FontSize="32" 
                                           FontWeight="Bold" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" 
                                Background="{DynamicResource BrushSurface}"
                                BorderBrush="{DynamicResource BrushBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Completed" 
                                           FontSize="12" 
                                           Foreground="{DynamicResource BrushTextSecondary}" />
                                <TextBlock Text="{Binding CompletedResponses}" 
                                           FontSize="32" 
                                           FontWeight="Bold" 
                                           Foreground="{DynamicResource BrushSuccess}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" 
                                Background="{DynamicResource BrushSurface}"
                                BorderBrush="{DynamicResource BrushBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Completion Rate" 
                                           FontSize="12" 
                                           Foreground="{DynamicResource BrushTextSecondary}" />
                                <TextBlock Text="{Binding CompletionRateText}" 
                                           FontSize="32" 
                                           FontWeight="Bold" 
                                           Foreground="{DynamicResource BrushPrimary}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- Question Analytics -->
                <StackPanel Spacing="12">
                    <TextBlock Text="Question Analytics" 
                               FontSize="16" 
                               FontWeight="SemiBold" />

                    <TextBlock Text="No questions in this survey"
                               FontSize="13"
                               FontStyle="Italic"
                               Foreground="{DynamicResource BrushTextTertiary}"
                               HorizontalAlignment="Center"
                               Margin="0,24"
                               IsVisible="{Binding NoQuestions}" />

                    <ItemsControl ItemsSource="{Binding QuestionAnalytics}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BrushSurface}"
                                        BorderBrush="{DynamicResource BrushBorder}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="16"
                                        Margin="0,0,0,12">
                                    <StackPanel Spacing="12">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Binding QuestionText}" 
                                                       FontSize="14" 
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding ResponseSummaryText}"
                                                       FontSize="12" 
                                                       Foreground="{DynamicResource BrushTextTertiary}"/>
                                        </StackPanel>

                                        <!-- Rating analytics -->
                                        <StackPanel Spacing="8" IsVisible="{Binding IsRatingQuestion}">
                                            <TextBlock FontSize="13">
                                                <TextBlock.Text>
                                                    <Binding Path="AverageRatingText" StringFormat="Average: {0}" />
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Choice analytics -->
                                        <ItemsControl ItemsSource="{Binding ChoiceCounts}" IsVisible="{Binding IsChoiceQuestion}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                                                        <TextBlock Text="{Binding Choice}" FontSize="12" Width="200" />
                                                        <TextBlock Text="{Binding Count}" FontSize="12" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding PercentageText}" FontSize="12" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Text analytics -->
                                        <StackPanel Spacing="6" IsVisible="{Binding IsTextQuestion}">
                                            <TextBlock Text="{Binding TextResponsesCountText}" FontSize="12" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" 
                Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="0,1,0,0"
                Padding="24,16">
            <Button Content="Close" 
                    Classes="secondary-button"
                    Click="OnCloseClick"
                    HorizontalAlignment="Right"
                    MinWidth="100" />
        </Border>
    </Grid>
</Window>
