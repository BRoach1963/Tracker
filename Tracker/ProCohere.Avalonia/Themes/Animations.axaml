<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- 
    Global Animation Styles for ProCohere
    Provides consistent micro-interactions across the application
    -->
    
    <!-- ========== BUTTON ANIMATIONS ========== -->
    
    <!-- Standard Button - subtle scale on press -->
    <Style Selector="Button">
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button:pressed">
        <Setter Property="RenderTransform" Value="scale(0.97)"/>
    </Style>
    
    <!-- Accent Button - more prominent feedback -->
    <Style Selector="Button.accent:pressed">
        <Setter Property="RenderTransform" Value="scale(0.95)"/>
    </Style>
    
    <!-- Icon Button - quick response -->
    <Style Selector="Button.icon-button">
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.08"/>
                <DoubleTransition Property="Opacity" Duration="0:0:0.1"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.icon-button:pointerover">
        <Setter Property="Opacity" Value="0.8"/>
    </Style>
    <Style Selector="Button.icon-button:pressed">
        <Setter Property="RenderTransform" Value="scale(0.9)"/>
    </Style>
    
    <!-- ========== CARD ANIMATIONS ========== -->
    
    <!-- Hover lift effect for cards -->
    <Style Selector="Border.card">
        <Setter Property="Transitions">
            <Transitions>
                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>
    
    <!-- Clickable card with scale feedback -->
    <Style Selector="Border.card-clickable">
        <Setter Property="Transitions">
            <Transitions>
                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.card-clickable:pointerover">
        <Setter Property="RenderTransform" Value="translateY(-2px)"/>
        <Setter Property="BoxShadow" Value="0 4 12 0 #20000000"/>
    </Style>
    <Style Selector="Border.card-clickable:pressed">
        <Setter Property="RenderTransform" Value="translateY(0) scale(0.99)"/>
    </Style>
    
    <!-- ========== PANEL ANIMATIONS ========== -->
    
    <!-- Slide-in panel (flyouts, sidebars) -->
    <Style Selector="Border.slide-panel">
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>
    
    <!-- Fade panel -->
    <Style Selector="Border.fade-panel">
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>
    
    <!-- ========== TOGGLE ANIMATIONS ========== -->
    
    <!-- Checkbox smooth transition -->
    <Style Selector="CheckBox">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>
    
    <!-- Toggle Switch -->
    <Style Selector="ToggleSwitch">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.2"/>
            </Transitions>
        </Setter>
    </Style>
    
    <!-- ========== INPUT ANIMATIONS ========== -->
    
    <!-- TextBox focus animation -->
    <Style Selector="TextBox">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>
    
    <!-- ========== TAB ANIMATIONS ========== -->
    
    <!-- Tab button underline animation -->
    <Style Selector="Button.tab-animated">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>
    
    <!-- ========== LIST ITEM ANIMATIONS ========== -->
    
    <!-- List item hover -->
    <Style Selector="Border.list-item">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.1"/>
            </Transitions>
        </Setter>
    </Style>
    
    <!-- ========== BADGE/CHIP ANIMATIONS ========== -->
    
    <Style Selector="Border.badge">
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.badge:pointerover">
        <Setter Property="RenderTransform" Value="scale(1.05)"/>
    </Style>
    
    <!-- ========== LOADING SPINNER ========== -->
    
    <Style Selector="PathIcon.spinning">
        <Style.Animations>
            <Animation Duration="0:0:1" IterationCount="INFINITE">
                <KeyFrame Cue="0%">
                    <Setter Property="RotateTransform.Angle" Value="0"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="RotateTransform.Angle" Value="360"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
        <Setter Property="RenderTransform">
            <RotateTransform/>
        </Setter>
    </Style>
    
    <!-- ========== PULSE ANIMATION ========== -->
    
    <Style Selector="Border.pulse">
        <Style.Animations>
            <Animation Duration="0:0:2" IterationCount="INFINITE">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="1"/>
                </KeyFrame>
                <KeyFrame Cue="50%">
                    <Setter Property="Opacity" Value="0.6"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    
    <!-- ========== SKELETON LOADING ========== -->
    
    <Style Selector="Border.skeleton">
        <Setter Property="Background" Value="#E5E7EB"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Style.Animations>
            <Animation Duration="0:0:1.5" IterationCount="INFINITE">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0.6"/>
                </KeyFrame>
                <KeyFrame Cue="50%">
                    <Setter Property="Opacity" Value="1"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="0.6"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    
    <!-- ========== EXPAND/COLLAPSE ========== -->
    
    <Style Selector="PathIcon.expandable">
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
        <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
    </Style>
    <Style Selector="PathIcon.expandable.expanded">
        <Setter Property="RenderTransform" Value="rotate(90deg)"/>
    </Style>
    
    <!-- ========== NOTIFICATION/TOAST ENTRY ========== -->
    
    <Style Selector="Border.toast">
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.3" Easing="CubicEaseOut"/>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>
    
</Styles>
