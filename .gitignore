# Coverlet
coverage*.json
coverage*.xml
coverage*.info

# Visual Studio code coverage
*.coverage
*.coveragexml

# Fakes Assemblies
FakesAssemblies/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# SQL Server
*.mdf
*.ldf
*.ndf

# Business Intelligence
*.rdl.data
*.bim.layout
*.bim_*.settings
*.rptproj.rsuser
*- [Bb]ackup.rdl
*- [Bb]ackup ([0-9]).rdl
*- [Bb]ackup ([0-9][0-9]).rdl

# Microsoft Fakes
FakesAssemblies/

# GhostDoc
*.GhostDoc.xml

# Node
node_modules/
npm-debug.log

# Local settings
appsettings.*.json
local.settings.json

# Local databases
*.db
*.db-shm
*.db-wal
TrackerDatabase.db

# Secrets
*.secrets.*
secrets.json

# WiX build files
Tracker.Installer/**/en-US/
!Tracker.Installer/**/Package.wxs

# Supabase local
supabase/.temp/

# Temp files
*.tmp
~$*
